---
const {
  title = "ShouldISpend",
  description = "Verdict-driven financial decision tools that help you evaluate major spending choices with income, savings, debt, and risk context.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-TMG3D5BX1B"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-TMG3D5BX1B');
  </script>
  <!-- Microsoft Clarity -->
<script type="text/javascript">
  (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
  })(window, document, "clarity", "script", "wrvwp5shli");
</script>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:image" content="https://shouldispend.com/og-image.png" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content="https://shouldispend.com/og-image.png" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={Astro.url} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script
  	type="application/ld+json"
  	set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "ShouldISpend",
    url: "https://shouldispend.com",
    logo: "https://shouldispend.com/favicon.svg",
  })}
/>
	</head>

	<body>
		<header class="site-header">
			<div class="container nav">
				<a href="/" class="logo">Should<span>I</span>Spend</a>

				<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />

				<label for="nav-toggle" class="hamburger">
					<span></span>
					<span></span>
					<span></span>
				</label>

				<nav class="site-nav">
					<a href="/calculators">Calculators</a>
					<a href="/wedding-calculators">Weddings</a>
					<a href="/car-calculators">Cars</a>
					<a href="/travel-calculators">Travel</a>
					<a href="/rent-calculators">Rent</a>
					<a href="/budget-rule-calculators">Budget Rules</a>
					<a href="/what-counts-as-debt">Debt Guide</a>
					<a href="/methodology">Methodology</a>
					<a href="/about">About</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-content">
				<div>
					<h3>ShouldISpend</h3>
					<p>
						Verdict-driven financial decision tools built to help you
						spend smarter.
					</p>
				</div>

				<div class="footer-links">
					<a href="/calculators">Calculators</a>
					<a href="/about">About</a>
					<a href="/contact">Contact</a>
					<a href="/methodology">Methodology</a>
					<a href="/privacy-policy">Privacy Policy</a>
					<a href="/disclaimer">Disclaimer</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--bg: #f4f7f8;
		--card: #ffffff;
		--text: #102a43;
		--muted: #486581;
		--primary: #0f766e;
		--border: #d9e2ec;
		--button: #0f766e;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: Arial, sans-serif;
		background: var(--bg);
		color: var(--text);
		line-height: 1.6;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	.container {
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.site-header {
		background: white;
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding: 0.85rem 1.5rem;
	}

	.logo {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--text);
		white-space: nowrap;
	}

	.logo span {
		color: var(--primary);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1.25rem;
		font-weight: 600;
		color: var(--muted);
		font-size: 0.9rem;
		white-space: nowrap;
	}

	.site-nav a:hover,
	.footer-links a:hover {
		color: var(--primary);
	}

	.nav-toggle {
		display: none;
	}

	.hamburger {
		display: none;
		width: 2rem;
		height: 1.5rem;
		cursor: pointer;
		flex-direction: column;
		justify-content: space-between;
	}

	.hamburger span {
		display: block;
		height: 3px;
		width: 100%;
		background: var(--text);
		border-radius: 999px;
	}

	main {
		min-height: 70vh;
	}

	.site-footer {
  margin-top: 80px;
  padding: 32px 0;
  border-top: 1px solid #d8e0ea;
  text-align: center;
}

.site-footer a {
  margin: 0 12px;
  color: var(--muted);
  text-decoration: none;
}

.site-footer a:hover {
  text-decoration: underline;
}

	h3 {
		margin-top: 0;
	}

	@media (max-width: 900px) {
		.nav {
			position: relative;
			padding: 0.75rem 1.25rem;
		}

		.logo {
			font-size: 1.25rem;
		}

		.hamburger {
			display: flex;
		}

		.site-nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: white;
			border-bottom: 1px solid var(--border);
			padding: 0.75rem 1.25rem 1rem;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
			box-shadow: 0 12px 20px rgba(16, 42, 67, 0.08);
		}

		.nav-toggle:checked ~ .site-nav {
			display: flex;
		}

		.site-nav a {
			width: 100%;
			padding: 0.35rem 0;
		}
	}
</style>