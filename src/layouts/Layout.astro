    <title>{title || "ShouldISpend"}</title>

        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:image" content="https://shouldispend.com/og-image.png" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="https://shouldispend.com/og-image.png" />
        <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
        <link rel="canonical" href={Astro.url} />

        <link rel="icon" href="/favicon.ico" sizes="any" />

        <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/web-app-manifest-192x192.png" />
        <link rel="icon" type="image/png" sizes="512x512" href="/web-app-manifest-512x512.png" />

        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "Organization",
                        "@id": "https://shouldispend.com/#organization",
                        name: "ShouldISpend",
                        alternateName: "Should I Spend",
                        url: "https://shouldispend.com/",
                        logo: {
                            "@type": "ImageObject",
                            url: "https://shouldispend.com/web-app-manifest-512x512.png",
                            width: 512,
                            height: 512
                        },
                        image: "https://shouldispend.com/web-app-manifest-512x512.png"
                    },
                    {
                        "@type": "WebSite",
                        "@id": "https://shouldispend.com/#website",
                        url: "https://shouldispend.com/",
                        name: "ShouldISpend",
                        alternateName: "Should I Spend",
                        publisher: {
                            "@id": "https://shouldispend.com/#organization"
                        }
                    }
                ]
            })}
        />
            <style is:global>
    button.sis-action-button {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-height: 48px !important;
      width: auto !important;
      padding: 14px 22px !important;
      border-radius: 999px !important;
      font-size: 1rem !important;
      font-weight: 800 !important;
      line-height: 1.2 !important;
      text-align: center !important;
      text-decoration: none !important;
      cursor: pointer !important;
      white-space: normal !important;
      box-sizing: border-box !important;
      opacity: 1 !important;
      visibility: visible !important;
      appearance: none !important;
      -webkit-appearance: none !important;
    }

    button.sis-action-button.sis-calculate-button {
      background: #0f172a !important;
      color: #ffffff !important;
      border: 1px solid #0f172a !important;
    }

    button.sis-action-button.sis-reset-button {
      background: #f1f5f9 !important;
      color: #0f172a !important;
      border: 1px solid #cbd5e1 !important;
    }

    button.sis-action-button:hover {
      opacity: 0.92 !important;
    }

    button.sis-action-button:focus-visible {
      outline: 3px solid #f59e0b !important;
      outline-offset: 3px !important;
    }

    @media (max-width: 640px) {
      button.sis-action-button {
        width: 100% !important;
      }
    }
  </style>
<script data-grow-initializer="">!(function(){window.growMe||((window.growMe=function(e){window.growMe._.push(e);}),(window.growMe._=[]));var e=document.createElement("script");(e.type="text/javascript"),(e.src="https://faves.grow.me/main.js"),(e.defer=!0),e.setAttribute("data-grow-faves-site-id","U2l0ZTozODRmN2MzMi02NWM2LTQwYTQtODEyNC0zNDZkNzFkMmZhY2Y=");var t=document.getElementsByTagName("script")[0];t.parentNode.insertBefore(e,t);})();</script>
</head>

    <body>
        <header class="site-header">
            <div class="container nav">
                <a href="/" class="logo logo-image" aria-label="ShouldISpend home">
                    <img src="/sislogo.png" alt="ShouldISpend" />
                </a>

                <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />

                <label for="nav-toggle" class="hamburger">
                    <span></span>
                    <span></span>
                    <span></span>
                </label>

                <nav class="site-nav">
                    <a href="/calculators/">Calculators</a>
                    <a href="/grocery-calculators/">Groceries</a>
                    <a href="/wedding-calculators/">Weddings</a>
                    <a href="/car-calculators/">Cars</a>
                    <a href="/travel-calculators/">Travel</a>
                    <a href="/rent-calculators/">Rent</a>
                    <a href="/medical-calculators/">Medical</a>
                    <a href="/home-improvement-calculators/">Repairs</a>
                    <a href="/baby-parenting-calculators/">Baby</a>
                    <a href="/budget-rule-calculators/">Budget Rules</a>
                    <a href="/how-much-debt-is-too-much/">Debt Guide</a>
                    <a href="/methodology/">Methodology</a>
                    <a href="/about/">About</a>
                </nav>
            </div>
        </header>

        <main>
            <slot />
        </main>

        <footer class="site-footer">
            <div class="container footer-content">
                <div>
                    <h3>ShouldISpend</h3>
                    <p>
                        Straight verdicts on the spending decisions that actually matter.
                        Pressure-test major costs against income, savings, debt, and the money left after.
                    </p>
                </div>

                <div class="footer-links">
                    <a href="/calculators/">Calculators</a>
                    <a href="/grocery-calculators/">Groceries</a>
                    <a href="/how-much-debt-is-too-much/">Debt Guide</a>
                    <a href="/about/">About</a>
                    <a href="/contact/">Contact</a>
                    <a href="/methodology/">Methodology</a>
                    <a href="/privacy/">Privacy Policy</a>
                    <a href="/disclaimer/">Disclaimer</a>
                    <a href="/terms/">Terms</a>
                    <a href="/editorial-policy/">Editorial Policy</a>
                </div>
            </div>
        </footer>
    </body>
</html>

<style>
    :root {
        --bg: #fbf8f3;
        --card: #ffffff;
        --surface: #ffffff;
        --surface-warm: #fffdf8;
        --text: #173404;
        --muted: #5f5e5a;
        --primary: #0f6e56;
        --primary-dark: #173404;
        --border: #e3ded3;
        --button: #0f6e56;
        --shadow-soft: 0 16px 34px rgba(23, 52, 4, 0.07);
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: "Outfit", Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .site-header {
        background: rgba(255, 253, 248, 0.96);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(10px);
    }

    .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 0.78rem 1.5rem;
    }

    .logo {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--text);
        white-space: nowrap;
    }

    .logo span {
        color: var(--primary);
    }

    .logo-image {
        display: inline-flex;
        align-items: center;
        line-height: 1;
    }

    .logo-image img {
        display: block;
        height: 58px;
        width: auto;
        max-width: none;
    }

    .site-nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1.05rem;
        font-weight: 700;
        color: var(--muted);
        font-size: 0.88rem;
        white-space: nowrap;
    }

    .site-nav a {
        border-radius: 999px;
        padding: 0.35rem 0.2rem;
        transition: 0.2s ease;
    }

    .site-nav a:hover,
    .footer-links a:hover {
        color: var(--primary);
    }

    .nav-toggle {
        display: none;
    }

    .hamburger {
        display: none;
        width: 2rem;
        height: 1.45rem;
        cursor: pointer;
        flex-direction: column;
        justify-content: space-between;
    }

    .hamburger span {
        display: block;
        height: 3px;
        width: 100%;
        background: var(--primary-dark);
        border-radius: 999px;
    }

    main {
        min-height: 70vh;
    }

    .site-footer {
        margin-top: 96px;
        padding: 56px 24px 32px;
        background: var(--primary-dark);
        color: white;
    }

    .footer-content {
        display: flex;
        justify-content: space-between;
        gap: 48px;
        flex-wrap: wrap;
    }

    .site-footer h3 {
        margin-top: 0;
        margin-bottom: 12px;
        font-size: 1.35rem;
    }

    .site-footer p {
        max-width: 560px;
        color: #e7eadf;
        line-height: 1.75;
    }

    .footer-links {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .footer-links a {
        color: #e7eadf;
        text-decoration: none;
        font-weight: 700;
    }

    .footer-links a:hover {
        color: white;
        text-decoration: underline;
    }

    h3 {
        margin-top: 0;
    }

    @media (max-width: 700px) {
        .nav {
            position: relative;
            padding: 0.7rem 1.25rem;
        }

        .logo-image img {
            height: 46px;
            max-width: none;
        }

        .logo {
            font-size: 1.25rem;
        }

        .hamburger {
            display: flex;
        }

        .site-nav {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: var(--surface-warm);
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 1.25rem 1rem;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.7rem;
            box-shadow: var(--shadow-soft);
        }

        .nav-toggle:checked ~ .site-nav {
            display: flex;
        }

        .site-nav a {
            width: 100%;
            padding: 0.35rem 0;
        }
    }
</style>


