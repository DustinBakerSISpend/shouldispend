---
const {
  eyebrow,
  title,
  description,
} = Astro.props;
---

<section class="calculator-page">
  <div class="calculator-hero">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="description">{description}</p>
  </div>

  <slot />
</section>

<style>
  .calculator-page {
    max-width: 920px;
    margin: 0 auto;
    padding: 56px 24px;
  }

  .calculator-hero {
    text-align: center;
    margin-bottom: 48px;
  }

  .eyebrow {
    color: #0f766e;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    line-height: 0.95;
    margin: 0 auto 24px;
    color: #0f172a;
    max-width: 900px;
  }

  .description {
    color: #334155;
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 720px;
    margin: 0 auto;
  }
</style>