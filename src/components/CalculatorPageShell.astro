---
const {
  eyebrow,
  title,
  description,
} = Astro.props;

const siteUrl = "https://shouldispend.com";

const calculatorSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: title,
  description,
  applicationCategory: "FinanceApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript",
  url: Astro.url.href,
  isAccessibleForFree: true,
  provider: {
    "@type": "Organization",
    name: "ShouldISpend",
    url: siteUrl,
  },
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(calculatorSchema)}
/>

<section class="calculator-page">
  <div class="calculator-hero">
    <p class="eyebrow">{eyebrow}</p>

    <h1>{title}</h1>

    <p class="description">{description}</p>
  </div>

  <slot />
</section>

<style>
  .calculator-page {
    max-width: 920px;
    margin: 0 auto;
    padding: 56px 24px;
  }

  .calculator-hero {
    text-align: center;
    margin-bottom: 48px;
  }

  .eyebrow {
    color: #0f766e;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    line-height: 0.95;
    margin: 0 auto 24px;
    color: #0f172a;
    max-width: 900px;
  }

  .description {
    color: #334155;
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 720px;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .calculator-page {
      padding: 44px 20px;
    }

    .calculator-hero {
      margin-bottom: 40px;
    }

    .description {
      font-size: 1rem;
    }
  }
</style>