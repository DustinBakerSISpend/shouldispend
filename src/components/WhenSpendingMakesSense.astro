---
const {
  title = "When This Spending Makes Sense",
  items = [],
} = Astro.props;
---

<section class="sense-section">
  <h2>{title}</h2>

  <ul>
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>

<style>
  .sense-section {
    margin: 2.5rem 0;
    padding: 1.5rem;
    border-radius: 18px;
    background: #ecfeff;
    border: 1px solid #a5f3fc;
  }

  .sense-section h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #155e75;
  }

  .sense-section ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .sense-section li {
    margin-bottom: 0.75rem;
    line-height: 1.7;
  }
</style>