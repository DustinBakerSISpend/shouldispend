---
const {
  title = "Waiting For Inputs",
  score = null,
  tone = "neutral",
  details = [],
  guidance = "",
  visible = false,
} = Astro.props;
---

<div class={`decision-verdict ${visible ? "visible" : ""}`}>
  <div class="score">
    {title}
    {score !== null && ` - ${score}/100`}
  </div>

  <div class="bar">
    <div class={`fill ${tone}`}></div>
  </div>

  <div class="details">
    {details.map((detail) => (
      <p>{detail}</p>
    ))}
  </div>

  {guidance && (
    <div class="guidance">
      {guidance}
    </div>
  )}

  <div class="disclaimer">
    This is a general educational estimate, not financial advice.
  </div>
</div>

<style>
  .decision-verdict {
    margin-top: 36px;
    background: #f8fafc;
    padding: 32px;
    border-radius: 24px;
    border: 1px solid var(--border);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    display: none;
  }

  .decision-verdict.visible {
    display: block;
  }

  .score {
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 22px;
    line-height: 1.15;
  }

  .bar {
    width: 100%;
    height: 16px;
    background: #dbe4ee;
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 24px;
  }

  .fill {
    height: 100%;
    width: 100%;
    border-radius: 999px;
  }

  .fill.safe {
    background: linear-gradient(
      90deg,
      #0f766e 0%,
      #14b8a6 100%
    );
  }

  .fill.caution {
    background: linear-gradient(
      90deg,
      #ca8a04 0%,
      #facc15 100%
    );
  }

  .fill.danger {
    background: linear-gradient(
      90deg,
      #dc2626 0%,
      #f97316 100%
    );
  }

  .fill.neutral {
    background: #cbd5e1;
  }

  .details {
    color: #334155;
    line-height: 1.9;
    font-size: 1.02rem;
  }

  .details p {
    margin: 0 0 12px;
  }

  .guidance {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid #dbe4ee;
    font-size: 1.12rem;
    line-height: 1.85;
    color: #1e293b;
  }

  .disclaimer {
    margin-top: 24px;
    font-size: 0.9rem;
    color: #64748b;
  }
</style>