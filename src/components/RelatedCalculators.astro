---
const { title = "Related Calculators", calculators = [] } = Astro.props;
---

<section class="related-calculators">
  <h2>{title}</h2>

  <div class="related-grid">
    {calculators.map((calculator) => (
      <a class="related-card" href={calculator.href}>
        <p>{calculator.category}</p>
        <h3>{calculator.title}</h3>
        <span>Open Calculator →</span>
      </a>
    ))}
  </div>
</section>

<style>
  .related-calculators {
    max-width: 920px;
    margin: 72px auto 0;
  }

  .related-calculators h2 {
    font-size: 2rem;
    margin-bottom: 28px;
    color: #0f172a;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .related-card {
    display: block;
    background: white;
    border: 1px solid #dbe3ee;
    border-radius: 18px;
    padding: 26px;
    text-decoration: none;
    color: #0f172a;
  }

  .related-card p {
    margin: 0 0 10px;
    color: #0f766e;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .related-card h3 {
    font-size: 1.25rem;
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .related-card span {
    font-weight: 800;
    color: #0b132b;
  }

  @media (max-width: 700px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>