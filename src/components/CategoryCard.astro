---
const {
  category,
  title,
  description
} = Astro.props;
---

<div class="category-card">
  <div class="category">{category}</div>
  <h3>{title}</h3>
  <p>{description}</p>
</div>

<style>
  .category-card {
    background: white;
    border: 1px solid #dbe3ee;
    border-radius: 20px;
    padding: 28px;
  }

  .category {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #0f766e;
    margin-bottom: 14px;
  }

  h3 {
    font-size: 1.45rem;
    line-height: 1.2;
    margin-bottom: 16px;
    color: #475569;
  }

  p {
    color: #64748b;
    line-height: 1.7;
  }
</style>