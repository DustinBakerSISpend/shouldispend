---
const {
  category,
  title,
  description,
  href
} = Astro.props;
---

<a class="category-card" href={href}>
  <div class="category">{category}</div>
  <h3>{title}</h3>
  <p>{description}</p>
  <span>Browse category &rarr;</span>
</a>

<style>
  .category-card {
    display: block;
    height: 100%;
    background: var(--card, #ffffff);
    border: 1px solid var(--border, #e3ded3);
    border-radius: 20px;
    padding: 28px;
    color: inherit;
    text-decoration: none;
    transition: 0.2s ease;
    box-shadow: 0 0 0 rgba(23, 52, 4, 0);
  }

  .category-card:hover {
    transform: translateY(-3px);
    border-color: var(--primary, #0f6e56);
    box-shadow: var(--shadow-soft, 0 16px 34px rgba(23, 52, 4, 0.07));
  }

  .category {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--primary, #0f6e56);
    margin-bottom: 14px;
  }

  h3 {
    font-size: 1.4rem;
    line-height: 1.2;
    margin: 0 0 16px;
    color: var(--text, #173404);
  }

  p {
    color: var(--muted, #5f5e5a);
    line-height: 1.7;
    margin: 0 0 20px;
  }

  span {
    font-weight: 800;
    color: var(--primary, #0f6e56);
  }
</style>
