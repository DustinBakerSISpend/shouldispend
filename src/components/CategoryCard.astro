---
const {
  category,
  title,
  description,
  href
} = Astro.props;
---

<a class="category-card" href={href}>
  <div class="category">{category}</div>
  <h3>{title}</h3>
  <p>{description}</p>
  <span>Browse category →</span>
</a>

<style>
  .category-card {
    display: block;
    background: white;
    border: 1px solid #dbe3ee;
    border-radius: 20px;
    padding: 28px;
    color: inherit;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-3px);
    border-color: #0f766e;
  }

  .category {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #0f766e;
    margin-bottom: 14px;
  }

  h3 {
    font-size: 1.45rem;
    line-height: 1.2;
    margin-bottom: 16px;
    color: #102a43;
  }

  p {
    color: #64748b;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  span {
    font-weight: 700;
    color: #0f766e;
  }
</style>