---
import { sourceRegistry } from "../data/sourceRegistry.js";
const { category } = Astro.props;
const sources = sourceRegistry.filter((source) => source.category === category);
---
{sources.length > 0 && (
  <section class="source-assumptions-block" aria-labelledby={"sources-"+category.toLowerCase().replace(/[^a-z0-9]+/g,"-")}>
    <div class="source-kicker">Sources &amp; assumptions</div>
    <h2 id={"sources-"+category.toLowerCase().replace(/[^a-z0-9]+/g,"-")}>Outside benchmarks used for context</h2>
    <p>The calculator verdict is driven by the numbers you enter. These sources support outside definitions, cost benchmarks, or consumer rules referenced on this page; they do not endorse ShouldISpend or replace a local quote, plan document, or professional judgment.</p>
    <ul>{sources.map((source) => <li><a href={source.url} rel="noopener noreferrer">{source.publisher}: {source.title}</a><span> - {source.supports}</span></li>)}</ul>
    <p class="source-more"><a href="/sources-and-assumptions/">View all sources and assumptions</a></p>
  </section>
)}
<style>
.source-assumptions-block{margin:42px auto 0;padding:24px;border:1px solid var(--border);border-radius:20px;background:var(--card);max-width:980px}.source-kicker{color:var(--primary);text-transform:uppercase;letter-spacing:1.4px;font-size:.76rem;font-weight:800;margin-bottom:8px}.source-assumptions-block h2{margin:0 0 12px;font-size:1.45rem}.source-assumptions-block p,.source-assumptions-block li{color:var(--muted);line-height:1.7}.source-assumptions-block ul{margin:14px 0;padding-left:1.25rem}.source-assumptions-block a{font-weight:750}.source-more{margin-bottom:0}
</style>
