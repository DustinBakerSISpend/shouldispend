---
const {
  title = "What This Calculator Assumes",
  items = [],
} = Astro.props;
---

<section class="assumptions">
  <h2>{title}</h2>

  <ul>
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>

<style>
  .assumptions {
    margin: 2.5rem 0;
    padding: 1.5rem;
    border-radius: 18px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
  }

  .assumptions h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #1d4ed8;
  }

  .assumptions ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .assumptions li {
    margin-bottom: 0.75rem;
    line-height: 1.7;
  }
</style>