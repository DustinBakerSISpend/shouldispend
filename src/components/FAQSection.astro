---
const { title = "Frequently Asked Questions", faqs = [] } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

{
  faqs.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />
  )
}

<section class="faq-section">
  <h2>{title}</h2>

  <div class="faq-list">
    {faqs.map((faq) => (
      <div class="faq-item">
        <h3>{faq.question}</h3>
        <p>{faq.answer}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .faq-section {
    margin-top: 72px;
  }

  .faq-section h2 {
    font-size: 2rem;
    margin-bottom: 32px;
    color: #0f172a;
    line-height: 1.2;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .faq-item {
    background: white;
    border: 1px solid #dbe3ee;
    border-radius: 18px;
    padding: 28px;
  }

  .faq-item h3 {
    font-size: 1.15rem;
    margin-bottom: 14px;
    color: #0f172a;
    line-height: 1.45;
  }

  .faq-item p {
    line-height: 1.8;
    color: #334155;
    margin: 0;
  }

  @media (max-width: 640px) {
    .faq-item {
      padding: 22px;
    }

    .faq-section h2 {
      font-size: 1.7rem;
    }
  }
</style>