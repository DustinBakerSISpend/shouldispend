---
const { category } = Astro.props;
const copy = {
  Medical: "This calculator does not determine medical urgency, diagnose a condition, confirm insurance coverage, decide whether a bill is correct, or tell you whether delaying care is safe. Use it to understand financial pressure after you have the best available medical and billing information.",
  "Funeral Costs": "This calculator does not decide what a family should value in a memorial, determine legal obligations, confirm insurance or benefit timing, interpret cemetery rules, or replace local itemized quotes. It is a financial pressure check on the costs you enter.",
  College: "This calculator does not predict admission, graduation, future earnings, aid renewal, interest-rate changes, or whether a specific program will deliver the expected career result. Replace estimates with the school's actual aid offer and borrowing terms whenever possible.",
  Rent: "This calculator does not judge lease quality, neighborhood fit, job stability, future rent increases, or costs you leave out. Include utilities, transportation, debt, insurance, and other recurring obligations when they affect your real monthly room.",
  Travel: "This calculator does not decide whether a trip is worth taking, predict airfare or hotel changes, model every meal or activity, or know how much flexibility your household needs after returning home. Use the all-in trip estimate you expect to pay and compare it with the cash flow and savings you actually want to preserve.",
  Weddings: "This calculator does not decide what a celebration should mean to you, predict vendor changes, model every contract term, or know which traditions are important to your family. Use the full amount you expect your household to cover and compare that uncovered cost with savings, debt, and monthly room after the event.",
  Groceries: "This calculator does not determine nutritional needs, food availability, medical dietary requirements, or whether a household should cut essential food. It pressure-tests the recurring food amount you enter against take-home pay, savings, debt, household size, and other food spending."
};
const text = copy[category] || "This calculator cannot model every part of the decision. Replace estimates with your actual numbers whenever possible and use the result as a financial pressure check rather than a substitute for professional or contractual guidance.";
---
<section class="decision-limits-block">
  <div class="limits-kicker">Limits</div>
  <h2>What this calculator does not decide</h2>
  <p>{text}</p>
</section>
<style>
.decision-limits-block{margin:42px auto 0;padding:24px;border:1px solid var(--border);border-radius:20px;background:var(--surface-warm);max-width:980px}.limits-kicker{color:var(--primary);text-transform:uppercase;letter-spacing:1.4px;font-size:.76rem;font-weight:800;margin-bottom:8px}.decision-limits-block h2{margin:0 0 12px;font-size:1.45rem}.decision-limits-block p{margin:0;color:var(--muted);line-height:1.75}
</style>
