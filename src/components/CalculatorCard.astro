---
const {
  category,
  title,
  description,
  href,
  type
} = Astro.props;

const guidePaths = [
  "/how-much-debt-is-too-much",
  "/how-much-house-can-i-afford",
  "/how-much-vacation-can-i-afford",
  "/what-counts-as-debt"
];

const isGuide =
  type === "guide" ||
  guidePaths.includes(href);

const ctaText = isGuide ? "Read Guide" : "Open Calculator";
---

<div class="card">
  <div class="category">{category}</div>

  <h3>{title}</h3>

  <p>{description}</p>

  <a href={href} class="button">
    {ctaText}
  </a>
</div>

<style>
  .card {
    background: white;
    border: 1px solid #dbe3ee;
    border-radius: 20px;
    padding: 28px;
  }

  .category {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #0f766e;
    margin-bottom: 14px;
  }

  h3 {
    font-size: 1.9rem;
    line-height: 1.2;
    margin-bottom: 18px;
    color: #0f172a;
  }

  p {
    color: #475569;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .button {
    display: inline-block;
    background: #0f172a;
    color: white;
    text-decoration: none;
    padding: 14px 22px;
    border-radius: 12px;
    font-weight: 700;
  }
</style>