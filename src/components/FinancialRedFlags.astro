---
const {
  title = "Financial Red Flags",
  items = [],
} = Astro.props;
---

<section class="red-flags">
  <h2>{title}</h2>

  <ul>
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>

<style>
  .red-flags {
    margin: 2.5rem 0;
    padding: 1.5rem;
    border-radius: 18px;
    background: #fff7ed;
    border: 1px solid #fed7aa;
  }

  .red-flags h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #9a3412;
  }

  .red-flags ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .red-flags li {
    margin-bottom: 0.75rem;
    line-height: 1.7;
  }
</style>