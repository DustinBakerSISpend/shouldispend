---
const {
  title = "Ways to Reduce the Cost",
  items = [],
} = Astro.props;
---

<section class="reduce-cost">
  <h2>{title}</h2>

  <ul>
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>

<style>
  .reduce-cost {
    margin: 2.5rem 0;
    padding: 1.5rem;
    border-radius: 18px;
    background: #f0fdf4;
    border: 1px solid #86efac;
  }

  .reduce-cost h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #166534;
  }

  .reduce-cost ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .reduce-cost li {
    margin-bottom: 0.75rem;
    line-height: 1.7;
  }
</style>