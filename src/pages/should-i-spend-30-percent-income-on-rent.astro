---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";

const pageUrl = "https://shouldispend.com/should-i-spend-30-percent-income-on-rent";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is spending 30% of income on rent good?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Spending 30% of income on rent is often a reasonable starting point, but it is not automatically safe. Debt, utilities, take-home pay, savings, and other bills still matter.",
      },
    },
    {
      "@type": "Question",
      name: "Should the 30% rent rule use gross income or take-home pay?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The traditional 30% rule usually uses gross income, but take-home pay is more useful for judging real monthly pressure.",
      },
    },
    {
      "@type": "Question",
      name: "Can 30% rent still be too much?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. A 30% rent payment can still be too much if debt payments are high, savings are weak, utilities are expensive, or the rest of the monthly budget is already tight.",
      },
    },
    {
      "@type": "Question",
      name: "Can spending 30% on rent be very safe?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. If income is high, debt is low, savings are strong, and monthly bills are manageable, 30% rent can be low pressure.",
      },
    },
    {
      "@type": "Question",
      name: "Should utilities count toward the 30% rent rule?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Utilities should be considered separately because they affect real affordability. Rent may be 30% before utilities, but the full housing cost can be higher.",
      },
    },
  ],
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Should I Spend 30% of My Income on Rent Calculator",
  url: pageUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "All",
  description:
    "A 30% rent rule calculator that estimates housing pressure using income, take-home pay, rent, utilities, debt, bills, savings, and move-in costs.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://shouldispend.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Rent Calculators",
      item: "https://shouldispend.com/rent-calculators",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Should I Spend 30% of My Income on Rent?",
      item: pageUrl,
    },
  ],
};
---

<Layout
  title="Should I Spend 30% of My Income on Rent? Calculator | ShouldISpend"
  description="Use this 30% rent calculator to decide whether the classic rent rule fits your take-home pay, debt, utilities, savings, bills, and monthly flexibility."

  noindex={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
      box-sizing: border-box;
    }

    button {
      background: #0f766e;
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
      display: none;
      background: #f8fafc;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
      line-height: 1.05;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }

    .content-section p,
    .content-section li {
      line-height: 1.8;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="30% Rent Rule Calculator"
      title="Should I Spend 30% of My Income on Rent?"
      description="Test whether the classic 30% rent rule actually works after take-home pay, utilities, debt payments, savings, move-in costs, other bills, and real monthly breathing room."
    >
      <div class="card">
        <h2>30% Rent Rule Pressure Verdict</h2>

        <div class="grid">
          <div>
            <label for="grossIncome">Annual Household Income</label>
            <input id="grossIncome" type="number" placeholder="90000" />
          </div>

          <div>
            <label for="takeHomePay">Monthly Take-Home Pay</label>
            <input id="takeHomePay" type="number" placeholder="6000" />
          </div>

          <div>
            <label for="rent">Monthly Rent</label>
            <input id="rent" type="number" placeholder="2250" />
          </div>

          <div>
            <label for="utilities">Utilities, Internet, Parking, Fees</label>
            <input id="utilities" type="number" placeholder="350" />
          </div>

          <div>
            <label for="monthlyDebt">Monthly Debt Payments</label>
            <input id="monthlyDebt" type="number" placeholder="600" />

            <div class="helper-link">
              <a href="/what-counts-as-debt/">
                Not sure what counts as debt? Read the debt guide
              </a>
            </div>
          </div>

          <div>
            <label for="otherBills">Other Monthly Bills</label>
            <input id="otherBills" type="number" placeholder="1600" />
          </div>

          <div>
            <label for="savings">Total Emergency Savings</label>
            <input id="savings" type="number" placeholder="18000" />
          </div>

          <div>
            <label for="movingCost">Estimated Move-In Cost</label>
            <input id="movingCost" type="number" placeholder="5000" />
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="rentButton" type="button">
          Get 30% Rent Verdict
        </button>

        <div class="result" id="result">
          <div class="score" id="score"></div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="housingRatio"></div>
          <div class="metric" id="takeHomeRatio"></div>
          <div class="metric" id="leftoverCash"></div>
          <div class="metric" id="recommendedRent"></div>
          <div class="metric" id="savingsCushion"></div>
          <div class="metric" id="moveInImpact"></div>
          <div class="metric" id="debtPressure"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <h2>Is 30% of Income on Rent Actually Safe?</h2>

        <p>
          Spending 30% of income on rent is one of the most common housing rules,
          but it is only a starting point. It can be a healthy target for some
          renters and still feel too tight for others, depending on take-home
          pay, debt, savings, utilities, transportation, and fixed monthly bills.
        </p>

        <p>
          The 30% rule is especially limited because it usually starts with gross
          income. Real life runs on take-home pay. Taxes, insurance, retirement
          contributions, healthcare premiums, and payroll deductions can make
          the same rent payment feel very different after payday.
        </p>

        <p>
          A good 30% rent decision should still leave room for savings, debt
          payoff, groceries, insurance, transportation, medical costs, and
          emergencies after the lease begins.
        </p>
      </div>

      <div class="content-section">
        <h2>Why the 30% Rule Can Mislead Renters</h2>

        <p>
          The 30% rule does not know whether you have a car payment, credit card
          balance, student loans, childcare, medical bills, irregular income, or
          weak emergency savings. It also does not know whether utilities,
          parking, pet fees, or transportation costs are unusually high.
        </p>

        <p>
          That means 30% can be perfectly comfortable for a high-income, low-debt
          household with strong savings. It can also be stressful for a household
          where the rest of the budget is already crowded.
        </p>
      </div>

      <WhenSpendingMakesSense
        title="When 30% Rent Makes Sense"
        items={[
          "Your take-home pay still leaves room for monthly savings after rent and utilities.",
          "Debt payments are low enough that housing does not crowd out other obligations.",
          "Emergency savings remain strong after deposits, movers, fees, and setup costs.",
          "The apartment supports work, safety, commute time, school access, or family logistics.",
          "Utilities, parking, internet, renter's insurance, pet fees, and transportation costs have been included.",
        ]}
      />

      <div class="content-section">
        <h2>When 30% Rent Can Still Be Too Much</h2>

        <p>
          A 30% rent payment may still be too much if you have high monthly debt,
          low emergency savings, expensive utilities, a long commute, unstable
          income, or large fixed costs outside housing.
        </p>

        <p>
          The warning sign is not the percentage alone. The warning sign is a
          budget that has no room for savings, emergencies, or normal life after
          rent is paid.
        </p>
      </div>

      <KeyCostCategories
        items={[
          {
            title: "Rent plus utilities",
            description:
              "The rent may equal 30% of income before electricity, heat, water, trash, internet, parking, renter's insurance, laundry, pet fees, and storage are counted.",
          },
          {
            title: "Debt payments",
            description:
              "Credit cards, student loans, car payments, medical debt, personal loans, and other recurring obligations can make a 30% rent target feel much tighter.",
          },
          {
            title: "Move-in costs",
            description:
              "Deposits, first month's rent, application fees, movers, furniture, and utility setup can weaken savings before the lease even starts.",
          },
          {
            title: "Cash left after bills",
            description:
              "The most important question is how much money remains after rent, utilities, debt payments, groceries, insurance, transportation, and other core expenses.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Use take-home pay as a second check instead of relying only on gross income.",
          "Compare rent plus utilities, parking, internet, pet fees, and insurance.",
          "Avoid signing if move-in costs would wipe out your emergency fund.",
          "Lower the target below 30% if debt payments or fixed bills are already high.",
          "Check whether a cheaper location would raise commute or transportation costs.",
          "Give yourself room for rent increases, repairs, medical bills, travel, and normal surprises.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "30% rent still leaves little or no room for monthly savings.",
          "You need credit cards for routine spending after paying rent.",
          "Move-in costs would drain most of your emergency savings.",
          "Debt payments already take a large share of take-home pay.",
          "The rent only works if overtime, bonuses, side income, or future raises arrive.",
          "Utilities, parking, insurance, pet fees, and commute costs are not included in your estimate.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "The calculator treats the 30% rent rule as a guideline, not a guarantee of affordability.",
          "Monthly housing cost includes rent plus estimated utilities, internet, parking, renter's insurance, and other required housing fees.",
          "Take-home pay is used to estimate real monthly breathing room.",
          "Move-in costs are treated as an immediate savings hit because deposits, movers, fees, and setup costs can reduce emergency cushion.",
          "The calculator is designed for general education and does not replace personalized financial advice.",
        ]}
      />

      <div class="content-section">
        <h2>Gross Income vs. Take-Home Pay</h2>

        <p>
          The traditional 30% rule usually uses gross income. For example,
          someone earning $90,000 per year has $7,500 in gross monthly income,
          making 30% equal $2,250.
        </p>

        <p>
          But the take-home version may feel different. If that same household
          brings home $6,000 per month, a $2,250 rent payment uses 37.5% of
          take-home pay before utilities. That gap is why this calculator checks
          both numbers.
        </p>
      </div>

      <div class="content-section">
        <h2>Emergency Savings Can Make 30% Rent Safer</h2>

        <p>
          A strong emergency fund gives 30% rent more room to work. If a car
          repair, medical bill, job change, family emergency, or moving surprise
          happens, savings can absorb the shock without turning the lease into
          debt.
        </p>

        <p>
          Thin savings make the same rent percentage riskier. Even a reasonable
          rent ratio can create stress if deposits and move-in costs leave you
          with no cushion.
        </p>
      </div>

      <FAQSection
        title="30% Rent Rule FAQ"
        faqs={[
          {
            question: "Is spending 30% of income on rent good?",
            answer:
              "It is often a reasonable starting point, but it is not automatically safe. Debt, utilities, savings, take-home pay, transportation, and other bills still matter.",
          },
          {
            question: "Should I use gross income or take-home pay for the 30% rent rule?",
            answer:
              "Use both. Gross income is the traditional rule-of-thumb number, but take-home pay is better for judging real monthly breathing room.",
          },
          {
            question: "Can 30% rent still be too much?",
            answer:
              "Yes. A 30% rent payment can still be too much if debt payments are high, emergency savings are weak, utilities are expensive, or the rest of the budget is tight.",
          },
          {
            question: "Can 30% rent be low pressure?",
            answer:
              "Yes. If income is high, debt is low, savings are strong, and monthly bills are controlled, 30% rent can be very manageable.",
          },
          {
            question: "Should utilities count toward 30% rent?",
            answer:
              "Utilities should be included in your real housing budget even if the simple 30% rule only refers to rent. The full housing cost matters more than the rent line alone.",
          },
        ]}
      />

      <MethodologySection category="rent affordability" updated="May 2026" />

      <RelatedGuides
        guides={[
          {
            title: "How Much Rent Can I Afford?",
            href: "/how-much-rent-can-i-afford",
            description:
              "Use the broader rent affordability guide to compare income, take-home pay, debt, utilities, savings, and monthly flexibility.",
          },
          {
            title: "What Counts as Debt?",
            href: "/what-counts-as-debt",
            description:
              "See which monthly obligations should be included when judging housing pressure.",
          },
          {
            title: "How Much Emergency Savings Should I Have?",
            href: "/how-much-emergency-savings-should-i-have",
            description:
              "Estimate how much cushion to keep before signing a lease or draining savings on move-in costs.",
          },
        ]}
      />

      <RelatedCalculators
        calculators={[
          {
            category: "Rent",
            title: "Should I Spend $1,500 on Rent?",
            href: "/should-i-spend-1500-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend $2,500 on Rent?",
            href: "/should-i-spend-2500-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend 40% of My Income on Rent?",
            href: "/should-i-spend-40-percent-income-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend 50% of My Income on Rent?",
            href: "/should-i-spend-50-percent-income-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend 60% of My Income on Rent?",
            href: "/should-i-spend-60-percent-income-on-rent",
          },
        ]}
      />
    </CalculatorPageShell>
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const formatMoney = (value) => {
      return Math.round(value).toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          color: "#16a34a",
          action:
            "This rent ratio appears manageable, but verify the full housing cost and post-move emergency cushion before signing.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          color: "#ca8a04",
          action:
            "This rent ratio may work, but compare the full housing cost against take-home pay, debt, and savings.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        color: "#dc2626",
        action:
          "This rent ratio could create serious strain. Consider lower rent, lower debt, stronger savings, or more income first.",
      };
    }

    function calculateRent() {
      const grossIncome = getNumber("grossIncome");
      const takeHomePay = getNumber("takeHomePay");
      const rent = getNumber("rent");
      const utilities = getNumber("utilities");
      const monthlyDebt = getNumber("monthlyDebt");
      const otherBills = getNumber("otherBills");
      const savings = getNumber("savings");
      const movingCost = getNumber("movingCost");

      const result = document.getElementById("result");
      const scoreEl = document.getElementById("score");
      const barFill = document.getElementById("barFill");
      const housingRatioEl = document.getElementById("housingRatio");
      const takeHomeRatioEl = document.getElementById("takeHomeRatio");
      const leftoverCashEl = document.getElementById("leftoverCash");
      const recommendedRentEl = document.getElementById("recommendedRent");
      const savingsCushionEl = document.getElementById("savingsCushion");
      const moveInImpactEl = document.getElementById("moveInImpact");
      const debtPressureEl = document.getElementById("debtPressure");
      const guidanceEl = document.getElementById("guidance");

      result.style.display = "block";

      if (grossIncome <= 0 || takeHomePay <= 0 || rent <= 0) {
        scoreEl.textContent = "Add your numbers first";
        barFill.style.width = "0%";
        barFill.style.background = "#16a34a";
        housingRatioEl.innerHTML = "";
        takeHomeRatioEl.innerHTML = "";
        leftoverCashEl.innerHTML = "";
        recommendedRentEl.innerHTML = "";
        savingsCushionEl.innerHTML = "";
        moveInImpactEl.innerHTML = "";
        debtPressureEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter positive numbers for annual income, monthly take-home pay, and rent so the calculator can estimate housing pressure.";
        return;
      }

      const monthlyGrossIncome = grossIncome / 12;
      const totalHousingCost = rent + utilities;
      const totalCommittedMonthly = totalHousingCost + monthlyDebt + otherBills;
      const leftoverAfterBills = takeHomePay - totalCommittedMonthly;
      const housingGrossRatio = (totalHousingCost / monthlyGrossIncome) * 100;
      const housingTakeHomeRatio = (totalHousingCost / takeHomePay) * 100;
      const debtTakeHomeRatio = (monthlyDebt / takeHomePay) * 100;
      const leftoverRatio = (leftoverAfterBills / takeHomePay) * 100;
      const postMoveSavings = savings - movingCost;
      const postMoveSavingsMonths =
        totalCommittedMonthly > 0 ? postMoveSavings / totalCommittedMonthly : 0;
      const emergencyMonths =
        totalCommittedMonthly > 0 ? savings / totalCommittedMonthly : 0;
      const moveInSavingsImpact =
        savings > 0 ? (movingCost / savings) * 100 : movingCost > 0 ? 100 : 0;

      const conservativeRent = Math.max(0, Math.min(monthlyGrossIncome * 0.25, takeHomePay * 0.28));
      const balancedRent = Math.max(0, Math.min(monthlyGrossIncome * 0.3, takeHomePay * 0.35));
      const stretchRent = Math.max(0, Math.min(monthlyGrossIncome * 0.4, takeHomePay * 0.45));

      let pressureScore = 0;

      pressureScore += clamp((housingGrossRatio - 20) * 1.05, 0, 28);
      pressureScore += clamp((housingTakeHomeRatio - 25) * 1.15, 0, 34);
      pressureScore += clamp(debtTakeHomeRatio * 0.55, 0, 16);

      if (leftoverAfterBills < 0) {
        pressureScore += 28;
      } else if (leftoverRatio < 8) {
        pressureScore += 20;
      } else if (leftoverRatio < 15) {
        pressureScore += 12;
      } else if (leftoverRatio >= 35) {
        pressureScore -= 8;
      } else if (leftoverRatio >= 25) {
        pressureScore -= 4;
      }

      if (savings <= 0 && movingCost > 0) {
        pressureScore += 18;
      } else if (postMoveSavings < 0) {
        pressureScore += 20;
      } else if (postMoveSavingsMonths < 1 && grossIncome < 120000) {
        pressureScore += 16;
      } else if (postMoveSavingsMonths < 3 && grossIncome < 180000) {
        pressureScore += 10;
      } else if (postMoveSavingsMonths >= 6) {
        pressureScore -= 8;
      }

      if (moveInSavingsImpact >= 75) pressureScore += 12;
      else if (moveInSavingsImpact >= 50) pressureScore += 8;
      else if (moveInSavingsImpact <= 10 && savings > 0) pressureScore -= 3;

      if (housingGrossRatio >= 60) pressureScore += 18;
      else if (housingGrossRatio >= 50) pressureScore += 12;
      else if (housingGrossRatio >= 40) pressureScore += 7;

      if (housingTakeHomeRatio >= 65) pressureScore += 20;
      else if (housingTakeHomeRatio >= 55) pressureScore += 14;
      else if (housingTakeHomeRatio >= 45) pressureScore += 8;

      if (
        housingGrossRatio < 22 &&
        housingTakeHomeRatio < 28 &&
        leftoverRatio >= 30 &&
        emergencyMonths >= 4 &&
        debtTakeHomeRatio < 10
      ) {
        pressureScore -= 12;
      }

      if (
        housingGrossRatio < 12 &&
        housingTakeHomeRatio < 16 &&
        leftoverRatio >= 50 &&
        emergencyMonths >= 8 &&
        debtTakeHomeRatio < 5
      ) {
        pressureScore = Math.min(pressureScore, 10);
      }

      if (
        housingGrossRatio < 6 &&
        housingTakeHomeRatio < 8 &&
        leftoverRatio >= 65 &&
        emergencyMonths >= 12 &&
        debtTakeHomeRatio < 3
      ) {
        pressureScore = 0;
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      let guidance = "";

      if (pressureScore === 0) {
        guidance =
          `This ${formatMoney(rent)} rent payment appears financially tiny relative to the numbers provided. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, leaving substantial flexibility. The decision is mainly about lease terms, location value, and opportunity cost.`;
      } else if (pressureScore <= 30) {
        guidance =
          `This ${formatMoney(rent)} rent payment appears manageable based on the numbers provided. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, while leaving about ${formatMoney(leftoverAfterBills)} after listed housing, debt, and bill obligations.`;
      } else if (pressureScore <= 60) {
        guidance =
          `This ${formatMoney(rent)} rent payment may work, but it deserves caution. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, so utilities, debt payments, move-in costs, and emergency savings should be checked carefully before signing.`;
      } else {
        guidance =
          `This ${formatMoney(rent)} rent payment could create significant financial pressure. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, which may leave too little flexibility after debt, bills, savings needs, and emergencies.`;
      }

      scoreEl.textContent = `${level.label}  -  ${pressureScore}/100`;
      barFill.style.width = `${pressureScore}%`;
      barFill.style.background = level.color;

      housingRatioEl.innerHTML = `<strong>Housing-to-gross-income ratio:</strong> ${housingGrossRatio.toFixed(1)}%`;
      takeHomeRatioEl.innerHTML = `<strong>Housing-to-take-home-pay ratio:</strong> ${housingTakeHomeRatio.toFixed(1)}%`;
      leftoverCashEl.innerHTML = `<strong>Estimated leftover after listed bills:</strong> ${formatMoney(leftoverAfterBills)}`;
      recommendedRentEl.innerHTML = `<strong>Estimated rent range:</strong> ${formatMoney(conservativeRent)} conservative / ${formatMoney(balancedRent)} balanced / ${formatMoney(stretchRent)} stretch`;
      savingsCushionEl.innerHTML = `<strong>Emergency cushion:</strong> ${emergencyMonths.toFixed(1)} months before move-in / ${postMoveSavingsMonths.toFixed(1)} months after move-in costs`;
      moveInImpactEl.innerHTML = `<strong>Move-in savings impact:</strong> ${moveInSavingsImpact.toFixed(1)}% of savings`;
      debtPressureEl.innerHTML = `<strong>Debt payment pressure:</strong> ${debtTakeHomeRatio.toFixed(1)}% of take-home pay`;
      guidanceEl.textContent = `${guidance} Recommended next step: ${level.action}`;
    }

    document
      .getElementById("rentButton")
      .addEventListener("click", calculateRent);
  </script>
</Layout>
