  "/should-i-spend-15000-on-a-honeymoon/",
  "/should-i-spend-20000-on-a-family-vacation/",
  "/should-i-spend-20000-on-an-african-safari/",
  "/should-i-spend-25000-on-a-luxury-vacation/",
];

const travelCalculators = calculators
  .filter((calculator) => calculator.category === "Travel")
  .sort((a, b) => {
    const aIndex = travelOrder.indexOf(a.href);
    const bIndex = travelOrder.indexOf(b.href);
    const aRank = aIndex === -1 ? 999 : aIndex;
    const bRank = bIndex === -1 ? 999 : bIndex;
    if (aRank !== bRank) return aRank - bRank;
    return a.title.localeCompare(b.title);
  });
const travelFaqs = [
  {
    question: "How much should I spend on a vacation?",
    answer:
      "The right amount depends on income, savings, debt, emergency funds, family size, and upcoming obligations. A vacation should not damage your ability to pay normal bills or recover financially after the trip.",
  },
  {
    question: "Should I use savings or finance a vacation?",
    answer:
      "Savings are usually safer than financing. High-interest travel debt can turn a good trip into months of financial stress after you return home.",
  },
  {
    question: "What travel costs do people forget?",
    answer:
      "Commonly forgotten costs include checked bags, tips, rideshares, parking, resort fees, excursions, museum tickets, snacks, phone plans, travel insurance, passports, and emergency expenses.",
  },
  {
    question: "Is an expensive vacation ever worth it?",
    answer:
      "Yes, an expensive vacation can be worth it if the trip is a real priority, the full cost is planned honestly, and the expense does not create debt pressure or drain your emergency fund.",
  },
  {
    question: "How do I make a trip cheaper without ruining it?",
    answer:
      "Reduce the number of travel days, choose fewer paid activities, use cheaper dates, book lodging with a kitchen, limit souvenirs, avoid unnecessary upgrades, and build more free time into the itinerary.",
