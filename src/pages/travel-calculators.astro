];

const pressureFactors = [
  {
    title: "Take-home income",
    text:
      "Vacation affordability should be measured against money actually available after taxes, deductions, and normal bills.",
  },
  {
    title: "Emergency savings",
    text:
      "A trip becomes riskier when it drains the cash needed for medical bills, car repairs, job changes, or home problems.",
  },
  {
    title: "Debt added",
    text:
      "Credit cards, personal loans, buy-now-pay-later plans, and travel financing can make a short trip create long-term pressure.",
  },
  {
    title: "Trip timing",
    text:
      "A vacation is easier to afford when it does not collide with moving costs, tuition, holidays, medical bills, car repairs, or wedding spending.",
  },
  {
    title: "Family size",
    text:
      "A family trip multiplies flights, food, tickets, rooms, souvenirs, and backup costs faster than many people expect.",
  },
  {
    title: "Hidden costs",
    text:
      "The safest trip budget includes the small costs that show up every day, not just flights and hotels.",
  },
];

const reduceCostTips = [
  {
    title: "Shorten the trip before cutting the good parts",
    text:
      "One fewer night can lower lodging, food, transportation, parking, and activity costs without making the whole trip feel cheap.",
  },
  {
    title: "Pick cheaper dates",
    text:
      "Flexible dates can reduce airfare, hotels, rental cars, park tickets, and crowds at the same time.",
  },
  {
    title: "Build in free time",
    text:
      "A trip packed with paid activities can become expensive and exhausting. Free time protects both the budget and the experience.",
  },
  {
    title: "Limit upgrades",
    text:
      "Rooms, seats, rental cars, views, packages, and premium add-ons should be intentional, not automatic.",
  },
  {
    title: "Plan food realistically",
    text:
      "Lodging with breakfast, grocery stops, snacks, and simple meals can reduce restaurant pressure without ruining the trip.",
  },
  {
    title: "Avoid travel debt",
    text:
      "A trip paid off before departure usually feels different from a trip that follows you home on a credit card.",
  },
];

const redFlags = [
  "The trip would go mostly on a credit card.",
  "The vacation would drain emergency savings.",
  "The budget only includes flights and lodging.",
  "The trip happens right before a major bill, move, tuition payment, or wedding.",
  "The traveler is assuming future overtime, bonuses, or tax refunds will fix the cost.",
  "The family is cutting basics at home to afford upgrades on the trip.",
  "The return-home budget is not planned.",
  "The trip is being booked because of pressure, comparison, or fear of missing out.",
];

const assumptions = [
  "Monthly income means take-home pay, not gross income.",
  "Travel affordability includes flights, lodging, transportation, food, activities, fees, insurance, and return-home pressure.",
  "Savings are safer than high-interest travel debt.",
  "A vacation is less risky when emergency savings remain strong afterward.",
  "Family trips usually need a larger buffer because many costs multiply by traveler count.",
  "A more expensive trip can make sense when it is planned, prioritized, and does not weaken essential bills.",
];

const relatedGuides = [
  {
    href: "/should-i-spend-8000-on-a-disney-vacation/",
    title: "$8,000 Disney Vacation Calculator",
    text:
      "Check tickets, hotels, food, souvenirs, add-ons, park-day pressure, savings, and family cash flow.",
  },
  {
    href: "/should-i-spend-12000-on-a-cruise/",
    title: "$12,000 Cruise Calculator",
    text:
      "Account for gratuities, excursions, drink packages, flights, onboard spending, and port costs.",
  },
  {
    href: "/should-i-spend-15000-on-a-honeymoon/",
    title: "$15,000 Honeymoon Calculator",
    text:
      "Balance milestone memories with wedding costs, savings, debt, and first-year cash flow.",
  },
  {
    href: "/how-much-emergency-savings-should-i-have/",
    title: "Emergency Savings Calculator",
    text:
      "See how much cushion to preserve before committing money to travel.",
  },
  {
    href: "/how-much-debt-is-too-much/",
    title: "Debt Pressure Calculator",
    text:
      "Understand whether existing debt leaves enough room for travel spending.",
  },
  {
    href: "/calculators/",
    title: "All ShouldISpend Calculators",
    text:
      "Browse calculators for travel, rent, groceries, cars, weddings, college, medical bills, and more.",
  },
];

const internalLinks = [
  { href: "/how-much-vacation-can-i-afford/", label: "vacation affordability" },
  { href: "/flight-cost-calculator/", label: "flight cost" },
  { href: "/road-trip-calculator/", label: "road trip" },
  { href: "/hotel-and-lodging-cost-calculator/", label: "hotel and lodging" },
  { href: "/vacation-food-budget-calculator/", label: "food budget" },
  { href: "/rental-car-cost-calculator/", label: "rental car" },
  { href: "/travel-activities-and-excursions-cost-calculator/", label: "activities" },
  { href: "/travel-insurance-cost-calculator/", label: "travel insurance" },
  { href: "/should-i-spend-3000-on-a-weekend-getaway/", label: "$3,000 weekend" },
  { href: "/should-i-spend-5000-on-a-vacation/", label: "$5,000 vacation" },
  { href: "/should-i-spend-8000-on-a-disney-vacation/", label: "$8,000 Disney" },
  { href: "/should-i-spend-10000-on-a-europe-trip/", label: "$10,000 Europe" },
  { href: "/should-i-spend-12000-on-a-cruise/", label: "$12,000 cruise" },
  { href: "/should-i-spend-15000-on-a-honeymoon/", label: "$15,000 honeymoon" },
  { href: "/should-i-spend-20000-on-a-family-vacation/", label: "$20,000 family trip" },
  { href: "/calculators/", label: "all calculators" },
