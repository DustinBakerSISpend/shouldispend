import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const travelOrder = [
  "/how-much-vacation-can-i-afford/",
  "/flight-cost-calculator/",
  "/road-trip-calculator/",
  "/hotel-and-lodging-cost-calculator/",
  "/vacation-food-budget-calculator/",
  "/rental-car-cost-calculator/",
  "/travel-activities-and-excursions-cost-calculator/",
  "/travel-insurance-cost-calculator/",
