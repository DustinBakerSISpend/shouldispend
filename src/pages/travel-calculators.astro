  "/should-i-spend-5000-on-a-vacation/",
  "/should-i-spend-7500-on-an-all-inclusive-vacation/",
  "/should-i-spend-4000-on-a-mexico-vacation/",
  "/should-i-spend-10000-on-a-europe-trip/",
  "/should-i-spend-15000-on-an-italy-trip/",
  "/should-i-spend-15000-on-a-japan-trip/",
