  },
  {
    href: "/rental-car-cost-calculator/",
    title: "Rental Car Cost Calculator",
    text:
      "Estimate rental car cost after taxes, insurance, fuel, tolls, parking, card holds, credits, and alternatives.",
  },
  {
    href: "/travel-activities-and-excursions-cost-calculator/",
    title: "Travel Activities and Excursions Cost Calculator",
    text:
      "Estimate tickets, tours, excursions, rentals, activity transport, tips, credits, nonrefundable risk, and itinerary pressure.",
  },
  {
    href: "/travel-insurance-cost-calculator/",
    title: "Travel Insurance Cost Calculator",
    text:
      "Estimate insurance premium cost against nonrefundable trip exposure, medical risk, existing coverage, credits, and pressure.",
  },
  {
    href: "/should-i-spend-5000-on-a-vacation/",
    title: "$5,000 Vacation Calculator",
    text:
      "Estimate whether a standard vacation fits your current budget without creating debt or draining savings.",
  },
  {
    href: "/should-i-spend-10000-on-a-europe-trip/",
    title: "$10,000 Europe Trip Calculator",
    text:
      "Evaluate flights, hotels, trains, museums, meals, currency cushion, and the cost of coming home.",
  },
  {
    href: "/should-i-spend-20000-on-a-family-vacation/",
    title: "$20,000 Family Vacation Calculator",
    text:
      "Measure airfare multipliers, larger rooms, meals, activities, kid costs, savings drawdown, and debt pressure.",
  },
];

const travelCostFactors = [
  {
    title: "Flights and transportation",
    text:
      "Airfare, checked bags, seat selection, parking, rideshares, rental cars, trains, ferries, fuel, and airport transfers can change the real trip cost quickly.",
  },
  {
    title: "Lodging and fees",
    text:
      "Hotels, rentals, resort fees, cleaning fees, taxes, deposits, parking, and required minimum stays can push the total beyond the nightly rate.",
  },
  {
    title: "Food and daily spending",
    text:
      "Meals, snacks, drinks, groceries, coffee, tips, room service, and convenience spending can quietly add hundreds or thousands to a trip.",
  },
  {
    title: "Activities and tickets",
    text:
      "Theme parks, museums, excursions, tours, shows, rentals, lessons, and timed-entry tickets should be part of the budget before booking.",
  },
  {
    title: "Travel documents and insurance",
    text:
      "Passports, visas, travel insurance, phone plans, vaccines, baggage protection, and emergency expenses may matter depending on the destination.",
