---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import { calculators } from "../data/calculators.js";

const stationeryFaqs = [
  {
    question: "How much do wedding invitations cost?",
    answer:
      "Wedding invitation cost depends on household count, print method, paper quality, number of inserts, envelopes, liners, addressing, postage, assembly, design fees, proofs, reprints, and whether you also need save-the-dates or day-of stationery.",
  },
  {
    question: "Should I calculate invitations by guest count or household count?",
    answer:
      "Invitation suites are usually mailed by household, not by individual guest. A 150-guest wedding may need far fewer than 150 mailed invitations if couples, families, and roommates share one envelope.",
  },
  {
    question: "What counts as wedding stationery?",
    answer:
      "Stationery can include save-the-dates, invitation suites, RSVP cards, detail cards, envelopes, postage, thank-you cards, programs, menus, place cards, escort cards, table numbers, signage, and welcome notes.",
  },
  {
    question: "Why is postage so important for invitations?",
    answer:
      "Postage can become expensive when suites are heavy, oversized, square, wax-sealed, rigid, or include extra envelopes. Couples should price postage before ordering final paper and inserts.",
  },
  {
    question: "How can I lower invitation and stationery costs?",
    answer:
      "The biggest levers are household count, digital save-the-dates, fewer inserts, lighter paper, standard envelope sizes, digital RSVPs, simpler printing, fewer day-of paper items, and avoiding rush reprints.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "Weddings" &&
      calculator.href !== "/wedding-invitations-and-stationery-cost-calculator"
  )
  .slice(0, 4);
---

<Layout
  title="Wedding Invitations and Stationery Cost Calculator"
  description="Estimate wedding invitation costs including save-the-dates, inserts, envelopes, postage, addressing, day-of paper, thank-you cards, and tax."
>


  <style>
    .container {
      max-width: 940px;
      margin: auto;
    }

    .calculator {
      background: var(--card);
      padding: 40px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: var(--text);
      letter-spacing: -0.03em;
    }

    .calculator-intro {
      color: var(--muted);
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: var(--text);
    }

    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid var(--border);
      font-size: 1rem;
      box-sizing: border-box;
      background: #ffffff;
      color: var(--text);
    }

    .field input:focus,
    .field select:focus {
      outline: 3px solid rgba(15, 110, 86, 0.18);
      border-color: var(--primary);
    }

    button {
      margin-top: 30px;
      background: var(--button);
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
      transform: translateY(-1px);
    }

    .results {
      margin-top: 36px;
      background: var(--surface-warm);
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-soft);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .result-label {
      font-size: 0.86rem;
      font-weight: 900;
      color: var(--primary);
      margin-bottom: 14px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .total-price {
      font-size: clamp(2.55rem, 6vw, 4.25rem);
      font-weight: 950;
      color: var(--text);
      line-height: 1.02;
      margin-bottom: 10px;
      letter-spacing: -0.055em;
    }

    .pressure-pill {
      display: inline-flex;
      align-items: center;
      margin: 8px 0 22px;
      padding: 9px 13px;
      border-radius: 999px;
      background: #eef8f3;
      color: var(--primary-dark);
      font-weight: 900;
      border: 1px solid #cfeee1;
    }

    .pressure-meter {
      width: 100%;
      height: 14px;
      background: #e7eadf;
      border-radius: 999px;
      overflow: hidden;
      margin: 10px 0 24px;
    }

    .pressure-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #0f6e56, #b45309, #b91c1c);
      border-radius: 999px;
      transition: width 0.25s ease;
    }

    .result-details {
      color: var(--muted);
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .mini-summary,
    .mailing-check {
      margin-top: 24px;
      padding: 20px;
      border-radius: 18px;
      background: #ffffff;
      border: 1px solid var(--border);
      color: var(--muted);
      line-height: 1.8;
    }

    .mailing-check strong,
    .mini-summary strong {
      color: var(--text);
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.7;
    }

    .content-section {
      margin-top: 62px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 18px;
      color: var(--text);
      letter-spacing: -0.03em;
    }

    .content-section p,
    .content-section li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: var(--muted);
    }

    .content-link {
      color: var(--primary);
      font-weight: 800;
      text-decoration: none;
    }

    .content-link:hover {
      text-decoration: underline;
    }

    .red-flags {
      margin-top: 62px;
      background: #fff7f7;
      border: 1px solid #fecaca;
      border-radius: 24px;
      padding: 32px;
    }

    .red-flags h2 {
      margin-top: 0;
      color: #7f1d1d;
      letter-spacing: -0.03em;
    }

    .red-flags p,
    .red-flags li {
      color: #7f1d1d;
      line-height: 1.8;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Wedding Invitations and Stationery Cost Calculator"
      title="Wedding Invitations and Stationery Cost Calculator"
      description="Estimate save-the-dates, invitation suites, inserts, envelopes, postage, addressing, assembly, day-of paper, thank-you cards, tax, and stationery budget pressure."
    >
      <div class="calculator">
        <h2>Estimate Wedding Invitations and Stationery Cost</h2>

        <p class="calculator-intro">
          Wedding stationery is not just the invitation. It can include
          save-the-dates, mailed suites, RSVP cards, envelope addressing, postage,
          thank-you cards, programs, menus, place cards, table numbers, signage,
          rush reprints, and day-of paper. This calculator focuses on the mailing
          math and the paper trail before, during, and after the wedding.
        </p>

        <div class="grid">
          <div class="field">
            <label for="guestCount">Guest Count</label>
            <input id="guestCount" type="number" placeholder="Example: 150" />
          </div>

          <div class="field">
            <label for="householdCount">Mailed Invitation Households</label>
            <input id="householdCount" type="number" placeholder="Example: 85" />
          </div>

          <div class="field">
            <label for="extraSuitePercent">Extra Suites Percentage</label>
            <input id="extraSuitePercent" type="number" placeholder="Example: 10" />
          </div>

          <div class="field">
            <label for="printStyle">Print Style</label>
            <select id="printStyle">
              <option value="" selected disabled>Select print style</option>
              <option value="digital">Digital or template print</option>
              <option value="semicustom">Semi-custom suite</option>
              <option value="foil">Foil, letterpress, or premium print</option>
              <option value="luxury">Luxury custom stationery</option>
            </select>
          </div>

          <div class="field">
            <label for="saveDateCost">Save-the-Date Cost per Household</label>
            <input id="saveDateCost" type="number" placeholder="Example: 2.50" />
          </div>

          <div class="field">
            <label for="inviteSuiteCost">Invitation Suite Cost per Household</label>
            <input id="inviteSuiteCost" type="number" placeholder="Example: 6.50" />
          </div>

          <div class="field">
            <label for="insertCardsCost">Extra Insert Cards per Household</label>
            <input id="insertCardsCost" type="number" placeholder="Example: 1.75" />
          </div>

          <div class="field">
            <label for="envelopeUpgradeCost">Envelope, Liner, or Wax Upgrade per Household</label>
            <input id="envelopeUpgradeCost" type="number" placeholder="Example: 1.25" />
          </div>

          <div class="field">
            <label for="addressingCost">Addressing or Calligraphy per Household</label>
            <input id="addressingCost" type="number" placeholder="Example: 2.00" />
          </div>

          <div class="field">
            <label for="assemblyCost">Assembly or Mailing Service per Household</label>
            <input id="assemblyCost" type="number" placeholder="Example: 1.50" />
          </div>

          <div class="field">
            <label for="postagePerSuite">Postage per Mailed Suite</label>
            <input id="postagePerSuite" type="number" placeholder="Example: 1.36" />
          </div>

          <div class="field">
            <label for="rsvpPostage">RSVP Postage per Household</label>
            <input id="rsvpPostage" type="number" placeholder="Example: 0.68" />
          </div>

          <div class="field">
            <label for="designFee">Design, Proof, or Setup Fee</label>
            <input id="designFee" type="number" placeholder="Example: 350" />
          </div>

          <div class="field">
            <label for="sampleProofCost">Samples, Proofs, or Test Prints</label>
            <input id="sampleProofCost" type="number" placeholder="Example: 75" />
          </div>

          <div class="field">
            <label for="rushReprintCost">Rush, Reprint, or Mistake Buffer</label>
            <input id="rushReprintCost" type="number" placeholder="Example: 150" />
          </div>

          <div class="field">
            <label for="programCount">Programs, Menus, or Place Cards Count</label>
            <input id="programCount" type="number" placeholder="Example: 150" />
          </div>

          <div class="field">
            <label for="programCost">Day-of Paper Cost Each</label>
            <input id="programCost" type="number" placeholder="Example: 2.25" />
          </div>

          <div class="field">
            <label for="signageCost">Signage, Seating Chart, or Table Numbers</label>
            <input id="signageCost" type="number" placeholder="Example: 400" />
          </div>

          <div class="field">
            <label for="thankYouCount">Thank-You Cards Count</label>
            <input id="thankYouCount" type="number" placeholder="Example: 100" />
          </div>

          <div class="field">
            <label for="thankYouCost">Thank-You Card Cost Each</label>
            <input id="thankYouCost" type="number" placeholder="Example: 1.75" />
          </div>

          <div class="field">
            <label for="thankYouPostage">Thank-You Postage Each</label>
            <input id="thankYouPostage" type="number" placeholder="Example: 0.68" />
          </div>

          <div class="field">
            <label for="taxRate">Tax Rate Percentage</label>
            <input id="taxRate" type="number" placeholder="Example: 8" />
          </div>

          <div class="field">
            <label for="weddingBudget">Total Wedding Budget</label>
            <input id="weddingBudget" type="number" placeholder="Example: 30000" />
          </div>

          <div class="field">
            <label for="stationeryFund">Cash Available for Stationery</label>
            <input id="stationeryFund" type="number" placeholder="Example: 1500" />
          </div>

          <div class="field">
            <label for="outsideHelp">Family Help or Stationery Contribution</label>
            <input id="outsideHelp" type="number" placeholder="Example: 300" />
          </div>

          <div class="field">
            <label for="monthsUntilWedding">Months Until Wedding</label>
            <input id="monthsUntilWedding" type="number" placeholder="Example: 10" />
          </div>

          <div class="field">
            <label for="monthlyIncome">Monthly Take-Home Income</label>
            <input id="monthlyIncome" type="number" placeholder="Example: 6500" />
          </div>

          <div class="field">
            <label for="emergencySavings">Emergency Savings After Paying</label>
            <input id="emergencySavings" type="number" placeholder="Example: 12000" />
          </div>

          <div class="field">
            <label for="currentWeddingDebt">Current Wedding Debt</label>
            <input id="currentWeddingDebt" type="number" placeholder="Example: 0" />
          </div>

          <div class="field">
            <label for="stationeryPriority">Stationery Priority</label>
            <select id="stationeryPriority">
              <option value="" selected disabled>Select stationery priority</option>
              <option value="low">Stationery is flexible</option>
              <option value="medium">Stationery matters, but budget matters too</option>
              <option value="high">Stationery is a top priority</option>
            </select>
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="stationeryButton" type="button">Calculate Stationery Cost</button>

        <div class="results" id="results">
          <div class="result-label">Estimated Stationery Cost</div>

          <div class="total-price" id="totalPrice"></div>

          <div class="pressure-pill" id="pressurePill"></div>

          <div class="pressure-meter" aria-hidden="true">
            <div class="pressure-fill" id="pressureFill"></div>
          </div>

          <div class="result-details" id="resultDetails"></div>

          <div class="mailing-check" id="mailingCheck"></div>

          <div class="mini-summary" id="stationerySummary"></div>

          <div class="disclaimer">
            This estimate is educational and uses simplified assumptions. Actual
            stationery, postage, design, printing, tax, rush, and mailing costs may
            calculate differently.
          </div>
        </div>
      </div>

<OmniStyleReviewBlock
      pageName="the wedding invitations and stationery cost calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="wedding invitations, save-the-dates, inserts, envelopes, postage, addressing, day-of paper, thank-you cards, guest count, savings, debt, and wedding budget pressure"
    />

    <CorePageExamplesBlock
      title="Wedding invitations and stationery examples"
      intro="Wedding paper costs usually grow with guest count and extras. The pressure comes from printing, inserts, postage, addressing, day-of signage, and thank-you cards together."
      useCases={[
          "You are estimating wedding invitation and stationery costs.",
          "You need to include save-the-dates, invitation suites, postage, addressing, day-of paper, and thank-you cards.",
          "You want to compare paper spending with the total wedding budget."
        ]}
      notEnough={[
          "You need design, printing, etiquette, or vendor recommendations.",
          "You need contract or cancellation advice.",
          "You are deciding based on family expectations or style preferences beyond finances."
        ]}
      examples={[
          {
            label: "Digital save-the-dates",
            takeaway: "Pressure may drop if digital options replace some printed pieces."
          },
          {
            label: "Large guest list",
            takeaway: "Costs multiply through postage, envelopes, inserts, and thank-you cards."
          },
          {
            label: "Premium suite",
            takeaway: "Upgrades can fit if lower-priority categories shrink elsewhere."
          }
        ]}
      commonMistake="Counting invitations only and forgetting postage, addressing, inserts, day-of paper, thank-you cards, and reprints."
      nextStep="Estimate cost per household mailed, then add day-of paper and thank-you cards."
    />



      <section class="content-section">
        <h2>Why Invitations and Stationery Need Their Own Calculator</h2>

        <p>
          Wedding stationery is easy to undercount because it is scattered across
          the whole timeline. Save-the-dates happen early. Invitation suites happen
          later. Postage arrives at mailing time. Programs, menus, place cards, and
          signage show up close to the wedding. Thank-you cards come after.
        </p>

        <p>
          That makes this calculator different from photography, music, flowers,
          and catering. It focuses on households, postage, inserts, addressing,
          day-of paper, reprint risk, and the small costs that multiply quietly.
        </p>

        <p>
          For the bigger picture, compare this result with the
          <a class="content-link" href="/wedding-calculators/">
            wedding budget calculators hub
          </a>
          or the
          <a class="content-link" href="/wedding-dj-and-music-cost-calculator/">
            wedding DJ and music cost calculator
          </a>.
        </p>
      </section>

      <KeyCostCategories
        items={[
          {
            title: "Household count",
            description:
              "Invitations are usually mailed by household, not guest count, so the number of mailed suites can be very different from the number of invited people.",
          },
          {
            title: "Print and paper style",
            description:
              "Digital printing, templates, semi-custom design, foil, letterpress, thick paper, liners, and wax seals can change the cost per suite quickly.",
          },
          {
            title: "Postage and mailing",
            description:
              "Heavy, square, rigid, or multi-piece suites can require extra postage, and RSVP cards or thank-you notes add more mailing cost.",
          },
          {
            title: "Day-of paper",
            description:
              "Programs, menus, place cards, escort cards, table numbers, seating charts, signs, and welcome notes often show up after the invitation budget is already spent.",
          },
          {
            title: "Reprint and timing risk",
            description:
              "Guest list changes, spelling mistakes, address issues, wrong dates, late proofs, and rush printing can create costs couples did not plan.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Calculate mailed households instead of using guest count as the invitation quantity.",
          "Use digital RSVPs or wedding website details to reduce insert cards and RSVP postage.",
          "Choose standard envelope sizes and lighter paper before adding liners, wax seals, or thick suites.",
          "Order a small buffer, but avoid ordering far more extras than you will use.",
          "Limit day-of paper to items that help guests move through the event.",
          "Proof names, dates, addresses, ceremony times, and venue details carefully before printing.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "Mailed suites are based on household count plus an extra-suite buffer.",
          "Save-the-date, invitation suite, insert, envelope, addressing, assembly, and postage costs are multiplied by mailed suite count.",
          "Thank-you cards and day-of paper are calculated separately from invitation suites.",
          "Print style adjusts the stationery subtotal before tax.",
          "Outside help reduces out-of-pocket cost before pressure is calculated.",
          "The calculator does not replace a stationery proposal, postal rules, tax advice, or financial planning.",
        ]}
      />

      <section class="content-section">
        <h2>The Stationery Creep Problem</h2>

        <p>
          Stationery creep happens when each paper decision feels small. A nicer
          liner, another insert, upgraded postage, extra signs, personalized menus,
          and thank-you cards may not feel like major choices individually. Together,
          they can turn a modest invitation plan into a larger design budget.
        </p>

        <p>
          The best stationery plan is usually clear and useful. It tells guests
          what they need to know, keeps the mailing process simple, and saves the
          premium touches for the few pieces that actually matter to the couple.
        </p>
      </section>

      <section class="red-flags" id="FinancialRedFlags">
        <h2>Wedding Invitations and Stationery Red Flags</h2>

        <p>
          Stationery deserves extra caution when the visible print quote does not
          include mailing, day-of paper, proofs, reprints, or the full guest-list
          reality.
        </p>

        <ul>
          <li>The estimate uses guest count instead of mailed household count.</li>
          <li>Postage has not been priced for the actual suite weight and shape.</li>
          <li>RSVP cards, return postage, thank-you cards, or day-of paper are missing.</li>
          <li>The design requires rush printing because the timeline is already tight.</li>
          <li>The couple is paying for premium paper details while other wedding categories are underfunded.</li>
          <li>The final stationery bill would require credit card debt or emergency savings meant for after the wedding.</li>
        </ul>
      </section>

      <div class="content-section">
        <FAQSection title="Wedding Invitations and Stationery Cost FAQ" faqs={stationeryFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="wedding invitations and stationery cost estimates" updated="July 2026" />
  </div>

  <script is:inline>
    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const getValue = (id) => document.getElementById(id)?.value || "";

    function formatMoney(value) {
      return value.toLocaleString(undefined, {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      });
    }

    function formatMoneyTwo(value) {
      return value.toLocaleString(undefined, {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    }

    function formatPercent(value) {
      return `${value.toFixed(0)}%`;
    }

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max);
    }

    function printStyleMultiplier(style) {
      const multipliers = {
        digital: 0.85,
        semicustom: 1,
        foil: 1.35,
        luxury: 1.65,
      };

      return multipliers[style] || 1;
    }

    function priorityAdjustment(priority) {
      if (priority === "high") {
        return -8;
      }

      if (priority === "low") {
        return 7;
      }

      return 0;
    }

    function getPressureLabel(score) {
      if (score >= 75) {
        return "High stationery pressure";
      }

      if (score >= 50) {
        return "Moderate stationery pressure";
      }

      if (score >= 25) {
        return "Manageable stationery pressure";
      }

      return "Low stationery pressure";
    }

    function calculateStationery() {
      const guestCount = getNumber("guestCount");
      const householdCount = getNumber("householdCount");
      const extraSuitePercent = getNumber("extraSuitePercent") / 100;
      const printStyle = getValue("printStyle");
      const saveDateCost = getNumber("saveDateCost");
      const inviteSuiteCost = getNumber("inviteSuiteCost");
      const insertCardsCost = getNumber("insertCardsCost");
      const envelopeUpgradeCost = getNumber("envelopeUpgradeCost");
      const addressingCost = getNumber("addressingCost");
      const assemblyCost = getNumber("assemblyCost");
      const postagePerSuite = getNumber("postagePerSuite");
      const rsvpPostage = getNumber("rsvpPostage");
      const designFee = getNumber("designFee");
      const sampleProofCost = getNumber("sampleProofCost");
      const rushReprintCost = getNumber("rushReprintCost");
      const programCount = getNumber("programCount");
      const programCost = getNumber("programCost");
      const signageCost = getNumber("signageCost");
      const thankYouCount = getNumber("thankYouCount");
      const thankYouCost = getNumber("thankYouCost");
      const thankYouPostage = getNumber("thankYouPostage");
      const taxRate = getNumber("taxRate") / 100;
      const weddingBudget = getNumber("weddingBudget");
      const stationeryFund = getNumber("stationeryFund");
      const outsideHelp = getNumber("outsideHelp");
      const monthsUntilWedding = Math.max(getNumber("monthsUntilWedding"), 1);
      const monthlyIncome = getNumber("monthlyIncome");
      const emergencySavings = getNumber("emergencySavings");
      const currentWeddingDebt = getNumber("currentWeddingDebt");
      const stationeryPriority = getValue("stationeryPriority");

      const results = document.getElementById("results");
      const totalPrice = document.getElementById("totalPrice");
      const pressurePill = document.getElementById("pressurePill");
      const pressureFill = document.getElementById("pressureFill");
      const resultDetails = document.getElementById("resultDetails");
      const mailingCheck = document.getElementById("mailingCheck");
      const stationerySummary = document.getElementById("stationerySummary");

      results.classList.add("visible");

      if (householdCount <= 0 && guestCount <= 0) {
        totalPrice.textContent = "$0";
        pressurePill.textContent = "Enter guest count or household count";
        pressureFill.style.width = "0%";
        resultDetails.innerHTML =
          "<p>Enter at least guest count or mailed household count to estimate wedding invitations and stationery cost.</p>";
        mailingCheck.textContent = "";
        stationerySummary.textContent = "";
        return;
      }

      const estimatedHouseholds =
        householdCount > 0 ? householdCount : Math.ceil(guestCount * 0.58);
      const mailedSuites = Math.ceil(
        estimatedHouseholds * (1 + extraSuitePercent)
      );

      const saveDateTotal = mailedSuites * saveDateCost;
      const suiteBeforeStyle =
        mailedSuites *
        (inviteSuiteCost +
          insertCardsCost +
          envelopeUpgradeCost +
          addressingCost +
          assemblyCost);
      const styleAdjustedSuites =
        suiteBeforeStyle * printStyleMultiplier(printStyle);
      const invitationPostage =
        mailedSuites * (postagePerSuite + rsvpPostage);
      const dayOfPaperTotal = programCount * programCost + signageCost;
      const thankYouTotal =
        thankYouCount * (thankYouCost + thankYouPostage);

      const preTaxSubtotal =
        saveDateTotal +
        styleAdjustedSuites +
        invitationPostage +
        designFee +
        sampleProofCost +
        rushReprintCost +
        dayOfPaperTotal +
        thankYouTotal;

      const taxTotal = preTaxSubtotal * taxRate;
      const totalCost = preTaxSubtotal + taxTotal;

      const helpApplied = Math.min(outsideHelp, totalCost);
      const outOfPocketCost = Math.max(totalCost - helpApplied, 0);
      const cashGap = Math.max(outOfPocketCost - stationeryFund, 0);
      const monthlySavingsNeeded = cashGap / monthsUntilWedding;
      const budgetShare = weddingBudget > 0 ? (totalCost / weddingBudget) * 100 : 0;
      const emergencyRatio =
        emergencySavings > 0 ? outOfPocketCost / emergencySavings : 999;
      const costPerMailedSuite =
        mailedSuites > 0 ? totalCost / mailedSuites : 0;
      const postageShare =
        totalCost > 0 ? (invitationPostage / totalCost) * 100 : 0;

      let pressureScore = 0;

      pressureScore += budgetShare > 8 ? 22 : budgetShare > 5 ? 14 : budgetShare > 3 ? 7 : 0;
      pressureScore += cashGap > 0 ? 18 : 0;
      pressureScore += monthlyIncome > 0 && monthlySavingsNeeded > monthlyIncome * 0.05 ? 14 : 0;
      pressureScore += emergencyRatio > 0.6 ? 16 : emergencyRatio > 0.3 ? 8 : 0;
      pressureScore += currentWeddingDebt > 0 ? 10 : 0;
      pressureScore += postageShare > 25 ? 7 : 0;
      pressureScore += printStyle === "luxury" ? 10 : printStyle === "foil" ? 6 : 0;
      pressureScore += rushReprintCost > preTaxSubtotal * 0.1 ? 7 : 0;
      pressureScore += priorityAdjustment(stationeryPriority);

      if (outsideHelp >= totalCost) {
        pressureScore = 5;
      }

      pressureScore = clamp(pressureScore, 0, 100);

      const label = getPressureLabel(pressureScore);
      const tenHouseholdSwing =
        10 *
        ((saveDateCost +
          inviteSuiteCost +
          insertCardsCost +
          envelopeUpgradeCost +
          addressingCost +
          assemblyCost) *
          printStyleMultiplier(printStyle) +
          postagePerSuite +
          rsvpPostage);

      totalPrice.textContent = formatMoney(totalCost);
      pressurePill.textContent = `${label} - ${formatPercent(pressureScore)}`;
      pressureFill.style.width = `${pressureScore}%`;

      resultDetails.innerHTML = `
        <p><strong>Estimated mailed suites:</strong> ${mailedSuites.toLocaleString()} based on ${estimatedHouseholds.toLocaleString()} households plus buffer.</p>

        <p><strong>Save-the-dates:</strong> ${formatMoney(saveDateTotal)}.</p>

        <p><strong>Invitation suites, inserts, envelopes, addressing, and assembly:</strong> ${formatMoney(styleAdjustedSuites)}.</p>

        <p><strong>Invitation and RSVP postage:</strong> ${formatMoney(invitationPostage)}.</p>

        <p><strong>Design, proofs, rush, day-of paper, signage, and thank-you cards:</strong> ${formatMoney(designFee + sampleProofCost + rushReprintCost + dayOfPaperTotal + thankYouTotal)}.</p>

        <p><strong>Estimated tax:</strong> ${formatMoney(taxTotal)}.</p>

        <p><strong>Estimated cost per mailed suite:</strong> ${formatMoneyTwo(costPerMailedSuite)}.</p>

        <p><strong>Out-of-pocket cost after family help or contributions:</strong> ${formatMoney(outOfPocketCost)}.</p>

        <p><strong>Estimated share of total wedding budget:</strong> ${formatPercent(budgetShare)}.</p>

        <p><strong>Cash gap after available stationery funds:</strong> ${formatMoney(cashGap)}.</p>

        <p><strong>Monthly savings needed until the wedding:</strong> ${formatMoney(monthlySavingsNeeded)} for ${monthsUntilWedding.toFixed(0)} ${monthsUntilWedding === 1 ? "month" : "months"}.</p>
      `;

      mailingCheck.innerHTML = `
        <strong>Mailing check:</strong> Invitation and RSVP postage is about <strong>${formatPercent(postageShare)}</strong> of this estimate.
        Every 10 additional mailed households changes the estimate by about <strong>${formatMoney(tenHouseholdSwing)}</strong> before tax.
        If pressure is high, reduce inserts, envelope upgrades, RSVP postage, or day-of paper before assuming the only answer is cheaper design.
      `;

      stationerySummary.innerHTML = `
        This invitation and stationery plan is estimated at <strong>${formatMoney(totalCost)}</strong>.
        After confirmed help, the estimated out-of-pocket cost is <strong>${formatMoney(outOfPocketCost)}</strong>.
        The pressure result is <strong>${label.toLowerCase()}</strong> based on budget share, cash gap, emergency savings,
        wedding debt, print style, postage share, rush risk, and monthly savings needed.
      `;
    }

    document
      .getElementById("stationeryButton")
      .addEventListener("click", calculateStationery);
  </script>
</Layout>


