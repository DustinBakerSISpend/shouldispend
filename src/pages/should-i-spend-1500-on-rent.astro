---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";

const pageUrl = "https://shouldispend.com/should-i-spend-1500-on-rent";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is $1,500 a month too much for rent?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "$1,500 rent can be affordable for many renters, but it depends on take-home pay, debt payments, utilities, savings, transportation costs, and how much money remains after normal bills.",
      },
    },
    {
      "@type": "Question",
      name: "How much income do I need for $1,500 rent?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Using the 30% gross-income rule, $1,500 rent points to roughly $60,000 in annual income, but take-home pay and debt matter more than a simple rule.",
      },
    },
    {
      "@type": "Question",
      name: "Should utilities be included with $1,500 rent?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Utilities, internet, parking, renter’s insurance, pet fees, laundry, and commuting costs should be included when judging whether $1,500 rent is affordable.",
      },
    },
    {
      "@type": "Question",
      name: "Can $1,500 rent still be risky?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. $1,500 rent can become risky if income is low, debt payments are high, savings are weak, move-in costs drain cash, or utilities and transportation costs are higher than expected.",
      },
    },
    {
      "@type": "Question",
      name: "Is $1,500 rent better than buying a house?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "$1,500 rent may be safer than buying if it preserves flexibility, avoids repair costs, and leaves room to build savings. Buying depends on income, down payment, location, debt, and long-term plans.",
      },
    },
  ],
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Should I Spend $1,500 on Rent Calculator",
  url: pageUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "All",
  description:
    "A $1,500 rent affordability calculator that estimates housing pressure using income, take-home pay, utilities, debt, bills, savings, and move-in costs.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://shouldispend.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Rent Calculators",
      item: "https://shouldispend.com/rent-calculators",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Should I Spend $1,500 on Rent?",
      item: pageUrl,
    },
  ],
};
---

<Layout
  title="Should I Spend $1,500 on Rent? Calculator | ShouldISpend"
  description="Use this $1,500 rent calculator to decide whether the payment fits your income, take-home pay, debt, utilities, savings, bills, and monthly flexibility."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
      box-sizing: border-box;
    }

    button {
      background: #0f766e;
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
      display: none;
      background: #f8fafc;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
      line-height: 1.05;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }

    .content-section p,
    .content-section li {
      line-height: 1.8;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="$1,500 Rent Calculator"
      title="Should I Spend $1,500 on Rent?"
      description="Estimate whether a $1,500 monthly rent payment is comfortable, tight, or risky after utilities, debt payments, other bills, savings, move-in costs, and real monthly breathing room."
    >
      <div class="card">
        <h2>$1,500 Rent Pressure Verdict</h2>

        <div class="grid">
          <div>
            <label for="grossIncome">Annual Household Income</label>
            <input id="grossIncome" type="number" placeholder="65000" />
          </div>

          <div>
            <label for="takeHomePay">Monthly Take-Home Pay</label>
            <input id="takeHomePay" type="number" placeholder="4300" />
          </div>

          <div>
            <label for="rent">Monthly Rent</label>
            <input id="rent" type="number" value="1500" />
          </div>

          <div>
            <label for="utilities">Utilities, Internet, Parking, Fees</label>
            <input id="utilities" type="number" placeholder="300" />
          </div>

          <div>
            <label for="monthlyDebt">Monthly Debt Payments</label>
            <input id="monthlyDebt" type="number" placeholder="450" />

            <div class="helper-link">
              <a href="/what-counts-as-debt">
                Not sure what counts as debt? Read the debt guide
              </a>
            </div>
          </div>

          <div>
            <label for="otherBills">Other Monthly Bills</label>
            <input id="otherBills" type="number" placeholder="1300" />
          </div>

          <div>
            <label for="savings">Total Emergency Savings</label>
            <input id="savings" type="number" placeholder="10000" />
          </div>

          <div>
            <label for="movingCost">Estimated Move-In Cost</label>
            <input id="movingCost" type="number" placeholder="3500" />
          </div>
        </div>

        <button id="rentButton" type="button">
          Get $1,500 Rent Verdict
        </button>

        <div class="result" id="result">
          <div class="score" id="score"></div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="housingRatio"></div>
          <div class="metric" id="takeHomeRatio"></div>
          <div class="metric" id="leftoverCash"></div>
          <div class="metric" id="recommendedRent"></div>
          <div class="metric" id="savingsCushion"></div>
          <div class="metric" id="moveInImpact"></div>
          <div class="metric" id="debtPressure"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <h2>Is $1,500 Rent Actually Affordable?</h2>

        <p>
          A $1,500 rent payment often sits in the middle zone: low enough to be
          reasonable for many households, but still large enough to create
          pressure if take-home pay is modest, debt payments are high, or the
          apartment comes with expensive utilities and fees.
        </p>

        <p>
          That is why this number needs more than a simple yes-or-no answer.
          A renter bringing home $4,000 per month will feel $1,500 rent very
          differently than someone bringing home $7,500 per month. Savings,
          car payments, student loans, credit cards, insurance, childcare, and
          commuting costs can change the answer quickly.
        </p>

        <p>
          The safest version of $1,500 rent leaves room for monthly savings,
          groceries, transportation, insurance, debt payments, and small
          emergencies without relying on credit cards.
        </p>
      </div>

      <div class="content-section">
        <h2>Why $1,500 Rent Can Be Sneakier Than It Looks</h2>

        <p>
          $1,500 may sound moderate compared with higher-cost apartments, but
          the true housing cost is rarely just the rent line. Utilities, internet,
          parking, renter’s insurance, laundry, pet rent, storage, and location
          tradeoffs can push the real monthly commitment closer to $1,800 or
          $2,000.
        </p>

        <p>
          Move-in costs can also change the decision. A security deposit, first
          month’s rent, application fees, movers, furniture, and utility setup
          can drain savings before the first normal month begins.
        </p>
      </div>

      <WhenSpendingMakesSense
        title="When $1,500 Rent Makes Sense"
        items={[
          "The full housing cost still leaves room for savings every month.",
          "Utilities, parking, internet, renter’s insurance, pet fees, and commuting costs have been included.",
          "You can pay deposits and move-in costs without wiping out your emergency fund.",
          "The apartment supports work, school, safety, family logistics, or transportation needs.",
          "Debt payments are low enough that rent does not crowd out groceries, insurance, medical costs, or normal bills.",
        ]}
      />

      <div class="content-section">
        <h2>When $1,500 Rent May Be Too Much</h2>

        <p>
          $1,500 rent may be too much if it leaves almost nothing after bills,
          blocks emergency savings, slows urgent debt payoff, or forces routine
          spending onto credit cards. The payment can also become risky if you
          are counting on overtime, bonuses, a roommate who has not committed,
          or a raise that has not happened yet.
        </p>

        <p>
          The warning sign is not the dollar amount by itself. The warning sign
          is a lease that only works when every month goes perfectly.
        </p>
      </div>

      <KeyCostCategories
        items={[
          {
            title: "Rent plus utilities",
            description:
              "A $1,500 apartment may cost much more once electricity, heat, water, trash, internet, parking, laundry, pet fees, and renter’s insurance are included.",
          },
          {
            title: "Move-in cash",
            description:
              "Deposits, first month’s rent, application fees, movers, basic furniture, cleaning supplies, and utility setup can create a large upfront hit.",
          },
          {
            title: "Debt and fixed obligations",
            description:
              "Student loans, car payments, credit cards, medical bills, personal loans, insurance, and childcare reduce how much room remains after rent.",
          },
          {
            title: "Neighborhood tradeoffs",
            description:
              "A lower rent can still be expensive if it adds commuting costs, parking costs, safety concerns, or time away from work and family.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Ask for average utility costs before applying.",
          "Compare apartments by total monthly housing cost, not rent alone.",
          "Avoid using most of your emergency fund for deposits and furniture.",
          "Check whether parking, laundry, internet, trash, or pet rent are extra.",
          "Look at commute costs before choosing the cheaper-looking apartment.",
          "Consider a roommate, smaller unit, or slightly different neighborhood if $1,500 feels tight.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "$1,500 rent plus utilities would consume more than half of take-home pay.",
          "You would have little or no cash left after rent, debt, groceries, and normal bills.",
          "Move-in costs would drain most of your emergency savings.",
          "You are already using credit cards to cover routine expenses.",
          "The apartment only works if overtime, bonuses, or side income continue.",
          "You have not counted utilities, parking, renter’s insurance, pet fees, or commute changes.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "The calculator treats $1,500 rent as a recurring monthly commitment.",
          "Monthly housing cost includes rent plus estimated utilities, internet, parking, renter’s insurance, and other required housing fees.",
          "Take-home pay is used to estimate real monthly breathing room.",
          "Move-in costs are treated as an immediate savings hit because they can weaken your emergency cushion before the lease starts.",
          "The calculator is designed for general education and does not replace personalized financial advice.",
        ]}
      />

      <div class="content-section">
        <h2>How Much Income Makes $1,500 Rent Comfortable?</h2>

        <p>
          Using the old 30% gross-income rule, $1,500 rent points to roughly
          $5,000 in gross monthly income, or about $60,000 per year. That can be
          a useful starting point, but it is not enough by itself.
        </p>

        <p>
          $1,500 rent is much safer when your take-home pay still leaves room for
          savings and when debt payments are modest. It becomes harder when car
          payments, student loans, credit cards, medical bills, childcare, or
          insurance already take a large bite out of monthly cash flow.
        </p>
      </div>

      <div class="content-section">
        <h2>Emergency Savings Matter Before You Sign</h2>

        <p>
          Rent is not easy to undo. Once the lease is signed, the payment shows
          up every month. That makes emergency savings especially important,
          even at a rent level that seems reasonable.
        </p>

        <p>
          A strong cushion lets you handle a car repair, medical bill, job
          disruption, family emergency, or unexpected move without turning the
          lease into credit card debt. Weak savings make the same rent feel much
          heavier.
        </p>
      </div>

      <FAQSection
        title="$1,500 Rent FAQ"
        faqs={[
          {
            question: "Is $1,500 a month too much for rent?",
            answer:
              "$1,500 rent may be affordable or risky depending on take-home pay, debt payments, savings, utilities, transportation, and other monthly bills.",
          },
          {
            question: "How much income do I need for $1,500 rent?",
            answer:
              "The 30% rule points to about $60,000 in annual gross income, but take-home pay is more useful. The rent is safer when it leaves room for savings, debt payments, groceries, insurance, and emergencies.",
          },
          {
            question: "Should I include utilities with $1,500 rent?",
            answer:
              "Yes. Utilities, internet, parking, renter’s insurance, laundry, pet fees, and commuting costs should be included in the real housing number.",
          },
          {
            question: "Can $1,500 rent be risky even if I qualify?",
            answer:
              "Yes. Qualifying for an apartment does not mean the rent is comfortable. High debt, low savings, high utilities, or large move-in costs can make the payment stressful.",
          },
          {
            question: "Is $1,500 rent a good deal?",
            answer:
              "It depends on the market, location, safety, commute, utilities, condition, and your budget. A good deal still needs to leave monthly breathing room.",
          },
        ]}
      />

      <MethodologySection category="rent affordability" updated="May 2026" />

      <RelatedGuides
        guides={[
          {
            title: "How Much Rent Can I Afford?",
            href: "/how-much-rent-can-i-afford",
            description:
              "Use the broader rent affordability guide to compare income, take-home pay, debt, utilities, and emergency savings.",
          },
          {
            title: "What Counts as Debt?",
            href: "/what-counts-as-debt",
            description:
              "See which monthly obligations should be included when judging rent pressure.",
          },
          {
            title: "How Much Emergency Savings Should I Have?",
            href: "/how-much-emergency-savings-should-i-have",
            description:
              "Estimate how much cushion to keep before signing a lease or draining savings on move-in costs.",
          },
        ]}
      />

      <RelatedCalculators
        calculators={[
          {
            category: "Rent",
            title: "Should I Spend $2,000 on Rent?",
            href: "/should-i-spend-2000-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend $2,500 on Rent?",
            href: "/should-i-spend-2500-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend $3,000 on Rent?",
            href: "/should-i-spend-3000-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend 40% of My Income on Rent?",
            href: "/should-i-spend-40-percent-of-income-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend 50% of My Income on Rent?",
            href: "/should-i-spend-50-percent-of-income-on-rent",
          },
        ]}
      />
    </CalculatorPageShell>
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const formatMoney = (value) => {
      return Math.round(value).toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          color: "#16a34a",
          action:
            "This rent appears manageable, but confirm utilities, fees, commute costs, and move-in cash before signing.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          color: "#ca8a04",
          action:
            "This rent may work, but protect your emergency cushion and compare the full cost against nearby alternatives.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        color: "#dc2626",
        action:
          "This rent could create monthly strain. Look for a cheaper unit, lower fees, roommate option, stronger savings cushion, or more income first.",
      };
    }

    function calculateRent() {
      const grossIncome = getNumber("grossIncome");
      const takeHomePay = getNumber("takeHomePay");
      const rent = getNumber("rent");
      const utilities = getNumber("utilities");
      const monthlyDebt = getNumber("monthlyDebt");
      const otherBills = getNumber("otherBills");
      const savings = getNumber("savings");
      const movingCost = getNumber("movingCost");

      const result = document.getElementById("result");
      const scoreEl = document.getElementById("score");
      const barFill = document.getElementById("barFill");
      const housingRatioEl = document.getElementById("housingRatio");
      const takeHomeRatioEl = document.getElementById("takeHomeRatio");
      const leftoverCashEl = document.getElementById("leftoverCash");
      const recommendedRentEl = document.getElementById("recommendedRent");
      const savingsCushionEl = document.getElementById("savingsCushion");
      const moveInImpactEl = document.getElementById("moveInImpact");
      const debtPressureEl = document.getElementById("debtPressure");
      const guidanceEl = document.getElementById("guidance");

      result.style.display = "block";

      if (grossIncome <= 0 || takeHomePay <= 0 || rent <= 0) {
        scoreEl.textContent = "Add your numbers first";
        barFill.style.width = "0%";
        barFill.style.background = "#16a34a";
        housingRatioEl.innerHTML = "";
        takeHomeRatioEl.innerHTML = "";
        leftoverCashEl.innerHTML = "";
        recommendedRentEl.innerHTML = "";
        savingsCushionEl.innerHTML = "";
        moveInImpactEl.innerHTML = "";
        debtPressureEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter positive numbers for annual income, monthly take-home pay, and rent so the calculator can estimate housing pressure.";
        return;
      }

      const monthlyGrossIncome = grossIncome / 12;
      const totalHousingCost = rent + utilities;
      const totalCommittedMonthly = totalHousingCost + monthlyDebt + otherBills;
      const leftoverAfterBills = takeHomePay - totalCommittedMonthly;
      const housingGrossRatio = (totalHousingCost / monthlyGrossIncome) * 100;
      const housingTakeHomeRatio = (totalHousingCost / takeHomePay) * 100;
      const debtTakeHomeRatio = (monthlyDebt / takeHomePay) * 100;
      const leftoverRatio = (leftoverAfterBills / takeHomePay) * 100;
      const postMoveSavings = savings - movingCost;
      const postMoveSavingsMonths =
        totalCommittedMonthly > 0 ? postMoveSavings / totalCommittedMonthly : 0;
      const emergencyMonths =
        totalCommittedMonthly > 0 ? savings / totalCommittedMonthly : 0;
      const moveInSavingsImpact =
        savings > 0 ? (movingCost / savings) * 100 : movingCost > 0 ? 100 : 0;

      const conservativeRent = Math.max(0, Math.min(monthlyGrossIncome * 0.25, takeHomePay * 0.28));
      const balancedRent = Math.max(0, Math.min(monthlyGrossIncome * 0.3, takeHomePay * 0.35));
      const stretchRent = Math.max(0, Math.min(monthlyGrossIncome * 0.4, takeHomePay * 0.45));

      let pressureScore = 0;

      pressureScore += clamp((housingGrossRatio - 20) * 1.05, 0, 28);
      pressureScore += clamp((housingTakeHomeRatio - 25) * 1.15, 0, 34);
      pressureScore += clamp(debtTakeHomeRatio * 0.55, 0, 16);

      if (leftoverAfterBills < 0) {
        pressureScore += 28;
      } else if (leftoverRatio < 8) {
        pressureScore += 20;
      } else if (leftoverRatio < 15) {
        pressureScore += 12;
      } else if (leftoverRatio >= 35) {
        pressureScore -= 8;
      } else if (leftoverRatio >= 25) {
        pressureScore -= 4;
      }

      if (savings <= 0 && movingCost > 0) {
        pressureScore += 18;
      } else if (postMoveSavings < 0) {
        pressureScore += 20;
      } else if (postMoveSavingsMonths < 1 && grossIncome < 120000) {
        pressureScore += 16;
      } else if (postMoveSavingsMonths < 3 && grossIncome < 180000) {
        pressureScore += 10;
      } else if (postMoveSavingsMonths >= 6) {
        pressureScore -= 8;
      }

      if (moveInSavingsImpact >= 75) pressureScore += 12;
      else if (moveInSavingsImpact >= 50) pressureScore += 8;
      else if (moveInSavingsImpact <= 10 && savings > 0) pressureScore -= 3;

      if (housingGrossRatio >= 60) pressureScore += 18;
      else if (housingGrossRatio >= 50) pressureScore += 12;
      else if (housingGrossRatio >= 40) pressureScore += 7;

      if (housingTakeHomeRatio >= 65) pressureScore += 20;
      else if (housingTakeHomeRatio >= 55) pressureScore += 14;
      else if (housingTakeHomeRatio >= 45) pressureScore += 8;

      if (
        housingGrossRatio < 22 &&
        housingTakeHomeRatio < 28 &&
        leftoverRatio >= 30 &&
        emergencyMonths >= 4 &&
        debtTakeHomeRatio < 10
      ) {
        pressureScore -= 12;
      }

      if (
        housingGrossRatio < 12 &&
        housingTakeHomeRatio < 16 &&
        leftoverRatio >= 50 &&
        emergencyMonths >= 8 &&
        debtTakeHomeRatio < 5
      ) {
        pressureScore = Math.min(pressureScore, 10);
      }

      if (
        housingGrossRatio < 6 &&
        housingTakeHomeRatio < 8 &&
        leftoverRatio >= 65 &&
        emergencyMonths >= 12 &&
        debtTakeHomeRatio < 3
      ) {
        pressureScore = 0;
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      let guidance = "";

      if (pressureScore === 0) {
  guidance =
    `This ${formatMoney(rent)} rent payment appears financially tiny relative to the numbers provided...`;
} else if (pressureScore <= 30) {
  guidance =
    `This ${formatMoney(rent)} rent payment appears manageable based on the numbers provided...`;
} else if (pressureScore <= 60) {
  guidance =
    `This ${formatMoney(rent)} rent payment may work, but it deserves caution...`;
} else {
  guidance =
    `This ${formatMoney(rent)} rent payment could create significant financial pressure...`;
}

      scoreEl.textContent = `${level.label} — ${pressureScore}/100`;
      barFill.style.width = `${pressureScore}%`;
      barFill.style.background = level.color;

      housingRatioEl.innerHTML = `<strong>Housing-to-gross-income ratio:</strong> ${housingGrossRatio.toFixed(1)}%`;
      takeHomeRatioEl.innerHTML = `<strong>Housing-to-take-home-pay ratio:</strong> ${housingTakeHomeRatio.toFixed(1)}%`;
      leftoverCashEl.innerHTML = `<strong>Estimated leftover after listed bills:</strong> ${formatMoney(leftoverAfterBills)}`;
      recommendedRentEl.innerHTML = `<strong>Estimated rent range:</strong> ${formatMoney(conservativeRent)} conservative / ${formatMoney(balancedRent)} balanced / ${formatMoney(stretchRent)} stretch`;
      savingsCushionEl.innerHTML = `<strong>Emergency cushion:</strong> ${emergencyMonths.toFixed(1)} months before move-in / ${postMoveSavingsMonths.toFixed(1)} months after move-in costs`;
      moveInImpactEl.innerHTML = `<strong>Move-in savings impact:</strong> ${moveInSavingsImpact.toFixed(1)}% of savings`;
      debtPressureEl.innerHTML = `<strong>Debt payment pressure:</strong> ${debtTakeHomeRatio.toFixed(1)}% of take-home pay`;
      guidanceEl.textContent = `${guidance} Recommended next step: ${level.action}`;
    }

    document
      .getElementById("rentButton")
      .addEventListener("click", calculateRent);
  </script>
</Layout>