---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";

const emergencyCalculators = [
  {
    title: "How Much Emergency Savings Should I Have?",
    href: "/how-much-emergency-savings-should-i-have/",
    type: "Guide",
    button: "Read Guide",
    text: "Estimate the broader emergency savings target to keep before major purchases, life changes, or long-term money decisions.",
  },
  {
    title: "Starter Emergency Fund Calculator",
    href: "/starter-emergency-fund-calculator/",
    type: "Calculator",
    button: "Open Calculator",
    text: "Calculate the first realistic cash cushion, starter range, savings gap, monthly plan, and next milestone.",
  },
  {
    title: "3-Month Emergency Fund Calculator",
    href: "/3-month-emergency-fund-calculator/",
    type: "Calculator",
    button: "Open Calculator",
    text: "Calculate a 3-month emergency fund target from essential expenses, current savings, shortfall, and savings timeline.",
  },
  {
    title: "6-Month Emergency Fund Calculator",
    href: "/6-month-emergency-fund-calculator/",
    type: "Calculator",
    button: "Open Calculator",
    text: "Build a longer runway for contractors, one-income households, homeowners, dependents, medical risk, and unstable income.",
  },
  {
    title: "Emergency Fund vs Debt Payoff Calculator",
    href: "/emergency-fund-vs-debt-payoff-calculator/",
    type: "Calculator",
    button: "Open Calculator",
    text: "Decide whether extra cash should build emergency savings, pay down debt, or split between both.",
  },
  {
    title: "Should I Use My Emergency Fund?",
    href: "/should-i-use-my-emergency-fund/",
    type: "Calculator",
    button: "Open Calculator",
    text: "Decide whether a surprise expense is a real emergency, urgent but plannable, or optional.",
  },
  {
    title: "Emergency Fund After Big Purchase Calculator",
    href: "/emergency-fund-after-big-purchase-calculator/",
    type: "Calculator",
    button: "Open Calculator",
    text: "See how much cushion remains after travel, repairs, a wedding, a home project, a car cost, or another big expense.",
  },
];

const emergencySavingsPressureFactors = [
  {
    title: "Essential monthly expenses",
    text:
      "A useful emergency fund starts with rent or mortgage, utilities, groceries, insurance, transportation, minimum debt payments, childcare, medicine, and other bills that cannot stop during a crisis.",
  },
  {
    title: "Income stability",
    text:
      "A two-income salaried household, a commission worker, a contractor, and a one-income family do not need the same cushion. Less predictable income usually needs more months of protection.",
  },
  {
    title: "Dependents and obligations",
    text:
      "Children, caregiving, pets, medical needs, shared housing, and family support obligations can raise the cost of being wrong about the cushion.",
  },
  {
    title: "Debt pressure",
    text:
      "Emergency savings and debt payoff compete for the same dollars. High-interest debt matters, but having no cash cushion can send the next surprise right back onto a card.",
  },
  {
    title: "Housing and transportation risk",
    text:
      "Homeowners, renters with moving risk, older vehicles, long commutes, and limited public transit all change how much cash should stay liquid.",
  },
  {
    title: "Upcoming planned spending",
    text:
      "A vacation, repair, move, wedding, medical bill, or car purchase may be affordable only if the emergency fund still survives after the payment.",
  },
];

const emergencySavingsTargets = [
  {
    title: "Starter fund",
    text:
      "A starter emergency fund is the first cash floor. It is useful when savings are near zero and the immediate goal is to stop small surprises from becoming new debt.",
  },
  {
    title: "Three-month fund",
    text:
      "A three-month target can fit households with stable income, lower fixed bills, good benefits, and backup options, especially after high-interest debt is under control.",
  },
  {
    title: "Six-month fund",
    text:
      "A six-month target is safer for one-income households, contractors, homeowners, parents, people with medical risk, or anyone whose job loss would be hard to replace quickly.",
  },
  {
    title: "After-purchase cushion",
    text:
      "The right emergency fund before a big purchase depends on what remains afterward. A purchase can be paid in cash and still be risky if it leaves no recovery room.",
  },
];

const emergencySavingsRedFlags = [
  "The savings target is based on gross income instead of essential expenses.",
  "A planned purchase would leave less than one month of essential bills in cash.",
  "Credit cards are the backup plan for rent, groceries, childcare, or medical bills.",
  "Income is unstable, but the household is using a short emergency-fund target.",
  "Debt payoff is so aggressive that one surprise would create new high-interest debt.",
  "The budget ignores insurance deductibles, car repairs, home repairs, or job-search time.",
  "The emergency fund is invested, locked up, or hard to access quickly.",
];

const emergencySavingsSaferSteps = [
  {
    title: "Define essentials first",
    text:
      "Use essential monthly bills as the base. Lifestyle spending can be cut in a crisis, but housing, food, utilities, transportation, insurance, medicine, childcare, and minimum debt payments usually cannot disappear.",
  },
  {
    title: "Separate emergency cash from spending cash",
    text:
      "Keep the emergency fund visible but not mixed with regular checking. The goal is to avoid accidentally treating the cushion as everyday money.",
  },
  {
    title: "Build the first floor before optimizing",
    text:
      "A small starter fund can matter more than chasing the perfect target. The first cushion gives the household time to make better decisions when something breaks.",
  },
  {
    title: "Match the target to risk",
    text:
      "Stable income, strong benefits, low fixed bills, and family support can lower the needed cushion. One income, dependents, health risk, or variable pay usually raises it.",
  },
  {
    title: "Check the after-purchase balance",
    text:
      "Before a large planned expense, compare the cost with the emergency fund left afterward. The leftover cushion is often more important than the purchase price alone.",
  },
  {
    title: "Avoid all-or-nothing debt payoff",
    text:
      "Paying down high-interest debt is important, but draining cash to zero can make the next emergency more expensive. A split plan is often safer.",
  },
];

const relatedEmergencyPlanningLinks = [
  {
    href: "/budget-rule-calculators/",
    title: "Budget Rule Calculators",
    text:
      "Compare emergency savings with rent ratios, debt pressure, and broader affordability rules.",
  },
  {
    href: "/how-much-debt-is-too-much/",
    title: "How Much Debt Is Too Much?",
    text:
      "Check whether debt payments leave enough room to build and protect an emergency fund.",
  },
  {
    href: "/what-counts-as-debt/",
    title: "What Counts as Debt?",
    text:
      "Clarify which obligations should be included when judging monthly debt pressure.",
  },
  {
    href: "/rent-calculators/",
    title: "Rent Calculators",
    text:
      "Compare emergency savings with housing costs, deposits, utilities, and monthly rent pressure.",
  },
  {
    href: "/medical-calculators/",
    title: "Medical Cost Calculators",
    text:
      "Plan around deductibles, payment plans, medical bills, and healthcare-related cash risk.",
  },
  {
    href: "/calculators/",
    title: "All ShouldISpend Calculators",
    text:
      "Browse the full calculator library by spending category and financial pressure point.",
  },
];

---

<Layout
  title="Emergency Savings Calculators | Cash Cushion and Debt Pressure"
  description="Use emergency savings calculators to compare starter funds, 3-month and 6-month targets, debt payoff tradeoffs, emergency fund use, and post-purchase cushion."
>
  <style>
    .container {
      max-width: 1040px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 700;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(2.6rem, 7vw, 4.5rem);
      line-height: 1;
      margin-bottom: 24px;
      max-width: 900px;
    }

    .intro {
      max-width: 790px;
      color: var(--muted);
      font-size: 1.15rem;
      line-height: 1.8;
      margin-bottom: 40px;
    }

    .quick-guide {
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 24px;
      padding: 26px;
      margin: 34px 0 52px;
      max-width: 900px;
    }

    .quick-guide strong {
      color: var(--text);
    }

    .quick-guide p {
      margin: 0;
      color: var(--muted);
      line-height: 1.8;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-top: 22px;
    }

    .tool-card {
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 18px;
      padding: 22px;
      min-height: 238px;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }

    .tool-card:hover {
      transform: translateY(-2px);
      border-color: rgba(0, 102, 85, 0.35);
    }

    .card-type {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.72rem;
      font-weight: 800;
      margin-bottom: 18px;
    }

    .tool-card h2 {
      color: var(--text);
      font-size: 1.55rem;
      line-height: 1.15;
      margin: 0 0 16px;
    }

    .tool-card p {
      color: var(--muted);
      line-height: 1.65;
      font-size: 0.95rem;
      margin: 0 0 22px;
    }

    .card-button {
      align-self: flex-start;
      margin-top: auto;
      background: var(--primary);
      color: white;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 0.88rem;
      font-weight: 800;
    }

    .section {
      margin-top: 70px;
      max-width: 880px;
    }

    .wide-section {
      margin-top: 76px;
    }

    .info-grid,
    .link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 22px;
      margin-top: 28px;
    }

    .info-card,
    .link-card,
    .callout {
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 22px;
      padding: 26px;
      box-shadow: var(--shadow-soft);
    }

    .info-card h3,
    .link-card strong {
      display: block;
      color: var(--text);
      font-size: 1.08rem;
      line-height: 1.3;
      margin: 0 0 10px;
    }

    .info-card p,
    .link-card span,
    .callout p,
    .wide-section p {
      color: var(--muted);
      line-height: 1.75;
      margin: 0;
    }

    .link-card {
      display: block;
      text-decoration: none;
      color: inherit;
      transition:
        transform 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
      border-color: var(--primary);
    }

    .check-list,
    .red-flag-list {
      color: var(--muted);
      line-height: 1.8;
      margin: 22px 0 0;
      padding-left: 22px;
    }

    .check-list li,
    .red-flag-list li {
      margin-bottom: 12px;
    }

    .red-flag-list li::marker {
      color: #b91c1c;
    }

    .dark-callout {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
      color: #ffffff;
    }

    .dark-callout h2,
    .dark-callout .eyebrow {
      color: #ffffff;
    }

    .dark-callout p {
      color: #e7eadf;
    }


    .section h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .section p,
    .section li {
      color: var(--muted);
      line-height: 1.8;
      margin-bottom: 18px;
    }

    @media (max-width: 900px) {
      .card-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .card-grid {
        grid-template-columns: 1fr;
      }

      .container {
        padding: 56px 18px;
      }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Emergency Savings Calculators</div>

    <h1>Emergency savings is not one number for every household.</h1>

    <p class="intro">
      Build the right cash cushion for the decision in front of you. These tools
      cover starter emergency funds, 3-month and 6-month targets, debt payoff
      tradeoffs, emergency fund use, and the cash left after a major purchase.
    </p>

    <p class="intro">
      The right target depends on essential bills, income stability, dependents,
      debt pressure, insurance exposure, housing risk, and whether a planned
      purchase would leave enough cash to recover from the next surprise.
    </p>

    <div class="quick-guide">
      <p>
        <strong>Start here:</strong> use the starter fund calculator if you have
        little or no cash cushion. Use the 3-month and 6-month calculators to
        build targets. Use the debt payoff calculator for allocation decisions.
        Use the emergency fund use calculator for a specific surprise. Use the
        after-purchase calculator before a major planned cost changes the cushion.
      </p>
    </div>

    <div class="card-grid">
      {emergencyCalculators.map((calculator) => (
        <a class="tool-card" href={calculator.href}>
          <div class="card-type">{calculator.type}</div>
          <h2>{calculator.title}</h2>
          <p>{calculator.text}</p>
          <span class="card-button">{calculator.button}</span>
        </a>
      ))}
    </div>

    <section class="section">
      <h2>Which emergency savings calculator should you use first?</h2>

      <p>
        If you are starting from zero, the starter calculator gives you the first
        practical cash floor. Once that is covered, the 3-month and 6-month
        calculators help you build the right emergency fund target.
      </p>

      <p>
        If the question is about a specific bill, use the emergency fund use
        calculator. If the question is about a major purchase you are planning,
        use the after-purchase calculator to see what emergency savings will
        remain after the decision.
      </p>
    </section>

    <OmniStyleReviewBlock
      pageName="the emergency savings calculators hub"
      pageType="calculator hub"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="emergency savings targets, starter funds, three-month funds, six-month funds, debt payoff tradeoffs, income stability, dependents, essential expenses, and cash cushion planning"
    />

    <CorePageExamplesBlock
      title="Emergency savings calculator examples"
      intro="Emergency savings calculators are most useful when the target reflects real essential expenses, income stability, and household risk."
      useCases={[
          "You need to choose an emergency savings calculator.",
          "You want to compare starter, three-month, and six-month savings targets.",
          "You need to include debt, job stability, dependents, and essential bills."
        ]}
      notEnough={[
          "You need investment, tax, or personalized financial-planning advice.",
          "You are in an immediate crisis requiring local assistance.",
          "You need business cash-reserve planning."
        ]}
      examples={[
          {
            label: "No savings yet",
            takeaway: "A starter fund can reduce reliance on credit cards."
          },
          {
            label: "Stable household",
            takeaway: "Three months may be a reasonable next target."
          },
          {
            label: "Higher-risk income",
            takeaway: "Six months or more may be safer."
          }
        ]}
      commonMistake="Choosing a savings target based on income instead of essential monthly expenses."
      nextStep="Start with the calculator that matches your current cushion and income risk."
    />



    <section id="HubReview" class="callout">
      <div class="eyebrow">Review status</div>
      <h2>Emergency savings calculator hub reviewed for clear assumptions, practical examples, and useful limits.</h2>

      <p>
        <strong>Written and maintained by Dustin Baker.</strong> Last reviewed: July 2026.
        This hub is part of the ShouldISpend calculator library and is reviewed for calculation accuracy, working links, practical examples, and clear limitations.
      </p>

      <p>
        These calculators are educational pressure tests. They help readers compare
        starter emergency funds, three-month cushions, six-month cushions, debt payoff, and savings after major purchases against take-home income, savings, debt, outside help, monthly
        breathing room, and recovery risk. They are not personalized financial, legal,
        tax, medical, insurance, or investment advice.
      </p>

      <p>
        For more context, review the <a href="/methodology/">Methodology</a>,
        <a href="/editorial-policy/">Editorial Policy</a>, and
        <a href="/disclaimer/">Disclaimer</a>.
      </p>
    </section>

    <section id="CrawlableHubExamples" class="wide-section">
      <div class="eyebrow">Worked examples</div>
      <h2>Examples this hub is meant to help pressure-test</h2>

      <p>
        These examples are visible before anyone uses a form. They show how the same
        category can produce very different pressure depending on savings, income,
        debt, outside help, urgency, and whether the decision creates a recurring bill.
      </p>

      <ul class="check-list">
        <li>A starter emergency fund for someone trying to create a first cash floor before aggressive debt payoff.</li>
        <li>A three-month emergency fund target based on essential expenses, not total lifestyle spending.</li>
        <li>A six-month cushion for a household with unstable income, dependents, or high fixed costs.</li>
        <li>A big purchase that is low-pressure because enormous savings remain afterward.</li>
      </ul>
    </section>

    <section id="HubLimits" class="section">
      <div class="eyebrow">When this hub is not enough</div>
      <h2>Use the calculators as a starting point, not the final word.</h2>

      <p>
        A calculator can clarify pressure, but it cannot know every detail of a household.
        Slow down before relying on a result alone when the decision involves legal
        obligations, taxes, medical treatment, insurance disputes, unstable income,
        major debt, family obligations, or a situation where the lowest-cost option
        could create larger harm later.
      </p>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Pressure factors</div>
      <h2>What changes the right emergency savings target?</h2>

      <p>
        Emergency savings is not one universal number. The safer target depends on
        what the household must keep paying, how reliable income is, who depends on
        the cash, and what would happen if the next surprise arrived after a planned
        purchase.
      </p>

      <div class="info-grid">
        {emergencySavingsPressureFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Savings targets</div>
      <h2>Starter, three-month, six-month, and after-purchase targets answer different questions.</h2>

      <p>
        A starter fund helps stop small emergencies from becoming debt. A three-month
        or six-month fund protects against larger income shocks. An after-purchase
        check asks whether a planned expense leaves enough cash to recover.
      </p>

      <div class="info-grid">
        {emergencySavingsTargets.map((target) => (
          <div class="info-card">
            <h3>{target.title}</h3>
            <p>{target.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="eyebrow">Warning signs</div>
      <h2>Emergency savings red flags</h2>

      <p>
        These warning signs do not mean the household has failed. They mean the
        savings target, purchase timing, or debt payoff plan needs more protection
        before the cushion is treated as safe.
      </p>

      <ul class="red-flag-list">
        {emergencySavingsRedFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Lower the risk</div>
      <h2>Ways to make an emergency fund plan safer</h2>

      <div class="info-grid">
        {emergencySavingsSaferSteps.map((step) => (
          <div class="info-card">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Related tools</div>
      <h2>Other calculators that connect to emergency savings</h2>

      <div class="link-grid">
        {relatedEmergencyPlanningLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="callout dark-callout">
      <div class="eyebrow">Use these as pressure tests</div>
      <h2>An emergency fund should protect the next decision, not just satisfy a rule.</h2>

      <p>
        ShouldISpend emergency savings calculators are educational tools. They are
        designed to help readers compare cash cushion, debt payoff, essential bills,
        income risk, and the savings left after major purchases. They are not
        personalized financial, legal, tax, insurance, investment, or crisis advice.
      </p>
    </section>

  </main>
</Layout>