---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const debtFaqs = [
  {
    question: "How much debt is too much?",
    answer:
      "Debt may be too much when monthly payments prevent saving, create stress after normal bills, force credit card use, or leave little room for emergencies.",
  },
  {
    question: "What is a risky debt-to-income ratio?",
    answer:
      "A debt-to-income ratio above 36% can start to feel tight for many households, and ratios above 43% often create serious affordability pressure, especially without strong savings.",
  },
  {
    question: "Should I include my mortgage or rent as debt?",
    answer:
      "Rent is usually treated as a housing cost, not debt. A mortgage is debt, but for affordability decisions, it is often evaluated separately from credit cards, student loans, car loans, and personal loans.",
  },
  {
    question: "Is credit card debt worse than other debt?",
    answer:
      "Credit card debt is often more dangerous because interest rates are usually high and balances can grow quickly if payments are not aggressive.",
  },
  {
    question: "What debt should I pay off first?",
    answer:
      "Many people prioritize high-interest debt first, especially credit cards, while still maintaining enough emergency savings to avoid adding new debt during surprises.",
  },
];
---

<Layout
  title="How Much Debt Is Too Much?"
  description="Use this debt pressure calculator to evaluate debt-to-income ratio, monthly payments, savings, credit card debt, and whether your finances are becoming dangerously stretched."
>
  <style>
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.95;
      margin-bottom: 28px;
      color: #0f172a;
      max-width: 860px;
    }

    .intro {
      font-size: 1.12rem;
      line-height: 1.9;
      color: #334155;
      max-width: 820px;
      margin-bottom: 48px;
    }

    .calculator-box,
    .callout,
    .link-card,
    .info-card {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 22px;
      padding: 26px;
    }

    .calculator-box {
      margin-bottom: 56px;
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .calculator-box h2,
    .content-section h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-box p,
    .content-section p,
    .content-section li {
      color: #334155;
      line-height: 1.9;
      font-size: 1.06rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-top: 22px;
    }

    label {
      display: block;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 8px;
      font-size: 0.95rem;
    }

    input {
      width: 100%;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 13px;
      font-size: 1rem;
      box-sizing: border-box;
    }

    button {
      margin-top: 24px;
      border: none;
      border-radius: 999px;
      padding: 15px 24px;
      background: #0f766e;
      color: white;
      font-weight: 900;
      font-size: 1rem;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 32px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 32px;
      display: none;
    }

    .result.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin-bottom: 12px;
    }

    .guidance {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #dbe4ee;
      color: #0f172a;
      font-size: 1.08rem;
      line-height: 1.8;
    }

    .fine-print {
      color: #64748b;
      font-size: 0.9rem;
      margin-top: 20px;
    }

    .content-section {
      margin-top: 72px;
    }

    .content-section h3 {
      font-size: 1.3rem;
      margin-top: 34px;
      margin-bottom: 12px;
      color: #0f172a;
    }

    .callout {
      background: #f8fafc;
      margin-top: 28px;
    }

    .link-grid,
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 28px;
    }

    .link-card,
    .info-card {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .link-card strong,
    .info-card h3 {
      display: block;
      margin: 0 0 10px;
      color: #0f172a;
      line-height: 1.3;
    }

    .link-card span,
    .info-card p {
      color: #334155;
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }
  </style>

  <main class="container">
    <div class="eyebrow">Debt Pressure Calculator</div>

    <h1>How Much Debt Is Too Much?</h1>

    <p class="intro">
      Debt becomes dangerous when it quietly removes flexibility from the rest of
      your financial life. Use this calculator to estimate whether your debt
      load looks manageable, tight, high pressure, or financially dangerous.
    </p>

    <section class="calculator-box">
      <h2>Debt Pressure Calculator</h2>

      <p>
        Enter your monthly take-home income, debt payments, housing cost,
        savings, and high-interest debt. The calculator estimates your debt
        pressure score and explains what the numbers mean.
      </p>

      <div class="form-grid">
        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 6500" />
        </div>

        <div>
          <label for="debtPayments">Monthly debt payments</label>
          <input id="debtPayments" type="number" placeholder="Example: 1400" />
        </div>

        <div>
          <label for="housing">Monthly rent or mortgage</label>
          <input id="housing" type="number" placeholder="Example: 1800" />
        </div>

        <div>
          <label for="savings">Emergency savings</label>
          <input id="savings" type="number" placeholder="Example: 12000" />
        </div>

        <div>
          <label for="creditCardDebt">Credit card debt</label>
          <input id="creditCardDebt" type="number" placeholder="Example: 6000" />
        </div>

        <div>
          <label for="totalDebt">Total non-mortgage debt</label>
          <input id="totalDebt" type="number" placeholder="Example: 28000" />
        </div>
      </div>

      <button id="calculateButton" type="button">Check Debt Pressure</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="fill" id="scoreFill"></div>
        </div>

        <div class="result-details" id="resultDetails"></div>

        <div class="guidance" id="guidance"></div>

        <div class="fine-print">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>How Debt Creates Monthly Financial Pressure</h2>

      <p>
        A large debt balance can be manageable if the monthly payment is low,
        the interest rate is reasonable, and the rest of the budget is stable. A
        smaller balance can still create stress if the payment is high, interest
        is expensive, or the household has limited savings.
      </p>

      <p>
        The bigger question is how much your debt reduces monthly flexibility
        after housing, food, transportation, utilities, insurance, savings, and
        normal life are paid.
      </p>

      <div class="callout">
        <p>
          Debt is usually too much when it prevents progress, creates stress, or
          forces new borrowing to cover normal life.
        </p>
      </div>
    </section>

    <section class="content-section">
      <h2>Debt-to-Income Ratio: A Useful Warning Light</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Under 20%</h3>
          <p>Often manageable if savings are healthy and payments do not interfere with basic expenses.</p>
        </div>

        <div class="info-card">
          <h3>20% to 35%</h3>
          <p>Worth watching closely, especially if housing costs are high or emergency savings are thin.</p>
        </div>

        <div class="info-card">
          <h3>36% to 43%</h3>
          <p>A caution zone where new large payments can quickly reduce financial flexibility.</p>
        </div>

        <div class="info-card">
          <h3>Above 43%</h3>
          <p>Often a high-pressure zone where debt may limit housing, saving, and major spending choices.</p>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>Warning Signs Your Debt Is Too High</h2>

      <ul>
        <li>You can only afford minimum payments</li>
        <li>You use credit cards for normal expenses</li>
        <li>You cannot build or rebuild emergency savings</li>
        <li>Debt payments make rent or car payments feel tight</li>
        <li>You need bonuses, overtime, or side income just to stay current</li>
        <li>You avoid looking at balances because they feel overwhelming</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Debt and Major Spending Decisions</h2>

      <p>
        Debt affects almost every major spending decision. A vacation, funeral,
  wedding, car payment, rent increase, or home purchase can look affordable
  until existing debt payments are included.
      </p>

      <div class="link-grid">
        <a class="link-card" href="/what-counts-as-debt">
          <strong>What Counts as Debt?</strong>
          <span>See which obligations should be included when evaluating affordability and monthly pressure.</span>
        </a>

        <a class="link-card" href="/how-much-emergency-savings-should-i-have">
          <strong>Emergency Savings Guide</strong>
          <span>Learn how much cushion to keep while paying down debt or making a major purchase.</span>
        </a>

        <a class="link-card" href="/should-i-spend-700-on-a-car-payment">
          <strong>$700 Car Payment Calculator</strong>
          <span>Understand how debt affects vehicle affordability and payment comfort.</span>
        </a>

        <a class="link-card" href="/should-i-spend-30000-on-a-wedding">
          <strong>$30,000 Wedding Calculator</strong>
          <span>Evaluate wedding spending against savings, debt, and post-wedding flexibility.</span>
        </a>

        <a class="link-card" href="/should-i-spend-1500-on-groceries-per-month">
  <strong>$1,500 Grocery Calculator</strong>

  <span>
    Evaluate whether recurring grocery spending fits your income, debt load,
    savings cushion, and monthly flexibility.
  </span>
</a>

<a class="link-card" href="/should-i-spend-this-much-eating-out-per-month">
  <strong>Eating Out Budget Calculator</strong>

  <span>
    Compare restaurant and takeout spending against debt pressure, savings,
    groceries, and recurring monthly obligations.
  </span>
</a>

<a class="link-card" href="/should-i-spend-10000-on-a-funeral">
  <strong>$10,000 Funeral Calculator</strong>

  <span>
    Evaluate whether funeral costs fit savings, insurance help, debt pressure,
    and emergency financial flexibility.
  </span>
</a>
      </div>
    </section>

    <section class="content-section">
      <h2>The Bottom Line on Too Much Debt</h2>

      <p>
        Debt is too much when it starts controlling the rest of the budget. If
        debt payments prevent saving, increase stress, or make normal expenses
        harder to manage, the next major purchase should probably wait.
      </p>
    </section>

    <FAQSection title="Debt Affordability FAQ" faqs={debtFaqs} />
  </main>

  <script>
    const button = document.getElementById("calculateButton");
    const result = document.getElementById("result");
    const scoreText = document.getElementById("scoreText");
    const scoreFill = document.getElementById("scoreFill");
    const resultDetails = document.getElementById("resultDetails");
    const guidance = document.getElementById("guidance");

    button?.addEventListener("click", () => {
      const income = Number(document.getElementById("income").value);
      const debtPayments = Number(document.getElementById("debtPayments").value || 0);
      const housing = Number(document.getElementById("housing").value || 0);
      const savings = Number(document.getElementById("savings").value || 0);
      const creditCardDebt = Number(document.getElementById("creditCardDebt").value || 0);
      const totalDebt = Number(document.getElementById("totalDebt").value || 0);

      result?.classList.add("visible");

      if (!income) {
        scoreText.textContent = "Add Monthly Income First";
        scoreFill.style.width = "0%";
        scoreFill.className = "fill";
        resultDetails.innerHTML = "<p>Enter monthly take-home income to calculate debt pressure.</p>";
        guidance.textContent = "";
        return;
      }

      const debtPaymentRatio = debtPayments / income;
      const fixedObligationRatio = (debtPayments + housing) / income;
      const savingsMonths = savings / Math.max(income * 0.7, 1);
      const creditCardRatio = creditCardDebt / Math.max(income, 1);
      const totalDebtRatio = totalDebt / Math.max(income * 12, 1);

      let score = 100;

      if (debtPaymentRatio >= 1 || fixedObligationRatio >= 1.15) {
        score = 0;
      } else {
        if (debtPaymentRatio > 0.6) score -= 55;
        else if (debtPaymentRatio > 0.43) score -= 42;
        else if (debtPaymentRatio > 0.36) score -= 30;
        else if (debtPaymentRatio > 0.25) score -= 20;
        else if (debtPaymentRatio > 0.15) score -= 10;
        else if (debtPaymentRatio < 0.08) score += 8;

        if (fixedObligationRatio > 0.85) score -= 35;
        else if (fixedObligationRatio > 0.7) score -= 25;
        else if (fixedObligationRatio > 0.55) score -= 15;
        else if (fixedObligationRatio > 0.45) score -= 8;

        if (savingsMonths < 1) score -= 28;
        else if (savingsMonths < 3) score -= 18;
        else if (savingsMonths < 6) score -= 8;
        else if (savingsMonths > 12) score += 8;

        if (creditCardRatio > 2) score -= 24;
        else if (creditCardRatio > 1) score -= 16;
        else if (creditCardRatio > 0.5) score -= 8;
        else if (creditCardDebt === 0) score += 6;

        if (totalDebtRatio > 1.5) score -= 20;
        else if (totalDebtRatio > 1) score -= 14;
        else if (totalDebtRatio > 0.5) score -= 8;

        score = Math.max(0, Math.min(100, Math.round(score)));
      }

      let verdict = "Low Debt Pressure";
      let explanation =
        "Your debt load appears manageable based on income, monthly debt payments, housing cost, savings, and high-interest debt.";

      if (score === 0) {
        verdict = "Critical Debt Pressure";
        explanation =
          "Your debt and fixed obligations appear to exceed what your monthly income can safely support. Avoid new major spending and consider professional debt help.";
      } else if (score < 35) {
        verdict = "Severe Debt Pressure";
        explanation =
          "Your debt load appears financially dangerous. New major purchases should probably wait until monthly obligations are reduced.";
      } else if (score < 50) {
        verdict = "High Debt Pressure";
        explanation =
          "Debt payments are taking up a large share of your financial flexibility. Focus on reducing pressure before adding new commitments.";
      } else if (score < 75) {
        verdict = "Manageable With Guardrails";
        explanation =
          "Your debt may be manageable, but there are warning signs. Watch savings, housing pressure, credit card balances, and new spending decisions.";
      } else if (score < 90) {
        verdict = "Comfortable Debt Load";
        explanation =
          "Your debt load appears reasonably comfortable, though continued savings and payoff progress still matter.";
      }

      scoreText.textContent = `${verdict} - ${score}/100`;

      scoreFill.style.width = `${Math.max(score, 6)}%`;
      scoreFill.className = "fill";

      if (score >= 75) {
        scoreFill.classList.add("safe");
      } else if (score >= 50) {
        scoreFill.classList.add("caution");
      } else {
        scoreFill.classList.add("danger");
      }

      resultDetails.innerHTML = `
        <p><strong>Debt payment ratio:</strong> ${(debtPaymentRatio * 100).toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Debt + housing pressure:</strong> ${(fixedObligationRatio * 100).toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Emergency savings cushion:</strong> About ${savingsMonths.toFixed(1)} months of estimated core expenses.</p>
        <p><strong>Credit card debt pressure:</strong> ${creditCardDebt > 0 ? `$${creditCardDebt.toLocaleString()} in credit card debt.` : "No credit card debt entered."}</p>
        <p><strong>Total non-mortgage debt:</strong> ${totalDebt > 0 ? `$${totalDebt.toLocaleString()}.` : "No total debt entered."}</p>
      `;

      guidance.textContent = explanation;
    });
  </script>
</Layout>