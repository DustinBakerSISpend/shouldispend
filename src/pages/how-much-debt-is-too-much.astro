---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
---

<Layout
  title="How Much Debt Is Too Much?"
  description="Use this debt pressure calculator to evaluate monthly debt payments, debt-to-income ratio, housing costs, savings, credit card debt, and overall financial flexibility."
>

    <OmniStyleReviewBlock
      pageName="the debt pressure guide"
      pageType="guide"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="monthly debt payments, take-home income, fixed obligations, emergency savings, and whether debt is crowding out normal life"
    />

    <CorePageExamplesBlock
      title="Debt pressure examples"
      intro="Debt does not become dangerous at one universal percentage. The pressure depends on income, emergency savings, fixed bills, interest rates, and how much room is left after payments."
      useCases={[
          "You want to know whether monthly debt payments are becoming too heavy.",
          "You are comparing credit cards, student loans, car payments, medical debt, or personal loans.",
          "You need a practical pressure test before taking on another payment."
        ]}
      notEnough={[
          "You are already missing payments or facing collections.",
          "You need bankruptcy, tax, legal, or credit counseling advice.",
          "The debt involves a court order, wage garnishment, or business liability."
        ]}
      examples={[
          {
            label: "$400 of monthly debt on $4,000 take-home income",
            takeaway: "This may be manageable if rent, food, insurance, and savings are still covered. It becomes more stressful when the emergency fund is thin or the debt has high interest."
          },
          {
            label: "$1,200 of monthly debt on $4,000 take-home income",
            takeaway: "This is much more likely to create pressure because debt alone takes a large share of take-home income before housing, groceries, transportation, and savings."
          },
          {
            label: "High debt with strong savings",
            takeaway: "Large savings can reduce emergency pressure, but it does not erase a monthly cash-flow problem if the debt payments keep crowding out normal bills."
          }
        ]}
      commonMistake="Looking only at total debt balance instead of the monthly payment pressure and interest rate."
      nextStep="Compare your debt payment total with rent, groceries, transportation, emergency savings, and the next payment you are considering."
    />


  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
      box-sizing: border-box;
    }

    button {
      background: #0f172a;
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      width: 100%;
      display: block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
      display: none;
      background: #f8fafc;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .content-section p,
    .content-section li {
      line-height: 1.8;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Debt Pressure Calculator"
      title="How Much Debt Is Too Much?"
      description="Estimate whether your monthly debt payments, credit card balances, housing costs, savings, and total non-mortgage debt are creating low, moderate, or high financial pressure."
    >
      <div class="card">
        <h2>Debt Pressure Verdict</h2>

        <div class="grid">
          <div>
            <label for="income">Monthly Take-Home Income</label>
            <input id="income" type="number" placeholder="6500" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="debtPayments">Monthly Debt Payments</label>
            <input id="debtPayments" type="number" placeholder="1400" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="housing">Monthly Rent or Mortgage</label>
            <input id="housing" type="number" placeholder="1800" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="savings">Emergency Savings</label>
            <input id="savings" type="number" placeholder="12000" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="creditCardDebt">Credit Card Debt</label>
            <input id="creditCardDebt" type="number" placeholder="6000" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="totalDebt">Total Non-Mortgage Debt</label>
            <input id="totalDebt" type="number" placeholder="28000" min="0" inputmode="decimal" />
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="debtButton" type="button">
          Calculate Debt Pressure
        </button>

        <div class="result" id="result">
          <div class="score" id="score"></div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="debtRatio"></div>
          <div class="metric" id="fixedPressure"></div>
          <div class="metric" id="creditCardPressure"></div>
          <div class="metric" id="savingsCushion"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial, legal, tax, credit, lending, or debt-settlement advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <h2>How Debt Creates Monthly Financial Pressure</h2>

        <p>
          Debt becomes too much when it removes flexibility from the rest of your financial life. A balance can look manageable on paper but still create stress if the monthly payment blocks saving, strains housing, or forces new credit card use.
        </p>

        <p>
          This calculator focuses on pressure, not shame. It looks at monthly debt payments, housing, emergency savings, credit card debt, and total non-mortgage debt to estimate how much room your budget still has.
        </p>
      </div>

      <WhenSpendingMakesSense
        title="When Debt May Still Be Manageable"
        items={[
          "Monthly debt payments take up a modest share of take-home income.",
          "Housing and debt together leave enough room for food, transportation, utilities, savings, and normal life.",
          "Credit card debt is low or being paid down aggressively.",
          "Emergency savings can cover several months of core expenses.",
          "You are not using new debt to cover normal monthly spending.",
        ]}
      />

      <div class="content-section">
        <h2>When Debt Becomes Too Much</h2>

        <p>
          Debt is usually too much when payments control the budget. If debt prevents saving, creates constant stress, or makes normal expenses feel unstable, new major purchases should probably wait.
        </p>

        <p>
          High-interest credit card debt is especially important because it can grow quickly and make minimum payments feel like progress even when the balance barely moves.
        </p>
      </div>

      <KeyCostCategories
        items={[
          {
            title: "Monthly debt payment ratio",
            description:
              "The share of take-home income going to credit cards, car loans, student loans, personal loans, and other required debt payments.",
          },
          {
            title: "Debt plus housing pressure",
            description:
              "Housing and debt together often reveal whether the monthly budget has enough room left for normal life.",
          },
          {
            title: "Credit card debt",
            description:
              "High-interest credit card balances can create more pressure than lower-interest installment debt.",
          },
          {
            title: "Emergency savings",
            description:
              "Debt is less risky when savings can absorb emergencies without forcing new borrowing.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Avoid adding new major payments while the debt pressure score is high.",
          "Prioritize high-interest credit card debt when possible.",
          "Keep a starter emergency fund so surprises do not create more debt.",
          "Compare payoff methods, including avalanche and snowball strategies.",
          "Look for recurring expenses that can be redirected toward debt payoff.",
          "Consider nonprofit credit counseling if payments are no longer manageable.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "You can only afford minimum payments.",
          "You use credit cards for normal expenses because cash flow is too tight.",
          "Debt payments prevent you from building emergency savings.",
          "Debt and housing together consume most of your take-home income.",
          "You need overtime, bonuses, tax refunds, or side income just to stay current.",
          "You avoid checking balances because the debt feels overwhelming.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "Monthly income means take-home pay after taxes and payroll deductions.",
          "Monthly debt payments include credit cards, car loans, student loans, personal loans, medical debt payments, and other required debt payments.",
          "Housing is evaluated separately but included in fixed-obligation pressure.",
          "Credit card debt receives extra weight because it is often high-interest and revolving.",
          "Total non-mortgage debt is compared against annual take-home income to estimate longer-term pressure.",
          "The result is educational guidance, not financial advice.",
        ]}
      />

      <FAQSection
        title="Debt Affordability FAQ"
        faqs={[
          {
            question: "How much debt is too much?",
            answer:
              "Debt may be too much when monthly payments prevent saving, create stress after normal bills, force credit card use, or leave little room for emergencies.",
          },
          {
            question: "What is a risky debt-to-income ratio?",
            answer:
              "Debt payments above 36% of monthly take-home income can start to feel tight for many households. Above 43% often creates serious pressure, especially when housing costs and emergency savings are weak.",
          },
          {
            question: "Should I include my mortgage or rent as debt?",
            answer:
              "Rent is usually treated as housing, not debt. A mortgage is technically debt, but for spending decisions, housing is often evaluated separately from credit cards, student loans, car loans, and personal loans.",
          },
          {
            question: "Is credit card debt worse than other debt?",
            answer:
              "Credit card debt is often more dangerous because interest rates are usually high, balances can grow quickly, and minimum payments may barely reduce principal.",
          },
          {
            question: "What debt should I pay off first?",
            answer:
              "Many people prioritize high-interest debt first, especially credit cards, while keeping enough emergency savings to avoid adding new debt during surprises.",
          },
        ]}
      />

      <MethodologySection category="debt pressure" updated="May 2026" />

      <RelatedGuides
        guides={[
          {
            title: "What Counts as Debt?",
            href: "/what-counts-as-debt",
            description:
              "Understand which monthly obligations should be included when estimating financial pressure.",
          },
          {
            title: "Emergency Savings Guide",
            href: "/how-much-emergency-savings-should-i-have",
            description:
              "Learn how much cushion to keep while paying down debt or making a major purchase.",
          },
        ]}
      />

      <RelatedCalculators
        calculators={[
          {
            category: "Cars",
            title: "Should I Spend $700 on a Car Payment?",
            href: "/should-i-spend-700-on-a-car-payment",
          },
          {
            category: "Groceries",
            title: "Should I Spend $1,500 on Groceries Per Month?",
            href: "/should-i-spend-1500-on-groceries-per-month",
          },
          {
            category: "Groceries",
            title: "Should I Spend This Much Eating Out Per Month?",
            href: "/should-i-spend-this-much-eating-out-per-month",
          },
          {
            category: "Weddings",
            title: "Should I Spend $30,000 on a Wedding?",
            href: "/should-i-spend-30000-on-a-wedding",
          },
        ]}
      />
    </CalculatorPageShell>
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Debt Pressure",
          stress: "Low pressure",
          color: "#16a34a",
          action: "Keep making progress, avoid unnecessary new debt, and maintain your emergency cushion.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Debt Pressure",
          stress: "Moderate pressure",
          color: "#ca8a04",
          action: "Be careful before adding new payments, watch credit card balances, and protect monthly savings.",
        };
      }

      return {
        label: "High Debt Pressure",
        stress: "High pressure",
        color: "#dc2626",
        action: "Slow down before taking on new commitments and focus on reducing monthly pressure.",
      };
    }

    function calculateDebt() {
      const income = getNumber("income");
      const debtPayments = getNumber("debtPayments");
      const housing = getNumber("housing");
      const savings = getNumber("savings");
      const creditCardDebt = getNumber("creditCardDebt");
      const totalDebt = getNumber("totalDebt");

      const result = document.getElementById("result");
      const scoreEl = document.getElementById("score");
      const barFill = document.getElementById("barFill");
      const debtRatioEl = document.getElementById("debtRatio");
      const fixedPressureEl = document.getElementById("fixedPressure");
      const creditCardPressureEl = document.getElementById("creditCardPressure");
      const savingsCushionEl = document.getElementById("savingsCushion");
      const guidanceEl = document.getElementById("guidance");

      result.style.display = "block";

      if (income <= 0) {
        scoreEl.textContent = "Add your income first";
        barFill.style.width = "0%";
        barFill.style.background = "#16a34a";
        debtRatioEl.innerHTML = "";
        fixedPressureEl.innerHTML = "";
        creditCardPressureEl.innerHTML = "";
        savingsCushionEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter monthly take-home income so the calculator can estimate debt pressure.";
        return;
      }

      const debtPaymentRatio = (debtPayments / income) * 100;
      const fixedObligationRatio = ((debtPayments + housing) / income) * 100;
      const monthlyCoreOutflow = debtPayments + housing;
      const monthlyRemaining = income - monthlyCoreOutflow;
      const emergencyMonths =
        monthlyCoreOutflow > 0 ? savings / monthlyCoreOutflow : savings > 0 ? 12 : 0;
      const creditCardToMonthlyIncome = (creditCardDebt / income) * 100;
      const totalDebtToAnnualIncome = (totalDebt / (income * 12)) * 100;

      let pressureScore = 0;

      pressureScore += clamp(debtPaymentRatio * 1.35, 0, 38);
      pressureScore += clamp(fixedObligationRatio * 0.38, 0, 32);
      pressureScore += clamp(creditCardToMonthlyIncome * 0.16, 0, 24);
      pressureScore += clamp(totalDebtToAnnualIncome * 0.12, 0, 20);

      if (monthlyRemaining < 0) pressureScore += 30;
      else if (monthlyRemaining < income * 0.08) pressureScore += 18;
      else if (monthlyRemaining < income * 0.15) pressureScore += 10;
      else if (monthlyRemaining > income * 0.35) pressureScore -= 8;

      if (emergencyMonths < 1 && income < 12000) pressureScore += 22;
      else if (emergencyMonths < 3 && income < 15000) pressureScore += 12;
      else if (emergencyMonths >= 6) pressureScore -= 8;
      else if (emergencyMonths >= 12) pressureScore -= 12;

      if (debtPaymentRatio >= 60) pressureScore += 22;
      else if (debtPaymentRatio >= 43) pressureScore += 14;
      else if (debtPaymentRatio >= 36) pressureScore += 8;

      if (fixedObligationRatio >= 90) pressureScore += 22;
      else if (fixedObligationRatio >= 75) pressureScore += 14;
      else if (fixedObligationRatio >= 60) pressureScore += 8;

      if (creditCardDebt > 0 && creditCardToMonthlyIncome >= 150) pressureScore += 18;
      else if (creditCardDebt > 0 && creditCardToMonthlyIncome >= 75) pressureScore += 10;
      else if (creditCardDebt === 0) pressureScore -= 6;

      if (income >= 12000 && monthlyRemaining > income * 0.25 && emergencyMonths >= 3) {
        pressureScore -= 10;
      }

      if (income >= 20000 && monthlyRemaining > income * 0.3 && emergencyMonths >= 3) {
        pressureScore -= 12;
      }

      if (
        debtPaymentRatio < 15 &&
        fixedObligationRatio < 45 &&
        emergencyMonths >= 6 &&
        creditCardDebt === 0 &&
        monthlyRemaining > income * 0.3
      ) {
        pressureScore = Math.min(pressureScore, 22);
      }

      if (
        debtPaymentRatio < 8 &&
        fixedObligationRatio < 35 &&
        emergencyMonths >= 9 &&
        creditCardDebt === 0 &&
        monthlyRemaining > income * 0.4
      ) {
        pressureScore = Math.min(pressureScore, 12);
      }

      if (debtPayments >= income || fixedObligationRatio >= 115) {
        pressureScore = Math.max(pressureScore, 92);
      }

      pressureScore = Math.round(clamp(pressureScore, 0, 100));

      const level = getPressureLevel(pressureScore);

      let guidance = "";

      if (pressureScore <= 30) {
        guidance =
          `Your debt load appears manageable based on the numbers provided. Monthly debt payments equal about ${debtPaymentRatio.toFixed(1)}% of take-home income, and your estimated emergency cushion is about ${Math.max(emergencyMonths, 0).toFixed(1)} months.`;
      } else if (pressureScore <= 60) {
        guidance =
          `Your debt load may be workable, but it creates noticeable pressure. Monthly debt payments equal about ${debtPaymentRatio.toFixed(1)}% of take-home income, and debt plus housing equals about ${fixedObligationRatio.toFixed(1)}%.`;
      } else {
        guidance =
          `Your debt load may be creating serious financial pressure. Monthly debt payments equal about ${debtPaymentRatio.toFixed(1)}% of take-home income, and the combination of housing, credit card debt, total debt, or savings suggests you should avoid new major commitments.`;
      }

      scoreEl.textContent = `${level.label}  -  ${pressureScore}/100`;
      scoreEl.style.color = level.color;
      barFill.style.width = `${pressureScore}%`;
      barFill.style.background = level.color;

      debtRatioEl.innerHTML = `<strong>Monthly debt payment ratio:</strong> ${debtPaymentRatio.toFixed(1)}% of take-home income`;
      fixedPressureEl.innerHTML = `<strong>Debt + housing pressure:</strong> ${fixedObligationRatio.toFixed(1)}% of take-home income`;
      creditCardPressureEl.innerHTML = `<strong>Credit card debt pressure:</strong> ${
        creditCardDebt > 0
          ? `$${Math.round(creditCardDebt).toLocaleString()} entered`
          : "No credit card debt entered"
      }`;
      savingsCushionEl.innerHTML = `<strong>Estimated emergency cushion:</strong> ${Math.max(emergencyMonths, 0).toFixed(1)} months`;
      guidanceEl.textContent = `${guidance} Recommended next step: ${level.action}`;
    }

    document
      .getElementById("debtButton")
      .addEventListener("click", calculateDebt);
  </script>
</Layout>
