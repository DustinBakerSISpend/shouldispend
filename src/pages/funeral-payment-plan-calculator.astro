---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import { calculators } from "../data/calculators.js";

const paymentPlanFaqs = [
  {
    question: "How much would a funeral payment plan cost per month?",
    answer:
      "The monthly payment depends on the amount financed, interest rate, fees, and repayment term. A shorter term usually costs more per month but less overall. A longer term lowers the monthly payment but can increase total interest.",
  },
  {
    question: "Is a funeral payment plan a bad idea?",
    answer:
      "A funeral payment plan can help with timing, but it becomes risky if the monthly payment strains the household, the interest rate is high, or the plan keeps the family in debt long after the funeral.",
  },
  {
    question: "Should I use savings instead of a funeral payment plan?",
    answer:
      "Using savings may be safer if enough emergency cushion remains afterward. A payment plan may make sense only when the payment is affordable and the household is not taking on high-interest debt unnecessarily.",
  },
  {
    question: "What funeral payment plan terms should I avoid?",
    answer:
      "Be careful with high interest, unclear fees, prepayment penalties, balloon payments, credit-card financing, and any monthly payment that crowds out rent, groceries, transportation, medical costs, or existing debt payments.",
  },
  {
    question: "Does this calculator use gross income or take-home income?",
    answer:
      "Use monthly take-home pay. That gives a more realistic view of whether the payment fits after taxes and payroll deductions.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "Funeral Costs" &&
      calculator.href !== "/funeral-payment-plan-calculator"
  )
  .slice(0, 4);
---

<Layout
  title="Funeral Payment Plan Calculator"
  description="Estimate funeral payment plan monthly payments, total interest, payoff timeline, and whether the payment fits your income, savings, debt, and household obligations."
>
  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .total-price {
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 900;
      color: #0f172a;
      line-height: 1.05;
      margin-bottom: 12px;
    }

    .result-label {
      font-size: 1.15rem;
      font-weight: 800;
      color: #0f766e;
      margin-bottom: 24px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .mini-summary {
      margin-top: 24px;
      padding: 20px;
      border-radius: 18px;
      background: white;
      border: 1px solid #dbe4ee;
      color: #334155;
      line-height: 1.8;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
    }

    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .content-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Funeral Payment Plan Calculator"
      title="Funeral Payment Plan Calculator"
      description="Estimate monthly payments, total interest, payoff time, and whether a funeral payment plan fits your income, savings, debt, and household obligations."
    >
      <div class="calculator">
        <h2>Estimate Funeral Payment Plan Costs</h2>

        <p class="calculator-intro">
          Enter the funeral balance, down payment, repayment term, interest
          rate, fees, income, savings, and debt. This calculator estimates the
          monthly payment range and shows whether the payment is likely to be
          manageable.
        </p>

        <div class="grid">
          <div class="field">
            <label for="funeralCost">Total Funeral Cost</label>
            <input id="funeralCost" type="number" placeholder="Example: 12000" />
          </div>

          <div class="field">
            <label for="help">Insurance / Family Help</label>
            <input id="help" type="number" placeholder="Example: 3000" />
          </div>

          <div class="field">
            <label for="downPayment">Down Payment from Savings</label>
            <input id="downPayment" type="number" placeholder="Example: 1000" />
          </div>

          <div class="field">
            <label for="fees">Financing Fees</label>
            <input id="fees" type="number" placeholder="Example: 250" />
          </div>

          <div class="field">
            <label for="interestRate">Estimated Interest Rate</label>
            <input id="interestRate" type="number" step="0.1" placeholder="Example: 12.9" />
          </div>

          <div class="field">
            <label for="termMonths">Payment Plan Term</label>
            <select id="termMonths">
              <option value="6">6 months</option>
              <option value="12" selected>12 months</option>
              <option value="18">18 months</option>
              <option value="24">24 months</option>
              <option value="36">36 months</option>
              <option value="48">48 months</option>
              <option value="60">60 months</option>
            </select>
          </div>

          <div class="field">
            <label for="monthlyIncome">Monthly Take-Home Income</label>
            <input id="monthlyIncome" type="number" placeholder="Example: 7000" />
          </div>

          <div class="field">
            <label for="essentialBills">Monthly Essential Bills</label>
            <input id="essentialBills" type="number" placeholder="Example: 3600" />
          </div>

          <div class="field">
            <label for="debtPayments">Current Monthly Debt Payments</label>
            <input id="debtPayments" type="number" placeholder="Example: 900" />
          </div>

          <div class="field">
            <label for="emergencySavings">Emergency Savings Available</label>
            <input id="emergencySavings" type="number" placeholder="Example: 12000" />
          </div>

          <div class="field">
            <label for="emergencyTarget">Savings Cushion Wanted</label>
            <input id="emergencyTarget" type="number" placeholder="Example: 10000" />
          </div>

          <div class="field">
            <label for="paymentType">Payment Type</label>
            <select id="paymentType">
              <option value="funeralHome" selected>Funeral home payment plan</option>
              <option value="personalLoan">Personal loan</option>
              <option value="creditCard">Credit card</option>
              <option value="zeroInterest">0% promotional plan</option>
            </select>
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="paymentPlanButton" type="button">Calculate Funeral Payment Plan</button>

        <div class="results" id="results">
          <div class="result-label">Estimated Monthly Payment Range</div>

          <div class="total-price" id="totalPrice"></div>

          <div class="result-details" id="resultDetails"></div>

          <div class="mini-summary" id="priceSummary"></div>

          <div class="disclaimer">
            This is an educational estimate, not a loan quote. Confirm interest,
            fees, payoff terms, late fees, prepayment rules, and whether a lower
            funeral cost would avoid borrowing.
          </div>
        </div>
      </div>

      <section class="content-section">
        <h2>How This Funeral Payment Plan Calculator Works</h2>

        <p>
          This calculator estimates the amount financed after insurance, family
          help, and any down payment. It then estimates a monthly payment using
          the selected term, interest rate, and fees.
        </p>

        <p>
          The output is a payment range, not a verdict bar. The calculator still
          checks the payment against income, essential bills, existing debt, and
          savings because a low monthly payment can still be risky if the
          household is already stretched.
        </p>

        <p>
          Before financing, compare the plan against the
          <a class="content-link" href="/funeral-price-calculator">
            Funeral Price Calculator
          </a>
          and the
          <a class="content-link" href="/can-i-afford-a-funeral">
            Can I Afford a Funeral?
          </a>
          calculator.
        </p>
      </section>

      <KeyCostCategories
        items={[
          {
            title: "Amount financed",
            description:
              "The financed balance is the funeral cost minus insurance, family help, and down payment, plus any financing fees.",
          },
          {
            title: "Interest rate",
            description:
              "Higher interest can make a funeral payment plan more expensive even if the monthly payment looks manageable.",
          },
          {
            title: "Repayment term",
            description:
              "Longer terms lower the monthly payment but can increase total interest and keep the family in debt longer.",
          },
          {
            title: "Monthly cash flow",
            description:
              "The payment should fit after essentials, existing debt, and emergency savings needs are protected.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Ask whether the funeral home payment plan has interest, fees, or late-payment penalties.",
          "Compare the monthly payment to your remaining cash flow after essential bills and existing debt.",
          "Avoid using a credit card unless the balance can be paid quickly.",
          "Reduce the funeral cost before financing if the payment crowds out basic needs.",
          "Use insurance or family contributions to lower the financed balance when possible.",
          "Choose the shortest term that fits safely without damaging emergency savings.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "Monthly income means take-home pay, not gross income.",
          "The calculator estimates payments using the financed balance, interest rate, fees, and term.",
          "The displayed range includes a small planning buffer because real payment plans may include additional fees or rounding.",
          "A very high income and strong savings can make payment pressure effectively zero in the summary.",
          "This page does not use a verdict bar because the primary output is a monthly payment range.",
          "This calculator does not replace an actual loan, credit card, or funeral home financing agreement.",
        ]}
      />

      <section class="content-section">
        <h2>When a Funeral Payment Plan Makes Sense</h2>

        <p>
          A funeral payment plan is more reasonable when the financed balance is
          modest, the interest rate is low, the payoff period is short, and the
          monthly payment fits comfortably after housing, food, transportation,
          medical costs, existing debt, and basic savings needs.
        </p>

        <p>
          It becomes riskier when the payment plan is used to preserve an
          expensive funeral package that the household cannot actually afford.
          Financing should solve a timing problem, not hide a budget problem.
        </p>
      </section>

      <section class="content-section">
        <h2 id="FinancialRedFlags">Red Flags Before Financing Funeral Costs</h2>

        <p>
          Be careful if the payment plan feels like the only way to say yes to a
          funeral quote. A respectful funeral should not require years of debt,
          high-interest credit cards, or missed bills afterward.
        </p>

        <ul>
          <li>The monthly payment would last longer than two or three years</li>
          <li>The interest rate or fees are unclear</li>
          <li>The plan uses a credit card that will not be paid quickly</li>
          <li>The household already has high monthly debt payments</li>
          <li>The payment crowds out rent, food, transportation, or medical needs</li>
          <li>No one has compared direct cremation, simpler burial, or smaller memorial options</li>
        </ul>
      </section>

      <div class="content-section">
        <FAQSection title="Funeral Payment Plan Calculator FAQ" faqs={paymentPlanFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="funeral payment plan estimates" updated="June 2026" />
  </div>

  <script is:inline>
    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const getValue = (id) => document.getElementById(id)?.value || "";

    function formatMoney(value) {
      return value.toLocaleString(undefined, {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      });
    }

    function calculatePayment(principal, annualRate, months) {
      if (principal <= 0) return 0;
      if (annualRate <= 0) return principal / months;

      const monthlyRate = annualRate / 100 / 12;
      return (
        principal *
        (monthlyRate * Math.pow(1 + monthlyRate, months)) /
        (Math.pow(1 + monthlyRate, months) - 1)
      );
    }

    function getPaymentTypeRisk(paymentType) {
      if (paymentType === "zeroInterest") return "lowest";
      if (paymentType === "funeralHome") return "medium";
      if (paymentType === "personalLoan") return "medium";
      return "highest";
    }

    function getPaymentMessage(paymentRatio, cashFlowAfterPayment, savingsAfterDownPayment, emergencyTarget, income, paymentTypeRisk) {
      const hugeIncome =
        paymentRatio <= 0.5 &&
        cashFlowAfterPayment >= income * 0.5 &&
        savingsAfterDownPayment >= Math.max(emergencyTarget, income * 3);

      const hugeSavings =
        savingsAfterDownPayment >= Math.max(emergencyTarget * 5, income * 12) &&
        paymentRatio <= 2;

      if (hugeIncome || hugeSavings) {
        return "This payment creates essentially no measurable pressure based on the income, savings, and obligations entered.";
      }

      if (paymentRatio <= 2 && cashFlowAfterPayment > 0 && savingsAfterDownPayment >= emergencyTarget) {
        return "This payment appears manageable if the terms are clear and the funeral cost has already been trimmed.";
      }

      if (paymentRatio <= 5 && cashFlowAfterPayment > 0 && savingsAfterDownPayment >= emergencyTarget * 0.5) {
        return "This payment may be workable, but the household should look for lower-cost funeral options or a shorter payoff if possible.";
      }

      if (paymentTypeRisk === "highest") {
        return "This looks risky, especially if the balance is going on a credit card. Reduce the funeral cost before accepting this payment.";
      }

      return "This payment may create real pressure. Review a lower funeral quote, more family help, direct cremation, or a smaller memorial before financing.";
    }

    function calculateFuneralPaymentPlan() {
      const funeralCost = getNumber("funeralCost");
      const help = getNumber("help");
      const downPayment = getNumber("downPayment");
      const fees = getNumber("fees");
      const interestRate = getNumber("interestRate");
      const termMonths = Math.max(Number(getValue("termMonths")), 1);
      const monthlyIncome = getNumber("monthlyIncome");
      const essentialBills = getNumber("essentialBills");
      const debtPayments = getNumber("debtPayments");
      const emergencySavings = getNumber("emergencySavings");
      const emergencyTarget = getNumber("emergencyTarget");
      const paymentType = getValue("paymentType");

      const results = document.getElementById("results");
      const totalPrice = document.getElementById("totalPrice");
      const resultDetails = document.getElementById("resultDetails");
      const priceSummary = document.getElementById("priceSummary");

      results.classList.add("visible");

      if (funeralCost <= 0 || monthlyIncome <= 0) {
        totalPrice.textContent = "$0 - $0";
        resultDetails.innerHTML =
          "<p>Enter a funeral cost and monthly take-home income to estimate the payment plan.</p>";
        priceSummary.textContent = "";
        return;
      }

      const balanceBeforeFees = Math.max(0, funeralCost - help - downPayment);
      const financedBalance = Math.max(0, balanceBeforeFees + fees);
      const basePayment = calculatePayment(financedBalance, interestRate, termMonths);

      const lowPayment = Math.max(0, basePayment * 0.95);
      const highPayment = Math.max(lowPayment, basePayment * 1.08);

      const totalPaid = basePayment * termMonths;
      const totalInterestAndFees = Math.max(0, totalPaid - balanceBeforeFees);
      const savingsAfterDownPayment = emergencySavings - downPayment;
      const paymentRatio = monthlyIncome > 0 ? (basePayment / monthlyIncome) * 100 : 100;
      const debtRatioBefore = monthlyIncome > 0 ? (debtPayments / monthlyIncome) * 100 : 100;
      const debtRatioAfter = monthlyIncome > 0 ? ((debtPayments + basePayment) / monthlyIncome) * 100 : 100;
      const cashFlowAfterPayment = monthlyIncome - essentialBills - debtPayments - basePayment;
      const paymentTypeRisk = getPaymentTypeRisk(paymentType);

      const message = getPaymentMessage(
        paymentRatio,
        cashFlowAfterPayment,
        savingsAfterDownPayment,
        emergencyTarget,
        monthlyIncome,
        paymentTypeRisk
      );

      totalPrice.textContent = `${formatMoney(lowPayment)} - ${formatMoney(highPayment)}`;

      resultDetails.innerHTML = `
        <p><strong>Estimated monthly payment:</strong> ${formatMoney(lowPayment)} - ${formatMoney(highPayment)} for ${termMonths} months.</p>

        <p><strong>Estimated amount financed:</strong> ${formatMoney(financedBalance)} after help, down payment, and fees.</p>

        <p><strong>Estimated total repaid:</strong> ${formatMoney(totalPaid)}.</p>

        <p><strong>Estimated interest and fees:</strong> ${formatMoney(totalInterestAndFees)}.</p>

        <p><strong>Payment impact:</strong> about ${paymentRatio.toFixed(1)}% of monthly take-home income.</p>

        <p><strong>Debt pressure before payment:</strong> ${debtRatioBefore.toFixed(1)}% of take-home income.</p>

        <p><strong>Debt pressure after payment:</strong> ${debtRatioAfter.toFixed(1)}% of take-home income.</p>

        <p><strong>Cash flow after essentials, debt, and funeral payment:</strong> ${formatMoney(cashFlowAfterPayment)}.</p>

        <p><strong>Savings after down payment:</strong> ${formatMoney(savingsAfterDownPayment)}.</p>

        <p><strong>Funding context:</strong> ${message}</p>
      `;

      priceSummary.innerHTML = `
        This funeral payment plan is estimated at
        <strong>${formatMoney(lowPayment)} - ${formatMoney(highPayment)} per month</strong>.
        The financed balance is about <strong>${formatMoney(financedBalance)}</strong>,
        with estimated total repayment of <strong>${formatMoney(totalPaid)}</strong>.
      `;
    }

    document
      .getElementById("paymentPlanButton")
      .addEventListener("click", calculateFuneralPaymentPlan);
  </script>
</Layout>
