---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
---

<Layout
  title="Should I Spend $500 on a Car Payment?"
  description="Use this car payment calculator to decide whether a $500 monthly car payment fits your income, debt, insurance, savings, housing costs, and overall monthly cash flow."
>
  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
      box-sizing: border-box;
    }

    button {
      background: #0f172a;
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      width: 100%;
      display: block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
      display: none;
      background: #f8fafc;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }

    .content-section p,
    .content-section li {
      line-height: 1.8;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Car Payment Calculator"
      title="Should I Spend $500 on a Car Payment?"
      description="Estimate whether a $500 monthly car payment fits your income, insurance costs, debt load, emergency savings, housing costs, and total vehicle budget."
    >
      <div class="card">
        <h2>$500 Car Payment Pressure Verdict</h2>

        <div class="grid">
          <div>
            <label for="carPayment">Monthly Car Payment</label>
            <input id="carPayment" type="number" placeholder="500" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="income">Monthly Take-Home Income</label>
            <input id="income" type="number" placeholder="6000" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="insurance">Monthly Car Insurance</label>
            <input id="insurance" type="number" placeholder="180" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="fuelMaintenance">Monthly Fuel + Maintenance</label>
            <input id="fuelMaintenance" type="number" placeholder="300" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="savings">Emergency Savings</label>
            <input id="savings" type="number" placeholder="12000" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="housing">Monthly Rent or Mortgage</label>
            <input id="housing" type="number" placeholder="1700" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="debt">Other Monthly Debt Payments</label>
            <input id="debt" type="number" placeholder="700" min="0" inputmode="decimal" />

            <div class="helper-link">
              <a href="/what-counts-as-debt">
                Not sure what counts as debt? Read the debt guide
              </a>
            </div>
          </div>
        </div>

        <button id="carButton" type="button">
          Calculate Financial Pressure
        </button>

        <div class="result" id="result">
          <div class="score" id="score"></div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="paymentShare"></div>
          <div class="metric" id="transportationShare"></div>
          <div class="metric" id="cashFlow"></div>
          <div class="metric" id="savingsCushion"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not personal financial, lending, tax, insurance, or vehicle-buying advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <h2>What a $500 Car Payment Really Means</h2>

        <p>
          A $500 monthly car payment is common, but the payment alone does not tell the full story. Insurance, fuel, maintenance, repairs, registration, parking, and existing debt all affect whether the vehicle is actually affordable.
        </p>

        <p>
          This calculator looks at the full transportation picture so a payment that seems manageable in isolation does not quietly strain the rest of your monthly budget.
        </p>
      </div>

      <WhenSpendingMakesSense
        title="When a $500 Car Payment Makes Sense"
        items={[
          "Your income comfortably supports the payment after housing, debt, insurance, savings, and other essentials.",
          "The vehicle is reliable enough to reduce repair risk or transportation stress.",
          "You are not using credit cards to cover normal monthly expenses.",
          "Insurance, fuel, maintenance, and registration are included in the full vehicle budget.",
          "You still have enough emergency savings after taking on the payment.",
        ]}
      />

      <div class="content-section">
        <h2>When a $500 Car Payment Deserves a Closer Look</h2>

        <p>
          A $500 payment becomes risky when it is only affordable before insurance, fuel, repairs, and other debts are included.
        </p>

        <p>
          The danger zone usually starts when the vehicle payment feels fine on paper but pushes savings, groceries, rent, credit cards, or emergency flexibility into a tighter place.
        </p>
      </div>

      <KeyCostCategories
        items={[
          {
            title: "Monthly payment",
            description:
              "The loan or lease payment is the visible cost, but it is only one part of the real vehicle expense.",
          },
          {
            title: "Insurance",
            description:
              "Insurance can change the affordability picture quickly, especially for newer vehicles, younger drivers, or full-coverage policies.",
          },
          {
            title: "Fuel, maintenance, and repairs",
            description:
              "Gas, tires, oil changes, repairs, registration, parking, and maintenance should be included before judging affordability.",
          },
          {
            title: "Debt and housing pressure",
            description:
              "A car payment is harder to handle when rent, mortgage, credit cards, student loans, or personal loans are already tight.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Get an insurance quote before committing to the vehicle.",
          "Compare the payment against total transportation cost, not just the loan amount.",
          "Consider a larger down payment only if it does not drain emergency savings.",
          "Avoid stretching the loan term just to make the monthly payment look comfortable.",
          "Compare a cheaper trim, used model, or lower-mileage alternative before signing.",
          "Leave room for maintenance, tires, registration, fuel, and unexpected repairs.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "The $500 payment only works before insurance and fuel are included.",
          "You would need a long loan term to make the payment feel affordable.",
          "The payment causes you to pause savings or rely on credit cards.",
          "Housing, debt, and transportation together consume most of your take-home income.",
          "You have little emergency savings and the vehicle would be expensive to repair.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "The calculator treats the car payment as a recurring monthly transportation expense.",
          "Monthly income means take-home pay after taxes and payroll deductions.",
          "Insurance, fuel, maintenance, and repair estimates are included to show total transportation pressure.",
          "Other monthly debt payments include credit cards, student loans, personal loans, medical debt payments, and other required debts.",
          "The calculator does not evaluate vehicle reliability, loan APR, trade-in value, taxes, registration, depreciation, or resale value.",
          "The result is educational guidance, not financial advice.",
        ]}
      />

      <FAQSection
        title="$500 Car Payment FAQ"
        faqs={[
          {
            question: "Is a $500 car payment too much?",
            answer:
              "It depends on your income, insurance cost, debt, housing, savings, and total transportation spending. A $500 payment may be reasonable for some households and stressful for others.",
          },
          {
            question: "Should insurance be included when judging a car payment?",
            answer:
              "Yes. Insurance can make a manageable car payment much more expensive, especially with newer vehicles, full coverage, or higher-risk drivers.",
          },
          {
            question: "What percentage of income should a car payment be?",
            answer:
              "A lower payment share is safer, but the full transportation cost matters more than the payment alone. Insurance, fuel, repairs, debt, and housing should be included.",
          },
          {
            question: "Is a $500 car payment normal now?",
            answer:
              "A $500 car payment is common in today’s vehicle market, but normal does not always mean comfortable. The right test is whether it fits your full monthly budget.",
          },
          {
            question: "What should I check before accepting a $500 car payment?",
            answer:
              "Check insurance, loan term, APR, emergency savings, other debt, fuel costs, maintenance, and whether the payment would reduce your monthly flexibility.",
          },
        ]}
      />

      <MethodologySection category="car payment affordability" updated="May 2026" />

      <RelatedGuides
        guides={[
          {
            title: "Car Calculators",
            href: "/car-calculators",
            description:
              "Browse car payment, vehicle affordability, insurance, and transportation-cost calculators.",
          },
          {
            title: "What Counts as Debt?",
            href: "/what-counts-as-debt",
            description:
              "Understand which monthly obligations should be included when estimating financial pressure.",
          },
        ]}
      />

      <RelatedCalculators
        calculators={[
          {
            category: "Cars",
            title: "How Much Car Can I Afford?",
            href: "/how-much-car-can-i-afford",
          },
          {
            category: "Cars",
            title: "Should I Spend $700 on a Car Payment?",
            href: "/should-i-spend-700-on-a-car-payment",
          },
          {
            category: "Cars",
            title: "Should I Spend $1,000 on a Car Payment?",
            href: "/should-i-spend-1000-on-a-car-payment",
          },
          {
            category: "Debt",
            title: "How Much Debt Is Too Much?",
            href: "/how-much-debt-is-too-much",
          },
        ]}
      />
    </CalculatorPageShell>
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          color: "#16a34a",
          action: "Keep the total vehicle cost visible, protect savings, and avoid stretching the loan term unnecessarily.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          color: "#ca8a04",
          action: "Check insurance, fuel, maintenance, loan term, and whether the payment crowds out savings.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        color: "#dc2626",
        action: "Slow down before signing and consider a cheaper vehicle, larger down payment, or delaying the purchase.",
      };
    }

    function calculateCarPayment() {
      const carPayment = getNumber("carPayment");
      const income = getNumber("income");
      const insurance = getNumber("insurance");
      const fuelMaintenance = getNumber("fuelMaintenance");
      const savings = getNumber("savings");
      const housing = getNumber("housing");
      const debt = getNumber("debt");

      const result = document.getElementById("result");
      const scoreEl = document.getElementById("score");
      const barFill = document.getElementById("barFill");
      const paymentShareEl = document.getElementById("paymentShare");
      const transportationShareEl = document.getElementById("transportationShare");
      const cashFlowEl = document.getElementById("cashFlow");
      const savingsCushionEl = document.getElementById("savingsCushion");
      const guidanceEl = document.getElementById("guidance");

      result.style.display = "block";

      if (carPayment <= 0 || income <= 0) {
        scoreEl.textContent = "Add your numbers first";
        barFill.style.width = "0%";
        barFill.style.background = "#16a34a";
        paymentShareEl.innerHTML = "";
        transportationShareEl.innerHTML = "";
        cashFlowEl.innerHTML = "";
        savingsCushionEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter a positive monthly car payment and monthly take-home income so the calculator can estimate financial pressure.";
        return;
      }

      const totalVehicleCost = carPayment + insurance + fuelMaintenance;
      const paymentIncomeShare = (carPayment / income) * 100;
      const transportationIncomeShare = (totalVehicleCost / income) * 100;
      const fixedObligationRatio = ((housing + debt + carPayment) / income) * 100;
      const monthlyRemaining = income - housing - debt - totalVehicleCost;
      const monthlyCoreOutflow = housing + debt + totalVehicleCost;
      const emergencyMonths =
        monthlyCoreOutflow > 0 ? savings / monthlyCoreOutflow : savings > 0 ? 12 : 0;

      let pressureScore = 0;

      pressureScore += clamp(paymentIncomeShare * 2.2, 0, 34);
      pressureScore += clamp(transportationIncomeShare * 1.45, 0, 34);
      pressureScore += clamp(fixedObligationRatio * 0.24, 0, 26);

      if (monthlyRemaining < 0) pressureScore += 28;
      else if (monthlyRemaining < income * 0.08) pressureScore += 16;
      else if (monthlyRemaining < income * 0.15) pressureScore += 8;
      else if (monthlyRemaining > income * 0.3) pressureScore -= 7;

      if (emergencyMonths < 1 && income < 12000) pressureScore += 20;
      else if (emergencyMonths < 3 && income < 15000) pressureScore += 10;
      else if (emergencyMonths >= 6) pressureScore -= 8;

      if (transportationIncomeShare >= 25) pressureScore += 16;
      else if (transportationIncomeShare >= 18) pressureScore += 9;

      if (paymentIncomeShare >= 15) pressureScore += 12;
      else if (paymentIncomeShare >= 10) pressureScore += 6;

      if (income >= 10000 && monthlyRemaining > income * 0.25 && emergencyMonths >= 3) {
        pressureScore -= 8;
      }

      if (income >= 18000 && monthlyRemaining > income * 0.3 && emergencyMonths >= 3) {
        pressureScore -= 12;
      }

      if (
        paymentIncomeShare < 8 &&
        transportationIncomeShare < 14 &&
        emergencyMonths >= 6 &&
        fixedObligationRatio < 55 &&
        monthlyRemaining > income * 0.25
      ) {
        pressureScore = Math.min(pressureScore, 28);
      }

      if (
        paymentIncomeShare < 6 &&
        transportationIncomeShare < 10 &&
        emergencyMonths >= 9 &&
        fixedObligationRatio < 45 &&
        monthlyRemaining > income * 0.35
      ) {
        pressureScore = Math.min(pressureScore, 14);
      }

      pressureScore = Math.round(clamp(pressureScore, 0, 100));

      const level = getPressureLevel(pressureScore);

      let guidance = "";

      if (pressureScore <= 30) {
        guidance =
          `This $500 car payment appears financially manageable based on the numbers provided. The payment equals about ${paymentIncomeShare.toFixed(1)}% of take-home income, while total vehicle costs equal about ${transportationIncomeShare.toFixed(1)}%.`;
      } else if (pressureScore <= 60) {
        guidance =
          `This $500 car payment may work, but it creates noticeable pressure. The payment equals about ${paymentIncomeShare.toFixed(1)}% of take-home income, and total transportation costs equal about ${transportationIncomeShare.toFixed(1)}%.`;
      } else {
        guidance =
          `This $500 car payment could create real strain. The payment equals about ${paymentIncomeShare.toFixed(1)}% of take-home income, and the combination of insurance, fuel, housing, debt, or savings suggests you should review the full vehicle cost before committing.`;
      }

      scoreEl.textContent = `${level.label} — ${pressureScore}/100`;
      scoreEl.style.color = level.color;
      barFill.style.width = `${pressureScore}%`;
      barFill.style.background = level.color;

      paymentShareEl.innerHTML = `<strong>Car payment share:</strong> ${paymentIncomeShare.toFixed(1)}% of take-home income`;
      transportationShareEl.innerHTML = `<strong>Total vehicle cost share:</strong> ${transportationIncomeShare.toFixed(1)}% of take-home income`;
      cashFlowEl.innerHTML = `<strong>Monthly cash flow after housing, debt, and vehicle costs:</strong> $${Math.round(monthlyRemaining).toLocaleString()}`;
      savingsCushionEl.innerHTML = `<strong>Estimated emergency cushion:</strong> ${Math.max(emergencyMonths, 0).toFixed(1)} months`;
      guidanceEl.textContent = `${guidance} Recommended next step: ${level.action}`;
    }

    document
      .getElementById("carButton")
      .addEventListener("click", calculateCarPayment);
  </script>
</Layout>