---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import { calculators } from "../data/calculators.js";

const obituaryFaqs = [
  {
    question: "What does an obituary cost calculator include?",
    answer:
      "This calculator estimates obituary and announcement costs, including newspaper base fees, word count, per-word or per-line pricing, photo fees, number of newspapers, number of print days, online memorial pages, printed programs, death certificate copies, and confirmed free alternatives or credits.",
  },
  {
    question: "Why can newspaper obituary pricing be hard to estimate?",
    answer:
      "Many obituary prices depend on word count, line count, photo use, number of print days, and how many papers publish the notice. A short obituary with no photo can cost much less than a longer tribute printed for multiple days in multiple papers.",
  },
  {
    question: "Should I publish an obituary in more than one newspaper?",
    answer:
      "That depends on where family, friends, former coworkers, and community members are likely to see it. More papers can be meaningful, but they multiply the base fee, photo fee, and print-day cost. Confirm pricing before submitting the final text.",
  },
  {
    question: "Are online memorial pages free?",
    answer:
      "Some online memorial pages are free, some are included by a funeral home, and some charge a setup or upgrade fee. Treat a free online memorial as a confirmed credit only when the provider clearly says it is included at no extra cost.",
  },
  {
    question: "Is this legal, estate, insurance, medical, or funeral-director advice?",
    answer:
      "No. This is a planning estimate only. It is not legal, estate, tax, insurance, medical, or funeral-director advice. Confirm obituary, newspaper, online memorial, printing, death certificate, and family-contribution details in writing with the newspaper, funeral home, county office, online memorial provider, printer, or family contributor.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "Funeral Costs" &&
      calculator.href !== "/obituary-cost-calculator"
  )
  .slice(0, 6);
---

<Layout
  title="Obituary Cost Calculator"
  description="Estimate obituary costs based on newspaper fees, word count, photo fees, print days, online memorials, and credits."
>


  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .result-label {
      font-size: 1.15rem;
      font-weight: 800;
      color: #0f766e;
      margin-bottom: 24px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .total-price {
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 900;
      color: #0f172a;
      line-height: 1.05;
      margin-bottom: 12px;
    }

    .range-line {
      color: #334155;
      font-size: 1.1rem;
      line-height: 1.8;
      margin-bottom: 24px;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 24px 0;
    }

    .summary-card {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      padding: 18px;
    }

    .summary-card span {
      display: block;
      color: #64748b;
      font-size: 0.88rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 8px;
      line-height: 1.35;
    }

    .summary-card strong {
      display: block;
      color: #0f172a;
      font-size: 1.35rem;
      line-height: 1.2;
    }

    .breakdown-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin-top: 24px;
    }

    .warning-box,
    .result-note,
    .disclaimer {
      margin-top: 24px;
      padding: 20px;
      border-radius: 18px;
      line-height: 1.8;
    }

    .warning-box {
      background: #fff7ed;
      border: 1px solid #fed7aa;
      color: #7c2d12;
    }

    .warning-box h3,
    .result-note h3 {
      margin-top: 0;
      color: #0f172a;
    }

    .warning-box ul {
      margin-bottom: 0;
      padding-left: 22px;
    }

    .result-note {
      background: white;
      border: 1px solid #dbe4ee;
      color: #334155;
    }

    .disclaimer {
      background: #f1f5f9;
      border: 1px solid #dbe4ee;
      color: #475569;
      font-size: 0.94rem;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section h3 {
      color: #0f172a;
      margin-top: 28px;
      margin-bottom: 10px;
    }

    .content-section p,
    .content-section li {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
    }

    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .content-link:hover {
      text-decoration: underline;
    }

    :global(.breakdown-card) {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      padding: 18px;
      box-sizing: border-box;
    }

    :global(.breakdown-card span) {
      display: block;
      color: #64748b;
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 8px;
      line-height: 1.35;
    }

    :global(.breakdown-card strong) {
      display: block;
      color: #0f172a;
      font-size: 1.25rem;
      line-height: 1.2;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid,
      .summary-grid,
      .breakdown-grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Funeral Cost Calculator"
      title="Obituary Cost Calculator"
      description="Estimate obituary and announcement costs by separating base newspaper fees, word count, photo fees, print days, number of papers, online memorials, programs, death certificate copies, and confirmed credits."
    >
      <div class="calculator">
        <h2>Estimate Obituary and Announcement Costs</h2>

        <p class="calculator-intro">
          Use this calculator to estimate the obituary or death notice portion
          of a funeral plan. It highlights the cost drivers that are easy to
          miss: word count, photo fees, print days, number of newspapers, online
          memorial pages, printed programs, death certificate copies, and only
          confirmed free alternatives or credits.
        </p>

        <div class="grid">
          <div class="field">
            <label for="newspaperBaseFee">Newspaper Base Fee</label>
            <input id="newspaperBaseFee" type="number" placeholder="Example: 75" />
          </div>

          <div class="field">
            <label for="numberOfPapers">Number of Newspapers</label>
            <input id="numberOfPapers" type="number" placeholder="Example: 2" />
          </div>

          <div class="field">
            <label for="printDays">Number of Print Days</label>
            <input id="printDays" type="number" placeholder="Example: 2" />
          </div>

          <div class="field">
            <label for="wordCount">Obituary Word Count</label>
            <input id="wordCount" type="number" placeholder="Example: 325" />
          </div>

          <div class="field">
            <label for="perWordFee">Per-Word Fee</label>
            <input id="perWordFee" type="number" step="0.01" placeholder="Example: 0.85" />
          </div>

          <div class="field">
            <label for="lineCount">Line Count if Priced by Line</label>
            <input id="lineCount" type="number" placeholder="Example: 45" />
          </div>

          <div class="field">
            <label for="perLineFee">Per-Line Fee</label>
            <input id="perLineFee" type="number" step="0.01" placeholder="Example: 5.50" />
          </div>

          <div class="field">
            <label for="photoFee">Photo Fee</label>
            <input id="photoFee" type="number" placeholder="Example: 75" />
          </div>

          <div class="field">
            <label for="onlineMemorial">Online Memorial Page</label>
            <input id="onlineMemorial" type="number" placeholder="Example: 125" />
          </div>

          <div class="field">
            <label for="programPrinting">Programs or Printed Copies</label>
            <input id="programPrinting" type="number" placeholder="Example: 150" />
          </div>

          <div class="field">
            <label for="deathCertificateCopies">Death Certificate Copies</label>
            <input id="deathCertificateCopies" type="number" placeholder="Example: 8" />
          </div>

          <div class="field">
            <label for="deathCertificateCost">Cost per Death Certificate Copy</label>
            <input id="deathCertificateCost" type="number" placeholder="Example: 15" />
          </div>

          <div class="field">
            <label for="freeAlternatives">Confirmed Free Alternatives / Credits</label>
            <input id="freeAlternatives" type="number" placeholder="Example: 100" />
          </div>

          <div class="field">
            <label for="confirmedHelp">Confirmed Family Help or Credits</label>
            <input id="confirmedHelp" type="number" placeholder="Example: 50" />
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="obituaryButton" type="button">
          Calculate Obituary Cost
        </button>

        <div class="results" id="results">
          <div class="result-label">Estimated Obituary / Announcement Cost</div>

          <div class="total-price" id="totalPrice"></div>

          <div class="range-line" id="rangeLine"></div>

          <div class="summary-grid">
            <div class="summary-card">
              <span>Out-of-pocket after confirmed help</span>
              <strong id="outOfPocket"></strong>
            </div>

            <div class="summary-card">
              <span>Print multiplier</span>
              <strong id="printMultiplier"></strong>
            </div>

            <div class="summary-card">
              <span>Photo + print-day driver</span>
              <strong id="photoPrintDriver"></strong>
            </div>
          </div>

          <div class="breakdown-grid" id="breakdownGrid"></div>

          <div class="warning-box">
            <h3>Obituary-Specific Warnings</h3>
            <ul id="warningList"></ul>
          </div>

          <div class="result-note">
            <h3>Obituary Cost Result Note</h3>
            <p id="resultNote"></p>
          </div>

          <div class="disclaimer">
            This is a planning estimate only. It is not legal, estate, tax,
            insurance, medical, or funeral-director advice. Confirm obituary,
            death notice, newspaper, photo, online memorial, printing, death
            certificate, credit, and payment details in writing with the
            newspaper, funeral home, online memorial provider, printer, county
            office, estate representative, or family contributor before relying
            on the estimate.
          </div>
        </div>
      </div>

<OmniStyleReviewBlock
      pageName="the obituary cost calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="obituary cost, newspaper fees, word count, photo fees, online memorials, print days, savings, family help, funeral budget, and whether obituary spending creates pressure"
    />

    <CorePageExamplesBlock
      title="Obituary cost examples"
      intro="Obituary costs can vary widely by newspaper, word count, photo, and number of print days. The cost should fit the overall funeral plan."
      useCases={[
          "You are estimating obituary and memorial notice costs.",
          "You need to include word count, photos, print days, online memorials, and multiple papers.",
          "You want to compare obituary spending with the funeral budget and family help."
        ]}
      notEnough={[
          "You need grief writing help, newspaper placement, or legal advice.",
          "You need urgent funeral-home or provider-specific pricing.",
          "You are handling family disagreement over wording or publication."
        ]}
      examples={[
          {
            label: "Short newspaper notice",
            takeaway: "Pressure can be lower when the family keeps the notice focused."
          },
          {
            label: "Long obituary with photo",
            takeaway: "Costs rise with word count, photo fees, and multiple publication days."
          },
          {
            label: "Online memorial",
            takeaway: "A lower-cost online option may supplement or replace a longer print notice."
          }
        ]}
      commonMistake="Writing the obituary before checking per-word, photo, and print-day pricing."
      nextStep="Ask for the newspaper pricing rules before choosing length and photo options."
    />



      <section class="content-section">
        <h2>Why Obituary Costs Need Their Own Estimate</h2>

        <p>
          Obituary pricing can look small until the family sees how the final
          cost is calculated. A newspaper may charge a base fee, then add cost
          for word count, line count, photos, multiple print days, and multiple
          papers. The same tribute can cost very different amounts depending on
          how long it is and where it runs.
        </p>

        <p>
          This calculator is intentionally narrower than a full funeral price
          calculator. It focuses on the announcement itself: the base newspaper
          charge, word or line pricing, photo fee, print-day multiplier, number
          of newspapers, online memorial cost, program printing, death
          certificate copies, and confirmed credits.
        </p>

        <p>
          For the broader plan, compare this result with the <a class="content-link" href="/funeral-price-calculator/">funeral price calculator</a>, the <a class="content-link" href="/funeral-reception-cost-calculator/">funeral reception cost calculator</a>, or the <a class="content-link" href="/funeral-calculators/">funeral calculators hub</a>.
        </p>
      </section>

      <KeyCostCategories
        items={[
          {
            title: "Base newspaper fee",
            description:
              "Some newspapers charge a starting fee before word count, line count, photos, extra days, or extra publications are added.",
          },
          {
            title: "Word or line pricing",
            description:
              "The main obituary cost driver may be the number of words or lines. Families should confirm which method the newspaper uses before submitting the final text.",
          },
          {
            title: "Photos and print days",
            description:
              "A photo can add a separate fee, and each extra print day or additional newspaper can multiply the cost.",
          },
          {
            title: "Online memorial page",
            description:
              "An online memorial may be free, included, or paid. Confirm whether it replaces a print obituary or sits on top of the newspaper cost.",
          },
          {
            title: "Programs and printed copies",
            description:
              "Service programs, keepsake copies, signs, or printed announcements should be separated from newspaper obituary pricing.",
          },
          {
            title: "Confirmed free alternatives and credits",
            description:
              "Only subtract free online postings, funeral-home included notices, family help, or credits when the amount or service is confirmed.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Ask the newspaper whether pricing is based on words, lines, inches, days, photos, or a package.",
          "Draft the obituary before submitting so the family can see the word count and shorten it if needed.",
          "Compare one print day with multiple print days before approving the final run.",
          "Ask whether one newspaper plus an online memorial reaches the same people as multiple paid newspaper placements.",
          "Confirm whether the funeral home includes a free online obituary or memorial page.",
          "Use a shorter paid newspaper notice with a fuller online memorial if that meets the family's needs.",
          "Separate death certificate copies from obituary costs so required paperwork does not get confused with announcement spending.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "This calculator estimates obituary, announcement, online memorial, printing, and death-certificate-copy costs only, not the full funeral-home, cemetery, casket, reception, or travel bill.",
          "Word-based cost is calculated from word count multiplied by per-word fee.",
          "Line-based cost is calculated from line count multiplied by per-line fee.",
          "Newspaper base fees, word or line costs, and photo fees are multiplied by the number of newspapers and print days.",
          "Online memorials, program printing, and death certificate copies are added after the newspaper estimate.",
          "This page is educational and is not legal, estate, tax, insurance, medical, or funeral-director advice.",
        ]}
      />

      <section id="FinancialRedFlags" class="content-section">
        <h2>Obituary Cost Red Flags</h2>

        <p>
          Obituary costs become risky when the family approves a tribute before
          seeing the word count, photo fee, number of print days, and number of
          newspapers in writing.
        </p>

        <ul>
          <li>The newspaper cannot clearly explain whether the obituary is priced by word, line, inch, package, photo, or day.</li>
          <li>The family submits a long obituary before checking how word count affects the final cost.</li>
          <li>Multiple newspapers or print days are chosen before anyone confirms whether an online memorial would reach the same people.</li>
          <li>The photo fee is not known before the obituary is submitted.</li>
          <li>The family assumes a funeral-home online obituary is free before confirming whether it is included.</li>
          <li>Death certificate copies, programs, and printed materials are mixed into the obituary budget without being listed separately.</li>
        </ul>
      </section>

      <section class="content-section">
        <h2>What Makes This Different From a Funeral Price Calculator</h2>

        <p>
          A full funeral price calculator estimates the overall service and
          related costs. This obituary calculator answers a narrower question:
          what will the announcement itself cost once the family separates base
          fees, word count, line count, photo fees, print days, newspapers,
          online memorials, printed programs, death certificate copies, and
          confirmed credits?
        </p>

        <p>
          That distinction matters because obituary pricing is often unclear
          until the text, photo, publication schedule, and newspaper count are
          known. A shorter print notice with a fuller online memorial may be
          more manageable, but the right choice depends on who needs to be
          notified and what the family wants preserved.
        </p>
      </section>

      <div class="content-section">
        <FAQSection
          title="Obituary Cost Calculator FAQ"
          faqs={obituaryFaqs}
        />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="obituary and funeral announcement cost estimates" updated="July 2026" />
  </div>

  <script is:inline>
    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function formatMoney(value) {
      return value.toLocaleString(undefined, {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      });
    }

    function addBreakdownCard(container, label, value) {
      const card = document.createElement("div");
      card.className = "breakdown-card";
      card.innerHTML = `<span>${label}</span><strong>${formatMoney(value)}</strong>`;
      container.appendChild(card);
    }

    function addWarning(list, text) {
      const item = document.createElement("li");
      item.textContent = text;
      list.appendChild(item);
    }

    function calculateObituaryCost() {
      const newspaperBaseFee = getNumber("newspaperBaseFee");
      const numberOfPapers = Math.max(getNumber("numberOfPapers"), 1);
      const printDays = Math.max(getNumber("printDays"), 1);
      const wordCount = getNumber("wordCount");
      const perWordFee = getNumber("perWordFee");
      const lineCount = getNumber("lineCount");
      const perLineFee = getNumber("perLineFee");
      const photoFee = getNumber("photoFee");
      const onlineMemorial = getNumber("onlineMemorial");
      const programPrinting = getNumber("programPrinting");
      const deathCertificateCopies = getNumber("deathCertificateCopies");
      const deathCertificateCost = getNumber("deathCertificateCost");
      const freeAlternatives = getNumber("freeAlternatives");
      const confirmedHelp = getNumber("confirmedHelp");

      const wordCost = wordCount * perWordFee;
      const lineCost = lineCount * perLineFee;
      const textCost = Math.max(wordCost, lineCost);
      const basePerRun = newspaperBaseFee + textCost + photoFee;
      const printMultiplier = numberOfPapers * printDays;
      const newspaperTotal = basePerRun * printMultiplier;
      const certificateTotal = deathCertificateCopies * deathCertificateCost;
      const addedItems = onlineMemorial + programPrinting + certificateTotal;
      const grossTotal = newspaperTotal + addedItems;
      const totalCredits = freeAlternatives + confirmedHelp;
      const outOfPocket = Math.max(0, grossTotal - totalCredits);
      const lowRange = Math.max(0, grossTotal * 0.9);
      const highRange = grossTotal * 1.18;
      const photoPrintDriver = photoFee * printMultiplier;

      const results = document.getElementById("results");
      const totalPrice = document.getElementById("totalPrice");
      const rangeLine = document.getElementById("rangeLine");
      const outOfPocketEl = document.getElementById("outOfPocket");
      const printMultiplierEl = document.getElementById("printMultiplier");
      const photoPrintDriverEl = document.getElementById("photoPrintDriver");
      const breakdownGrid = document.getElementById("breakdownGrid");
      const warningList = document.getElementById("warningList");
      const resultNote = document.getElementById("resultNote");

      results.classList.add("visible");
      breakdownGrid.innerHTML = "";
      warningList.innerHTML = "";

      if (grossTotal <= 0) {
        totalPrice.textContent = "$0";
        rangeLine.textContent =
          "Enter newspaper base fees, word or line pricing, photo fees, print days, number of newspapers, online memorial costs, printing, death certificate copies, and confirmed credits to estimate obituary costs.";
        outOfPocketEl.textContent = "$0";
        printMultiplierEl.textContent = "1x";
        photoPrintDriverEl.textContent = "$0";
        resultNote.textContent =
          "This calculator is designed to isolate the obituary and announcement cost from the main funeral bill. Start by entering the newspaper pricing method, photo cost, number of papers, print days, and any confirmed free alternatives.";
        addWarning(
          warningList,
          "Do not submit the final obituary until the newspaper confirms whether pricing is based on words, lines, inches, packages, photos, days, or publications."
        );
        return;
      }

      totalPrice.textContent = formatMoney(grossTotal);
      rangeLine.textContent = `Planning range: ${formatMoney(lowRange)} to ${formatMoney(highRange)} before late text edits, photo changes, added print days, extra newspapers, or online memorial upgrades.`;
      outOfPocketEl.textContent = formatMoney(outOfPocket);
      printMultiplierEl.textContent = `${printMultiplier.toFixed(0)}x`;
      photoPrintDriverEl.textContent = formatMoney(photoPrintDriver);

      addBreakdownCard(breakdownGrid, "Newspaper base fees", newspaperBaseFee * printMultiplier);
      addBreakdownCard(breakdownGrid, "Word-based text cost", wordCost * printMultiplier);
      addBreakdownCard(breakdownGrid, "Line-based text cost", lineCost * printMultiplier);
      addBreakdownCard(breakdownGrid, "Photo fees", photoPrintDriver);
      addBreakdownCard(breakdownGrid, "Online memorial page", onlineMemorial);
      addBreakdownCard(breakdownGrid, "Programs or printed copies", programPrinting);
      addBreakdownCard(breakdownGrid, "Death certificate copies", certificateTotal);
      addBreakdownCard(breakdownGrid, "Confirmed free alternatives", freeAlternatives);
      addBreakdownCard(breakdownGrid, "Confirmed family help", confirmedHelp);

      if (wordCost > 0 && lineCost > 0) {
        addWarning(
          warningList,
          "Both word-based and line-based pricing were entered. This calculator uses the higher text-cost method for caution, but the newspaper should confirm the real pricing method."
        );
      }

      if (wordCount >= 500 && perWordFee > 0) {
        addWarning(
          warningList,
          "The obituary is long enough for word-count pricing to matter. Consider whether a shorter paid notice plus fuller online memorial would work."
        );
      }

      if (printMultiplier >= 4) {
        addWarning(
          warningList,
          "The obituary is being multiplied across several papers or print days. Confirm that each placement is necessary before approving the run."
        );
      }

      if (photoFee > 0 && photoPrintDriver >= 200) {
        addWarning(
          warningList,
          "Photo fees are becoming a meaningful cost driver because they are affected by the number of papers and print days entered."
        );
      }

      if (freeAlternatives === 0 && onlineMemorial === 0) {
        addWarning(
          warningList,
          "No free online alternative or included memorial page was entered. Ask whether the funeral home or newspaper includes one before paying for extra print space."
        );
      }

      if (deathCertificateCopies > 0 && deathCertificateCost === 0) {
        addWarning(
          warningList,
          "Death certificate copies were entered without a per-copy cost. Confirm county or state pricing before relying on this estimate."
        );
      }

      addWarning(
        warningList,
        "Print obituary pricing may stay unclear until the final word count, photo, number of days, and number of newspapers are confirmed in writing."
      );

      resultNote.textContent =
        `This is not a full funeral estimate. It isolates the obituary and announcement cost: ${formatMoney(newspaperTotal)} for newspaper placement using a ${printMultiplier.toFixed(0)}x print multiplier, ${formatMoney(addedItems)} for online memorial, printing, and death certificate copies, and ${formatMoney(outOfPocket)} still out of pocket after confirmed credits. The obituary-specific question is whether the chosen word count, photo, print days, and number of papers are worth the added cost compared with a shorter notice or fuller online memorial.`;
    }

    document
      .getElementById("obituaryButton")
      .addEventListener("click", calculateObituaryCost);
  </script>
</Layout>

