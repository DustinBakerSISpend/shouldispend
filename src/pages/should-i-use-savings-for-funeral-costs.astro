---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const funeralFaqs = [
  {
    question: "Should I use savings to pay for funeral costs?",
    answer:
      "Using savings can make sense if the funeral can be paid without draining emergency reserves, missing bills, or creating new debt. It becomes risky when the household loses its financial cushion afterward.",
  },
  {
    question: "Is it better to use savings or borrow for a funeral?",
    answer:
      "Savings are usually safer than high-interest debt if enough emergency cushion remains afterward. Borrowing may create longer-term pressure through interest charges, monthly payments, and missed-payment risk.",
  },
  {
    question: "How much savings should I keep after a funeral?",
    answer:
      "A safer target is enough savings to cover essential bills, housing, food, transportation, medical needs, and another emergency. The right amount depends on monthly expenses, income stability, dependents, debt, and whether other family members can help.",
  },
  {
    question: "What if family members expect me to use my savings?",
    answer:
      "It is reasonable to protect your household before paying for everything yourself. Ask for clear contributions, assign specific costs to relatives, compare lower-cost options, and do not let vague family pressure drain your emergency fund.",
  },
  {
    question: "Should I wait for life insurance before using savings?",
    answer:
      "If insurance is confirmed but delayed, using savings may be reasonable if the household remains safe and reimbursement is realistic. If timing, beneficiary access, or payout amount is unclear, treat the insurance as uncertain until confirmed.",
  },
];

const costCategories = [
  {
    title: "Confirmed out-of-pocket cost",
    body:
      "The key number is what remains after insurance, prepaid funds, estate cash, employer benefits, church help, or family contributions are applied.",
  },
  {
    title: "Emergency savings left afterward",
    body:
      "Savings use is safer when enough cash remains for housing, food, utilities, transportation, medical needs, repairs, and another emergency.",
  },
  {
    title: "Insurance or estate timing",
    body:
      "Expected reimbursement can help, but the household still needs to survive the period before life insurance, estate funds, or family contributions arrive.",
  },
  {
    title: "Debt avoided",
    body:
      "Using savings can be better than high-interest debt when it prevents credit card interest, loan fees, or a funeral payment plan the household cannot afford.",
  },
  {
    title: "Income recovery time",
    body:
      "A household with strong take-home income can rebuild savings faster than one already stretched by rent, debt, groceries, medical bills, or unstable work.",
  },
  {
    title: "Shared family responsibility",
    body:
      "Savings pressure is lower when relatives contribute real amounts to specific costs instead of leaving one person to pay and hope for reimbursement.",
  },
];

const reduceCostTips = [
  "Ask for itemized pricing before using savings.",
  "Compare the current funeral quote against a $5,000, $10,000, and $15,000 version.",
  "Separate required costs from optional upgrades before paying.",
  "Confirm whether life insurance, prepaid funeral funds, employer benefits, or estate cash are actually available.",
  "Ask relatives to pay specific costs directly, such as flowers, obituary, food, travel, music, or reception expenses.",
  "Consider direct cremation, cremation with memorial, simple burial, or memorial-only options.",
  "Delay optional headstone upgrades, keepsakes, large receptions, or celebration-of-life events until cash is rebuilt.",
  "Avoid using savings and still taking on credit card debt if reducing the funeral cost would solve both problems.",
];

const redFlags = [
  "Using savings would leave the household below its minimum emergency cushion.",
  "Rent, groceries, utilities, transportation, medical needs, or childcare would be at risk afterward.",
  "The person paying is relying on insurance or estate reimbursement that is not confirmed.",
  "Family members are applying pressure but have not committed real money.",
  "The funeral home quote is not itemized or includes unclear package costs.",
  "Savings would be drained and credit cards would still be needed.",
  "The surviving spouse, child, or dependent household would be weakened by the payment.",
  "The family has not compared lower-cost funeral, cremation, or memorial options.",
  "The payer already has high monthly debt obligations.",
  "The decision is being driven mainly by guilt, urgency, or fear of looking disrespectful.",
];

const assumptions = [
  "Monthly income means take-home pay available to the person or household paying the funeral bill.",
  "Savings means liquid cash that can be used without selling long-term assets, missing bills, or triggering penalties.",
  "Insurance or family help means confirmed or highly realistic money available for this funeral.",
  "The emergency target is the minimum savings cushion the household wants left after the funeral is paid.",
  "The calculator estimates savings pressure, not the emotional value of the service.",
  "Using savings can be responsible when it avoids high-interest debt and leaves the household stable.",
  "Using savings can be risky when it leaves the household exposed, even if it avoids borrowing today.",
  "A score of 0 is allowed when the funeral is fully covered or the uncovered cost is tiny compared with income and savings.",
];

const relatedCalculators = [
  {
    title: "Funeral Calculators",
    href: "/funeral-calculators",
    body: "Compare funeral, cremation, burial, insurance, savings, and payment-plan decisions.",
  },
  {
    title: "$5,000 Funeral Calculator",
    href: "/should-i-spend-5000-on-a-funeral",
    body: "See whether a smaller cremation or memorial budget protects savings better.",
  },
  {
    title: "$10,000 Funeral Calculator",
    href: "/should-i-spend-10000-on-a-funeral",
    body: "Test a common funeral budget against savings, income, help, and debt pressure.",
  },
  {
    title: "$15,000 Funeral Calculator",
    href: "/should-i-spend-15000-on-a-funeral",
    body: "Compare savings pressure from a higher-cost burial or full-service plan.",
  },
  {
    title: "$20,000 Funeral Calculator",
    href: "/should-i-spend-20000-on-a-funeral",
    body: "Pressure-test a high-cost funeral before using major savings or financing.",
  },
  {
    title: "Funeral Payment Plan Calculator",
    href: "/funeral-payment-plan-calculator",
    body: "Compare monthly payment pressure before choosing debt instead of savings.",
  },
  {
    title: "Emergency Savings Guide",
    href: "/how-much-emergency-savings-should-i-have",
    body: "Estimate how much cash should remain after a major family expense.",
  },
  {
    title: "Debt Pressure Calculator",
    href: "/how-much-debt-is-too-much",
    body: "Check whether avoiding funeral debt is worth using part of your savings.",
  },
];
---

<Layout
  title="Should I Use Savings for Funeral Costs?"
  description="Use this funeral savings calculator to decide whether paying funeral costs from savings is safer than borrowing or whether it drains emergency reserves too far."
>
  <style>
    .container { max-width: 1060px; margin: 0 auto; padding: 80px 24px; }
    .eyebrow { color:#0f766e; text-transform:uppercase; letter-spacing:2px; font-size:.8rem; font-weight:900; margin-bottom:18px; }
    h1 { font-size:clamp(2.65rem,7vw,4.8rem); line-height:.95; margin:0 0 24px; color:#0f172a; max-width:930px; }
    h2 { font-size:clamp(1.8rem,4vw,2.45rem); line-height:1.12; margin:0 0 18px; color:#0f172a; }
    h3 { color:#0f172a; line-height:1.25; margin:0 0 10px; }
    p, li { color:#334155; line-height:1.85; font-size:1.06rem; }
    a { color:#0f766e; font-weight:800; }
    .intro { max-width:860px; font-size:1.14rem; margin-bottom:32px; }
    .hero-grid, .info-grid, .link-grid, .mini-grid { display:grid; gap:20px; }
    .hero-grid { grid-template-columns:minmax(0,1.4fr) minmax(280px,.7fr); margin:34px 0 56px; }
    .info-grid, .link-grid, .mini-grid { grid-template-columns:repeat(auto-fit,minmax(245px,1fr)); margin-top:28px; }
    .summary-card, .calculator-box, .info-card, .link-card, .callout, .mini-card, .table-wrap {
      border:1px solid #dbe4ee; background:#fff; border-radius:24px; box-shadow:0 12px 28px rgba(15,23,42,.04);
    }
    .summary-card, .info-card, .mini-card, .link-card, .callout { padding:24px; }
    .summary-card { background:linear-gradient(180deg,#f8fafc 0%,#fff 100%); }
    .summary-card strong { display:block; color:#0f172a; font-size:1.1rem; margin-bottom:10px; }
    .summary-list { margin:0; padding-left:20px; }
    .summary-list li { margin-bottom:10px; font-size:.98rem; }
    .calculator-box { padding:30px; margin-bottom:64px; }
    .form-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:18px; margin-top:24px; }
    label { display:block; font-weight:900; color:#0f172a; margin-bottom:8px; font-size:.95rem; }
    .hint { display:block; color:#64748b; font-size:.83rem; line-height:1.45; margin-top:5px; }
    input { width:100%; border:1px solid #cbd5e1; border-radius:13px; padding:13px; font-size:1rem; box-sizing:border-box; color:#0f172a; background:#fff; }
    button { margin-top:24px; border:none; border-radius:999px; padding:15px 24px; background:#0f766e; color:#fff; font-weight:900; font-size:1rem; cursor:pointer; }
    button:hover { opacity:.92; }
    .result { margin-top:32px; background:#f8fafc; border:1px solid #dbe4ee; border-radius:24px; padding:30px; display:none; }
    .result.visible { display:block; }
    .score { font-size:clamp(2rem,4vw,2.75rem); font-weight:950; color:#0f172a; margin-bottom:20px; line-height:1.12; }
    .bar { height:16px; background:#dbe4ee; border-radius:999px; overflow:hidden; margin-bottom:24px; }
    .fill { height:100%; width:0%; border-radius:999px; transition:width .45s ease; }
    .fill.safe { background:linear-gradient(90deg,#0f766e 0%,#14b8a6 100%); }
    .fill.caution { background:linear-gradient(90deg,#ca8a04 0%,#facc15 100%); }
    .fill.danger { background:linear-gradient(90deg,#dc2626 0%,#f97316 100%); }
    .result-details { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:14px; margin-top:20px; }
    .result-metric { background:#fff; border:1px solid #e2e8f0; border-radius:18px; padding:16px; }
    .result-metric strong { display:block; color:#0f172a; margin-bottom:6px; }
    .result-metric span { color:#334155; line-height:1.55; font-size:.96rem; }
    .guidance { margin-top:22px; padding-top:20px; border-top:1px solid #dbe4ee; color:#0f172a; font-size:1.08rem; line-height:1.8; }
    .fine-print { color:#64748b; font-size:.9rem; margin-top:18px; line-height:1.6; }
    .content-section { margin-top:76px; }
    .content-section > p { max-width:900px; }
    .numbered-card { position:relative; padding-top:48px; }
    .numbered-card .number { position:absolute; top:20px; left:22px; width:28px; height:28px; border-radius:999px; background:#ccfbf1; color:#115e59; font-weight:950; display:grid; place-items:center; font-size:.86rem; }
    .callout { background:#f8fafc; margin-top:28px; }
    .callout p { margin:0; color:#0f172a; font-size:1.08rem; }
    .warning-box { border-left:5px solid #dc2626; }
    .decision-box { border-left:5px solid #0f766e; }
    .table-wrap { overflow-x:auto; margin-top:26px; padding:0; }
    table { width:100%; border-collapse:collapse; min-width:720px; }
    th, td { text-align:left; padding:16px; border-bottom:1px solid #e2e8f0; vertical-align:top; color:#334155; line-height:1.55; }
    th { color:#0f172a; background:#f8fafc; font-size:.92rem; text-transform:uppercase; letter-spacing:.04em; }
    tr:last-child td { border-bottom:none; }
    .link-card { display:block; text-decoration:none; color:inherit; transition:transform .15s ease, box-shadow .15s ease; }
    .link-card:hover { transform:translateY(-2px); box-shadow:0 16px 34px rgba(15,23,42,.08); }
    .link-card strong { display:block; color:#0f172a; margin-bottom:8px; line-height:1.3; font-size:1.03rem; }
    .link-card span, .info-card p, .mini-card p { display:block; margin:0; color:#334155; line-height:1.7; font-size:.96rem; }
    .check-list, .red-list { list-style:none; padding-left:0; }
    .check-list li, .red-list li { position:relative; padding-left:30px; margin-bottom:10px; }
    .check-list li::before { content:"✓"; position:absolute; left:0; top:0; color:#0f766e; font-weight:950; }
    .red-list li::before { content:"!"; position:absolute; left:0; top:2px; width:18px; height:18px; border-radius:999px; display:grid; place-items:center; background:#fee2e2; color:#b91c1c; font-weight:950; font-size:.8rem; }
    @media (max-width:760px) {
      .container { padding:54px 18px; }
      .hero-grid { grid-template-columns:1fr; }
      .calculator-box { padding:22px; }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Funeral Savings Calculator</div>

    <h1>Should I Use Savings for Funeral Costs?</h1>

    <p class="intro">
      Paying funeral expenses from savings can be safer than borrowing, but only
      if the household still has enough money left afterward. This calculator
      estimates whether using savings for funeral costs protects your family or
      creates pressure by draining emergency reserves, monthly flexibility, or
      basic financial security.
    </p>

    <div class="hero-grid">
      <div class="summary-card">
        <strong>Fast answer</strong>
        <p>
          Use savings when it avoids high-interest debt and still leaves a real
          emergency cushion. Do not use savings blindly if the payment would
          leave the household exposed after the funeral.
        </p>
      </div>

      <div class="summary-card">
        <strong>This page helps you check:</strong>
        <ul class="summary-list">
          <li>how much savings would remain after the funeral</li>
          <li>whether borrowing is actually worse</li>
          <li>whether family help is real or vague</li>
          <li>whether the funeral cost should be reduced first</li>
        </ul>
      </div>
    </div>

    <section class="calculator-box">
      <h2>Funeral Savings Pressure Calculator</h2>

      <p>
        Enter the funeral cost, liquid savings, insurance or family help, monthly
        take-home income, debt payments, and the savings cushion you want left
        afterward. The calculator estimates whether using savings looks
        manageable, stressful, or financially dangerous.
      </p>

      <div class="form-grid">
        <div>
          <label for="cost">Estimated funeral cost</label>
          <input id="cost" type="number" placeholder="Example: 10000" min="0" inputmode="decimal" />
          <span class="hint">Use the full expected bill, including funeral, burial or cremation, memorial, and extras.</span>
        </div>

        <div>
          <label for="savings">Current liquid savings</label>
          <input id="savings" type="number" placeholder="Example: 20000" min="0" inputmode="decimal" />
          <span class="hint">Cash available without missing bills or selling long-term assets.</span>
        </div>

        <div>
          <label for="help">Insurance or family help</label>
          <input id="help" type="number" placeholder="Example: 3000" min="0" inputmode="decimal" />
          <span class="hint">Confirmed insurance, prepaid funds, employer benefits, estate cash, or family contributions.</span>
        </div>

        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 6500" min="0" inputmode="decimal" />
          <span class="hint">After-tax income for the person or household paying.</span>
        </div>

        <div>
          <label for="debt">Monthly debt payments</label>
          <input id="debt" type="number" placeholder="Example: 900" min="0" inputmode="decimal" />
          <span class="hint">Credit cards, loans, car payments, student loans, medical plans, and other debt.</span>
        </div>

        <div>
          <label for="emergencyTarget">Minimum savings you want left afterward</label>
          <input id="emergencyTarget" type="number" placeholder="Example: 12000" min="0" inputmode="decimal" />
          <span class="hint">The cash floor you do not want the funeral to break.</span>
        </div>
      </div>

      <button id="calculateButton" type="button">Check Savings Pressure</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>
        <div class="bar"><div class="fill" id="scoreFill"></div></div>
        <div class="result-details" id="resultDetails"></div>
        <div class="guidance" id="guidance"></div>
        <div class="fine-print">This calculator is educational only and is not financial, legal, tax, estate, insurance, or funeral-planning advice.</div>
      </div>
    </section>

    <section class="content-section">
      <h2>The real question is not “can I pay?” It is “what happens after I pay?”</h2>

      <p>
        Savings can make a funeral decision cleaner. It may avoid interest,
        applications, financing pressure, and the emotional weight of carrying
        funeral debt. But savings are also the family’s protection against the
        next emergency.
      </p>

      <p>
        The right answer depends on what remains after the payment. If the
        funeral uses savings but leaves rent, groceries, utilities,
        transportation, medical needs, and emergency reserves protected, savings
        may be the safest option. If it empties the account, the better move may
        be reducing the funeral cost instead of borrowing or spending every
        dollar.
      </p>

      <div class="callout decision-box">
        <p>
          Savings are useful because they create stability. Do not let a funeral
          decision destroy the stability the savings were meant to protect.
        </p>
      </div>
    </section>

    <section class="content-section" id="MethodologySection">
      <h2>How this funeral savings calculator works</h2>

      <p>
        The calculator estimates a pressure score from 0 to 100. It focuses on
        savings damage rather than only funeral price. A funeral paid from cash
        can be low pressure if the household remains safe afterward. It can be
        high pressure if the cash payment leaves the household exposed.
      </p>

      <div class="mini-grid">
        <div class="mini-card numbered-card">
          <div class="number">1</div>
          <h3>Out-of-pocket savings use</h3>
          <p>The calculator subtracts confirmed help from the funeral cost to estimate how much savings may be needed.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">2</div>
          <h3>Savings left afterward</h3>
          <p>The score rises when the funeral drains cash below your emergency target or below basic stability.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">3</div>
          <h3>Income recovery time</h3>
          <p>Monthly take-home income matters because it affects how quickly the household can rebuild savings.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">4</div>
          <h3>Debt pressure</h3>
          <p>Existing debt raises risk because the household may need a larger cushion after using savings.</p>
        </div>
      </div>

      <p>
        There is no artificial minimum pressure. If the funeral is fully covered,
        the score can be 0. If the uncovered cost is tiny compared with income
        and savings, the score can also be 0.
      </p>
    </section>

    <section class="content-section">
      <h2>When using savings for funeral costs makes sense</h2>

      <ul class="check-list">
        <li>The funeral can be paid without high-interest debt.</li>
        <li>Emergency savings remain above the household’s minimum safe level.</li>
        <li>Insurance, prepaid funds, or family help reduce the out-of-pocket cost.</li>
        <li>The funeral home quote is itemized and understandable.</li>
        <li>The surviving household can still cover essentials afterward.</li>
        <li>The household has enough income stability to rebuild savings over time.</li>
        <li>The plan avoids financing optional upgrades.</li>
      </ul>
    </section>

    <section class="content-section" id="KeyCostCategories">
      <h2>Key factors before using savings for a funeral</h2>

      <p>
        The safest decision is not always “never touch savings” or “avoid all
        debt.” The safest decision is the one that leaves the household most
        stable after the funeral is paid.
      </p>

      <div class="info-grid">
        {costCategories.map((category) => (
          <div class="info-card">
            <h3>{category.title}</h3>
            <p>{category.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>Savings vs. debt for funeral expenses</h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Payment choice</th>
              <th>When it can make sense</th>
              <th>When it becomes risky</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Use savings</td>
              <td>Enough emergency cash remains and the payment avoids interest.</td>
              <td>The household is left with no cushion for basic needs or another emergency.</td>
            </tr>
            <tr>
              <td>Use life insurance</td>
              <td>The payout is confirmed, accessible, and available near the payment deadline.</td>
              <td>The family assumes reimbursement before beneficiary access or timing is clear.</td>
            </tr>
            <tr>
              <td>Family contributions</td>
              <td>Relatives commit specific amounts or pay specific expenses directly.</td>
              <td>One person pays upfront based on vague promises to help later.</td>
            </tr>
            <tr>
              <td>Payment plan or loan</td>
              <td>The payment is affordable, low-cost, and safer than draining all cash.</td>
              <td>Interest, fees, or monthly payments create long-term pressure.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section" id="ReduceCostTips">
      <h2>Ways to protect savings before paying funeral costs</h2>

      <p>
        Before spending a large share of savings, look for ways to reduce the
        out-of-pocket cost and preserve cash for the surviving household.
      </p>

      <ul class="check-list">
        {reduceCostTips.map((tip) => <li>{tip}</li>)}
      </ul>
    </section>

    <section class="content-section" id="FinancialRedFlags">
      <h2>Financial red flags before using savings for a funeral</h2>

      <p>
        The danger is not simply using savings. The danger is using savings in a
        way that leaves the family financially exposed after the funeral.
      </p>

      <ul class="red-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>

      <div class="callout warning-box">
        <p>
          Be careful if using savings still leaves a gap that must go on a credit
          card. In that case, the safer move may be reducing the funeral cost.
        </p>
      </div>
    </section>

    <section class="content-section">
      <h2>What to do if family expects you to spend your savings</h2>

      <p>
        Funeral decisions can become unfair when one person has savings and
        everyone else has opinions. If you are the person expected to pay, it is
        reasonable to protect your household first.
      </p>

      <p>
        Ask relatives to commit to specific amounts, pay specific vendors
        directly, or take responsibility for flexible costs such as food,
        flowers, obituary, travel, music, or reception expenses. If the family
        wants a more expensive service, the funding should be just as clear as
        the preference.
      </p>
    </section>

    <section class="content-section" id="CalculatorAssumptions">
      <h2>Calculator assumptions</h2>

      <ul>
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="content-section">
      <h2>Decision guide: what to do with your result</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Low pressure</h3>
          <p>Using savings appears manageable. Confirm pricing, payment timing, and what cash remains afterward.</p>
        </div>

        <div class="info-card">
          <h3>Moderate pressure</h3>
          <p>Reduce optional costs, confirm family help, and compare whether partial savings plus a smaller plan is safer.</p>
        </div>

        <div class="info-card">
          <h3>High pressure</h3>
          <p>Do not drain the account without reducing the funeral cost, securing help, or protecting essential reserves.</p>
        </div>
      </div>
    </section>

    <section class="content-section" id="RelatedCalculators">
      <h2>Related funeral and financial calculators</h2>

      <div class="link-grid">
        {relatedCalculators.map((calculator) => (
          <a class="link-card" href={calculator.href}>
            <strong>{calculator.title}</strong>
            <span>{calculator.body}</span>
          </a>
        ))}
      </div>
    </section>

    <FAQSection title="Using Savings for Funeral Costs FAQ" faqs={funeralFaqs} />
  </main>

  <script>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const formatCurrency = (value) => {
      const safeValue = Number.isFinite(value) ? value : 0;
      return safeValue.toLocaleString(undefined, {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
    };

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action: "Use savings only after confirming the funeral is itemized and the emergency cushion remains protected.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action: "Reduce costs, confirm family help, and protect emergency savings before paying.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action: "Avoid draining savings; reduce the funeral cost, seek help, or avoid high-interest debt.",
      };
    }

    const button = document.getElementById("calculateButton");
    const result = document.getElementById("result");
    const scoreText = document.getElementById("scoreText");
    const scoreFill = document.getElementById("scoreFill");
    const resultDetails = document.getElementById("resultDetails");
    const guidance = document.getElementById("guidance");

    button?.addEventListener("click", () => {
      const cost = getNumber("cost");
      const savings = getNumber("savings");
      const help = getNumber("help");
      const income = getNumber("income");
      const debt = getNumber("debt");
      const emergencyTarget = getNumber("emergencyTarget");

      result?.classList.add("visible");

      if (cost <= 0) {
        scoreText.textContent = "Add a funeral cost first";
        scoreFill.style.width = "0%";
        scoreFill.className = "fill safe";
        resultDetails.innerHTML = `
          <div class="result-metric">
            <strong>Missing cost</strong>
            <span>Enter a funeral cost so the calculator can estimate savings pressure.</span>
          </div>
        `;
        guidance.textContent = "";
        return;
      }

      const outOfPocket = Math.max(cost - help, 0);
      const savingsAfter = savings - outOfPocket;
      const savingsImpact = savings > 0 ? (outOfPocket / savings) * 100 : outOfPocket > 0 ? 150 : 0;
      const monthlyIncomeImpact = income > 0 ? (outOfPocket / income) * 100 : outOfPocket > 0 ? 300 : 0;
      const debtPaymentRatio = income > 0 ? (debt / income) * 100 : debt > 0 ? 100 : 0;
      const emergencyTargetRemaining =
        emergencyTarget > 0 ? (savingsAfter / emergencyTarget) * 100 : null;

      const fullyCovered = outOfPocket <= 0;
      const tinyUncoveredCost =
        outOfPocket > 0 &&
        outOfPocket <= Math.max(100, income * 0.02) &&
        savingsAfter >= 0 &&
        debtPaymentRatio <= 10;

      const hugeSavings =
        outOfPocket > 0 &&
        savingsAfter >= Math.max(emergencyTarget, income * 6, outOfPocket * 20);

      const hugeIncome =
        outOfPocket > 0 &&
        income > 0 &&
        monthlyIncomeImpact <= 2 &&
        debtPaymentRatio <= 5 &&
        savingsAfter >= 0;

      let pressureScore = 0;

      if (fullyCovered || tinyUncoveredCost || hugeSavings || hugeIncome) {
        pressureScore = 0;
      } else {
        pressureScore += clamp(savingsImpact * 0.5, 0, 42);
        pressureScore += clamp(monthlyIncomeImpact * 0.28, 0, 24);
        pressureScore += clamp(debtPaymentRatio * 0.28, 0, 18);

        if (outOfPocket > savings) pressureScore += 30;

        if (savingsAfter < 0) {
          pressureScore += 28;
        } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget * 0.5) {
          pressureScore += 18;
        } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget) {
          pressureScore += 10;
        } else if (emergencyTarget > 0 && savingsAfter >= emergencyTarget * 3) {
          pressureScore -= 12;
        } else if (income > 0 && savingsAfter >= income * 6) {
          pressureScore -= 10;
        }

        if (monthlyIncomeImpact > 300) pressureScore += 18;
        else if (monthlyIncomeImpact > 200) pressureScore += 12;
        else if (monthlyIncomeImpact > 100) pressureScore += 6;

        if (debtPaymentRatio >= 45) pressureScore += 14;
        else if (debtPaymentRatio >= 30) pressureScore += 9;
        else if (debtPaymentRatio >= 20) pressureScore += 4;

        if (
          outOfPocket > 0 &&
          savingsImpact <= 0.5 &&
          monthlyIncomeImpact <= 5 &&
          savingsAfter >= Math.max(emergencyTarget, 0)
        ) {
          pressureScore = Math.min(pressureScore, 3);
        } else if (
          outOfPocket > 0 &&
          savingsImpact <= 1 &&
          monthlyIncomeImpact <= 10 &&
          savingsAfter >= Math.max(emergencyTarget, income * 3)
        ) {
          pressureScore = Math.min(pressureScore, 8);
        } else if (
          outOfPocket > 0 &&
          savingsImpact <= 3 &&
          monthlyIncomeImpact <= 20 &&
          savingsAfter >= Math.max(emergencyTarget, 0)
        ) {
          pressureScore = Math.min(pressureScore, 15);
        }
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);
      const level = getPressureLevel(pressureScore);

      scoreText.textContent = `${level.label} — ${pressureScore}/100`;
      scoreFill.style.width = `${pressureScore}%`;
      scoreFill.className = `fill ${level.colorClass}`;

      resultDetails.innerHTML = `
        <div class="result-metric"><strong>Pressure level</strong><span>${level.stress}</span></div>
        <div class="result-metric"><strong>Estimated savings used</strong><span>${formatCurrency(outOfPocket)} after insurance, prepaid funds, estate cash, or family help.</span></div>
        <div class="result-metric"><strong>Savings after funeral</strong><span>${formatCurrency(savingsAfter)}</span></div>
        <div class="result-metric"><strong>Savings impact</strong><span>${savings > 0 ? `${savingsImpact.toFixed(1)}% of available liquid savings.` : "No liquid savings entered."}</span></div>
        <div class="result-metric"><strong>Monthly income impact</strong><span>${income > 0 ? `${monthlyIncomeImpact.toFixed(1)}% of one month’s take-home income.` : "No monthly take-home income entered."}</span></div>
        <div class="result-metric"><strong>Debt payment pressure</strong><span>${income > 0 ? `${debtPaymentRatio.toFixed(1)}% of monthly take-home income already goes to debt.` : "Enter income to estimate debt pressure."}</span></div>
        ${
          emergencyTargetRemaining !== null
            ? `<div class="result-metric"><strong>Emergency savings target</strong><span>${emergencyTargetRemaining.toFixed(1)}% of your target would remain after the funeral.</span></div>`
            : ""
        }
      `;

      if (pressureScore === 0) {
        guidance.textContent =
          `Using savings for this funeral creates essentially no measurable financial pressure based on the numbers provided. Recommended next step: ${level.action}`;
      } else if (pressureScore <= 30) {
        guidance.textContent =
          `Using savings for this funeral appears manageable based on the numbers provided. Recommended next step: ${level.action}`;
      } else if (pressureScore <= 60) {
        guidance.textContent =
          `Using savings for this funeral may be workable, but it deserves caution. Recommended next step: ${level.action}`;
      } else {
        guidance.textContent =
          `Using savings for this funeral could create real financial strain. Recommended next step: ${level.action}`;
      }
    });
  </script>
</Layout>