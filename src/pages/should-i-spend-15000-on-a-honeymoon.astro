---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
---

<Layout title="Should I Spend $15,000 on a Honeymoon?">

  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
    }

    button {
      background: var(--button);
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }
  </style>

<div class="container">

<CalculatorPageShell
  eyebrow="Honeymoon Calculator"
  title="Should I Spend $15,000 on a Honeymoon?"
  description="Estimate whether a $15,000 honeymoon fits your income, savings, debt, wedding costs, emergency cushion, and post-wedding cash flow."
>

  <div class="card">

    <h2>Honeymoon Affordability Verdict</h2>

    <div class="grid">

      <div>
        <label>Annual Household Income</label>
        <input id="income" type="number" placeholder="150000" />
      </div>

      <div>
        <label>Total Savings After Wedding</label>
        <input id="savings" type="number" placeholder="30000" />
      </div>

      <div>
        <label>Honeymoon Cost</label>
        <input id="vacation" type="number" placeholder="15000" />
      </div>

      <div>
        <label>Total Debt</label>
        <input id="debt" type="number" placeholder="20000" />

        <div class="helper-link">
          <a href="/what-counts-as-debt">
            Not sure what counts as debt? Read the debt guide
          </a>
        </div>
      </div>

    </div>

    <button id="vacationButton" type="button">
      Get Honeymoon Verdict
    </button>

    <div class="result">

      <div class="score" id="score">
        Comfortable Honeymoon - 82/100
      </div>

      <div class="bar">
        <div class="fill" id="barFill"></div>
      </div>

      <div class="metric" id="stress"></div>
      <div class="metric" id="savingsImpact"></div>
      <div class="metric" id="incomeImpact"></div>
      <div class="metric" id="debtRatio"></div>

      <div class="guidance" id="guidance"></div>

      <div class="disclaimer">
        This is a general educational estimate, not financial advice.
      </div>

    </div>

  </div>

<div class="content-section">

<section>
  <h2>What a $15,000 Honeymoon Really Costs</h2>

  <p>
    A honeymoon budget can feel different from a normal vacation because it is tied to a major
    life milestone. Flights, resort nights, upgrades, excursions, meals, spa appointments,
    travel insurance, photos, airport transfers, and once-in-a-lifetime experiences can quickly
    push the total above the original estimate.
  </p>

  <p>
    A $15,000 honeymoon may be reasonable for a luxury resort, international trip, longer stay,
    or premium experience. It becomes more risky when the wedding already created debt, savings
    are low after the wedding, or the honeymoon depends on credit cards to feel special.
  </p>

  <p>
    The best honeymoon budget protects both goals: making the trip memorable and starting
    married life without immediate financial strain.
  </p>
</section>

<section>
  <h2>When a $15,000 Honeymoon Makes Sense</h2>

  <p>
    A honeymoon at this price point makes more sense when the wedding is already paid for,
    emergency savings remain intact, and the trip does not create high-interest debt.
  </p>

  <p>
    The budget should include the full experience: flights, lodging, resort fees, meals,
    excursions, upgrades, transportation, travel insurance, and a cushion for extra spending.
  </p>

  <p>
    It can be worth spending more when the trip is a true priority and the cost does not make
    the first year of marriage financially tighter than necessary.
  </p>
</section>

<section>
  <h2>When You Should Wait</h2>

  <p>
    Waiting may be smarter if wedding bills are still unpaid, credit cards are carrying balances,
    or the honeymoon would drain most of your remaining savings.
  </p>

  <p>
    You can still preserve the milestone with a lower-cost version. Consider a shorter trip,
    delayed honeymoon, cheaper resort, fewer upgrades, domestic destination, or a smaller trip
    now with a larger anniversary trip later.
  </p>
</section>

<FAQSection
  title="Honeymoon Spending FAQ"
  faqs={[
    {
      question: "Is $15,000 too much for a honeymoon?",
      answer:
        "It depends on income, savings after the wedding, debt, destination, trip length, and whether the cost creates financial pressure. A $15,000 honeymoon can be reasonable if it is paid from savings and does not damage your emergency cushion.",
    },
    {
      question: "Should we spend more on the wedding or the honeymoon?",
      answer:
        "That depends on which experience matters more to you. The safest approach is to set one combined wedding and honeymoon budget so the honeymoon does not become an afterthought funded with debt.",
    },
    {
      question: "Should I finance a honeymoon?",
      answer:
        "Financing a honeymoon can create stress early in marriage, especially with high-interest credit card debt. Using savings while keeping an emergency cushion is usually safer.",
    },
    {
      question: "What should be included in a honeymoon budget?",
      answer:
        "Include flights, hotels or resort stays, meals, excursions, upgrades, travel insurance, transportation, tips, photos, spa costs, passports, and an emergency cushion.",
    },
    {
      question: "Is a delayed honeymoon a good idea?",
      answer:
        "A delayed honeymoon can be a smart move if it gives you time to recover from wedding costs, rebuild savings, avoid debt, or book the trip you actually want without pressure.",
    },
  ]}
/>

<RelatedCalculators
  calculators={[
    {
      category: "Wedding",
      title: "Should I Spend $30,000 on a Wedding?",
      href: "/should-i-spend-30000-on-a-wedding",
    },
    {
      category: "Travel",
      title: "Should I Spend $10,000 on a Europe Trip?",
      href: "/should-i-spend-10000-on-a-europe-trip",
    },
    {
      category: "Travel",
      title: "Should I Spend $12,000 on a Cruise?",
      href: "/should-i-spend-12000-on-a-cruise",
    },
    {
      category: "Travel",
      title: "Browse Travel Calculators",
      href: "/travel-calculators",
    },
  ]}
/>

</div>

</CalculatorPageShell>

</div>

<script is:inline>

function calculateVacation() {

  const income = Number(document.getElementById("income").value);
  const savings = Number(document.getElementById("savings").value);
  const vacation = Number(document.getElementById("vacation").value);
  const debt = Number(document.getElementById("debt").value);

  let score = 100;

  const savingsImpact = (vacation / savings) * 100;
  const incomeImpact = (vacation / income) * 100;
  const debtRatio = (debt / income) * 100;

  score -= savingsImpact * 0.22;
  score -= incomeImpact * 0.9;
  score -= debtRatio * 0.18;

  if (savings < vacation) score -= 12;
  if (debt > income * 0.5) score -= 10;

  score = Math.max(0, Math.min(100, Math.round(score)));

  let verdict = "";
  let stress = "";
  let guidance = "";
  let barColor = "";

  if (score >= 80) {
    verdict = "Comfortable Honeymoon";
    stress = "Low stress";
    guidance =
      "This honeymoon appears financially manageable based on your income, post-wedding savings, debt, and remaining emergency cushion.";
    barColor = "#16a34a";
  }

  else if (score >= 60) {
    verdict = "Manageable With Guardrails";
    stress = "Moderate stress";
    guidance =
      "This honeymoon may work, but keep firm limits on upgrades, excursions, resort costs, and post-wedding spending.";
    barColor = "#ca8a04";
  }

  else if (score >= 40) {
    verdict = "Financial Stretch";
    stress = "High stress";
    guidance =
      "This honeymoon could create financial pressure. Consider a delayed honeymoon, shorter trip, cheaper destination, or more time to save.";
    barColor = "#ea580c";
  }

  else {
    verdict = "High Financial Risk";
    stress = "Very high stress";
    guidance =
      "This honeymoon cost appears too aggressive for the current financial picture, especially if wedding costs or high-interest debt are already present.";
    barColor = "#b91c1c";
  }

  document.getElementById("score").textContent =
    `${verdict} - ${score}/100`;

  document.getElementById("barFill").style.width =
    `${score}%`;

  document.getElementById("barFill").style.background =
    barColor;

  document.getElementById("stress").innerHTML =
    `<strong>Stress level:</strong> ${stress}`;

  document.getElementById("savingsImpact").innerHTML =
    `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of post-wedding savings`;

  document.getElementById("incomeImpact").innerHTML =
    `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;

  document.getElementById("debtRatio").innerHTML =
    `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

  document.getElementById("guidance").textContent =
    guidance;
}

document.getElementById("vacationButton")
  .addEventListener("click", calculateVacation);

</script>

</Layout>