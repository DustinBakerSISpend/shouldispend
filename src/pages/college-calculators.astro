---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import MethodologySection from "../components/MethodologySection.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import { calculators } from "../data/calculators.js";

const collegeCalculators = calculators.filter(
  (calculator) => calculator.category === "College"
);

const featuredCollegeLinks = [
  {
    href: "/ideal-tuition-cost-calculator",
    title: "Ideal Tuition Cost Calculator",
    text:
      "Find a realistic annual tuition range before comparing schools, aid packages, housing plans, and career payoff.",
  },
  {
    href: "/college-cost-calculator",
    title: "College Cost Calculator",
    text:
      "Estimate the real pressure of tuition, fees, housing, books, savings, loans, and monthly cash flow before committing.",
  },
  {
    href: "/degree-roi-calculator",
    title: "Degree ROI Calculator",
    text:
      "Compare total cost, lost income, expected salary gains, payback period, debt pressure, and career upside.",
  },
  {
    href: "/should-i-take-out-student-loans",
    title: "Student Loan Calculator",
    text:
      "Compare borrowing against future payments, income expectations, repayment risk, and household flexibility.",
  },
];

const planningLinks = [
  {
    href: "/should-i-use-savings-for-college",
    title: "Should I Use Savings for College?",
    text:
      "Decide whether using cash for school protects your future or drains too much emergency and household cushion.",
  },
  {
    href: "/should-i-spend-15000-on-out-of-state-tuition",
    title: "Should I Spend $15,000 More on Out-of-State Tuition?",
    text:
      "Test whether an out-of-state premium is justified by program strength, aid, residency rules, and career upside.",
  },
  {
    href: "/should-i-spend-12000-on-campus-housing",
    title: "Should I Spend $12,000 on Campus Housing?",
    text:
      "Compare dorm costs against commute alternatives, aid coverage, independence, safety, and academic fit.",
  },
  {
    href: "/should-i-spend-5000-on-college-meal-plan",
    title: "Should I Spend $5,000 on a College Meal Plan?",
    text:
      "Evaluate required or optional meal plans against groceries, campus access, dietary needs, aid, and cash flow.",
  },
  {
    href: "/should-i-spend-10000-on-study-abroad",
    title: "Should I Spend $10,000 on Study Abroad?",
    text:
      "Pressure-test study abroad against scholarships, travel costs, safety, degree relevance, and career value.",
  },
  {
    href: "/should-i-spend-3000-on-college-laptop-and-supplies",
    title: "Should I Spend $3,000 on a College Laptop and Supplies?",
    text:
      "Evaluate laptop and supply costs using major requirements, specs, used options, aid refunds, and necessity.",
  },
];

const collegeCostFactors = [
  {
    title: "Tuition and Fees",
    text:
      "The published price may not include program fees, technology fees, lab costs, graduation fees, transfer fees, testing charges, or course-specific expenses.",
  },
  {
    title: "Housing and Transportation",
    text:
      "Dorms, rent, commuting, parking, gas, flights, moving costs, and campus access can change the real college budget quickly.",
  },
  {
    title: "Books, Supplies, and Equipment",
    text:
      "Laptops, software, uniforms, tools, textbooks, exam fees, calculators, and professional materials can add pressure beyond tuition.",
  },
  {
    title: "Lost Income and Time",
    text:
      "Going back to school can reduce work hours, delay earnings, or create childcare and schedule costs that matter as much as tuition.",
  },
  {
    title: "Student Loans",
    text:
      "Borrowing can make school possible, but the repayment math has to fit future income, existing debt, and the degree’s realistic payoff.",
  },
  {
    title: "Emergency Savings",
    text:
      "A college plan that wipes out emergency savings can become risky even when tuition itself looks manageable.",
  },
];

const collegeFaqs = [
  {
    question: "How much should you spend on college?",
    answer:
      "The right amount depends on income, savings, scholarships, grants, existing debt, expected earnings after graduation, program quality, and whether the cost creates manageable monthly pressure.",
  },
  {
    question: "Is $20,000 for college too much?",
    answer:
      "$20,000 may be reasonable for a strong program with clear career value, but it can still be risky if it drains emergency savings, requires high-interest debt, or does not improve earning power.",
  },
  {
    question: "Is $50,000 for college too much?",
    answer:
      "$50,000 is a major financial decision. It may make sense for some degrees or career pivots, but the repayment path, job outlook, income upside, and savings impact should be tested carefully.",
  },
  {
    question: "Should I take out student loans?",
    answer:
      "Student loans may be reasonable when the degree has a clear payoff and payments fit future income. They become riskier when the program outcome is uncertain, borrowing is high, or existing debt is already stressful.",
  },
  {
    question: "Should I use savings to pay for college?",
    answer:
      "Using savings can reduce borrowing, but it should not wipe out emergency reserves or leave the household unable to handle rent, repairs, medical bills, childcare, or job disruption.",
  },
  {
    question: "Should I choose the cheapest college option?",
    answer:
      "Not always. The cheapest school may be smart when outcomes are similar, but a more expensive option can make sense if it improves graduation odds, licensing, internships, job placement, safety, or time to completion.",
  },
];

const relatedCollegeCalculators = collegeCalculators
  .filter((calculator) => calculator.href !== "/college-calculators")
  .slice(0, 8);
---

<Layout
  title="College Cost Calculators | ShouldISpend"
  description="Browse college cost calculators for tuition, student loans, housing, meal plans, study abroad, savings, degree ROI, and major education spending decisions."
>
  <style>
    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 76px 24px 90px;
    }

    .hero {
      max-width: 920px;
      margin-bottom: 42px;
    }

    .eyebrow {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(2.8rem, 7vw, 5rem);
      line-height: 0.98;
      margin: 0 0 24px;
      color: var(--text);
      letter-spacing: -0.05em;
      max-width: 950px;
    }

    .intro {
      max-width: 850px;
      color: var(--muted);
      font-size: 1.12rem;
      line-height: 1.85;
      margin: 0;
    }

    .trust-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 36px 0 64px;
    }

    .trust-item {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px 20px;
    }

    .trust-item strong {
      display: block;
      color: var(--text);
      margin-bottom: 6px;
      font-size: 0.98rem;
    }

    .trust-item span {
      color: var(--muted);
      line-height: 1.55;
      font-size: 0.92rem;
    }

    .grid,
    .link-grid,
    .info-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      margin-top: 28px;
    }

    .link-grid,
    .info-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 28px;
    }

    .content-section {
      margin-top: 76px;
    }

    .content-section.narrow {
      max-width: 860px;
    }

    .section-kicker {
      color: var(--accent);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.76rem;
      margin-bottom: 12px;
    }

    .content-section h2 {
      font-size: clamp(1.85rem, 4vw, 2.35rem);
      margin: 0 0 18px;
      line-height: 1.15;
      color: var(--text);
      letter-spacing: -0.035em;
    }

    .content-section p,
    .content-section li {
      color: var(--muted);
      line-height: 1.82;
      margin-bottom: 18px;
      font-size: 1.04rem;
    }

    .link-card,
    .info-card {
      display: block;
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: rgba(15, 118, 110, 0.35);
      box-shadow: 0 16px 35px rgba(15, 23, 42, 0.08);
    }

    .link-card strong,
    .info-card h3 {
      display: block;
      color: var(--text);
      margin-bottom: 10px;
      font-size: 1.05rem;
    }

    .link-card span,
    .info-card p {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .callout {
      margin-top: 72px;
      padding: 30px;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: #f8fafc;
      max-width: 900px;
    }

    .callout h2 {
      margin: 0 0 14px;
      color: var(--text);
      font-size: 1.55rem;
      letter-spacing: -0.02em;
    }

    .callout p {
      color: var(--muted);
      line-height: 1.78;
      margin: 0;
    }

    @media (max-width: 768px) {
      .container {
        padding: 54px 18px 76px;
      }

      h1 {
        font-size: 2.75rem;
      }

      .intro {
        font-size: 1.04rem;
      }

      .trust-strip {
        grid-template-columns: 1fr;
        margin-bottom: 50px;
      }

      .grid,
      .link-grid,
      .info-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .content-section {
        margin-top: 58px;
      }
    }
  </style>

  <main class="container">
    <section class="hero">
      <div class="eyebrow">College Calculators</div>

      <h1>College Cost Calculators for Real-Life Education Decisions</h1>

      <p class="intro">
        College can be a smart investment, a manageable stretch, or a financial
        strain depending on tuition, housing, books, loans, savings, income,
        career upside, and family obligations. These calculators help
        pressure-test education spending before you commit cash, borrow money,
        or rearrange your life around school.
      </p>
    </section>

    <div class="trust-strip">
      <div class="trust-item">
        <strong>Beyond tuition</strong>
        <span>
          College affordability includes housing, meal plans, books, supplies,
          fees, lost income, and repayment pressure.
        </span>
      </div>

      <div class="trust-item">
        <strong>Loan-aware planning</strong>
        <span>
          Tools flag when borrowing may create more stress than the degree can
          reasonably justify.
        </span>
      </div>

      <div class="trust-item">
        <strong>Payoff-first framing</strong>
        <span>
          The goal is education that improves your future without cornering your
          present finances.
        </span>
      </div>
    </div>

    <section class="content-section">
      <div class="section-kicker">Start Here</div>

      <h2>College Affordability Calculators</h2>

      <p>
        Use these tools to compare tuition decisions, student loans, savings
        tradeoffs, housing, meal plans, study abroad, laptop costs, and
        back-to-school plans against your income, emergency fund, existing debt,
        monthly flexibility, and expected career payoff.
      </p>

      <div class="grid">
        {collegeCalculators.map((calculator) => (
          <CalculatorCard
            category={calculator.category}
            title={calculator.title}
            description={calculator.description}
            href={calculator.href}
          />
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-kicker">Popular Tools</div>

      <h2>Compare Common College Spending Decisions</h2>

      <p>
        A $20,000 program, a $50,000 degree path, a dorm contract, and a student
        loan decision can create very different levels of pressure. The safest
        choice is not always the cheapest one, but the numbers should make sense
        before the commitment becomes difficult to unwind.
      </p>

      <div class="link-grid">
        {featuredCollegeLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section narrow">
      <div class="section-kicker">Decision Philosophy</div>

      <h2>How Much Should You Spend on College?</h2>

      <p>
        There is no universal correct college budget. The right amount depends
        on grants, scholarships, household income, student income, existing debt,
        emergency savings, the strength of the program, career goals, and the
        income you can reasonably expect after finishing.
      </p>

      <p>
        A college expense that is manageable for one person may be risky for
        another. A safer education budget usually avoids unnecessary borrowing,
        protects some emergency cushion, and has a realistic path to improved
        earning power, career stability, licensing, or advancement.
      </p>

      <p>
        The healthiest question is not “Can I technically enroll?” It is “Will
        this education decision still feel financially defensible after the bill,
        the loans, the housing costs, and the life changes show up?”
      </p>
    </section>

    <section class="content-section">
      <div class="section-kicker">Hidden Costs</div>

      <h2>College Expenses That Quietly Change the Real Price</h2>

      <p>
        Tuition is only one part of the decision. Some college plans look
        affordable until housing, food, technology, travel, parking, software,
        lost income, and loan payments enter the picture.
      </p>

      <div class="info-grid">
        {collegeCostFactors.map((item) => (
          <div class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <KeyCostCategories
      items={[
        {
          title: "Tuition and fees",
          description:
            "The base price matters, but program fees, lab charges, technology fees, transfer fees, and course-specific costs can change the real number.",
        },
        {
          title: "Housing and food",
          description:
            "Dorms, rent, commuting, meal plans, groceries, and campus access often determine whether college is actually manageable.",
        },
        {
          title: "Loans and repayment",
          description:
            "Student loans should be judged against future income, existing debt, repayment flexibility, and the degree's realistic payoff.",
        },
        {
          title: "Savings and emergency cushion",
          description:
            "Using savings may reduce debt, but it can create risk if it leaves the student or household with too little backup cash.",
        },
        {
          title: "Career payoff",
          description:
            "Higher costs are easier to justify when the program improves earnings, licensure, job access, promotion potential, or career stability.",
        },
      ]}
    />

    <ReduceCostTips
      items={[
        "Compare net price after grants, scholarships, and reliable help — not only the published sticker price.",
        "Separate tuition from housing, food, books, laptop costs, transportation, and personal spending.",
        "Check whether credits transfer cleanly before choosing community college, transfer paths, graduate programs, or study abroad.",
        "Use expected starting salary to test whether future loan payments are likely to be manageable.",
        "Consider lower-cost paths first: in-state schools, community college, employer reimbursement, scholarships, and part-time enrollment.",
        "Avoid using emergency savings for college unless the remaining cushion is still strong.",
      ]}
    />

    <FinancialRedFlags
      items={[
        "The plan depends on vague family help, uncertain aid, or scholarships that may not renew.",
        "The student would need large loans for a degree with unclear earnings or weak completion odds.",
        "Emergency savings would be drained below a basic cushion.",
        "Housing, food, transportation, laptop costs, and fees are being ignored while tuition is evaluated alone.",
        "The more expensive option is mainly for preference, prestige, or location rather than a clear academic or career reason.",
        "The expected loan payment would crowd out rent, transportation, medical costs, or other basic obligations after graduation.",
      ]}
    />

    <CalculatorAssumptions
      items={[
        "Monthly income means take-home pay, not gross income.",
        "College affordability depends on the full education plan, not tuition alone.",
        "Aid, grants, scholarships, and reliable outside help should be treated separately from borrowed money.",
        "Emergency savings should generally be protected before increasing tuition, housing, travel, or supply spending.",
        "A higher-cost school can still make sense if the program clearly improves completion odds, career access, licensing, or earning power.",
        "A lower-cost school can be the better choice when outcomes are similar and debt risk is lower.",
      ]}
    />

    <section class="content-section">
      <div class="section-kicker">Planning Guides</div>

      <h2>College Planning and Financial Pressure Guides</h2>

      <p>
        These guides connect education spending with the bigger household
        picture: savings, debt, emergency funds, monthly obligations, and the
        tradeoff between future opportunity and present financial pressure.
      </p>

      <div class="link-grid">
        {planningLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section narrow">
      <div class="section-kicker">How to Use These Tools</div>

      <h2>Use College Calculators as a Pressure Test, Not a Permission Slip</h2>

      <p>
        A calculator result should not be the only reason to choose a school,
        borrow money, or go back to class. It should reveal whether the decision
        fits the money available, the debt already present, the cash cushion left
        afterward, and the likely payoff.
      </p>

      <p>
        The strongest college decisions usually have three things in common:
        the cost is clear, the funding source is realistic, and the expected
        benefit is specific. The weakest decisions often rely on vague optimism:
        “I’ll figure out the loans later,” “the degree should help somehow,” or
        “the expensive school just feels better.”
      </p>
    </section>

    <section class="callout">
      <h2>Use College Calculators Before the Bill Becomes Permanent</h2>

      <p>
        These tools are educational estimates, not personalized financial advice.
        Use them to compare tradeoffs, spot repayment risk, protect emergency
        savings, and make clearer decisions before committing to tuition, loans,
        housing, study abroad, meal plans, or a major career pivot.
      </p>
    </section>

    <FAQSection title="College Cost FAQ" faqs={collegeFaqs} />

    <div class="content-section">
      <RelatedCalculators calculators={relatedCollegeCalculators} />
    </div>
  </main>

  <MethodologySection category="college affordability" updated="June 2026" />
</Layout>