---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const collegeCalculators = calculators.filter(
  (calculator) => calculator.category === "College"
);

const featuredCollegeLinks = [
  {
    href: "/ideal-tuition-cost-calculator/",
    title: "Ideal Tuition Cost Calculator",
    text:
      "Find a realistic annual tuition range before comparing schools, aid packages, housing plans, and career payoff.",
  },
  {
    href: "/college-cost-calculator/",
    title: "College Cost Calculator",
    text:
      "Estimate the real pressure of tuition, fees, housing, books, savings, loans, and cash flow before committing.",
  },
  {
    href: "/degree-roi-calculator/",
    title: "Degree ROI Calculator",
    text:
      "Compare total cost, lost income, expected salary gains, payback period, debt pressure, and career upside.",
  },
  {
    href: "/should-i-take-out-student-loans/",
    title: "Student Loan Calculator",
    text:
      "Compare borrowing against future payments, income expectations, repayment risk, and household flexibility.",
  },
];

const planningLinks = [
  {
    href: "/should-i-use-savings-for-college/",
    title: "Should I Use Savings for College?",
    text:
      "Decide whether using cash for school protects your future or drains too much emergency and household cushion.",
  },


  {
    href: "/should-i-spend-5000-on-college-meal-plan/",
    title: "Should I Spend $5,000 on a College Meal Plan?",
    text:
      "Evaluate required or optional meal plans against groceries, campus access, dietary needs, aid, and cash flow.",
  },


];

const collegeCostFactors = [
  {
    title: "Tuition and fees",
    text:
      "The published price may not include program fees, technology fees, lab costs, graduation fees, transfer fees, testing charges, or course-specific expenses.",
  },
  {
    title: "Housing and transportation",
    text:
      "Dorms, rent, commuting, parking, gas, flights, moving costs, and campus access can change the real college budget quickly.",
  },
  {
    title: "Books, supplies, and equipment",
    text:
      "Laptops, software, uniforms, tools, textbooks, exam fees, calculators, and professional materials can add pressure beyond tuition.",
  },
  {
    title: "Lost income and time",
    text:
      "Going back to school can reduce work hours, delay earnings, or create childcare and schedule costs that matter as much as tuition.",
  },
  {
    title: "Student loans",
    text:
      "Borrowing can make school possible, but the repayment math has to fit future income, existing debt, and the degree's realistic payoff.",
  },
  {
    title: "Emergency savings",
    text:
      "A college plan that wipes out emergency savings can become risky even when tuition itself looks manageable.",
  },
];

const reduceCostTips = [
  {
    title: "Compare net price, not sticker price",
    text:
      "Scholarships, grants, employer help, family support, and school aid can change the real cost more than the advertised tuition number.",
  },
  {
    title: "Start with the cheapest path to the same outcome",
    text:
      "Community college, in-state tuition, transfer plans, online programs, and commuting may work when the degree outcome is similar.",
  },
  {
    title: "Separate must-have costs from upgrades",
    text:
      "Required tuition, books, and tools are different from premium housing, expensive meal plans, study abroad, and optional campus lifestyle costs.",
  },
  {
    title: "Borrow with the future payment in mind",
    text:
      "A loan is not just aid for this semester. It is a future monthly bill that has to fit the expected career path.",
  },
  {
    title: "Protect some emergency savings",
    text:
      "Using savings for college can reduce debt, but wiping out the household cushion can make normal surprises harder to survive.",
  },
  {
    title: "Check the payoff honestly",
    text:
      "The more expensive the program, the more important it is to understand graduation odds, licensing, internships, job placement, and salary range.",
  },
];

const redFlags = [
  "The plan depends on large loans without a realistic future payment estimate.",
  "The school choice drains emergency savings and still requires borrowing.",
  "The degree path has unclear job outcomes or weak salary upside.",
  "Housing, meal plans, transportation, or supplies were left out of the budget.",
  "The student is choosing a more expensive option mainly because it feels exciting.",
  "Family help is assumed but not confirmed.",
  "The plan requires credit cards for living costs.",
  "Going back to school would reduce income, but the lost pay has not been modeled.",
];

const assumptions = [
  "College affordability depends on net cost after confirmed scholarships, grants, aid, family help, and employer support.",
  "Student loans should be judged against future income, not only today's ability to enroll.",
  "Using savings can reduce debt, but emergency savings should not be drained casually.",
  "Housing, food, books, supplies, transportation, and fees are part of the real college cost.",
  "A more expensive school can make sense when it clearly improves completion odds, licensing, job placement, or long-term income.",
  "The cheapest option is not always best, but the extra cost should have a clear reason.",
  "These calculators are educational tools and do not replace financial aid, tax, legal, career, or financial advice.",
];

const collegeFaqs = [
  {
    question: "How much should you spend on college?",
    answer:
      "The right amount depends on income, savings, scholarships, grants, existing debt, expected earnings after graduation, program quality, and whether the cost creates manageable monthly pressure.",
  },
  {
    question: "Is $20,000 for college too much?",
    answer:
      "$20,000 may be reasonable for a strong program with clear career value, but it can still be risky if it drains emergency savings, requires high-interest debt, or does not improve earning power.",
  },
  {
    question: "Is $50,000 for college too much?",
    answer:
      "$50,000 is a major financial decision. It may make sense for some degrees or career pivots, but the repayment path, job outlook, income upside, and savings impact should be tested carefully.",
  },
  {
    question: "Should I take out student loans?",
    answer:
      "Student loans may be reasonable when the degree has a clear payoff and payments fit future income. They become riskier when the program outcome is uncertain, borrowing is high, or existing debt is already stressful.",
  },
  {
    question: "Should I use savings to pay for college?",
    answer:
      "Using savings can reduce borrowing, but it should not wipe out emergency reserves or leave the household unable to handle rent, repairs, medical bills, childcare, or job disruption.",
  },
  {
    question: "Should I choose the cheapest college option?",
    answer:
      "Not always. The cheapest school may be smart when outcomes are similar, but a more expensive option can make sense if it improves graduation odds, licensing, internships, job placement, safety, or time to completion.",
  },
];

const internalLinks = [
  { href: "/ideal-tuition-cost-calculator/", label: "ideal tuition calculator" },
  { href: "/college-cost-calculator/", label: "college cost calculator" },
  { href: "/degree-roi-calculator/", label: "degree ROI calculator" },
  { href: "/should-i-take-out-student-loans/", label: "student loans" },
  { href: "/should-i-use-savings-for-college/", label: "use savings for college" },
  { href: "/how-much-emergency-savings-should-i-have/", label: "emergency savings" },
  { href: "/calculators/", label: "all calculators" },
];
---

<Layout
  title="College Cost Calculators | ShouldISpend"
  description="Use college calculators to compare tuition, community college, student loans, graduate school, MBA costs, meal plans, savings, debt, and college affordability pressure."
>
  <style>
    .hub-page {
      width: 92%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 72px 0 20px;
    }

    .hero {
      max-width: 940px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      max-width: 980px;
      font-size: clamp(2.75rem, 6.4vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      margin: 0 0 24px;
      color: var(--text);
    }

    h2 {
      font-size: clamp(1.85rem, 3.6vw, 2.65rem);
      line-height: 1.08;
      letter-spacing: -0.035em;
      margin: 0 0 18px;
      color: var(--text);
    }

    h3 {
      color: var(--text);
      font-size: 1.15rem;
      line-height: 1.32;
      margin: 0 0 10px;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.04rem;
    }

    .intro {
      max-width: 880px;
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.85;
      margin: 0 0 18px;
    }

    .trust-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 34px 0 64px;
    }

    .trust-item,
    .info-card,
    .link-card,
    .callout {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
    }

    .trust-item {
      box-shadow: var(--shadow-soft);
    }

    .trust-item strong,
    .link-card strong {
      display: block;
      color: var(--text);
      margin-bottom: 10px;
      font-size: 1.05rem;
    }

    .trust-item span,
    .link-card span {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .section {
      margin-top: 76px;
      max-width: 920px;
    }

    .wide-section {
      margin-top: 76px;
    }

    .grid,
    .link-grid,
    .info-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-top: 34px;
    }

    .link-grid,
    .info-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      margin-top: 28px;
    }

    .info-card p,
    .link-card span {
      display: block;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: var(--shadow-soft);
    }

    .info-card p {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .check-list,
    .red-flag-list {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .check-list li,
    .red-flag-list li {
      margin: 0;
      padding: 15px 16px;
      border-radius: 16px;
      line-height: 1.55;
      font-size: 0.96rem;
    }

    .red-flag-list li {
      border: 1px solid #fecaca;
      background: #fff7f7;
      color: #7f1d1d;
    }

    .check-list li {
      border: 1px solid #cfeee1;
      background: #f1fbf6;
      color: #173404;
    }

    .inline-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .inline-links a {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 800;
      font-size: 0.92rem;
      background: var(--card);
    }

    .inline-links a:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .dark-callout {
      margin-top: 76px;
      background: var(--primary-dark);
      border-color: var(--primary-dark);
      color: #ffffff;
      border-radius: 24px;
      padding: 32px;
    }

    .dark-callout h2 {
      color: #ffffff;
    }

    .dark-callout p {
      color: #e7eadf;
    }

    @media (max-width: 720px) {
      .hub-page {
        padding: 56px 0 12px;
      }

      h1 {
        font-size: 2.55rem;
        line-height: 1.03;
      }

      .intro,
      p,
      li {
        font-size: 1rem;
      }

      .trust-strip,
      .grid,
      .link-grid,
      .info-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .section,
      .wide-section,
      .dark-callout {
        margin-top: 58px;
      }

      .dark-callout {
        padding: 24px;
      }
    }

    .college-hub-grid,
    .college-hub-link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 22px;
      margin-top: 28px;
    }

    .college-hub-card,
    .college-hub-link-card,
    .college-hub-callout {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 24px;
    }

    .college-hub-link-card {
      display: block;
      color: inherit;
      text-decoration: none;
      transition:
        transform 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease;
    }

    .college-hub-link-card:hover {
      transform: translateY(-2px);
      border-color: var(--primary);
      box-shadow: var(--shadow-soft);
    }

    .college-hub-card h3,
    .college-hub-link-card strong {
      display: block;
      color: var(--text);
      font-size: 1.08rem;
      line-height: 1.3;
      margin: 0 0 10px;
    }

    .college-hub-card p,
    .college-hub-link-card span,
    .college-hub-callout p {
      color: var(--muted);
      line-height: 1.75;
      margin: 0;
    }

    .college-hub-check-list {
      color: var(--muted);
      line-height: 1.8;
      margin: 22px 0 0;
      padding-left: 22px;
    }

    .college-hub-check-list li {
      margin-bottom: 12px;
    }

  </style>

  <main class="hub-page">
    <section class="hero">
      <div class="eyebrow">College Calculators</div>

      <h1>College can be an investment, a stretch, or a trap.</h1>

      <p class="intro">
        College affordability depends on more than tuition. Housing, meal plans,
        books, supplies, student loans, lost income, savings, aid, family help,
        and career payoff all change the real answer.
      </p>

      <p class="intro">
        These calculators help pressure-test education spending before you commit
        cash, borrow money, or rearrange your life around school.
      </p>

      <div class="inline-links">
        {internalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </section>

    <OmniStyleReviewBlock
      pageName="the college calculators hub"
      pageType="calculator hub"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="college cost, tuition, aid, scholarships, housing, meal plans, laptops, study abroad, student loans, savings, expected salary, and degree ROI"
    />

    <CorePageExamplesBlock
      title="College calculator examples"
      intro="College decisions should compare net cost, borrowing, aid, degree value, and cash flow instead of sticker price alone."
      useCases={[
          "You need a calculator for college affordability.",
          "You want to compare tuition, housing, meal plans, laptops, study abroad, and loans.",
          "You need to judge cost against aid, savings, debt, and expected salary."
        ]}
      notEnough={[
          "You need admissions, academic advising, tax, or financial-aid advice.",
          "You need exact program outcomes or salary guarantees.",
          "You are choosing a school mainly for personal fit."
        ]}
      examples={[
          {
            label: "Choosing a school",
            takeaway: "Compare net cost and borrowing, not sticker price."
          },
          {
            label: "Considering loans",
            takeaway: "Debt pressure should be checked against likely income."
          },
          {
            label: "Using savings",
            takeaway: "Savings can help if emergency reserves remain protected."
          }
        ]}
      commonMistake="Comparing schools before subtracting grants, scholarships, and realistic family help."
      nextStep="Start with total college cost, then test specific add-on decisions."
    />



    <section id="HubReview" class="callout">
      <div class="eyebrow">Review status</div>
      <h2>College calculator hub reviewed for clear assumptions, practical examples, and useful limits.</h2>

      <p>
        <strong>Written and maintained by Dustin Baker.</strong> Last reviewed: July 2026.
        This hub is part of the ShouldISpend calculator library and is reviewed for calculation accuracy, working links, practical examples, and clear limitations.
      </p>

      <p>
        These calculators are educational pressure tests. They help readers compare
        tuition, aid, scholarships, student loans, family help, housing, meal plans, salary expectations, and degree ROI against take-home income, savings, debt, outside help, monthly
        breathing room, and recovery risk. They are not personalized financial, legal,
        tax, medical, insurance, or investment advice.
      </p>

      <p>
        For more context, review the <a href="/methodology/">Methodology</a>,
        <a href="/editorial-policy/">Editorial Policy</a>, and
        <a href="/disclaimer/">Disclaimer</a>.
      </p>
    </section>

    <section id="CrawlableHubExamples" class="wide-section">
      <div class="eyebrow">Worked examples</div>
      <h2>Examples this hub is meant to help pressure-test</h2>

      <p>
        These examples are visible before anyone uses a form. They show how the same
        category can produce very different pressure depending on savings, income,
        debt, outside help, urgency, and whether the decision creates a recurring bill.
      </p>

      <ul class="check-list">
        <li>$15,000 out-of-state tuition mostly covered by grants, scholarships, or confirmed family help.</li>
        <li>$50,000 college cost that depends heavily on student loans with uncertain salary payoff.</li>
        <li>Campus housing that is safer with aid coverage but risky when it creates avoidable borrowing.</li>
        <li>A lower-cost community college path that preserves options before transferring.</li>
      </ul>
    </section>

    <section id="HubLimits" class="section">
      <div class="eyebrow">When this hub is not enough</div>
      <h2>Use the calculators as a starting point, not the final word.</h2>

      <p>
        A calculator can clarify pressure, but it cannot know every detail of a household.
        Slow down before relying on a result alone when the decision involves legal
        obligations, taxes, medical treatment, insurance disputes, unstable income,
        major debt, family obligations, or a situation where the lowest-cost option
        could create larger harm later.
      </p>
    </section>


    <div class="trust-strip">
      <div class="trust-item">
        <strong>Beyond tuition</strong>
        <span>College affordability includes housing, meal plans, books, supplies, fees, lost income, and repayment pressure.</span>
      </div>

      <div class="trust-item">
        <strong>Loan-aware planning</strong>
        <span>Tools flag when borrowing may create more stress than the degree can reasonably justify.</span>
      </div>

      <div class="trust-item">
        <strong>Payoff-first framing</strong>
        <span>The goal is education that improves your future without cornering your present finances.</span>
      </div>
    </div>

    <section class="wide-section">
      <div class="eyebrow">Start here</div>
      <h2>Common college spending decisions</h2>

      <div class="link-grid">
        {featuredCollegeLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    {collegeCalculators.length > 0 && (
      <section class="wide-section">
        <div class="eyebrow">All college calculators</div>
        <h2>College cost and education affordability calculators</h2>

        <p>
          Use these tools to compare tuition, loans, savings use, housing, meal
          plans, study abroad, laptop costs, graduate school, degree ROI, and
          back-to-school plans against real financial pressure.
        </p>

        <div class="grid">
          {collegeCalculators.map((calculator) => (
            <CalculatorCard
              category={calculator.category}
              title={calculator.title}
              description={calculator.description}
              href={calculator.href}
            />
          ))}
        </div>
      </section>
    )}

    <section class="section">
      <div class="eyebrow">Decision philosophy</div>
      <h2>How much should you spend on college?</h2>

      <p>
        There is no universal correct college budget. The right amount depends on
        grants, scholarships, household income, student income, existing debt,
        emergency savings, program quality, career goals, and the income you can
        reasonably expect after finishing.
      </p>

      <p>
        A college expense that is manageable for one person may be risky for another.
        A safer education budget usually avoids unnecessary borrowing, protects some
        emergency cushion, and has a realistic path to better earning power, career
        stability, licensing, or advancement.
      </p>

      <p>
        The healthiest question is not whether you can technically enroll. It is
        whether the education path still makes sense after the aid package, housing
        bill, loan payment, and future income are part of the same picture.
      </p>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Cost factors</div>
      <h2>What college costs can include</h2>

      <div class="info-grid">
        {collegeCostFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Lower the pressure</div>
      <h2>Ways to make college costs safer</h2>

      <div class="info-grid">
        {reduceCostTips.map((tip) => (
          <div class="info-card">
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="eyebrow">Warning signs</div>
      <h2>College cost red flags</h2>

      <p>
        These signs do not mean school is a bad idea. They mean the plan needs
        more math before the commitment becomes hard to unwind.
      </p>

      <ul class="red-flag-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="eyebrow">Assumptions</div>
      <h2>How these calculators think about education costs</h2>

      <p>
        These assumptions help keep the college calculator cluster consistent.
      </p>

      <ul class="check-list">
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Related tools</div>
      <h2>Other calculators that connect to college planning</h2>

      <div class="link-grid">
        {planningLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="dark-callout">
      <div class="eyebrow">Use these as pressure tests</div>

      <h2>A college decision should make the future bigger, not the present impossible.</h2>

      <p>
        ShouldISpend college calculators are educational tools. Use them to compare
        tuition, loans, savings, housing, aid, and career payoff before committing.
        For financial aid, tax, legal, career, or loan advice, talk with a qualified
        professional.
      </p>
    </section>


      <section id="CollegeDecisionPath" class="content-section">
        <h2>Start with the college decision, not the sticker price.</h2>

        <p>
          College affordability is not one question. A student comparing community
          college with a university is not making the same financial decision as a
          graduate student considering an MBA, a parent weighing student loans, or a
          household trying to cover housing, meal plans, books, and supplies.
        </p>

        <p>
          This hub is meant to route users toward the right college calculator before
          they overfocus on a single tuition number. The stronger question is what the
          degree path does to monthly cash flow, borrowing, savings, work hours, living
          costs, and the fallback plan if income or aid changes.
        </p>

        <div class="college-hub-grid">
          <div class="college-hub-card">
            <h3>Undergraduate cost decision</h3>
            <p>
              Use college cost tools when the main question is tuition, housing, books,
              transportation, meal plans, family contribution, scholarships, and the
              amount that may need to be borrowed.
            </p>
          </div>

          <div class="college-hub-card">
            <h3>Community college comparison</h3>
            <p>
              Use comparison tools when the tradeoff is lower tuition versus transfer
              timing, commuting, credits, housing, degree path, and total years in school.
            </p>
          </div>

          <div class="college-hub-card">
            <h3>Student loan decision</h3>
            <p>
              Use loan-focused pages when the key risk is future payment pressure,
              interest, repayment timing, and whether the likely income path can support
              the debt.
            </p>
          </div>

          <div class="college-hub-card">
            <h3>Graduate school decision</h3>
            <p>
              Use graduate school and MBA tools when the cost includes lost income,
              career upside, employer help, living expenses, debt, and the time it takes
              for the degree to pay back.
            </p>
          </div>
        </div>
      </section>

      <section id="CollegeCostBuckets" class="content-section">
        <h2>College costs should be separated before they are judged.</h2>

        <p>
          A college bill can look simple on a school website and messy in a household
          budget. Tuition is only one piece. Housing, meal plans, books, technology,
          transportation, fees, health insurance, deposits, and lost work hours can
          change the real affordability answer.
        </p>

        <ul class="college-hub-check-list">
          <li>Separate tuition and mandatory fees from optional or variable costs.</li>
          <li>Count housing, utilities, commuting, parking, and trips home as real college costs.</li>
          <li>Estimate books, supplies, laptop needs, software, lab fees, and program-specific expenses.</li>
          <li>Model meal plans and groceries separately because the cheaper-looking option is not always cheaper overall.</li>
          <li>Include scholarships, grants, employer help, family help, savings, work income, and realistic borrowing.</li>
          <li>Test what happens if aid changes, a transfer takes longer, or work hours drop during school.</li>
        </ul>
      </section>

      <section id="CollegeAffordabilityRiskDrivers" class="content-section">
        <h2>The safest college plan protects the years after enrollment.</h2>

        <p>
          A school can be payable this semester and still risky over the full degree
          path. The calculators on this hub should be used to check whether the plan
          still works after the first bill, after borrowing starts, and after repayment
          begins.
        </p>

        <div class="college-hub-grid">
          <div class="college-hub-card">
            <h3>Borrowing risk</h3>
            <p>
              Student loans can make a school possible, but they also create future
              payment pressure. The risk is higher when borrowing is needed every year
              with no clear repayment plan.
            </p>
          </div>

          <div class="college-hub-card">
            <h3>Completion risk</h3>
            <p>
              A lower-cost path can become expensive if credits do not transfer, the
              program takes longer, or the student has to stop and restart later.
            </p>
          </div>

          <div class="college-hub-card">
            <h3>Living-cost risk</h3>
            <p>
              Rent, meal plans, transportation, insurance, and supplies can erase the
              savings from a lower tuition number if they are not included early.
            </p>
          </div>

          <div class="college-hub-card">
            <h3>Income-timing risk</h3>
            <p>
              Working during school can help, but the plan is weaker if affordability
              depends on hours that conflict with classes, clinicals, internships, or
              graduation requirements.
            </p>
          </div>
        </div>
      </section>

      <section id="CollegeScenarioPlanning" class="content-section">
        <h2>Run the school plan through three college scenarios.</h2>

        <p>
          A single average college estimate can hide the expensive parts of the path.
          Before choosing a school, loan amount, meal plan, housing setup, or graduate
          program, compare a manageable scenario, a realistic scenario, and a stress
          scenario.
        </p>

        <div class="college-hub-grid">
          <div class="college-hub-card">
            <h3>Manageable scenario</h3>
            <p>
              Aid arrives as expected, credits apply cleanly, work income is steady,
              housing costs stay controlled, and borrowing stays below the planned limit.
            </p>
          </div>

          <div class="college-hub-card">
            <h3>Realistic scenario</h3>
            <p>
              Some costs run higher, work hours vary, books and supplies cost more than
              expected, and the student needs a modest loan or family support gap.
            </p>
          </div>

          <div class="college-hub-card">
            <h3>Stress scenario</h3>
            <p>
              Aid changes, housing costs rise, the program takes longer, credits do not
              transfer cleanly, or the student cannot work as many hours as planned.
            </p>
          </div>
        </div>
      </section>

