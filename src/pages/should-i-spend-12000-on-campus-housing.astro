---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import { calculators } from "../data/calculators.js";

const housingFaqs = [
  {
    question: "Is $12,000 too much to spend on campus housing?",
    answer:
      "$12,000 can be reasonable if it improves safety, access to classes, academic focus, or independence without creating debt pressure. It is riskier when a cheaper commute or family housing option is realistic.",
  },
  {
    question: "Is this calculator for the student or the parent?",
    answer:
      "It is for the person or household paying for campus housing. That may be the student, a parent, or both. Use the income, savings, aid, and debt that will actually support the housing cost.",
  },
  {
    question: "Should I include financial aid refunds?",
    answer:
      "Yes. Include grants, scholarships, housing aid, 529 funds, or reliable outside help that can be used for campus housing.",
  },
  {
    question: "Does this include meal plans?",
    answer:
      "No. This calculator focuses on campus housing. If the dorm requires a meal plan, add that separately or use a meal plan calculator.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "College" &&
      calculator.href !== "/should-i-spend-12000-on-campus-housing"
  )
  .slice(0, 6);
---

<Layout
  title="Should I Spend $12,000 on Campus Housing?"
  description="Evaluate whether $12,000 campus housing makes sense based on commute options, aid, savings, income, debt, safety, and fit."
>


  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro,
    .annual-note {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .annual-note {
      background: #ecfeff;
      border: 1px solid #99f6e4;
      border-radius: 18px;
      padding: 18px 20px;
      font-weight: 800;
      color: #115e59;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }

    .field-hint {
      display: block;
      margin-top: 8px;
      color: #64748b;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a,
    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .helper-link a:hover,
    .content-link:hover {
      text-decoration: underline;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .guidance {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid #dbe4ee;
      font-size: 1.12rem;
      line-height: 1.85;
      color: #1e293b;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
    }

    .pillar-card {
      display: block;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 24px;
      margin-top: 28px;
      text-decoration: none;
      transition: transform 0.15s ease;
    }

    .pillar-card:hover {
      transform: translateY(-2px);
    }

    .pillar-card strong {
      display: block;
      margin-bottom: 10px;
      color: #0f172a;
      font-size: 1.08rem;
    }

    .pillar-card span {
      color: #334155;
      line-height: 1.7;
      font-size: 0.98rem;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="College Housing Calculator"
      title="Should I Spend $12,000 on Campus Housing?"
      description="Pressure-test campus housing against commute alternatives, safety, independence, aid coverage, savings, income, debt, borrowing, and academic fit."
    >
      <div class="calculator">
        <h2>$12,000 Campus Housing Pressure Verdict</h2>

        <p class="calculator-intro">
          Campus housing can make college easier, safer, and more focused. It
          can also add real cost if a cheaper commute or family housing option
          is realistic. Use the income, savings, aid, and debt that will actually
          support the housing bill.
        </p>

        <div class="annual-note">
          Important: this evaluates campus housing for one school year, not the
          total cost of the full degree.
        </div>

        <div class="grid">
          <div class="field">
            <label for="housingCost">Campus Housing Cost per Year</label>
            <input id="housingCost" type="number" value="12000" placeholder="Example: 12000" />
          </div>

          <div class="field">
            <label for="income">Monthly Take-Home Income Supporting Housing</label>
            <input id="income" type="number" placeholder="Example: 6500" />
            <span class="field-hint">Use student income, parent income, or both  -  only if it will help pay.</span>
          </div>

          <div class="field">
            <label for="savings">Savings Available for College Housing</label>
            <input id="savings" type="number" placeholder="Example: 18000" />
          </div>

          <div class="field">
            <label for="emergencyFund">Emergency Fund After Housing Savings</label>
            <input id="emergencyFund" type="number" placeholder="Example: 10000" />
          </div>

          <div class="field">
            <label for="monthlyDebt">Current Monthly Debt Payments</label>
            <input id="monthlyDebt" type="number" placeholder="Example: 450" />
            <div class="helper-link">
              Not sure what counts as debt?
              <a href="/what-counts-as-debt/">Read the debt guide</a>
            </div>
          </div>

          <div class="field">
            <label for="borrowed">Amount Borrowed for Housing</label>
            <input id="borrowed" type="number" placeholder="Example: 6000" />
            <div class="helper-link">
              Testing the loan side?
              <a href="/should-i-take-out-student-loans/">Use the student loan calculator</a>
            </div>
          </div>

          <div class="field">
            <label for="aid">Aid / Scholarships Covering Housing</label>
            <input id="aid" type="number" placeholder="Example: 3000" />
          </div>

          <div class="field">
            <label for="outsideHelp">Reliable Family or Outside Help per Year</label>
            <input id="outsideHelp" type="number" placeholder="Example: 3000" />
          </div>

          <div class="field">
            <label for="cashUsed">Savings Used for Housing</label>
            <input id="cashUsed" type="number" placeholder="Example: 4000" />
          </div>

          <div class="field">
            <label for="commuteAlternative">Cheaper Commute Alternative</label>
            <select id="commuteAlternative">
              <option value="none">No realistic cheaper option</option>
              <option value="weak">Cheaper option exists but has drawbacks</option>
              <option value="strong" selected>Good cheaper option exists</option>
            </select>
          </div>

          <div class="field">
            <label for="housingNeed">Campus Housing Need</label>
            <select id="housingNeed">
              <option value="strong">Strong need: safety, distance, program access, or support</option>
              <option value="medium" selected>Some academic or lifestyle benefit</option>
              <option value="weak">Mostly preference or convenience</option>
            </select>
          </div>

          <div class="field">
            <label for="mealPlan">Meal Plan Situation</label>
            <select id="mealPlan">
              <option value="none">No required meal plan</option>
              <option value="moderate" selected>Meal plan adds some cost</option>
              <option value="expensive">Required expensive meal plan</option>
            </select>
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="housingButton" type="button">Get Campus Housing Verdict</button>

        <div class="results" id="results">
          <div class="score" id="scoreText"></div>
          <div class="bar">
            <div class="fill" id="fillBar"></div>
          </div>
          <div class="result-details" id="resultDetails"></div>
          <div class="guidance" id="guidance"></div>
          <div class="disclaimer">
            This is a general educational estimate, not personalized financial advice.
          </div>
        </div>
      </div>

<OmniStyleReviewBlock
      pageName="the $12,000 campus housing calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="$12,000 campus housing cost, room and board, commute alternative, aid, scholarships, family help, student income, savings, loans, debt, and whether housing supports the degree path"
    />

    <CorePageExamplesBlock
      title="$12,000 campus housing examples"
      intro="Campus housing can be worth it when it supports school success or solves commute problems. It becomes pressure when it adds debt without enough academic or practical value."
      useCases={[
          "You are deciding whether $12,000 in campus housing is worth it.",
          "You need to compare dorm cost with commuting, rent, aid, savings, and loans.",
          "You want to know whether housing cost supports or strains the degree plan."
        ]}
      notEnough={[
          "You need financial-aid, tax, lease, or student-loan advice.",
          "You need campus housing availability or roommate guidance.",
          "You are deciding based mainly on safety, disability, or student-life needs."
        ]}
      examples={[
          {
            label: "Long commute avoided",
            takeaway: "Housing may be easier to justify if it protects study time and transportation costs."
          },
          {
            label: "Housing funded by loans",
            takeaway: "Pressure rises when room and board add debt without a clear need."
          },
          {
            label: "Aid covers housing",
            takeaway: "Confirmed grants or scholarships can lower pressure if borrowing stays limited."
          }
        ]}
      commonMistake="Comparing dorm cost with rent only while ignoring commute, meal costs, aid, loans, and academic impact."
      nextStep="Compare campus housing with the full commute or off-campus alternative before borrowing."
    />



      <section class="content-section">
        <h2>Start With the Real Housing Tradeoff</h2>

        <p>
          Campus housing should be compared against the realistic alternative:
          living at home, commuting, sharing an apartment, or choosing a cheaper
          school housing option. The right answer depends on cost, safety,
          access, time, independence, and academic fit.
        </p>

        <p>
          A $12,000 dorm bill can be reasonable if it prevents a long commute,
          improves class attendance, gives the student support, or makes the
          college plan more stable. It is harder to justify when a good cheaper
          option exists and the dorm is mostly a preference.
        </p>

        <a class="pillar-card" href="/college-cost-calculator/">
          <strong>College Cost Calculator</strong>
          <span>
            Estimate total college pressure using tuition, fees, housing, books,
            loans, savings, aid, and expected payoff.
          </span>
        </a>

        <a class="pillar-card" href="/ideal-tuition-cost-calculator/">
          <strong>Ideal Tuition Cost Calculator</strong>
          <span>
            Find a realistic annual tuition range before adding housing, meal
            plans, transportation, and other school costs.
          </span>
        </a>

        <a class="pillar-card" href="/should-i-spend-5000-on-college-meal-plan/">
          <strong>Should I Spend $5,000 on a College Meal Plan?</strong>
          <span>
            Test whether a required or optional meal plan fits the full college
            budget.
          </span>
        </a>
      </section>

      <section class="content-section">
        <h2>What Campus Housing Really Includes</h2>

        <p>
          The dorm price may not be the full housing cost. Some schools require
          meal plans, activity fees, parking, deposits, laundry, technology fees,
          move-in supplies, insurance, or storage. Those extras can turn a
          simple housing decision into a larger school-year budget.
        </p>

        <p>
          The benefit side also matters. Campus housing can reduce commuting
          time, make studying easier, improve access to labs or libraries, and
          help some students stay connected. The question is whether those
          benefits are worth the extra cost after aid and help are applied.
        </p>
      </section>

      <WhenSpendingMakesSense
        title="When Spending $12,000 on Campus Housing Can Make Sense"
        items={[
          "Aid, scholarships, or reliable help cover most or all of the housing cost.",
          "Living on campus improves safety, access, attendance, or academic support.",
          "The cheaper commute would be long, unreliable, unsafe, or disruptive.",
          "Borrowing stays low or unnecessary.",
          "Emergency savings remain protected after any cash contribution.",
          "The student is more likely to finish successfully with campus support.",
        ]}
      />

      <KeyCostCategories
        items={[
          {
            title: "Annual housing cost",
            description:
              "This calculator evaluates one year of campus housing, not the entire college degree.",
          },
          {
            title: "Aid and outside help",
            description:
              "Grants, scholarships, financial aid refunds, 529 funds, or family help can reduce the uncovered housing cost.",
          },
          {
            title: "Borrowing",
            description:
              "Housing loans should be judged against income, existing debt, and total college debt exposure.",
          },
          {
            title: "Commute alternative",
            description:
              "A strong cheaper living option makes campus housing harder to justify unless the on-campus benefit is clear.",
          },
          {
            title: "Meal plan exposure",
            description:
              "A required meal plan can turn a housing decision into a larger annual living-cost decision.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Compare the dorm against the cheapest realistic housing option, not against an unrealistic ideal.",
          "Ask whether aid can be used for housing or only tuition.",
          "Check whether the housing contract is annual, semester-based, refundable, or difficult to cancel.",
          "Price required meal plans before deciding that campus housing fits.",
          "Consider living on campus for the first year only, then moving to a cheaper option later.",
          "Avoid borrowing for housing if a safe and practical lower-cost option exists.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "The dorm is mostly for preference while a good cheaper commute option exists.",
          "The housing plan requires borrowing without a clear need.",
          "Savings would be drained below a basic emergency cushion.",
          "A required meal plan makes the true cost much higher than expected.",
          "The student is ignoring transportation, parking, move-in supplies, and personal expenses.",
          "The housing contract is difficult to exit if the student transfers, withdraws, or changes plans.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "Monthly income means take-home pay, not gross income.",
          "This calculator evaluates one year of campus housing, not the full college cost.",
          "Aid, scholarships, and outside help are treated as annual amounts.",
          "Estimated student loan payment uses a rough monthly payment equal to 1.2% of the borrowed amount.",
          "If aid and outside help fully cover housing, pressure can be 0/100.",
          "Huge income, huge savings, low debt, no borrowing, and strong liquidity can produce 0/100 with no artificial minimum.",
        ]}
      />

      <section class="content-section">
        <h2>When the Cheaper Housing Option Wins</h2>

        <p>
          A cheaper commute or family housing setup may be the better move when
          it is safe, reliable, and does not damage the student's ability to
          attend class, study, work, or participate in required activities.
        </p>

        <p>
          Saving $12,000 in one year can protect emergency savings, reduce loans,
          pay for books and supplies, or leave room for future semesters. Campus
          housing should earn its cost, especially when the alternative is
          practical.
        </p>
      </section>

      <section class="content-section">
        <h2>What Your Campus Housing Verdict Means</h2>

        <p>
          A low-pressure result means the dorm cost appears manageable based on
          the income, savings, aid, borrowing, and support entered. A moderate
          result means the housing plan may still work, but cheaper options and
          meal-plan costs should be tested.
        </p>

        <p>
          A high-pressure result does not mean living on campus is wrong. It
          means this version of the housing plan may need more aid, less
          borrowing, a cheaper dorm, a different meal plan, or a safer cash
          cushion before it becomes financially durable.
        </p>
      </section>

      <div class="content-section">
        <FAQSection title="Campus Housing FAQ" faqs={housingFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="college housing affordability" updated="June 2026" />
  </div>

  <script is:inline>
  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  const getNumber = (id) => {
    const rawValue = document.getElementById(id)?.value;
    const value = Number(rawValue);
    return Number.isFinite(value) && value >= 0 ? value : 0;
  };

  const getValue = (id) => document.getElementById(id)?.value || "";

  function formatDollars(value) {
    return `$${Math.round(value).toLocaleString()}`;
  }

  function getPressureLevel(score) {
    if (score <= 30) {
      return {
        label: "Low Pressure",
        stress: "Low pressure",
        colorClass: "safe",
        action:
          "Confirm housing rules, meal-plan costs, and aid coverage, but the dorm cost appears manageable.",
      };
    }

    if (score <= 60) {
      return {
        label: "Moderate Pressure",
        stress: "Moderate pressure",
        colorClass: "caution",
        action:
          "Compare commuting, cheaper housing, aid coverage, and meal-plan costs before committing.",
      };
    }

    return {
      label: "High Pressure",
      stress: "High pressure",
      colorClass: "danger",
      action:
        "Reduce the housing cost, avoid borrowing, choose a cheaper option, or build more cushion before committing.",
    };
  }

  function calculateHousingPressure() {
    const housingCost = getNumber("housingCost") || 12000;
    const income = getNumber("income");
    const savings = getNumber("savings");
    const emergencyFund = getNumber("emergencyFund");
    const monthlyDebt = getNumber("monthlyDebt");
    const requestedBorrowed = getNumber("borrowed");
    const aid = getNumber("aid");
    const outsideHelp = getNumber("outsideHelp");
    const requestedCashUsed = getNumber("cashUsed");
    const commuteAlternative = getValue("commuteAlternative") || "strong";
    const housingNeed = getValue("housingNeed") || "medium";
    const mealPlan = getValue("mealPlan") || "moderate";

    const results = document.getElementById("results");
    const scoreText = document.getElementById("scoreText");
    const fillBar = document.getElementById("fillBar");
    const resultDetails = document.getElementById("resultDetails");
    const guidance = document.getElementById("guidance");

    results.classList.add("visible");

    if (housingCost <= 0) {
      scoreText.textContent = "Add the housing cost first";
      fillBar.style.width = "0%";
      fillBar.className = "fill safe";
      resultDetails.innerHTML =
        "<p>Enter the annual campus housing cost to calculate pressure.</p>";
      guidance.textContent = "";
      return;
    }

    if (income <= 0 && savings <= 0 && aid <= 0 && outsideHelp <= 0) {
      scoreText.textContent = "Add your numbers first";
      fillBar.style.width = "0%";
      fillBar.className = "fill safe";
      resultDetails.innerHTML =
        "<p>Enter income, savings, aid, outside help, or borrowing that will support campus housing.</p>";
      guidance.textContent = "";
      return;
    }

    const annualIncome = income * 12;
    const giftHelp = aid + outsideHelp;
    const uncoveredCost = Math.max(housingCost - giftHelp, 0);

    const borrowed = Math.min(requestedBorrowed, uncoveredCost);
    const cashNeededAfterBorrowing = Math.max(uncoveredCost - borrowed, 0);
    const cashUsed =
      uncoveredCost <= 0
        ? 0
        : Math.min(
            requestedCashUsed > 0 ? requestedCashUsed : cashNeededAfterBorrowing,
            cashNeededAfterBorrowing
          );

    const remainingSavings = Math.max(savings - cashUsed, 0);
    const estimatedLoanPayment = borrowed > 0 ? borrowed * 0.012 : 0;

    const emergencyMonths = income > 0 ? emergencyFund / income : 0;
    const savingsMonthsAfter = income > 0 ? remainingSavings / income : 0;
    const totalLiquidMonthsAfter =
      income > 0 ? (remainingSavings + emergencyFund) / income : 0;

    const debtRatioAfter =
      income > 0 ? ((monthlyDebt + estimatedLoanPayment) / income) * 100 : 0;

    const uncoveredCostRatio =
      income > 0
        ? (uncoveredCost / Math.max(annualIncome, 1)) * 100
        : uncoveredCost > 0
          ? 100
          : 0;

    const cashUseRatio =
      cashUsed > 0 ? (cashUsed / Math.max(savings, 1)) * 100 : 0;

    const borrowedShare =
      borrowed > 0 && uncoveredCost > 0 ? (borrowed / uncoveredCost) * 100 : 0;

    let pressureScore = 0;
    let hardGateReason = "";

    if (uncoveredCost === 0) {
      pressureScore = 0;
      hardGateReason =
        "Aid and outside help fully cover the annual campus housing cost.";
    } else if (
      income >= housingCost * 2 &&
      debtRatioAfter <= 10 &&
      borrowed <= income * 0.1
    ) {
      pressureScore = 0;
      hardGateReason =
        "Monthly take-home income is large enough that the uncovered housing cost creates no meaningful pressure.";
    } else if (
      savings >= housingCost * 20 &&
      remainingSavings >= housingCost * 15
    ) {
      pressureScore = 0;
      hardGateReason =
        "Savings are large enough that the housing cost creates no meaningful pressure.";
    } else if (
      uncoveredCost <= income * 0.25 &&
      debtRatioAfter <= 10 &&
      borrowed === 0
    ) {
      pressureScore = 0;
      hardGateReason =
        "The uncovered housing cost is less than one week of take-home income with no borrowing needed.";
    } else {
      pressureScore += clamp(uncoveredCostRatio * 1.6, 0, 28);
      pressureScore += clamp(cashUseRatio * 0.22, 0, 16);
      pressureScore += clamp(debtRatioAfter * 0.6, 0, 26);

      if (borrowed > 0) {
        pressureScore += clamp(borrowedShare * 0.14, 0, 14);
      }

      if (emergencyMonths < 1) {
        pressureScore += savings >= housingCost * 5 ? 2 : 16;
      } else if (emergencyMonths < 3) {
        pressureScore += savings >= housingCost * 5 ? 1 : 7;
      } else if (emergencyMonths >= 6) {
        pressureScore -= 8;
      }

      if (savingsMonthsAfter >= 24) pressureScore -= 18;
      else if (savingsMonthsAfter >= 12) pressureScore -= 12;
      else if (savingsMonthsAfter >= 6) pressureScore -= 6;
      else if (cashUsed > 0 && savingsMonthsAfter < 1) pressureScore += 12;

      if (commuteAlternative === "strong") pressureScore += 8;
      else if (commuteAlternative === "none") pressureScore -= 8;

      if (housingNeed === "strong") pressureScore -= 10;
      else if (housingNeed === "weak") pressureScore += 8;

      if (mealPlan === "expensive") pressureScore += 7;
      else if (mealPlan === "none") pressureScore -= 4;

      if (giftHelp >= housingCost * 0.75) pressureScore -= 14;
      else if (giftHelp >= housingCost * 0.5) pressureScore -= 10;
      else if (giftHelp >= housingCost * 0.25) pressureScore -= 5;

      if (
        savings >= housingCost * 12 &&
        remainingSavings >= housingCost * 10 &&
        debtRatioAfter <= 12
      ) {
        pressureScore = Math.min(pressureScore, 5);
      }

      if (
        savings >= housingCost * 8 &&
        remainingSavings >= housingCost * 6 &&
        debtRatioAfter <= 15
      ) {
        pressureScore = Math.min(pressureScore, 10);
      }

      if (
        income >= housingCost &&
        uncoveredCost <= income &&
        debtRatioAfter <= 12
      ) {
        pressureScore = Math.min(pressureScore, 5);
      }

      if (
        borrowed === 0 &&
        uncoveredCost <= income &&
        debtRatioAfter <= 10
      ) {
        pressureScore = Math.min(pressureScore, 3);
      }
    }

    pressureScore = clamp(Math.round(pressureScore), 0, 100);

    const level = getPressureLevel(pressureScore);

    scoreText.textContent = `${level.label}  -  ${pressureScore}/100`;
    fillBar.style.width = `${pressureScore}%`;
    fillBar.className = `fill ${level.colorClass}`;

    let explanation = "";

    if (pressureScore === 0) {
      explanation =
        hardGateReason ||
        "This campus housing cost creates virtually no measurable pressure based on the income, savings, debt, borrowing, and aid entered.";
    } else if (pressureScore <= 30) {
      explanation =
        "This campus housing cost appears manageable. The main job is confirming the housing benefit, meal-plan cost, and cheaper alternatives.";
    } else if (pressureScore <= 60) {
      explanation =
        "This campus housing decision may work, but it deserves caution. Compare cheaper housing, commuting, meal-plan costs, and aid coverage before committing.";
    } else {
      explanation =
        "This campus housing decision could create significant financial pressure. A cheaper housing plan, more aid, less borrowing, or stronger savings cushion would likely be safer.";
    }

    resultDetails.innerHTML = `
      <p><strong>Annual campus housing cost:</strong> ${formatDollars(housingCost)}.</p>

      <p><strong>Aid and outside help applied:</strong> ${formatDollars(giftHelp)}.</p>

      <p><strong>Uncovered housing cost:</strong> ${formatDollars(uncoveredCost)}.</p>

      <p><strong>Uncovered cost impact:</strong> ${uncoveredCostRatio.toFixed(1)}% of annual take-home income.</p>

      <p><strong>Estimated loan payment:</strong> About ${formatDollars(estimatedLoanPayment)} per month based on uncovered borrowing.</p>

      <p><strong>Debt impact after borrowing:</strong> ${debtRatioAfter.toFixed(1)}% of monthly take-home income, including estimated housing loan payment.</p>

      <p><strong>Emergency fund coverage:</strong> ${emergencyMonths.toFixed(1)} months of take-home income.</p>

      <p><strong>Savings after planned cash use:</strong> About ${savingsMonthsAfter.toFixed(1)} months of take-home income.</p>

      <p><strong>Total liquid cushion after housing:</strong> About ${totalLiquidMonthsAfter.toFixed(1)} months of take-home income.</p>

      <p><strong>Pressure level:</strong> ${level.stress}.</p>

      <p>${explanation} Recommended next step: ${level.action}</p>
    `;

    guidance.textContent = "";
  }

  document
    .getElementById("housingButton")
    .addEventListener("click", calculateHousingPressure);
</script>
</Layout>
