---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const funeralFaqs = [
  {
    question: "Is cremation cheaper than burial?",
    answer:
      "Direct cremation is usually cheaper than traditional burial because it can avoid cemetery plots, caskets, burial vaults, grave opening and closing, and headstone costs. Cremation with a large memorial, reception, obituary, flowers, urn, and travel can still become expensive.",
  },
  {
    question: "How do I compare funeral and cremation costs?",
    answer:
      "Compare the full out-of-pocket cost after insurance, family help, cemetery fees, funeral home charges, service costs, reception costs, travel, debt risk, and emergency savings impact. Do not compare only the base package price.",
  },
  {
    question: "Should I choose cremation to save money?",
    answer:
      "Cremation can reduce financial pressure, especially when burial would create debt or drain savings. But family wishes, faith, culture, and the person's preferences also matter. The safest choice is the one that honors the person without harming the surviving household.",
  },
  {
    question: "What is the cheapest respectful funeral option?",
    answer:
      "Direct cremation with a family-hosted memorial is often one of the lowest-cost respectful options. A simple graveside service or memorial-only gathering can also work, depending on local pricing, family needs, and available support.",
  },
  {
    question: "When is burial worth the extra cost?",
    answer:
      "Burial may be worth the extra cost when it reflects the person's clear wishes, religious practice, cemetery ownership, family tradition, or prepaid planning, and when the family can pay without high-interest debt or emergency-savings damage.",
  },
];

const costCategories = [
  {
    title: "Funeral home services",
    body:
      "Both burial and cremation can include planning, staff, transportation, paperwork, permits, facility use, viewing, and ceremony coordination.",
  },
  {
    title: "Burial-specific costs",
    body:
      "Burial may add a casket, cemetery plot, burial vault, grave liner, grave opening and closing, marker, headstone, and cemetery administration fees.",
  },
  {
    title: "Cremation-specific costs",
    body:
      "Cremation may include crematory fees, a cremation container, urn, keepsakes, permits, transportation, and optional burial or scattering of ashes.",
  },
  {
    title: "Service and memorial costs",
    body:
      "Viewing, visitation, memorial service, clergy, music, flowers, programs, livestreaming, obituary, photos, and reception costs can apply to either option.",
  },
  {
    title: "Family logistics",
    body:
      "Travel, lodging, food, missed work, transportation, and family-hosted gatherings can meaningfully affect the real cost of either plan.",
  },
  {
    title: "Debt and timing",
    body:
      "A lower-cost option is safer when it avoids borrowing, preserves emergency savings, and does not rely on delayed insurance or vague reimbursement.",
  },
];

const reduceCostTips = [
  "Ask for itemized burial and cremation quotes rather than comparing packages by name.",
  "Price direct cremation, cremation with memorial, simple graveside service, and traditional burial side by side.",
  "Separate required cemetery costs from optional burial upgrades.",
  "Choose a simpler casket, urn, vault, flowers, printed materials, or reception if those upgrades are not central to the goodbye.",
  "Ask family members to contribute to specific costs such as obituary, food, flowers, travel, or music.",
  "Delay headstone upgrades, keepsakes, or a larger celebration of life until cash is available.",
  "Avoid choosing burial or cremation only because of pressure from relatives who are not helping pay.",
  "Use savings carefully and avoid high-interest debt if a lower-pressure option still honors the person.",
];

const redFlags = [
  "The higher-cost option requires credit cards, personal loans, or funeral financing.",
  "Insurance or estate reimbursement is assumed but not confirmed.",
  "The burial quote excludes cemetery, headstone, grave opening, or reception costs.",
  "The cremation quote excludes memorial, urn, obituary, travel, or family-gathering costs.",
  "One person is signing the contract while others only vaguely promise to contribute.",
  "The family is choosing the more expensive option mainly because of guilt or fear of judgment.",
  "Emergency savings would fall below the household's minimum safe level.",
  "The quote is not itemized enough to compare required costs and optional upgrades.",
  "Both options create pressure, but the family has not compared a smaller memorial or delayed gathering.",
];

const assumptions = [
  "Monthly income means take-home pay available to the person or household paying the funeral bill.",
  "Insurance or family help means confirmed or highly realistic money available for this funeral.",
  "Liquid savings means cash available without missing essential bills or selling long-term assets.",
  "The calculator applies the same help amount to both options to compare pressure consistently.",
  "The emergency target is the minimum savings cushion the household wants left after the funeral is paid.",
  "The calculator estimates financial pressure, not the spiritual, cultural, or emotional value of burial or cremation.",
  "A score of 0 is allowed when an option is fully covered or tiny compared with savings and income.",
];

const relatedCalculators = [
  {
    title: "Funeral Calculators",
    href: "/funeral-calculators",
    body: "Browse the full funeral calculator cluster for burial, cremation, insurance, savings, and debt decisions.",
  },
  {
    title: "Can I Afford a Funeral?",
    href: "/can-i-afford-a-funeral",
    body: "Compare a full funeral quote against savings, income, debt, essential bills, and emergency reserves.",
  },
  {
    title: "Cremation Cost Calculator",
    href: "/cremation-cost-calculator",
    body: "Estimate direct cremation, memorial, urn, obituary, travel, and reception costs.",
  },
  {
    title: "Burial Cost Calculator",
    href: "/burial-cost-calculator",
    body: "Estimate burial costs including casket, plot, vault, headstone, and cemetery fees.",
  },
  {
    title: "$5,000 Funeral Calculator",
    href: "/should-i-spend-5000-on-a-funeral",
    body: "Test a smaller cremation or memorial budget against savings and debt pressure.",
  },
  {
    title: "$10,000 Funeral Calculator",
    href: "/should-i-spend-10000-on-a-funeral",
    body: "Pressure-test a common funeral budget against income, savings, help, and debt.",
  },
  {
    title: "$15,000 Funeral Calculator",
    href: "/should-i-spend-15000-on-a-funeral",
    body: "Evaluate a higher-cost burial or full-service funeral before committing.",
  },
  {
    title: "Use Savings for Funeral Costs?",
    href: "/should-i-use-savings-for-funeral-costs",
    body: "Decide whether paying from savings protects the family or drains too much emergency cushion.",
  },
];
---

<Layout
  title="Funeral vs. Cremation Cost Calculator"
  description="Compare funeral and cremation costs, burial expenses, savings impact, insurance help, family contributions, debt risk, and emergency fund pressure."
>
  <style>
    .container { max-width: 1060px; margin: 0 auto; padding: 80px 24px; }
    .eyebrow { color:#0f766e; text-transform:uppercase; letter-spacing:2px; font-size:.8rem; font-weight:900; margin-bottom:18px; }
    h1 { font-size:clamp(2.65rem,7vw,4.8rem); line-height:.95; margin:0 0 24px; color:#0f172a; max-width:930px; }
    h2 { font-size:clamp(1.8rem,4vw,2.45rem); line-height:1.12; margin:0 0 18px; color:#0f172a; }
    h3 { color:#0f172a; line-height:1.25; margin:0 0 10px; }
    p, li { color:#334155; line-height:1.85; font-size:1.06rem; }
    a { color:#0f766e; font-weight:800; }
    .intro { max-width:860px; font-size:1.14rem; margin-bottom:32px; }
    .hero-grid, .info-grid, .link-grid, .mini-grid { display:grid; gap:20px; }
    .hero-grid { grid-template-columns:minmax(0,1.4fr) minmax(280px,.7fr); margin:34px 0 56px; }
    .info-grid, .link-grid, .mini-grid { grid-template-columns:repeat(auto-fit,minmax(245px,1fr)); margin-top:28px; }
    .summary-card, .calculator-box, .info-card, .link-card, .callout, .mini-card, .table-wrap {
      border:1px solid #dbe4ee; background:#fff; border-radius:24px; box-shadow:0 12px 28px rgba(15,23,42,.04);
    }
    .summary-card, .info-card, .mini-card, .link-card, .callout { padding:24px; }
    .summary-card { background:linear-gradient(180deg,#f8fafc 0%,#fff 100%); }
    .summary-card strong { display:block; color:#0f172a; font-size:1.1rem; margin-bottom:10px; }
    .summary-list { margin:0; padding-left:20px; }
    .summary-list li { margin-bottom:10px; font-size:.98rem; }
    .calculator-box { padding:30px; margin-bottom:64px; }
    .form-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:18px; margin-top:24px; }
    label { display:block; font-weight:900; color:#0f172a; margin-bottom:8px; font-size:.95rem; }
    .hint { display:block; color:#64748b; font-size:.83rem; line-height:1.45; margin-top:5px; }
    input { width:100%; border:1px solid #cbd5e1; border-radius:13px; padding:13px; font-size:1rem; box-sizing:border-box; color:#0f172a; background:#fff; }
    button { margin-top:24px; border:none; border-radius:999px; padding:15px 24px; background:#0f766e; color:#fff; font-weight:900; font-size:1rem; cursor:pointer; }
    button:hover { opacity:.92; }
    .result { margin-top:32px; background:#f8fafc; border:1px solid #dbe4ee; border-radius:24px; padding:30px; display:none; }
    .result.visible { display:block; }
    .score { font-size:clamp(2rem,4vw,2.75rem); font-weight:950; color:#0f172a; margin-bottom:20px; line-height:1.12; }
    .bar { height:16px; background:#dbe4ee; border-radius:999px; overflow:hidden; margin-bottom:24px; }
    .fill { height:100%; width:0%; border-radius:999px; transition:width .45s ease; }
    .fill.safe { background:linear-gradient(90deg,#0f766e 0%,#14b8a6 100%); }
    .fill.caution { background:linear-gradient(90deg,#ca8a04 0%,#facc15 100%); }
    .fill.danger { background:linear-gradient(90deg,#dc2626 0%,#f97316 100%); }
    .result-details { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:14px; margin-top:20px; }
    .result-metric { background:#fff; border:1px solid #e2e8f0; border-radius:18px; padding:16px; }
    .result-metric strong { display:block; color:#0f172a; margin-bottom:6px; }
    .result-metric span { color:#334155; line-height:1.55; font-size:.96rem; }
    .guidance { margin-top:22px; padding-top:20px; border-top:1px solid #dbe4ee; color:#0f172a; font-size:1.08rem; line-height:1.8; }
    .fine-print { color:#64748b; font-size:.9rem; margin-top:18px; line-height:1.6; }
    .content-section { margin-top:76px; }
    .content-section > p { max-width:900px; }
    .numbered-card { position:relative; padding-top:48px; }
    .numbered-card .number { position:absolute; top:20px; left:22px; width:28px; height:28px; border-radius:999px; background:#ccfbf1; color:#115e59; font-weight:950; display:grid; place-items:center; font-size:.86rem; }
    .callout { background:#f8fafc; margin-top:28px; }
    .callout p { margin:0; color:#0f172a; font-size:1.08rem; }
    .warning-box { border-left:5px solid #dc2626; }
    .decision-box { border-left:5px solid #0f766e; }
    .table-wrap { overflow-x:auto; margin-top:26px; padding:0; }
    table { width:100%; border-collapse:collapse; min-width:720px; }
    th, td { text-align:left; padding:16px; border-bottom:1px solid #e2e8f0; vertical-align:top; color:#334155; line-height:1.55; }
    th { color:#0f172a; background:#f8fafc; font-size:.92rem; text-transform:uppercase; letter-spacing:.04em; }
    tr:last-child td { border-bottom:none; }
    .link-card { display:block; text-decoration:none; color:inherit; transition:transform .15s ease, box-shadow .15s ease; }
    .link-card:hover { transform:translateY(-2px); box-shadow:0 16px 34px rgba(15,23,42,.08); }
    .link-card strong { display:block; color:#0f172a; margin-bottom:8px; line-height:1.3; font-size:1.03rem; }
    .link-card span, .info-card p, .mini-card p { display:block; margin:0; color:#334155; line-height:1.7; font-size:.96rem; }
    .check-list, .red-list { list-style:none; padding-left:0; }
    .check-list li, .red-list li { position:relative; padding-left:30px; margin-bottom:10px; }
    .check-list li::before { content:"+"; position:absolute; left:0; top:0; color:#0f766e; font-weight:950; }
    .red-list li::before { content:"!"; position:absolute; left:0; top:2px; width:18px; height:18px; border-radius:999px; display:grid; place-items:center; background:#fee2e2; color:#b91c1c; font-weight:950; font-size:.8rem; }
    @media (max-width:760px) {
      .container { padding:54px 18px; }
      .hero-grid { grid-template-columns:1fr; }
      .calculator-box { padding:22px; }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Funeral vs. Cremation Calculator</div>

    <h1>Funeral vs. Cremation Cost Calculator</h1>

    <p class="intro">
      Burial and cremation can create very different financial pressure. This
      calculator compares a traditional funeral or burial plan against a
      cremation plan using savings, insurance help, family contributions, income,
      debt, and emergency fund protection.
    </p>

    <div class="hero-grid">
      <div class="summary-card">
        <strong>Fast answer</strong>
        <p>
          Cremation often reduces pressure because it can avoid cemetery, casket,
          vault, and grave costs. But the best choice is not automatically the
          cheapest choice. It is the option that honors the person without
          creating avoidable financial harm.
        </p>
      </div>

      <div class="summary-card">
        <strong>This page helps you compare:</strong>
        <ul class="summary-list">
          <li>burial cost versus cremation cost</li>
          <li>out-of-pocket cost after help</li>
          <li>emergency savings left afterward</li>
          <li>debt risk and family pressure</li>
        </ul>
      </div>
    </div>

    <section class="calculator-box">
      <h2>Compare Funeral and Cremation Costs</h2>

      <p>
        Enter the estimated burial or funeral cost, estimated cremation cost,
        available savings, insurance or family help, take-home income, debt
        payments, and the emergency cushion you want left afterward.
      </p>

      <div class="form-grid">
        <div>
          <label for="burialCost">Traditional funeral or burial cost</label>
          <input id="burialCost" type="number" placeholder="Example: 15000" min="0" inputmode="decimal" />
          <span class="hint">Include funeral home, cemetery, casket, burial, reception, and related costs.</span>
        </div>

        <div>
          <label for="cremationCost">Cremation or memorial cost</label>
          <input id="cremationCost" type="number" placeholder="Example: 5000" min="0" inputmode="decimal" />
          <span class="hint">Include cremation, urn, memorial, obituary, gathering, and travel costs.</span>
        </div>

        <div>
          <label for="savings">Current liquid savings</label>
          <input id="savings" type="number" placeholder="Example: 20000" min="0" inputmode="decimal" />
          <span class="hint">Cash available without missing bills or selling long-term assets.</span>
        </div>

        <div>
          <label for="help">Insurance or family help</label>
          <input id="help" type="number" placeholder="Example: 3000" min="0" inputmode="decimal" />
          <span class="hint">Confirmed insurance, prepaid funds, estate cash, or family contributions.</span>
        </div>

        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 6500" min="0" inputmode="decimal" />
          <span class="hint">After-tax income for the person or household paying.</span>
        </div>

        <div>
          <label for="debt">Monthly debt payments</label>
          <input id="debt" type="number" placeholder="Example: 900" min="0" inputmode="decimal" />
          <span class="hint">Credit cards, loans, car payments, student loans, and medical payment plans.</span>
        </div>

        <div>
          <label for="emergencyTarget">Minimum savings you want left afterward</label>
          <input id="emergencyTarget" type="number" placeholder="Example: 12000" min="0" inputmode="decimal" />
          <span class="hint">The cash floor you do not want either option to break.</span>
        </div>
      </div>

      <button class="sis-action-button sis-calculate-button" id="calculateButton" type="button">Compare Funeral Options</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>
        <div class="bar"><div class="fill" id="scoreFill"></div></div>
        <div class="result-details" id="resultDetails"></div>
        <div class="guidance" id="guidance"></div>
        <div class="fine-print">This calculator is educational only and is not financial, legal, insurance, tax, estate, or funeral-planning advice.</div>
      </div>
    </section>

    <OmniStyleReviewBlock
      pageName="the funeral vs cremation cost calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="funeral versus cremation cost, burial, direct cremation, memorial service, cemetery costs, reception, travel, insurance, savings, family help, debt, and affordability pressure"
    />

    <CorePageExamplesBlock
      title="Funeral vs cremation cost examples"
      intro="Burial and cremation can both be meaningful. The affordability question is the total cost, confirmed funds, and debt risk."
      useCases={[
          "You are comparing burial, cremation, and memorial options.",
          "You need to include cemetery, service, reception, travel, insurance, savings, and family help.",
          "You want to understand which option creates less payment pressure."
        ]}
      notEnough={[
          "You need religious, legal, estate, or funeral-home advice.",
          "You need urgent arrangements or grief counseling.",
          "You are resolving family disagreement over final wishes."
        ]}
      examples={[
          {
            label: "Direct cremation with memorial",
            takeaway: "Pressure can be lower when the family separates disposition from gathering."
          },
          {
            label: "Traditional burial",
            takeaway: "Costs rise with casket, cemetery, vault, headstone, and service choices."
          },
          {
            label: "Insurance-funded service",
            takeaway: "Confirmed insurance can change the affordability picture."
          }
        ]}
      commonMistake="Comparing cremation and burial without adding cemetery, reception, travel, and timing costs."
      nextStep="Compare itemized totals for each option before choosing."
    />



    <section class="content-section">
      <h2>Burial versus cremation is a cost decision and a values decision</h2>

      <p>
        The financial difference between burial and cremation can be large, but
        the decision is not purely mathematical. The person's wishes, faith,
        family tradition, cemetery ownership, culture, and emotional needs all
        matter. The money question is whether those preferences can be honored
        without leaving the surviving household exposed.
      </p>

      <p>
        A traditional burial may be right when it is clearly wanted and safely
        funded. A cremation or memorial plan may be safer when burial would
        require debt, drain emergency savings, or force one person to carry the
        cost alone.
      </p>

      <div class="callout decision-box">
        <p>
          The best option is not always the cheapest option. It is the option
          that honors the person while keeping the family financially stable.
        </p>
      </div>
    </section>

    <section class="content-section" id="MethodologySection">
      <h2>How this funeral vs. cremation calculator works</h2>

      <p>
        The calculator estimates separate pressure scores for the burial plan
        and the cremation plan. It subtracts the same confirmed help from each
        option, then compares the out-of-pocket cost against savings, monthly
        take-home income, debt payments, and the emergency cushion the household
        wants left afterward.
      </p>

      <div class="mini-grid">
        <div class="mini-card numbered-card">
          <div class="number">1</div>
          <h3>Compare total cost</h3>
          <p>The calculator starts with the full burial cost and full cremation cost, including service and gathering expenses.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">2</div>
          <h3>Apply confirmed help</h3>
          <p>Insurance, prepaid funds, estate cash, or family help reduce the out-of-pocket cost for each option.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">3</div>
          <h3>Check savings impact</h3>
          <p>The score rises if either option drains cash below the emergency target or requires borrowing.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">4</div>
          <h3>Compare pressure scores</h3>
          <p>The result shows which option creates less financial pressure and whether the difference is meaningful.</p>
        </div>
      </div>

      <p>
        There is no artificial minimum pressure. If an option is fully covered,
        the score can be 0. If the uncovered cost is tiny compared with income
        and savings, the score can also be 0.
      </p>
    </section>

    <section class="content-section" id="KeyCostCategories">
      <h2>Key cost categories when comparing burial and cremation</h2>

      <p>
        Burial and cremation quotes can look simple until the family adds
        services, gathering costs, products, travel, or cemetery expenses. The
        full comparison should include everything the household expects to pay.
      </p>

      <div class="info-grid">
        {costCategories.map((category) => (
          <div class="info-card">
            <h3>{category.title}</h3>
            <p>{category.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>Burial vs. cremation cost comparison</h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Choice</th>
              <th>Common costs</th>
              <th>Financial pressure point</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Traditional burial</td>
              <td>Casket, cemetery plot, vault, opening and closing, marker, viewing, service, transportation, and reception.</td>
              <td>Costs can stack quickly across several vendors, not just the funeral home.</td>
            </tr>
            <tr>
              <td>Simple burial or graveside service</td>
              <td>Casket, cemetery fees, transportation, smaller service, and fewer facility or reception costs.</td>
              <td>Still may be expensive if cemetery requirements, vault, or marker costs are high.</td>
            </tr>
            <tr>
              <td>Cremation with memorial</td>
              <td>Cremation, urn, obituary, memorial service, food, travel, flowers, photos, and keepsakes.</td>
              <td>Usually more flexible, but memorial choices can still push the cost up.</td>
            </tr>
            <tr>
              <td>Direct cremation</td>
              <td>Basic services, transportation, paperwork, cremation container, cremation, and simple return of ashes.</td>
              <td>Often lowest pressure, but families should still budget for any separate gathering.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>When cremation creates less financial pressure</h2>

      <p>
        Cremation often creates less pressure when it avoids cemetery costs,
        burial vaults, caskets, grave opening and closing fees, headstone costs,
        embalming, and a full traditional viewing. Direct cremation with a
        separate memorial can be one of the most financially flexible options.
      </p>

      <p>
        Cremation is especially worth comparing when the burial plan would
        require high-interest debt, reduce emergency savings below the household
        target, or depend on family reimbursement that is not confirmed.
      </p>
    </section>

    <section class="content-section">
      <h2>When burial may still be worth the cost</h2>

      <p>
        Burial may be worth the higher cost when it reflects the person's clear
        wishes, religious practice, family tradition, cemetery ownership, a
        prepaid arrangement, or insurance money specifically intended for that
        purpose.
      </p>

      <p>
        The warning sign is not burial itself. The warning sign is choosing a
        higher-cost burial because of guilt, pressure, unclear pricing, or fear
        of judgment when the cost would create long-term harm for the household.
      </p>
    </section>

    <section class="content-section" id="ReduceCostTips">
      <h2>Ways to reduce funeral or cremation costs before deciding</h2>

      <p>
        If the calculator shows moderate or high pressure, the next step is not
        automatically "choose the cheapest option." The next step is to compare
        the specific line items and keep the parts that matter most.
      </p>

      <ul class="check-list">
        {reduceCostTips.map((tip) => <li>{tip}</li>)}
      </ul>
    </section>

    <section class="content-section" id="FinancialRedFlags">
      <h2>Financial red flags in a burial vs. cremation decision</h2>

      <p>
        These warning signs mean the family should slow down, request itemized
        pricing, compare lower-cost versions, and avoid letting pressure create
        avoidable debt.
      </p>

      <ul class="red-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>

      <div class="callout warning-box">
        <p>
          Be careful when the higher-cost option depends on money that has not
          arrived yet. Expected reimbursement and cash available today are not
          the same thing.
        </p>
      </div>
    </section>

    <section class="content-section">
      <h2>How to compare options before you decide</h2>

      <p>
        Ask funeral homes for itemized pricing, compare at least two providers
        when time allows, separate required costs from optional upgrades, confirm
        insurance timing, and ask family members for specific contributions
        before choosing a package.
      </p>

      <p>
        It can help to price three versions: direct cremation with a family
        memorial, cremation with a formal service, and traditional burial.
        Seeing the gap side by side can make the final decision calmer and less
        driven by pressure.
      </p>
    </section>

    <section class="content-section" id="CalculatorAssumptions">
      <h2>Calculator assumptions</h2>

      <ul>
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="content-section">
      <h2>Decision guide: what to do with your result</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Both options are low pressure</h3>
          <p>The decision can focus more on the person's wishes, faith, family needs, and emotional preference.</p>
        </div>

        <div class="info-card">
          <h3>Cremation is much lower pressure</h3>
          <p>Compare direct cremation or cremation with memorial before committing to a higher-cost burial plan.</p>
        </div>

        <div class="info-card">
          <h3>Both options are high pressure</h3>
          <p>Reduce the service cost, seek confirmed help, delay optional expenses, or avoid high-interest debt.</p>
        </div>
      </div>
    </section>

    <section class="content-section" id="RelatedCalculators">
      <h2>Related funeral and financial calculators</h2>

      <div class="link-grid">
        {relatedCalculators.map((calculator) => (
          <a class="link-card" href={calculator.href}>
            <strong>{calculator.title}</strong>
            <span>{calculator.body}</span>
          </a>
        ))}
      </div>
    </section>

    <FAQSection title="Funeral vs. Cremation Cost FAQ" faqs={funeralFaqs} />
  </main>

  <script>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const formatCurrency = (value) => {
      const safeValue = Number.isFinite(value) ? value : 0;
      return safeValue.toLocaleString(undefined, {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
    };

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action:
            "Choose the option that fits the person's wishes while keeping the plan itemized and controlled.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action:
            "Compare direct cremation, simpler services, and family contributions before committing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action:
          "Avoid high-interest debt; reduce the funeral cost, seek help, or choose a lower-pressure option.",
      };
    }

    function calculatePressureScore(outOfPocket, savings, income, debt, emergencyTarget) {
      const savingsAfter = savings - outOfPocket;
      const savingsImpact = savings > 0 ? (outOfPocket / savings) * 100 : outOfPocket > 0 ? 150 : 0;
      const monthlyIncomeImpact = income > 0 ? (outOfPocket / income) * 100 : outOfPocket > 0 ? 300 : 0;
      const debtPaymentRatio = income > 0 ? (debt / income) * 100 : debt > 0 ? 100 : 0;

      const fullyCovered = outOfPocket <= 0;

      const tinyUncoveredCost =
        outOfPocket > 0 &&
        outOfPocket <= Math.max(100, income * 0.02) &&
        savingsAfter >= 0 &&
        debtPaymentRatio <= 10;

      const hugeSavings =
        outOfPocket > 0 &&
        savingsAfter >= Math.max(emergencyTarget, income * 6, outOfPocket * 20);

      const hugeIncome =
        outOfPocket > 0 &&
        income > 0 &&
        monthlyIncomeImpact <= 2 &&
        debtPaymentRatio <= 5 &&
        savingsAfter >= 0;

      let pressureScore = 0;

      if (fullyCovered || tinyUncoveredCost || hugeSavings || hugeIncome) {
        return 0;
      }

      pressureScore += clamp(savingsImpact * 0.42, 0, 38);
      pressureScore += clamp(monthlyIncomeImpact * 0.3, 0, 30);
      pressureScore += clamp(debtPaymentRatio * 0.34, 0, 20);

      if (outOfPocket > savings) pressureScore += 24;

      if (savingsAfter < 0) {
        pressureScore += 24;
      } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget * 0.5) {
        pressureScore += 16;
      } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget) {
        pressureScore += 9;
      } else if (emergencyTarget > 0 && savingsAfter >= emergencyTarget * 2.5) {
        pressureScore -= 12;
      } else if (income > 0 && savingsAfter >= income * 6) {
        pressureScore -= 10;
      }

      if (monthlyIncomeImpact > 300) pressureScore += 18;
      else if (monthlyIncomeImpact > 200) pressureScore += 12;
      else if (monthlyIncomeImpact > 100) pressureScore += 6;

      if (debtPaymentRatio >= 45) pressureScore += 14;
      else if (debtPaymentRatio >= 30) pressureScore += 9;
      else if (debtPaymentRatio >= 20) pressureScore += 4;

      if (
        outOfPocket > 0 &&
        savingsImpact <= 0.5 &&
        monthlyIncomeImpact <= 5 &&
        savingsAfter >= Math.max(emergencyTarget, 0)
      ) {
        pressureScore = Math.min(pressureScore, 3);
      } else if (
        outOfPocket > 0 &&
        savingsImpact <= 1 &&
        monthlyIncomeImpact <= 10 &&
        savingsAfter >= Math.max(emergencyTarget, income * 3)
      ) {
        pressureScore = Math.min(pressureScore, 8);
      } else if (
        outOfPocket > 0 &&
        savingsImpact <= 3 &&
        monthlyIncomeImpact <= 20 &&
        savingsAfter >= Math.max(emergencyTarget, 0)
      ) {
        pressureScore = Math.min(pressureScore, 15);
      }

      return clamp(Math.round(pressureScore), 0, 100);
    }

    const button = document.getElementById("calculateButton");
    const result = document.getElementById("result");
    const scoreText = document.getElementById("scoreText");
    const scoreFill = document.getElementById("scoreFill");
    const resultDetails = document.getElementById("resultDetails");
    const guidance = document.getElementById("guidance");

    button?.addEventListener("click", () => {
      const burialCost = getNumber("burialCost");
      const cremationCost = getNumber("cremationCost");
      const savings = getNumber("savings");
      const help = getNumber("help");
      const income = getNumber("income");
      const debt = getNumber("debt");
      const emergencyTarget = getNumber("emergencyTarget");

      result?.classList.add("visible");

      if (burialCost <= 0 || cremationCost <= 0) {
        scoreText.textContent = "Add both funeral options first";
        scoreFill.style.width = "0%";
        scoreFill.className = "fill safe";
        resultDetails.innerHTML = `
          <div class="result-metric">
            <strong>Missing comparison</strong>
            <span>Enter both burial and cremation costs so the calculator can compare pressure.</span>
          </div>
        `;
        guidance.textContent = "";
        return;
      }

      const burialOutOfPocket = Math.max(burialCost - help, 0);
      const cremationOutOfPocket = Math.max(cremationCost - help, 0);
      const costDifference = Math.abs(burialCost - cremationCost);

      const burialScore = calculatePressureScore(
        burialOutOfPocket,
        savings,
        income,
        debt,
        emergencyTarget
      );

      const cremationScore = calculatePressureScore(
        cremationOutOfPocket,
        savings,
        income,
        debt,
        emergencyTarget
      );

      const lowerOption =
        cremationCost < burialCost
          ? "cremation or memorial plan"
          : "traditional funeral or burial plan";

      const recommendedScore = Math.min(burialScore, cremationScore);
      const level = getPressureLevel(recommendedScore);

      scoreText.textContent = `${level.label}  -  ${recommendedScore}/100`;
      scoreFill.style.width = `${recommendedScore}%`;
      scoreFill.className = `fill ${level.colorClass}`;

      const burialSavingsAfter = savings - burialOutOfPocket;
      const cremationSavingsAfter = savings - cremationOutOfPocket;
      const debtRatio = income > 0 ? (debt / income) * 100 : debt > 0 ? 100 : 0;

      resultDetails.innerHTML = `
        <div class="result-metric"><strong>Lower-cost option</strong><span>The ${lowerOption} is lower by ${formatCurrency(costDifference)}.</span></div>
        <div class="result-metric"><strong>Burial out-of-pocket cost</strong><span>${formatCurrency(burialOutOfPocket)} after insurance, prepaid funds, estate cash, or family help.</span></div>
        <div class="result-metric"><strong>Burial pressure score</strong><span>${burialScore}/100.</span></div>
        <div class="result-metric"><strong>Savings after burial</strong><span>${formatCurrency(burialSavingsAfter)}.</span></div>
        <div class="result-metric"><strong>Cremation out-of-pocket cost</strong><span>${formatCurrency(cremationOutOfPocket)} after insurance, prepaid funds, estate cash, or family help.</span></div>
        <div class="result-metric"><strong>Cremation pressure score</strong><span>${cremationScore}/100.</span></div>
        <div class="result-metric"><strong>Savings after cremation</strong><span>${formatCurrency(cremationSavingsAfter)}.</span></div>
        <div class="result-metric"><strong>Monthly debt pressure</strong><span>${income > 0 ? `${debtRatio.toFixed(1)}% of monthly take-home income.` : "Enter income to estimate debt pressure."}</span></div>
      `;

      if (recommendedScore === 0) {
        guidance.textContent =
          `The lower-pressure option creates essentially no measurable financial pressure based on the numbers provided. Recommended next step: ${level.action}`;
      } else if (burialScore - cremationScore >= 25) {
        guidance.textContent =
          `Cremation appears to reduce financial pressure meaningfully in this scenario. The score gap is large enough that the family should seriously compare direct cremation, cremation with a memorial, or a smaller service before committing to the higher-cost plan. Recommended next step: ${level.action}`;
      } else if (cremationScore - burialScore >= 25) {
        guidance.textContent =
          `The traditional funeral or burial plan appears to create less pressure in this scenario because of the numbers entered. Confirm that all cemetery and service costs are included before relying on that result. Recommended next step: ${level.action}`;
      } else if (burialScore <= 30 && cremationScore <= 30) {
        guidance.textContent =
          `Both options appear financially manageable based on the numbers provided. The decision may come down more to the person's wishes, family needs, faith, culture, and emotional preference than strict affordability. Recommended next step: ${level.action}`;
      } else if (recommendedScore <= 60) {
        guidance.textContent =
          `The lower-cost option may be workable, but it still deserves caution. Compare itemized prices, protect emergency savings, and avoid letting family pressure push the plan beyond what the household can absorb. Recommended next step: ${level.action}`;
      } else {
        guidance.textContent =
          `Even the lower-cost option could create real financial strain based on the numbers provided. Reducing the service cost, seeking family help, confirming insurance timing, or avoiding high-interest debt would be safer. Recommended next step: ${level.action}`;
      }
    });
  </script>
</Layout>
