---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const funeralFaqs = [
  {
    question: "Is cremation cheaper than burial?",
    answer:
      "Direct cremation is usually cheaper than traditional burial, but cremation with a full memorial, reception, obituary, flowers, urn, and travel can still become expensive.",
  },
  {
    question: "How do I compare funeral and cremation costs?",
    answer:
      "Compare the full out-of-pocket cost after insurance, family help, cemetery fees, funeral home charges, service costs, reception costs, and emergency savings impact.",
  },
  {
    question: "Should I choose cremation to save money?",
    answer:
      "Cremation can reduce financial pressure, especially when burial would create debt or drain savings. But family wishes, faith, culture, and the person’s preferences also matter.",
  },
  {
    question: "What is the cheapest respectful funeral option?",
    answer:
      "Direct cremation with a family-hosted memorial is often one of the lowest-cost respectful options, but the right choice depends on local pricing, family needs, and available support.",
  },
];
---

<Layout
  title="Funeral vs. Cremation Cost Calculator"
  description="Compare funeral and cremation costs, burial expenses, savings impact, insurance help, family contributions, debt risk, and emergency fund pressure."
>
  <style>
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.7rem, 7vw, 4.8rem);
      line-height: 0.95;
      margin-bottom: 24px;
      color: #0f172a;
      max-width: 900px;
    }

    .intro {
      max-width: 820px;
      color: #334155;
      font-size: 1.12rem;
      line-height: 1.85;
      margin-bottom: 48px;
    }

    .calculator-box,
    .info-card,
    .link-card,
    .callout {
      border: 1px solid #dbe4ee;
      background: white;
      border-radius: 22px;
      padding: 26px;
    }

    .calculator-box {
      margin-bottom: 56px;
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .calculator-box h2,
    .content-section h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-box p,
    .content-section p,
    .content-section li {
      color: #334155;
      line-height: 1.9;
      font-size: 1.06rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-top: 22px;
    }

    label {
      display: block;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 8px;
      font-size: 0.95rem;
    }

    input {
      width: 100%;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 13px;
      font-size: 1rem;
      box-sizing: border-box;
    }

    button {
      margin-top: 24px;
      border: none;
      border-radius: 999px;
      padding: 15px 24px;
      background: #0f766e;
      color: white;
      font-weight: 900;
      font-size: 1rem;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 32px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 32px;
      display: none;
    }

    .result.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin-bottom: 12px;
    }

    .guidance {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #dbe4ee;
      color: #0f172a;
      font-size: 1.08rem;
      line-height: 1.8;
    }

    .fine-print {
      color: #64748b;
      font-size: 0.9rem;
      margin-top: 20px;
    }

    .content-section {
      margin-top: 72px;
    }

    .content-section h3 {
      font-size: 1.3rem;
      color: #0f172a;
      margin: 28px 0 12px;
    }

    .info-grid,
    .link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 28px;
    }

    .info-card h3 {
      margin-top: 0;
    }

    .info-card p,
    .link-card span {
      margin: 0;
      color: #334155;
      line-height: 1.7;
      font-size: 0.96rem;
    }

    .link-card {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .link-card strong {
      display: block;
      color: #0f172a;
      margin-bottom: 8px;
      line-height: 1.3;
    }

    .callout {
      background: #f8fafc;
      margin-top: 28px;
    }
  </style>

  <main class="container">
    <div class="eyebrow">Funeral vs. Cremation Calculator</div>

    <h1>Funeral vs. Cremation Cost Calculator</h1>

    <p class="intro">
      Burial and cremation can create very different financial pressure. This
      calculator compares a traditional funeral or burial plan against a
      cremation plan using savings, insurance help, family contributions, income,
      debt, and emergency fund protection.
    </p>

    <section class="calculator-box">
      <h2>Compare Funeral and Cremation Costs</h2>

      <p>
        Enter the estimated burial or funeral cost, estimated cremation cost,
        available savings, insurance or family help, income, debt payments, and
        the emergency cushion you want left afterward.
      </p>

      <div class="form-grid">
        <div>
          <label for="burialCost">Traditional funeral or burial cost</label>
          <input id="burialCost" type="number" placeholder="Example: 15000" />
        </div>

        <div>
          <label for="cremationCost">Cremation or memorial cost</label>
          <input id="cremationCost" type="number" placeholder="Example: 5000" />
        </div>

        <div>
          <label for="savings">Current liquid savings</label>
          <input id="savings" type="number" placeholder="Example: 20000" />
        </div>

        <div>
          <label for="help">Insurance or family help</label>
          <input id="help" type="number" placeholder="Example: 3000" />
        </div>

        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 6500" />
        </div>

        <div>
          <label for="debt">Monthly debt payments</label>
          <input id="debt" type="number" placeholder="Example: 900" />
        </div>

        <div>
          <label for="emergencyTarget">Minimum savings you want left afterward</label>
          <input id="emergencyTarget" type="number" placeholder="Example: 12000" />
        </div>
      </div>

      <button id="calculateButton" type="button">Compare Funeral Options</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="fill" id="scoreFill"></div>
        </div>

        <div class="result-details" id="resultDetails"></div>

        <div class="guidance" id="guidance"></div>

        <div class="fine-print">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>When Cremation Creates Less Financial Pressure</h2>

      <p>
        Cremation often creates less pressure when it avoids cemetery costs,
        burial vaults, caskets, grave opening and closing fees, headstone costs,
        embalming, and a full traditional viewing. Direct cremation with a
        separate memorial can be one of the most financially flexible options.
      </p>

      <p>
        That does not mean cremation is always the right choice. The person’s
        wishes, family beliefs, religion, culture, and emotional needs matter.
        The point is to understand the financial difference before urgency,
        grief, or family pressure turns into avoidable debt.
      </p>

      <div class="callout">
        <p>
          The best option is not always the cheapest option. It is the option
          that honors the person while keeping the family financially stable.
        </p>
      </div>
    </section>

    <section class="content-section">
      <h2>What This Funeral vs. Cremation Calculator Considers</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Total Cost Difference</h3>
          <p>
            The calculator compares the estimated burial or funeral cost against
            the cremation or memorial cost so the family can see the actual
            dollar gap.
          </p>
        </div>

        <div class="info-card">
          <h3>Out-of-Pocket Cost</h3>
          <p>
            Insurance, prepaid funds, employer benefits, estate money, and family
            contributions can change the real amount that must come from savings
            or debt.
          </p>
        </div>

        <div class="info-card">
          <h3>Emergency Savings Impact</h3>
          <p>
            A lower-cost cremation plan may be safer if it preserves cash for
            housing, food, transportation, medical needs, repairs, and another
            emergency.
          </p>
        </div>

        <div class="info-card">
          <h3>Debt Risk</h3>
          <p>
            Burial becomes riskier when the higher cost requires credit cards,
            personal loans, funeral financing, or one person carrying the bill
            alone.
          </p>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>Costs That Often Make Burial More Expensive</h2>

      <p>
        Traditional burial can be meaningful, but it often includes more cost
        layers. Some are required by the plan, while others are optional upgrades
        that families may choose under emotional pressure.
      </p>

      <ul>
        <li>Casket, burial vault, grave liner, or cemetery requirements</li>
        <li>Cemetery plot, grave opening and closing, marker, or headstone</li>
        <li>Embalming, viewing, body preparation, dressing, and cosmetics</li>
        <li>Funeral home staff, ceremony, transportation, and service vehicles</li>
        <li>Flowers, obituary placement, printed programs, and livestreaming</li>
        <li>Reception, catering, venue, clergy, music, travel, and lodging</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Costs That Can Still Make Cremation Expensive</h2>

      <p>
        Cremation is not automatically cheap. A cremation plan can become costly
        when the family adds a viewing, formal service, premium urn, obituary,
        flowers, reception, keepsakes, travel, or cemetery burial of ashes.
      </p>

      <p>
        The key distinction is direct cremation versus cremation with a full
        memorial package. Direct cremation is usually the lower-cost baseline.
        Cremation with a large service can start to look much closer to a
        traditional funeral budget.
      </p>
    </section>

    <section class="content-section">
      <h2>When Burial May Still Be Worth the Cost</h2>

      <p>
        Burial may be worth the higher cost when it reflects the person’s clear
        wishes, family tradition, religious practice, cemetery ownership, a
        prepaid plan, or insurance money specifically intended for that purpose.
      </p>

      <p>
        The warning sign is not burial itself. The warning sign is choosing
        burial because of guilt, pressure, unclear pricing, or fear of judgment
        when the cost would create long-term financial harm for the household.
      </p>
    </section>

    <section class="content-section">
      <h2>How to Compare Options Before You Decide</h2>

      <p>
        Ask funeral homes for itemized pricing, compare at least two providers
        when time allows, separate required costs from optional upgrades, confirm
        insurance timing, and ask family members for specific contributions
        before choosing a package.
      </p>

      <p>
        It can also help to price three versions: direct cremation with a family
        memorial, cremation with a formal service, and traditional burial. Seeing
        the gap side by side can make the final decision calmer and less driven
        by pressure.
      </p>
    </section>

    <section class="content-section">
      <h2>Related Funeral and Financial Calculators</h2>

      <div class="link-grid">
        <a class="link-card" href="/funeral-calculators">
          <strong>Funeral Cost Calculators</strong>
          <span>
            Compare funeral, cremation, burial, insurance, savings, and debt
            decisions in one cluster.
          </span>
        </a>

        <a class="link-card" href="/should-i-spend-5000-on-a-funeral">
          <strong>$5,000 Funeral Calculator</strong>
          <span>
            Estimate pressure from a smaller cremation or memorial budget.
          </span>
        </a>

        <a class="link-card" href="/should-i-spend-10000-on-a-funeral">
          <strong>$10,000 Funeral Calculator</strong>
          <span>
            Test a common funeral budget against savings, income, help, and debt.
          </span>
        </a>

        <a class="link-card" href="/should-i-spend-20000-on-a-funeral">
          <strong>$20,000 Funeral Calculator</strong>
          <span>
            Compare a higher-cost traditional burial or full-service funeral.
          </span>
        </a>

        <a class="link-card" href="/should-i-use-savings-for-funeral-costs">
          <strong>Use Savings for Funeral Costs?</strong>
          <span>
            Decide whether paying from savings protects the family or drains too
            much emergency cushion.
          </span>
        </a>

        <a class="link-card" href="/how-much-debt-is-too-much">
          <strong>Debt Pressure Calculator</strong>
          <span>
            Check whether funeral borrowing would add too much pressure to the
            household budget.
          </span>
        </a>

        <a class="link-card" href="/calculators">
          <strong>All Financial Calculators</strong>
          <span>
            Browse all ShouldISpend calculators for groceries, weddings, cars,
            travel, rent, medical costs, and major expenses.
          </span>
        </a>
      </div>
    </section>

    <FAQSection title="Funeral vs. Cremation Cost FAQ" faqs={funeralFaqs} />
  </main>

  <script>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action: "Choose the option that fits the person’s wishes while keeping the plan itemized and controlled.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action: "Compare direct cremation, simpler services, and family contributions before committing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action: "Avoid high-interest debt; reduce the funeral cost, seek help, or choose a lower-pressure option.",
      };
    }

    function calculatePressureScore(outOfPocket, savings, income, debt, emergencyTarget) {
      const savingsAfter = savings - outOfPocket;
      const savingsImpact = savings > 0 ? (outOfPocket / savings) * 100 : 150;
      const monthlyIncomeImpact = (outOfPocket / income) * 100;
      const debtPaymentRatio = income > 0 ? (debt / income) * 100 : 100;

      let pressureScore = 0;

      const hasAbsurdSavings =
        savings >= outOfPocket * 100 &&
        savingsAfter >= Math.max(emergencyTarget, income * 6);

      const hasAbsurdIncome =
        outOfPocket > 0 &&
        monthlyIncomeImpact <= 2 &&
        debtPaymentRatio <= 5 &&
        savingsAfter >= 0;

      const fullyCovered = outOfPocket <= 0;

      if (fullyCovered || hasAbsurdSavings || hasAbsurdIncome) {
        return 0;
      }

      pressureScore += clamp(savingsImpact * 0.45, 0, 38);
      pressureScore += clamp(monthlyIncomeImpact * 0.32, 0, 28);
      pressureScore += clamp(debtPaymentRatio * 0.3, 0, 18);

      if (outOfPocket > savings) pressureScore += 26;

      if (savingsAfter < 0) {
        pressureScore += 24;
      } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget * 0.5) {
        pressureScore += 14;
      } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget) {
        pressureScore += 7;
      } else if (emergencyTarget > 0 && savingsAfter >= emergencyTarget * 3) {
        pressureScore -= 12;
      } else if (savingsAfter >= income * 6) {
        pressureScore -= 10;
      }

      if (monthlyIncomeImpact > 300) pressureScore += 18;
      else if (monthlyIncomeImpact > 200) pressureScore += 12;
      else if (monthlyIncomeImpact > 100) pressureScore += 6;

      if (debtPaymentRatio >= 45) pressureScore += 14;
      else if (debtPaymentRatio >= 30) pressureScore += 9;
      else if (debtPaymentRatio >= 20) pressureScore += 4;

      if (
        monthlyIncomeImpact <= 2 &&
        debtPaymentRatio <= 5 &&
        savingsAfter >= 0
      ) {
        pressureScore = 0;
      } else if (
        savingsImpact <= 0.5 &&
        monthlyIncomeImpact <= 5 &&
        savingsAfter >= emergencyTarget
      ) {
        pressureScore = Math.min(pressureScore, 3);
      } else if (
        savingsImpact <= 1 &&
        monthlyIncomeImpact <= 10 &&
        savingsAfter >= Math.max(emergencyTarget, income * 3)
      ) {
        pressureScore = Math.min(pressureScore, 8);
      } else if (
        savingsImpact <= 3 &&
        monthlyIncomeImpact <= 20 &&
        savingsAfter >= emergencyTarget
      ) {
        pressureScore = Math.min(pressureScore, 15);
      }

      return clamp(Math.round(pressureScore), 0, 100);
    }

    const button = document.getElementById("calculateButton");
    const result = document.getElementById("result");
    const scoreText = document.getElementById("scoreText");
    const scoreFill = document.getElementById("scoreFill");
    const resultDetails = document.getElementById("resultDetails");
    const guidance = document.getElementById("guidance");

    button?.addEventListener("click", () => {
      const burialCost = getNumber("burialCost");
      const cremationCost = getNumber("cremationCost");
      const savings = getNumber("savings");
      const help = getNumber("help");
      const income = getNumber("income");
      const debt = getNumber("debt");
      const emergencyTarget = getNumber("emergencyTarget");

      result?.classList.add("visible");

      if (burialCost <= 0 || cremationCost <= 0 || income <= 0) {
        scoreText.textContent = "Add your numbers first";
        scoreFill.style.width = "0%";
        scoreFill.className = "fill safe";
        resultDetails.innerHTML =
          "<p>Enter positive funeral, cremation, and monthly income numbers so the calculator can compare financial pressure.</p>";
        guidance.textContent = "";
        return;
      }

      const burialOutOfPocket = Math.max(burialCost - help, 0);
      const cremationOutOfPocket = Math.max(cremationCost - help, 0);
      const lowerCost = Math.min(burialCost, cremationCost);
      const higherCost = Math.max(burialCost, cremationCost);
      const costDifference = Math.abs(burialCost - cremationCost);

      const burialScore = calculatePressureScore(
        burialOutOfPocket,
        savings,
        income,
        debt,
        emergencyTarget
      );

      const cremationScore = calculatePressureScore(
        cremationOutOfPocket,
        savings,
        income,
        debt,
        emergencyTarget
      );

      const lowerOption =
        cremationCost < burialCost
          ? "cremation or memorial plan"
          : "traditional funeral or burial plan";

      const recommendedScore = Math.min(burialScore, cremationScore);
      const level = getPressureLevel(recommendedScore);

      scoreText.textContent = `${level.label} — ${recommendedScore}/100`;
      scoreFill.style.width = `${recommendedScore}%`;
      scoreFill.className = `fill ${level.colorClass}`;

      const burialSavingsAfter = savings - burialOutOfPocket;
      const cremationSavingsAfter = savings - cremationOutOfPocket;

      resultDetails.innerHTML = `
        <p><strong>Lower-cost option:</strong> The ${lowerOption} is lower by $${costDifference.toLocaleString()}.</p>
        <p><strong>Traditional funeral or burial cost:</strong> $${burialCost.toLocaleString()} total, with $${burialOutOfPocket.toLocaleString()} estimated out of pocket after help.</p>
        <p><strong>Burial pressure score:</strong> ${burialScore}/100.</p>
        <p><strong>Estimated savings after burial:</strong> $${burialSavingsAfter.toLocaleString()}.</p>
        <p><strong>Cremation or memorial cost:</strong> $${cremationCost.toLocaleString()} total, with $${cremationOutOfPocket.toLocaleString()} estimated out of pocket after help.</p>
        <p><strong>Cremation pressure score:</strong> ${cremationScore}/100.</p>
        <p><strong>Estimated savings after cremation:</strong> $${cremationSavingsAfter.toLocaleString()}.</p>
        <p><strong>Monthly debt pressure:</strong> ${((debt / income) * 100).toFixed(1)}% of monthly take-home income.</p>
      `;

      if (recommendedScore === 0) {
        guidance.textContent =
          `The lower-pressure option creates essentially no measurable financial pressure based on the numbers provided. Cost still matters, but the out-of-pocket amount is extremely small relative to savings or income. Recommended next step: ${level.action}`;
      } else if (burialScore - cremationScore >= 25) {
        guidance.textContent =
          `Cremation appears to reduce financial pressure meaningfully in this scenario. The score gap is large enough that the family should seriously compare direct cremation, cremation with a memorial, or a smaller service before committing to the higher-cost plan. Recommended next step: ${level.action}`;
      } else if (burialScore <= 30 && cremationScore <= 30) {
        guidance.textContent =
          `Both options appear financially manageable based on the numbers provided. The decision may come down more to the person’s wishes, family needs, faith, culture, and emotional preference than strict affordability. Recommended next step: ${level.action}`;
      } else if (recommendedScore <= 60) {
        guidance.textContent =
          `The lower-cost option may be workable, but it still deserves caution. Compare itemized prices, protect emergency savings, and avoid letting family pressure push the plan beyond what the household can absorb. Recommended next step: ${level.action}`;
      } else {
        guidance.textContent =
          `Even the lower-cost option could create real financial strain based on the numbers provided. Reducing the service cost, seeking family help, confirming insurance timing, or avoiding high-interest debt would be safer. Recommended next step: ${level.action}`;
      }
    });
  </script>
</Layout>