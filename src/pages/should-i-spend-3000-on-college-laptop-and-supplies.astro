---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import { calculators } from "../data/calculators.js";

const laptopFaqs = [
  {
    question: "Is $3,000 too much to spend on a college laptop and supplies?",
    answer:
      "$3,000 can make sense for majors that require specific hardware, software, design tools, engineering programs, or lab supplies. It is harder to justify when a basic laptop, used device, campus lab, or refurbished option would work.",
  },
  {
    question: "Is this calculator for the student or the parent?",
    answer:
      "It is for whoever is paying for the laptop and supplies. That may be the student, a parent, or both. Use the income, savings, aid, and debt that will actually support the purchase.",
  },
  {
    question: "Should I include a financial aid refund?",
    answer:
      "Yes. Include aid refunds, scholarships, 529 funds, family help, or school technology grants that can be used for the laptop and supplies.",
  },
  {
    question: "Should I buy a used or refurbished laptop for college?",
    answer:
      "A used or refurbished laptop can make sense if it meets the school's requirements and has enough warranty protection. It is riskier for majors that require high-performance specs or software compatibility.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "College" &&
      calculator.href !== "/should-i-spend-3000-on-college-laptop-and-supplies"
  )
  .slice(0, 6);
---

<Layout
  title="Should I Spend $3,000 on a College Laptop and Supplies?"
  description="Evaluate whether spending $3,000 on a college laptop and supplies makes sense based on major requirements, specs, used options, aid refunds, savings, income, debt, and necessity."
>

    <OmniStyleReviewBlock
      pageName="the $3,000 college laptop and supplies calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="$3,000 college laptop and supplies cost, major requirements, specs, used options, aid refunds, savings, student income, debt, necessity, and whether the purchase supports the degree path"
    />

    <CorePageExamplesBlock
      title="$3,000 college laptop and supplies examples"
      intro="A college laptop can be necessary, but the right budget depends on major requirements, expected lifespan, aid, savings, and whether cheaper options would still work."
      useCases={[
          "You are deciding whether $3,000 in college tech and supplies is reasonable.",
          "You need to include laptop specs, software, books, accessories, and used options.",
          "You want to compare the purchase with aid refunds, savings, income, and loans."
        ]}
      notEnough={[
          "You need device recommendations or technical specs for a specific major.",
          "You need financial-aid, tax, or student-loan advice.",
          "You need warranty, repair, or campus IT guidance."
        ]}
      examples={[
          {
            label: "Major requires high specs",
            takeaway: "Pressure may be lower if the device is necessary for coursework and lasts several years."
          },
          {
            label: "General-use student",
            takeaway: "A cheaper laptop may be enough if the major has modest requirements."
          },
          {
            label: "Purchase funded by loans",
            takeaway: "Pressure rises if optional upgrades add unnecessary debt."
          }
        ]}
      commonMistake="Buying premium tech before confirming actual major, software, and campus requirements."
      nextStep="Check required specs first, then compare new, refurbished, used, and campus-supported options."
    />


  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro,
    .annual-note {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .annual-note {
      background: #ecfeff;
      border: 1px solid #99f6e4;
      border-radius: 18px;
      padding: 18px 20px;
      font-weight: 800;
      color: #115e59;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }

    .field-hint {
      display: block;
      margin-top: 8px;
      color: #64748b;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a,
    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .helper-link a:hover,
    .content-link:hover {
      text-decoration: underline;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .guidance {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid #dbe4ee;
      font-size: 1.12rem;
      line-height: 1.85;
      color: #1e293b;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
    }

    .pillar-card {
      display: block;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 24px;
      margin-top: 28px;
      text-decoration: none;
      transition: transform 0.15s ease;
    }

    .pillar-card:hover {
      transform: translateY(-2px);
    }

    .pillar-card strong {
      display: block;
      margin-bottom: 10px;
      color: #0f172a;
      font-size: 1.08rem;
    }

    .pillar-card span {
      color: #334155;
      line-height: 1.7;
      font-size: 0.98rem;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="College Supplies Calculator"
      title="Should I Spend $3,000 on a College Laptop and Supplies?"
      description="Pressure-test a college laptop and supply purchase against major requirements, specs, refurbished options, aid refunds, savings, income, debt, and necessity."
    >
      <div class="calculator">
        <h2>$3,000 College Laptop and Supplies Pressure Verdict</h2>

        <p class="calculator-intro">
          A college laptop can be essential, but a premium setup is not always
          necessary. This calculator tests whether the laptop and supplies are
          required, whether cheaper options would work, and whether the purchase
          fits the money actually supporting college.
        </p>

        <div class="annual-note">
          Important: this evaluates one laptop-and-supplies purchase, not the
          total cost of college.
        </div>

        <div class="grid">
          <div class="field">
            <label for="supplyCost">Laptop and Supplies Cost</label>
            <input id="supplyCost" type="number" value="3000" placeholder="Example: 3000" />
          </div>

          <div class="field">
            <label for="income">Monthly Take-Home Income Supporting This Purchase</label>
            <input id="income" type="number" placeholder="Example: 6500" />
            <span class="field-hint">Use student income, parent income, or both  -  only if it will help pay.</span>
          </div>

          <div class="field">
            <label for="savings">Savings Available for College Supplies</label>
            <input id="savings" type="number" placeholder="Example: 5000" />
          </div>

          <div class="field">
            <label for="emergencyFund">Emergency Fund After Supply Savings</label>
            <input id="emergencyFund" type="number" placeholder="Example: 6000" />
          </div>

          <div class="field">
            <label for="monthlyDebt">Current Monthly Debt Payments</label>
            <input id="monthlyDebt" type="number" placeholder="Example: 350" />
            <div class="helper-link">
              Not sure what counts as debt?
              <a href="/what-counts-as-debt/">Read the debt guide</a>
            </div>
          </div>

          <div class="field">
            <label for="borrowed">Amount Borrowed for Laptop / Supplies</label>
            <input id="borrowed" type="number" placeholder="Example: 1000" />
            <div class="helper-link">
              Testing the loan side?
              <a href="/should-i-take-out-student-loans/">Use the student loan calculator</a>
            </div>
          </div>

          <div class="field">
            <label for="aid">Aid Refund / Scholarship Covering Supplies</label>
            <input id="aid" type="number" placeholder="Example: 750" />
          </div>

          <div class="field">
            <label for="outsideHelp">Reliable Family or Outside Help</label>
            <input id="outsideHelp" type="number" placeholder="Example: 500" />
          </div>

          <div class="field">
            <label for="cashUsed">Savings Used for Laptop / Supplies</label>
            <input id="cashUsed" type="number" placeholder="Example: 1200" />
          </div>

          <div class="field">
            <label for="majorRequirement">Major / Program Requirement</label>
            <select id="majorRequirement">
              <option value="strong">Required specs for major or software</option>
              <option value="medium" selected>Helpful but not strictly required</option>
              <option value="weak">Mostly preference or premium upgrade</option>
            </select>
          </div>

          <div class="field">
            <label for="cheaperAlternative">Cheaper Laptop Option</label>
            <select id="cheaperAlternative">
              <option value="none">No realistic cheaper option</option>
              <option value="weak">Cheaper option exists but has drawbacks</option>
              <option value="strong" selected>Good used/refurb/basic option exists</option>
            </select>
          </div>

          <div class="field">
            <label for="urgency">Purchase Need</label>
            <select id="urgency">
              <option value="strong">Needed now for classes, labs, or software</option>
              <option value="medium" selected>Useful soon but some flexibility</option>
              <option value="weak">Can wait or upgrade later</option>
            </select>
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="suppliesButton" type="button">Get Laptop and Supplies Verdict</button>

        <div class="results" id="results">
          <div class="score" id="scoreText"></div>
          <div class="bar">
            <div class="fill" id="fillBar"></div>
          </div>
          <div class="result-details" id="resultDetails"></div>
          <div class="guidance" id="guidance"></div>
          <div class="disclaimer">
            This is a general educational estimate, not personalized financial advice.
          </div>
        </div>
      </div>

      <section class="content-section">
        <h2>Start With What the Program Actually Requires</h2>

        <p>
          A $3,000 laptop and supply purchase should be judged against the
          student's real academic requirements. Some majors need specific
          processors, memory, graphics cards, tablets, software, lab kits, or
          design tools. Other students can complete coursework with a basic
          laptop, campus lab access, or a refurbished machine.
        </p>

        <p>
          The best question is not whether a premium laptop is nice to have. It
          is whether the purchase prevents real academic friction and fits the
          full college budget after aid, savings, and debt are considered.
        </p>

        <a class="pillar-card" href="/college-cost-calculator/">
          <strong>College Cost Calculator</strong>
          <span>
            Estimate total college pressure using tuition, fees, housing, food,
            books, supplies, loans, savings, aid, and expected payoff.
          </span>
        </a>

        <a class="pillar-card" href="/should-i-use-savings-for-college/">
          <strong>Should I Use Savings for College?</strong>
          <span>
            Test whether using savings reduces school debt or leaves too little
            emergency cushion after college costs.
          </span>
        </a>

        <a class="pillar-card" href="/should-i-take-out-student-loans/">
          <strong>Should I Take Out Student Loans?</strong>
          <span>
            Evaluate student loan affordability using payments, future income,
            current debt, savings cushion, and repayment risk.
          </span>
        </a>
      </section>

      <section class="content-section">
        <h2>What Laptop and Supply Costs Really Include</h2>

        <p>
          The laptop itself may not be the full cost. Students may also need a
          warranty, case, monitor, keyboard, mouse, docking station, printer,
          software subscriptions, calculator, tablet, headphones, cloud storage,
          lab materials, art supplies, or certification tools.
        </p>

        <p>
          Some purchases are durable and useful for several years. Others are
          premium upgrades that do not materially improve coursework. This
          calculator gives credit for real program requirements while penalizing
          unnecessary borrowing, weak savings, and premium-only upgrades.
        </p>
      </section>

      <WhenSpendingMakesSense
        title="When Spending $3,000 on a College Laptop and Supplies Can Make Sense"
        items={[
          "The major requires specific laptop specs, software, design tools, lab kits, or testing equipment.",
          "Aid refunds, scholarships, 529 funds, or reliable help cover most or all of the purchase.",
          "The device will realistically last through multiple school years.",
          "Borrowing is low or unnecessary.",
          "A cheaper used or refurbished option would not meet program requirements.",
          "Emergency savings remain protected after any cash contribution.",
        ]}
      />

      <KeyCostCategories
        items={[
          {
            title: "Laptop and hardware",
            description:
              "The main cost may include the computer, tablet, monitor, accessories, warranty, and required peripherals.",
          },
          {
            title: "Software and subscriptions",
            description:
              "Some majors require design software, coding tools, cloud storage, testing platforms, or paid academic programs.",
          },
          {
            title: "Course supplies",
            description:
              "Books, calculators, lab materials, art supplies, nursing kits, or certification materials can add to the total.",
          },
          {
            title: "Aid and outside help",
            description:
              "Aid refunds, scholarships, 529 funds, school technology grants, or family help can reduce the uncovered cost.",
          },
          {
            title: "Used or refurbished alternatives",
            description:
              "A cheaper option may be smart if it meets school requirements and has enough warranty protection.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Check the department's exact laptop specs before buying.",
          "Ask whether campus computer labs or loaner laptops can cover specialized software.",
          "Compare student discounts, refurbished models, open-box deals, and warranty coverage.",
          "Avoid buying premium specs that the major does not require.",
          "Separate required supplies from nice-to-have accessories.",
          "Avoid borrowing for upgrades if a basic or refurbished option would work.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "The purchase is mostly a premium upgrade while a cheaper laptop would meet requirements.",
          "The student is borrowing for accessories, aesthetics, or convenience instead of necessity.",
          "Savings would be drained below a basic emergency cushion.",
          "The school's actual technology requirements have not been checked.",
          "The laptop lacks warranty protection even though it must last several school years.",
          "Software, supplies, or course materials are being ignored while only the laptop price is considered.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "Monthly income means take-home pay, not gross income.",
          "This calculator evaluates one laptop-and-supplies purchase, not the full college cost.",
          "Aid refunds, scholarships, and outside help are treated as purchase-specific amounts.",
          "Estimated student loan payment uses a rough monthly payment equal to 1.2% of the borrowed amount.",
          "If aid and outside help fully cover the laptop and supplies, pressure can be 0/100.",
          "Huge income, huge savings, low debt, no borrowing, and strong affordability can produce 0/100 with no artificial minimum.",
        ]}
      />

      <section class="content-section">
        <h2>When the Cheaper Laptop Option Wins</h2>

        <p>
          A cheaper laptop may be the better move when the major has basic
          requirements, the student can use campus labs for specialized software,
          or a refurbished model can do the job with warranty protection.
        </p>

        <p>
          Saving even $500 or $1,000 can leave room for books, transportation,
          meal costs, emergency expenses, or future semesters. The more optional
          the upgrade is, the more the cheaper option deserves a serious look.
        </p>
      </section>

      <section class="content-section">
        <h2>What Your Laptop and Supplies Verdict Means</h2>

        <p>
          A low-pressure result means the purchase appears manageable based on
          the income, savings, aid, borrowing, and support entered. A moderate
          result means the purchase may still work, but used options, specs, and
          accessory choices should be reviewed first.
        </p>

        <p>
          A high-pressure result does not mean the student should go without a
          computer. It means this version of the purchase may need more aid, less
          borrowing, fewer premium accessories, or a cheaper device before it
          becomes financially durable.
        </p>
      </section>

      <div class="content-section">
        <FAQSection title="College Laptop and Supplies FAQ" faqs={laptopFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="college laptop and supplies affordability" updated="June 2026" />
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const getValue = (id) => document.getElementById(id)?.value || "";

    function formatDollars(value) {
      return `$${Math.round(value).toLocaleString()}`;
    }

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action:
            "Confirm program requirements, warranty coverage, and aid coverage, but the purchase appears manageable.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action:
            "Compare used, refurbished, student-discount, and lower-spec options before committing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action:
          "Reduce the purchase cost, avoid borrowing, buy used or refurbished, or build more cushion before committing.",
      };
    }

    function calculateSuppliesPressure() {
      const supplyCost = getNumber("supplyCost") || 3000;
      const income = getNumber("income");
      const savings = getNumber("savings");
      const emergencyFund = getNumber("emergencyFund");
      const monthlyDebt = getNumber("monthlyDebt");
      const requestedBorrowed = getNumber("borrowed");
      const aid = getNumber("aid");
      const outsideHelp = getNumber("outsideHelp");
      const requestedCashUsed = getNumber("cashUsed");
      const majorRequirement = getValue("majorRequirement") || "medium";
      const cheaperAlternative = getValue("cheaperAlternative") || "strong";
      const urgency = getValue("urgency") || "medium";

      const results = document.getElementById("results");
      const scoreText = document.getElementById("scoreText");
      const fillBar = document.getElementById("fillBar");
      const resultDetails = document.getElementById("resultDetails");
      const guidance = document.getElementById("guidance");

      results.classList.add("visible");

      if (supplyCost <= 0) {
        scoreText.textContent = "Add the laptop and supplies cost first";
        fillBar.style.width = "0%";
        fillBar.className = "fill safe";
        resultDetails.innerHTML =
          "<p>Enter the laptop and supplies cost to calculate pressure.</p>";
        guidance.textContent = "";
        return;
      }

      if (income <= 0 && savings <= 0 && aid <= 0 && outsideHelp <= 0) {
        scoreText.textContent = "Add your numbers first";
        fillBar.style.width = "0%";
        fillBar.className = "fill safe";
        resultDetails.innerHTML =
          "<p>Enter income, savings, aid, outside help, or borrowing that will support the laptop and supplies purchase.</p>";
        guidance.textContent = "";
        return;
      }

      const annualIncome = income * 12;
      const giftHelp = aid + outsideHelp;
      const uncoveredCost = Math.max(supplyCost - giftHelp, 0);

      const borrowed = Math.min(requestedBorrowed, uncoveredCost);
      const cashNeededAfterBorrowing = Math.max(uncoveredCost - borrowed, 0);
      const cashUsed =
        uncoveredCost <= 0
          ? 0
          : Math.min(
              requestedCashUsed > 0 ? requestedCashUsed : cashNeededAfterBorrowing,
              cashNeededAfterBorrowing
            );

      const remainingSavings = Math.max(savings - cashUsed, 0);
      const estimatedLoanPayment = borrowed > 0 ? borrowed * 0.012 : 0;

      const emergencyMonths = income > 0 ? emergencyFund / income : 0;
      const savingsMonthsAfter = income > 0 ? remainingSavings / income : 0;
      const totalLiquidMonthsAfter =
        income > 0 ? (remainingSavings + emergencyFund) / income : 0;

      const debtRatioAfter =
        income > 0 ? ((monthlyDebt + estimatedLoanPayment) / income) * 100 : 0;

      const uncoveredCostRatio =
        income > 0
          ? (uncoveredCost / Math.max(annualIncome, 1)) * 100
          : uncoveredCost > 0
            ? 100
            : 0;

      const cashUseRatio =
        cashUsed > 0 ? (cashUsed / Math.max(savings, 1)) * 100 : 0;

      const borrowedShare =
        borrowed > 0 && uncoveredCost > 0 ? (borrowed / uncoveredCost) * 100 : 0;

      let pressureScore = 0;
      let hardGateReason = "";

      if (uncoveredCost === 0) {
        pressureScore = 0;
        hardGateReason =
          "Aid and outside help fully cover the laptop and supplies purchase.";
      } else if (
        income >= supplyCost * 2 &&
        debtRatioAfter <= 10 &&
        borrowed <= income * 0.1
      ) {
        pressureScore = 0;
        hardGateReason =
          "Monthly take-home income is large enough that the uncovered laptop and supplies cost creates no meaningful pressure.";
      } else if (
        savings >= supplyCost * 20 &&
        remainingSavings >= supplyCost * 15
      ) {
        pressureScore = 0;
        hardGateReason =
          "Savings are large enough that the laptop and supplies purchase creates no meaningful pressure.";
      } else if (
        uncoveredCost <= income * 0.25 &&
        debtRatioAfter <= 10 &&
        borrowed === 0
      ) {
        pressureScore = 0;
        hardGateReason =
          "The uncovered laptop and supplies cost is less than one week of take-home income with no borrowing needed.";
      } else {
        pressureScore += clamp(uncoveredCostRatio * 1.7, 0, 28);
        pressureScore += clamp(cashUseRatio * 0.22, 0, 16);
        pressureScore += clamp(debtRatioAfter * 0.6, 0, 26);

        if (borrowed > 0) {
          pressureScore += clamp(borrowedShare * 0.14, 0, 14);
        }

        if (emergencyMonths < 1) {
          pressureScore += savings >= supplyCost * 5 ? 2 : 16;
        } else if (emergencyMonths < 3) {
          pressureScore += savings >= supplyCost * 5 ? 1 : 7;
        } else if (emergencyMonths >= 6) {
          pressureScore -= 8;
        }

        if (savingsMonthsAfter >= 24) pressureScore -= 18;
        else if (savingsMonthsAfter >= 12) pressureScore -= 12;
        else if (savingsMonthsAfter >= 6) pressureScore -= 6;
        else if (cashUsed > 0 && savingsMonthsAfter < 1) pressureScore += 12;

        if (majorRequirement === "strong") pressureScore -= 10;
        else if (majorRequirement === "weak") pressureScore += 8;

        if (cheaperAlternative === "strong") pressureScore += 8;
        else if (cheaperAlternative === "none") pressureScore -= 8;

        if (urgency === "strong") pressureScore -= 8;
        else if (urgency === "weak") pressureScore += 8;

        if (giftHelp >= supplyCost * 0.75) pressureScore -= 14;
        else if (giftHelp >= supplyCost * 0.5) pressureScore -= 10;
        else if (giftHelp >= supplyCost * 0.25) pressureScore -= 5;

        if (
          savings >= supplyCost * 12 &&
          remainingSavings >= supplyCost * 10 &&
          debtRatioAfter <= 12
        ) {
          pressureScore = Math.min(pressureScore, 5);
        }

        if (
          savings >= supplyCost * 8 &&
          remainingSavings >= supplyCost * 6 &&
          debtRatioAfter <= 15
        ) {
          pressureScore = Math.min(pressureScore, 10);
        }

        if (
          income >= supplyCost &&
          uncoveredCost <= income &&
          debtRatioAfter <= 12
        ) {
          pressureScore = Math.min(pressureScore, 5);
        }

        if (
          borrowed === 0 &&
          uncoveredCost <= income &&
          debtRatioAfter <= 10
        ) {
          pressureScore = Math.min(pressureScore, 3);
        }
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      scoreText.textContent = `${level.label}  -  ${pressureScore}/100`;
      fillBar.style.width = `${pressureScore}%`;
      fillBar.className = `fill ${level.colorClass}`;

      let explanation = "";

      if (pressureScore === 0) {
        explanation =
          hardGateReason ||
          "This laptop and supplies purchase creates virtually no measurable pressure based on the income, savings, debt, borrowing, and aid entered.";
      } else if (pressureScore <= 30) {
        explanation =
          "This laptop and supplies purchase appears manageable. The main job is confirming the specs, warranty, school requirements, and cheaper alternatives.";
      } else if (pressureScore <= 60) {
        explanation =
          "This laptop and supplies purchase may work, but it deserves caution. Compare used, refurbished, lower-spec, student-discount, and campus-lab options before committing.";
      } else {
        explanation =
          "This laptop and supplies purchase could create significant financial pressure. A cheaper device, more aid, less borrowing, or fewer premium accessories would likely be safer.";
      }

      resultDetails.innerHTML = `
        <p><strong>Laptop and supplies cost:</strong> ${formatDollars(supplyCost)}.</p>

        <p><strong>Aid and outside help applied:</strong> ${formatDollars(giftHelp)}.</p>

        <p><strong>Uncovered laptop and supplies cost:</strong> ${formatDollars(uncoveredCost)}.</p>

        <p><strong>Uncovered cost impact:</strong> ${uncoveredCostRatio.toFixed(1)}% of annual take-home income.</p>

        <p><strong>Estimated loan payment:</strong> About ${formatDollars(estimatedLoanPayment)} per month based on uncovered borrowing.</p>

        <p><strong>Debt impact after borrowing:</strong> ${debtRatioAfter.toFixed(1)}% of monthly take-home income, including estimated laptop/supplies borrowing.</p>

        <p><strong>Emergency fund coverage:</strong> ${emergencyMonths.toFixed(1)} months of take-home income.</p>

        <p><strong>Savings after planned cash use:</strong> About ${savingsMonthsAfter.toFixed(1)} months of take-home income.</p>

        <p><strong>Total liquid cushion after purchase:</strong> About ${totalLiquidMonthsAfter.toFixed(1)} months of take-home income.</p>

        <p><strong>Pressure level:</strong> ${level.stress}.</p>

        <p>${explanation} Recommended next step: ${level.action}</p>
      `;

      guidance.textContent = "";
    }

    document
      .getElementById("suppliesButton")
      .addEventListener("click", calculateSuppliesPressure);
  </script>
</Layout>
