---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
---

<Layout
  title="Should I Spend $12,000 on a Cruise?"
  description="Use this cruise calculator to evaluate whether a $12,000 cruise vacation fits your savings, income, debt load, and financial flexibility."
>
  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
    }

    button {
      background: var(--button);
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Cruise Vacation Calculator"
      title="Should I Spend $12,000 on a Cruise?"
      description="Estimate whether a $12,000 cruise fits your income, savings, debt, emergency cushion, flights, excursions, gratuities, and onboard spending."
    >
      <div class="card">
        <h2>Cruise Affordability Verdict</h2>

        <div class="grid">
          <div>
            <label for="income">Annual Household Income</label>
            <input id="income" type="number" placeholder="150000" />
          </div>

          <div>
            <label for="savings">Total Savings</label>
            <input id="savings" type="number" placeholder="30000" />
          </div>

          <div>
            <label for="vacation">Total Cruise Cost</label>
            <input id="vacation" type="number" placeholder="12000" />
          </div>

          <div>
            <label for="debt">Total Debt</label>
            <input id="debt" type="number" placeholder="20000" />

            <div class="helper-link">
              <a href="/what-counts-as-debt">
                Not sure what counts as debt? Read the debt guide
              </a>
            </div>
          </div>
        </div>

        <button id="vacationButton" type="button">
          Get Cruise Verdict
        </button>

        <div class="result">
          <div class="score" id="score">
            Comfortable Cruise - 82/100
          </div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="stress"></div>
          <div class="metric" id="savingsImpact"></div>
          <div class="metric" id="incomeImpact"></div>
          <div class="metric" id="debtRatio"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <section>
          <h2>What a $12,000 Cruise Really Costs</h2>

          <p>
            A cruise can look cheaper than it really is because the base fare feels bundled.
            The real total often includes gratuities, excursions, drink packages, specialty
            dining, Wi-Fi, spa services, casino spending, port transportation, pre-cruise hotels,
            flights, travel insurance, passports, luggage, and onboard purchases.
          </p>

          <p>
            A $12,000 cruise may be reasonable for a family, longer itinerary, balcony cabin,
            suite, Alaska sailing, European route, or premium cruise line. It becomes riskier
            when the quoted fare only covers the cabin and leaves tips, shore excursions,
            alcohol, flights, hotels, port transfers, and taxes outside the estimate.
          </p>

          <p>
            Cruise spending can also climb during the trip. Once you are onboard, convenience
            costs feel easier to approve because meals, entertainment, drinks, excursions, and
            upgrades are all happening in one closed environment.
          </p>
        </section>

        <section>
          <h2>Why Cruises Cost More Than the Advertised Fare</h2>

          <p>
            The advertised cruise fare usually tells only part of the story. Port fees, taxes,
            gratuities, drinks, specialty restaurants, shore excursions, Wi-Fi, photos, and
            transportation can add thousands to the final bill.
          </p>

          <p>
            Flights to the port city are another major swing factor. A family flying to Miami,
            Orlando, Seattle, New York, Vancouver, Rome, or Barcelona may need airfare, checked
            bags, hotel rooms before embarkation, meals, rideshares, and buffer time before
            the ship leaves.
          </p>
        </section>

        <section>
          <h2>Cruise Costs People Forget</h2>

          <p>
            Common forgotten cruise costs include gratuities, drink packages, bottled water,
            specialty coffee, Wi-Fi, photos, arcade spending, casino spending, spa services,
            excursions, port taxis, travel insurance, seasickness medicine, formalwear, laundry,
            passports, and pre- or post-cruise hotel nights.
          </p>

          <p>
            Families should also consider cabin comfort. An interior cabin may save money, but
            a balcony or larger room can matter more on longer sailings, rough seas, or trips
            with children who need downtime.
          </p>
        </section>

        <section>
          <h2>When a $12,000 Cruise Makes Sense</h2>

          <p>
            A cruise at this price point makes more sense when it is mostly paid from savings,
            your emergency fund remains intact, and the trip does not create high-interest
            credit card debt.
          </p>

          <p>
            The budget should include the full cruise experience: cabin fare, taxes, port fees,
            gratuities, excursions, drink packages, specialty dining, flights, hotels before
            sailing, ground transportation, travel insurance, and a cushion for onboard spending.
          </p>

          <p>
            A cruise can be a strong value when the all-in cost is honest and the trip does not
            create financial stress after you return home.
          </p>
        </section>

        <section>
          <h2>When You Should Scale Back</h2>

          <p>
            Scaling back may be smarter if the cruise requires financing, drains savings, or
            leaves you without enough cash for bills, emergencies, debt payoff, or upcoming
            household expenses.
          </p>

          <p>
            A cheaper version may still work. Consider a shorter sailing, interior cabin, fewer
            paid excursions, no drink package, a departure port within driving distance, or a
            later date that gives you more time to save.
          </p>
        </section>

        <FinancialRedFlags
  items={[
    "The cruise budget depends on financing the trip with debt.",
    "You are not accounting for excursions, drink packages, gratuities, flights, or port costs.",
    "The trip would significantly reduce your emergency savings.",
    "Your monthly bills already feel difficult to manage.",
    "You would return from the cruise financially stressed or unable to rebuild savings quickly.",
  ]}

  <CalculatorAssumptions
  items={[
    "The calculator assumes the cruise is primarily paid with savings instead of high-interest debt.",
    "Cruise pricing should include gratuities, excursions, flights, transportation, and onboard purchases.",
    "The estimate assumes your normal monthly bills remain manageable after the trip.",
    "Unexpected medical, weather, or travel disruption costs can increase total spending.",
    "The calculator assumes you still maintain an emergency cushion after booking the cruise.",
  ]}
/>
/>
        <FAQSection
          title="Cruise Vacation FAQ"
          faqs={[
            {
              question: "Is $12,000 too much for a cruise?",
              answer:
                "It depends on income, savings, debt, family size, cruise length, cabin type, destination, and what is included. A $12,000 cruise can be reasonable if it reflects the full trip cost and does not create debt pressure.",
            },
            {
              question: "What costs should I include in a cruise budget?",
              answer:
                "Include the cruise fare, taxes, port fees, gratuities, excursions, drink packages, specialty dining, Wi-Fi, flights, hotels, transportation, travel insurance, passports, luggage, and onboard spending.",
            },
            {
              question: "Should I finance a cruise?",
              answer:
                "Financing a cruise can be risky if it involves high-interest debt. A cruise is usually safer when paid from savings while keeping an emergency cushion intact.",
            },
            {
              question: "Why do cruises cost more than the advertised fare?",
              answer:
                "The advertised fare often excludes gratuities, excursions, drinks, specialty dining, Wi-Fi, port transportation, flights, hotels, taxes, and extra onboard spending.",
            },
            {
              question: "Are cruise drink packages worth it?",
              answer:
                "Drink packages can be worth it for travelers who will use them heavily, but they can also add major cost. Families or light drinkers should compare the package price against realistic daily use.",
            },
            {
              question: "How can I make a cruise cheaper?",
              answer:
                "Choose an interior cabin, book a shorter sailing, limit excursions, skip drink packages, drive to the port if possible, avoid specialty dining, and set a firm onboard spending limit.",
            },
          ]}
        />

        <MethodologySection
          category="cruise spending"
          updated="May 2026"
        />

        <RelatedGuides
  guides={[
    {
      title: "How to Avoid Vacation Debt",
      href: "/how-to-avoid-vacation-debt",
      description:
        "Learn how to keep a cruise or major vacation from turning into long-term debt.",
    },
    {
      title: "Travel Budget Calculators",
      href: "/travel-calculators",
      description:
        "Compare cruise, Disney, Europe, and vacation calculators before committing to a major trip.",
    },
  ]}
/>
        <RelatedCalculators
          calculators={[
            {
              category: "Travel",
              title: "Should I Spend $5,000 on a Vacation?",
              href: "/should-i-spend-5000-on-a-vacation",
            },
            {
              category: "Travel",
              title: "Should I Spend $8,000 on a Disney Vacation?",
              href: "/should-i-spend-8000-on-a-disney-vacation",
            },
            {
              category: "Travel",
              title: "Should I Spend $10,000 on a Europe Trip?",
              href: "/should-i-spend-10000-on-a-europe-trip",
            },
            {
              category: "Travel",
              title: "Browse Travel Calculators",
              href: "/travel-calculators",
            },
          ]}
        />
      </div>
    </CalculatorPageShell>
  </div>

  <script is:inline>
    function calculateVacation() {
      const income = Number(document.getElementById("income").value);
      const savings = Number(document.getElementById("savings").value);
      const vacation = Number(document.getElementById("vacation").value);
      const debt = Number(document.getElementById("debt").value);

      let score = 100;

      const savingsImpact = savings > 0 ? (vacation / savings) * 100 : 100;
      const incomeImpact = income > 0 ? (vacation / income) * 100 : 100;
      const debtRatio = income > 0 ? (debt / income) * 100 : 50;

      score -= savingsImpact * 0.22;
      score -= incomeImpact * 0.9;
      score -= debtRatio * 0.18;

      if (savings < vacation) score -= 12;
      if (income > 0 && debt > income * 0.5) score -= 10;

      score = Math.max(0, Math.min(100, Math.round(score)));

      let verdict = "";
      let stress = "";
      let guidance = "";
      let barColor = "";

      if (score >= 80) {
        verdict = "Comfortable Cruise";
        stress = "Low stress";
        guidance =
          "This cruise appears financially manageable based on your income, savings, debt, and remaining emergency cushion.";
        barColor = "#16a34a";
      } else if (score >= 60) {
        verdict = "Manageable With Guardrails";
        stress = "Moderate stress";
        guidance =
          "This cruise may work, but keep firm limits on excursions, drink packages, specialty dining, gratuities, and onboard spending.";
        barColor = "#ca8a04";
      } else if (score >= 40) {
        verdict = "Financial Stretch";
        stress = "High stress";
        guidance =
          "This cruise could create financial pressure. Consider a cheaper cabin, shorter sailing, fewer excursions, or more time to save.";
        barColor = "#ea580c";
      } else {
        verdict = "High Financial Risk";
        stress = "Very high stress";
        guidance =
          "This cruise cost appears too aggressive for the current financial picture, especially if the trip would be financed with high-interest debt.";
        barColor = "#b91c1c";
      }

      document.getElementById("score").textContent = `${verdict} - ${score}/100`;
      document.getElementById("barFill").style.width = `${score}%`;
      document.getElementById("barFill").style.background = barColor;

      document.getElementById("stress").innerHTML =
        `<strong>Stress level:</strong> ${stress}`;

      document.getElementById("savingsImpact").innerHTML =
        `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;

      document.getElementById("incomeImpact").innerHTML =
        `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;

      document.getElementById("debtRatio").innerHTML =
        `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

      document.getElementById("guidance").textContent = guidance;
    }

    document.getElementById("vacationButton").addEventListener("click", calculateVacation);
  </script>
</Layout>