---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
---

<Layout title="Should I Spend $12,000 on a Cruise?">

  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
    }

    button {
      background: var(--button);
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }
  </style>

<div class="container">

<CalculatorPageShell
  eyebrow="Cruise Vacation Calculator"
  title="Should I Spend $12,000 on a Cruise?"
  description="Estimate whether a $12,000 cruise fits your income, savings, debt, emergency cushion, flights, excursions, gratuities, and onboard spending."
>

  <div class="card">

    <h2>Cruise Affordability Verdict</h2>

    <div class="grid">

      <div>
        <label>Annual Household Income</label>
        <input id="income" type="number" placeholder="150000" />
      </div>

      <div>
        <label>Total Savings</label>
        <input id="savings" type="number" placeholder="30000" />
      </div>

      <div>
        <label>Total Cruise Cost</label>
        <input id="vacation" type="number" placeholder="12000" />
      </div>

      <div>
        <label>Total Debt</label>
        <input id="debt" type="number" placeholder="20000" />

        <div class="helper-link">
          <a href="/what-counts-as-debt">
            Not sure what counts as debt? Read the debt guide
          </a>
        </div>
      </div>

    </div>

    <button id="vacationButton" type="button">
      Get Cruise Verdict
    </button>

    <div class="result">

      <div class="score" id="score">
        Comfortable Cruise - 82/100
      </div>

      <div class="bar">
        <div class="fill" id="barFill"></div>
      </div>

      <div class="metric" id="stress"></div>
      <div class="metric" id="savingsImpact"></div>
      <div class="metric" id="incomeImpact"></div>
      <div class="metric" id="debtRatio"></div>

      <div class="guidance" id="guidance"></div>

      <div class="disclaimer">
        This is a general educational estimate, not financial advice.
      </div>

    </div>

  </div>

<div class="content-section">

<section>
  <h2>What a $12,000 Cruise Really Costs</h2>

  <p>
    A cruise budget can look simple at first because the base fare feels bundled. The real
    total often includes much more: gratuities, excursions, drink packages, specialty dining,
    Wi-Fi, spa services, casino spending, port transportation, pre-cruise hotels, flights,
    travel insurance, passports, luggage, and onboard purchases.
  </p>

  <p>
    A $12,000 cruise may be reasonable for a family, a longer itinerary, a balcony cabin, or
    a premium cruise line. It becomes riskier when the quoted price only covers the cabin and
    leaves shore excursions, alcohol, tips, flights, hotel nights, and port costs outside the
    original estimate.
  </p>

  <p>
    Cruise spending can also creep upward during the trip. Once you are onboard, convenience
    costs feel easier to approve because meals, entertainment, and activities are all happening
    in one closed environment.
  </p>
</section>

<section>
  <h2>When a $12,000 Cruise Makes Sense</h2>

  <p>
    A cruise at this price point makes more sense when it is mostly paid from savings, your
    emergency fund remains intact, and the trip does not create high-interest credit card debt.
  </p>

  <p>
    The budget should include the full cruise experience: cabin fare, taxes, port fees,
    gratuities, excursions, drink packages, specialty dining, flights, hotels before sailing,
    ground transportation, and a cushion for onboard spending.
  </p>

  <p>
    A cruise can be a strong value when the final all-in cost is honest and the trip does not
    create financial stress after you return home.
  </p>
</section>

<section>
  <h2>When You Should Wait</h2>

  <p>
    Waiting may be smarter if the cruise requires financing, drains savings, or leaves you
    without enough cash for bills, emergencies, debt payoff, or upcoming household expenses.
  </p>

  <p>
    A cheaper version may still work. Consider a shorter sailing, interior cabin, fewer paid
    excursions, no drink package, a departure port within driving distance, or a later date that
    gives you more time to save.
  </p>
</section>

<FAQSection
  title="Cruise Vacation FAQ"
  faqs={[
    {
      question: "Is $12,000 too much for a cruise?",
      answer:
        "It depends on your income, savings, debt, family size, cruise length, cabin type, and what is included. A $12,000 cruise can be reasonable if it includes the full trip cost and does not create debt pressure.",
    },
    {
      question: "What costs should I include in a cruise budget?",
      answer:
        "Include the cruise fare, taxes, port fees, gratuities, excursions, drink packages, specialty dining, Wi-Fi, flights, hotels, transportation, travel insurance, passports, and onboard spending.",
    },
    {
      question: "Should I finance a cruise?",
      answer:
        "Financing a cruise can be risky if it involves high-interest debt. A cruise is usually safer when paid from savings while keeping an emergency cushion intact.",
    },
    {
      question: "Why do cruises cost more than the advertised fare?",
      answer:
        "The advertised fare often does not include gratuities, excursions, drinks, specialty dining, Wi-Fi, port transportation, flights, hotels, and extra onboard spending.",
    },
    {
      question: "How can I make a cruise cheaper?",
      answer:
        "Choose an interior cabin, book a shorter sailing, limit excursions, skip drink packages, drive to the port if possible, avoid specialty dining, and set a firm onboard spending limit.",
    },
  ]}
/>

<RelatedCalculators
  calculators={[
    {
      category: "Travel",
      title: "Should I Spend $5,000 on a Vacation?",
      href: "/should-i-spend-5000-on-a-vacation",
    },
    {
      category: "Travel",
      title: "Should I Spend $8,000 on a Disney Vacation?",
      href: "/should-i-spend-8000-on-a-disney-vacation",
    },
    {
      category: "Travel",
      title: "Should I Spend $10,000 on a Europe Trip?",
      href: "/should-i-spend-10000-on-a-europe-trip",
    },
    {
      category: "Travel",
      title: "Browse Travel Calculators",
      href: "/travel-calculators",
    },
  ]}
/>

</div>

</CalculatorPageShell>

</div>

<script is:inline>

function calculateVacation() {

  const income = Number(document.getElementById("income").value);
  const savings = Number(document.getElementById("savings").value);
  const vacation = Number(document.getElementById("vacation").value);
  const debt = Number(document.getElementById("debt").value);

  let score = 100;

  const savingsImpact = (vacation / savings) * 100;
  const incomeImpact = (vacation / income) * 100;
  const debtRatio = (debt / income) * 100;

  score -= savingsImpact * 0.22;
  score -= incomeImpact * 0.9;
  score -= debtRatio * 0.18;

  if (savings < vacation) score -= 12;
  if (debt > income * 0.5) score -= 10;

  score = Math.max(0, Math.min(100, Math.round(score)));

  let verdict = "";
  let stress = "";
  let guidance = "";
  let barColor = "";

  if (score >= 80) {
    verdict = "Comfortable Cruise";
    stress = "Low stress";
    guidance =
      "This cruise appears financially manageable based on your income, savings, debt, and remaining emergency cushion.";
    barColor = "#16a34a";
  }

  else if (score >= 60) {
    verdict = "Manageable With Guardrails";
    stress = "Moderate stress";
    guidance =
      "This cruise may work, but keep firm limits on excursions, drink packages, specialty dining, gratuities, and onboard spending.";
    barColor = "#ca8a04";
  }

  else if (score >= 40) {
    verdict = "Financial Stretch";
    stress = "High stress";
    guidance =
      "This cruise could create financial pressure. Consider a cheaper cabin, shorter sailing, fewer excursions, or more time to save.";
    barColor = "#ea580c";
  }

  else {
    verdict = "High Financial Risk";
    stress = "Very high stress";
    guidance =
      "This cruise cost appears too aggressive for the current financial picture, especially if the trip would be financed with high-interest debt.";
    barColor = "#b91c1c";
  }

  document.getElementById("score").textContent =
    `${verdict} - ${score}/100`;

  document.getElementById("barFill").style.width =
    `${score}%`;

  document.getElementById("barFill").style.background =
    barColor;

  document.getElementById("stress").innerHTML =
    `<strong>Stress level:</strong> ${stress}`;

  document.getElementById("savingsImpact").innerHTML =
    `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;

  document.getElementById("incomeImpact").innerHTML =
    `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;

  document.getElementById("debtRatio").innerHTML =
    `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

  document.getElementById("guidance").textContent =
    guidance;
}

document.getElementById("vacationButton")
  .addEventListener("click", calculateVacation);

</script>

</Layout>