      </div>
    </section>

    <FAQSection title="Emergency Savings FAQ" faqs={emergencySavingsFaqs} />
  </main>

  <script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const button = document.getElementById("calculateEmergencySavings");

    if (!button) return;

    button.addEventListener("click", function () {
      const expensesInput = document.getElementById("expenses");
const expenses = Number(expensesInput.value);

      const savingsInput = document.getElementById("savings");
const savings = Number(savingsInput.value);

      const debt = document.getElementById("debt").value;
      const stability = document.getElementById("stability").value;
      const dependents = document.getElementById("dependents").value;
      const housing = document.getElementById("housing").value;

      let monthsTarget = 3;

      if (debt === "moderate") monthsTarget += 1;
      if (debt === "high") monthsTarget += 2;

      if (stability === "average") monthsTarget += 1;
      if (stability === "unstable") monthsTarget += 2;

      if (dependents === "1") monthsTarget += 1;
      if (dependents === "2") monthsTarget += 2;

      if (housing === "own") monthsTarget += 1;

      const targetAmount = expenses * monthsTarget;

      let verdict = "";
      let analysis = "";

      if (savings >= targetAmount) {
        verdict = "Strong Emergency Cushion";
        analysis =
          "Your emergency savings appear healthy relative to your monthly obligations and financial risk profile.";
      } else if (savings >= targetAmount * 0.6) {
        verdict = "Moderate Emergency Cushion";
        analysis =
          "Your savings provide some protection, but a larger cushion may improve flexibility and stability.";
      } else {
        verdict = "Thin Emergency Cushion";
        analysis =
          "Your emergency savings may leave limited room for layoffs, repairs, medical bills, or unexpected financial pressure.";
      }

      document.getElementById("calcResults").classList.add("active");
      document.getElementById("calcVerdict").innerText = verdict;

      document.getElementById("calcTarget").innerText =
        `Recommended Emergency Fund: $${targetAmount.toLocaleString()}`;

      document.getElementById("calcMonths").innerText =
        `Suggested Cushion: ${monthsTarget} months of expenses`;

      document.getElementById("calcAnalysis").innerText = analysis;
    });
  });
</script>
</Layout>
