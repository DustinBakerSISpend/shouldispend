---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
---

<Layout title="Should I Spend $20,000 on a Family Vacation?">

  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
    }

    button {
      background: var(--button);
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }
  </style>

<div class="container">

<CalculatorPageShell
  eyebrow="Family Vacation Calculator"
  title="Should I Spend $20,000 on a Family Vacation?"
  description="Estimate whether a $20,000 family vacation fits your income, savings, debt, emergency cushion, kids' costs, airfare, hotels, food, and activities."
>

  <div class="card">

    <h2>Family Vacation Affordability Verdict</h2>

    <div class="grid">

      <div>
        <label>Annual Household Income</label>
        <input id="income" type="number" placeholder="175000" />
      </div>

      <div>
        <label>Total Savings</label>
        <input id="savings" type="number" placeholder="40000" />
      </div>

      <div>
        <label>Family Vacation Cost</label>
        <input id="vacation" type="number" placeholder="20000" />
      </div>

      <div>
        <label>Total Debt</label>
        <input id="debt" type="number" placeholder="25000" />

        <div class="helper-link">
          <a href="/what-counts-as-debt">
            Not sure what counts as debt? Read the debt guide
          </a>
        </div>
      </div>

    </div>

    <button id="vacationButton" type="button">
      Get Family Vacation Verdict
    </button>

    <div class="result">

      <div class="score" id="score">
        Comfortable Family Vacation - 82/100
      </div>

      <div class="bar">
        <div class="fill" id="barFill"></div>
      </div>

      <div class="metric" id="stress"></div>
      <div class="metric" id="savingsImpact"></div>
      <div class="metric" id="incomeImpact"></div>
      <div class="metric" id="debtRatio"></div>

      <div class="guidance" id="guidance"></div>

      <div class="disclaimer">
        This is a general educational estimate, not financial advice.
      </div>

    </div>

  </div>

<div class="content-section">

<section>
  <h2>What a $20,000 Family Vacation Really Costs</h2>

  <p>
    A family vacation budget grows quickly because every major category multiplies. Airfare,
    meals, tickets, hotel rooms, rental cars, checked bags, snacks, activities, souvenirs,
    and emergency costs all become larger when several people are traveling together.
  </p>

  <p>
    A $20,000 family vacation may be reasonable for a larger household, international trip,
    theme park vacation, resort stay, cruise, or multi-city itinerary. It becomes riskier when
    the number only covers flights and lodging while food, activities, transportation, and
    kid-specific costs are added later.
  </p>

  <p>
    Families also face timing pressure. School breaks, holidays, and summer travel can make
    flights and hotels more expensive, which means the same trip may cost far less during a
    different season.
  </p>
</section>

<section>
  <h2>When a $20,000 Family Vacation Makes Sense</h2>

  <p>
    A family vacation at this price point makes more sense when it is paid mostly from savings,
    the emergency fund remains intact, and the trip does not create credit card debt after
    everyone gets home.
  </p>

  <p>
    The budget should include the full family reality: flights, lodging, rental car or transfers,
    meals, snacks, checked bags, activities, tickets, childcare-related needs, souvenirs, and
    a cushion for illness, delays, or last-minute changes.
  </p>

  <p>
    The trip can be worth it when the memories fit inside a financial plan that still works
    after the vacation ends.
  </p>
</section>

<section>
  <h2>When You Should Wait</h2>

  <p>
    Waiting may be smarter if the trip would drain savings, require high-interest debt, or
    make normal expenses feel tight after returning home.
  </p>

  <p>
    A cheaper version may still work. Consider driving instead of flying, shortening the trip,
    booking fewer hotel nights, choosing a kitchen-equipped rental, traveling outside peak
    school-break windows, or limiting paid activities.
  </p>
</section>

<FAQSection
  title="Family Vacation FAQ"
  faqs={[
    {
      question: "Is $20,000 too much for a family vacation?",
      answer:
        "It depends on income, savings, debt, family size, destination, and trip length. A $20,000 family vacation can be reasonable if it is planned honestly and does not create debt pressure.",
    },
    {
      question: "What should be included in a family vacation budget?",
      answer:
        "Include airfare or gas, hotels, rental car or transfers, meals, snacks, activities, tickets, checked bags, souvenirs, travel insurance, and an emergency cushion.",
    },
    {
      question: "Should I finance a family vacation?",
      answer:
        "Financing a family vacation can create long-term stress, especially with credit card interest. Paying from savings while keeping an emergency fund intact is usually safer.",
    },
    {
      question: "Why are family vacations so expensive?",
      answer:
        "Family vacations cost more because transportation, meals, tickets, luggage, activities, and lodging needs often multiply with each traveler.",
    },
    {
      question: "How can I lower the cost of a family vacation?",
      answer:
        "Travel outside peak dates, drive when possible, use fewer hotel nights, book lodging with a kitchen, limit paid activities, set a souvenir budget, and build the trip around free or low-cost experiences.",
    },
  ]}
/>

<RelatedCalculators
  calculators={[
    {
      category: "Travel",
      title: "Should I Spend $5,000 on a Vacation?",
      href: "/should-i-spend-5000-on-a-vacation",
    },
    {
      category: "Travel",
      title: "Should I Spend $8,000 on a Disney Vacation?",
      href: "/should-i-spend-8000-on-a-disney-vacation",
    },
    {
      category: "Travel",
      title: "Should I Spend $10,000 on a Europe Trip?",
      href: "/should-i-spend-10000-on-a-europe-trip",
    },
    {
      category: "Travel",
      title: "Browse Travel Calculators",
      href: "/travel-calculators",
    },
  ]}
/>

</div>

</CalculatorPageShell>

</div>

<script is:inline>

function calculateVacation() {

  const income = Number(document.getElementById("income").value);
  const savings = Number(document.getElementById("savings").value);
  const vacation = Number(document.getElementById("vacation").value);
  const debt = Number(document.getElementById("debt").value);

  let score = 100;

  const savingsImpact = (vacation / savings) * 100;
  const incomeImpact = (vacation / income) * 100;
  const debtRatio = (debt / income) * 100;

  score -= savingsImpact * 0.22;
  score -= incomeImpact * 0.9;
  score -= debtRatio * 0.18;

  if (savings < vacation) score -= 12;
  if (debt > income * 0.5) score -= 10;

  score = Math.max(0, Math.min(100, Math.round(score)));

  let verdict = "";
  let stress = "";
  let guidance = "";
  let barColor = "";

  if (score >= 80) {
    verdict = "Comfortable Family Vacation";
    stress = "Low stress";
    guidance =
      "This family vacation appears financially manageable based on your income, savings, debt, and remaining emergency cushion.";
    barColor = "#16a34a";
  }

  else if (score >= 60) {
    verdict = "Manageable With Guardrails";
    stress = "Moderate stress";
    guidance =
      "This family vacation may work, but keep firm limits on flights, hotels, food, activities, souvenirs, and emergency spending.";
    barColor = "#ca8a04";
  }

  else if (score >= 40) {
    verdict = "Financial Stretch";
    stress = "High stress";
    guidance =
      "This family vacation could create financial pressure. Consider fewer travel days, cheaper lodging, driving instead of flying, or more time to save.";
    barColor = "#ea580c";
  }

  else {
    verdict = "High Financial Risk";
    stress = "Very high stress";
    guidance =
      "This family vacation cost appears too aggressive for the current financial picture, especially if the trip would be financed with high-interest debt.";
    barColor = "#b91c1c";
  }

  document.getElementById("score").textContent =
    `${verdict} - ${score}/100`;

  document.getElementById("barFill").style.width =
    `${score}%`;

  document.getElementById("barFill").style.background =
    barColor;

  document.getElementById("stress").innerHTML =
    `<strong>Stress level:</strong> ${stress}`;

  document.getElementById("savingsImpact").innerHTML =
    `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;

  document.getElementById("incomeImpact").innerHTML =
    `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;

  document.getElementById("debtRatio").innerHTML =
    `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

  document.getElementById("guidance").textContent =
    guidance;
}

document.getElementById("vacationButton")
  .addEventListener("click", calculateVacation);

</script>

</Layout>