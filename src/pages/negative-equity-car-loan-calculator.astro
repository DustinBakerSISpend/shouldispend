          <input type="number" id="otherDebt" placeholder="500" min="0" inputmode="decimal" />
        </div>

        <div class="calc-field">
          <label for="emergencySavings">Current Emergency Savings ($)</label>
          <input type="number" id="emergencySavings" placeholder="12000" min="0" inputmode="decimal" />
        </div>

        <div class="calc-field">
          <label for="insuranceChange">Monthly Insurance Increase on New Vehicle ($)</label>
          <input type="number" id="insuranceChange" placeholder="90" min="0" inputmode="decimal" />
