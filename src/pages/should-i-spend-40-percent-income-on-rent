---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Should I Spend 40% of My Income on Rent?">
  <style>
    .container {
      max-width: 920px;
      margin: 0 auto;
      padding: 72px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 18px;
      text-align: center;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.95;
      margin-bottom: 24px;
      text-align: center;
      color: #0f172a;
    }

    .subtitle {
      text-align: center;
      font-size: 1.08rem;
      line-height: 1.8;
      color: #334155;
      max-width: 720px;
      margin: 0 auto 60px auto;
    }

    .content-section {
      max-width: 760px;
      margin: 0 auto 56px auto;
    }

    .content-section h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 24px;
      color: #0f172a;
    }

    .content-section p {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
      margin-bottom: 24px;
    }

    .calculator {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 36px;
      margin: 56px auto;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    }

    .calculator h3 {
      margin-bottom: 28px;
      font-size: 1.7rem;
      color: #0f172a;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
      color: #0f172a;
      font-size: 0.95rem;
    }

    input {
      width: 100%;
      padding: 16px;
      border-radius: 14px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .helper-link a:hover {
      text-decoration: underline;
    }

    button {
      margin-top: 28px;
      background: #020617;
      color: white;
      border: none;
      padding: 18px 28px;
      border-radius: 14px;
      font-size: 19px;
      font-weight: 900;
      cursor: pointer;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 28px;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 18px;
      padding: 28px;
    }

    .score {
      font-size: 2.5rem;
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 18px;
    }

    .bar {
      height: 14px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 18px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #0f766e;
      transition: width 0.4s ease;
    }

    .result-details {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 18px;
    }

    .fine-print {
      font-size: 0.9rem;
      color: #64748b;
    }

    .faq {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      padding: 28px;
      margin-bottom: 22px;
    }

    .faq h3 {
      margin-bottom: 16px;
      color: #0f172a;
    }

    .faq p {
      margin: 0;
    }

    @media (max-width: 720px) {
      .container {
        padding: 54px 20px;
      }

      h1 {
        font-size: 2.8rem;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator {
        padding: 24px;
      }

      .score {
        font-size: 2rem;
      }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Rent Affordability Calculator</div>

    <h1>Should I Spend 40% of My Income on Rent?</h1>

    <p class="subtitle">
      Evaluate whether spending 40% of your take-home income on rent leaves
      enough room for debt payments, savings, emergencies, and normal life.
    </p>

    <section class="content-section">
      <h2>Is 40% of Income on Rent Too Much?</h2>

      <p>
        Spending 40% of take-home income on rent is often a stretch point.
        It may be workable in expensive cities or for people with low debt,
        but it can also reduce flexibility quickly.
      </p>

      <p>
        The real question is whether the rent still leaves enough room for
        savings, transportation, food, insurance, debt payments, and unexpected
        expenses after the lease begins.
      </p>
    </section>

    <div class="calculator">
      <h3>Rent Affordability Verdict</h3>

      <div class="grid">
        <div>
          <label>Monthly Take-Home Income</label>
          <input id="income" type="number" placeholder="Example: 7000" />
        </div>

        <div>
          <label>Total Savings</label>
          <input id="savings" type="number" placeholder="Example: 20000" />
        </div>

        <div>
          <label>Monthly Rent</label>
          <input id="rent" type="number" placeholder="Example: 2800" />
        </div>

        <div>
          <label>Monthly Debt Payments</label>
          <input id="debt" type="number" placeholder="Example: 700" />

          <div class="helper-link">
            Not sure what counts as debt?
            <a href="/what-counts-as-debt">Read the debt guide</a>
          </div>
        </div>
      </div>

      <button id="rentButton">Get Rent Verdict</button>

      <div class="result" id="result">
        <div class="score" id="scoreText">Waiting For Inputs</div>

        <div class="bar">
          <div class="fill" id="scoreFill"></div>
        </div>

        <div class="result-details" id="resultDetails"></div>

        <div class="fine-print">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>What a 40% Rent Ratio Means</h2>

      <p>
        A 40% rent ratio means rent takes a large share of your monthly
        take-home pay before groceries, transportation, utilities, debt,
        savings, or entertainment are considered.
      </p>

      <p>
        This can still work when savings are strong and debt is low. It becomes
        more concerning when the rent combines with car payments, credit card
        balances, student loans, or a thin emergency fund.
      </p>
    </section>

    <section class="content-section">
      <h2>Frequently Asked Questions</h2>

      <div class="faq">
        <h3>Is spending 40% of income on rent bad?</h3>
        <p>
          It is usually aggressive, but context matters. A renter with strong
          savings and little debt may handle it better than someone with high
          monthly obligations and limited emergency cash.
        </p>
      </div>

      <div class="faq">
        <h3>What is a safer rent percentage?</h3>
        <p>
          Many renters aim for 25% to 30% of take-home income, though expensive
          housing markets can push that higher. The key is whether the rest of
          the budget still works.
        </p>
      </div>

      <div class="faq">
        <h3>Should I include debt when evaluating rent?</h3>
        <p>
          Yes. Debt payments reduce the money available after rent, which can
          make a 40% rent ratio feel tighter than the percentage suggests.
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    function calculateRent() {
      const income = Number(document.getElementById("income").value);
      const savings = Number(document.getElementById("savings").value);
      const rent = Number(document.getElementById("rent").value);
      const debt = Number(document.getElementById("debt").value);

      if (!income || !rent) {
        alert("Please enter income and rent.");
        return;
      }

      let score = 100;

      const rentRatio = rent / income;
      const debtRatio = debt / income;

      score -= rentRatio * 120;
      score -= debtRatio * 45;

      if (rentRatio > 0.35 && savings < rent * 3) {
  score -= 18;
}

else if (rentRatio > 0.25 && savings < rent * 6) {
  score -= 10;
}

      score = Math.max(5, Math.min(100, Math.round(score)));

      let verdict = "";
      let color = "#0f766e";

      if (score >= 80) {
        verdict = "Comfortable Rent";
        color = "#16a34a";
      } else if (score >= 60) {
        verdict = "Manageable With Guardrails";
        color = "#eab308";
      } else if (score >= 40) {
        verdict = "Financial Stretch";
        color = "#f97316";
      } else {
        verdict = "High Risk Housing Cost";
        color = "#dc2626";
      }

      const rentPercent = rentRatio * 100;
      const debtPercent = debtRatio * 100;

      document.getElementById(
        "scoreText"
      ).innerText = `${verdict} - ${score}/100`;

      document.getElementById("scoreFill").style.width = `${score}%`;
      document.getElementById("scoreFill").style.background = color;

      document.getElementById("resultDetails").innerHTML = `
        <p><strong>Rent impact:</strong> ${rentPercent.toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Debt impact:</strong> ${debtPercent.toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Savings cushion:</strong> ${savings ? (savings / rent).toFixed(1) : "0.0"} months of rent covered.</p>
      `;
    }

    document
      .getElementById("rentButton")
      .addEventListener("click", calculateRent);
  </script>
</Layout>