---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found | ShouldISpend"
  description="The page you requested could not be found."
>
  <section class="not-found">
    <p class="eyebrow">404 ERROR</p>

    <h1>That Page Doesn't Exist</h1>

    <p class="description">
      The calculator, guide, or page you requested may have moved or no longer exists.
    </p>

    <div class="actions">
      <a href="/" class="primary-button">Return Home</a>
      <a href="/calculators" class="secondary-button">Browse Calculators</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    max-width: 760px;
    margin: 100px auto;
    text-align: center;
    padding: 0 20px;
  }

  .eyebrow {
    color: #0f766e;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .description {
    color: #475569;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary-button,
  .secondary-button {
    padding: 0.9rem 1.4rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
  }

  .primary-button {
    background: #0f766e;
    color: white;
  }

  .secondary-button {
    border: 1px solid #d8e0ea;
    color: #061126;
  }
</style>