---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const funeralFaqs = [
  {
    question: "Is $10,000 too much to spend on a funeral?",
    answer:
      "$10,000 can be manageable if the family has savings, insurance, or help from relatives. It becomes risky when the cost requires credit cards, personal loans, or drains emergency savings.",
  },
  {
    question: "Should you go into debt for a funeral?",
    answer:
      "Funeral debt can create long-term pressure during an already difficult time. If possible, compare lower-cost options, ask for itemized pricing, and avoid high-interest financing.",
  },
  {
    question: "What costs should I include in a funeral budget?",
    answer:
      "Include funeral home services, burial or cremation, casket or urn, cemetery costs, transportation, flowers, obituary notices, reception costs, clergy or celebrant fees, and travel.",
  },
  {
    question: "Is cremation usually cheaper than burial?",
    answer:
      "Cremation is often less expensive than traditional burial, especially when it avoids cemetery plots, burial vaults, and higher casket costs.",
  },
];
---

<Layout
  title="Should I Spend $10,000 on a Funeral?"
  description="Use this funeral affordability calculator to see whether a $10,000 funeral fits your savings, debt, income, insurance help, and emergency fund without creating long-term financial pressure."
>
  <style>
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.7rem, 7vw, 4.8rem);
      line-height: 0.95;
      margin-bottom: 24px;
      color: #0f172a;
      max-width: 900px;
    }

    .intro {
      max-width: 820px;
      color: #334155;
      font-size: 1.12rem;
      line-height: 1.85;
      margin-bottom: 48px;
    }

    .calculator-box,
    .info-card,
    .link-card,
    .callout {
      border: 1px solid #dbe4ee;
      background: white;
      border-radius: 22px;
      padding: 26px;
    }

    .calculator-box {
      margin-bottom: 56px;
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .calculator-box h2,
    .content-section h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-box p,
    .content-section p,
    .content-section li {
      color: #334155;
      line-height: 1.9;
      font-size: 1.06rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-top: 22px;
    }

    label {
      display: block;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 8px;
      font-size: 0.95rem;
    }

    input {
      width: 100%;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 13px;
      font-size: 1rem;
      box-sizing: border-box;
    }

    button {
      margin-top: 24px;
      border: none;
      border-radius: 999px;
      padding: 15px 24px;
      background: #0f766e;
      color: white;
      font-weight: 900;
      font-size: 1rem;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 32px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 32px;
      display: none;
    }

    .result.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin-bottom: 12px;
    }

    .guidance {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #dbe4ee;
      color: #0f172a;
      font-size: 1.08rem;
      line-height: 1.8;
    }

    .fine-print {
      color: #64748b;
      font-size: 0.9rem;
      margin-top: 20px;
    }

    .content-section {
      margin-top: 72px;
    }

    .content-section h3 {
      font-size: 1.3rem;
      color: #0f172a;
      margin: 28px 0 12px;
    }

    .info-grid,
    .link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 28px;
    }

    .info-card h3 {
      margin-top: 0;
    }

    .info-card p,
    .link-card span {
      margin: 0;
      color: #334155;
      line-height: 1.7;
      font-size: 0.96rem;
    }

    .link-card {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .link-card strong {
      display: block;
      color: #0f172a;
      margin-bottom: 8px;
      line-height: 1.3;
    }

    .callout {
      background: #f8fafc;
      margin-top: 28px;
    }
  </style>

  <main class="container">
    <div class="eyebrow">Funeral Cost Calculator</div>

    <h1>Should I Spend $10,000 on a Funeral?</h1>

    <p class="intro">
      Funeral costs can create sudden financial pressure at the worst possible
      time. This calculator helps estimate whether a $10,000 funeral is
      manageable based on savings, income, family help, insurance, debt, and
      emergency flexibility.
    </p>

    <section class="calculator-box">
      <h2>$10,000 Funeral Pressure Calculator</h2>

      <p>
        Enter the funeral cost, available savings, insurance or family
        contributions, monthly income, and current debt payments. The calculator
        estimates whether the expense looks manageable, stressful, or financially
        dangerous.
      </p>

      <div class="form-grid">
        <div>
          <label for="cost">Estimated funeral cost</label>
          <input id="cost" type="number" value="10000" />
        </div>

        <div>
          <label for="savings">Current liquid savings</label>
          <input id="savings" type="number" placeholder="Example: 15000" />
        </div>

        <div>
          <label for="help">Insurance or family help</label>
          <input id="help" type="number" placeholder="Example: 3000" />
        </div>

        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 6500" />
        </div>

        <div>
          <label for="debt">Monthly debt payments</label>
          <input id="debt" type="number" placeholder="Example: 900" />
        </div>

        <div>
          <label for="emergencyTarget">Minimum savings you want left afterward</label>
          <input id="emergencyTarget" type="number" placeholder="Example: 15000" />
        </div>
      </div>

      <button id="calculateButton" type="button">Check Funeral Affordability</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="fill" id="scoreFill"></div>
        </div>

        <div class="result-details" id="resultDetails"></div>

        <div class="guidance" id="guidance"></div>

        <div class="fine-print">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>When a $10,000 Funeral Is Financially Reasonable</h2>

      <p>
        A $10,000 funeral can be manageable when there is enough savings,
        insurance money, prepaid funeral planning, or shared family support to
        cover most of the cost without high-interest debt.
      </p>

      <p>
        The expense becomes more dangerous when the family has to rely on credit
        cards, personal loans, or money that was needed for rent, groceries,
        utilities, medical costs, or emergency savings.
      </p>

      <div class="callout">
        <p>
          A funeral budget should honor the person who died without creating
          months or years of avoidable financial stress for the people left
          behind.
        </p>
      </div>
    </section>

    <section class="content-section">
      <h2>What This Funeral Calculator Considers</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Out-of-Pocket Cost</h3>
          <p>
            The most important number is what remains after insurance, prepaid
            funds, and family contributions are applied.
          </p>
        </div>

        <div class="info-card">
          <h3>Emergency Savings</h3>
          <p>
            A funeral can be harder to absorb if it drains money needed for rent,
            groceries, transportation, or medical needs.
          </p>
        </div>

        <div class="info-card">
          <h3>Debt Pressure</h3>
          <p>
            Existing debt payments make funeral financing riskier because less
            monthly income is available for repayment.
          </p>
        </div>

        <div class="info-card">
          <h3>Income Flexibility</h3>
          <p>
            The same funeral cost creates different pressure depending on income,
            savings, help available, and regular monthly obligations.
          </p>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>Costs to Include in a Funeral Budget</h2>

      <p>
        Funeral quotes can vary because families choose different services,
        products, locations, and burial or cremation options. Ask for an
        itemized price list and separate required costs from optional upgrades.
      </p>

      <ul>
        <li>Funeral home basic service fees</li>
        <li>Viewing, ceremony, or memorial service costs</li>
        <li>Casket, urn, burial vault, or cremation container</li>
        <li>Burial plot, cemetery fees, and grave opening or closing</li>
        <li>Transportation, flowers, obituary notices, and printed materials</li>
        <li>Reception, travel, clergy, musician, or celebrant costs</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Lower-Cost Options to Consider</h2>

      <p>
        A lower funeral budget does not mean a less meaningful goodbye. Families
        can often reduce pressure by choosing direct cremation, a smaller
        memorial, a home or church gathering, fewer upgrades, or a simpler
        service plan.
      </p>

      <p>
        The goal is not to spend the least possible amount. The goal is to avoid
        making a painful moment even harder with debt that lasts long after the
        service is over.
      </p>
    </section>

    <section class="content-section">
      <h2>Related Financial Calculators</h2>

      <div class="link-grid">
        <a class="link-card" href="/how-much-debt-is-too-much">
          <strong>Debt Pressure Calculator</strong>
          <span>
            See how existing debt payments affect funeral affordability and
            other major spending decisions.
          </span>
        </a>

        <a class="link-card" href="/how-much-debt-is-too-much">
          <strong>Protecting Emergency Savings</strong>
          <span>
            Understand how much cushion to keep before using savings for a major
            unexpected expense.
          </span>
        </a>

        <a class="link-card" href="/what-counts-as-debt">
          <strong>What Counts as Debt?</strong>
          <span>
            Review which monthly obligations should be included when evaluating
            affordability.
          </span>
        </a>

<a class="link-card" href="/should-i-spend-1500-on-groceries-per-month">
  <strong>$1,500 Grocery Budget Calculator</strong>
  <span>
    Compare funeral costs against recurring monthly pressure from groceries,
    debt, savings, and household expenses.
  </span>
</a>

        <a class="link-card" href="/calculators">
          <strong>All Financial Calculators</strong>
          <span>
            Browse all ShouldISpend calculators for debt, groceries, weddings,
            cars, travel, rent, and major expenses.
          </span>
        </a>
      </div>
    </section>

    <FAQSection title="Funeral Cost FAQ" faqs={funeralFaqs} />
  </main>

    <script>
  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  const getNumber = (id) => {
    const rawValue = document.getElementById(id)?.value;
    const value = Number(rawValue);
    return Number.isFinite(value) && value >= 0 ? value : 0;
  };

  function getPressureLevel(score) {
    if (score <= 30) {
      return {
        label: "Low Pressure",
        stress: "Low pressure",
        colorClass: "safe",
        action: "Proceed while keeping the service itemized and controlled.",
      };
    }

    if (score <= 60) {
      return {
        label: "Moderate Pressure",
        stress: "Moderate pressure",
        colorClass: "caution",
        action: "Compare lower-cost options and protect emergency savings.",
      };
    }

    return {
      label: "High Pressure",
      stress: "High pressure",
      colorClass: "danger",
      action: "Reduce the funeral cost, seek help, or avoid high-interest debt.",
    };
  }

  const button = document.getElementById("calculateButton");
  const result = document.getElementById("result");
  const scoreText = document.getElementById("scoreText");
  const scoreFill = document.getElementById("scoreFill");
  const resultDetails = document.getElementById("resultDetails");
  const guidance = document.getElementById("guidance");

  button?.addEventListener("click", () => {
    const cost = getNumber("cost");
    const savings = getNumber("savings");
    const help = getNumber("help");
    const income = getNumber("income");
    const debt = getNumber("debt");
    const emergencyTarget = getNumber("emergencyTarget");

    result?.classList.add("visible");

    if (cost <= 0 || income <= 0) {
      scoreText.textContent = "Add your numbers first";
      scoreFill.style.width = "0%";
      scoreFill.className = "fill safe";
      resultDetails.innerHTML =
        "<p>Enter a positive funeral cost and monthly take-home income so the calculator can estimate financial pressure.</p>";
      guidance.textContent = "";
      return;
    }

    const outOfPocket = Math.max(cost - help, 0);
    const savingsAfter = savings - outOfPocket;
    const savingsImpact = savings > 0 ? (outOfPocket / savings) * 100 : 150;
    const monthlyIncomeImpact = (outOfPocket / income) * 100;
    const debtPaymentRatio = income > 0 ? (debt / income) * 100 : 100;
    const emergencyTargetRemaining =
      emergencyTarget > 0 ? (savingsAfter / emergencyTarget) * 100 : null;

    let pressureScore = 0;

    const hasAbsurdSavings =
      savings >= outOfPocket * 100 &&
      savingsAfter >= Math.max(emergencyTarget, income * 6);

    const hasAbsurdIncome =
  outOfPocket > 0 &&
  monthlyIncomeImpact <= 2 &&
  debtPaymentRatio <= 5 &&
  savingsAfter >= 0;

    const fullyCovered = outOfPocket <= 0;

    if (fullyCovered || hasAbsurdSavings || hasAbsurdIncome) {
      pressureScore = 0;
    } else {
      pressureScore += clamp(savingsImpact * 0.45, 0, 38);
      pressureScore += clamp(monthlyIncomeImpact * 0.32, 0, 28);
      pressureScore += clamp(debtPaymentRatio * 0.3, 0, 18);

      if (outOfPocket > savings) pressureScore += 26;

      if (savingsAfter < 0) {
        pressureScore += 24;
      } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget * 0.5) {
        pressureScore += 14;
      } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget) {
        pressureScore += 7;
      } else if (emergencyTarget > 0 && savingsAfter >= emergencyTarget * 3) {
        pressureScore -= 12;
      } else if (savingsAfter >= income * 6) {
        pressureScore -= 10;
      }

      if (monthlyIncomeImpact > 300) pressureScore += 18;
      else if (monthlyIncomeImpact > 200) pressureScore += 12;
      else if (monthlyIncomeImpact > 100) pressureScore += 6;

      if (debtPaymentRatio >= 45) pressureScore += 14;
      else if (debtPaymentRatio >= 30) pressureScore += 9;
      else if (debtPaymentRatio >= 20) pressureScore += 4;

      if (
  monthlyIncomeImpact <= 2 &&
  debtPaymentRatio <= 5 &&
  savingsAfter >= 0
) {
  pressureScore = 0;
} else if (
  savingsImpact <= 0.5 &&
  monthlyIncomeImpact <= 5 &&
  savingsAfter >= emergencyTarget
) {
        pressureScore = Math.min(pressureScore, 3);
      } else if (
        savingsImpact <= 1 &&
        monthlyIncomeImpact <= 10 &&
        savingsAfter >= Math.max(emergencyTarget, income * 3)
      ) {
        pressureScore = Math.min(pressureScore, 8);
      } else if (
        savingsImpact <= 3 &&
        monthlyIncomeImpact <= 20 &&
        savingsAfter >= emergencyTarget
      ) {
        pressureScore = Math.min(pressureScore, 15);
      }
    }

    pressureScore = clamp(Math.round(pressureScore), 0, 100);

    const level = getPressureLevel(pressureScore);

    scoreText.textContent = `${level.label} — ${pressureScore}/100`;
    scoreFill.style.width = `${pressureScore}%`;
    scoreFill.className = `fill ${level.colorClass}`;

    resultDetails.innerHTML = `
      <p><strong>Pressure level:</strong> ${level.stress}.</p>
      <p><strong>Estimated out-of-pocket cost:</strong> $${outOfPocket.toLocaleString()} after insurance or family help.</p>
      <p><strong>Savings impact:</strong> ${savings > 0 ? `${savingsImpact.toFixed(1)}% of available savings.` : "No available savings entered."}</p>
      <p><strong>Estimated savings after funeral:</strong> $${savingsAfter.toLocaleString()}.</p>
      <p><strong>Monthly income impact:</strong> ${monthlyIncomeImpact.toFixed(1)}% of one month’s take-home income.</p>
      <p><strong>Debt payment pressure:</strong> ${debtPaymentRatio.toFixed(1)}% of monthly take-home income.</p>
      ${
        emergencyTargetRemaining !== null
          ? `<p><strong>Emergency target after funeral:</strong> ${emergencyTargetRemaining.toFixed(1)}% of target remaining.</p>`
          : ""
      }
    `;

    if (pressureScore === 0) {
      guidance.textContent =
        `This funeral cost creates essentially no measurable financial pressure based on the numbers provided. The out-of-pocket cost is extremely small relative to available savings or income, and emergency reserves remain protected. Recommended next step: ${level.action}`;
    } else if (pressureScore <= 30) {
      guidance.textContent =
        `This funeral cost appears manageable based on the numbers provided. The out-of-pocket cost equals about ${monthlyIncomeImpact.toFixed(1)}% of one month’s take-home income and ${savingsImpact.toFixed(1)}% of available savings. Recommended next step: ${level.action}`;
    } else if (pressureScore <= 60) {
      guidance.textContent =
        `This funeral cost may be workable, but it deserves caution. The out-of-pocket cost equals about ${monthlyIncomeImpact.toFixed(1)}% of one month’s take-home income and ${savingsImpact.toFixed(1)}% of available savings, so itemized pricing and lower-cost options matter. Recommended next step: ${level.action}`;
    } else {
      guidance.textContent =
        `This funeral cost could create real financial strain. The out-of-pocket cost equals about ${monthlyIncomeImpact.toFixed(1)}% of one month’s take-home income and ${savingsImpact.toFixed(1)}% of available savings, so reducing costs, seeking help, or avoiding high-interest debt would be safer. Recommended next step: ${level.action}`;
    }
  });
</script>
</Layout>