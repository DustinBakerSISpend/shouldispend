---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import { calculators } from "../data/calculators.js";

const moveFaqs = [
  {
    question: "What is a good move pressure score?",
    answer:
      "A score under 30 usually means the move is not putting unusual pressure on savings or monthly cash flow. A score above 55 means the current version of the move deserves a second look before you sign anything.",
  },
  {
    question: "Should I move if rent goes up?",
    answer:
      "Maybe, but only if the reason is strong and the rest of the budget can absorb it. A rent increase paired with lease penalties and thin savings is the classic danger zone.",
  },
  {
    question: "Does this calculator count non-financial reasons?",
    answer:
      "Yes. Safety, job stability, family needs, and major commute changes can reduce pressure. Preference-only moves do not receive the same benefit.",
  },
  {
    question: "What if outside help covers the move?",
    answer:
      "Confirmed help lowers the upfront cash pressure. It does not erase a higher monthly rent problem, because that cost remains after move-in day.",
  },
];

const relatedCalculators = calculators
  .filter((calculator) =>
    [
      "/moving-cost-calculator",
      "/how-much-should-i-save-before-moving-out",
      "/first-apartment-cost-calculator",
      "/security-deposit-and-move-in-cost-calculator",
      "/first-apartment-furniture-cost-calculator",
      "/roommate-vs-living-alone-calculator",
      "/can-i-afford-to-move-out",
      "/moving-calculators",
    ].includes(calculator.href)
  )
  .filter((calculator) => calculator.href !== "/should-i-move-calculator")
  .slice(0, 6);
---

<Layout
  title="Should I Move Calculator | ShouldISpend"
  description="Score whether moving makes financial sense based on cash needed, savings, rent change, lease timing, debt, commute, and reasons to move."
>
  <style>
    .container {
      max-width: 960px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin: 0 0 18px;
      font-size: 2rem;
      color: #0f172a;
    }

    .calculator-intro {
      margin: 0 0 30px;
      color: #334155;
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      margin-bottom: 10px;
      color: #0f172a;
      font-weight: 800;
    }

    .field input,
    .field select {
      width: 100%;
      box-sizing: border-box;
      padding: 16px;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      background: white;
      color: #0f172a;
      font: inherit;
    }

    .field small {
      display: block;
      margin-top: 8px;
      color: #64748b;
      line-height: 1.55;
    }

    .section-title {
      grid-column: 1 / -1;
      margin: 12px 0 -4px;
      padding-top: 18px;
      border-top: 1px solid #e2e8f0;
      color: #0f172a;
      font-size: 1.08rem;
    }

    .section-title:first-child {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .result-panel {
      margin-top: 36px;
      padding: 32px;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      background: #f8fafc;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    }

    .result-panel[hidden] {
      display: none !important;
    }

    .verdict {
      display: inline-flex;
      align-items: center;
      padding: 9px 14px;
      border-radius: 999px;
      background: #e2e8f0;
      color: #0f172a;
      font-weight: 900;
    }

    .score-row {
      display: grid;
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: 28px;
      align-items: end;
      margin-top: 28px;
    }

    .score-label {
      display: block;
      margin-bottom: 6px;
      color: #64748b;
      font-weight: 700;
    }

    .score-number {
      color: #0f172a;
      font-size: clamp(3rem, 8vw, 4.8rem);
      font-weight: 900;
      line-height: 0.95;
    }

    .score-copy {
      margin: 0;
      color: #334155;
      font-size: 1.02rem;
      line-height: 1.7;
    }

    .pressure-track {
      height: 14px;
      margin-top: 24px;
      overflow: hidden;
      border-radius: 999px;
      background: #e2e8f0;
    }

    .pressure-fill {
      width: 0;
      height: 100%;
      border-radius: inherit;
      background: #0f172a;
      transition: width 0.25s ease;
    }

    .result-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-top: 26px;
    }

    .metric {
      padding: 20px;
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      background: white;
    }

    .metric span {
      display: block;
      margin-bottom: 8px;
      color: #475569;
      font-weight: 700;
      line-height: 1.45;
    }

    .metric strong {
      color: #0f172a;
      font-size: 1.45rem;
    }

    .red-flags {
      margin-top: 22px;
      padding: 22px;
      border: 1px solid #fecaca;
      border-radius: 18px;
      background: #fff7f7;
    }

    .red-flags h3 {
      margin: 0 0 12px;
      color: #0f172a;
    }

    .red-flags ul {
      margin: 0;
      padding-left: 22px;
      color: #334155;
      line-height: 1.7;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      margin: 0 0 18px;
      color: #0f172a;
      font-size: 1.8rem;
    }

    .content-section h3 {
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      color: #334155;
      line-height: 1.8;
    }

    .content-section ul {
      padding-left: 24px;
    }

    .score-guide {
      padding: 30px;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      background: white;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    }

    .score-guide-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 24px;
    }

    .score-guide-card {
      padding: 20px;
      border: 1px solid #e2e8f0;
      border-radius: 18px;
      background: #f8fafc;
    }

    .score-guide-card strong {
      display: block;
      margin-bottom: 6px;
      color: #0f172a;
      font-size: 1.05rem;
    }

    .score-guide-card span {
      color: #475569;
      line-height: 1.6;
    }

    @media (max-width: 720px) {
      .calculator {
        padding: 26px;
      }

      .grid,
      .score-row,
      .result-grid,
      .score-guide-grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .result-panel {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Moving Decision Calculator"
      title="Should I Move Calculator"
      description="Score whether moving makes financial sense using upfront cash, emergency savings, monthly housing change, debt, commute, lease timing, and the reason for the move."
    >
      <div class="calculator">
        <h2>Should You Move?</h2>

        <p class="calculator-intro">
          Enter what you know about the move. The calculator weighs upfront cash,
          savings left afterward, monthly budget pressure, lease timing, and
          whether the move solves a serious job, safety, health, or family need.
        </p>

        <form id="moveForm" novalidate>
          <div class="grid">
            <h3 class="section-title">Cash needed to move</h3>

            <div class="field">
              <label for="moveCost">Upfront Moving and Move-In Cost</label>
              <input id="moveCost" type="number" inputmode="decimal" min="0" step="50" placeholder="Example: 4500" />
              <small>Deposits, movers, truck, boxes, setup fees, utility deposits, and first rent gap.</small>
            </div>

            <div class="field">
              <label for="leaseBreakCost">Lease Break or Overlap Cost</label>
              <input id="leaseBreakCost" type="number" inputmode="decimal" min="0" step="50" placeholder="Example: 1800" />
              <small>Penalty, notice period, rent overlap, reletting fee, or lost deposit risk.</small>
            </div>

            <div class="field">
              <label for="outsideHelp">Confirmed Outside Help</label>
              <input id="outsideHelp" type="number" inputmode="decimal" min="0" step="50" placeholder="Example: 1000" />
              <small>Employer relocation money, family help, roommate contribution, or reimbursements.</small>
            </div>

            <div class="field">
              <label for="emergencySavings">Emergency Savings Available</label>
              <input id="emergencySavings" type="number" inputmode="decimal" min="0" step="100" placeholder="Example: 9000" />
              <small>Cash you could use without touching retirement or taking on high-interest debt.</small>
            </div>

            <h3 class="section-title">Monthly budget impact</h3>

            <div class="field">
              <label for="takeHomeIncome">Monthly Take-Home Income</label>
              <input id="takeHomeIncome" type="number" inputmode="decimal" min="0" step="50" placeholder="Example: 5200" />
              <small>After taxes, payroll deductions, and regular withholding.</small>
            </div>

            <div class="field">
              <label for="debtPayments">Monthly Debt Payments</label>
              <input id="debtPayments" type="number" inputmode="decimal" min="0" step="25" placeholder="Example: 650" />
              <small>Credit cards, student loans, auto loans, personal loans, and minimum payments.</small>
            </div>

            <div class="field">
              <label for="currentHousing">Current Rent or Mortgage</label>
              <input id="currentHousing" type="number" inputmode="decimal" min="0" step="25" placeholder="Example: 1500" />
              <small>Your current monthly housing payment.</small>
            </div>

            <div class="field">
              <label for="newHousing">New Rent or Mortgage</label>
              <input id="newHousing" type="number" inputmode="decimal" min="0" step="25" placeholder="Example: 1850" />
              <small>Expected new monthly housing payment.</small>
            </div>

            <div class="field">
              <label for="commuteChange">Monthly Commute Change</label>
              <input id="commuteChange" type="number" inputmode="decimal" step="25" placeholder="Example: -125" />
              <small>Use a negative number if the move saves money.</small>
            </div>

            <div class="field">
              <label for="monthlyFlexibility">Current Monthly Flexibility</label>
              <input id="monthlyFlexibility" type="number" inputmode="decimal" min="0" step="25" placeholder="Example: 900" />
              <small>What is left after normal bills, food, debt, and planned savings.</small>
            </div>

            <h3 class="section-title">Timing and reason quality</h3>

            <div class="field">
              <label for="leaseTiming">Lease Timing</label>
              <select id="leaseTiming">
                <option value="">Choose one</option>
                <option value="0">No lease issue or lease ends now</option>
                <option value="1">1 month or less remaining</option>
                <option value="2">2 to 3 months remaining</option>
                <option value="4">4 to 6 months remaining</option>
                <option value="7">7+ months remaining</option>
              </select>
            </div>

            <div class="field">
              <label for="jobReason">Job or Income Reason</label>
              <select id="jobReason">
                <option value="">Choose one</option>
                <option value="0">No job or income benefit</option>
                <option value="1">Some commute or job stability benefit</option>
                <option value="2">Major job, income, or career benefit</option>
              </select>
            </div>

            <div class="field">
              <label for="safetyReason">Safety or Household Stress Reason</label>
              <select id="safetyReason">
                <option value="">Choose one</option>
                <option value="0">No safety or stress issue</option>
                <option value="1">Moderate quality-of-life issue</option>
                <option value="2">Serious safety, health, or household issue</option>
              </select>
            </div>

            <div class="field">
              <label for="spaceReason">Space or Family Need</label>
              <select id="spaceReason">
                <option value="">Choose one</option>
                <option value="0">Mostly preference</option>
                <option value="1">Real but manageable need</option>
                <option value="2">Strong space, school, family, or caregiving need</option>
              </select>
            </div>
          </div>

          <div class="actions">
            <button class="sis-action-button sis-calculate-button" type="submit">
              Calculate Move Pressure
            </button>
            <button class="sis-action-button sis-reset-button" type="button" id="resetButton">
              Reset
            </button>
          </div>
        </form>

        <section id="resultPanel" class="result-panel" aria-live="polite" hidden>
          <div id="verdict" class="verdict">Verdict</div>

          <div class="score-row">
            <div>
              <span class="score-label">Move Pressure Score</span>
              <div><span id="pressureScore" class="score-number">0</span><strong>/100</strong></div>
            </div>
            <p id="scoreCopy" class="score-copy"></p>
          </div>

          <div class="pressure-track" aria-label="Move pressure bar">
            <div id="pressureFill" class="pressure-fill"></div>
          </div>

          <div class="result-grid">
            <div class="metric">
              <span>Cash Needed After Outside Help</span>
              <strong id="cashNeeded">$0</strong>
            </div>
            <div class="metric">
              <span>Emergency Savings After Move</span>
              <strong id="savingsAfter">$0</strong>
            </div>
            <div class="metric">
              <span>Monthly Budget Impact</span>
              <strong id="monthlyImpact">$0</strong>
            </div>
            <div class="metric">
              <span>Monthly Flexibility After Move</span>
              <strong id="flexAfter">$0</strong>
            </div>
          </div>

          <div class="red-flags">
            <h3>Red Flags Found</h3>
            <ul id="redFlagList"></ul>
          </div>
        </section>
      </div>

      <OmniStyleReviewBlock
        pageName="the moving decision calculator"
        pageType="calculator"
        reviewLabel="Last reviewed: July 2026"
        methodologyHref="/methodology/"
        editorialHref="/editorial-policy/"
        disclaimerHref="/disclaimer/"
        decisionFocus="moving cost, cash needed, savings, rent change, lease timing, debt, commute, income stability, emergency fund, and whether the move creates financial pressure"
      />

      <CorePageExamplesBlock
        title="Moving decision examples"
        intro="A move can be worth it, but the decision should include upfront cash, monthly change, lease timing, commute, savings, and debt."
        useCases={[
          "You are deciding whether moving makes financial sense.",
          "You need to compare upfront costs with monthly savings or higher rent.",
          "You want to include commute, lease timing, debt, and emergency savings.",
        ]}
        notEnough={[
          "You need legal, landlord, mortgage, or relocation advice.",
          "You need live housing prices or neighborhood recommendations.",
          "The move is mainly about safety, family emergency, or medical need.",
        ]}
        examples={[
          {
            label: "Lower monthly rent",
            takeaway: "A move can work if upfront costs are recovered quickly and savings stay intact.",
          },
          {
            label: "Higher rent for better commute",
            takeaway: "The tradeoff may be reasonable if the monthly pressure stays manageable.",
          },
          {
            label: "Moving on credit",
            takeaway: "Pressure rises if deposits, movers, and overlap create debt.",
          },
        ]}
        commonMistake="Judging the move by rent alone instead of total move-in cash, overlap, deposits, commute, and emergency savings."
        nextStep="Compare upfront cost, monthly change, and cash left after the move before deciding."
      />

      <section class="content-section score-guide">
        <h2>How to Read the Move Pressure Score</h2>
        <p>
          A high score does not mean you can never move. It means the current
          version of the move needs a safer cash, timing, or monthly-cost plan.
        </p>

        <div class="score-guide-grid">
          <div class="score-guide-card">
            <strong>0â€“29: Financially controlled</strong>
            <span>The move is not creating unusual pressure based on the numbers entered.</span>
          </div>
          <div class="score-guide-card">
            <strong>30â€“54: Workable with guardrails</strong>
            <span>The move may work, but the cash plan and monthly budget need discipline.</span>
          </div>
          <div class="score-guide-card">
            <strong>55â€“74: Delay or reduce cost</strong>
            <span>Improve cash, lease timing, or the monthly housing change before committing.</span>
          </div>
          <div class="score-guide-card">
            <strong>75â€“100: Too much pressure</strong>
            <span>The move is putting heavy strain on savings, cash flow, or lease timing.</span>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2>How the Should I Move Calculator Works</h2>
        <p>
          The calculator starts with the cash required to move, then subtracts
          confirmed outside help. It estimates savings left after the move, the
          monthly housing and commute change, the share of take-home income going
          to housing and debt, and the remaining monthly flexibility.
        </p>
        <p>
          The pressure score rises when the move consumes emergency savings,
          creates a large monthly increase, pushes housing above a safer share of
          take-home income, leaves little budget flexibility, or happens with bad
          lease timing. It can fall when the move saves monthly money or solves a
          serious job, safety, health, or family problem.
        </p>
      </section>

      <KeyCostCategories
        items={[
          {
            title: "Upfront move cash",
            description:
              "Deposits, application fees, movers, rental trucks, packing supplies, utility setup, cleaning, overlap rent, lease-break costs, storage, and first household restock.",
          },
          {
            title: "Monthly housing change",
            description:
              "The calculator compares the new rent or mortgage with the current housing payment instead of judging the new payment alone.",
          },
          {
            title: "Commute and flexibility",
            description:
              "A shorter commute can offset higher housing cost, while a more expensive commute can make an otherwise affordable move harder.",
          },
          {
            title: "Savings and outside help",
            description:
              "Confirmed reimbursements or family help reduce upfront pressure, but the calculator still tests the recurring monthly budget.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Move at the lease end instead of paying overlap, notice penalties, or a lease-break fee.",
          "Get written quotes for movers, truck rental, packing supplies, storage, and deposits before deciding.",
          "Ask whether an employer, roommate, family member, or landlord concession can cover part of the upfront cost.",
          "Use a smaller place, a different neighborhood, or a delayed move date if the monthly increase is the main problem.",
          "Sell or donate heavy furniture if it raises mover, truck, storage, or stair fees.",
        ]}
      />

      <section class="content-section" id="FinancialRedFlags">
        <h2>Moving Budget Red Flags</h2>
        <ul>
          <li>The move costs more cash than you have available.</li>
          <li>You would finish the move with less than one month of basic emergency cushion.</li>
          <li>The new rent or mortgage would take more than 35% of monthly take-home pay.</li>
          <li>The move raises monthly costs while debt payments are already heavy.</li>
          <li>The reason for moving is mostly preference, but the financial pressure is high.</li>
        </ul>
      </section>

      <CalculatorAssumptions
        items={[
          "Take-home income means after-tax monthly income.",
          "Emergency savings means cash that can be used without taking on new debt.",
          "Outside help only counts if it is confirmed, not hoped for.",
          "A negative commute change means the move saves money each month.",
          "The calculator is a planning tool, not legal, tax, mortgage, or lease advice.",
        ]}
      />

      <div class="content-section">
        <FAQSection title="Should I Move Calculator FAQ" faqs={moveFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>
  </div>

  <script is:inline>
const form = document.getElementById("moveForm");
      const resultPanel = document.getElementById("resultPanel");
      const resetButton = document.getElementById("resetButton");
      const money = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });

      function getNumber(id) {
        const raw = document.getElementById(id).value;
        if (raw === "" || raw === null) return 0;
        const parsed = Number(raw);
        return Number.isFinite(parsed) ? parsed : 0;
      }

      function getSelectNumber(id) {
        const raw = document.getElementById(id).value;
        if (raw === "" || raw === null) return 0;
        const parsed = Number(raw);
        return Number.isFinite(parsed) ? parsed : 0;
      }

      function clamp(value, min, max) {
        return Math.min(Math.max(value, min), max);
      }

      function formatSignedMoney(value) {
        if (value > 0) return "+" + money.format(value);
        if (value < 0) return "-" + money.format(Math.abs(value));
        return money.format(0);
      }

      form.addEventListener("submit", function (event) {
        event.preventDefault();

        const moveCost = getNumber("moveCost");
        const leaseBreakCost = getNumber("leaseBreakCost");
        const outsideHelp = getNumber("outsideHelp");
        const emergencySavings = getNumber("emergencySavings");
        const takeHomeIncome = getNumber("takeHomeIncome");
        const debtPayments = getNumber("debtPayments");
        const currentHousing = getNumber("currentHousing");
        const newHousing = getNumber("newHousing");
        const commuteChange = getNumber("commuteChange");
        const monthlyFlexibility = getNumber("monthlyFlexibility");
        const leaseTiming = getSelectNumber("leaseTiming");
        const jobReason = getSelectNumber("jobReason");
        const safetyReason = getSelectNumber("safetyReason");
        const spaceReason = getSelectNumber("spaceReason");

        const totalUpfront = moveCost + leaseBreakCost;
        const cashNeeded = Math.max(0, totalUpfront - outsideHelp);
        const savingsAfter = emergencySavings - cashNeeded;
        const monthlyImpact = (newHousing - currentHousing) + commuteChange;
        const flexAfter = monthlyFlexibility - monthlyImpact;

        const housingShare = takeHomeIncome > 0 ? newHousing / takeHomeIncome : 0;
        const debtShare = takeHomeIncome > 0 ? debtPayments / takeHomeIncome : 0;
        const monthlyImpactShare = takeHomeIncome > 0 ? monthlyImpact / takeHomeIncome : 0;
        /*
          Emergency floor:
          Use housing + debt + a basic living-cost allowance. Do not use 50% of take-home income
          as the emergency floor, because that punishes high-income households even when the move
          is tiny compared with savings and cash flow.
        */
        const basicMonthlyFloor = Math.max(newHousing + debtPayments + 1800, 1000);
        const emergencyTarget = basicMonthlyFloor * 3;

        let score = 32;

        if (takeHomeIncome <= 0) score += 12;

        if (cashNeeded > emergencySavings) score += 30;
        else if (emergencySavings > 0 && cashNeeded > emergencySavings * 0.75) score += 22;
        else if (emergencySavings > 0 && cashNeeded > emergencySavings * 0.5) score += 14;
        else if (cashNeeded === 0 && totalUpfront > 0) score -= 12;

        if (savingsAfter < 0) score += 18;
        else if (savingsAfter < 1000) score += 15;
        else if (savingsAfter < emergencyTarget * 0.5) score += 10;
        else if (savingsAfter >= emergencyTarget) score -= 8;

        if (monthlyImpactShare > 0.15) score += 20;
        else if (monthlyImpactShare > 0.1) score += 15;
        else if (monthlyImpactShare > 0.05) score += 8;
        else if (monthlyImpact < 0) score -= 10;

        if (housingShare > 0.45) score += 20;
        else if (housingShare > 0.35) score += 12;
        else if (takeHomeIncome > 0 && housingShare < 0.28) score -= 4;

        if (debtShare > 0.25) score += 12;
        else if (debtShare > 0.15) score += 7;

        if (flexAfter < 0) score += 18;
        else if (flexAfter < 250) score += 13;
        else if (flexAfter < 500) score += 8;
        else if (flexAfter > 1000) score -= 5;

        if (leaseTiming >= 7) score += 14;
        else if (leaseTiming >= 4) score += 9;
        else if (leaseTiming >= 2) score += 5;

        if (jobReason === 2) score -= 9;
        else if (jobReason === 1) score -= 4;

        if (safetyReason === 2) score -= 10;
        else if (safetyReason === 1) score -= 4;

        if (spaceReason === 2) score -= 5;
        else if (spaceReason === 0 && jobReason === 0 && safetyReason === 0 && monthlyImpact > 0) score += 6;

        const annualizedIncome = takeHomeIncome * 12;
        const cashNeededShareOfSavings = emergencySavings > 0 ? cashNeeded / emergencySavings : 1;
        const cashNeededShareOfMonthlyIncome = takeHomeIncome > 0 ? cashNeeded / takeHomeIncome : 1;
        const monthsOfSavingsAfterMove = basicMonthlyFloor > 0 ? savingsAfter / basicMonthlyFloor : 0;
        const monthlyImpactAbsShare = takeHomeIncome > 0 ? Math.abs(monthlyImpact) / takeHomeIncome : 1;

        /*
          Rich-person / high-reserve logic:
          The calculator should not treat a $5k-$10k move as dangerous when the user has
          very high liquid savings, very high take-home income, low housing share, and tiny
          monthly impact. Absolute dollars matter less than proportional strain.
        */
        if (
          takeHomeIncome >= 25000 &&
          emergencySavings >= 100000 &&
          cashNeededShareOfSavings <= 0.03 &&
          cashNeededShareOfMonthlyIncome <= 0.5 &&
          housingShare <= 0.2 &&
          debtShare <= 0.1 &&
          monthlyImpactAbsShare <= 0.05 &&
          flexAfter >= 0 &&
          monthsOfSavingsAfterMove >= 12
        ) {
          score = Math.min(score, 8);
        } else if (
          takeHomeIncome >= 12000 &&
          emergencySavings >= 50000 &&
          cashNeededShareOfSavings <= 0.06 &&
          cashNeededShareOfMonthlyIncome <= 0.75 &&
          housingShare <= 0.25 &&
          debtShare <= 0.15 &&
          monthlyImpactAbsShare <= 0.08 &&
          flexAfter >= 0 &&
          monthsOfSavingsAfterMove >= 6
        ) {
          score = Math.min(score, 18);
        } else if (
          emergencySavings >= 25000 &&
          cashNeededShareOfSavings <= 0.08 &&
          cashNeededShareOfMonthlyIncome <= 1 &&
          housingShare <= 0.3 &&
          debtShare <= 0.18 &&
          flexAfter >= 500 &&
          monthsOfSavingsAfterMove >= 4
        ) {
          score = Math.min(score, 28);
        }

        /*
          Outside-help override:
          If confirmed help fully covers the upfront move cost and the new monthly budget
          remains healthy, the move should not carry artificial cash pressure.
        */
        if (
          totalUpfront > 0 &&
          outsideHelp >= totalUpfront &&
          housingShare <= 0.3 &&
          debtShare <= 0.18 &&
          flexAfter >= 500 &&
          monthlyImpactAbsShare <= 0.08
        ) {
          score = Math.min(score, 10);
        }

        /*
          Final household-scale override:
          Some moves are objectively tiny compared with the household's income or liquid savings.
          In those cases, additive pressure rules like lease timing, housing ratio, or preference-only reason
          should not create a scary verdict.
        */
        const positiveMonthlyImpact = Math.max(0, monthlyImpact);
        const strongIncomeTinyMove =
          takeHomeIncome >= 15000 &&
          cashNeeded <= takeHomeIncome * 0.15 &&
          positiveMonthlyImpact <= takeHomeIncome * 0.04 &&
          newHousing <= takeHomeIncome * 0.18 &&
          debtPayments <= takeHomeIncome * 0.15 &&
          savingsAfter >= cashNeeded * 5;

        const strongSavingsTinyMove =
          emergencySavings >= 100000 &&
          cashNeeded <= emergencySavings * 0.06 &&
          savingsAfter >= basicMonthlyFloor * 6 &&
          positiveMonthlyImpact <= Math.max(takeHomeIncome * 0.05, 1500);

        const ultraHighReserveMove =
          emergencySavings >= 1000000 &&
          cashNeeded <= emergencySavings * 0.08 &&
          positiveMonthlyImpact <= Math.max(takeHomeIncome * 0.06, 2500);

        const householdScaleOverride =
          strongIncomeTinyMove ||
          strongSavingsTinyMove ||
          ultraHighReserveMove;

        if (householdScaleOverride) {
          score = 0;
        }
score = Math.round(clamp(score, 0, 100));

        let verdict = "";
        let scoreCopy = "";

        if (score <= 29) {
          verdict = "Move looks financially reasonable";
          scoreCopy = "The move has manageable pressure based on the numbers entered.";
        } else if (score <= 54) {
          verdict = "Move can work with guardrails";
          scoreCopy = "The move may be reasonable, but the cash plan and monthly budget need discipline.";
        } else if (score <= 74) {
          verdict = "Delay or reduce the move cost";
          scoreCopy = "The current version of the move creates real pressure. Improve cash, timing, or monthly cost.";
        } else {
          verdict = "Do not move yet unless it is urgent";
          scoreCopy = "The move is putting heavy pressure on savings, monthly flexibility, or lease timing.";
        }

        const flags = [];

        if (cashNeeded > emergencySavings) {
          flags.push("The upfront cash needed is higher than the emergency savings entered.");
        }
        if (savingsAfter < 1000) {
          flags.push("Savings after the move would be below a basic emergency cushion.");
        }
        if (takeHomeIncome > 0 && housingShare > 0.35) {
          flags.push("New housing cost is above 35% of monthly take-home income.");
        }
        if (monthlyImpact > 0 && takeHomeIncome > 0 && monthlyImpactShare > 0.1) {
          flags.push("The move raises monthly costs by more than 10% of take-home income.");
        }
        if (flexAfter < 0) {
          flags.push("The move appears to create negative monthly flexibility.");
        }
        if (debtShare > 0.2) {
          flags.push("Debt payments are already taking a large share of take-home income.");
        }
        if (leaseTiming >= 4 && leaseBreakCost === 0) {
          flags.push("Lease timing looks risky. Confirm penalties, notice rules, reletting fees, and rent overlap.");
        }
        if (jobReason === 0 && safetyReason === 0 && spaceReason === 0 && score > 54) {
          flags.push("The reason for moving appears preference-based while the financial pressure is high.");
        }
        if (
          score <= 10 &&
          cashNeededShareOfSavings <= 0.03 &&
          monthsOfSavingsAfterMove >= 12 &&
          housingShare <= 0.2 &&
          monthlyImpactAbsShare <= 0.05
        ) {
          flags.length = 0;
          flags.push("No major financial red flags. The move cost is very small compared with the income and savings entered.");
        }

        if (householdScaleOverride) {
          flags.length = 0;
          flags.push("No major financial red flags. The move cost and monthly increase are tiny compared with the income or liquid savings entered.");
        }

        if (flags.length === 0) {
          flags.push("No major red flags based on the numbers entered. Still confirm lease terms and moving quotes before committing.");
        }

        document.getElementById("verdict").textContent = verdict;
        document.getElementById("pressureScore").textContent = String(score);
        document.getElementById("pressureFill").style.width = score + "%";
        document.getElementById("scoreCopy").textContent = scoreCopy;
        document.getElementById("cashNeeded").textContent = money.format(cashNeeded);
        document.getElementById("savingsAfter").textContent = money.format(savingsAfter);
        document.getElementById("monthlyImpact").textContent = formatSignedMoney(monthlyImpact);
        document.getElementById("flexAfter").textContent = money.format(flexAfter);

        const flagList = document.getElementById("redFlagList");
        flagList.innerHTML = "";
        flags.forEach(function (flag) {
          const li = document.createElement("li");
          li.textContent = flag;
          flagList.appendChild(li);
        });

        resultPanel.hidden = false;
      });

      resetButton.addEventListener("click", function () {
        form.reset();
        resultPanel.hidden = true;
        document.getElementById("pressureFill").style.width = "0%";
      });
  </script>
</Layout>