---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const groceryFaqs = [
  {
    question: "Is $1,500 a month too much for groceries?",
    answer:
      "$1,500 per month can be reasonable for larger households, high-cost areas, special diets, or families replacing restaurant spending with home cooking. It becomes riskier when it crowds out savings, debt payoff, rent, utilities, or emergency flexibility.",
  },
  {
    question: "What household size makes a $1,500 grocery budget more reasonable?",
    answer:
      "A $1,500 grocery budget looks very different for one person than it does for a family of four, five, or six. Per-person grocery spending is one of the most important context points.",
  },
  {
    question: "Should restaurants and takeout count with groceries?",
    answer:
      "Usually, no. Groceries and dining out should often be tracked separately. But total food spending matters because groceries plus restaurants can create real monthly pressure.",
  },
  {
    question: "Can inflation make $1,500 groceries normal?",
    answer:
      "Higher food prices can make larger grocery bills more common, but the important question is whether the spending still fits income, savings, debt, and monthly flexibility.",
  },
];
---

<Layout
  title="Should I Spend $1,500 on Groceries Per Month?"
  description="Use this grocery budget calculator to evaluate whether spending $1,500 per month on groceries fits your income, household size, debt, savings, and financial flexibility."
>
  <style>
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.6rem, 7vw, 4.7rem);
      line-height: 0.95;
      margin-bottom: 24px;
      color: var(--text);
      max-width: 900px;
    }

    .intro {
      max-width: 820px;
      color: var(--muted);
      font-size: 1.12rem;
      line-height: 1.85;
      margin-bottom: 48px;
    }

    .calculator-box,
    .info-card,
    .link-card {
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 22px;
      padding: 24px;
    }

    .calculator-box {
      margin-bottom: 40px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-top: 18px;
    }

    label {
      display: block;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 8px;
      font-size: 0.95rem;
    }

    input {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      font-size: 1rem;
      background: white;
      color: var(--text);
    }

    button {
      margin-top: 22px;
      border: none;
      border-radius: 999px;
      padding: 14px 22px;
      background: #0f766e;
      color: white;
      font-weight: 800;
      font-size: 0.95rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.15s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 32px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 32px;
      display: none;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
    }

    .result.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: var(--muted);
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin-bottom: 12px;
    }

    .fine-print {
      color: var(--muted);
      font-size: 0.9rem;
      margin-top: 20px;
    }

    section {
      margin-top: 64px;
    }

    h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 18px;
      color: var(--text);
    }

    h3 {
      font-size: 1.25rem;
      color: var(--text);
      margin: 0 0 10px;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.05rem;
    }

    .info-grid,
    .link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
      margin-top: 24px;
    }

    .info-card p,
    .link-card span {
      margin: 0;
      color: var(--muted);
      line-height: 1.65;
      font-size: 0.95rem;
    }

    .link-card {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .link-card strong {
      display: block;
      color: var(--text);
      margin-bottom: 8px;
      line-height: 1.3;
    }

    .note {
      font-size: 0.92rem;
      color: var(--muted);
      margin-top: 14px;
    }
  </style>

  <main class="container">
    <div class="eyebrow">Grocery Budget Calculator</div>

    <h1>Should I Spend $1,500 on Groceries Per Month?</h1>

    <p class="intro">
      A $1,500 monthly grocery bill can be reasonable for some households and
      financially stressful for others. This calculator evaluates whether that
      grocery budget fits your income, household size, debt load, emergency
      savings, dining out habits, and overall monthly flexibility.
    </p>

    <section class="calculator-box">
      <h2>$1,500 Monthly Grocery Budget Calculator</h2>

      <p>
        This calculator starts with a $1,500 grocery budget. Enter your income,
        household size, debt, savings, and dining out spending to see whether
        that monthly food cost looks manageable, elevated, or financially tight.
      </p>

      <div class="form-grid">
        <div>
          <label for="groceries">Monthly grocery spending</label>
          <input id="groceries" type="number" value="1500" />
        </div>

        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 7500" />
        </div>

        <div>
          <label for="household">Household size</label>
          <input id="household" type="number" placeholder="Example: 4" />
        </div>

        <div>
          <label for="debt">Monthly debt payments</label>
          <input id="debt" type="number" placeholder="Example: 900" />
        </div>

        <div>
          <label for="savings">Emergency savings</label>
          <input id="savings" type="number" placeholder="Example: 15000" />
        </div>

        <div>
          <label for="dining">Monthly dining out / takeout</label>
          <input id="dining" type="number" placeholder="Example: 350" />
        </div>
      </div>

      <button id="calculateButton" type="button">Review $1,500 Grocery Budget</button>

      <p class="note">
        This calculator uses simplified educational estimates. It is not
        financial advice.
      </p>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="fill" id="scoreFill"></div>
        </div>

        <div class="result-details" id="resultDetails"></div>

        <div class="fine-print">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </section>

    <section>
      <h2>When $1,500 on Groceries Can Make Sense</h2>

      <p>
        A $1,500 grocery budget may be reasonable for a larger household, a
        high-cost area, a family with specific dietary needs, or a household
        that cooks at home instead of spending heavily at restaurants.
      </p>

      <p>
        The number becomes more concerning when it combines with high dining
        out spending, weak emergency savings, heavy debt payments, or a rent
        and utility burden that already leaves little monthly room.
      </p>
    </section>

    <section>
      <h2>What Makes a $1,500 Grocery Budget Risky?</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Small Household Size</h3>
          <p>
            $1,500 per month looks much heavier for one or two people than for a
            larger family.
          </p>
        </div>

        <div class="info-card">
          <h3>High Dining Out Spending</h3>
          <p>
            Groceries may be only part of the issue if restaurants, takeout,
            delivery, and coffee spending are also high.
          </p>
        </div>

        <div class="info-card">
          <h3>Thin Emergency Savings</h3>
          <p>
            A large grocery budget is riskier when the household has little
            cushion for surprise expenses.
          </p>
        </div>

        <div class="info-card">
          <h3>Heavy Debt Payments</h3>
          <p>
            Debt payments reduce the flexibility needed to absorb higher food
            prices or irregular monthly expenses.
          </p>
        </div>
      </div>
    </section>

    <section>
      <h2>$1,500 Groceries vs. Total Food Spending</h2>

      <p>
        A $1,500 grocery bill does not tell the whole story. If restaurant
        spending is low, the household may simply be buying most food at the
        grocery store. If dining out is also high, total food spending may be
        creating more pressure than the grocery number alone suggests.
      </p>

      <p>
        For most households, the better question is not whether $1,500 sounds
        high in isolation. The better question is whether total food spending
        still leaves room for savings, housing, transportation, debt payoff,
        insurance, and normal life.
      </p>
    </section>

    <section>
      <h2>Related ShouldISpend Guides</h2>

      <div class="link-grid">
        <a class="link-card" href="/grocery-calculators">
          <strong>Grocery Budget Calculators</strong>
          <span>
            Browse grocery and food spending calculators for monthly budget
            decisions.
          </span>
        </a>

        <a class="link-card" href="/should-i-spend-this-much-on-groceries-per-month">
          <strong>Monthly Grocery Spending Calculator</strong>
          <span>
            Use the broader grocery calculator for any monthly grocery budget.
          </span>
        </a>

        <a class="link-card" href="/how-much-emergency-savings-should-i-have">
          <strong>Emergency Savings Guide</strong>
          <span>
            Understand how much cash cushion to keep before major or recurring
            spending decisions.
          </span>
        </a>

        <a class="link-card" href="/how-much-debt-is-too-much">
          <strong>How Much Debt Is Too Much?</strong>
          <span>
            Learn how monthly obligations and debt pressure affect financial
            flexibility.
          </span>
        </a>
      </div>
    </section>

    <FAQSection title="$1,500 Grocery Budget FAQ" faqs={groceryFaqs} />
  </main>

  <script>
  const button = document.getElementById("calculateButton");
  const result = document.getElementById("result");
  const scoreText = document.getElementById("scoreText");
  const scoreFill = document.getElementById("scoreFill");
  const resultDetails = document.getElementById("resultDetails");

  button?.addEventListener("click", () => {
    const groceries = Number(document.getElementById("groceries").value);
    const income = Number(document.getElementById("income").value);
    const household = Number(document.getElementById("household").value);
    const debt = Number(document.getElementById("debt").value || 0);
    const savings = Number(document.getElementById("savings").value || 0);
    const dining = Number(document.getElementById("dining").value || 0);

    result?.classList.add("visible");

    if (!groceries || !income || !household) {
      scoreText.textContent = "Add the Core Numbers First";
      scoreFill.style.width = "0%";
      scoreFill.className = "fill";
      resultDetails.innerHTML = `
        <p>Enter monthly grocery spending, monthly take-home income, and household size to review the grocery budget.</p>
      `;
      return;
    }

    const groceryRatio = groceries / income;
    const foodRatio = (groceries + dining) / income;
    const groceriesPerPerson = groceries / household;
    const debtRatio = debt / income;
    const savingsMonths = savings / Math.max(income * 0.7, 1);

    let riskScore = 100;

    if (groceryRatio >= 1 || foodRatio >= 1) {
      riskScore = 0;
    } else {
      if (groceryRatio > 0.45) riskScore -= 55;
      else if (groceryRatio > 0.3) riskScore -= 40;
      else if (groceryRatio > 0.2) riskScore -= 28;
      else if (groceryRatio > 0.15) riskScore -= 18;
      else if (groceryRatio > 0.1) riskScore -= 10;
      else if (groceryRatio < 0.04) riskScore += 10;

      if (foodRatio > 0.5) riskScore -= 40;
      else if (foodRatio > 0.35) riskScore -= 28;
      else if (foodRatio > 0.25) riskScore -= 18;
      else if (foodRatio > 0.18) riskScore -= 10;
      else if (foodRatio < 0.08) riskScore += 8;

      if (household <= 2 && groceriesPerPerson > 500) riskScore -= 24;
      else if (groceriesPerPerson > 450) riskScore -= 16;
      else if (groceriesPerPerson > 350) riskScore -= 8;
      else if (groceriesPerPerson < 180) riskScore += 6;

      if (debtRatio > 0.45) riskScore -= 30;
      else if (debtRatio > 0.3) riskScore -= 20;
      else if (debtRatio > 0.2) riskScore -= 12;
      else if (debtRatio < 0.05) riskScore += 5;

      if (savingsMonths < 1) riskScore -= 28;
      else if (savingsMonths < 3) riskScore -= 18;
      else if (savingsMonths < 6) riskScore -= 8;
      else if (savingsMonths > 12) riskScore += 8;

      riskScore = Math.max(0, Math.min(100, Math.round(riskScore)));
    }

    let verdict = "Strong Grocery Budget";
    let explanation =
      "Based on the numbers entered, this grocery budget appears highly manageable relative to income, household size, debt, savings, and total food spending.";

    if (riskScore === 0) {
      verdict = "Impossible Grocery Budget";
      explanation =
        "This grocery budget is equal to or greater than monthly take-home income. Recheck the number entered or reduce the budget dramatically.";
    } else if (riskScore < 35) {
      verdict = "Severe Grocery Budget Pressure";
      explanation =
        "This grocery budget looks financially unsustainable relative to income, household size, total food spending, debt, or savings cushion.";
    } else if (riskScore < 50) {
      verdict = "High Grocery Budget Pressure";
      explanation =
        "This grocery budget looks tight and may be reducing flexibility elsewhere in the budget.";
    } else if (riskScore < 75) {
      verdict = "Manageable With Guardrails";
      explanation =
        "This grocery budget may be reasonable, but there are signs of pressure. Review total food spending, dining out, debt payments, and savings room.";
    } else if (riskScore < 90) {
      verdict = "Comfortable Grocery Budget";
      explanation =
        "This grocery budget appears manageable, though it is still worth tracking total food spending and savings progress.";
    }

    scoreText.textContent = `${verdict} - ${riskScore}/100`;

    scoreFill.style.width = `${Math.max(riskScore, 6)}%`;
    scoreFill.className = "fill";

    if (riskScore >= 75) {
      scoreFill.classList.add("safe");
    } else if (riskScore >= 50) {
      scoreFill.classList.add("caution");
    } else {
      scoreFill.classList.add("danger");
    }

    resultDetails.innerHTML = `
      <p><strong>Grocery impact:</strong> ${(groceryRatio * 100).toFixed(1)}% of monthly take-home income.</p>
      <p><strong>Total food impact:</strong> ${(foodRatio * 100).toFixed(1)}% of monthly take-home income, including dining out and takeout.</p>
      <p><strong>Groceries per person:</strong> $${groceriesPerPerson.toFixed(0)} per month.</p>
      <p><strong>Debt impact:</strong> ${(debtRatio * 100).toFixed(1)}% of monthly take-home income.</p>
      <p><strong>Emergency savings cushion:</strong> About ${savingsMonths.toFixed(1)} months of estimated core expenses.</p>
      <p>${explanation}</p>
    `;
  });
</script>
</Layout>