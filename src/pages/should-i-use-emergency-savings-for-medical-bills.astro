---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const medicalSavingsFaqs = [
  {
    question: "Should I use emergency savings for medical bills?",
    answer:
      "Emergency savings are often meant for unavoidable costs like medical bills. The key is whether using the money leaves you with enough cushion afterward.",
  },
  {
    question: "Is it better to use savings or a payment plan?",
    answer:
      "A payment plan may help preserve cash, but it can also reduce monthly flexibility. The safer choice depends on the bill size, remaining savings, debt pressure, and whether the plan has interest.",
  },
  {
    question: "Should I use a credit card for medical bills?",
    answer:
      "A credit card can become risky if the balance carries high interest. Before using one, ask the provider about payment plans, financial assistance, or other billing options.",
  },
  {
    question: "How much emergency savings should remain after a medical bill?",
    answer:
      "Many households should try to keep at least a starter cushion after paying a medical bill, especially if income is unstable, debt is high, or dependents rely on the household.",
  },
];
---

<Layout
  title="Should I Use Emergency Savings for Medical Bills? | Calculator"
  description="Evaluate whether using emergency savings for medical bills is financially safe based on savings left, bill size, debt pressure, income, and payment options."
>
  <style>
    .container {
      width: 92%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 72px 0;
    }

    .hero {
      max-width: 860px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(2.8rem, 6vw, 5rem);
      line-height: 1;
      margin-bottom: 24px;
      color: var(--primary);
    }

    .hero p,
    .section p {
      font-size: 1.05rem;
      line-height: 1.9;
      color: var(--muted);
    }

    .calculator {
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 24px;
      padding: 32px;
      margin-bottom: 72px;
    }

    .calc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }

    .calc-field {
      display: flex;
      flex-direction: column;
    }

    .calc-field label {
      font-weight: 700;
      margin-bottom: 10px;
      color: var(--text);
    }

    .calc-field input,
    .calc-field select {
      padding: 14px;
      border-radius: 12px;
      border: 1px solid var(--border);
      font-size: 1rem;
    }

    .calc-button {
      margin-top: 26px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 14px;
      padding: 15px 22px;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
    }

    .calc-results {
      margin-top: 30px;
      border: 1px solid #dbe4ee;
      background: #f8fafc;
      border-radius: 20px;
      padding: 26px;
      display: none;
    }

    .calc-results.active {
      display: block;
    }

    .calc-verdict {
      font-size: 2rem;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 16px;
    }

    .calc-stat {
      font-size: 1.1rem;
      margin-bottom: 12px;
      color: var(--text);
    }

    .risk-bar {
      width: 100%;
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin: 24px 0;
    }

    .risk-fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.35s ease;
      background: var(--primary);
    }

    .calc-analysis {
      color: var(--muted);
      line-height: 1.8;
      margin-top: 18px;
    }

    .section {
      max-width: 860px;
      margin-top: 72px;
    }

    .section h2 {
      font-size: 2rem;
      margin-bottom: 22px;
      line-height: 1.2;
      color: var(--text);
    }

    .link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 22px;
      margin-top: 28px;
    }

    .link-card {
      display: block;
      border: 1px solid var(--border);
      background: white;
      border-radius: 18px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .link-card strong {
      display: block;
      margin-bottom: 10px;
      color: var(--text);
    }

    .link-card span {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
    }
  </style>

  <main class="container">
    <section class="hero">
      <div class="eyebrow">Medical Emergency Savings Calculator</div>

      <h1>Should I Use Emergency Savings for Medical Bills?</h1>

      <p>
        Medical bills are one of the reasons emergency savings exist. This
        calculator helps estimate whether using your emergency fund for healthcare
        costs protects stability or leaves your household financially exposed.
      </p>
    </section>

    <section class="calculator">
      <div class="calc-grid">
        <div class="calc-field">
          <label>Medical Bill Amount ($)</label>
          <input type="number" id="billAmount" placeholder="4000" />
        </div>

        <div class="calc-field">
          <label>Current Emergency Savings ($)</label>
          <input type="number" id="savingsAmount" placeholder="10000" />
        </div>

        <div class="calc-field">
          <label>Monthly Essential Expenses ($)</label>
          <input type="number" id="monthlyExpenses" placeholder="4500" />
        </div>

        <div class="calc-field">
          <label>Debt Pressure</label>
          <select id="debtPressure">
            <option value="low">Low</option>
            <option value="moderate">Moderate</option>
            <option value="high">High</option>
          </select>
        </div>

        <div class="calc-field">
          <label>Income Stability</label>
          <select id="incomeStability">
            <option value="stable">Stable</option>
            <option value="average">Average</option>
            <option value="unstable">Unstable</option>
          </select>
        </div>

        <div class="calc-field">
          <label>Payment Plan Available?</label>
          <select id="paymentPlan">
            <option value="yes">Yes</option>
            <option value="no">No</option>
          </select>
        </div>
      </div>

      <button class="calc-button" id="calculateMedicalSavings">
        Evaluate Emergency Savings Decision
      </button>

      <div class="calc-results" id="calcResults">
        <div class="calc-verdict" id="calcVerdict"></div>
        <div class="calc-stat" id="remainingSavings"></div>
        <div class="calc-stat" id="monthsRemaining"></div>

        <div class="risk-bar">
          <div class="risk-fill" id="riskFill"></div>
        </div>

        <div class="calc-analysis" id="calcAnalysis"></div>
      </div>
    </section>

    <section class="section">
      <h2>When Using Emergency Savings Makes Sense</h2>

      <p>
        Emergency savings are designed for unavoidable financial shocks. Medical
        bills often qualify, especially when delaying treatment could create
        larger health or financial problems later.
      </p>

      <p>
        The question is not only whether you can pay the bill. The stronger
        question is whether your household remains stable after the payment.
        A medical bill that drains savings completely can create new risk even
        when the care itself is necessary.
      </p>
    </section>

    <section class="section">
      <h2>Related Medical and Financial Pressure Tools</h2>

      <div class="link-grid">
        <a class="link-card" href="/should-i-spend-this-much-on-medical-bills">
          <strong>Medical Bill Calculator</strong>
          <span>
            Evaluate overall healthcare cost pressure using savings, debt,
            insurance, income, and payment options.
          </span>
        </a>

        <a class="link-card" href="/how-much-emergency-savings-should-i-have">
          <strong>Emergency Savings Calculator</strong>
          <span>
            Calculate a target emergency fund based on expenses, debt,
            dependents, job stability, and housing.
          </span>
        </a>

        <a class="link-card" href="/how-much-debt-is-too-much">
          <strong>How Much Debt Is Too Much?</strong>
          <span>
            See how debt obligations affect financial flexibility and monthly
            pressure.
          </span>
        </a>

        <a class="link-card" href="/medical-calculators">
          <strong>Medical Cost Calculators</strong>
          <span>
            Browse healthcare affordability tools for medical bills, savings,
            debt pressure, and payment plans.
          </span>
        </a>
      </div>
    </section>

    <FAQSection title="Emergency Savings and Medical Bills FAQ" faqs={medicalSavingsFaqs} />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const button = document.getElementById("calculateMedicalSavings");

      if (!button) return;

      button.addEventListener("click", function () {
        const billAmount = Number(document.getElementById("billAmount").value) || 0;
        const savingsAmount = Number(document.getElementById("savingsAmount").value) || 0;
        const monthlyExpenses = Number(document.getElementById("monthlyExpenses").value) || 0;
        const debtPressure = document.getElementById("debtPressure").value;
        const incomeStability = document.getElementById("incomeStability").value;
        const paymentPlan = document.getElementById("paymentPlan").value;

        const remaining = savingsAmount - billAmount;
        const monthsLeft =
          monthlyExpenses > 0 ? remaining / monthlyExpenses : 0;

        let riskScore = 0;

        if (remaining < 0) riskScore += 40;
        else if (monthsLeft < 1) riskScore += 35;
        else if (monthsLeft < 3) riskScore += 20;
        else if (monthsLeft < 6) riskScore += 10;

        if (debtPressure === "moderate") riskScore += 15;
        if (debtPressure === "high") riskScore += 30;

        if (incomeStability === "average") riskScore += 10;
        if (incomeStability === "unstable") riskScore += 25;

        if (paymentPlan === "no") riskScore += 10;

        if (riskScore > 100) riskScore = 100;

        let verdict = "";
        let analysis = "";

        if (riskScore <= 30) {
          verdict = "Reasonable Use of Emergency Savings";
          analysis =
            "Using emergency savings for this medical bill appears manageable because enough cushion may remain afterward.";
        } else if (riskScore <= 60) {
          verdict = "Use Savings Carefully";
          analysis =
            "This medical bill may be necessary, but using savings could leave your household with reduced flexibility afterward.";
        } else {
          verdict = "High Post-Bill Financial Risk";
          analysis =
            "This bill may seriously weaken your emergency cushion. Ask about payment plans, financial assistance, or ways to avoid high-interest debt if possible.";
        }

        const riskFill = document.getElementById("riskFill");

        riskFill.style.width = `${riskScore}%`;

        if (riskScore <= 30) {
          riskFill.style.background = "#0f766e";
        } else if (riskScore <= 60) {
          riskFill.style.background = "#ca8a04";
        } else {
          riskFill.style.background = "#dc2626";
        }

        document.getElementById("calcResults").classList.add("active");
        document.getElementById("calcVerdict").innerText = verdict;

        document.getElementById("remainingSavings").innerText =
          `Emergency Savings Left After Bill: $${remaining.toLocaleString()}`;

        document.getElementById("monthsRemaining").innerText =
          `Months of Essential Expenses Remaining: ${Math.max(monthsLeft, 0).toFixed(1)}`;

        document.getElementById("calcAnalysis").innerText = analysis;
      });
    });
  </script>
</Layout>