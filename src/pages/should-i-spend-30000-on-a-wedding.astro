---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import { calculators } from "../data/calculators.js";

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "Weddings" &&
      calculator.href !== "/should-i-spend-30000-on-a-wedding"
  )
  .slice(0, 4);
---

<Layout title="Should I Spend $30,000 on a Wedding?">
  <style>
    .container {
      max-width: 920px;
      margin: auto;
    }

    .content-section {
      max-width: 760px;
      margin: 0 auto 56px auto;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 24px;
      line-height: 1.2;
    }

    .content-section h3 {
      font-size: 1.25rem;
      margin: 28px 0 10px;
      color: var(--navy);
    }

    .content-section p,
    .content-section li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
    }

    .content-section p {
      margin-bottom: 24px;
    }

    .content-section ul {
      padding-left: 24px;
      margin-top: 0;
    }

    .content-section a {
      color: var(--teal);
      font-weight: 700;
    }

    .eyebrow {
      text-align: center;
      color: var(--teal);
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    h1 {
      font-size: 56px;
      text-align: center;
      margin: 0 0 16px;
      color: var(--navy);
      line-height: 1.05;
    }

    .subtitle {
      text-align: center;
      font-size: 22px;
      color: var(--muted);
      margin: 0 auto 42px;
      line-height: 1.5;
      max-width: 760px;
    }

    .calculator {
      background: var(--card);
      border-radius: 24px;
      padding: 38px;
      box-shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
      border: 1px solid rgba(15, 23, 42, 0.05);
      margin-bottom: 56px;
    }

    .calculator h2 {
      margin-top: 0;
      color: var(--navy);
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    label {
      display: block;
      font-weight: 800;
      margin-bottom: 9px;
      color: var(--navy);
    }

    input {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid var(--border);
      font-size: 18px;
      box-sizing: border-box;
    }

    input:focus {
      outline: 3px solid rgba(15, 118, 110, 0.18);
      border-color: var(--teal);
    }

    button {
      margin-top: 28px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 28px;
      border-radius: 14px;
      font-size: 19px;
      font-weight: 900;
      cursor: pointer;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 34px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 30px;
      display: none;
    }

    .score {
      font-size: 36px;
      font-weight: 900;
      margin-bottom: 18px;
      color: var(--navy);
    }

    .bar {
      height: 16px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .bar-fill {
      height: 100%;
      background: var(--teal);
      width: 0%;
      transition: width 0.4s ease;
    }

    .line {
      margin-bottom: 12px;
      font-size: 18px;
      color: var(--text);
    }

    .guidance {
      margin-top: 26px;
      font-size: 20px;
      line-height: 1.6;
      color: var(--navy);
    }

    .verdict-breakdown {
      margin-top: 18px;
      padding: 18px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 14px;
      font-size: 0.98rem;
      line-height: 1.65;
      color: var(--muted);
      display: none;
    }

    .verdict-breakdown strong {
      color: var(--text);
    }

    .disclaimer {
      margin-top: 22px;
      font-size: 13px;
      color: #64748b;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--teal);
      font-weight: 700;
    }

    .card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
    }

    .card h3 {
      font-size: 1.35rem;
      margin-bottom: 12px;
      line-height: 1.3;
    }

    .card p {
      color: #475569;
      line-height: 1.7;
      margin-bottom: 20px;
    }

    .card-category {
      color: var(--teal);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    @media (max-width: 700px) {
      body {
        padding: 28px 14px;
      }

      h1 {
        font-size: 38px;
      }

      .subtitle {
        font-size: 18px;
      }

      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .score {
        font-size: 28px;
      }
    }
  </style>

  <div class="container">
    <div class="eyebrow">Wedding Spending Calculator</div>

    <h1>Should I Spend $30,000 on a Wedding?</h1>

    <p class="subtitle">
      Get a practical verdict based on income, savings, debt, stress level, and
      how much of your financial cushion the wedding would consume.
    </p>

    <div class="calculator">
      <h2>Wedding Affordability Verdict</h2>

      <div class="grid">
        <div>
          <label>Combined Annual Income</label>
          <input id="income" type="number" placeholder="Example: 140000" />
        </div>

        <div>
          <label>Total Savings</label>
          <input id="savings" type="number" placeholder="Example: 50000" />
        </div>

        <div>
          <label>Wedding Cost</label>
          <input id="cost" type="number" placeholder="30000" />
        </div>

        <div>
          <label>Current Debt</label>
          <input id="debt" type="number" placeholder="Example: 12000" />

          <div class="helper-link">
            <a href="/what-counts-as-debt">
              Not sure what counts as debt? Read the debt guide
            </a>
          </div>
        </div>
      </div>

      <button id="weddingButton">Get Wedding Verdict</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="bar-fill" id="barFill"></div>
        </div>

        <div class="line" id="stress"></div>
        <div class="line" id="savingsImpact"></div>
        <div class="line" id="incomeImpact"></div>
        <div class="line" id="debtRatio"></div>

        <div class="guidance" id="guidance"></div>

        <div class="verdict-breakdown" id="verdictBreakdown"></div>

        <div class="disclaimer">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>What a $30,000 Wedding Really Costs</h2>

      <p>
        A $30,000 wedding is rarely just the venue bill. Catering, photography,
        attire, entertainment, flowers, decorations, alcohol, gratuities,
        rentals, transportation, and last-minute upgrades can push the real cost
        higher than expected.
      </p>

      <p>
        The bigger issue is what the wedding does to the couple’s financial
        flexibility after the celebration. A $30,000 wedding may feel manageable
        on paper, but it can become stressful if it drains emergency savings,
        adds debt, or delays larger goals like buying a home, paying off loans,
        or building long-term savings.
      </p>

      <p>
        This calculator looks at income, savings, current debt, and total cost
        because wedding affordability depends on the full financial picture, not
        just whether the couple can technically pay the bill.
      </p>
    </section>

    <section class="content-section">
      <h2>When a $30K Wedding Can Make Sense</h2>

      <p>
        A $30,000 wedding can be reasonable when the cost is planned in advance,
        paid mostly or entirely in cash, and does not damage the couple’s
        emergency fund or major financial goals.
      </p>

      <ul>
        <li>You have strong savings left after the wedding.</li>
        <li>You are not using high-interest debt to pay for the event.</li>
        <li>Your housing, retirement, and emergency savings goals remain intact.</li>
        <li>The guest count, venue, and vendor choices reflect your real budget.</li>
        <li>Both partners are comfortable with the tradeoffs.</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>When You Should Wait</h2>

      <p>
        A $30,000 wedding becomes risky when it requires credit cards, personal
        loans, depleted savings, or financial help that creates pressure after
        the event.
      </p>

      <p>
        It may also be worth waiting if the wedding would delay a home purchase,
        weaken your emergency fund, increase existing debt stress, or force you
        to cut back on basic financial stability for months or years afterward.
      </p>

      <p>
        A smaller wedding can still be meaningful while leaving more room for
        the life you are building after the wedding day.
      </p>
    </section>

    <section class="content-section">
      <h2>Hidden Wedding Costs to Consider</h2>

      <p>
        Wedding budgets often expand because couples focus on the headline venue
        or catering number while underestimating smaller costs that arrive later.
      </p>

      <ul>
        <li>Taxes, service charges, and gratuities</li>
        <li>Dress alterations, accessories, hair, and makeup</li>
        <li>Photography, video, music, and entertainment</li>
        <li>Invitations, postage, signage, and favors</li>
        <li>Transportation, hotel rooms, and rehearsal events</li>
        <li>Vendor meals, setup fees, overtime, and cleanup costs</li>
      </ul>

      <p>
        These costs matter because a wedding that begins as a $30,000 plan can
        quietly become a much larger commitment without strict guardrails.
      </p>
    </section>

    <section class="content-section">
      <h2>Financial Red Flags</h2>

      <p>
        Be careful if the wedding would leave little emergency savings, require
        high-interest debt, create arguments about money, or depend on future
        income that is not guaranteed.
      </p>

      <p>
        Another warning sign is feeling forced to spend more because of family
        expectations, social comparison, or fear that a smaller wedding will feel
        less legitimate.
      </p>

      <p>
        The healthiest wedding budget is one that lets you celebrate without
        creating a long financial recovery period afterward.
      </p>
    </section>

    <section class="content-section">
      <h2>What Your Wedding Verdict Actually Means</h2>

      <p>
        A wedding affordability score is not a judgment about whether the
        celebration is emotionally meaningful. The verdict estimates how much
        financial pressure the expense may create relative to your current
        income, savings cushion, and debt load.
      </p>

      <p>
        Higher savings impact percentages usually mean the wedding may consume
        too much of your cushion. Higher debt ratios can make the same wedding
        cost more stressful because there is less flexibility if something
        unexpected happens.
      </p>

      <p>
        A strong score means the wedding appears easier to absorb. A weaker score
        means the budget may still be possible, but the tradeoffs deserve more
        caution.
      </p>
    </section>

    <section class="content-section">
      <h2>Wedding Spending FAQ</h2>

      <h3>Is $30,000 too much to spend on a wedding?</h3>
      <p>
        It depends on income, savings, debt, and whether the wedding creates
        financial stress afterward. A $30,000 wedding may be manageable for one
        household and risky for another.
      </p>

      <h3>Should you finance a wedding?</h3>
      <p>
        Financing a wedding can create long-term pressure after the celebration
        is over. If the cost requires credit cards, personal loans, or depleted
        emergency savings, the budget may be too aggressive.
      </p>

      <h3>How much of your savings should a wedding use?</h3>
      <p>
        There is no perfect number, but using a large share of available savings
        can reduce financial flexibility. Emergency savings, housing goals, debt,
        and future plans should come before a larger wedding budget.
      </p>

      <h3>What percentage of income should a wedding cost?</h3>
      <p>
        A lower percentage of annual income is usually safer. The higher the
        wedding cost rises relative to income, the more important it becomes to
        avoid debt and preserve savings.
      </p>

      <p>
        For a deeper planning breakdown, read
        <a href="/how-to-budget-for-a-wedding-without-going-into-debt">
          How to Budget for a Wedding Without Going Into Debt
        </a>.
      </p>
    </section>

    <section class="content-section">
      <h2>Related Financial Calculators</h2>

      <div class="grid">
        {relatedCalculators.map((calculator) => (
          <CalculatorCard
            category={calculator.category}
            title={calculator.title}
            description={calculator.description}
            href={calculator.href}
          />
        ))}
      </div>
    </section>
  </div>

  <script is:inline>
    function calculateWedding() {
      const income = Number(document.getElementById("income").value);
      const savings = Number(document.getElementById("savings").value);
      const cost = Number(document.getElementById("cost").value);
      const debt = Number(document.getElementById("debt").value || 0);

      if (!income || !savings || !cost) {
        alert("Please enter income, savings, and wedding cost.");
        return;
      }

      const savingsImpact = (cost / savings) * 100;
      const incomeImpact = (cost / income) * 100;
      const debtRatio = (debt / income) * 100;
      const breakdown = document.getElementById("verdictBreakdown");

      let score = 100;

      if (savingsImpact > 10) score -= 12;
      if (savingsImpact > 25) score -= 18;
      if (savingsImpact > 50) score -= 25;
      if (incomeImpact > 15) score -= 10;
      if (incomeImpact > 25) score -= 15;
      if (debtRatio > 10) score -= 8;
      if (debtRatio > 25) score -= 12;

      score = Math.max(0, Math.min(100, score));

      let verdict = "";
      let guidance = "";
      let stress = "";
      let barColor = "";

      if (score >= 85) {
        verdict = "Smart Wedding Budget";
        stress = "Low stress";
        barColor = "var(--green)";
        guidance =
          "This wedding appears financially manageable. It still deserves a budget, but the cost does not seriously threaten your cushion.";
      } else if (score >= 70) {
        verdict = "Manageable with Guardrails";
        stress = "Manageable stress";
        barColor = "var(--teal)";
        guidance =
          "This can work if you avoid financing it, keep extra costs under control, and preserve enough emergency savings after the wedding.";
      } else if (score >= 50) {
        verdict = "Proceed Carefully";
        stress = "Noticeable stress";
        barColor = "var(--amber)";
        guidance =
          "This wedding would take a meaningful bite out of your financial cushion. Consider trimming the guest list, venue cost, or extras.";
      } else {
        verdict = "High Financial Risk";
        stress = "High stress";
        barColor = "var(--red)";
        guidance =
          "This wedding cost looks too aggressive for the current financial picture. A smaller budget would likely protect your future flexibility.";
      }

      document.getElementById("result").style.display = "block";
      document.getElementById("scoreText").textContent =
        `${verdict} - ${score}/100`;

      document.getElementById("barFill").style.width = `${score}%`;
      document.getElementById("barFill").style.background = barColor;

      document.getElementById("stress").innerHTML =
        `<strong>Stress level:</strong> ${stress}`;

      document.getElementById("savingsImpact").innerHTML =
        `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;

      document.getElementById("incomeImpact").innerHTML =
        `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;

      document.getElementById("debtRatio").innerHTML =
        `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

      document.getElementById("guidance").textContent = guidance;

      breakdown.style.display = "block";

      breakdown.innerHTML = `
        <strong>Financial Breakdown:</strong><br><br>
        - Wedding cost equals <strong>${incomeImpact.toFixed(1)}%</strong> of annual household income.<br>
        - Wedding cost consumes <strong>${savingsImpact.toFixed(1)}%</strong> of total savings.<br>
        - Existing debt load equals <strong>${debtRatio.toFixed(1)}%</strong> of annual income.<br><br>
        Higher savings impact and debt pressure usually increase long-term financial stress after large purchases.
      `;
    }

    document
      .getElementById("weddingButton")
      .addEventListener("click", calculateWedding);
  </script>
</Layout>