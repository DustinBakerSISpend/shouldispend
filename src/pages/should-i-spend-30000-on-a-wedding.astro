---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
import { calculators } from "../data/calculators.js";

const weddingFaqs = [
  {
    question: "Is $30,000 too much to spend on a wedding?",
    answer:
      "It depends on income, savings, debt, and whether the wedding creates financial pressure after the event. A $30,000 wedding can be manageable for one couple and risky for another.",
  },
  {
    question: "Should you finance a wedding?",
    answer:
      "Financing a wedding can create long-term pressure after the celebration is over. If the cost requires credit cards, personal loans, or depleted emergency savings, the budget may be too aggressive.",
  },
  {
    question: "How much of your savings should a wedding use?",
    answer:
      "There is no perfect number, but using a large share of available savings can reduce financial flexibility. Emergency savings, housing goals, debt, and future plans should come before a larger wedding budget.",
  },
  {
    question: "What percentage of income should a wedding cost?",
    answer:
      "A lower percentage of annual income is usually safer. The higher the wedding cost rises relative to income, the more important it becomes to avoid debt and preserve savings.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "Weddings" &&
      calculator.href !== "/should-i-spend-30000-on-a-wedding"
  )
  .slice(0, 4);
---

<Layout
  title="Should I Spend $30,000 on a Wedding?"
  description="Evaluate whether a $30,000 wedding fits your income, savings, debt load, emergency cushion, and financial flexibility."
>
  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a,
    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .helper-link a:hover,
    .content-link:hover {
      text-decoration: underline;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .guidance {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid #dbe4ee;
      font-size: 1.12rem;
      line-height: 1.85;
      color: #1e293b;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
    }

    .content-section ul {
      padding-left: 24px;
    }

    .pillar-card {
      display: block;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 24px;
      margin-top: 28px;
      text-decoration: none;
      transition: transform 0.15s ease;
    }

    .pillar-card:hover {
      transform: translateY(-2px);
    }

    .pillar-card strong {
      display: block;
      margin-bottom: 10px;
      color: #0f172a;
      font-size: 1.08rem;
    }

    .pillar-card span {
      color: #334155;
      line-height: 1.7;
      font-size: 0.98rem;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Wedding Spending Calculator"
      title="Should I Spend $30,000 on a Wedding?"
      description="Evaluate whether a $30,000 wedding fits your income, savings, debt load, emergency cushion, and financial flexibility."
    >
      <div class="calculator">
        <h2>Wedding Pressure Verdict</h2>

        <p class="calculator-intro">
          Enter your income, savings, wedding cost, and current debt. This
          calculator estimates whether the wedding looks comfortable, costly but
          manageable, or financially risky.
        </p>

        <div class="grid">
          <div class="field">
            <label for="income">Combined Annual Income</label>
            <input id="income" type="number" placeholder="Example: 140000" />
          </div>

          <div class="field">
            <label for="savings">Total Savings</label>
            <input id="savings" type="number" placeholder="Example: 50000" />
          </div>

          <div class="field">
            <label for="cost">Wedding Cost</label>
            <input id="cost" type="number" placeholder="Example: 30000" />
          </div>

          <div class="field">
            <label for="debt">Current Debt</label>
            <input id="debt" type="number" placeholder="Example: 12000" />

            <div class="helper-link">
              Not sure what counts as debt?
              <a href="/what-counts-as-debt">Read the debt guide</a>
            </div>
          </div>
        </div>

        <button id="weddingButton" type="button">Get Wedding Verdict</button>

        <div class="results" id="results">
          <div class="score" id="scoreText"></div>

          <div class="bar">
            <div class="fill" id="fillBar"></div>
          </div>

          <div class="result-details" id="resultDetails"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <section class="content-section">
        <h2>Start With the Full Wedding Budget Guide</h2>

        <p>
          A $30,000 wedding only tells part of the story. Venue minimums,
          catering, photography, attire, flowers, entertainment, rentals,
          gratuities, and last-minute upgrades can all change the real financial
          impact.
        </p>

        <a
          class="pillar-card"
          href="/how-to-budget-for-a-wedding-without-going-into-debt"
        >
          <strong>How to Budget for a Wedding Without Going Into Debt</strong>
          <span>
            Build a wedding budget around cash flow, savings protection, vendor
            tradeoffs, debt avoidance, and the financial life you want after the
            celebration.
          </span>
        </a>
      </section>

      <section class="content-section">
        <h2>What a $30,000 Wedding Really Costs</h2>

        <p>
          A $30,000 wedding is rarely just the venue bill. Catering, photography,
          attire, entertainment, flowers, decorations, alcohol, gratuities,
          rentals, transportation, and last-minute upgrades can push the real
          cost higher than expected.
        </p>

        <p>
          The bigger issue is what the wedding does to the couple’s financial
          flexibility after the celebration. A $30,000 wedding may feel
          manageable on paper, but it can become stressful if it drains
          emergency savings, adds debt, or delays larger goals like buying a
          home, paying off loans, or building long-term savings.
        </p>
      </section>

      <section id="ReduceCostTips">
        <WhenSpendingMakesSense
        title="When a $30,000 Wedding Can Make Sense"
        items={[
          "You can pay for the wedding mostly or entirely in cash.",
          "You have strong emergency savings left after the event.",
          "You are not using high-interest debt to cover the celebration.",
          "Your housing, retirement, and savings goals remain intact.",
          "Both partners are comfortable with the tradeoffs.",
        ]}
      />

      <section class="content-section">
        <h2>When You Should Wait</h2>

        <p>
          A $30,000 wedding becomes risky when it requires credit cards,
          personal loans, depleted savings, or financial help that creates
          pressure after the event.
        </p>

        <p>
          It may also be worth waiting if the wedding would delay a home
          purchase, weaken your emergency fund, increase existing debt stress,
          or force you to cut back on basic financial stability for months or
          years afterward.
        </p>

        <p>
          A smaller wedding can still be meaningful while leaving more room for
          the life you are building after the wedding day.
        </p>
      </section>

      <section id="KeyCostCategories" class="content-section">
        <h2>Hidden Wedding Costs to Consider</h2>

        <p>
          Wedding budgets often expand because couples focus on the headline
          venue or catering number while underestimating smaller costs that
          arrive later.
        </p>

        <ul>
          <li>Taxes, service charges, and gratuities</li>
          <li>Dress alterations, accessories, hair, and makeup</li>
          <li>Photography, video, music, and entertainment</li>
          <li>Invitations, postage, signage, and favors</li>
          <li>Transportation, hotel rooms, and rehearsal events</li>
          <li>Vendor meals, setup fees, overtime, and cleanup costs</li>
        </ul>

        <p>
          These costs matter because a wedding that begins as a $30,000 plan can
          quietly become a much larger commitment without strict guardrails.
        </p>
      </section>

      <section id="FinancialRedFlags" class="content-section">
        <h2>Financial Red Flags</h2>

        <p>
          Be careful if the wedding would leave little emergency savings,
          require high-interest debt, create arguments about money, or depend on
          future income that is not guaranteed.
        </p>

        <p>
          Another warning sign is feeling forced to spend more because of family
          expectations, social comparison, or fear that a smaller wedding will
          feel less legitimate.
        </p>

        <p>
          The healthiest wedding budget is one that lets you celebrate without
          creating a long financial recovery period afterward.
        </p>
      </section>

      <section class="content-section">
        <h2>What Your Wedding Verdict Actually Means</h2>

        <p>
          A wedding affordability score is not a judgment about whether the
          celebration is emotionally meaningful. The verdict estimates how much
          financial pressure the expense may create relative to your current
          income, savings cushion, and debt load.
        </p>

        <p>
          Higher savings impact percentages usually mean the wedding may consume
          too much of your cushion. Higher debt ratios can make the same wedding
          cost more stressful because there is less flexibility if something
          unexpected happens.
        </p>

        <p>
          A strong score means the wedding appears easier to absorb. A weaker
          score means the budget may still be possible, but the tradeoffs deserve
          more caution.
        </p>
      </section>

      <section id="CalculatorAssumptions" class="content-section">
        <h2>$30,000 Wedding Calculator Assumptions</h2>

        <p>
          This calculator evaluates a $30,000 wedding using annual household
          income, total savings, wedding cost, and current debt. It treats the
          wedding as a major one-time expense that can affect emergency savings,
          cash flow, future goals, and post-wedding flexibility.
        </p>

        <p>
          The score assumes a wedding is safer when it can be paid mostly or
          entirely in cash, does not require high-interest debt, and leaves
          meaningful savings after the event. Strong income, strong savings,
          low debt, and a small savings impact can reduce pressure significantly.
        </p>
      </section>


      <div class="content-section">
        <FAQSection faqs={weddingFaqs} />
      </div>

      <div id="RelatedCalculators" class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <section id="MethodologySection">
      <MethodologySection category="wedding affordability" />
    </section>
  </div>

    <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action: "Proceed with a disciplined wedding budget.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action: "Reduce wedding upgrades or rebuild savings first.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action: "Lower the wedding budget or delay spending.",
      };
    }

    function calculateWedding() {
      const income = getNumber("income");
      const savings = getNumber("savings");
      const cost = getNumber("cost");
      const debt = getNumber("debt");

      const results = document.getElementById("results");
      const scoreText = document.getElementById("scoreText");
      const fillBar = document.getElementById("fillBar");
      const resultDetails = document.getElementById("resultDetails");
      const guidance = document.getElementById("guidance");

      results.classList.add("visible");

      if (income <= 0 || savings <= 0 || cost <= 0) {
        scoreText.textContent = "Add your numbers first";
        fillBar.style.width = "0%";
        fillBar.className = "fill safe";
        resultDetails.innerHTML =
          "<p>Enter a positive income, savings amount, wedding cost, and debt so the calculator can estimate financial pressure.</p>";
        guidance.textContent = "";
        return;
      }

      const monthlyIncome = income / 12;
      const savingsImpact = (cost / savings) * 100;
      const annualIncomeImpact = (cost / income) * 100;
      const monthlyIncomeImpact = (cost / monthlyIncome) * 100;
      const debtRatio = (debt / income) * 100;
      const remainingSavings = savings - cost;
      const remainingSavingsMonths = remainingSavings / monthlyIncome;

      let pressureScore = 0;

      pressureScore += clamp(savingsImpact * 0.42, 0, 42);
      pressureScore += clamp(monthlyIncomeImpact * 0.26, 0, 28);
      pressureScore += clamp(debtRatio * 0.22, 0, 18);

      if (cost > savings) pressureScore += 28;

      if (remainingSavingsMonths < 1 && income < 100000) {
        pressureScore += 20;
      } else if (remainingSavingsMonths < 3 && income < 150000) {
        pressureScore += 12;
      } else if (remainingSavingsMonths >= 6) {
        pressureScore -= 8;
      }

      if (debtRatio >= 75) pressureScore += 12;
      else if (debtRatio >= 40) pressureScore += 8;

      if (
        annualIncomeImpact < 2 &&
        savingsImpact < 10 &&
        remainingSavingsMonths >= 6
      ) {
        pressureScore -= 12;
      }

      if (
        annualIncomeImpact < 0.25 &&
        monthlyIncomeImpact < 5 &&
        debtRatio < 10
      ) {
        pressureScore = Math.min(pressureScore, 20);
      }

      if (
        annualIncomeImpact < 0.05 &&
        monthlyIncomeImpact < 1 &&
        debtRatio < 5
      ) {
        pressureScore = Math.min(pressureScore, 10);
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      fillBar.style.width = `${pressureScore}%`;
      fillBar.className = `fill ${level.colorClass}`;

      scoreText.textContent = `${level.label} — ${pressureScore}/100`;

      resultDetails.innerHTML = `
        <p><strong>Pressure level:</strong> ${level.stress}.</p>
        <p><strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of current savings.</p>
        <p><strong>Annual income impact:</strong> ${annualIncomeImpact.toFixed(1)}% of annual household income.</p>
        <p><strong>Monthly income impact:</strong> ${monthlyIncomeImpact.toFixed(1)}% of one month’s income.</p>
        <p><strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual household income.</p>
        <p><strong>Estimated savings after wedding:</strong> $${remainingSavings.toLocaleString()}.</p>
      `;

      if (pressureScore <= 30) {
        guidance.textContent =
          `This wedding appears financially manageable based on the numbers provided. The cost equals about ${monthlyIncomeImpact.toFixed(1)}% of one month’s income and ${savingsImpact.toFixed(1)}% of savings, so the main priority is controlling guest-count creep, vendor upgrades, and final-week expenses. Recommended next step: ${level.action}`;
      } else if (pressureScore <= 60) {
        guidance.textContent =
          `This wedding may work, but it deserves caution. The cost equals about ${monthlyIncomeImpact.toFixed(1)}% of one month’s income and ${savingsImpact.toFixed(1)}% of savings, which means the venue, catering, bar, photography, and guest list need strict guardrails. Recommended next step: ${level.action}`;
      } else {
        guidance.textContent =
          `This wedding could create real financial strain. The cost equals about ${monthlyIncomeImpact.toFixed(1)}% of one month’s income and ${savingsImpact.toFixed(1)}% of savings, so lowering the guest count, simplifying the venue, delaying spending, or saving more would likely be safer. Recommended next step: ${level.action}`;
      }
    }

    document
      .getElementById("weddingButton")
      .addEventListener("click", calculateWedding);
  </script>
</Layout>