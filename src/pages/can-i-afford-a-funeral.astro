---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const funeralFaqs = [
  {
    question: "How do I know if I can afford a funeral?",
    answer:
      "A funeral is more affordable when savings, insurance, family help, or prepaid funds cover most of the cost without draining emergency reserves, creating high-interest debt, or crowding out rent, groceries, medical needs, transportation, or other bills.",
  },
  {
    question: "Should I use gross income or take-home income?",
    answer:
      "Use monthly take-home income. That is the money actually available after taxes and payroll deductions. Gross income can make a funeral look more affordable than it really is.",
  },
  {
    question: "Is funeral debt a bad idea?",
    answer:
      "Funeral debt can become risky when it involves credit cards, high-interest loans, unclear payment plans, or monthly payments that stretch the household after the service. Before borrowing, compare lower-cost funeral, cremation, and memorial options.",
  },
  {
    question: "What if insurance money has not arrived yet?",
    answer:
      "Delayed insurance proceeds can create short-term pressure. Before borrowing, confirm timing, ask whether assignment is possible, compare lower-cost services, and avoid assuming money will arrive immediately.",
  },
  {
    question: "What is the safest funeral budget?",
    answer:
      "The safest funeral budget is one the family can pay without harming the surviving household. It should have itemized pricing, confirmed funding, realistic family contributions, and enough emergency savings left afterward.",
  },
];

const costCategories = [
  {
    title: "Funeral home services",
    body:
      "Basic services, staff, facility use, paperwork, permits, viewing, ceremony coordination, and transportation can make up a large part of the quote.",
  },
  {
    title: "Burial or cremation",
    body:
      "Burial may add casket, cemetery, plot, vault, and grave fees. Cremation may be lower-cost, but memorial, urn, obituary, and reception costs still matter.",
  },
  {
    title: "Cemetery and graveside costs",
    body:
      "Plots, grave opening and closing, markers, headstones, vaults, and cemetery administration fees may be billed separately from the funeral home.",
  },
  {
    title: "Family and gathering costs",
    body:
      "Travel, lodging, food, reception, flowers, printed materials, clergy, music, photos, and missed work can affect affordability beyond the quote.",
  },
  {
    title: "Funding source",
    body:
      "The same funeral cost creates very different pressure depending on whether it is covered by insurance, savings, family help, or debt.",
  },
  {
    title: "Payment timing",
    body:
      "A funeral may be affordable eventually but stressful immediately if insurance, estate funds, or contributions are delayed.",
  },
];

const reduceCostTips = [
  "Ask for itemized pricing before choosing a package.",
  "Separate required costs from optional upgrades.",
  "Compare burial, cremation, direct cremation, graveside service, and memorial-only options.",
  "Confirm insurance, prepaid funds, estate cash, or employer benefits before assuming reimbursement.",
  "Ask family members to pay specific costs directly instead of promising vague help later.",
  "Choose simpler flowers, printed materials, casket, urn, reception, or keepsakes if those costs are not central to the goodbye.",
  "Delay optional headstone upgrades, large receptions, or memorial events until cash is available.",
  "Avoid high-interest credit cards unless the payoff plan is already realistic.",
];

const redFlags = [
  "The funeral would drain savings below the emergency cushion.",
  "Credit cards or high-interest loans are needed to cover the bill.",
  "The funeral quote is not itemized or feels confusing.",
  "Essential bills would become harder to pay afterward.",
  "Family help is assumed but not confirmed.",
  "Insurance or estate money is expected but timing is unclear.",
  "The plan is being upgraded mainly because of guilt, pressure, or fear of looking disrespectful.",
  "The person signing the contract is relying on reimbursement from relatives later.",
  "The monthly payment plan would crowd out rent, food, transportation, medical bills, or other debt payments.",
  "No one has compared a lower-cost funeral, cremation, direct cremation, or smaller memorial.",
];

const assumptions = [
  "Monthly income means take-home pay for the person or household paying the funeral bill.",
  "Insurance, prepaid funds, estate cash, or family help should mean money that is confirmed or highly realistic.",
  "Liquid savings means cash available without missing essential bills, selling long-term assets, or triggering penalties.",
  "Essential bills include housing, utilities, groceries, transportation, medical needs, childcare, and other non-optional household costs.",
  "Borrowing includes credit cards, personal loans, funeral financing, and any amount expected to become a future payment obligation.",
  "The emergency target is the minimum savings cushion the household wants left after the funeral is paid.",
  "This calculator estimates financial pressure, not the emotional value of the funeral.",
  "A score of 0 is allowed when the funeral is fully covered or tiny compared with income, savings, and obligations.",
];

const relatedCalculators = [
  {
    title: "Funeral Calculators",
    href: "/funeral-calculators",
    body: "Browse the full funeral calculator cluster for burial, cremation, insurance, savings, and debt decisions.",
  },
  {
    title: "Funeral Price Calculator",
    href: "/funeral-price-calculator",
    body: "Estimate a realistic funeral cost range before testing affordability.",
  },
  {
    title: "Funeral vs. Cremation Cost Calculator",
    href: "/funeral-vs-cremation-cost-calculator",
    body: "Compare burial, cremation, direct cremation, and memorial service options.",
  },
  {
    title: "$5,000 Funeral Calculator",
    href: "/should-i-spend-5000-on-a-funeral",
    body: "Test a simpler cremation or memorial budget against savings and debt pressure.",
  },
  {
    title: "$10,000 Funeral Calculator",
    href: "/should-i-spend-10000-on-a-funeral",
    body: "Pressure-test a common funeral budget against insurance, savings, income, and family help.",
  },
  {
    title: "$15,000 Funeral Calculator",
    href: "/should-i-spend-15000-on-a-funeral",
    body: "Evaluate a higher-cost burial or full-service funeral before committing.",
  },
  {
    title: "Use Savings for Funeral Costs?",
    href: "/should-i-use-savings-for-funeral-costs",
    body: "Decide whether using cash is safer than borrowing or waiting for reimbursement.",
  },
  {
    title: "Funeral Payment Plan Calculator",
    href: "/funeral-payment-plan-calculator",
    body: "Estimate monthly payment, interest, payoff time, and financing pressure.",
  },
];
---

<Layout
  title="Can I Afford a Funeral?"
  description="Use this funeral affordability calculator to compare funeral quotes against savings, insurance, family help, debt, income, essential bills, borrowing risk, and emergency reserves."
>
  <style>
    .container { max-width: 1060px; margin: 0 auto; padding: 80px 24px; }
    .eyebrow { color:#0f766e; text-transform:uppercase; letter-spacing:2px; font-size:.8rem; font-weight:900; margin-bottom:18px; }
    h1 { font-size:clamp(2.65rem,7vw,4.8rem); line-height:.95; margin:0 0 24px; color:#0f172a; max-width:930px; }
    h2 { font-size:clamp(1.8rem,4vw,2.45rem); line-height:1.12; margin:0 0 18px; color:#0f172a; }
    h3 { color:#0f172a; line-height:1.25; margin:0 0 10px; }
    p, li { color:#334155; line-height:1.85; font-size:1.06rem; }
    a { color:#0f766e; font-weight:800; }
    .intro { max-width:860px; font-size:1.14rem; margin-bottom:32px; }
    .hero-grid, .info-grid, .link-grid, .mini-grid { display:grid; gap:20px; }
    .hero-grid { grid-template-columns:minmax(0,1.4fr) minmax(280px,.7fr); margin:34px 0 56px; }
    .info-grid, .link-grid, .mini-grid { grid-template-columns:repeat(auto-fit,minmax(245px,1fr)); margin-top:28px; }
    .summary-card, .calculator-box, .info-card, .link-card, .callout, .mini-card, .table-wrap {
      border:1px solid #dbe4ee; background:#fff; border-radius:24px; box-shadow:0 12px 28px rgba(15,23,42,.04);
    }
    .summary-card, .info-card, .mini-card, .link-card, .callout { padding:24px; }
    .summary-card { background:linear-gradient(180deg,#f8fafc 0%,#fff 100%); }
    .summary-card strong { display:block; color:#0f172a; font-size:1.1rem; margin-bottom:10px; }
    .summary-list { margin:0; padding-left:20px; }
    .summary-list li { margin-bottom:10px; font-size:.98rem; }
    .calculator-box { padding:30px; margin-bottom:64px; }
    .form-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:18px; margin-top:24px; }
    label { display:block; font-weight:900; color:#0f172a; margin-bottom:8px; font-size:.95rem; }
    .hint { display:block; color:#64748b; font-size:.83rem; line-height:1.45; margin-top:5px; }
    input, select { width:100%; border:1px solid #cbd5e1; border-radius:13px; padding:13px; font-size:1rem; box-sizing:border-box; color:#0f172a; background:#fff; }
    button { margin-top:24px; border:none; border-radius:999px; padding:15px 24px; background:#0f766e; color:#fff; font-weight:900; font-size:1rem; cursor:pointer; }
    button:hover { opacity:.92; }
    .result { margin-top:32px; background:#f8fafc; border:1px solid #dbe4ee; border-radius:24px; padding:30px; display:none; }
    .result.visible { display:block; }
    .score { font-size:clamp(2rem,4vw,2.75rem); font-weight:950; color:#0f172a; margin-bottom:20px; line-height:1.12; }
    .bar { height:16px; background:#dbe4ee; border-radius:999px; overflow:hidden; margin-bottom:24px; }
    .fill { height:100%; width:0%; border-radius:999px; transition:width .45s ease; }
    .fill.safe { background:linear-gradient(90deg,#0f766e 0%,#14b8a6 100%); }
    .fill.caution { background:linear-gradient(90deg,#ca8a04 0%,#facc15 100%); }
    .fill.danger { background:linear-gradient(90deg,#dc2626 0%,#f97316 100%); }
    .result-details { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:14px; margin-top:20px; }
    .result-metric { background:#fff; border:1px solid #e2e8f0; border-radius:18px; padding:16px; }
    .result-metric strong { display:block; color:#0f172a; margin-bottom:6px; }
    .result-metric span { color:#334155; line-height:1.55; font-size:.96rem; }
    .guidance { margin-top:22px; padding-top:20px; border-top:1px solid #dbe4ee; color:#0f172a; font-size:1.08rem; line-height:1.8; }
    .fine-print { color:#64748b; font-size:.9rem; margin-top:18px; line-height:1.6; }
    .content-section { margin-top:76px; }
    .content-section > p { max-width:900px; }
    .numbered-card { position:relative; padding-top:48px; }
    .numbered-card .number { position:absolute; top:20px; left:22px; width:28px; height:28px; border-radius:999px; background:#ccfbf1; color:#115e59; font-weight:950; display:grid; place-items:center; font-size:.86rem; }
    .callout { background:#f8fafc; margin-top:28px; }
    .callout p { margin:0; color:#0f172a; font-size:1.08rem; }
    .warning-box { border-left:5px solid #dc2626; }
    .decision-box { border-left:5px solid #0f766e; }
    .table-wrap { overflow-x:auto; margin-top:26px; padding:0; }
    table { width:100%; border-collapse:collapse; min-width:720px; }
    th, td { text-align:left; padding:16px; border-bottom:1px solid #e2e8f0; vertical-align:top; color:#334155; line-height:1.55; }
    th { color:#0f172a; background:#f8fafc; font-size:.92rem; text-transform:uppercase; letter-spacing:.04em; }
    tr:last-child td { border-bottom:none; }
    .link-card { display:block; text-decoration:none; color:inherit; transition:transform .15s ease, box-shadow .15s ease; }
    .link-card:hover { transform:translateY(-2px); box-shadow:0 16px 34px rgba(15,23,42,.08); }
    .link-card strong { display:block; color:#0f172a; margin-bottom:8px; line-height:1.3; font-size:1.03rem; }
    .link-card span, .info-card p, .mini-card p { display:block; margin:0; color:#334155; line-height:1.7; font-size:.96rem; }
    .check-list, .red-list { list-style:none; padding-left:0; }
    .check-list li, .red-list li { position:relative; padding-left:30px; margin-bottom:10px; }
    .check-list li::before { content:"+"; position:absolute; left:0; top:0; color:#0f766e; font-weight:950; }
    .red-list li::before { content:"!"; position:absolute; left:0; top:2px; width:18px; height:18px; border-radius:999px; display:grid; place-items:center; background:#fee2e2; color:#b91c1c; font-weight:950; font-size:.8rem; }
    @media (max-width:760px) {
      .container { padding:54px 18px; }
      .hero-grid { grid-template-columns:1fr; }
      .calculator-box { padding:22px; }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Funeral Affordability Calculator</div>

    <h1>Can I Afford a Funeral?</h1>

    <p class="intro">
      Funeral decisions often happen quickly, under grief, family pressure, and
      unclear pricing. This calculator compares a funeral quote against savings,
      insurance help, family contributions, income, debt, essential bills,
      borrowing risk, and emergency reserves to estimate whether the plan is
      manageable or financially risky.
    </p>

    <div class="hero-grid">
      <div class="summary-card">
        <strong>Fast answer</strong>
        <p>
          You can usually afford a funeral when confirmed help and available
          cash cover the bill without draining emergency savings or creating
          high-interest debt. The same quote becomes risky when one household is
          left exposed afterward.
        </p>
      </div>

      <div class="summary-card">
        <strong>This page helps you check:</strong>
        <ul class="summary-list">
          <li>the real out-of-pocket cost after help</li>
          <li>whether savings remain protected</li>
          <li>whether borrowing creates monthly pressure</li>
          <li>whether the quote should be reduced before signing</li>
        </ul>
      </div>
    </div>

    <section class="calculator-box">
      <h2>Funeral Affordability Pressure Calculator</h2>

      <p>
        Enter the funeral quote, available help, household savings, take-home
        income, debt payments, basic monthly obligations, expected borrowing,
        service type, and quote clarity. Use take-home income, not gross income.
      </p>

      <div class="form-grid">
        <div>
          <label for="cost">Total funeral quote</label>
          <input id="cost" type="number" placeholder="Example: 12000" min="0" inputmode="decimal" />
          <span class="hint">Use the full expected quote, including funeral, burial or cremation, and extras.</span>
        </div>

        <div>
          <label for="help">Insurance, prepaid funds, or family help</label>
          <input id="help" type="number" placeholder="Example: 5000" min="0" inputmode="decimal" />
          <span class="hint">Only include confirmed or highly realistic help.</span>
        </div>

        <div>
          <label for="savings">Current liquid savings</label>
          <input id="savings" type="number" placeholder="Example: 18000" min="0" inputmode="decimal" />
          <span class="hint">Cash available without missing bills or selling long-term assets.</span>
        </div>

        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 7000" min="0" inputmode="decimal" />
          <span class="hint">After-tax income for the person or household paying.</span>
        </div>

        <div>
          <label for="debt">Monthly debt payments</label>
          <input id="debt" type="number" placeholder="Example: 900" min="0" inputmode="decimal" />
          <span class="hint">Credit cards, loans, car payments, student loans, and medical payment plans.</span>
        </div>

        <div>
          <label for="essentials">Monthly essential bills</label>
          <input id="essentials" type="number" placeholder="Example: 3800" min="0" inputmode="decimal" />
          <span class="hint">Housing, utilities, groceries, transportation, medical needs, childcare, and basics.</span>
        </div>

        <div>
          <label for="emergencyTarget">Minimum savings cushion wanted afterward</label>
          <input id="emergencyTarget" type="number" placeholder="Example: 12000" min="0" inputmode="decimal" />
          <span class="hint">The cash floor you do not want the funeral to break.</span>
        </div>

        <div>
          <label for="borrowing">Amount likely borrowed</label>
          <input id="borrowing" type="number" placeholder="Example: 3000" min="0" inputmode="decimal" />
          <span class="hint">Credit card, funeral financing, personal loan, or other future payment obligation.</span>
        </div>

        <div>
          <label for="serviceType">Main plan type</label>
          <select id="serviceType">
            <option value="direct">Direct cremation / simple memorial</option>
            <option value="cremation">Cremation with service</option>
            <option value="burial" selected>Traditional burial</option>
            <option value="premium">Higher-cost burial or full service</option>
          </select>
        </div>

        <div>
          <label for="pricingClarity">Quote clarity</label>
          <select id="pricingClarity">
            <option value="clear" selected>Itemized and clear</option>
            <option value="partial">Partly clear</option>
            <option value="unclear">Unclear / package pressure</option>
          </select>
        </div>
      </div>

      <button class="sis-action-button sis-calculate-button" id="calculateButton" type="button">Check Funeral Affordability</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>
        <div class="bar"><div class="fill" id="scoreFill"></div></div>
        <div class="result-details" id="resultDetails"></div>
        <div class="guidance" id="guidance"></div>
        <div class="fine-print">This is a general educational estimate, not financial, legal, insurance, tax, estate, or funeral-planning advice.</div>
      </div>
    </section>

    <section class="content-section">
      <h2>What makes a funeral affordable?</h2>

      <p>
        A funeral is affordable when the family can pay for it without creating
        a second crisis. That usually means the cost is covered by insurance,
        prepaid arrangements, family contributions, estate cash, or savings that
        can be used without destroying the household's emergency cushion.
      </p>

      <p>
        The same quote can be fine for one household and dangerous for another.
        A $12,000 funeral covered by insurance is different from a $12,000
        funeral placed on one person's credit card while they wait for relatives
        to reimburse them.
      </p>

      <div class="callout decision-box">
        <p>
          The right question is not only "Can we pay the invoice?" It is "Can we
          honor this person without leaving the family financially exposed
          afterward?"
        </p>
      </div>
    </section>

    <section class="content-section" id="MethodologySection">
      <h2>How this funeral affordability calculator works</h2>

      <p>
        The calculator estimates a pressure score from 0 to 100. It starts with
        the funeral quote, subtracts confirmed help, and then weighs the
        remaining cost against savings, take-home income, essential bills,
        existing debt, borrowing, emergency cushion, service type, and quote
        clarity.
      </p>

      <div class="mini-grid">
        <div class="mini-card numbered-card">
          <div class="number">1</div>
          <h3>Real out-of-pocket cost</h3>
          <p>The calculator subtracts confirmed help from the funeral quote to estimate what the household must cover.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">2</div>
          <h3>Savings after the funeral</h3>
          <p>It checks whether the funeral leaves enough cash for essential bills and another emergency.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">3</div>
          <h3>Monthly recovery ability</h3>
          <p>It compares income, debt, and essential bills to estimate whether the household can recover after paying.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">4</div>
          <h3>Borrowing and quote risk</h3>
          <p>Financing, unclear pricing, and package pressure can raise risk even when the initial quote seems manageable.</p>
        </div>
      </div>

      <p>
        There is no artificial minimum pressure. If the funeral is fully covered,
        the score can be 0. If the uncovered cost is tiny compared with income,
        savings, and obligations, the score can also be 0.
      </p>
    </section>

    <section class="content-section" id="KeyCostCategories">
      <h2>Key funeral cost categories to include</h2>

      <p>
        Funeral affordability depends on the full cost, not just the main
        service package. Families should include both the funeral home invoice
        and the costs that may appear outside it.
      </p>

      <div class="info-grid">
        {costCategories.map((category) => (
          <div class="info-card">
            <h3>{category.title}</h3>
            <p>{category.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>Funeral affordability by payment source</h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Payment source</th>
              <th>When it helps</th>
              <th>When it becomes risky</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Life insurance or prepaid funds</td>
              <td>The money is confirmed, accessible, and available near the payment deadline.</td>
              <td>The family assumes reimbursement before timing, beneficiary access, or coverage is clear.</td>
            </tr>
            <tr>
              <td>Savings</td>
              <td>The funeral can be paid while leaving a real emergency cushion.</td>
              <td>The payment drains cash needed for housing, food, utilities, transportation, or medical needs.</td>
            </tr>
            <tr>
              <td>Family contributions</td>
              <td>Relatives commit specific amounts or pay specific vendors directly.</td>
              <td>One person signs the contract based on vague promises to help later.</td>
            </tr>
            <tr>
              <td>Payment plan or loan</td>
              <td>The payment is affordable, transparent, and safer than draining all cash.</td>
              <td>Interest, fees, or monthly payments create long-term pressure.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section" id="FinancialRedFlags">
      <h2>Financial red flags before committing to a funeral quote</h2>

      <p>
        Funeral pressure rises when the plan depends on debt, unclear pricing,
        delayed insurance money, emotional upgrades, or one person paying more
        than the household can safely absorb.
      </p>

      <ul class="red-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>

      <div class="callout warning-box">
        <p>
          Be especially careful if the funeral feels affordable only because
          money is expected later. Expected reimbursement and cash available
          today are not the same thing.
        </p>
      </div>
    </section>

    <section class="content-section" id="ReduceCostTips">
      <h2>Ways to make a funeral more affordable</h2>

      <p>
        Lower-cost choices can still be respectful. The goal is not to minimize
        grief or choose the cheapest possible option. The goal is to keep the
        meaningful parts while removing spending that creates avoidable
        financial harm.
      </p>

      <ul class="check-list">
        {reduceCostTips.map((tip) => <li>{tip}</li>)}
      </ul>
    </section>

    <section class="content-section">
      <h2>Burial, cremation, and memorial choices affect affordability</h2>

      <p>
        A traditional burial may be appropriate, but it often includes more cost
        categories than families expect. A direct cremation or smaller memorial
        may reduce pressure, but it still needs a complete budget for service,
        urn, obituary, gathering, travel, and family logistics.
      </p>

      <p>
        Before signing a contract, compare the current quote against the
        <a href="/funeral-vs-cremation-cost-calculator/">funeral vs. cremation cost calculator</a>,
        <a href="/cremation-cost-calculator/">cremation cost calculator</a>, and
        <a href="/burial-cost-calculator/">burial cost calculator</a>.
      </p>
    </section>

    <section class="content-section" id="CalculatorAssumptions">
      <h2>Calculator assumptions</h2>

      <ul>
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="content-section">
      <h2>Decision guide: what to do with your result</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Low pressure</h3>
          <p>Confirm itemized pricing, avoid unnecessary upgrades, and pay without creating new debt.</p>
        </div>

        <div class="info-card">
          <h3>Moderate pressure</h3>
          <p>Trim the quote, confirm family help, compare cremation or simpler options, and avoid expensive financing.</p>
        </div>

        <div class="info-card">
          <h3>High pressure</h3>
          <p>Reduce the funeral cost before committing. Avoid draining savings or taking on high-interest debt if a simpler service is possible.</p>
        </div>
      </div>
    </section>

    <section class="content-section" id="RelatedCalculators">
      <h2>Related funeral calculators</h2>

      <div class="link-grid">
        {relatedCalculators.map((calculator) => (
          <a class="link-card" href={calculator.href}>
            <strong>{calculator.title}</strong>
            <span>{calculator.body}</span>
          </a>
        ))}
      </div>
    </section>

    <FAQSection title="Can I Afford a Funeral FAQ" faqs={funeralFaqs} />
  </main>

  <script>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const getValue = (id) => document.getElementById(id)?.value || "";

    function formatMoney(value) {
      const safeValue = Number.isFinite(value) ? value : 0;

      return safeValue.toLocaleString(undefined, {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      });
    }

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action:
            "Confirm itemized pricing, avoid unnecessary upgrades, and pay without creating new debt.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action:
            "Trim the quote, confirm family help, compare cremation or simpler options, and avoid expensive financing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action:
          "Reduce the funeral cost before committing. Avoid draining savings or taking on high-interest debt if a simpler service is possible.",
      };
    }

    function getServiceRisk(serviceType) {
      if (serviceType === "direct") return -5;
      if (serviceType === "cremation") return -2;
      if (serviceType === "burial") return 3;
      return 7;
    }

    function getClarityRisk(pricingClarity) {
      if (pricingClarity === "clear") return 0;
      if (pricingClarity === "partial") return 6;
      return 12;
    }

    const button = document.getElementById("calculateButton");
    const result = document.getElementById("result");
    const scoreText = document.getElementById("scoreText");
    const scoreFill = document.getElementById("scoreFill");
    const resultDetails = document.getElementById("resultDetails");
    const guidance = document.getElementById("guidance");

    button?.addEventListener("click", () => {
      const cost = getNumber("cost");
      const help = getNumber("help");
      const savings = getNumber("savings");
      const income = getNumber("income");
      const debt = getNumber("debt");
      const essentials = getNumber("essentials");
      const emergencyTarget = getNumber("emergencyTarget");
      const borrowing = getNumber("borrowing");
      const serviceType = getValue("serviceType");
      const pricingClarity = getValue("pricingClarity");

      result?.classList.add("visible");

      if (cost <= 0) {
        scoreText.textContent = "Add a funeral quote first";
        scoreFill.style.width = "0%";
        scoreFill.className = "fill safe";
        resultDetails.innerHTML = `
          <div class="result-metric">
            <strong>Missing quote</strong>
            <span>Enter a funeral quote so the calculator can estimate affordability pressure.</span>
          </div>
        `;
        guidance.textContent = "";
        return;
      }

      const outOfPocket = Math.max(cost - help, 0);
      const savingsAfter = savings - outOfPocket;
      const cashFlowAfterBills = income - debt - essentials;

      const monthlyIncomeImpact = income > 0 ? (outOfPocket / income) * 100 : outOfPocket > 0 ? 300 : 0;
      const savingsImpact = savings > 0 ? (outOfPocket / savings) * 100 : outOfPocket > 0 ? 150 : 0;
      const debtRatio = income > 0 ? (debt / income) * 100 : debt > 0 ? 100 : 0;
      const essentialsRatio = income > 0 ? (essentials / income) * 100 : essentials > 0 ? 100 : 0;
      const borrowingRatio = income > 0 ? (borrowing / income) * 100 : borrowing > 0 ? 100 : 0;
      const emergencyRemaining =
        emergencyTarget > 0 ? (savingsAfter / emergencyTarget) * 100 : null;

      const recoveryMonths =
        cashFlowAfterBills > 0 ? outOfPocket / cashFlowAfterBills : 99;

      const effectiveEmergencyTarget =
        emergencyTarget > 0 ? emergencyTarget : Math.max(income * 3, essentials * 2);

      const fullyCovered = outOfPocket <= 0;

      const tinyUncoveredCost =
        outOfPocket > 0 &&
        outOfPocket <= Math.max(100, income * 0.02) &&
        savingsAfter >= 0 &&
        debtRatio <= 10 &&
        borrowing <= 0;

      const savingsMassivelyAbsorbsCost =
        outOfPocket > 0 &&
        savingsAfter >= Math.max(effectiveEmergencyTarget * 3, income * 6, outOfPocket * 20);

      const incomeMassivelyAbsorbsCost =
        outOfPocket > 0 &&
        income > 0 &&
        monthlyIncomeImpact <= 2 &&
        debtRatio <= 10 &&
        essentialsRatio <= 40 &&
        cashFlowAfterBills >= outOfPocket * 2;

      let pressureScore = 0;

      if (fullyCovered || tinyUncoveredCost || savingsMassivelyAbsorbsCost || incomeMassivelyAbsorbsCost) {
        pressureScore = 0;
      } else {
        pressureScore += clamp(monthlyIncomeImpact * 0.28, 0, 28);
        pressureScore += clamp(savingsImpact * 0.55, 0, 38);
        pressureScore += clamp(debtRatio * 0.28, 0, 18);
        pressureScore += clamp(essentialsRatio * 0.12, 0, 12);
        pressureScore += clamp(borrowingRatio * 0.4, 0, 20);

        if (outOfPocket > savings) pressureScore += 30;

        if (savingsAfter < 0) {
          pressureScore += 28;
        } else if (savingsAfter < effectiveEmergencyTarget * 0.5) {
          pressureScore += 18;
        } else if (savingsAfter < effectiveEmergencyTarget) {
          pressureScore += 10;
        } else if (savingsAfter >= effectiveEmergencyTarget * 2) {
          pressureScore -= 8;
        }

        if (cashFlowAfterBills <= 0) pressureScore += 16;
        else if (recoveryMonths > 12) pressureScore += 15;
        else if (recoveryMonths > 6) pressureScore += 9;
        else if (recoveryMonths > 3) pressureScore += 5;
        else if (recoveryMonths <= 1) pressureScore -= 5;

        pressureScore += getServiceRisk(serviceType);
        pressureScore += getClarityRisk(pricingClarity);

        if (borrowing > 0 && savingsAfter >= effectiveEmergencyTarget * 2) {
          pressureScore -= 8;
        } else if (borrowing > 0 && debtRatio >= 30) {
          pressureScore += 12;
        } else if (borrowing > 0 && savingsAfter < effectiveEmergencyTarget) {
          pressureScore += 10;
        }

        if (
          outOfPocket > 0 &&
          savingsImpact <= 1 &&
          monthlyIncomeImpact <= 10 &&
          savingsAfter >= effectiveEmergencyTarget &&
          debtRatio <= 15
        ) {
          pressureScore = Math.min(pressureScore, 8);
        }

        if (
          outOfPocket > 0 &&
          savingsImpact <= 3 &&
          monthlyIncomeImpact <= 20 &&
          savingsAfter >= effectiveEmergencyTarget &&
          debtRatio <= 25
        ) {
          pressureScore = Math.min(pressureScore, 15);
        }
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      scoreText.textContent = `${level.label}  -  ${pressureScore}/100`;
      scoreFill.style.width = `${pressureScore}%`;
      scoreFill.className = `fill ${level.colorClass}`;

      resultDetails.innerHTML = `
        <div class="result-metric"><strong>Pressure level</strong><span>${level.stress}</span></div>
        <div class="result-metric"><strong>Funeral quote</strong><span>${formatMoney(cost)}</span></div>
        <div class="result-metric"><strong>Out-of-pocket cost</strong><span>${formatMoney(outOfPocket)} after insurance, prepaid funds, estate cash, or family help.</span></div>
        <div class="result-metric"><strong>Savings after funeral</strong><span>${formatMoney(savingsAfter)}</span></div>
        <div class="result-metric"><strong>Monthly income impact</strong><span>${income > 0 ? `${monthlyIncomeImpact.toFixed(1)}% of one month's take-home income.` : "No monthly take-home income entered."}</span></div>
        <div class="result-metric"><strong>Savings impact</strong><span>${savings > 0 ? `${savingsImpact.toFixed(1)}% of available savings.` : "No available savings entered."}</span></div>
        <div class="result-metric"><strong>Debt payment pressure</strong><span>${income > 0 ? `${debtRatio.toFixed(1)}% of monthly take-home income.` : "Enter income to estimate debt pressure."}</span></div>
        <div class="result-metric"><strong>Essential bills pressure</strong><span>${income > 0 ? `${essentialsRatio.toFixed(1)}% of monthly take-home income.` : "Enter income to estimate essential-bill pressure."}</span></div>
        <div class="result-metric"><strong>Estimated recovery time</strong><span>${
          recoveryMonths >= 99
            ? "Cash flow is too tight to estimate a safe recovery time."
            : `${recoveryMonths.toFixed(1)} month${recoveryMonths === 1 ? "" : "s"} of remaining monthly cash flow.`
        }</span></div>
        ${
          emergencyRemaining !== null
            ? `<div class="result-metric"><strong>Emergency target after funeral</strong><span>${emergencyRemaining.toFixed(1)}% of target remaining.</span></div>`
            : ""
        }
      `;

      if (pressureScore === 0) {
        guidance.textContent =
          `This funeral creates essentially no measurable financial pressure based on the numbers provided. The cost is fully covered or tiny compared with available savings, income, and obligations. Recommended next step: ${level.action}`;
      } else if (pressureScore <= 30) {
        guidance.textContent =
          `This funeral appears affordable based on the numbers provided. The household should still confirm itemized pricing and avoid emotional upgrades. Recommended next step: ${level.action}`;
      } else if (pressureScore <= 60) {
        guidance.textContent =
          `This funeral may be affordable, but the plan deserves caution. The cost affects savings, monthly flexibility, or recovery time enough that trimming the quote could help. Recommended next step: ${level.action}`;
      } else {
        guidance.textContent =
          `This funeral appears financially risky based on the numbers provided. The safer move is to lower the cost before committing, confirm help, and avoid high-interest debt. Recommended next step: ${level.action}`;
      }
    });
  </script>
</Layout>
