---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const funeralFaqs = [
  {
    question: "How do I know if I can afford a funeral?",
    answer:
      "A funeral is more affordable when savings, insurance, family help, or prepaid funds cover most of the cost without draining emergency reserves, creating high-interest debt, or crowding out rent, groceries, medical needs, transportation, or other bills.",
  },
  {
    question: "Should I use gross income or take-home income?",
    answer:
      "Use monthly take-home income. That is the money actually available after taxes and payroll deductions.",
  },
  {
    question: "Is funeral debt a bad idea?",
    answer:
      "Funeral debt can become risky when it involves credit cards, high-interest loans, unclear payment plans, or monthly payments that stretch the household after the service.",
  },
  {
    question: "What if insurance money has not arrived yet?",
    answer:
      "Delayed insurance proceeds can create short-term pressure. Before borrowing, confirm timing, ask about assignment options, compare lower-cost services, and avoid assuming money will arrive immediately.",
  },
];
---

<Layout
  title="Can I Afford a Funeral?"
  description="Use this funeral affordability calculator to compare funeral quotes against savings, insurance proceeds, family help, debt, income, and household obligations."
>
  <style>
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.7rem, 7vw, 4.8rem);
      line-height: 0.95;
      margin-bottom: 24px;
      color: #0f172a;
      max-width: 900px;
    }

    .intro {
      max-width: 820px;
      color: #334155;
      font-size: 1.12rem;
      line-height: 1.85;
      margin-bottom: 48px;
    }

    .calculator-box,
    .info-card,
    .link-card,
    .callout {
      border: 1px solid #dbe4ee;
      background: white;
      border-radius: 22px;
      padding: 26px;
    }

    .calculator-box {
      margin-bottom: 56px;
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
    }

    .calculator-box h2,
    .content-section h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-box p,
    .content-section p,
    .content-section li {
      color: #334155;
      line-height: 1.9;
      font-size: 1.06rem;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-top: 22px;
    }

    label {
      display: block;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 8px;
      font-size: 0.95rem;
    }

    input,
    select {
      width: 100%;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 13px;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }

    button {
      margin-top: 24px;
      border: none;
      border-radius: 999px;
      padding: 15px 24px;
      background: #0f766e;
      color: white;
      font-weight: 900;
      font-size: 1rem;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 32px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 32px;
      display: none;
    }

    .result.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin-bottom: 12px;
    }

    .guidance {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #dbe4ee;
      color: #0f172a;
      font-size: 1.08rem;
      line-height: 1.8;
    }

    .fine-print {
      color: #64748b;
      font-size: 0.9rem;
      margin-top: 20px;
    }

    .content-section {
      margin-top: 72px;
    }

    .content-section h3 {
      font-size: 1.3rem;
      color: #0f172a;
      margin: 28px 0 12px;
    }

    .info-grid,
    .link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 28px;
    }

    .info-card h3 {
      margin-top: 0;
    }

    .info-card p,
    .link-card span {
      margin: 0;
      color: #334155;
      line-height: 1.7;
      font-size: 0.96rem;
    }

    .link-card {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .link-card strong {
      display: block;
      color: #0f172a;
      margin-bottom: 8px;
      line-height: 1.3;
    }

    .callout {
      background: #f8fafc;
      margin-top: 28px;
    }
  </style>

  <main class="container">
    <div class="eyebrow">Funeral Affordability Calculator</div>

    <h1>Can I Afford a Funeral?</h1>

    <p class="intro">
      Funeral decisions often happen quickly, under grief, family pressure, and
      unclear pricing. This calculator compares a funeral quote against savings,
      insurance help, family contributions, income, debt, and emergency reserves
      to estimate whether the plan is manageable or financially risky.
    </p>

    <section class="calculator-box">
      <h2>Funeral Affordability Pressure Calculator</h2>

      <p>
        Enter the funeral quote, available help, household savings, take-home
        income, debt payments, and basic monthly obligations. The calculator
        estimates whether the funeral creates low, moderate, or high financial
        pressure.
      </p>

      <div class="form-grid">
        <div>
          <label for="cost">Total funeral quote</label>
          <input id="cost" type="number" placeholder="Example: 12000" />
        </div>

        <div>
          <label for="help">Insurance, prepaid funds, or family help</label>
          <input id="help" type="number" placeholder="Example: 5000" />
        </div>

        <div>
          <label for="savings">Current liquid savings</label>
          <input id="savings" type="number" placeholder="Example: 18000" />
        </div>

        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 7000" />
        </div>

        <div>
          <label for="debt">Monthly debt payments</label>
          <input id="debt" type="number" placeholder="Example: 900" />
        </div>

        <div>
          <label for="essentials">Monthly essential bills</label>
          <input id="essentials" type="number" placeholder="Example: 3800" />
        </div>

        <div>
          <label for="emergencyTarget">Minimum savings cushion wanted afterward</label>
          <input id="emergencyTarget" type="number" placeholder="Example: 12000" />
        </div>

        <div>
          <label for="borrowing">Amount likely borrowed</label>
          <input id="borrowing" type="number" placeholder="Example: 3000" />
        </div>

        <div>
          <label for="serviceType">Main plan type</label>
          <select id="serviceType">
            <option value="direct">Direct cremation / simple memorial</option>
            <option value="cremation">Cremation with service</option>
            <option value="burial" selected>Traditional burial</option>
            <option value="premium">Higher-cost burial or full service</option>
          </select>
        </div>

        <div>
          <label for="pricingClarity">Quote clarity</label>
          <select id="pricingClarity">
            <option value="clear" selected>Itemized and clear</option>
            <option value="partial">Partly clear</option>
            <option value="unclear">Unclear / package pressure</option>
          </select>
        </div>
      </div>

      <button id="calculateButton" type="button">Check Funeral Affordability</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="fill" id="scoreFill"></div>
        </div>

        <div class="result-details" id="resultDetails"></div>

        <div class="guidance" id="guidance"></div>

        <div class="fine-print">
          This is a general educational estimate, not financial, legal,
          insurance, or funeral-planning advice.
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>What Makes a Funeral Affordable?</h2>

      <p>
        A funeral is affordable when the family can pay for it without creating
        a second crisis. That usually means the cost is covered by insurance,
        prepaid arrangements, family contributions, or savings that can be used
        without destroying the household’s emergency cushion.
      </p>

      <p>
        The same funeral quote can be fine for one household and dangerous for
        another. A $12,000 funeral covered by insurance is different from a
        $12,000 funeral placed on one person’s credit card.
      </p>

      <div class="callout">
        <p>
          The question is not “Is this funeral respectful enough?” The better
          question is “Can we honor this person without leaving the family
          financially exposed afterward?”
        </p>
      </div>
    </section>

    <section class="content-section">
      <h2>What This Funeral Affordability Calculator Considers</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Out-of-Pocket Cost</h3>
          <p>
            The calculator subtracts insurance, prepaid funds, and family help
            from the funeral quote to estimate what the household must actually
            cover.
          </p>
        </div>

        <div class="info-card">
          <h3>Emergency Savings</h3>
          <p>
            Funeral spending is safer when enough savings remain for housing,
            food, transportation, medical needs, repairs, and another emergency.
          </p>
        </div>

        <div class="info-card">
          <h3>Income and Bills</h3>
          <p>
            Monthly take-home income and essential bills show whether the family
            can recover after the funeral or would be stuck rebuilding from zero.
          </p>
        </div>

        <div class="info-card">
          <h3>Borrowing Risk</h3>
          <p>
            Credit cards, personal loans, and funeral payment plans can turn a
            short-term funeral decision into months or years of pressure.
          </p>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>When a Funeral Becomes Financially Risky</h2>

      <p>
        Funeral pressure rises when the plan depends on debt, unclear pricing,
        delayed insurance money, emotional upgrades, or one person paying more
        than the household can safely absorb.
      </p>

      <ul>
        <li>The funeral would drain savings below the emergency cushion</li>
        <li>Credit cards or high-interest loans are needed to cover the bill</li>
        <li>The funeral quote is not itemized</li>
        <li>Essential bills would become harder to pay afterward</li>
        <li>Family help is assumed but not confirmed</li>
        <li>The plan is being upgraded mainly because of guilt or pressure</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Ways to Make a Funeral More Affordable</h2>

      <p>
        Before committing, ask for an itemized price list, compare burial and
        cremation options, separate required costs from optional upgrades, confirm
        insurance timing, and ask relatives for specific contributions instead
        of vague promises.
      </p>

      <p>
        Lower-cost choices can still be respectful. Direct cremation, a smaller
        memorial, a family-hosted reception, a delayed celebration of life, a
        simpler casket, fewer flowers, or postponing the headstone can reduce
        pressure without making the goodbye meaningless.
      </p>
    </section>

    <section class="content-section">
      <h2>Related Funeral Calculators</h2>

      <div class="link-grid">
        <a class="link-card" href="/funeral-price-calculator">
          <strong>Funeral Price Calculator</strong>
          <span>
            Estimate a wise funeral spending range before comparing affordability.
          </span>
        </a>

        <a class="link-card" href="/cremation-cost-calculator">
          <strong>Cremation Cost Calculator</strong>
          <span>
            Estimate direct cremation, memorial, urn, reception, travel, and
            keepsake costs.
          </span>
        </a>

        <a class="link-card" href="/burial-cost-calculator">
          <strong>Burial Cost Calculator</strong>
          <span>
            Estimate burial costs including casket, plot, vault, headstone, and
            cemetery fees.
          </span>
        </a>

        <a class="link-card" href="/funeral-payment-plan-calculator">
          <strong>Funeral Payment Plan Calculator</strong>
          <span>
            Estimate monthly payments, interest, payoff time, and financing
            pressure.
          </span>
        </a>

        <a class="link-card" href="/should-i-use-savings-for-funeral-costs">
          <strong>Should I Use Savings for Funeral Costs?</strong>
          <span>
            Decide whether using savings protects the household or drains the
            emergency fund too far.
          </span>
        </a>

        <a class="link-card" href="/funeral-calculators">
          <strong>Funeral Cost Calculators</strong>
          <span>
            Browse the full funeral calculator cluster for burial, cremation,
            insurance, savings, and debt decisions.
          </span>
        </a>
      </div>
    </section>

    <FAQSection title="Can I Afford a Funeral FAQ" faqs={funeralFaqs} />
  </main>

  <script>
  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  const getNumber = (id) => {
    const rawValue = document.getElementById(id)?.value;
    const value = Number(rawValue);
    return Number.isFinite(value) && value >= 0 ? value : 0;
  };

  const getValue = (id) => document.getElementById(id)?.value || "";

  function formatMoney(value) {
    return value.toLocaleString(undefined, {
      style: "currency",
      currency: "USD",
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    });
  }

  function getPressureLevel(score) {
    if (score <= 30) {
      return {
        label: "Low Pressure",
        stress: "Low pressure",
        colorClass: "safe",
        action:
          "Confirm itemized pricing, avoid unnecessary upgrades, and pay without creating new debt.",
      };
    }

    if (score <= 60) {
      return {
        label: "Moderate Pressure",
        stress: "Moderate pressure",
        colorClass: "caution",
        action:
          "Trim the quote, confirm family help, compare cremation or simpler options, and avoid expensive financing.",
      };
    }

    return {
      label: "High Pressure",
      stress: "High pressure",
      colorClass: "danger",
      action:
        "Reduce the funeral cost before committing. Avoid draining savings or taking on high-interest debt if a simpler service is possible.",
    };
  }

  function getServiceRisk(serviceType) {
    if (serviceType === "direct") return -5;
    if (serviceType === "cremation") return -2;
    if (serviceType === "burial") return 3;
    return 7;
  }

  function getClarityRisk(pricingClarity) {
    if (pricingClarity === "clear") return 0;
    if (pricingClarity === "partial") return 6;
    return 12;
  }

  const button = document.getElementById("calculateButton");
  const result = document.getElementById("result");
  const scoreText = document.getElementById("scoreText");
  const scoreFill = document.getElementById("scoreFill");
  const resultDetails = document.getElementById("resultDetails");
  const guidance = document.getElementById("guidance");

  button?.addEventListener("click", () => {
    const cost = getNumber("cost");
    const help = getNumber("help");
    const savings = getNumber("savings");
    const income = getNumber("income");
    const debt = getNumber("debt");
    const essentials = getNumber("essentials");
    const emergencyTarget = getNumber("emergencyTarget");
    const borrowing = getNumber("borrowing");
    const serviceType = getValue("serviceType");
    const pricingClarity = getValue("pricingClarity");

    result?.classList.add("visible");

    if (cost <= 0 || income <= 0) {
      scoreText.textContent = "Add your numbers first";
      scoreFill.style.width = "0%";
      scoreFill.className = "fill safe";
      resultDetails.innerHTML =
        "<p>Enter a positive funeral quote and monthly take-home income so the calculator can estimate affordability pressure.</p>";
      guidance.textContent = "";
      return;
    }

    const outOfPocket = Math.max(cost - help, 0);
    const savingsAfter = savings - outOfPocket;
    const cashFlowAfterBills = income - debt - essentials;

    const monthlyIncomeImpact = income > 0 ? (outOfPocket / income) * 100 : 100;
    const savingsImpact = savings > 0 ? (outOfPocket / savings) * 100 : 150;
    const debtRatio = income > 0 ? (debt / income) * 100 : 100;
    const essentialsRatio = income > 0 ? (essentials / income) * 100 : 100;
    const borrowingRatio = income > 0 ? (borrowing / income) * 100 : 100;
    const emergencyRemaining =
      emergencyTarget > 0 ? (savingsAfter / emergencyTarget) * 100 : null;

    const recoveryMonths =
      cashFlowAfterBills > 0 ? outOfPocket / cashFlowAfterBills : 99;

    const effectiveEmergencyTarget =
      emergencyTarget > 0 ? emergencyTarget : Math.max(income * 3, essentials * 2);

    const fullyCovered = outOfPocket <= 0;

    const savingsClearlyAbsorbsCost =
      savingsAfter >= effectiveEmergencyTarget &&
      outOfPocket <= savings * 0.05;

    const savingsMassivelyAbsorbsCost =
      savingsAfter >= Math.max(effectiveEmergencyTarget * 3, income * 6) &&
      outOfPocket <= savings * 0.01;

    const incomeClearlyAbsorbsCost =
      monthlyIncomeImpact <= 5 &&
      debtRatio <= 15 &&
      essentialsRatio <= 50 &&
      cashFlowAfterBills >= outOfPocket;

    const incomeMassivelyAbsorbsCost =
      monthlyIncomeImpact <= 2 &&
      debtRatio <= 10 &&
      essentialsRatio <= 40 &&
      cashFlowAfterBills >= outOfPocket * 2;

    let pressureScore = 0;

    if (fullyCovered || savingsMassivelyAbsorbsCost || incomeMassivelyAbsorbsCost) {
      pressureScore = 0;
    } else if (savingsClearlyAbsorbsCost || incomeClearlyAbsorbsCost) {
      pressureScore = 5;
    } else {
      pressureScore += clamp(monthlyIncomeImpact * 0.28, 0, 28);
      pressureScore += clamp(savingsImpact * 0.55, 0, 38);
      pressureScore += clamp(debtRatio * 0.28, 0, 18);
      pressureScore += clamp(essentialsRatio * 0.12, 0, 12);
      pressureScore += clamp(borrowingRatio * 0.4, 0, 20);

      if (outOfPocket > savings) pressureScore += 30;

      if (savingsAfter < 0) {
        pressureScore += 28;
      } else if (savingsAfter < effectiveEmergencyTarget * 0.5) {
        pressureScore += 18;
      } else if (savingsAfter < effectiveEmergencyTarget) {
        pressureScore += 10;
      } else if (savingsAfter >= effectiveEmergencyTarget * 2) {
        pressureScore -= 8;
      }

      if (cashFlowAfterBills <= 0) pressureScore += 16;
      else if (recoveryMonths > 12) pressureScore += 15;
      else if (recoveryMonths > 6) pressureScore += 9;
      else if (recoveryMonths > 3) pressureScore += 5;
      else if (recoveryMonths <= 1) pressureScore -= 5;

      pressureScore += getServiceRisk(serviceType);
      pressureScore += getClarityRisk(pricingClarity);

      if (borrowing > 0 && savingsAfter >= effectiveEmergencyTarget * 2) {
        pressureScore -= 8;
      } else if (borrowing > 0 && debtRatio >= 30) {
        pressureScore += 12;
      } else if (borrowing > 0 && savingsAfter < effectiveEmergencyTarget) {
        pressureScore += 10;
      }

      if (
        savingsImpact <= 1 &&
        monthlyIncomeImpact <= 10 &&
        savingsAfter >= effectiveEmergencyTarget &&
        debtRatio <= 15
      ) {
        pressureScore = Math.min(pressureScore, 8);
      }

      if (
        savingsImpact <= 3 &&
        monthlyIncomeImpact <= 20 &&
        savingsAfter >= effectiveEmergencyTarget &&
        debtRatio <= 25
      ) {
        pressureScore = Math.min(pressureScore, 15);
      }
    }

    pressureScore = clamp(Math.round(pressureScore), 0, 100);

    const level = getPressureLevel(pressureScore);

    scoreText.textContent = `${level.label} — ${pressureScore}/100`;
    scoreFill.style.width = `${pressureScore}%`;
    scoreFill.className = `fill ${level.colorClass}`;

    resultDetails.innerHTML = `
      <p><strong>Pressure level:</strong> ${level.stress}.</p>
      <p><strong>Funeral quote:</strong> ${formatMoney(cost)}.</p>
      <p><strong>Estimated out-of-pocket cost:</strong> ${formatMoney(outOfPocket)} after insurance, prepaid funds, or family help.</p>
      <p><strong>Estimated savings after funeral:</strong> ${formatMoney(savingsAfter)}.</p>
      <p><strong>Monthly income impact:</strong> ${monthlyIncomeImpact.toFixed(1)}% of one month’s take-home income.</p>
      <p><strong>Savings impact:</strong> ${savings > 0 ? `${savingsImpact.toFixed(3)}% of available savings.` : "No available savings entered."}</p>
      <p><strong>Debt payment pressure:</strong> ${debtRatio.toFixed(1)}% of monthly take-home income.</p>
      <p><strong>Essential bills pressure:</strong> ${essentialsRatio.toFixed(1)}% of monthly take-home income.</p>
      <p><strong>Estimated recovery time:</strong> ${
        recoveryMonths >= 99
          ? "Cash flow is too tight to estimate a safe recovery time."
          : `${recoveryMonths.toFixed(1)} month${recoveryMonths === 1 ? "" : "s"} of remaining monthly cash flow.`
      }</p>
      ${
        emergencyRemaining !== null
          ? `<p><strong>Emergency target after funeral:</strong> ${emergencyRemaining.toFixed(1)}% of target remaining.</p>`
          : ""
      }
    `;

    if (pressureScore === 0) {
      guidance.textContent =
        `This funeral creates essentially no measurable financial pressure based on the numbers provided. The cost is fully covered or tiny compared with available savings, income, and obligations. Recommended next step: ${level.action}`;
    } else if (pressureScore <= 30) {
      guidance.textContent =
        `This funeral appears affordable based on the numbers provided. The household should still confirm itemized pricing and avoid emotional upgrades. Recommended next step: ${level.action}`;
    } else if (pressureScore <= 60) {
      guidance.textContent =
        `This funeral may be affordable, but the plan deserves caution. The cost affects savings, monthly flexibility, or recovery time enough that trimming the quote could help. Recommended next step: ${level.action}`;
    } else {
      guidance.textContent =
        `This funeral appears financially risky based on the numbers provided. The safer move is to lower the cost before committing, confirm help, and avoid high-interest debt. Recommended next step: ${level.action}`;
    }
  });
</script>
</Layout>