---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const earlyPayoffFaqs = [
  {
    question: "Should I pay off my car loan early?",
    answer:
      "Paying off a car loan early can make sense when the APR is meaningful, the payoff saves real interest, emergency savings remain strong, higher-interest debt is handled, and the lender applies extra money to principal without a large prepayment penalty.",
  },
  {
    question: "When should I not pay off a car loan early?",
    answer:
      "Do not rush early payoff if it drains emergency savings, leaves credit card debt or other higher-interest debt untouched, creates negative monthly cash flow, triggers a meaningful payoff fee, or leaves no money for insurance deductibles, repairs, tires, or basic household emergencies.",
  },
  {
    question: "Should I pay off my car before credit card debt?",
    answer:
      "Usually no. If credit card debt, personal loans, or other balances have a much higher APR than the car loan, the higher-interest debt usually deserves priority because each dollar saves more interest there.",
  },
  {
    question: "Is it better to make one lump-sum car payment or extra monthly payments?",
    answer:
      "A lump-sum payment can reduce interest faster when it goes directly to principal, but it can also reduce liquidity quickly. Extra monthly payments are slower, but they may be safer if you need to keep cash available while still shortening the loan.",
  },
  {
    question: "Does paying off a car loan early save interest?",
    answer:
      "Usually yes, if the loan allows extra principal payments and any prepayment penalty is small or zero. The exact savings depend on balance, APR, current payment, months left, lump sum, extra monthly payment, and how the lender applies extra money.",
  },
  {
    question: "Should I use emergency savings to pay off my car?",
    answer:
      "Be careful. A paid-off car does not replace emergency savings. If the payoff leaves the household exposed to job loss, repairs, medical bills, insurance deductibles, or urgent travel, savings may need priority.",
  },
  {
    question: "What should I check before paying off a car loan early?",
    answer:
      "Check the payoff quote, whether extra payments go to principal, whether there is a prepayment penalty, how much emergency savings will remain, whether higher-interest debt exists, and whether the payoff improves monthly flexibility enough to justify using the cash.",
  },
];
---

<Layout
  title="Car Loan Early Payoff Calculator | Pay Off Your Car Early?"
  description="Estimate car loan early payoff interest savings, months saved, and whether extra cash should go to the car, savings, or higher-interest debt."
>
  <style>
    .container {
      max-width: 940px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(2.55rem, 7vw, 4.55rem);
      line-height: 1;
      letter-spacing: -0.055em;
      margin: 0 0 24px;
      max-width: 900px;
      color: var(--text);
    }

    h2 {
      font-size: clamp(1.8rem, 4vw, 2.45rem);
      line-height: 1.12;
      letter-spacing: -0.035em;
      margin: 0 0 18px;
      color: var(--text);
    }

    h3 {
      font-size: 1.22rem;
      line-height: 1.3;
      margin: 28px 0 10px;
      color: var(--text);
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.82;
      font-size: 1.04rem;
      margin-bottom: 18px;
    }

    a {
      color: var(--primary);
    }

    section {
      margin-top: 68px;
    }

    .intro {
      max-width: 830px;
      color: var(--muted);
      font-size: 1.14rem;
      line-height: 1.85;
      margin-bottom: 42px;
    }

    .calculator {
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 24px;
      padding: 30px;
      margin: 44px 0;
      box-shadow: var(--shadow-soft);
    }

    .calc-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
      gap: 20px;
    }

    .calc-field {
      display: flex;
      flex-direction: column;
    }

    .calc-field label {
      font-weight: 800;
      margin-bottom: 10px;
      color: var(--text);
      line-height: 1.35;
    }

    .calc-field input,
    .calc-field select {
      padding: 14px;
      border-radius: 12px;
      border: 1px solid var(--border);
      font-size: 1rem;
      background: #ffffff;
      color: var(--text);
    }

    .calc-button {
      margin-top: 26px;
      background: var(--primary);
      color: #ffffff;
      border: none;
      border-radius: 14px;
      padding: 15px 22px;
      font-size: 1rem;
      font-weight: 900;
