      color: var(--muted);
      line-height: 1.65;
      font-size: 0.95rem;
      margin: 0;
    }

    .red-flag-list {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .red-flag-list li {
      margin: 0;
      padding: 15px 16px;
      border-radius: 16px;
      border: 1px solid #fecaca;
      background: #fff7f7;
      color: #7f1d1d;
      line-height: 1.55;
      font-size: 0.96rem;
    }

    @media (max-width: 720px) {
      .container {
        padding: 58px 20px;
