---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import { calculators } from "../data/calculators.js";

const studyAbroadFaqs = [
  {
    question: "Is $10,000 too much to spend on study abroad?",
    answer:
      "$10,000 can make sense if the program supports the degree, language goals, internships, scholarships, or career value without creating debt pressure. It is riskier when the trip is mostly optional travel funded by loans or emergency savings.",
  },
  {
    question: "Is this calculator for the student or the parent?",
    answer:
      "It is for whoever is paying for study abroad. That may be the student, a parent, or both. Use the income, savings, aid, and debt that will actually support the cost.",
  },
  {
    question: "Should I include scholarships or grants?",
    answer:
      "Yes. Include scholarships, grants, financial aid refunds, 529 funds, family help, or other reliable support that can be used for the study abroad program.",
  },
  {
    question: "Does this include spending money and travel costs?",
    answer:
      "It should. Use the total expected study abroad cost, including program fees, airfare, lodging, meals, insurance, passport costs, visas, local transportation, and personal spending.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "College" &&
      calculator.href !== "/should-i-spend-10000-on-study-abroad"
  )
  .slice(0, 6);
---

<Layout
  title="Should I Spend $10,000 on Study Abroad?"
  description="Evaluate whether $10,000 study abroad makes sense based on degree value, scholarships, travel, safety, debt, savings, income, and aid."
>


  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro,
    .annual-note {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .annual-note {
      background: #ecfeff;
      border: 1px solid #99f6e4;
      border-radius: 18px;
      padding: 18px 20px;
      font-weight: 800;
      color: #115e59;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }

    .field-hint {
      display: block;
      margin-top: 8px;
      color: #64748b;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a,
    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .helper-link a:hover,
    .content-link:hover {
      text-decoration: underline;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .guidance {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid #dbe4ee;
      font-size: 1.12rem;
      line-height: 1.85;
      color: #1e293b;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
    }

    .pillar-card {
      display: block;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 24px;
      margin-top: 28px;
      text-decoration: none;
      transition: transform 0.15s ease;
    }

    .pillar-card:hover {
      transform: translateY(-2px);
    }

    .pillar-card strong {
      display: block;
      margin-bottom: 10px;
      color: #0f172a;
      font-size: 1.08rem;
    }

    .pillar-card span {
      color: #334155;
      line-height: 1.7;
      font-size: 0.98rem;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="College Travel Calculator"
      title="Should I Spend $10,000 on Study Abroad?"
      description="Pressure-test study abroad against degree relevance, scholarships, travel costs, safety, opportunity cost, borrowing, savings, income, and career value."
    >
      <div class="calculator">
        <h2>$10,000 Study Abroad Pressure Verdict</h2>

        <p class="calculator-intro">
          Study abroad can be valuable when it supports a degree, language goal,
          internship path, or career plan. It can also become expensive travel if
          the cost depends on loans, emergency savings, or vague payoff. Use the
          income, savings, aid, and debt that will actually support the program.
        </p>

        <div class="annual-note">
          Important: this evaluates one study abroad program or school-year
          abroad cost, not the total cost of the full degree.
        </div>

        <div class="grid">
          <div class="field">
            <label for="studyAbroadCost">Study Abroad Cost</label>
            <input id="studyAbroadCost" type="number" value="10000" placeholder="Example: 10000" />
            <span class="field-hint">Include program fees, airfare, housing, meals, insurance, visas, and spending money.</span>
          </div>

          <div class="field">
            <label for="income">Monthly Take-Home Income Supporting Study Abroad</label>
            <input id="income" type="number" placeholder="Example: 6500" />
            <span class="field-hint">Use student income, parent income, or both  -  only if it will help pay.</span>
          </div>

          <div class="field">
            <label for="savings">Savings Available for Study Abroad</label>
            <input id="savings" type="number" placeholder="Example: 12000" />
          </div>

          <div class="field">
            <label for="emergencyFund">Emergency Fund After Study Abroad Savings</label>
            <input id="emergencyFund" type="number" placeholder="Example: 8000" />
          </div>

          <div class="field">
            <label for="monthlyDebt">Current Monthly Debt Payments</label>
            <input id="monthlyDebt" type="number" placeholder="Example: 450" />
            <div class="helper-link">
              Not sure what counts as debt?
              <a href="/what-counts-as-debt/">Read the debt guide</a>
            </div>
          </div>

          <div class="field">
            <label for="borrowed">Amount Borrowed for Study Abroad</label>
            <input id="borrowed" type="number" placeholder="Example: 4000" />
            <div class="helper-link">
              Testing the loan side?
              <a href="/should-i-take-out-student-loans/">Use the student loan calculator</a>
            </div>
          </div>

          <div class="field">
            <label for="aid">Scholarships / Aid Covering Study Abroad</label>
            <input id="aid" type="number" placeholder="Example: 2500" />
          </div>

          <div class="field">
            <label for="outsideHelp">Reliable Family or Outside Help</label>
            <input id="outsideHelp" type="number" placeholder="Example: 2000" />
          </div>

          <div class="field">
            <label for="cashUsed">Savings Used for Study Abroad</label>
            <input id="cashUsed" type="number" placeholder="Example: 3500" />
          </div>

          <div class="field">
            <label for="degreeRelevance">Degree Relevance</label>
            <select id="degreeRelevance">
              <option value="strong">Strong: major, language, internship, or required credits</option>
              <option value="medium" selected>Some academic or cultural value</option>
              <option value="weak">Mostly travel or personal preference</option>
            </select>
          </div>

          <div class="field">
            <label for="careerValue">Career Value</label>
            <select id="careerValue">
              <option value="strong">Clear career, language, networking, or field value</option>
              <option value="medium" selected>Some resume value</option>
              <option value="weak">Little direct career value</option>
            </select>
          </div>

          <div class="field">
            <label for="travelRisk">Travel / Safety / Extra Cost Risk</label>
            <select id="travelRisk">
              <option value="low">Low risk and well-planned</option>
              <option value="medium" selected>Some extra cost risk</option>
              <option value="high">High uncertainty, safety, or extra cost risk</option>
            </select>
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="studyAbroadButton" type="button">Get Study Abroad Verdict</button>

        <div class="results" id="results">
          <div class="score" id="scoreText"></div>
          <div class="bar">
            <div class="fill" id="fillBar"></div>
          </div>
          <div class="result-details" id="resultDetails"></div>
          <div class="guidance" id="guidance"></div>
          <div class="disclaimer">
            This is a general educational estimate, not personalized financial advice or travel safety advice.
          </div>
        </div>
      </div>

<OmniStyleReviewBlock
      pageName="the $10,000 study abroad calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="$10,000 study abroad cost, degree relevance, credits, scholarships, aid, travel, safety, savings, income, debt, career value, and whether the program supports the education plan"
    />

    <CorePageExamplesBlock
      title="$10,000 study abroad examples"
      intro="Study abroad can be valuable, but the financial case is stronger when credits transfer, aid applies, and the program supports the degree or career path."
      useCases={[
          "You are deciding whether a $10,000 study abroad program is worth it.",
          "You need to include program fees, flights, housing, food, aid, scholarships, and credits.",
          "You want to compare the experience with debt, savings, and career value."
        ]}
      notEnough={[
          "You need academic advising, visa, safety, legal, or medical guidance.",
          "You need financial-aid or student-loan advice.",
          "You are choosing between specific programs or countries."
        ]}
      examples={[
          {
            label: "Credits transfer cleanly",
            takeaway: "Pressure may be lower if the program keeps graduation on schedule."
          },
          {
            label: "Program funded by loans",
            takeaway: "Pressure rises when the experience adds debt without clear academic value."
          },
          {
            label: "Scholarships confirmed",
            takeaway: "Confirmed aid can materially lower the out-of-pocket cost."
          }
        ]}
      commonMistake="Treating study abroad like a vacation instead of checking credits, aid, graduation timing, and borrowing."
      nextStep="Confirm credits, aid, and total out-of-pocket cost before deciding."
    />



      <section class="content-section">
        <h2>Start With the Real Study Abroad Cost</h2>

        <p>
          Study abroad should be judged by the full cost, not only the program
          fee. Airfare, passport costs, visas, insurance, housing, meals, local
          transportation, phone service, exchange rates, weekend travel, and
          emergency cash can change the total quickly.
        </p>

        <p>
          A $10,000 study abroad program can be reasonable if it supports the
          student's degree or career. It is harder to justify when it is mostly a
          travel experience funded by loans or savings the household cannot
          comfortably replace.
        </p>

        <a class="pillar-card" href="/college-cost-calculator/">
          <strong>College Cost Calculator</strong>
          <span>
            Estimate total college pressure using tuition, fees, housing, food,
            books, loans, savings, aid, and expected payoff.
          </span>
        </a>

        <a class="pillar-card" href="/degree-roi-calculator/">
          <strong>Degree ROI Calculator</strong>
          <span>
            Compare education cost, lost income, expected salary gains, payback
            period, debt pressure, and career upside.
          </span>
        </a>

        <a class="pillar-card" href="/should-i-spend-5000-on-college-meal-plan/">
          <strong>Should I Spend $5,000 on a College Meal Plan?</strong>
          <span>
            Test whether required or optional college food costs fit the full
            school-year budget.
          </span>
        </a>
      </section>

      <section class="content-section">
        <h2>What Study Abroad Really Includes</h2>

        <p>
          The advertised program cost may not include every expense. Some
          students need international airfare, train tickets, immunizations,
          luggage, adapters, international phone service, local transit, travel
          insurance, emergency funds, deposits, and personal spending money.
        </p>

        <p>
          The value side matters too. Study abroad may be more defensible when
          it helps with language fluency, required credits, field experience,
          internships, research, cultural competency, or a specific career path.
          Without that connection, the decision becomes closer to a discretionary
          travel purchase.
        </p>
      </section>

      <WhenSpendingMakesSense
        title="When Spending $10,000 on Study Abroad Can Make Sense"
        items={[
          "Aid, scholarships, grants, or reliable help cover most or all of the program cost.",
          "The program directly supports the student's major, language goals, internship path, or required credits.",
          "Borrowing is low or unnecessary.",
          "Emergency savings remain protected after any cash contribution.",
          "The student has a realistic travel budget beyond the advertised program fee.",
          "The experience has clear academic, career, or personal-development value that justifies the cost.",
        ]}
      />

      <KeyCostCategories
        items={[
          {
            title: "Program cost",
            description:
              "This includes tuition differences, program fees, housing, meals, and required school charges for the abroad term.",
          },
          {
            title: "Travel costs",
            description:
              "Airfare, local transportation, insurance, visas, passport costs, and emergency money can raise the real cost.",
          },
          {
            title: "Aid and scholarships",
            description:
              "Study abroad scholarships, financial aid, grants, 529 funds, or family help can reduce the uncovered cost.",
          },
          {
            title: "Borrowing",
            description:
              "Borrowing for a short-term experience should be treated carefully because repayment lasts longer than the trip.",
          },
          {
            title: "Academic and career value",
            description:
              "The cost is easier to justify when the program clearly supports a degree, language skill, internship, or career path.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Ask whether existing financial aid can be used for the study abroad program.",
          "Apply for study abroad scholarships before assuming the full cost is out of pocket.",
          "Compare faculty-led short programs with semester-long programs.",
          "Build a real travel budget that includes airfare, insurance, visas, local transportation, and emergency cash.",
          "Avoid borrowing for optional weekend travel or personal spending.",
          "Choose a program that satisfies required credits instead of adding extra semesters.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "The program is mostly optional travel funded by loans.",
          "The student would use emergency savings for flights, deposits, or spending money.",
          "The advertised cost excludes major travel, visa, insurance, or local transportation expenses.",
          "Credits may not transfer cleanly or may delay graduation.",
          "The program has weak degree relevance and little career value.",
          "The plan depends on vague family help or uncertain aid.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "Monthly income means take-home pay, not gross income.",
          "This calculator evaluates one study abroad program or one school-year abroad cost, not the full college cost.",
          "Aid, scholarships, and outside help are treated as annual or program-specific amounts.",
          "Estimated student loan payment uses a rough monthly payment equal to 1.2% of the borrowed amount.",
          "If aid and outside help fully cover study abroad, pressure can be 0/100.",
          "Huge income, huge savings, low debt, no borrowing, and strong affordability can produce 0/100 with no artificial minimum.",
        ]}
      />

      <section class="content-section">
        <h2>When Skipping Study Abroad Is the Better Move</h2>

        <p>
          Skipping or delaying study abroad may be smarter when the cost requires
          loans, the academic connection is weak, credits may not transfer, or
          the student would return with less emergency cash and more debt.
        </p>

        <p>
          A lower-cost alternative may include a shorter faculty-led trip,
          domestic internship, language immersion program, exchange program,
          scholarship-supported option, or waiting until the student has a
          stronger cash cushion.
        </p>
      </section>

      <section class="content-section">
        <h2>What Your Study Abroad Verdict Means</h2>

        <p>
          A low-pressure result means the study abroad cost appears manageable
          based on the income, savings, aid, borrowing, and support entered. A
          moderate result means the program may still work, but scholarships,
          cheaper programs, travel extras, and borrowing should be tested first.
        </p>

        <p>
          A high-pressure result does not mean study abroad is a bad idea. It
          means this version of the plan may need more aid, lower travel costs,
          less borrowing, stronger savings, or clearer degree value before it
          becomes financially durable.
        </p>
      </section>

      <div class="content-section">
        <FAQSection title="Study Abroad FAQ" faqs={studyAbroadFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="study abroad affordability" updated="June 2026" />
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const getValue = (id) => document.getElementById(id)?.value || "";

    function formatDollars(value) {
      return `$${Math.round(value).toLocaleString()}`;
    }

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action:
            "Confirm program costs, credit transfer, aid coverage, and travel budget, but the study abroad cost appears manageable.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action:
            "Compare cheaper programs, scholarships, shorter trips, travel extras, and borrowing before committing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action:
          "Reduce the program cost, avoid borrowing, choose a cheaper option, or build more cushion before committing.",
      };
    }

    function calculateStudyAbroadPressure() {
      const studyAbroadCost = getNumber("studyAbroadCost") || 10000;
      const income = getNumber("income");
      const savings = getNumber("savings");
      const emergencyFund = getNumber("emergencyFund");
      const monthlyDebt = getNumber("monthlyDebt");
      const requestedBorrowed = getNumber("borrowed");
      const aid = getNumber("aid");
      const outsideHelp = getNumber("outsideHelp");
      const requestedCashUsed = getNumber("cashUsed");
      const degreeRelevance = getValue("degreeRelevance") || "medium";
      const careerValue = getValue("careerValue") || "medium";
      const travelRisk = getValue("travelRisk") || "medium";

      const results = document.getElementById("results");
      const scoreText = document.getElementById("scoreText");
      const fillBar = document.getElementById("fillBar");
      const resultDetails = document.getElementById("resultDetails");
      const guidance = document.getElementById("guidance");

      results.classList.add("visible");

      if (studyAbroadCost <= 0) {
        scoreText.textContent = "Add the study abroad cost first";
        fillBar.style.width = "0%";
        fillBar.className = "fill safe";
        resultDetails.innerHTML =
          "<p>Enter the total study abroad cost to calculate pressure.</p>";
        guidance.textContent = "";
        return;
      }

      if (income <= 0 && savings <= 0 && aid <= 0 && outsideHelp <= 0) {
        scoreText.textContent = "Add your numbers first";
        fillBar.style.width = "0%";
        fillBar.className = "fill safe";
        resultDetails.innerHTML =
          "<p>Enter income, savings, aid, outside help, or borrowing that will support study abroad.</p>";
        guidance.textContent = "";
        return;
      }

      const annualIncome = income * 12;
      const giftHelp = aid + outsideHelp;
      const uncoveredCost = Math.max(studyAbroadCost - giftHelp, 0);

      const borrowed = Math.min(requestedBorrowed, uncoveredCost);
      const cashNeededAfterBorrowing = Math.max(uncoveredCost - borrowed, 0);
      const cashUsed =
        uncoveredCost <= 0
          ? 0
          : Math.min(
              requestedCashUsed > 0 ? requestedCashUsed : cashNeededAfterBorrowing,
              cashNeededAfterBorrowing
            );

      const remainingSavings = Math.max(savings - cashUsed, 0);
      const estimatedLoanPayment = borrowed > 0 ? borrowed * 0.012 : 0;

      const emergencyMonths = income > 0 ? emergencyFund / income : 0;
      const savingsMonthsAfter = income > 0 ? remainingSavings / income : 0;
      const totalLiquidMonthsAfter =
        income > 0 ? (remainingSavings + emergencyFund) / income : 0;

      const debtRatioAfter =
        income > 0 ? ((monthlyDebt + estimatedLoanPayment) / income) * 100 : 0;

      const uncoveredCostRatio =
        income > 0
          ? (uncoveredCost / Math.max(annualIncome, 1)) * 100
          : uncoveredCost > 0
            ? 100
            : 0;

      const cashUseRatio =
        cashUsed > 0 ? (cashUsed / Math.max(savings, 1)) * 100 : 0;

      const borrowedShare =
        borrowed > 0 && uncoveredCost > 0 ? (borrowed / uncoveredCost) * 100 : 0;

      let pressureScore = 0;
      let hardGateReason = "";

      if (uncoveredCost === 0) {
        pressureScore = 0;
        hardGateReason =
          "Aid and outside help fully cover the study abroad cost.";
      } else if (
        income >= studyAbroadCost * 2 &&
        debtRatioAfter <= 10 &&
        borrowed <= income * 0.1
      ) {
        pressureScore = 0;
        hardGateReason =
          "Monthly take-home income is large enough that the uncovered study abroad cost creates no meaningful pressure.";
      } else if (
        savings >= studyAbroadCost * 20 &&
        remainingSavings >= studyAbroadCost * 15
      ) {
        pressureScore = 0;
        hardGateReason =
          "Savings are large enough that the study abroad cost creates no meaningful pressure.";
      } else if (
        uncoveredCost <= income * 0.25 &&
        debtRatioAfter <= 10 &&
        borrowed === 0
      ) {
        pressureScore = 0;
        hardGateReason =
          "The uncovered study abroad cost is less than one week of take-home income with no borrowing needed.";
      } else {
        pressureScore += clamp(uncoveredCostRatio * 1.7, 0, 28);
        pressureScore += clamp(cashUseRatio * 0.22, 0, 16);
        pressureScore += clamp(debtRatioAfter * 0.6, 0, 26);

        if (borrowed > 0) {
          pressureScore += clamp(borrowedShare * 0.14, 0, 14);
        }

        if (emergencyMonths < 1) {
          pressureScore += savings >= studyAbroadCost * 5 ? 2 : 16;
        } else if (emergencyMonths < 3) {
          pressureScore += savings >= studyAbroadCost * 5 ? 1 : 7;
        } else if (emergencyMonths >= 6) {
          pressureScore -= 8;
        }

        if (savingsMonthsAfter >= 24) pressureScore -= 18;
        else if (savingsMonthsAfter >= 12) pressureScore -= 12;
        else if (savingsMonthsAfter >= 6) pressureScore -= 6;
        else if (cashUsed > 0 && savingsMonthsAfter < 1) pressureScore += 12;

        if (degreeRelevance === "strong") pressureScore -= 10;
        else if (degreeRelevance === "weak") pressureScore += 10;

        if (careerValue === "strong") pressureScore -= 8;
        else if (careerValue === "weak") pressureScore += 8;

        if (travelRisk === "high") pressureScore += 8;
        else if (travelRisk === "low") pressureScore -= 4;

        if (giftHelp >= studyAbroadCost * 0.75) pressureScore -= 14;
        else if (giftHelp >= studyAbroadCost * 0.5) pressureScore -= 10;
        else if (giftHelp >= studyAbroadCost * 0.25) pressureScore -= 5;

        if (
          savings >= studyAbroadCost * 12 &&
          remainingSavings >= studyAbroadCost * 10 &&
          debtRatioAfter <= 12
        ) {
          pressureScore = Math.min(pressureScore, 5);
        }

        if (
          savings >= studyAbroadCost * 8 &&
          remainingSavings >= studyAbroadCost * 6 &&
          debtRatioAfter <= 15
        ) {
          pressureScore = Math.min(pressureScore, 10);
        }

        if (
          income >= studyAbroadCost &&
          uncoveredCost <= income &&
          debtRatioAfter <= 12
        ) {
          pressureScore = Math.min(pressureScore, 5);
        }

        if (
          borrowed === 0 &&
          uncoveredCost <= income &&
          debtRatioAfter <= 10
        ) {
          pressureScore = Math.min(pressureScore, 3);
        }
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      scoreText.textContent = `${level.label}  -  ${pressureScore}/100`;
      fillBar.style.width = `${pressureScore}%`;
      fillBar.className = `fill ${level.colorClass}`;

      let explanation = "";

      if (pressureScore === 0) {
        explanation =
          hardGateReason ||
          "This study abroad cost creates virtually no measurable pressure based on the income, savings, debt, borrowing, and aid entered.";
      } else if (pressureScore <= 30) {
        explanation =
          "This study abroad cost appears manageable. The main job is confirming credit transfer, travel budget, program value, and cheaper alternatives.";
      } else if (pressureScore <= 60) {
        explanation =
          "This study abroad decision may work, but it deserves caution. Compare scholarships, shorter programs, travel extras, and borrowing before committing.";
      } else {
        explanation =
          "This study abroad decision could create significant financial pressure. A cheaper program, more aid, less borrowing, or stronger savings cushion would likely be safer.";
      }

      resultDetails.innerHTML = `
        <p><strong>Total study abroad cost:</strong> ${formatDollars(studyAbroadCost)}.</p>

        <p><strong>Aid and outside help applied:</strong> ${formatDollars(giftHelp)}.</p>

        <p><strong>Uncovered study abroad cost:</strong> ${formatDollars(uncoveredCost)}.</p>

        <p><strong>Uncovered cost impact:</strong> ${uncoveredCostRatio.toFixed(1)}% of annual take-home income.</p>

        <p><strong>Estimated loan payment:</strong> About ${formatDollars(estimatedLoanPayment)} per month based on uncovered borrowing.</p>

        <p><strong>Debt impact after borrowing:</strong> ${debtRatioAfter.toFixed(1)}% of monthly take-home income, including estimated study abroad borrowing.</p>

        <p><strong>Emergency fund coverage:</strong> ${emergencyMonths.toFixed(1)} months of take-home income.</p>

        <p><strong>Savings after planned cash use:</strong> About ${savingsMonthsAfter.toFixed(1)} months of take-home income.</p>

        <p><strong>Total liquid cushion after study abroad:</strong> About ${totalLiquidMonthsAfter.toFixed(1)} months of take-home income.</p>

        <p><strong>Pressure level:</strong> ${level.stress}.</p>

        <p>${explanation} Recommended next step: ${level.action}</p>
      `;

      guidance.textContent = "";
    }

    document
      .getElementById("studyAbroadButton")
      .addEventListener("click", calculateStudyAbroadPressure);
  </script>
</Layout>
