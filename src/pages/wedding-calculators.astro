---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const weddingCalculatorOrder = [
  "/wedding-catering-cost-calculator/",
  "/wedding-photography-cost-calculator/",
  "/wedding-calculators/",
  "/wedding-flowers-and-decor-cost-calculator/",
  "/wedding-dj-and-music-cost-calculator/",
  "/rehearsal-dinner-cost-calculator/",
  "/wedding-invitations-and-stationery-cost-calculator/",
  "/wedding-planner/",
  "/wedding-calculators/",
  "/wedding-calculators/",
  "/how-to-budget-for-a-wedding-without-going-into-debt/",
  "/destination-wedding/",
  "/should-i-spend-30000-on-a-wedding/",
  "/should-i-spend-15000-on-a-wedding/",
  "/should-i-spend-40000-on-a-wedding/",
  "/should-i-spend-50000-on-a-wedding/",
  "/should-i-spend-20000-on-a-wedding-venue/",
  "/should-i-spend-10000-on-a-destination-wedding/",
];

const weddingCalculators = calculators
  .filter((calculator) => calculator.category === "Weddings")
  .sort((a, b) => {
    const aIndex = weddingCalculatorOrder.indexOf(a.href);
    const bIndex = weddingCalculatorOrder.indexOf(b.href);

    if (aIndex === -1 && bIndex === -1) {
      return a.title.localeCompare(b.title);
    }

    if (aIndex === -1) {
      return 1;
    }

    if (bIndex === -1) {
      return -1;
    }

    return aIndex - bIndex;
  });

const weddingFaqs = [
  {
    question: "How much should you spend on a wedding?",
    answer:
      "The right wedding budget depends on take-home income, savings, debt, emergency funds, family help, guest count, local vendor costs, and whether the couple still has financial flexibility after the celebration.",
  },
  {
    question: "Is a $30,000 wedding too much?",
    answer:
      "A $30,000 wedding may be manageable for some couples and stressful for others. The key question is whether it drains savings, creates debt, delays housing goals, or leaves too little emergency cushion after the wedding.",
  },
  {
    question: "Should you finance a wedding?",
    answer:
      "Financing a wedding can create long-term pressure, especially through credit cards or high-interest personal loans. A wedding is usually safer when most costs are paid from planned savings while preserving an emergency fund.",
  },
  {
    question: "What wedding costs do couples forget?",
    answer:
      "Commonly missed costs include taxes, gratuities, service fees, alterations, vendor meals, postage, hotel rooms, transportation, rentals, rehearsal events, overtime, beauty trials, marriage license fees, and last-minute upgrades.",
  },
  {
    question: "Should honeymoon costs be part of the wedding budget?",
    answer:
      "Yes. Wedding and honeymoon spending often happen close together, so couples should consider the combined savings impact, debt risk, and monthly cash-flow pressure before committing to both.",
  },
  {
    question: "Is it better to cut the guest list or cut vendors?",
    answer:
      "Often, reducing guest count has the biggest impact because it can lower food, drinks, rentals, venue size, invitations, favors, transportation, and staffing. Vendor cuts can help too, but guest count usually drives several categories at once.",
  },
];

const featuredWeddingLinks = [
  {
    href: "/wedding-catering-cost-calculator/",
    title: "Wedding Catering Cost Calculator",
    text:
      "Estimate food, bar, staffing, rentals, service fees, tax, gratuity, and guest-count pressure.",
  },
  {
    href: "/wedding-photography-cost-calculator/",
    title: "Wedding Photography Cost Calculator",
    text:
      "Pressure-test coverage hours, second shooter needs, travel, albums, overtime, and photo budget share.",
  },
  {
    href: "/wedding-calculators/",
    title: "Should I Invite This Many Wedding Guests?",
    text:
      "See how the guest list affects catering, venue, bar, rentals, lodging, and family expectations.",
  },
  {
    href: "/wedding-flowers-and-decor-cost-calculator/",
    title: "Wedding Flowers and Decor Cost Calculator",
    text:
      "Estimate bouquets, centerpieces, ceremony pieces, installations, rentals, setup, strike, and decor pressure.",
  },
  {
    href: "/wedding-dj-and-music-cost-calculator/",
    title: "Wedding DJ and Music Cost Calculator",
    text:
      "Estimate reception hours, ceremony audio, MC duties, lighting, overtime, travel, and music pressure.",
  },
  {
    href: "/should-i-spend-30000-on-a-wedding/",
    title: "$30,000 Wedding Calculator",
    text:
      "Use a broad total-budget pressure test after checking the biggest wedding vendor categories.",
  },
];

const weddingCostCategories = [
  {
    title: "Venue and catering",
    text:
      "Venue fees, food, bar packages, service charges, staffing, cake cutting, taxes, gratuities, rentals, and minimum spends often make up the largest share of the budget.",
  },
  {
    title: "Guest count costs",
    text:
      "Every additional guest can affect meals, drinks, tables, chairs, linens, invitations, favors, transportation, venue size, and after-party or brunch costs.",
  },
  {
    title: "Photography and video",
    text:
      "Photo and video costs can be worth prioritizing, but packages, second shooters, extra hours, albums, travel fees, and engagement shoots can raise the final number.",
  },
  {
    title: "Attire and beauty",
    text:
      "Dresses, suits, alterations, shoes, hair, makeup, trials, accessories, steaming, and last-minute changes can quietly exceed the original estimate.",
  },
  {
    title: "Decor, flowers, and rentals",
    text:
      "Florals, centerpieces, arches, candles, signage, lounge furniture, lighting, linens, tents, chairs, and specialty rentals can grow quickly if the design vision expands.",
  },
  {
    title: "Weekend and afterward costs",
    text:
      "Rehearsal dinners, welcome drinks, hotel blocks, transportation, brunches, honeymoon spending, name changes, tips, thank-you cards, and post-wedding bills matter too.",
  },
];

const pressureFactors = [
  {
    title: "Take-home income",
    text:
      "Wedding affordability should be judged against money actually available to the couple or household, not gross income before taxes and deductions.",
  },
  {
    title: "Emergency savings",
    text:
      "A wedding is safer when it does not wipe out the cash needed for medical bills, car repairs, housing problems, job changes, or other emergencies.",
  },
  {
    title: "Debt added",
    text:
      "Credit cards, personal loans, buy-now-pay-later plans, and family loans can make one celebration affect the first years of marriage.",
  },
  {
    title: "Family help",
    text:
      "Confirmed outside help, parent contributions, gifts, or prepaid costs should reduce the uncovered amount. Unconfirmed help should not be treated as guaranteed.",
  },
  {
    title: "Post-wedding goals",
    text:
      "Housing, debt payoff, emergency savings, travel, children, relocation, and career changes should be considered before locking in a large wedding budget.",
  },
  {
    title: "Guest count flexibility",
    text:
      "A couple with a flexible guest list usually has more ways to control costs than a couple locked into a large invitation count.",
  },
];

const redFlags = [
  "The wedding would use nearly all emergency savings.",
  "The plan depends on credit cards or high-interest personal loans.",
  "The couple has not included taxes, gratuities, service fees, or vendor tips.",
  "Family contributions are assumed but not confirmed.",
  "The guest list keeps growing while the budget stays the same.",
  "The honeymoon is separate from the budget even though it will be paid around the same time.",
  "The wedding delays rent stability, housing goals, debt payoff, or basic emergency savings.",
  "The couple is upgrading vendors because of pressure, comparison, or fear of disappointing others.",
];

const reduceCostTips = [
  {
    title: "Cut guest count before cutting everything else",
    text:
      "Guest count affects food, drinks, rentals, invitations, favors, venue size, transportation, and staffing. It is often the most powerful cost lever.",
  },
  {
    title: "Ask for the all-in number",
    text:
      "Venue and catering quotes should include taxes, service charges, gratuities, rentals, staffing, bar fees, overtime, and required minimums.",
  },
  {
    title: "Separate must-have from nice-to-have",
    text:
      "Pick the few things that matter most, then reduce spending on categories that mostly exist because of comparison or expectation.",
  },
  {
    title: "Limit wedding-weekend creep",
    text:
      "Welcome parties, brunches, hotel gifts, extra transportation, and family hosting can turn a one-day budget into a full-weekend expense.",
  },
  {
    title: "Protect the emergency fund",
    text:
      "A meaningful celebration is not worth starting married life without cash for normal emergencies.",
  },
  {
    title: "Budget the honeymoon together",
    text:
      "The honeymoon may feel separate emotionally, but financially it often hits the same savings account and credit cards.",
  },
];

const assumptions = [
  "Monthly income means take-home pay available to support the couple or household, not gross income.",
  "Confirmed family help, gifts, or outside contributions should reduce the true uncovered wedding cost.",
  "Unconfirmed help should not be treated as guaranteed.",
  "High-interest wedding debt is treated as a major pressure factor.",
  "A wedding is less risky when emergency savings remain strong afterward.",
  "Honeymoon spending should be considered alongside wedding spending because the costs often happen close together.",
];

const relatedGuides = [
  {
    href: "/how-to-budget-for-a-wedding-without-going-into-debt/",
    title: "How to Budget for a Wedding Without Going Into Debt",
    text:
      "Build a realistic wedding plan that protects savings, avoids panic borrowing, and keeps the celebration grounded.",
  },
  {
    href: "/how-much-emergency-savings-should-i-have/",
    title: "Emergency Savings Calculator",
    text:
      "See how much cushion to preserve before committing cash to a large one-day or weekend event.",
  },
  {
    href: "/how-much-debt-is-too-much/",
    title: "How Much Debt Is Too Much?",
    text:
      "Understand whether debt payments leave room for a wedding, honeymoon, housing, and post-wedding goals.",
  },
  {
    href: "/how-much-house-can-i-afford/",
    title: "How Much House Can I Afford?",
    text:
      "Compare wedding spending with housing goals, monthly obligations, and longer-term household planning.",
  },
  {
    href: "/travel-calculators/",
    title: "Travel Calculators",
    text:
      "Compare honeymoon and post-wedding travel spending against savings, debt, and monthly flexibility.",
  },
  {
    href: "/budget-rule-calculators/",
    title: "Budget Rule Calculators",
    text:
      "Pressure-test major spending decisions using income, savings, debt, and affordability rules.",
  },
];

const internalLinks = [
  { href: "/wedding-catering-cost-calculator/", label: "catering cost" },
  { href: "/wedding-photography-cost-calculator/", label: "photography cost" },
  { href: "/wedding-calculators/", label: "guest count" },
  { href: "/wedding-flowers-and-decor-cost-calculator/", label: "flowers and decor" },
  { href: "/wedding-dj-and-music-cost-calculator/", label: "DJ and music" },
  { href: "/rehearsal-dinner-cost-calculator/", label: "rehearsal dinner" },
  { href: "/wedding-invitations-and-stationery-cost-calculator/", label: "invitations" },
  { href: "/should-i-spend-30000-on-a-wedding/", label: "$30,000 wedding" },
  { href: "/how-to-budget-for-a-wedding-without-going-into-debt/", label: "wedding debt guide" },
  { href: "/calculators/", label: "all calculators" },
];
---

<Layout
  title="Wedding Budget Calculators | Wedding Costs, Debt and Savings"
  description="Use wedding calculators for catering, photography, flowers, DJ, rehearsal dinner, invitations, honeymoon costs, debt, savings, and affordability."
>
  <style>
    .hub-page {
      width: 92%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 72px 0 20px;
    }

    .hero {
      max-width: 940px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      max-width: 980px;
      font-size: clamp(2.75rem, 6.4vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      margin: 0 0 24px;
      color: var(--text);
    }

    h2 {
      font-size: clamp(1.85rem, 3.6vw, 2.65rem);
      line-height: 1.08;
      letter-spacing: -0.035em;
      margin: 0 0 18px;
      color: var(--text);
    }

    h3 {
      color: var(--text);
      font-size: 1.15rem;
      line-height: 1.32;
      margin: 0 0 10px;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.04rem;
    }

    .intro {
      max-width: 880px;
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.85;
      margin: 0 0 18px;
    }

    .section {
      margin-top: 76px;
      max-width: 920px;
    }

    .wide-section {
      margin-top: 76px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-top: 34px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      margin-top: 28px;
    }

    .verdict-bar,
    .callout,
    .note {
      margin-top: 56px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 32px;
      box-shadow: var(--shadow-soft);
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .info-card,
    .link-card {
      display: block;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 20px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: var(--shadow-soft);
    }

    .info-card p,
    .link-card span {
      display: block;
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .link-card strong {
      display: block;
      color: var(--text);
      line-height: 1.3;
      font-size: 1.08rem;
      margin: 0 0 10px;
    }

    .check-list,
    .red-flag-list {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .check-list li,
    .red-flag-list li {
      margin: 0;
      padding: 15px 16px;
      border-radius: 16px;
      line-height: 1.55;
      font-size: 0.96rem;
    }

    .red-flag-list li {
      border: 1px solid #fecaca;
      background: #fff7f7;
      color: #7f1d1d;
    }

    .check-list li {
      border: 1px solid #cfeee1;
      background: #f1fbf6;
      color: #173404;
    }

    .inline-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .inline-links a {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 800;
      font-size: 0.92rem;
      background: var(--card);
    }

    .inline-links a:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .dark-callout {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
      color: #ffffff;
    }

    .dark-callout h2 {
      color: #ffffff;
    }

    .dark-callout p {
      color: #e7eadf;
    }

    @media (max-width: 720px) {
      .hub-page {
        padding: 56px 0 12px;
      }

      h1 {
        font-size: 2.55rem;
        line-height: 1.03;
      }

      .intro,
      p,
      li {
        font-size: 1rem;
      }

      .grid,
      .info-grid,
      .link-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .section,
      .wide-section {
        margin-top: 58px;
      }

      .verdict-bar,
      .callout,
      .note {
        padding: 24px;
      }
    }
  </style>

  <main class="hub-page">
    <section class="hero">
      <div class="eyebrow">Wedding Budget Calculators</div>

      <h1>A wedding budget is really a first-year-marriage decision.</h1>

      <p class="intro">
        Wedding spending can snowball fast once venue minimums, catering, bar
        packages, photography, attire, flowers, rentals, travel, tips, taxes, and
        guest count collide.
      </p>

      <p class="intro">
        These calculators help pressure-test a wedding budget against take-home
        income, savings, debt, emergency reserves, family help, honeymoon plans,
        and post-wedding flexibility.
      </p>

      <div class="inline-links">
        {internalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </section>

    <section id="AdSenseHubReview" class="callout">
      <div class="eyebrow">Review status</div>
      <h2>Wedding calculator hub reviewed for pressure, trust, and crawlable guidance.</h2>

      <p>
        <strong>Written and maintained by Dustin Baker.</strong> Last reviewed: July 2026.
        This hub is part of the ShouldISpend calculator library and is being reviewed
        for AdSense readiness, clean internal links, visible examples, and clear limits.
      </p>

      <p>
        These calculators are educational pressure tests. They help readers compare
        wedding budgets, vendor deposits, guest count, family help, savings, and debt risk against take-home income, savings, debt, outside help, monthly
        breathing room, and recovery risk. They are not personalized financial, legal,
        tax, medical, insurance, or investment advice.
      </p>

      <p>
        For more context, review the <a href="/methodology/">Methodology</a>,
        <a href="/editorial-policy/">Editorial Policy</a>, and
        <a href="/disclaimer/">Disclaimer</a>.
      </p>
    </section>

    <section id="CrawlableHubExamples" class="wide-section">
      <div class="eyebrow">Worked examples</div>
      <h2>Examples this hub is meant to help pressure-test</h2>

      <p>
        These examples are visible before anyone uses a form. They show how the same
        category can produce very different pressure depending on savings, income,
        debt, outside help, urgency, and whether the decision creates a recurring bill.
      </p>

      <ul class="check-list">
        <li>$30,000 wedding with $20,000 confirmed family help and no credit-card borrowing.</li>
        <li>$50,000 wedding where deposits drain emergency savings before final vendor payments arrive.</li>
        <li>A smaller guest list that protects savings versus a larger reception that depends on debt.</li>
        <li>A destination wedding where travel costs shift pressure from the couple to guests or family.</li>
      </ul>
    </section>

    <section id="HubLimits" class="section">
      <div class="eyebrow">When this hub is not enough</div>
      <h2>Use the calculators as a starting point, not the final word.</h2>

      <p>
        A calculator can clarify pressure, but it cannot know every detail of a household.
        Slow down before relying on a result alone when the decision involves legal
        obligations, taxes, medical treatment, insurance disputes, unstable income,
        major debt, family obligations, or a situation where the lowest-cost option
        could create larger harm later.
      </p>
    </section>


    <section class="wide-section">
      <div class="eyebrow">Start here</div>
      <h2>Start with the biggest wedding cost drivers</h2>

      <div class="link-grid">
        {featuredWeddingLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    {weddingCalculators.length > 0 && (
      <section class="wide-section">
        <div class="eyebrow">All wedding calculators</div>
        <h2>All wedding cost and affordability calculators</h2>

        <p>
          Use these tools to compare wedding budgets, honeymoon costs, guest count,
          savings drawdown, debt pressure, family help, vendor costs, and the
          financial room left after the celebration.
        </p>

        <div class="grid">
          {weddingCalculators.map((calculator) => (
            <CalculatorCard
              category={calculator.category}
              title={calculator.title}
              description={calculator.description}
              href={calculator.href}
            />
          ))}
        </div>
      </section>
    )}

    <div class="verdict-bar">
      <div class="verdict-label">Wedding pressure</div>

      <h2>The event can be paid for and still leave the household cornered.</h2>

      <p>
        A wedding can be meaningful, memorable, and still too expensive for the
        couple behind it. The pressure is not only the invoice. It is the cash left
        afterward, the debt added, the goals delayed, and the emergency room the
        couple still has after the celebration and honeymoon are over.
      </p>
    </div>

    <section class="section">
      <div class="eyebrow">Decision framework</div>
      <h2>What wedding affordability really means</h2>

      <p>
        Wedding affordability is not the same as being able to make the deposit.
        A couple may be able to book a venue today and still struggle later when
        final payments, attire, tips, travel, and honeymoon expenses arrive close
        together.
      </p>

      <p>
        The healthier question is whether the couple can celebrate without damaging
        the first year of marriage. That means preserving emergency savings, avoiding
        high-interest debt, respecting housing goals, and being honest about what
        family help is confirmed versus hoped for.
      </p>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Cost categories</div>
      <h2>What wedding costs can include</h2>

      <div class="info-grid">
        {weddingCostCategories.map((category) => (
          <div class="info-card">
            <h3>{category.title}</h3>
            <p>{category.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Pressure factors</div>
      <h2>What makes wedding spending manageable or risky</h2>

      <p>
        A wedding calculator should not judge the celebration in isolation. It
        should judge the wedding against the couple's full financial picture.
      </p>

      <div class="info-grid">
        {pressureFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Lower the pressure</div>
      <h2>Ways to make a wedding budget safer</h2>

      <div class="info-grid">
        {reduceCostTips.map((tip) => (
          <div class="info-card">
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="eyebrow">Warning signs</div>
      <h2>Wedding budget red flags</h2>

      <p>
        These warning signs do not mean the wedding should not happen. They mean
        the budget needs more pressure testing before more deposits are paid.
      </p>

      <ul class="red-flag-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="eyebrow">When spending more can make sense</div>
      <h2>An expensive wedding is not automatically irresponsible.</h2>

      <p>
        Spending more can be reasonable when the couple has strong savings, confirmed
        family help, low debt, stable income, and a clear reason for prioritizing
        the event.
      </p>

      <p>
        It can also make sense to spend more on categories that protect the guest
        experience or the couple's values: food, accessibility, photography,
        transportation, or a venue that keeps logistics simple.
      </p>

      <p>
        The problem is spending more because every upgrade feels mandatory. The
        strongest wedding budget reflects actual priorities, not comparison, guilt,
        vendor pressure, or fear of disappointing people.
      </p>
    </section>

    <section class="section">
      <div class="eyebrow">Assumptions</div>
      <h2>How these calculators think about wedding costs</h2>

      <p>
        These assumptions help keep wedding budget results realistic across different
        couples and event styles.
      </p>

      <ul class="check-list">
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Related tools</div>
      <h2>Other calculators that connect to wedding planning</h2>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>
            <span>{guide.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="callout dark-callout">
      <div class="eyebrow">Use these as pressure tests</div>

      <h2>A wedding calculator is not a permission slip.</h2>

      <p>
        A low-pressure result does not mean every upgrade is worth buying. A
        high-pressure result does not mean the celebration has to disappear. The
        result should help the couple see the tradeoff clearly: what the wedding
        costs, what it adds emotionally, what it delays financially, and how much
        breathing room remains afterward.
      </p>
    </section>

    <FAQSection title="Wedding Budget FAQ" faqs={weddingFaqs} />
  </main>
</Layout>
