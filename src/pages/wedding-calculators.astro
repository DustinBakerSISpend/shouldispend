---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const weddingCalculators = calculators.filter(
  (calculator) => calculator.category === "Weddings"
);

const featuredWeddingLinks = [
  {
    href: "/should-i-spend-15000-on-a-wedding",
    title: "$15,000 Wedding Calculator",
    text:
      "Pressure-test a leaner wedding budget against savings, guest count, debt, and first-year marriage flexibility.",
  },
  {
    href: "/should-i-spend-30000-on-a-wedding",
    title: "$30,000 Wedding Calculator",
    text:
      "Evaluate whether a mid-to-large wedding budget fits your income, emergency cushion, and other financial goals.",
  },
  {
    href: "/should-i-spend-50000-on-a-wedding",
    title: "$50,000 Wedding Calculator",
    text:
      "Treat a high-cost wedding like a major financial event and test whether the tradeoff is sustainable.",
  },
  {
    href: "/should-i-spend-15000-on-a-honeymoon",
    title: "$15,000 Honeymoon Calculator",
    text:
      "Look at the combined post-wedding impact of travel spending, savings drawdown, and debt pressure.",
  },
];

const planningLinks = [
  {
    href: "/how-to-budget-for-a-wedding-without-going-into-debt",
    title: "How to Budget for a Wedding Without Going Into Debt",
    text:
      "Build a realistic wedding plan that protects savings, avoids panic borrowing, and keeps the celebration grounded.",
  },
  {
    href: "/what-counts-as-debt",
    title: "What Counts as Debt?",
    text:
      "Understand which obligations matter when judging whether a wedding budget adds too much pressure.",
  },
  {
    href: "/how-much-emergency-savings-should-i-have",
    title: "Emergency Savings Guide",
    text:
      "See how much cushion to preserve before committing cash to a large one-day or weekend event.",
  },
  {
    href: "/how-much-house-can-i-afford",
    title: "How Much House Can I Afford?",
    text:
      "Compare wedding spending with housing goals, monthly obligations, and longer-term household planning.",
  },
];

const weddingCostFactors = [
  {
    title: "Guest Count Pressure",
    text:
      "Food, drinks, tables, invitations, favors, rentals, and venue size often rise with every additional guest.",
  },
  {
    title: "Venue and Catering Minimums",
    text:
      "A reasonable-looking quote can change quickly once minimums, service fees, gratuities, and taxes are added.",
  },
  {
    title: "Weekend Spillover Costs",
    text:
      "Rehearsal dinners, welcome drinks, hotels, transportation, brunches, and family hosting can expand the real budget.",
  },
  {
    title: "Post-Wedding Cash Flow",
    text:
      "The healthiest wedding budget leaves room for rent or mortgage payments, debt payoff, travel, repairs, and emergencies afterward.",
  },
];

const weddingFaqs = [
  {
    question: "How much should you spend on a wedding?",
    answer:
      "The right wedding budget depends on income, savings, debt, emergency funds, family help, guest count, local costs, and whether the expense leaves enough flexibility after the celebration.",
  },
  {
    question: "Is a $30,000 wedding too much?",
    answer:
      "A $30,000 wedding may be manageable for some households and stressful for others. The key question is whether it drains savings, creates debt, delays housing goals, or leaves little emergency cushion.",
  },
  {
    question: "Should you finance a wedding?",
    answer:
      "Financing a wedding can create long-term pressure, especially through credit cards or high-interest personal loans. A wedding is usually safer when most costs are paid from planned savings while preserving an emergency fund.",
  },
  {
    question: "What wedding costs do couples forget?",
    answer:
      "Commonly missed costs include taxes, gratuities, service fees, alterations, vendor meals, postage, hotel rooms, transportation, rentals, rehearsal events, overtime, and last-minute upgrades.",
  },
  {
    question: "Should honeymoon costs be part of the wedding budget?",
    answer:
      "Yes. Wedding and honeymoon spending often happen close together, so couples should consider the combined savings impact, debt risk, and monthly cash flow pressure before committing to both.",
  },
];
---

<Layout
  title="Wedding Budget Calculators | ShouldISpend"
  description="Browse wedding budget calculators for $15,000, $30,000, and $50,000 weddings, plus honeymoon, debt, savings, and affordability guidance."
>
  <style>
    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 76px 24px 90px;
    }

    .hero {
      max-width: 920px;
      margin-bottom: 42px;
    }

    .eyebrow {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(2.8rem, 7vw, 5rem);
      line-height: 0.98;
      margin: 0 0 24px;
      color: var(--text);
      letter-spacing: -0.05em;
      max-width: 950px;
    }

    .intro {
      max-width: 850px;
      color: var(--muted);
      font-size: 1.12rem;
      line-height: 1.85;
      margin: 0;
    }

    .trust-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 36px 0 64px;
    }

    .trust-item {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px 20px;
    }

    .trust-item strong {
      display: block;
      color: var(--text);
      margin-bottom: 6px;
      font-size: 0.98rem;
    }

    .trust-item span {
      color: var(--muted);
      line-height: 1.55;
      font-size: 0.92rem;
    }

    .grid,
    .link-grid,
    .info-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      margin-top: 28px;
    }

    .link-grid,
    .info-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 28px;
    }

    .content-section {
      margin-top: 76px;
    }

    .content-section.narrow {
      max-width: 860px;
    }

    .section-kicker {
      color: var(--accent);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.76rem;
      margin-bottom: 12px;
    }

    .content-section h2 {
      font-size: clamp(1.85rem, 4vw, 2.35rem);
      margin: 0 0 18px;
      line-height: 1.15;
      color: var(--text);
      letter-spacing: -0.035em;
    }

    .content-section p,
    .content-section li {
      color: var(--muted);
      line-height: 1.82;
      margin-bottom: 18px;
      font-size: 1.04rem;
    }

    .link-card,
    .info-card {
      display: block;
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: rgba(15, 118, 110, 0.35);
      box-shadow: 0 16px 35px rgba(15, 23, 42, 0.08);
    }

    .link-card strong,
    .info-card h3 {
      display: block;
      color: var(--text);
      margin-bottom: 10px;
      font-size: 1.05rem;
    }

    .link-card span,
    .info-card p {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .callout {
      margin-top: 72px;
      padding: 30px;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: #f8fafc;
      max-width: 900px;
    }

    .callout h2 {
      margin: 0 0 14px;
      color: var(--text);
      font-size: 1.55rem;
      letter-spacing: -0.02em;
    }

    .callout p {
      color: var(--muted);
      line-height: 1.78;
      margin: 0;
    }

    @media (max-width: 768px) {
      .container {
        padding: 54px 18px 76px;
      }

      h1 {
        font-size: 2.75rem;
      }

      .intro {
        font-size: 1.04rem;
      }

      .trust-strip {
        grid-template-columns: 1fr;
        margin-bottom: 50px;
      }

      .grid,
      .link-grid,
      .info-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .content-section {
        margin-top: 58px;
      }
    }
  </style>

  <main class="container">
    <section class="hero">
      <div class="eyebrow">Wedding Calculators</div>

      <h1>Wedding Budget Calculators for Real-Life Tradeoffs</h1>

      <p class="intro">
        Wedding spending can snowball fast once venue minimums, catering,
        photography, attire, flowers, rentals, travel, tips, taxes, and guest
        count collide. These calculators help pressure-test a wedding budget
        against income, savings, debt, emergency reserves, and post-wedding
        flexibility.
      </p>
    </section>

    <div class="trust-strip">
      <div class="trust-item">
        <strong>Beyond the sticker price</strong>
        <span>
          Wedding affordability depends on the after-effect, not just the invoice.
        </span>
      </div>

      <div class="trust-item">
        <strong>Debt-aware planning</strong>
        <span>
          Tools flag pressure from loans, credit cards, and reduced monthly flexibility.
        </span>
      </div>

      <div class="trust-item">
        <strong>Marriage-first framing</strong>
        <span>
          The goal is a meaningful celebration without starting married life financially cornered.
        </span>
      </div>
    </div>

    <section class="content-section">
      <div class="section-kicker">Start Here</div>

      <h2>Wedding Affordability Calculators</h2>

      <p>
        Use these tools to compare different wedding budgets and see how each
        one may affect savings, monthly breathing room, debt risk, and the
        financial reset period after the event.
      </p>

      <div class="grid">
        {weddingCalculators.map((calculator) => (
          <CalculatorCard
            category={calculator.category}
            title={calculator.title}
            description={calculator.description}
            href={calculator.href}
          />
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-kicker">Popular Tools</div>

      <h2>Compare Common Wedding Budget Levels</h2>

      <p>
        A $15,000 wedding, a $30,000 wedding, and a $50,000 wedding are not just
        different price points. They often create different guest-list pressure,
        savings tradeoffs, vendor expectations, and post-wedding recovery timelines.
      </p>

      <div class="link-grid">
        {featuredWeddingLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section narrow">
      <div class="section-kicker">Budget Philosophy</div>

      <h2>How Much Should You Spend on a Wedding?</h2>

      <p>
        There is no universal correct wedding budget. The right number depends
        on household income, existing debt, family contributions, savings,
        emergency funds, local vendor prices, guest count, and how much
        financial pressure the couple is willing to carry afterward.
      </p>

      <p>
        A wedding that feels manageable for one household may create years of
        stress for another. A safer wedding budget usually avoids high-interest
        debt, preserves an emergency cushion, and does not delay major goals
        like housing, debt payoff, retirement savings, or family planning.
      </p>

      <p>
        The healthiest question is not “What can we technically pay for?” It is
        “What can we celebrate without creating a financial hangover?”
      </p>
    </section>

    <section class="content-section">
      <div class="section-kicker">Hidden Costs</div>

      <h2>Wedding Expenses That Quietly Change the Final Number</h2>

      <div class="info-grid">
        {weddingCostFactors.map((item) => (
          <div class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-kicker">Planning Guides</div>

      <h2>Wedding Planning and Financial Pressure Guides</h2>

      <p>
        These guides help connect wedding spending with the bigger household
        picture: debt, emergency savings, housing goals, and the early financial
        months after the celebration.
      </p>

      <div class="link-grid">
        {planningLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="callout">
      <h2>Use Wedding Calculators as a Pressure Test</h2>

      <p>
        These tools are educational estimates, not personalized financial advice.
        Use them to spot risk, compare tradeoffs, and have clearer conversations
        before booking vendors or taking on wedding-related debt.
      </p>
    </section>

    <FAQSection title="Wedding Budget FAQ" faqs={weddingFaqs} />
  </main>
</Layout>