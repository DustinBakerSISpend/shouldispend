---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const funeralFaqs = [
  {
    question: "Is $20,000 too much to spend on a funeral?",
    answer:
      "$20,000 is a major funeral expense. It may be manageable with strong life insurance, prepaid arrangements, estate funds, large savings, or shared family support. It becomes risky when it requires credit cards, loans, funeral financing, or emergency savings needed by the surviving household.",
  },
  {
    question: "What kind of funeral can cost $20,000?",
    answer:
      "A $20,000 funeral may include a full traditional burial, premium casket, viewing, embalming, funeral home services, cemetery plot, burial vault, headstone, flowers, obituary, transportation, reception, travel, and family logistics.",
  },
  {
    question: "Should I borrow money for a $20,000 funeral?",
    answer:
      "Borrowing for a $20,000 funeral should be treated very carefully. Before using credit cards, personal loans, or payment plans, compare lower-cost packages, cremation options, family contributions, insurance timing, itemized pricing, and whether optional costs can be delayed.",
  },
  {
    question: "How can I lower a $20,000 funeral cost?",
    answer:
      "Ask for an itemized price list, compare funeral homes, consider direct cremation, simplify the casket or service package, reduce reception costs, delay a celebration of life, separate required costs from optional upgrades, and ask relatives to cover specific costs directly.",
  },
  {
    question: "When does a $20,000 funeral make sense?",
    answer:
      "A $20,000 funeral can make sense when it reflects clear wishes, religious needs, prepaid plans, cemetery ownership, strong insurance, or family agreement  -  and when the cost does not damage the people left behind.",
  },
];

const costCategories = [
  {
    title: "Full-service funeral home package",
    body:
      "Planning, staff, facilities, viewing, ceremony coordination, transportation, paperwork, permits, and professional services can form a large base cost.",
  },
  {
    title: "Premium burial products",
    body:
      "A higher-cost casket, vault, liner, marker, headstone, engraving, and memorial products can push the total far beyond a basic funeral plan.",
  },
  {
    title: "Cemetery and graveside costs",
    body:
      "Cemetery plot, opening and closing, perpetual care, marker placement, administration, and graveside setup may be billed separately from the funeral home.",
  },
  {
    title: "Viewing and preparation",
    body:
      "Embalming, body preparation, dressing, cosmetics, refrigeration, private viewing, public visitation, and facility time can raise the total.",
  },
  {
    title: "Ceremony and memorial extras",
    body:
      "Flowers, printed programs, obituary placement, livestreaming, clergy, musicians, video tributes, keepsakes, photos, and receptions can add thousands.",
  },
  {
    title: "Family travel and timing",
    body:
      "Travel, lodging, meals, missed work, transportation, delayed insurance, and estate timing can create pressure beyond the funeral invoice.",
  },
];

const reduceCostTips = [
  "Ask for itemized funeral home and cemetery pricing before choosing a package.",
  "Compare the $20,000 plan against $15,000, $10,000, and $5,000 versions.",
  "Separate required burial costs from optional upgrades.",
  "Compare traditional burial with simple burial, direct cremation, cremation with memorial, and memorial-only options.",
  "Choose a simpler casket, vault, headstone, flowers, programs, reception, or keepsakes if those upgrades are not central to the goodbye.",
  "Ask relatives to contribute to specific costs instead of relying on vague reimbursement promises.",
  "Delay headstone upgrades, a large reception, keepsakes, or a celebration of life until cash is available.",
  "Avoid financing optional upgrades if the required funeral costs already stretch the household.",
];

const redFlags = [
  "The funeral requires credit cards, a personal loan, or a high-interest payment plan.",
  "The person signing the contract is relying on family reimbursement that is not confirmed.",
  "Insurance or estate money is expected but the timing is unclear.",
  "The quote is not itemized enough to separate required costs from optional upgrades.",
  "The funeral would drain emergency savings below the household's minimum safe level.",
  "A surviving spouse, child, or dependent household would be financially weakened by the cost.",
  "The family is choosing premium products mainly because a simpler funeral feels embarrassing.",
  "No one has compared cremation, direct cremation, simple burial, or a smaller memorial.",
  "Existing debt payments are already high before adding funeral financing.",
  "The plan includes expensive extras that do not clearly reflect the person's wishes.",
];

const assumptions = [
  "Monthly income means take-home pay available to the person or household paying the funeral bill.",
  "Insurance or family help means confirmed or highly realistic money available for this funeral.",
  "Liquid savings means cash that can be used without missing essential bills, selling long-term assets, or triggering penalties.",
  "The emergency target is the minimum savings cushion the household wants left after the funeral is paid.",
  "The calculator estimates financial pressure, not the emotional value of the service.",
  "A higher-cost funeral can be reasonable when it is funded safely and chosen intentionally.",
  "A score of 0 is allowed when the funeral is fully covered or the uncovered cost is tiny compared with income and savings.",
];

const relatedCalculators = [
  {
    title: "Funeral Calculators",
    href: "/funeral-calculators",
    body: "Compare funeral, cremation, burial, insurance, savings, and payment-plan decisions.",
  },
  {
    title: "Can I Afford a Funeral?",
    href: "/can-i-afford-a-funeral",
    body: "Test a full funeral quote against income, savings, debt, essential bills, and emergency reserves.",
  },
  {
    title: "$15,000 Funeral Calculator",
    href: "/should-i-spend-15000-on-a-funeral",
    body: "Compare this $20,000 plan with a slightly lower full-service funeral budget.",
  },
  {
    title: "$10,000 Funeral Calculator",
    href: "/should-i-spend-10000-on-a-funeral",
    body: "See whether a more moderate funeral budget reduces savings and debt pressure.",
  },
  {
    title: "$5,000 Funeral Calculator",
    href: "/should-i-spend-5000-on-a-funeral",
    body: "Compare the high-cost plan with a simpler cremation or memorial budget.",
  },
  {
    title: "Funeral vs. Cremation Cost Calculator",
    href: "/funeral-vs-cremation-cost-calculator",
    body: "Compare burial, cremation, direct cremation, and memorial options side by side.",
  },
  {
    title: "Funeral Payment Plan Calculator",
    href: "/funeral-payment-plan-calculator",
    body: "Estimate monthly payment pressure before financing funeral expenses.",
  },
  {
    title: "Use Savings for Funeral Costs?",
    href: "/should-i-use-savings-for-funeral-costs",
    body: "Decide whether using cash is safer than borrowing or waiting for reimbursement.",
  },
];
---

<Layout
  title="Should I Spend $20,000 on a Funeral?"
  description="Use this $20,000 funeral affordability calculator to decide whether a high-cost funeral fits savings, insurance, family help, debt, income, and emergency reserves."
>
  <style>
    .container { max-width: 1060px; margin: 0 auto; padding: 80px 24px; }
    .eyebrow { color:#0f766e; text-transform:uppercase; letter-spacing:2px; font-size:.8rem; font-weight:900; margin-bottom:18px; }
    h1 { font-size:clamp(2.65rem,7vw,4.8rem); line-height:.95; margin:0 0 24px; color:#0f172a; max-width:930px; }
    h2 { font-size:clamp(1.8rem,4vw,2.45rem); line-height:1.12; margin:0 0 18px; color:#0f172a; }
    h3 { color:#0f172a; line-height:1.25; margin:0 0 10px; }
    p, li { color:#334155; line-height:1.85; font-size:1.06rem; }
    a { color:#0f766e; font-weight:800; }
    .intro { max-width:860px; font-size:1.14rem; margin-bottom:32px; }
    .hero-grid, .info-grid, .link-grid, .mini-grid { display:grid; gap:20px; }
    .hero-grid { grid-template-columns:minmax(0,1.4fr) minmax(280px,.7fr); margin:34px 0 56px; }
    .info-grid, .link-grid, .mini-grid { grid-template-columns:repeat(auto-fit,minmax(245px,1fr)); margin-top:28px; }
    .summary-card, .calculator-box, .info-card, .link-card, .callout, .mini-card, .table-wrap {
      border:1px solid #dbe4ee; background:#fff; border-radius:24px; box-shadow:0 12px 28px rgba(15,23,42,.04);
    }
    .summary-card, .info-card, .mini-card, .link-card, .callout { padding:24px; }
    .summary-card { background:linear-gradient(180deg,#f8fafc 0%,#fff 100%); }
    .summary-card strong { display:block; color:#0f172a; font-size:1.1rem; margin-bottom:10px; }
    .summary-list { margin:0; padding-left:20px; }
    .summary-list li { margin-bottom:10px; font-size:.98rem; }
    .calculator-box { padding:30px; margin-bottom:64px; }
    .form-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:18px; margin-top:24px; }
    label { display:block; font-weight:900; color:#0f172a; margin-bottom:8px; font-size:.95rem; }
    .hint { display:block; color:#64748b; font-size:.83rem; line-height:1.45; margin-top:5px; }
    input { width:100%; border:1px solid #cbd5e1; border-radius:13px; padding:13px; font-size:1rem; box-sizing:border-box; color:#0f172a; background:#fff; }
    button { margin-top:24px; border:none; border-radius:999px; padding:15px 24px; background:#0f766e; color:#fff; font-weight:900; font-size:1rem; cursor:pointer; }
    button:hover { opacity:.92; }
    .result { margin-top:32px; background:#f8fafc; border:1px solid #dbe4ee; border-radius:24px; padding:30px; display:none; }
    .result.visible { display:block; }
    .score { font-size:clamp(2rem,4vw,2.75rem); font-weight:950; color:#0f172a; margin-bottom:20px; line-height:1.12; }
    .bar { height:16px; background:#dbe4ee; border-radius:999px; overflow:hidden; margin-bottom:24px; }
    .fill { height:100%; width:0%; border-radius:999px; transition:width .45s ease; }
    .fill.safe { background:linear-gradient(90deg,#0f766e 0%,#14b8a6 100%); }
    .fill.caution { background:linear-gradient(90deg,#ca8a04 0%,#facc15 100%); }
    .fill.danger { background:linear-gradient(90deg,#dc2626 0%,#f97316 100%); }
    .result-details { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:14px; margin-top:20px; }
    .result-metric { background:#fff; border:1px solid #e2e8f0; border-radius:18px; padding:16px; }
    .result-metric strong { display:block; color:#0f172a; margin-bottom:6px; }
    .result-metric span { color:#334155; line-height:1.55; font-size:.96rem; }
    .guidance { margin-top:22px; padding-top:20px; border-top:1px solid #dbe4ee; color:#0f172a; font-size:1.08rem; line-height:1.8; }
    .fine-print { color:#64748b; font-size:.9rem; margin-top:18px; line-height:1.6; }
    .content-section { margin-top:76px; }
    .content-section > p { max-width:900px; }
    .numbered-card { position:relative; padding-top:48px; }
    .numbered-card .number { position:absolute; top:20px; left:22px; width:28px; height:28px; border-radius:999px; background:#ccfbf1; color:#115e59; font-weight:950; display:grid; place-items:center; font-size:.86rem; }
    .callout { background:#f8fafc; margin-top:28px; }
    .callout p { margin:0; color:#0f172a; font-size:1.08rem; }
    .warning-box { border-left:5px solid #dc2626; }
    .decision-box { border-left:5px solid #0f766e; }
    .table-wrap { overflow-x:auto; margin-top:26px; padding:0; }
    table { width:100%; border-collapse:collapse; min-width:720px; }
    th, td { text-align:left; padding:16px; border-bottom:1px solid #e2e8f0; vertical-align:top; color:#334155; line-height:1.55; }
    th { color:#0f172a; background:#f8fafc; font-size:.92rem; text-transform:uppercase; letter-spacing:.04em; }
    tr:last-child td { border-bottom:none; }
    .link-card { display:block; text-decoration:none; color:inherit; transition:transform .15s ease, box-shadow .15s ease; }
    .link-card:hover { transform:translateY(-2px); box-shadow:0 16px 34px rgba(15,23,42,.08); }
    .link-card strong { display:block; color:#0f172a; margin-bottom:8px; line-height:1.3; font-size:1.03rem; }
    .link-card span, .info-card p, .mini-card p { display:block; margin:0; color:#334155; line-height:1.7; font-size:.96rem; }
    .check-list, .red-list { list-style:none; padding-left:0; }
    .check-list li, .red-list li { position:relative; padding-left:30px; margin-bottom:10px; }
    .check-list li::before { content:"+"; position:absolute; left:0; top:0; color:#0f766e; font-weight:950; }
    .red-list li::before { content:"!"; position:absolute; left:0; top:2px; width:18px; height:18px; border-radius:999px; display:grid; place-items:center; background:#fee2e2; color:#b91c1c; font-weight:950; font-size:.8rem; }
    @media (max-width:760px) {
      .container { padding:54px 18px; }
      .hero-grid { grid-template-columns:1fr; }
      .calculator-box { padding:22px; }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Funeral Cost Calculator</div>

    <h1>Should I Spend $20,000 on a Funeral?</h1>

    <p class="intro">
      A $20,000 funeral is no longer a routine expense. It is a major family
      financial decision that may include a traditional burial, cemetery costs,
      premium products, funeral home services, flowers, obituary, reception, and
      family travel. This calculator estimates whether that plan is safely funded
      or whether it creates risky pressure on savings, debt, income, and
      emergency reserves.
    </p>

    <div class="hero-grid">
      <div class="summary-card">
        <strong>Fast answer</strong>
        <p>
          A $20,000 funeral can be reasonable only when the funding is real:
          insurance, prepaid arrangements, estate cash, strong savings, or clear
          family contributions. It is dangerous when one person absorbs debt to
          satisfy a high-cost plan.
        </p>
      </div>

      <div class="summary-card">
        <strong>This page helps you check:</strong>
        <ul class="summary-list">
          <li>whether the out-of-pocket cost is actually affordable</li>
          <li>whether emergency savings remain protected</li>
          <li>whether family help is clear or assumed</li>
          <li>whether a lower-cost version should be compared first</li>
        </ul>
      </div>
    </div>

    <section class="calculator-box">
      <h2>$20,000 Funeral Pressure Calculator</h2>

      <p>
        Enter the numbers for the person or household actually paying. Use
        monthly take-home income, not gross income. Only include insurance,
        prepaid funds, estate money, or family help that is confirmed or highly
        realistic.
      </p>

      <div class="form-grid">
        <div>
          <label for="cost">Estimated funeral cost</label>
          <input id="cost" type="number" value="20000" min="0" inputmode="decimal" />
          <span class="hint">Use the full expected bill, including burial, cemetery, service, reception, and extras.</span>
        </div>

        <div>
          <label for="savings">Current liquid savings</label>
          <input id="savings" type="number" placeholder="Example: 40000" min="0" inputmode="decimal" />
          <span class="hint">Cash available without missing bills or selling long-term assets.</span>
        </div>

        <div>
          <label for="help">Insurance or family help</label>
          <input id="help" type="number" placeholder="Example: 8000" min="0" inputmode="decimal" />
          <span class="hint">Confirmed insurance, prepaid funds, employer benefits, estate cash, or contributions.</span>
        </div>

        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 8500" min="0" inputmode="decimal" />
          <span class="hint">After-tax income for the person or household paying.</span>
        </div>

        <div>
          <label for="debt">Monthly debt payments</label>
          <input id="debt" type="number" placeholder="Example: 1200" min="0" inputmode="decimal" />
          <span class="hint">Credit cards, loans, car payments, student loans, medical plans, and other debt.</span>
        </div>

        <div>
          <label for="emergencyTarget">Minimum savings you want left afterward</label>
          <input id="emergencyTarget" type="number" placeholder="Example: 20000" min="0" inputmode="decimal" />
          <span class="hint">The cash floor you do not want the funeral to break.</span>
        </div>
      </div>

      <button class="sis-action-button sis-calculate-button" id="calculateButton" type="button">Check Funeral Affordability</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>
        <div class="bar"><div class="fill" id="scoreFill"></div></div>
        <div class="result-details" id="resultDetails"></div>
        <div class="guidance" id="guidance"></div>
        <div class="fine-print">This calculator is educational only and is not financial, legal, tax, estate, insurance, or funeral-planning advice.</div>
      </div>
    </section>

    <section class="content-section">
      <h2>A $20,000 funeral should be treated like a major household decision</h2>

      <p>
        A higher-cost funeral can be meaningful and appropriate in some
        situations. It may reflect religious expectations, a traditional burial,
        cemetery ownership, family travel, a prepaid plan, or a clear wish for a
        full service.
      </p>

      <p>
        The financial danger begins when the family chooses the most expensive
        version of every option before confirming how the bill will be paid. A
        funeral home invoice, cemetery bill, reception, travel, and headstone can
        arrive before insurance or estate money is actually available.
      </p>

      <div class="callout decision-box">
        <p>
          At $20,000, the plan needs a funding plan as much as it needs a service
          plan.
        </p>
      </div>
    </section>

    <section class="content-section" id="MethodologySection">
      <h2>How this $20,000 funeral affordability calculator works</h2>

      <p>
        The calculator estimates a pressure score from 0 to 100. It starts with
        the out-of-pocket cost after insurance, prepaid funds, estate cash, or
        family help. Then it checks savings impact, emergency savings remaining,
        monthly take-home income, and existing debt pressure.
      </p>

      <div class="mini-grid">
        <div class="mini-card numbered-card">
          <div class="number">1</div>
          <h3>Out-of-pocket cost</h3>
          <p>A $20,000 funeral with $18,000 of confirmed help is very different from one paid entirely by one household.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">2</div>
          <h3>Emergency savings impact</h3>
          <p>The score rises when the funeral drains cash needed for housing, food, transportation, medical needs, or job loss.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">3</div>
          <h3>Income flexibility</h3>
          <p>The uncovered cost is compared with monthly take-home income because gross income is not spendable cash.</p>
        </div>

        <div class="mini-card numbered-card">
          <div class="number">4</div>
          <h3>Debt pressure</h3>
          <p>Existing debt raises risk because funeral financing may become one more required monthly payment.</p>
        </div>
      </div>

      <p>
        There is no artificial minimum pressure. If the funeral is fully covered,
        the score can be 0. If the uncovered cost is tiny compared with income
        and savings, the score can also be 0.
      </p>
    </section>

    <section class="content-section">
      <h2>When spending $20,000 on a funeral can make sense</h2>

      <ul class="check-list">
        <li>Life insurance, prepaid arrangements, estate cash, or family help cover most of the bill.</li>
        <li>The service reflects clear wishes, religious expectations, cemetery ownership, or a deliberate family choice.</li>
        <li>Emergency savings remain above the household's minimum comfort level.</li>
        <li>No high-interest debt is needed.</li>
        <li>Funeral home, cemetery, reception, travel, and marker costs are itemized separately.</li>
        <li>The person signing the contract is not relying on vague reimbursement promises.</li>
        <li>The surviving household remains stable after the funeral is paid.</li>
      </ul>
    </section>

    <section class="content-section" id="KeyCostCategories">
      <h2>Key cost categories in a $20,000 funeral</h2>

      <p>
        A $20,000 funeral usually means several expensive categories are stacking
        together. Some may be meaningful. Some may be required. Others may be
        optional upgrades that should be questioned before anyone borrows money.
      </p>

      <div class="info-grid">
        {costCategories.map((category) => (
          <div class="info-card">
            <h3>{category.title}</h3>
            <p>{category.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>What can push a funeral toward $20,000?</h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Cost driver</th>
              <th>Why it raises the total</th>
              <th>Question to ask</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Premium traditional burial</td>
              <td>Casket, cemetery plot, vault, marker, opening and closing, graveside setup, and facility costs stack together.</td>
              <td>Which burial costs are required, and which can be simplified or delayed?</td>
            </tr>
            <tr>
              <td>Public viewing and full service</td>
              <td>Viewing may add embalming, preparation, staff, facility, transportation, flowers, and printed materials.</td>
              <td>Would a private viewing, smaller service, or memorial meet the family's needs?</td>
            </tr>
            <tr>
              <td>Upgraded products and extras</td>
              <td>Casket, vault, flowers, programs, keepsakes, video tributes, livestreaming, and marker upgrades can add thousands.</td>
              <td>Is this upgrade meaningful, required, or mainly emotional pressure?</td>
            </tr>
            <tr>
              <td>Reception, travel, and logistics</td>
              <td>Food, venue, lodging, flights, gas, missed work, and family travel may not appear in the funeral quote.</td>
              <td>Can family members contribute directly to gathering or travel costs?</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section" id="ReduceCostTips">
      <h2>Ways to lower a $20,000 funeral without making it feel cheap</h2>

      <p>
        A $20,000 plan may be appropriate, but it should be compared against a
        simpler version before anyone signs financing paperwork. The goal is to
        keep the meaningful parts and remove spending that is mostly pressure.
      </p>

      <ul class="check-list">
        {reduceCostTips.map((tip) => <li>{tip}</li>)}
      </ul>
    </section>

    <section class="content-section" id="FinancialRedFlags">
      <h2>Financial red flags before agreeing to a $20,000 funeral</h2>

      <p>
        A larger funeral budget deserves more scrutiny, not less. These warning
        signs mean the family should pause, compare alternatives, or reduce the
        plan.
      </p>

      <ul class="red-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>

      <div class="callout warning-box">
        <p>
          Be careful when a high funeral cost is justified by money that has not
          arrived yet. Expected insurance and actual cash on hand are not the
          same thing.
        </p>
      </div>
    </section>

    <section class="content-section">
      <h2>Compare $20,000 against lower-cost funeral options</h2>

      <p>
        A $20,000 funeral may be right for the family, but it should survive a
        comparison against a $15,000 funeral, $10,000 funeral, direct cremation,
        cremation with memorial, simple burial, a family-hosted reception, or a
        delayed celebration of life.
      </p>

      <p>
        Spending less does not mean caring less. It may mean protecting a
        surviving spouse, children, siblings, or household from debt that lasts
        much longer than the service.
      </p>
    </section>

    <section class="content-section" id="CalculatorAssumptions">
      <h2>Calculator assumptions</h2>

      <ul>
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="content-section">
      <h2>Decision guide: what to do with your result</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Low pressure</h3>
          <p>The funeral appears affordable. Still confirm itemized pricing, cemetery costs, reimbursement timing, and who is paying each piece.</p>
        </div>

        <div class="info-card">
          <h3>Moderate pressure</h3>
          <p>Compare a $15,000 or $10,000 version, clarify family help, and reduce optional upgrades before borrowing.</p>
        </div>

        <div class="info-card">
          <h3>High pressure</h3>
          <p>Reduce the plan, avoid high-interest debt, seek confirmed help, and protect the surviving household.</p>
        </div>
      </div>
    </section>

    <section class="content-section" id="RelatedCalculators">
      <h2>Related funeral and emergency expense calculators</h2>

      <div class="link-grid">
        {relatedCalculators.map((calculator) => (
          <a class="link-card" href={calculator.href}>
            <strong>{calculator.title}</strong>
            <span>{calculator.body}</span>
          </a>
        ))}
      </div>
    </section>

    <FAQSection title="$20,000 Funeral FAQ" faqs={funeralFaqs} />
  </main>

  <script>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const formatCurrency = (value) => {
      const safeValue = Number.isFinite(value) ? value : 0;
      return safeValue.toLocaleString(undefined, {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
    };

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action:
            "Proceed only after confirming itemized pricing, cemetery costs, reimbursement timing, and who is paying each piece.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action:
            "Compare lower-cost versions and protect emergency savings before borrowing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action:
          "Reduce the funeral cost, seek confirmed help, choose a simpler service, or avoid high-interest debt.",
      };
    }

    const button = document.getElementById("calculateButton");
    const result = document.getElementById("result");
    const scoreText = document.getElementById("scoreText");
    const scoreFill = document.getElementById("scoreFill");
    const resultDetails = document.getElementById("resultDetails");
    const guidance = document.getElementById("guidance");

    button?.addEventListener("click", () => {
      const cost = getNumber("cost");
      const savings = getNumber("savings");
      const help = getNumber("help");
      const income = getNumber("income");
      const debt = getNumber("debt");
      const emergencyTarget = getNumber("emergencyTarget");

      result?.classList.add("visible");

      if (cost <= 0) {
        scoreText.textContent = "Add a funeral cost first";
        scoreFill.style.width = "0%";
        scoreFill.className = "fill safe";
        resultDetails.innerHTML = `
          <div class="result-metric">
            <strong>Missing cost</strong>
            <span>Enter a funeral cost so the calculator can estimate pressure.</span>
          </div>
        `;
        guidance.textContent = "";
        return;
      }

      const outOfPocket = Math.max(cost - help, 0);
      const savingsAfter = savings - outOfPocket;
      const savingsImpact = savings > 0 ? (outOfPocket / savings) * 100 : outOfPocket > 0 ? 150 : 0;
      const monthlyIncomeImpact = income > 0 ? (outOfPocket / income) * 100 : outOfPocket > 0 ? 300 : 0;
      const debtPaymentRatio = income > 0 ? (debt / income) * 100 : debt > 0 ? 100 : 0;
      const emergencyTargetRemaining =
        emergencyTarget > 0 ? (savingsAfter / emergencyTarget) * 100 : null;

      const fullyCovered = outOfPocket <= 0;

      const tinyUncoveredCost =
        outOfPocket > 0 &&
        outOfPocket <= Math.max(100, income * 0.02) &&
        savingsAfter >= 0 &&
        debtPaymentRatio <= 10;

      const hugeSavings =
        outOfPocket > 0 &&
        savingsAfter >= Math.max(emergencyTarget, income * 6, outOfPocket * 20);

      const hugeIncome =
        outOfPocket > 0 &&
        income > 0 &&
        monthlyIncomeImpact <= 2 &&
        debtPaymentRatio <= 5 &&
        savingsAfter >= 0;

      let pressureScore = 0;

      if (fullyCovered || tinyUncoveredCost || hugeSavings || hugeIncome) {
        pressureScore = 0;
      } else {
        pressureScore += clamp(savingsImpact * 0.42, 0, 38);
        pressureScore += clamp(monthlyIncomeImpact * 0.3, 0, 30);
        pressureScore += clamp(debtPaymentRatio * 0.34, 0, 20);

        if (outOfPocket > savings) pressureScore += 24;

        if (savingsAfter < 0) {
          pressureScore += 24;
        } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget * 0.5) {
          pressureScore += 16;
        } else if (emergencyTarget > 0 && savingsAfter < emergencyTarget) {
          pressureScore += 9;
        } else if (emergencyTarget > 0 && savingsAfter >= emergencyTarget * 2.5) {
          pressureScore -= 12;
        } else if (income > 0 && savingsAfter >= income * 6) {
          pressureScore -= 10;
        }

        if (monthlyIncomeImpact > 300) pressureScore += 18;
        else if (monthlyIncomeImpact > 200) pressureScore += 12;
        else if (monthlyIncomeImpact > 100) pressureScore += 6;

        if (debtPaymentRatio >= 45) pressureScore += 14;
        else if (debtPaymentRatio >= 30) pressureScore += 9;
        else if (debtPaymentRatio >= 20) pressureScore += 4;

        if (
          outOfPocket > 0 &&
          savingsImpact <= 0.5 &&
          monthlyIncomeImpact <= 5 &&
          savingsAfter >= Math.max(emergencyTarget, 0)
        ) {
          pressureScore = Math.min(pressureScore, 3);
        } else if (
          outOfPocket > 0 &&
          savingsImpact <= 1 &&
          monthlyIncomeImpact <= 10 &&
          savingsAfter >= Math.max(emergencyTarget, income * 3)
        ) {
          pressureScore = Math.min(pressureScore, 8);
        } else if (
          outOfPocket > 0 &&
          savingsImpact <= 3 &&
          monthlyIncomeImpact <= 20 &&
          savingsAfter >= Math.max(emergencyTarget, 0)
        ) {
          pressureScore = Math.min(pressureScore, 15);
        }
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);
      const level = getPressureLevel(pressureScore);

      scoreText.textContent = `${level.label}  -  ${pressureScore}/100`;
      scoreFill.style.width = `${pressureScore}%`;
      scoreFill.className = `fill ${level.colorClass}`;

      resultDetails.innerHTML = `
        <div class="result-metric"><strong>Pressure level</strong><span>${level.stress}</span></div>
        <div class="result-metric"><strong>Out-of-pocket cost</strong><span>${formatCurrency(outOfPocket)} after insurance, prepaid funds, estate cash, or family help.</span></div>
        <div class="result-metric"><strong>Savings after funeral</strong><span>${formatCurrency(savingsAfter)}</span></div>
        <div class="result-metric"><strong>Savings impact</strong><span>${savings > 0 ? `${savingsImpact.toFixed(1)}% of available liquid savings.` : "No liquid savings entered."}</span></div>
        <div class="result-metric"><strong>Monthly income impact</strong><span>${income > 0 ? `${monthlyIncomeImpact.toFixed(1)}% of one month's take-home income.` : "No monthly take-home income entered."}</span></div>
        <div class="result-metric"><strong>Debt payment pressure</strong><span>${income > 0 ? `${debtPaymentRatio.toFixed(1)}% of monthly take-home income already goes to debt.` : "Enter income to estimate debt pressure."}</span></div>
        ${
          emergencyTargetRemaining !== null
            ? `<div class="result-metric"><strong>Emergency savings target</strong><span>${emergencyTargetRemaining.toFixed(1)}% of your target would remain after the funeral.</span></div>`
            : ""
        }
      `;

      if (pressureScore === 0) {
        guidance.textContent =
          `This funeral creates essentially no measurable financial pressure based on the numbers provided. Recommended next step: ${level.action}`;
      } else if (pressureScore <= 30) {
        guidance.textContent =
          `This funeral appears manageable based on the numbers provided. Recommended next step: ${level.action}`;
      } else if (pressureScore <= 60) {
        guidance.textContent =
          `This funeral may be workable, but it deserves caution. Recommended next step: ${level.action}`;
      } else {
        guidance.textContent =
          `This funeral could create real financial strain. Recommended next step: ${level.action}`;
      }
    });
  </script>
</Layout>
