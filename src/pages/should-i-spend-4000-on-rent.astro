---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";

const pageUrl = "https://shouldispend.com/should-i-spend-4000-on-rent";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is $4,000 a month too much for rent?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "$4,000 rent is a major monthly commitment. It may be reasonable for high-income households with low debt and strong savings, but it can create serious pressure if take-home pay, emergency savings, or monthly flexibility are limited.",
      },
    },
    {
      "@type": "Question",
      name: "How much income do I need for $4,000 rent?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Using the 30% gross-income rule, $4,000 rent points to roughly $160,000 in annual income. Take-home pay, debt, utilities, savings, and other obligations still matter.",
      },
    },
    {
      "@type": "Question",
      name: "Should utilities be included with $4,000 rent?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Utilities, parking, renter's insurance, pet fees, storage, internet, and commuting costs should be included because they can push the true housing cost far above $4,000.",
      },
    },
    {
      "@type": "Question",
      name: "Can $4,000 rent ever be safe?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, but usually only when income is high, debt is low, savings are strong, and the location meaningfully supports work, safety, family needs, or transportation savings.",
      },
    },
    {
      "@type": "Question",
      name: "What makes $4,000 rent risky?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "$4,000 rent becomes risky when it consumes too much take-home pay, blocks savings, requires credit card use, depends on uncertain income, or drains emergency savings through deposits and move-in costs.",
      },
    },
  ],
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Should I Spend $4,000 on Rent Calculator",
  url: pageUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "All",
  description:
    "A $4,000 rent affordability calculator that estimates housing pressure using income, take-home pay, utilities, debt, bills, savings, and move-in costs.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://shouldispend.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Rent Calculators",
      item: "https://shouldispend.com/rent-calculators",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Should I Spend $4,000 on Rent?",
      item: pageUrl,
    },
  ],
};
---

<Layout
  title="Should I Spend $4,000 on Rent? Calculator | ShouldISpend"
  description="Use this $4,000 rent calculator to decide whether the payment fits your income, take-home pay, debt, utilities, savings, bills, and monthly flexibility."

  noindex={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
      box-sizing: border-box;
    }

    button {
      background: #0f766e;
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
      display: none;
      background: #f8fafc;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
      line-height: 1.05;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }

    .content-section p,
    .content-section li {
      line-height: 1.8;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="$4,000 Rent Calculator"
      title="Should I Spend $4,000 on Rent?"
      description="Estimate whether a $4,000 monthly rent payment is sustainable, stretched, or dangerous after utilities, debt payments, other bills, savings, move-in costs, and real monthly breathing room."
    >
      <div class="card">
        <h2>$4,000 Rent Pressure Verdict</h2>

        <div class="grid">
          <div>
            <label for="grossIncome">Annual Household Income</label>
            <input id="grossIncome" type="number" placeholder="180000" />
          </div>

          <div>
            <label for="takeHomePay">Monthly Take-Home Pay</label>
            <input id="takeHomePay" type="number" placeholder="11000" />
          </div>

          <div>
            <label for="rent">Monthly Rent</label>
            <input id="rent" type="number" value="4000" />
          </div>

          <div>
            <label for="utilities">Utilities, Internet, Parking, Fees</label>
            <input id="utilities" type="number" placeholder="650" />
          </div>

          <div>
            <label for="monthlyDebt">Monthly Debt Payments</label>
            <input id="monthlyDebt" type="number" placeholder="900" />

            <div class="helper-link">
              <a href="/what-counts-as-debt/">
                Not sure what counts as debt? Read the debt guide
              </a>
            </div>
          </div>

          <div>
            <label for="otherBills">Other Monthly Bills</label>
            <input id="otherBills" type="number" placeholder="2600" />
          </div>

          <div>
            <label for="savings">Total Emergency Savings</label>
            <input id="savings" type="number" placeholder="40000" />
          </div>

          <div>
            <label for="movingCost">Estimated Move-In Cost</label>
            <input id="movingCost" type="number" placeholder="10000" />
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="rentButton" type="button">
          Get $4,000 Rent Verdict
        </button>

        <div class="result" id="result">
          <div class="score" id="score"></div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="housingRatio"></div>
          <div class="metric" id="takeHomeRatio"></div>
          <div class="metric" id="leftoverCash"></div>
          <div class="metric" id="recommendedRent"></div>
          <div class="metric" id="savingsCushion"></div>
          <div class="metric" id="moveInImpact"></div>
          <div class="metric" id="debtPressure"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <h2>Is $4,000 Rent Actually Affordable?</h2>

        <p>
          A $4,000 rent payment is not a casual housing decision. It can be
          perfectly manageable for a high-income household with strong savings,
          low debt, and a stable job situation, but it can also become one of the
          fastest ways to turn a good income into a tight monthly budget.
        </p>

        <p>
          The key question is not whether $4,000 sounds high. The real question
          is what happens after rent, utilities, parking, insurance, debt
          payments, groceries, transportation, childcare, medical costs, and
          savings are all counted.
        </p>

        <p>
          At this level, the apartment should either fit easily or deliver a
          meaningful life advantage: a shorter commute, safer location, better
          schools, better work access, less transportation cost, or a housing
          setup that solves a real family or career problem.
        </p>
      </div>

      <div class="content-section">
        <h2>Why $4,000 Rent Needs a Bigger Safety Check</h2>

        <p>
          High rent magnifies small mistakes. A $300 utility surprise, parking
          fee, pet charge, rent increase, or insurance cost may not sound huge by
          itself, but the total housing number can climb fast when the base rent
          already starts at $4,000.
        </p>

        <p>
          Move-in costs also matter more. Deposits, first month's rent, movers,
          furniture, building fees, storage, and setup costs can easily create a
          five-figure cash hit before the lease even begins.
        </p>
      </div>

      <WhenSpendingMakesSense
        title="When $4,000 Rent Makes Sense"
        items={[
          "Your income is high enough that the full housing cost still leaves strong monthly breathing room.",
          "You have enough emergency savings after deposits, movers, fees, and setup costs.",
          "Debt payments are low and do not compete with rent for monthly cash flow.",
          "The location meaningfully improves commute time, job access, safety, schools, family logistics, or quality of life.",
          "The apartment replaces or reduces another major cost, such as commuting, parking, a second car, or childcare logistics.",
        ]}
      />

      <div class="content-section">
        <h2>When $4,000 Rent Is a Warning Sign</h2>

        <p>
          $4,000 rent becomes dangerous when it only works in a perfect month.
          If the payment depends on bonuses, overtime, side income, a future
          raise, or credit cards covering normal expenses, the lease may be too
          aggressive.
        </p>

        <p>
          The risk is especially high if move-in costs would drain savings. A
          premium apartment can feel manageable on payday and stressful after the
          first medical bill, car repair, job disruption, or family emergency.
        </p>
      </div>

      <KeyCostCategories
        items={[
          {
            title: "Full housing cost",
            description:
              "$4,000 rent can become much more expensive after utilities, internet, parking, pet fees, renter's insurance, storage, trash, and building fees are included.",
          },
          {
            title: "Large move-in costs",
            description:
              "Deposits, first month's rent, movers, furniture, elevator fees, application fees, and utility setup can create a major upfront savings hit.",
          },
          {
            title: "Debt and lifestyle commitments",
            description:
              "Car payments, student loans, credit cards, childcare, insurance, subscriptions, medical bills, and other fixed costs determine whether high rent is comfortable or tight.",
          },
          {
            title: "Location value",
            description:
              "High rent is easier to justify when it materially improves work access, commute time, school access, safety, family logistics, or transportation costs.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Ask for the full monthly cost before applying, including parking, utilities, internet, pet rent, storage, and building fees.",
          "Compare the apartment against cheaper units that still solve the same commute, safety, school, or work-access problem.",
          "Avoid spending most of your emergency fund on deposits, furniture, and move-in costs.",
          "Check whether the lease includes future rent increases, amenity fees, parking changes, or required insurance.",
          "Look for concessions, included utilities, lower parking costs, or a slightly smaller unit before committing.",
          "Test the payment against one bad month: car repair, medical bill, missed bonus, or temporary income drop.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "$4,000 rent plus utilities would consume more than half of take-home pay.",
          "The lease depends on bonuses, overtime, side income, or a raise that has not happened yet.",
          "Move-in costs would drain most of your emergency savings.",
          "You would need credit cards for groceries, transportation, medical costs, or normal bills after paying rent.",
          "Debt payments already make your monthly budget feel tight.",
          "The apartment is mainly a lifestyle upgrade without enough monthly breathing room to support it.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "The calculator treats $4,000 rent as a recurring monthly commitment.",
          "Monthly housing cost includes rent plus estimated utilities, internet, parking, renter's insurance, and other required housing fees.",
          "Take-home pay is used to estimate real monthly breathing room.",
          "Move-in costs are treated as an immediate savings hit because high-rent leases often require large deposits, movers, fees, and setup costs.",
          "The calculator is designed for general education and does not replace personalized financial advice.",
        ]}
      />

      <div class="content-section">
        <h2>How Much Income Makes $4,000 Rent Comfortable?</h2>

        <p>
          Using the 30% gross-income rule, $4,000 rent points to about $13,333
          in gross monthly income, or roughly $160,000 per year. That is only a
          starting point.
        </p>

        <p>
          A household earning more than that can still feel pressure if debt,
          childcare, car payments, insurance, taxes, or lifestyle costs are high.
          A very high-income household with low debt and strong savings may see
          $4,000 rent as a manageable tradeoff, especially in an expensive market.
        </p>
      </div>

      <div class="content-section">
        <h2>The Emergency Fund Matters More at Higher Rent Levels</h2>

        <p>
          Higher rent raises the cost of instability. If income drops, a job
          changes, or a surprise expense hits, the monthly payment remains. That
          is why a strong emergency fund matters before signing a high-rent
          lease.
        </p>

        <p>
          A safer version of $4,000 rent leaves enough savings after move-in
          costs to cover several months of core expenses. A risky version drains
          savings upfront and relies on every future month going smoothly.
        </p>
      </div>

      <FAQSection
        title="$4,000 Rent FAQ"
        faqs={[
          {
            question: "Is $4,000 a month too much for rent?",
            answer:
              "$4,000 rent may be reasonable for a high-income household with low debt and strong savings, but it can be risky if it consumes too much take-home pay or weakens your emergency fund.",
          },
          {
            question: "How much income do I need for $4,000 rent?",
            answer:
              "The 30% rule points to about $160,000 in annual gross income, but take-home pay is more useful. The payment is safer when it leaves room for savings, debt payments, utilities, insurance, and emergencies.",
          },
          {
            question: "Should I include utilities with $4,000 rent?",
            answer:
              "Yes. Utilities, parking, internet, renter's insurance, pet fees, storage, and building fees should be included in the real housing number.",
          },
          {
            question: "Can $4,000 rent be worth it?",
            answer:
              "Sometimes. It can make sense if it improves work access, safety, schools, commute time, family logistics, or transportation costs without damaging savings or monthly flexibility.",
          },
          {
            question: "What is the biggest risk with $4,000 rent?",
            answer:
              "The biggest risk is committing to a high fixed payment that leaves too little room for emergencies, savings, debt payoff, or normal monthly life after the lease begins.",
          },
        ]}
      />

      <MethodologySection category="rent affordability" updated="May 2026" />

      <RelatedGuides
        guides={[
          {
            title: "How Much Rent Can I Afford?",
            href: "/how-much-rent-can-i-afford",
            description:
              "Use the broader rent affordability guide to compare income, take-home pay, debt, utilities, savings, and monthly flexibility.",
          },
          {
            title: "What Counts as Debt?",
            href: "/what-counts-as-debt",
            description:
              "See which monthly obligations should be included when judging housing pressure.",
          },
          {
            title: "How Much Emergency Savings Should I Have?",
            href: "/how-much-emergency-savings-should-i-have",
            description:
              "Estimate how much cushion to keep before signing a high-rent lease.",
          },
        ]}
      />

      <RelatedCalculators
        calculators={[
          {
            category: "Rent",
            title: "Should I Spend $1,500 on Rent?",
            href: "/should-i-spend-1500-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend $2,500 on Rent?",
            href: "/should-i-spend-2500-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend $3,000 on Rent?",
            href: "/should-i-spend-3000-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend 50% of My Income on Rent?",
            href: "/should-i-spend-50-percent-income-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend 60% of My Income on Rent?",
            href: "/should-i-spend-60-percent-income-on-rent",
          },
        ]}
      />
    </CalculatorPageShell>
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const formatMoney = (value) => {
      return Math.round(value).toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          color: "#16a34a",
          action:
            "This rent appears manageable, but verify the full cost, lease terms, and post-move emergency cushion before signing.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          color: "#ca8a04",
          action:
            "This rent may work, but compare lower-cost options and protect your emergency savings before committing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        color: "#dc2626",
        action:
          "This rent could create serious strain. Consider a cheaper unit, stronger savings cushion, lower debt load, or more income first.",
      };
    }

    function calculateRent() {
      const grossIncome = getNumber("grossIncome");
      const takeHomePay = getNumber("takeHomePay");
      const rent = getNumber("rent");
      const utilities = getNumber("utilities");
      const monthlyDebt = getNumber("monthlyDebt");
      const otherBills = getNumber("otherBills");
      const savings = getNumber("savings");
      const movingCost = getNumber("movingCost");

      const result = document.getElementById("result");
      const scoreEl = document.getElementById("score");
      const barFill = document.getElementById("barFill");
      const housingRatioEl = document.getElementById("housingRatio");
      const takeHomeRatioEl = document.getElementById("takeHomeRatio");
      const leftoverCashEl = document.getElementById("leftoverCash");
      const recommendedRentEl = document.getElementById("recommendedRent");
      const savingsCushionEl = document.getElementById("savingsCushion");
      const moveInImpactEl = document.getElementById("moveInImpact");
      const debtPressureEl = document.getElementById("debtPressure");
      const guidanceEl = document.getElementById("guidance");

      result.style.display = "block";

      if (grossIncome <= 0 || takeHomePay <= 0 || rent <= 0) {
        scoreEl.textContent = "Add your numbers first";
        barFill.style.width = "0%";
        barFill.style.background = "#16a34a";
        housingRatioEl.innerHTML = "";
        takeHomeRatioEl.innerHTML = "";
        leftoverCashEl.innerHTML = "";
        recommendedRentEl.innerHTML = "";
        savingsCushionEl.innerHTML = "";
        moveInImpactEl.innerHTML = "";
        debtPressureEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter positive numbers for annual income, monthly take-home pay, and rent so the calculator can estimate housing pressure.";
        return;
      }

      const monthlyGrossIncome = grossIncome / 12;
      const totalHousingCost = rent + utilities;
      const totalCommittedMonthly = totalHousingCost + monthlyDebt + otherBills;
      const leftoverAfterBills = takeHomePay - totalCommittedMonthly;
      const housingGrossRatio = (totalHousingCost / monthlyGrossIncome) * 100;
      const housingTakeHomeRatio = (totalHousingCost / takeHomePay) * 100;
      const debtTakeHomeRatio = (monthlyDebt / takeHomePay) * 100;
      const leftoverRatio = (leftoverAfterBills / takeHomePay) * 100;
      const postMoveSavings = savings - movingCost;
      const postMoveSavingsMonths =
        totalCommittedMonthly > 0 ? postMoveSavings / totalCommittedMonthly : 0;
      const emergencyMonths =
        totalCommittedMonthly > 0 ? savings / totalCommittedMonthly : 0;
      const moveInSavingsImpact =
        savings > 0 ? (movingCost / savings) * 100 : movingCost > 0 ? 100 : 0;

      const conservativeRent = Math.max(0, Math.min(monthlyGrossIncome * 0.25, takeHomePay * 0.28));
      const balancedRent = Math.max(0, Math.min(monthlyGrossIncome * 0.3, takeHomePay * 0.35));
      const stretchRent = Math.max(0, Math.min(monthlyGrossIncome * 0.4, takeHomePay * 0.45));

      let pressureScore = 0;

      pressureScore += clamp((housingGrossRatio - 20) * 1.05, 0, 28);
      pressureScore += clamp((housingTakeHomeRatio - 25) * 1.15, 0, 34);
      pressureScore += clamp(debtTakeHomeRatio * 0.55, 0, 16);

      if (leftoverAfterBills < 0) {
        pressureScore += 28;
      } else if (leftoverRatio < 8) {
        pressureScore += 20;
      } else if (leftoverRatio < 15) {
        pressureScore += 12;
      } else if (leftoverRatio >= 35) {
        pressureScore -= 8;
      } else if (leftoverRatio >= 25) {
        pressureScore -= 4;
      }

      if (savings <= 0 && movingCost > 0) {
        pressureScore += 18;
      } else if (postMoveSavings < 0) {
        pressureScore += 20;
      } else if (postMoveSavingsMonths < 1 && grossIncome < 120000) {
        pressureScore += 16;
      } else if (postMoveSavingsMonths < 3 && grossIncome < 180000) {
        pressureScore += 10;
      } else if (postMoveSavingsMonths >= 6) {
        pressureScore -= 8;
      }

      if (moveInSavingsImpact >= 75) pressureScore += 12;
      else if (moveInSavingsImpact >= 50) pressureScore += 8;
      else if (moveInSavingsImpact <= 10 && savings > 0) pressureScore -= 3;

      if (housingGrossRatio >= 60) pressureScore += 18;
      else if (housingGrossRatio >= 50) pressureScore += 12;
      else if (housingGrossRatio >= 40) pressureScore += 7;

      if (housingTakeHomeRatio >= 65) pressureScore += 20;
      else if (housingTakeHomeRatio >= 55) pressureScore += 14;
      else if (housingTakeHomeRatio >= 45) pressureScore += 8;

      if (
        housingGrossRatio < 22 &&
        housingTakeHomeRatio < 28 &&
        leftoverRatio >= 30 &&
        emergencyMonths >= 4 &&
        debtTakeHomeRatio < 10
      ) {
        pressureScore -= 12;
      }

      if (
        housingGrossRatio < 12 &&
        housingTakeHomeRatio < 16 &&
        leftoverRatio >= 50 &&
        emergencyMonths >= 8 &&
        debtTakeHomeRatio < 5
      ) {
        pressureScore = Math.min(pressureScore, 10);
      }

      if (
        housingGrossRatio < 6 &&
        housingTakeHomeRatio < 8 &&
        leftoverRatio >= 65 &&
        emergencyMonths >= 12 &&
        debtTakeHomeRatio < 3
      ) {
        pressureScore = 0;
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      let guidance = "";

      if (pressureScore === 0) {
        guidance =
          `This ${formatMoney(rent)} rent payment appears financially tiny relative to the numbers provided. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, leaving substantial flexibility. The decision is mainly about lease terms, location value, and opportunity cost.`;
      } else if (pressureScore <= 30) {
        guidance =
          `This ${formatMoney(rent)} rent payment appears manageable based on the numbers provided. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, while leaving about ${formatMoney(leftoverAfterBills)} after listed housing, debt, and bill obligations.`;
      } else if (pressureScore <= 60) {
        guidance =
          `This ${formatMoney(rent)} rent payment may work, but it deserves caution. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, so utilities, debt payments, move-in costs, and emergency savings should be checked carefully before signing.`;
      } else {
        guidance =
          `This ${formatMoney(rent)} rent payment could create significant financial pressure. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, which may leave too little flexibility after debt, bills, savings needs, and emergencies.`;
      }

      scoreEl.textContent = `${level.label}  -  ${pressureScore}/100`;
      barFill.style.width = `${pressureScore}%`;
      barFill.style.background = level.color;

      housingRatioEl.innerHTML = `<strong>Housing-to-gross-income ratio:</strong> ${housingGrossRatio.toFixed(1)}%`;
      takeHomeRatioEl.innerHTML = `<strong>Housing-to-take-home-pay ratio:</strong> ${housingTakeHomeRatio.toFixed(1)}%`;
      leftoverCashEl.innerHTML = `<strong>Estimated leftover after listed bills:</strong> ${formatMoney(leftoverAfterBills)}`;
      recommendedRentEl.innerHTML = `<strong>Estimated rent range:</strong> ${formatMoney(conservativeRent)} conservative / ${formatMoney(balancedRent)} balanced / ${formatMoney(stretchRent)} stretch`;
      savingsCushionEl.innerHTML = `<strong>Emergency cushion:</strong> ${emergencyMonths.toFixed(1)} months before move-in / ${postMoveSavingsMonths.toFixed(1)} months after move-in costs`;
      moveInImpactEl.innerHTML = `<strong>Move-in savings impact:</strong> ${moveInSavingsImpact.toFixed(1)}% of savings`;
      debtPressureEl.innerHTML = `<strong>Debt payment pressure:</strong> ${debtTakeHomeRatio.toFixed(1)}% of take-home pay`;
      guidanceEl.textContent = `${guidance} Recommended next step: ${level.action}`;
    }

    document
      .getElementById("rentButton")
      .addEventListener("click", calculateRent);
  </script>
</Layout>
