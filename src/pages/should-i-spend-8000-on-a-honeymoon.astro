---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";

const pageUrl = "https://shouldispend.com/should-i-spend-8000-on-a-honeymoon";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is $8,000 too much to spend on a honeymoon?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "$8,000 can be reasonable or risky depending on income, savings, debt, wedding costs, emergency cushion, and whether the trip requires financing.",
      },
    },
    {
      "@type": "Question",
      name: "Should I finance an $8,000 honeymoon?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Financing a honeymoon can create pressure after the wedding. Paying in cash while preserving emergency savings is usually safer.",
      },
    },
    {
      "@type": "Question",
      name: "What should be included in an $8,000 honeymoon budget?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Include flights, hotels, resort fees, meals, drinks, excursions, transportation, passports, travel insurance, tips, luggage, and a buffer for surprises.",
      },
    },
    {
      "@type": "Question",
      name: "Can a honeymoon be worth $8,000?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, if the trip fits comfortably within income and savings, avoids high-interest debt, and does not damage emergency savings or post-wedding goals.",
      },
    },
    {
      "@type": "Question",
      name: "How can I lower an $8,000 honeymoon cost?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Shorten the trip, travel off-season, use points, choose a cheaper destination, reduce luxury upgrades, limit excursions, or delay the honeymoon until savings recover.",
      },
    },
  ],
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Should I Spend $8,000 on a Honeymoon Calculator",
  url: pageUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "All",
  description:
    "A honeymoon affordability calculator that estimates pressure from an $8,000 honeymoon using income, savings, debt, wedding costs, emergency cushion, and travel flexibility.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://shouldispend.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Wedding Calculators",
      item: "https://shouldispend.com/wedding-calculators",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Should I Spend $8,000 on a Honeymoon?",
      item: pageUrl,
    },
  ],
};
---

<Layout
  title="Should I Spend $8,000 on a Honeymoon? Calculator | ShouldISpend"
  description="Use this $8,000 honeymoon calculator to decide whether the trip fits your income, savings, debt, wedding costs, emergency fund, and travel priorities."

  noindex={true}>


  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .container {
      max-width: 950px;
