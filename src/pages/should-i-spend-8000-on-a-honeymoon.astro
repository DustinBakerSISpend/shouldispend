  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const formatMoney = (value) => {
      return Math.round(value).toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          color: "#16a34a",
          action:
            "This honeymoon appears manageable, but keep the full wedding and post-trip savings picture in view.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          color: "#ca8a04",
          action:
            "This honeymoon may work, but consider lowering the trip cost, delaying, or rebuilding savings first.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        color: "#dc2626",
        action:
          "This honeymoon could create real strain. Consider a cheaper trip, delayed honeymoon, or more time to save.",
      };
    }

    function calculateHoneymoon() {
      const income = getNumber("income");
      const savings = getNumber("savings");
      const honeymoonCost = getNumber("honeymoonCost");
      const debt = getNumber("debt");
      const weddingCost = getNumber("weddingCost");
      const monthlyTakeHome = getNumber("monthlyTakeHome");

      const result = document.getElementById("result");
      const scoreEl = document.getElementById("score");
      const barFill = document.getElementById("barFill");
      const stressEl = document.getElementById("stress");
      const savingsImpactEl = document.getElementById("savingsImpact");
      const incomeImpactEl = document.getElementById("incomeImpact");
      const monthlyImpactEl = document.getElementById("monthlyImpact");
      const debtRatioEl = document.getElementById("debtRatio");
      const weddingStackEl = document.getElementById("weddingStack");
      const remainingSavingsEl = document.getElementById("remainingSavings");
      const guidanceEl = document.getElementById("guidance");

      result.style.display = "block";

      if (income <= 0 || savings <= 0 || honeymoonCost <= 0) {
        scoreEl.textContent = "Add your numbers first";
        barFill.style.width = "0%";
        barFill.style.background = "#16a34a";
        stressEl.innerHTML = "";
        savingsImpactEl.innerHTML = "";
        incomeImpactEl.innerHTML = "";
        monthlyImpactEl.innerHTML = "";
        debtRatioEl.innerHTML = "";
        weddingStackEl.innerHTML = "";
        remainingSavingsEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter a positive income, savings amount, honeymoon cost, debt, wedding cost, and take-home pay so the calculator can estimate pressure.";
        return;
      }

      const monthlyIncome = monthlyTakeHome > 0 ? monthlyTakeHome : income / 12;
      const savingsImpact = (honeymoonCost / savings) * 100;
      const annualIncomeImpact = (honeymoonCost / income) * 100;
      const monthlyIncomeImpact = (honeymoonCost / monthlyIncome) * 100;
      const debtRatio = (debt / income) * 100;
      const weddingTravelStack = honeymoonCost + weddingCost;
      const weddingTravelIncomeImpact = (weddingTravelStack / income) * 100;
      const weddingTravelSavingsImpact = savings > 0 ? (weddingTravelStack / savings) * 100 : 0;
      const remainingSavings = savings - honeymoonCost;
      const remainingSavingsMonths = remainingSavings / monthlyIncome;

      let pressureScore = 0;

      pressureScore += clamp(savingsImpact * 0.38, 0, 36);
      pressureScore += clamp(monthlyIncomeImpact * 0.22, 0, 24);
      pressureScore += clamp(debtRatio * 0.2, 0, 16);

      if (honeymoonCost > savings) pressureScore += 26;

      if (remainingSavingsMonths < 1 && income < 100000) {
        pressureScore += 18;
      } else if (remainingSavingsMonths < 3 && income < 150000) {
        pressureScore += 10;
      } else if (remainingSavingsMonths >= 6) {
        pressureScore -= 8;
      }

      if (debtRatio >= 75) pressureScore += 12;
      else if (debtRatio >= 40) pressureScore += 8;

      if (weddingCost > 0) {
        if (weddingTravelSavingsImpact >= 90) pressureScore += 14;
        else if (weddingTravelSavingsImpact >= 60) pressureScore += 9;
        else if (weddingTravelSavingsImpact >= 35) pressureScore += 5;

        if (weddingTravelIncomeImpact >= 45) pressureScore += 10;
        else if (weddingTravelIncomeImpact >= 25) pressureScore += 6;
      }

      if (
        annualIncomeImpact < 2 &&
        savingsImpact < 10 &&
        remainingSavingsMonths >= 6 &&
        debtRatio < 15
      ) {
        pressureScore -= 12;
      }

      if (
        annualIncomeImpact < 0.75 &&
        monthlyIncomeImpact < 8 &&
        debtRatio < 10
      ) {
        pressureScore = Math.min(pressureScore, 18);
      }

      if (
        annualIncomeImpact < 0.25 &&
        monthlyIncomeImpact < 3 &&
        debtRatio < 5
      ) {
        pressureScore = Math.min(pressureScore, 8);
      }

      if (
        annualIncomeImpact < 0.1 &&
        monthlyIncomeImpact < 1.5 &&
        savingsImpact < 1 &&
        debtRatio < 3 &&
        remainingSavingsMonths >= 12
      ) {
        pressureScore = 0;
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      let guidance = "";

      if (pressureScore === 0) {
        guidance =
          `This ${formatMoney(honeymoonCost)} honeymoon appears financially tiny relative to the numbers provided. The trip equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, so the decision is mainly about trip value, timing, and opportunity cost.`;
      } else if (pressureScore <= 30) {
        guidance =
          `This ${formatMoney(honeymoonCost)} honeymoon appears manageable based on the numbers provided. The trip equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, so the main priority is avoiding financing and keeping final wedding costs controlled.`;
      } else if (pressureScore <= 60) {
        guidance =
          `This ${formatMoney(honeymoonCost)} honeymoon may work, but it deserves caution. The trip equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, and the full wedding-plus-travel stack may add pressure if costs keep rising.`;
      } else {
        guidance =
          `This ${formatMoney(honeymoonCost)} honeymoon could create real financial strain. The trip equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, so a cheaper trip, delayed honeymoon, or longer savings window would likely be safer.`;
      }

      scoreEl.textContent = `${level.label}  -  ${pressureScore}/100`;
      barFill.style.width = `${pressureScore}%`;
      barFill.style.background = level.color;

      stressEl.innerHTML = `<strong>Pressure level:</strong> ${level.stress}`;
      savingsImpactEl.innerHTML = `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;
      incomeImpactEl.innerHTML = `<strong>Annual income impact:</strong> ${annualIncomeImpact.toFixed(1)}% of annual income`;
      monthlyImpactEl.innerHTML = `<strong>Monthly take-home impact:</strong> ${monthlyIncomeImpact.toFixed(1)}% of one month's take-home pay`;
      debtRatioEl.innerHTML = `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;
      weddingStackEl.innerHTML = `<strong>Wedding + honeymoon stack:</strong> ${formatMoney(weddingTravelStack)} total / ${weddingTravelIncomeImpact.toFixed(1)}% of annual income`;
      remainingSavingsEl.innerHTML = `<strong>Estimated savings after honeymoon:</strong> ${formatMoney(remainingSavings)} / ${remainingSavingsMonths.toFixed(1)} months of take-home pay`;

      guidanceEl.textContent = `${guidance} Recommended next step: ${level.action}`;
    }

    document
      .getElementById("honeymoonButton")
      .addEventListener("click", calculateHoneymoon);
  </script>
</Layout>
