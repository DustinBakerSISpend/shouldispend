---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";

const groceryFaqs = [
  {
    question: "How much should I spend on groceries per month?",
    answer:
      "A reasonable grocery budget depends on household size, income, location, dietary needs, debt, and savings goals. The safest number is one that still leaves room for bills, savings, and flexibility.",
  },
  {
    question: "Are groceries different from eating out?",
    answer:
      "Yes. Groceries usually cover food prepared at home. Restaurant meals, takeout, coffee runs, delivery fees, and convenience food should usually be tracked separately.",
  },
  {
    question: "Is a high grocery bill always bad?",
    answer:
      "No. A higher grocery bill may be reasonable for larger families, special diets, high-cost areas, or households replacing restaurant spending with home cooking.",
  },
  {
    question: "What if groceries are high because prices went up?",
    answer:
      "Inflation and local food costs matter. The goal is not to shame necessary spending, but to see whether the grocery budget is crowding out savings, debt payoff, or other essentials.",
  },
];
---

<Layout
  title="Should I Spend This Much on Groceries Per Month?"
  description="Use this grocery spending calculator to evaluate whether your monthly grocery budget fits your income, household size, debt, savings, and financial flexibility."
>
  <style>
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.6rem, 7vw, 4.7rem);
      line-height: 0.95;
      margin-bottom: 24px;
      color: var(--text);
      max-width: 900px;
    }

    .intro {
      max-width: 820px;
      color: var(--muted);
      font-size: 1.12rem;
      line-height: 1.85;
      margin-bottom: 48px;
    }

    .calculator-box,
    .info-card,
    .link-card {
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 22px;
      padding: 24px;
    }

    .calculator-box {
      margin-bottom: 40px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-top: 18px;
    }

    label {
      display: block;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 8px;
      font-size: 0.95rem;
    }

    input,
    select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      font-size: 1rem;
      background: white;
      color: var(--text);
    }

    button {
      margin-top: 22px;
      border: none;
      border-radius: 999px;
      padding: 14px 22px;
      background: #0f766e;
      color: white;
      font-weight: 800;
      font-size: 0.95rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.15s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 28px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      padding: 28px;
      display: none;
    }

    .result.visible {
      display: block;
    }

    .score {
      font-size: 2.2rem;
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 18px;
      line-height: 1.2;
    }

    .bar {
      height: 14px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 18px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #0f766e;
      transition: width 0.4s ease;
    }

    .result-details {
      color: var(--muted);
      line-height: 1.8;
      font-size: 1rem;
    }

    .result-details p {
      margin-bottom: 12px;
    }

    .fine-print {
      color: var(--muted);
      font-size: 0.9rem;
      margin-top: 20px;
    }

    section {
      margin-top: 64px;
    }

    h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 18px;
      color: var(--text);
    }

    h3 {
      font-size: 1.25rem;
      color: var(--text);
      margin: 0 0 10px;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.05rem;
    }

    .info-grid,
    .link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
      margin-top: 24px;
    }

    .info-card p,
    .link-card span {
      margin: 0;
      color: var(--muted);
      line-height: 1.65;
      font-size: 0.95rem;
    }

    .link-card {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .link-card strong {
      display: block;
      color: var(--text);
      margin-bottom: 8px;
      line-height: 1.3;
    }

    .note {
      font-size: 0.92rem;
      color: var(--muted);
      margin-top: 14px;
    }
  </style>

  <main class="container">
    <div class="eyebrow">Grocery Budget Calculator</div>

    <h1>Should I Spend This Much on Groceries Per Month?</h1>

    <p class="intro">
      Grocery spending is one of the easiest budget categories to underestimate.
      This calculator helps you evaluate whether your monthly grocery budget
      fits your household size, income, debt load, savings cushion, and overall
      financial flexibility.
    </p>

    <section class="calculator-box">
      <h2>Monthly Grocery Spending Calculator</h2>

      <p>
        Enter your monthly grocery spending and basic financial details. This
        tool estimates whether your grocery budget looks comfortable, elevated,
        or financially tight.
      </p>

      <div class="form-grid">
        <div>
          <label for="groceries">Monthly grocery spending</label>
          <input id="groceries" type="number" placeholder="Example: 900" />
        </div>

        <div>
          <label for="income">Monthly take-home income</label>
          <input id="income" type="number" placeholder="Example: 6500" />
        </div>

        <div>
          <label for="household">Household size</label>
          <input id="household" type="number" placeholder="Example: 4" />
        </div>

        <div>
          <label for="debt">Monthly debt payments</label>
          <input id="debt" type="number" placeholder="Example: 800" />
        </div>

        <div>
          <label for="savings">Emergency savings</label>
          <input id="savings" type="number" placeholder="Example: 15000" />
        </div>

        <div>
          <label for="dining">Monthly dining out / takeout</label>
          <input id="dining" type="number" placeholder="Example: 350" />
        </div>
      </div>

      <button id="calculateButton" type="button">Review Grocery Budget</button>

      <p class="note">
        This calculator uses simplified educational estimates. It is not
        financial advice.
      </p>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="fill" id="scoreFill"></div>
        </div>

        <div class="result-details" id="resultDetails"></div>

        <div class="fine-print">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </section>

    <section>
      <h2>How to Think About Grocery Spending</h2>

      <p>
        Grocery spending is different from a vacation, wedding, or car payment
        because food is necessary. The goal is not to treat groceries like a
        luxury. The goal is to understand whether the monthly total is crowding
        out savings, debt payoff, rent, transportation, or other essential
        needs.
      </p>

      <p>
        A higher grocery bill may be reasonable for a larger household, a
        high-cost area, specific dietary needs, or a family that cooks at home
        instead of spending heavily at restaurants.
      </p>
    </section>

    <section>
      <h2>Signs Your Grocery Budget May Be Too High</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>It Crowds Out Savings</h3>
          <p>
            If groceries prevent you from building emergency savings, the budget
            may need closer review.
          </p>
        </div>

        <div class="info-card">
          <h3>Dining Out Is Also High</h3>
          <p>
            Groceries may be reasonable alone, but total food spending can rise
            fast when takeout and restaurants are added.
          </p>
        </div>

        <div class="info-card">
          <h3>Debt Is Already Tight</h3>
          <p>
            High monthly debt payments make every recurring category more
            important to monitor.
          </p>
        </div>

        <div class="info-card">
          <h3>Food Waste Is Common</h3>
          <p>
            Throwing away groceries regularly can mean the issue is planning,
            not just price.
          </p>
        </div>
      </div>
    </section>

    <section>
      <h2>Groceries vs. Restaurants</h2>

      <p>
        For budgeting, it usually helps to separate groceries from restaurants,
        takeout, coffee, delivery apps, and convenience food. A household may
        have a high grocery bill but a low restaurant budget, which can still be
        reasonable.
      </p>

      <p>
        Total food spending is the bigger picture. If groceries and dining out
        are both high, the combined category may be creating more pressure than
        it appears at first.
      </p>
    </section>

    <section>
      <h2>Related ShouldISpend Guides</h2>

      <div class="link-grid">
        <a class="link-card" href="/how-much-emergency-savings-should-i-have">
          <strong>Emergency Savings Guide</strong>
          <span>
            Understand how much cash cushion to keep before major or recurring
            spending decisions.
          </span>
        </a>

        <a class="link-card" href="/how-much-debt-is-too-much">
          <strong>How Much Debt Is Too Much?</strong>
          <span>
            Learn how monthly obligations and debt pressure affect financial
            flexibility.
          </span>
        </a>

        <a class="link-card" href="/budget-rule-calculators">
          <strong>Budget Rule Calculators</strong>
          <span>
            Browse tools for income percentages, spending pressure, and budget
            balance.
          </span>
        </a>

        <a class="link-card" href="/what-counts-as-debt">
          <strong>What Counts as Debt?</strong>
          <span>
            See which obligations should be included when evaluating monthly
            financial pressure.
          </span>
        </a>
      </div>
    </section>

    <FAQSection title="Grocery Budget FAQ" faqs={groceryFaqs} />
  </main>

  <script>
    const button = document.getElementById("calculateButton");
    const result = document.getElementById("result");
    const scoreText = document.getElementById("scoreText");
    const scoreFill = document.getElementById("scoreFill");
    const resultDetails = document.getElementById("resultDetails");

    button?.addEventListener("click", () => {
      const groceries = Number(document.getElementById("groceries").value);
      const income = Number(document.getElementById("income").value);
      const household = Number(document.getElementById("household").value);
      const debt = Number(document.getElementById("debt").value);
      const savings = Number(document.getElementById("savings").value);
      const dining = Number(document.getElementById("dining").value);

      result?.classList.add("visible");

      if (!groceries || !income || !household) {
        scoreText.textContent = "Add the Core Numbers First";
        scoreFill.style.width = "0%";
        resultDetails.innerHTML = `
          <p>Enter monthly grocery spending, monthly take-home income, and household size to review the grocery budget.</p>
        `;
        return;
      }

      const groceryRatio = groceries / income;
      const foodRatio = (groceries + dining) / income;
      const groceriesPerPerson = groceries / household;
      const debtRatio = debt / income;
      const savingsMonths = savings / Math.max(income * 0.7, 1);

      let riskScore = 100;

      if (groceryRatio > 0.18) riskScore -= 30;
      else if (groceryRatio > 0.13) riskScore -= 20;
      else if (groceryRatio > 0.1) riskScore -= 10;

      if (foodRatio > 0.24) riskScore -= 25;
      else if (foodRatio > 0.18) riskScore -= 15;
      else if (foodRatio > 0.14) riskScore -= 8;

      if (groceriesPerPerson > 450) riskScore -= 15;
      else if (groceriesPerPerson > 350) riskScore -= 8;

      if (debtRatio > 0.25) riskScore -= 15;
      else if (debtRatio > 0.15) riskScore -= 8;

      if (savingsMonths < 1) riskScore -= 15;
      else if (savingsMonths < 3) riskScore -= 8;

      riskScore = Math.max(0, Math.min(100, Math.round(riskScore)));

      let verdict = "Manageable";
      let explanation =
        "Based on the numbers entered, this grocery budget appears to fit reasonably within your broader financial picture.";

      if (riskScore < 50) {
        verdict = "High Grocery Budget Pressure";
        explanation =
          "This grocery budget looks tight relative to income, household size, total food spending, debt, or savings cushion. It may be reducing flexibility elsewhere in the budget.";
      } else if (riskScore < 75) {
        verdict = "Manageable With Guardrails";
        explanation =
          "This grocery budget may be reasonable, but there are signs of pressure. Review total food spending, dining out, debt payments, and savings room.";
      }

      scoreText.textContent = `${verdict} - ${riskScore}/100`;
      scoreFill.style.width = `${riskScore}%`;

      resultDetails.innerHTML = `
        <p><strong>Grocery impact:</strong> ${(groceryRatio * 100).toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Total food impact:</strong> ${(foodRatio * 100).toFixed(1)}% of monthly take-home income, including dining out and takeout.</p>
        <p><strong>Groceries per person:</strong> $${groceriesPerPerson.toFixed(0)} per month.</p>
        <p><strong>Debt impact:</strong> ${(debtRatio * 100).toFixed(1)}% of monthly take-home income.</p>
        <p>${explanation}</p>
      `;
    });
  </script>
</Layout>