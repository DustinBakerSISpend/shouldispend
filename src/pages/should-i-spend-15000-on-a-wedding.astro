---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
---

<Layout
  title="Should I Spend $15,000 on a Wedding?"
  description="Use this wedding calculator to decide whether a $15,000 wedding fits your income, savings, debt, emergency cushion, and financial goals."
>
  <style>
    .container {
      max-width: 920px;
      margin: 0 auto;
      padding: 72px 24px;
    }

    .eyebrow {
      text-align: center;
      color: var(--teal);
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      text-align: center;
      margin: 0 0 16px;
      color: var(--navy);
      line-height: 1.05;
    }

    .subtitle {
      text-align: center;
      font-size: 22px;
      color: var(--muted);
      margin: 0 auto 56px;
      line-height: 1.5;
      max-width: 760px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 24px;
      line-height: 1.2;
    }

    .content-section p,
    .content-section li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
      margin-bottom: 24px;
    }

    .calculator {
      background: var(--card);
      border-radius: 24px;
      padding: 38px;
      box-shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
      border: 1px solid rgba(15, 23, 42, 0.05);
      margin-top: 56px;
    }

    .calculator h2 {
      margin-top: 0;
      color: var(--navy);
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    label {
      display: block;
      font-weight: 800;
      margin-bottom: 9px;
      color: var(--navy);
    }

    input {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid var(--border);
      font-size: 18px;
      box-sizing: border-box;
    }

    input:focus {
      outline: 3px solid rgba(15, 118, 110, 0.18);
      border-color: var(--teal);
    }

    button {
      margin-top: 28px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 28px;
      border-radius: 14px;
      font-size: 19px;
      font-weight: 900;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 34px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 30px;
      display: none;
    }

    .score {
      font-size: 36px;
      font-weight: 900;
      margin-bottom: 18px;
      color: var(--navy);
    }

    .bar {
      height: 16px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .bar-fill {
      height: 100%;
      background: var(--teal);
      width: 0%;
      transition: width 0.4s ease;
    }

    .line {
      margin-bottom: 12px;
      font-size: 18px;
      color: var(--text);
    }

    .guidance {
      margin-top: 26px;
      font-size: 20px;
      line-height: 1.6;
      color: var(--navy);
    }

    .verdict-breakdown {
      margin-top: 18px;
      padding: 18px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 14px;
      font-size: 0.98rem;
      line-height: 1.65;
      color: var(--muted);
      display: none;
    }

    .verdict-breakdown strong {
      color: var(--text);
    }

    .disclaimer {
      margin-top: 22px;
      font-size: 13px;
      color: #64748b;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: #0f766e;
      font-weight: 700;
    }

    @media (max-width: 700px) {
      .container {
        padding: 54px 20px;
      }

      h1 {
        font-size: 38px;
      }

      .subtitle {
        font-size: 18px;
      }

      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Wedding Spending Calculator</div>

    <h1>Should I Spend $15,000 on a Wedding?</h1>

    <p class="subtitle">
      Get a practical verdict based on income, savings, debt, emergency cushion,
      and how much flexibility the wedding leaves afterward.
    </p>

    <div class="calculator">
      <h2>Wedding Pressure Verdict</h2>

      <div class="grid">
        <div>
          <label for="income">Combined Annual Income</label>
          <input id="income" type="number" placeholder="Example: 140000" />
        </div>

        <div>
          <label for="savings">Total Savings</label>
          <input id="savings" type="number" placeholder="Example: 50000" />
        </div>

        <div>
          <label for="cost">Wedding Cost</label>
          <input id="cost" type="number" value="15000" />
        </div>

        <div>
          <label for="debt">Current Debt</label>
          <input id="debt" type="number" placeholder="Example: 12000" />

          <div class="helper-link">
            <a href="/what-counts-as-debt">
              Not sure what counts as debt? Read the debt guide
            </a>
          </div>
        </div>
      </div>

      <button id="weddingButton" type="button">Get Wedding Verdict</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="bar-fill" id="barFill"></div>
        </div>

        <div class="line" id="stress"></div>
        <div class="line" id="savingsImpact"></div>
        <div class="line" id="incomeImpact"></div>
        <div class="line" id="monthlyIncomeImpact"></div>
        <div class="line" id="debtRatio"></div>

        <div class="guidance" id="guidance"></div>

        <div class="verdict-breakdown" id="verdictBreakdown"></div>

        <div class="disclaimer">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>What a $15,000 Wedding Really Costs</h2>

      <p>
        A $15,000 wedding can be a disciplined, realistic celebration, but it
        still needs a full budget. Venue fees, catering, attire, photography,
        flowers, music, decorations, invitations, gratuities, rentals, and
        last-minute upgrades can push the total higher than expected.
      </p>

      <p>
        The main question is whether the wedding fits your broader financial
        life. A $15,000 wedding may be manageable if it is planned in advance and
        paid mostly in cash. It becomes riskier if it drains emergency savings,
        adds debt, or delays larger goals.
      </p>
    </section>

    <WhenSpendingMakesSense
      title="When a $15,000 Wedding Can Make Sense"
      items={[
        "You can pay for the wedding without high-interest debt.",
        "Emergency savings remain intact after the celebration.",
        "The guest list, venue, food, and extras fit one clear budget.",
        "The wedding does not delay housing, debt payoff, or savings goals.",
        "Both partners are comfortable with the tradeoffs.",
      ]}
    />

    <section class="content-section">
      <h2>When You Should Scale Back</h2>

      <p>
        Scaling back may be smarter if the wedding would require credit cards,
        personal loans, depleted savings, or financial help that creates stress
        afterward.
      </p>

      <p>
        A lower-cost wedding can still feel personal and meaningful. A smaller
        guest list, simpler venue, shorter reception, limited bar, or fewer
        vendor upgrades can protect the parts of the day that matter most.
      </p>
    </section>

    <KeyCostCategories
      items={[
        {
          title: "Venue and food",
          description:
            "Venue rental, catering, cake, bar service, service fees, and gratuities usually drive the largest share of the budget.",
        },
        {
          title: "Photography and entertainment",
          description:
            "Photo, video, DJ, live music, ceremony sound, and reception entertainment can quickly change the final total.",
        },
        {
          title: "Attire and beauty",
          description:
            "Dress, suit, alterations, shoes, accessories, hair, makeup, and wedding-party expectations should be included upfront.",
        },
        {
          title: "Decor and last-minute extras",
          description:
            "Flowers, signage, rentals, transportation, favors, postage, and day-of upgrades can quietly push the budget higher.",
        },
      ]}
    />

    <ReduceCostTips
      items={[
        "Limit the guest list before cutting meaningful details.",
        "Choose a venue with tables, chairs, linens, and basic decor included.",
        "Use a simpler bar package or shorter reception window.",
        "Pick one or two splurges instead of upgrading every category.",
        "Keep a separate buffer for taxes, tips, and final-week expenses.",
      ]}
    />

    <FinancialRedFlags
      items={[
        "The wedding requires credit cards or personal loans.",
        "The budget would drain most emergency savings.",
        "The final cost depends on uncertain gifts or family contributions.",
        "The wedding would delay debt payoff or housing stability.",
        "The couple disagrees about the tradeoffs or feels pressured to overspend.",
      ]}
    />

    <CalculatorAssumptions
      items={[
        "The calculator assumes the wedding cost includes the major event expenses, not only the venue deposit.",
        "The estimate uses annual household income, total savings, current debt, and the planned wedding budget.",
        "The calculator treats high savings impact and high debt pressure as larger risk factors.",
        "Very high income or very high savings can reduce the pressure score when the wedding cost is financially trivial.",
        "The tool is educational and does not replace personalized financial advice.",
      ]}
    />

    <section class="content-section">
      <h2>What Your Wedding Verdict Actually Means</h2>

      <p>
        A wedding affordability score is not a judgment about whether the
        celebration is emotionally meaningful. The verdict estimates how much
        financial pressure the expense may create relative to your current
        income, savings cushion, and debt load.
      </p>

      <p>
        A stronger score means the wedding is easier to absorb. A weaker score
        means the budget may still be possible, but the tradeoffs deserve more
        caution.
      </p>
    </section>

    <FAQSection
      title="$15,000 Wedding FAQ"
      faqs={[
        {
          question: "Is $15,000 too much to spend on a wedding?",
          answer:
            "It depends on income, savings, debt, and whether the wedding creates financial stress afterward. A $15,000 wedding may be manageable for one household and risky for another.",
        },
        {
          question: "Can you have a good wedding for $15,000?",
          answer:
            "Yes. A $15,000 wedding can work well with a focused guest list, careful venue choice, realistic food costs, and clear priorities.",
        },
        {
          question: "Should you finance a $15,000 wedding?",
          answer:
            "Financing a wedding can create long-term pressure after the celebration is over. If the cost requires high-interest debt or depleted emergency savings, the budget may be too aggressive.",
        },
        {
          question: "What should be included in a $15,000 wedding budget?",
          answer:
            "Include venue, food, drinks, attire, photography, music, decorations, flowers, invitations, transportation, taxes, tips, and a buffer for last-minute costs.",
        },
        {
          question: "How can I reduce a $15,000 wedding budget?",
          answer:
            "Start with the guest list, venue, food, bar package, photography package, and decor. Those categories usually create the biggest savings opportunities.",
        },
      ]}
    />

    <MethodologySection category="wedding spending" updated="June 2026" />

    <RelatedGuides
      guides={[
        {
          title: "How to Budget for a Wedding Without Going Into Debt",
          href: "/how-to-budget-for-a-wedding-without-going-into-debt",
          description:
            "Plan wedding spending without letting the celebration create long-term financial pressure.",
        },
        {
          title: "What Counts as Debt?",
          href: "/what-counts-as-debt",
          description:
            "See which debt obligations matter when evaluating a major wedding budget.",
        },
      ]}
    />

    <RelatedCalculators
      calculators={[
        {
          category: "Weddings",
          title: "Should I Hire a Wedding Planner?",
          href: "/wedding-planner",
        },
        {
          category: "Weddings",
          title: "Should I Invite This Many Wedding Guests?",
          href: "/wedding-guest-count",
        },
        {
          category: "Weddings",
          title: "Should I Spend $30,000 on a Wedding?",
          href: "/should-i-spend-30000-on-a-wedding",
        },
        {
          category: "Weddings",
          title: "Should I Spend $50,000 on a Wedding?",
          href: "/should-i-spend-50000-on-a-wedding",
        },
      ]}
    />
  </main>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          color: "#16a34a",
          action: "Proceed with a disciplined wedding budget.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          color: "#ca8a04",
          action: "Trim upgrades, protect savings, and avoid debt.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        color: "#dc2626",
        action: "Lower the wedding budget, delay spending, or rebuild savings first.",
      };
    }

    function calculateWedding() {
      const income = getNumber("income");
      const savings = getNumber("savings");
      const cost = getNumber("cost");
      const debt = getNumber("debt");

      const result = document.getElementById("result");
      const scoreText = document.getElementById("scoreText");
      const barFill = document.getElementById("barFill");
      const stressEl = document.getElementById("stress");
      const savingsImpactEl = document.getElementById("savingsImpact");
      const incomeImpactEl = document.getElementById("incomeImpact");
      const monthlyIncomeImpactEl = document.getElementById("monthlyIncomeImpact");
      const debtRatioEl = document.getElementById("debtRatio");
      const guidanceEl = document.getElementById("guidance");
      const breakdown = document.getElementById("verdictBreakdown");

      result.style.display = "block";

      if (income <= 0 || cost <= 0) {
        scoreText.textContent = "Add your numbers first";
        barFill.style.width = "0%";
        barFill.style.background = "#16a34a";
        stressEl.innerHTML = "";
        savingsImpactEl.innerHTML = "";
        incomeImpactEl.innerHTML = "";
        monthlyIncomeImpactEl.innerHTML = "";
        debtRatioEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter a positive income and wedding cost so the calculator can estimate financial pressure.";
        breakdown.style.display = "none";
        return;
      }

      const monthlyIncome = income / 12;
      const remainingSavings = savings - cost;

      const savingsImpact = savings > 0 ? (cost / savings) * 100 : 999;
      const annualIncomeImpact = (cost / income) * 100;
      const monthlyIncomeImpact = (cost / monthlyIncome) * 100;
      const debtRatio = (debt / income) * 100;
      const remainingSavingsMonths = monthlyIncome > 0 ? remainingSavings / monthlyIncome : 0;

      let pressureScore = 0;

      pressureScore += clamp(savingsImpact * 0.28, 0, 34);
      pressureScore += clamp(monthlyIncomeImpact * 0.18, 0, 26);
      pressureScore += clamp(debtRatio * 0.18, 0, 20);

      if (cost > savings && annualIncomeImpact >= 8) pressureScore += 24;
      else if (cost > savings && annualIncomeImpact >= 3) pressureScore += 14;
      else if (cost > savings) pressureScore += 6;

      if (remainingSavingsMonths < 1 && annualIncomeImpact >= 6) {
        pressureScore += 18;
      } else if (remainingSavingsMonths < 3 && annualIncomeImpact >= 4) {
        pressureScore += 10;
      } else if (remainingSavingsMonths >= 6) {
        pressureScore -= 8;
      }

      if (debtRatio >= 75) pressureScore += 12;
      else if (debtRatio >= 40) pressureScore += 8;
      else if (debtRatio <= 5) pressureScore -= 4;

      if (savingsImpact <= 10 && remainingSavings > 0) pressureScore -= 10;
      if (annualIncomeImpact <= 5) pressureScore -= 6;
      if (annualIncomeImpact <= 2) pressureScore -= 8;
      if (monthlyIncomeImpact <= 25) pressureScore -= 6;

      /*
        Huge-income and huge-savings guardrails:
        These prevent absurdly wealthy inputs from producing fake high pressure.
      */

      if (
        income >= 750000 &&
        annualIncomeImpact <= 3 &&
        debtRatio <= 15
      ) {
        pressureScore = Math.min(pressureScore, 18);
      }

      if (
        income >= 1000000 &&
        annualIncomeImpact <= 2 &&
        debtRatio <= 10
      ) {
        pressureScore = Math.min(pressureScore, 8);
      }

      if (
        income >= 1000000 &&
        annualIncomeImpact <= 1.5 &&
        debtRatio <= 5
      ) {
        pressureScore = Math.min(pressureScore, 3);
      }

      if (
        savings >= cost * 20 &&
        remainingSavingsMonths >= 6 &&
        debtRatio <= 15
      ) {
        pressureScore = Math.min(pressureScore, 15);
      }

      if (
        savings >= cost * 50 &&
        debtRatio <= 10
      ) {
        pressureScore = Math.min(pressureScore, 5);
      }

      if (
        income >= 1000000 &&
        cost <= monthlyIncome * 0.25 &&
        debtRatio <= 5
      ) {
        pressureScore = 0;
      }

      if (
        savings >= cost * 100 &&
        debtRatio <= 5
      ) {
        pressureScore = 0;
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      let guidance = "";

      if (pressureScore <= 30) {
        guidance =
          `This wedding appears financially manageable based on the numbers provided. The cost equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, so the main priority is staying disciplined and avoiding unnecessary upgrades.`;
      } else if (pressureScore <= 60) {
        guidance =
          `This wedding may work, but it deserves caution. The cost equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, so the budget should be controlled carefully before deposits, guest-count growth, bar upgrades, and vendor add-ons raise the final total.`;
      } else {
        guidance =
          `This wedding could create real financial strain. The cost equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, so reducing the guest list, simplifying the venue, delaying spending, or rebuilding savings would likely be safer.`;
      }

      scoreText.textContent = `${level.label} — ${pressureScore}/100`;

      barFill.style.width = `${pressureScore}%`;
      barFill.style.background = level.color;

      stressEl.innerHTML =
        `<strong>Pressure level:</strong> ${level.stress}`;

      savingsImpactEl.innerHTML =
        `<strong>Savings impact:</strong> ${
          savings > 0 ? `${savingsImpact.toFixed(1)}% of savings` : "No savings entered"
        }`;

      incomeImpactEl.innerHTML =
        `<strong>Annual income impact:</strong> ${annualIncomeImpact.toFixed(1)}% of annual income`;

      monthlyIncomeImpactEl.innerHTML =
        `<strong>Monthly income impact:</strong> ${monthlyIncomeImpact.toFixed(1)}% of one month’s income`;

      debtRatioEl.innerHTML =
        `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

      guidanceEl.textContent =
        `${guidance} Recommended next step: ${level.action}`;

      breakdown.style.display = "block";

      breakdown.innerHTML = `
        <strong>Financial Breakdown:</strong><br><br>
        - Wedding cost equals <strong>${annualIncomeImpact.toFixed(1)}%</strong> of annual household income.<br>
        - Wedding cost consumes <strong>${
          savings > 0 ? savingsImpact.toFixed(1) + "%" : "an undefined share"
        }</strong> of total savings.<br>
        - Existing debt load equals <strong>${debtRatio.toFixed(1)}%</strong> of annual income.<br>
        - Estimated savings after the wedding: <strong>$${Math.max(remainingSavings, 0).toLocaleString()}</strong>.<br><br>
        This verdict weighs savings impact, income impact, debt pressure, and remaining cushion. Very high income or very high savings can appropriately lower the score when the wedding cost is financially minor.
      `;
    }

    document
      .getElementById("weddingButton")
      .addEventListener("click", calculateWedding);
  </script>
</Layout>