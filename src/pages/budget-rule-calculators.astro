---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const ruleCalculators = calculators.filter(
  (calculator) =>
    calculator.title.includes("%") ||
    calculator.title.includes("Income") ||
    calculator.category === "Budget Rules"
);

const budgetRuleFaqs = [
  {
    question: "What is a budget rule calculator?",
    answer:
      "A budget rule calculator compares a monthly expense to your income, debt, savings, and other obligations so you can see whether the expense is reasonable or financially stressful.",
  },
  {
    question: "Are percentage-based budget rules always accurate?",
    answer:
      "No. Budget rules are useful starting points, but they should be adjusted for income, debt, savings, family size, local costs, and personal priorities.",
  },
  {
    question: "Should I use gross income or take-home income?",
    answer:
      "Take-home income usually gives a more realistic picture because it reflects the money actually available after taxes, benefits, and payroll deductions.",
  },
  {
    question: "Is the 30% rent rule still useful?",
    answer:
      "Yes, but only as a starting point. Rent affordability should also consider debt payments, utilities, transportation, emergency savings, and local housing costs.",
  },
  {
    question: "Why do budget percentages matter?",
    answer:
      "Percentages help show whether one expense is taking too much of your income and reducing flexibility for savings, debt payoff, emergencies, and normal life.",
  },
];
---

<Layout
  title="Budget Rule Calculators | Income, Rent, Debt and Spending Rules"
  description="Use budget rule calculators to compare rent, debt, car payments, groceries, travel, and major expenses against your income and financial pressure."
>
  <style>
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 72px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.95;
      margin-bottom: 28px;
      max-width: 860px;
      color: #0f172a;
    }

    .intro {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
      max-width: 820px;
      margin-bottom: 40px;
    }

    .hero-note {
      background: #f0fdfa;
      border: 1px solid #99f6e4;
      border-radius: 20px;
      padding: 24px;
      color: #134e4a;
      line-height: 1.75;
      max-width: 860px;
      margin-bottom: 56px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-bottom: 72px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 28px;
    }

    .content-section {
      max-width: 860px;
      margin-top: 72px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 24px;
      line-height: 1.2;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
      margin-bottom: 24px;
    }

    .info-card,
    .link-card {
      display: block;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .info-card h3,
    .link-card strong {
      display: block;
      color: #0f172a;
      margin-top: 0;
      margin-bottom: 10px;
      line-height: 1.25;
    }

    .info-card p,
    .link-card span {
      color: #334155;
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }
  </style>

  <main class="container">
    <div class="eyebrow">Budget Rule Calculators</div>

    <h1>Budget Rule Calculators for Real-Life Spending Decisions</h1>

    <p class="intro">
      Budget rules can help you spot financial pressure before it becomes a
      problem. These calculators compare expenses to your income, debt,
      savings, and monthly flexibility so you can see whether a decision fits
      your real budget.
    </p>

    <div class="hero-note">
      ShouldISpend does not treat budget rules as one-size-fits-all answers.
      A 30% rent rule, 20% car-payment rule, or 50/30/20 budget guideline can
      be useful, but the real question is whether the expense leaves enough room
      for debt payments, emergency savings, groceries, insurance, utilities, and
      normal life.
    </div>

    <div class="grid">
      {ruleCalculators.map((calculator) => (
        <CalculatorCard
          category={calculator.category}
          title={calculator.title}
          description={calculator.description}
          href={calculator.href}
        />
      ))}
    </div>

    <section class="content-section">
      <h2>How Budget Rule Calculators Help</h2>

      <p>
        Many spending decisions look reasonable when viewed as a single monthly
        payment. The pressure becomes clearer when that payment is compared to
        take-home income, existing debt, savings, and recurring obligations.
      </p>

      <p>
        A budget rule calculator helps translate a decision into a percentage
        of your income. That percentage can show whether the expense is
        comfortable, tight, risky, or likely to crowd out other financial goals.
      </p>

      <p>
        These calculators are especially useful for decisions involving rent,
        car payments, debt ratios, groceries, travel, weddings, emergency
        savings, and other recurring or high-cost expenses.
      </p>
    </section>

    <section class="content-section">
      <h2>Common Budget Rule Pressure Points</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Housing Percentage</h3>
          <p>
            Rent or mortgage payments become more stressful as they consume a
            larger share of take-home income.
          </p>
        </div>

        <div class="info-card">
          <h3>Debt-to-Income Pressure</h3>
          <p>
            Debt payments reduce flexibility after housing, transportation,
            groceries, insurance, and utilities are paid.
          </p>
        </div>

        <div class="info-card">
          <h3>Car Payment Rules</h3>
          <p>
            Transportation costs can quietly strain a budget when the payment,
            insurance, gas, maintenance, and registration are counted together.
          </p>
        </div>

        <div class="info-card">
          <h3>Emergency Savings Cushion</h3>
          <p>
            Higher spending percentages are safer when emergency savings are
            strong and riskier when savings are thin.
          </p>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>Helpful Budget, Debt, and Housing Guides</h2>

      <div class="link-grid">
        <a class="link-card" href="/how-much-rent-can-i-afford">
          <strong>How Much Rent Can I Afford?</strong>
          <span>
            Estimate realistic rent using take-home pay, debt, utilities,
            savings, and monthly pressure.
          </span>
        </a>

        <a class="link-card" href="/how-much-house-can-i-afford">
          <strong>How Much House Can I Afford?</strong>
          <span>
            Compare home affordability against income, debt, taxes, insurance,
            maintenance, and cash reserves.
          </span>
        </a>

        <a class="link-card" href="/how-much-debt-is-too-much">
          <strong>How Much Debt Is Too Much?</strong>
          <span>
            Understand when debt payments begin to limit flexibility, savings,
            and long-term stability.
          </span>
        </a>

        <a class="link-card" href="/what-counts-as-debt">
          <strong>What Counts as Debt?</strong>
          <span>
            See which obligations should be counted when evaluating monthly
            affordability and debt pressure.
          </span>
        </a>

        <a class="link-card" href="/how-much-emergency-savings-should-i-have">
          <strong>Emergency Savings Guide</strong>
          <span>
            Learn how much cushion to keep before committing to major monthly
            expenses.
          </span>
        </a>

        <a class="link-card" href="/calculators">
          <strong>All ShouldISpend Calculators</strong>
          <span>
            Browse every calculator across rent, cars, groceries, travel,
            weddings, debt, and major life expenses.
          </span>
        </a>
      </div>
    </section>

    <FAQSection title="Budget Rule Calculator FAQ" faqs={budgetRuleFaqs} />
  </main>
</Layout>