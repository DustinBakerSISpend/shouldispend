---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const budgetRuleCalculators = calculators.filter(
  (calculator) => calculator.category === "Budget Rules"
);

const budgetFaqs = [
  {
    question: "Should I use gross income or take-home income for budget rules?",
    answer:
      "Take-home income usually gives a clearer picture because it reflects money actually available after taxes, deductions, benefits, and payroll withholding.",
  },
  {
    question: "Are budget rules always accurate?",
    answer:
      "No. Budget rules are starting points, not guarantees. Debt, location, savings, income stability, dependents, medical costs, and housing costs can change the safe answer.",
  },
  {
    question: "How much emergency savings should I have?",
    answer:
      "The right emergency fund depends on essential expenses, debt, job stability, dependents, health needs, home or car risk, and how quickly you could recover from a surprise.",
  },
  {
    question: "How much debt is too much?",
    answer:
      "Debt becomes too much when monthly payments crowd out savings, housing stability, groceries, medical needs, transportation, or the ability to handle emergencies.",
  },
  {
    question: "What counts as debt in affordability calculators?",
    answer:
      "Debt usually includes required monthly payments such as credit cards, student loans, car loans, personal loans, medical payment plans, and other recurring obligations.",
  },
];

const featuredBudgetLinks = [
  {
    href: "/how-much-emergency-savings-should-i-have/",
    title: "Emergency Savings Calculator",
    text:
      "Calculate emergency savings targets using expenses, debt pressure, dependents, job stability, and financial flexibility.",
  },
  {
    href: "/how-much-debt-is-too-much/",
    title: "How Much Debt Is Too Much?",
    text:
      "Calculate debt pressure using monthly payments, housing costs, emergency savings, credit card debt, and overall flexibility.",
  },
  {
    href: "/what-counts-as-debt/",
    title: "What Counts as Debt?",
    text:
      "Learn which monthly obligations usually count as debt when using affordability calculators and budget rules.",
  },
  {
    href: "/how-much-house-can-i-afford/",
    title: "How Much House Can I Afford?",
    text:
      "Learn how income, debt, taxes, insurance, maintenance, emergency savings, and monthly flexibility affect home affordability.",
  },
];

const budgetCostFactors = [
  {
    title: "Take-home income",
    text:
      "Rules based on gross income can miss taxes, insurance, retirement contributions, benefits, and deductions that reduce real monthly cash.",
  },
  {
    title: "Fixed obligations",
    text:
      "Rent, mortgage, car payments, student loans, credit cards, medical debt, insurance, and utilities reduce flexibility.",
  },
  {
    title: "Emergency savings",
    text:
      "A budget with no cushion can break even when the monthly math looks technically balanced.",
  },
  {
    title: "Debt pressure",
    text:
      "Minimum payments may fit today while still preventing savings, creating stress, or leaving no room for surprises.",
  },
  {
    title: "Income stability",
    text:
      "A freelancer, contractor, commission worker, or single-income household may need more cushion than a stable dual-income household.",
  },
  {
    title: "Local cost reality",
    text:
      "Housing, childcare, groceries, medical costs, transportation, and insurance can make national rules feel unrealistic in a specific household.",
  },
];

const pressureFactors = [
  {
    title: "Monthly breathing room",
    text:
      "The safest budget leaves money after required bills, not just enough to make minimum payments.",
  },
  {
    title: "Recovery power",
    text:
      "A household is stronger when it can rebuild savings after a major expense instead of staying stuck at zero.",
  },
  {
    title: "Debt type",
    text:
      "Credit card debt, medical debt, student loans, car loans, and mortgage debt do not all carry the same risk.",
  },
  {
    title: "Essential expenses",
    text:
      "Food, housing, utilities, transportation, prescriptions, insurance, and childcare deserve more protection than optional spending.",
  },
  {
    title: "Dependents",
    text:
      "Children, family support, pets, and caregiving responsibilities can make the same budget rule feel tighter.",
  },
  {
    title: "Timing",
    text:
      "A major purchase is riskier when it arrives near moving costs, tuition, medical bills, job changes, or other large obligations.",
  },
];

const reduceCostTips = [
  {
    title: "Use rules as warnings, not permission",
    text:
      "A number can look acceptable under a rule and still be risky if savings, debt, or income stability are weak.",
  },
  {
    title: "Start with fixed bills",
    text:
      "Rent, debt, insurance, utilities, transportation, and childcare shape the rest of the budget before optional spending begins.",
  },
  {
    title: "Protect emergency cash",
    text:
      "A decision that drains savings may be riskier than the same decision made with a stronger cushion.",
  },
  {
    title: "Track debt payments together",
    text:
      "A single payment may look fine while the combined debt load quietly controls the month.",
  },
  {
    title: "Model the month after",
    text:
      "The safest choices still work after the purchase, trip, repair, lease, or bill is paid.",
  },
  {
    title: "Adjust for real life",
    text:
      "Budget rules should bend for local costs, health needs, family size, job stability, and unavoidable obligations.",
  },
];

const redFlags = [
  "The rule says yes but the emergency fund would be wiped out.",
  "Minimum debt payments already crowd out savings.",
  "The budget only works if every month is perfect.",
  "Gross income is being used even though take-home pay is much lower.",
  "A major decision depends on future raises, bonuses, overtime, or tax refunds.",
  "Housing, car payments, groceries, and debt are all tight at the same time.",
  "The household has no clear plan to recover after the expense.",
  "The budget ignores dependents, medical needs, job instability, or local cost reality.",
];

const assumptions = [
  "Take-home income is usually more useful than gross income for household pressure tests.",
  "Budget rules are starting points, not final answers.",
  "Debt pressure includes required monthly payments and the stress they create in the rest of the budget.",
  "Emergency savings can make the same expense safer or riskier depending on how much remains afterward.",
  "A decision is less risky when normal bills, savings, debt payoff, and essentials still work afterward.",
  "These calculators are educational tools and do not replace tax, legal, lending, housing, insurance, or financial advice.",
];

const relatedGuides = [
  {
    href: "/rent-calculators/",
    title: "Rent Calculators",
    text:
      "Compare housing costs against take-home income, utilities, debt, transportation, and savings.",
  },
  {
    href: "/car-calculators/",
    title: "Car Calculators",
    text:
      "Pressure-test car payments against insurance, fuel, debt, emergency savings, and total ownership costs.",
  },
  {
    href: "/grocery-calculators/",
    title: "Grocery Calculators",
    text:
      "Evaluate grocery spending against household size, income, savings, debt, and restaurant spending.",
  },
  {
    href: "/medical-calculators/",
    title: "Medical Cost Calculators",
    text:
      "Compare medical bills, payment plans, insurance gaps, debt pressure, and emergency savings use.",
  },
  {
    href: "/home-improvement-calculators/",
    title: "Home Improvement Calculators",
    text:
      "Evaluate repairs, projects, financing, emergency savings, and the cost of waiting.",
  },
  {
    href: "/calculators/",
    title: "All ShouldISpend Calculators",
    text:
      "Browse every calculator for major household decisions and spending pressure.",
  },
];

const internalLinks = [
  { href: "/how-much-emergency-savings-should-i-have/", label: "emergency savings" },
  { href: "/how-much-debt-is-too-much/", label: "debt pressure" },
  { href: "/what-counts-as-debt/", label: "what counts as debt" },
  { href: "/how-much-house-can-i-afford/", label: "house affordability" },
  { href: "/rent-calculators/", label: "rent calculators" },
  { href: "/car-calculators/", label: "car calculators" },
  { href: "/grocery-calculators/", label: "grocery calculators" },
  { href: "/calculators/", label: "all calculators" },
];
---

<Layout
  title="Budget Rule Calculators | Debt, Savings and Affordability Rules"
  description="Use budget rule calculators to evaluate emergency savings, debt pressure, house affordability, take-home income, monthly obligations, and financial flexibility."
>
  <style>
    .hub-page {
      width: 92%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 72px 0 20px;
    }

    .hero {
      max-width: 940px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      max-width: 980px;
      font-size: clamp(2.75rem, 6.4vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      margin: 0 0 24px;
      color: var(--text);
    }

    h2 {
      font-size: clamp(1.85rem, 3.6vw, 2.65rem);
      line-height: 1.08;
      letter-spacing: -0.035em;
      margin: 0 0 18px;
      color: var(--text);
    }

    h3 {
      color: var(--text);
      font-size: 1.15rem;
      line-height: 1.32;
      margin: 0 0 10px;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.04rem;
    }

    .intro {
      max-width: 880px;
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.85;
      margin: 0 0 18px;
    }

    .section {
      margin-top: 76px;
      max-width: 920px;
    }

    .wide-section {
      margin-top: 76px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-top: 34px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      margin-top: 28px;
    }

    .verdict-bar,
    .callout {
      margin-top: 56px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 32px;
      box-shadow: var(--shadow-soft);
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .info-card,
    .link-card {
      display: block;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 20px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: var(--shadow-soft);
    }

    .info-card p,
    .link-card span {
      display: block;
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .link-card strong {
      display: block;
      color: var(--text);
      line-height: 1.3;
      font-size: 1.08rem;
      margin: 0 0 10px;
    }

    .check-list,
    .red-flag-list {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .check-list li,
    .red-flag-list li {
      margin: 0;
      padding: 15px 16px;
      border-radius: 16px;
      line-height: 1.55;
      font-size: 0.96rem;
    }

    .red-flag-list li {
      border: 1px solid #fecaca;
      background: #fff7f7;
      color: #7f1d1d;
    }

    .check-list li {
      border: 1px solid #cfeee1;
      background: #f1fbf6;
      color: #173404;
    }

    .inline-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .inline-links a {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 800;
      font-size: 0.92rem;
      background: var(--card);
    }

    .inline-links a:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .dark-callout {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
      color: #ffffff;
    }

    .dark-callout h2 {
      color: #ffffff;
    }

    .dark-callout p {
      color: #e7eadf;
    }

    @media (max-width: 720px) {
      .hub-page {
        padding: 56px 0 12px;
      }

      h1 {
        font-size: 2.55rem;
        line-height: 1.03;
      }

      .intro,
      p,
      li {
        font-size: 1rem;
      }

      .grid,
      .info-grid,
      .link-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .section,
      .wide-section {
        margin-top: 58px;
      }

      .verdict-bar,
      .callout {
        padding: 24px;
      }
    }
  </style>

  <main class="hub-page">
    <section class="hero">
      <div class="eyebrow">Budget Rule Calculators and Guides</div>

      <h1>Budget rules are useful until real life breaks the rule.</h1>

      <p class="intro">
        The 30% rent rule, debt ratios, emergency fund targets, and affordability
        guidelines can be useful starting points. They are not permission slips.
      </p>

      <p class="intro">
        These calculators help pressure-test rules against take-home income, debt,
        savings, housing, dependents, job stability, and monthly breathing room.
      </p>

      <div class="inline-links">
        {internalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </section>

    <section id="AdSenseHubReview" class="callout">
      <div class="eyebrow">Review status</div>
      <h2>Budget rule calculator hub reviewed for pressure, trust, and crawlable guidance.</h2>

      <p>
        <strong>Written and maintained by Dustin Baker.</strong> Last reviewed: July 2026.
        This hub is part of the ShouldISpend calculator library and is being reviewed
        for AdSense readiness, clean internal links, visible examples, and clear limits.
      </p>

      <p>
        These calculators are educational pressure tests. They help readers compare
        rent rules, debt rules, car payment rules, emergency savings, and affordability thresholds against take-home income, savings, debt, outside help, monthly
        breathing room, and recovery risk. They are not personalized financial, legal,
        tax, medical, insurance, or investment advice.
      </p>

      <p>
        For more context, review the <a href="/methodology/">Methodology</a>,
        <a href="/editorial-policy/">Editorial Policy</a>, and
        <a href="/disclaimer/">Disclaimer</a>.
      </p>
    </section>

    <section id="CrawlableHubExamples" class="wide-section">
      <div class="eyebrow">Worked examples</div>
      <h2>Examples this hub is meant to help pressure-test</h2>

      <p>
        These examples are visible before anyone uses a form. They show how the same
        category can produce very different pressure depending on savings, income,
        debt, outside help, urgency, and whether the decision creates a recurring bill.
      </p>

      <ul class="check-list">
        <li>30% rent that is manageable with low debt but tight with a car payment and no emergency fund.</li>
        <li>A debt ratio that looks acceptable until childcare, medical bills, or variable income are included.</li>
        <li>A car payment rule that works as a starting point but misses insurance and maintenance.</li>
        <li>Emergency savings targets that change when income is unstable or fixed costs are high.</li>
      </ul>
    </section>

    <section id="HubLimits" class="section">
      <div class="eyebrow">When this hub is not enough</div>
      <h2>Use the calculators as a starting point, not the final word.</h2>

      <p>
        A calculator can clarify pressure, but it cannot know every detail of a household.
        Slow down before relying on a result alone when the decision involves legal
        obligations, taxes, medical treatment, insurance disputes, unstable income,
        major debt, family obligations, or a situation where the lowest-cost option
        could create larger harm later.
      </p>
    </section>


    <section class="wide-section">
      <div class="eyebrow">Start here</div>
      <h2>Common budget rule decisions</h2>

      <div class="link-grid">
        {featuredBudgetLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    {budgetRuleCalculators.length > 0 && (
      <section class="wide-section">
        <div class="eyebrow">All budget rule calculators</div>
        <h2>Debt, savings, and affordability rule calculators</h2>

        <p>
          Use these tools to compare emergency savings, debt pressure, house
          affordability, monthly obligations, and the flexibility left after major
          decisions.
        </p>

        <div class="grid">
          {budgetRuleCalculators.map((calculator) => (
            <CalculatorCard
              category={calculator.category}
              title={calculator.title}
              description={calculator.description}
              href={calculator.href}
            />
          ))}
        </div>
      </section>
    )}

    <div class="verdict-bar">
      <div class="verdict-label">Rule pressure</div>

      <h2>A rule can say yes while your budget says no.</h2>

      <p>
        Budget rules are useful because they simplify complicated decisions. They
        become risky when they ignore real monthly bills, unstable income, high
        debt, dependents, medical needs, or a weak emergency fund.
      </p>
    </div>

    <section class="section">
      <div class="eyebrow">Decision framework</div>
      <h2>What budget affordability really means</h2>

      <p>
        A budget decision is safer when the household can pay the cost, preserve
        basic stability, keep savings alive, and recover afterward.
      </p>

      <p>
        The best rule is not the one that approves the biggest purchase. It is the
        one that helps you see pressure before the pressure becomes debt, missed
        bills, or panic.
      </p>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Cost categories</div>
      <h2>What budget rules should account for</h2>

      <div class="info-grid">
        {budgetCostFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Pressure factors</div>
      <h2>What makes a budget rule useful or misleading</h2>

      <p>
        A useful rule should bend around the household's actual obligations,
        savings, risk, and recovery power.
      </p>

      <div class="info-grid">
        {pressureFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Lower the pressure</div>
      <h2>Ways to use budget rules safely</h2>

      <div class="info-grid">
        {reduceCostTips.map((tip) => (
          <div class="info-card">
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="eyebrow">Warning signs</div>
      <h2>Budget rule red flags</h2>

      <p>
        These signs mean the rule may be too simple for the decision in front of
        you.
      </p>

      <ul class="red-flag-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="eyebrow">When a stretch can make sense</div>
      <h2>Sometimes your context matters more than the shortcut.</h2>

      <p>
        A household with strong savings, low debt, stable income, and clear
        priorities may safely stretch in one category.
      </p>

      <p>
        The danger is stacking multiple stretches together: high rent, high car
        payment, low savings, credit card debt, and a major purchase all at once.
      </p>
    </section>

    <section class="section">
      <div class="eyebrow">Assumptions</div>
      <h2>How these calculators think about budget rules</h2>

      <p>
        These assumptions help keep rule-based calculators realistic across
        different households.
      </p>

      <ul class="check-list">
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Related tools</div>
      <h2>Other calculators that connect to budget rules</h2>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>
            <span>{guide.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="callout dark-callout">
      <div class="eyebrow">Use these as pressure tests</div>

      <h2>A good rule should make the decision clearer, not smaller than real life.</h2>

      <p>
        ShouldISpend budget rule calculators are educational tools. Use them to
        compare income, debt, savings, housing, and monthly flexibility before
        making a major decision. They do not replace tax, legal, lending, housing,
        insurance, or financial advice.
      </p>
    </section>

    <FAQSection title="Budget Rule FAQ" faqs={budgetFaqs} />
  </main>
</Layout>
