---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const ruleCalculators = calculators.filter(
  (calculator) =>
    calculator.title.includes("%") ||
    calculator.title.includes("Income")
);

const budgetRuleFaqs = [
  {
    question: "Are percentage-based budget rules always accurate?",
    answer:
      "No. Percentage rules are useful starting points, but they should be adjusted for income, debt, savings, family size, local costs, and personal priorities.",
  },
  {
    question: "Should I use gross income or take-home income?",
    answer:
      "Take-home income usually gives a more realistic picture because it reflects the money actually available after taxes, benefits, and payroll deductions.",
  },
  {
    question: "Is the 30% rent rule still useful?",
    answer:
      "Yes, but only as a starting point. Rent affordability should also consider debt payments, utilities, transportation, emergency savings, and local housing costs.",
  },
  {
    question: "Why do budget percentages matter?",
    answer:
      "Percentages help show whether one expense is taking too much of your income and reducing flexibility for savings, debt payoff, emergencies, and normal life.",
  },
];
---

<Layout
  title="Budget Rule Calculators | ShouldISpend"
  description="Browse percentage-based budget calculators for rent, income, housing pressure, and financial flexibility."
>
  <style>
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 72px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.95;
      margin-bottom: 28px;
      max-width: 820px;
      color: #0f172a;
    }

    .intro {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
      max-width: 800px;
      margin-bottom: 56px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-bottom: 72px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 28px;
    }

    .content-section {
      max-width: 820px;
      margin-top: 72px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 24px;
      line-height: 1.2;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
      margin-bottom: 24px;
    }

    .info-card,
    .link-card {
      display: block;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .info-card h3,
    .link-card strong {
      display: block;
      color: #0f172a;
      margin-top: 0;
      margin-bottom: 10px;
      line-height: 1.25;
    }

    .info-card p,
    .link-card span {
      color: #334155;
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }
  </style>

  <main class="container">
    <div class="eyebrow">Budget Rule Calculators</div>

    <h1>Percentage-Based Budget and Spending Calculators</h1>

    <p class="intro">
      These calculators evaluate spending decisions using percentage-of-income
      rules commonly used in budgeting, housing, transportation, and lifestyle
      planning. They help show whether one expense is taking too much room away
      from savings, debt payoff, emergency funds, and everyday flexibility.
    </p>

    <div class="grid">
      {ruleCalculators.map((calculator) => (
        <CalculatorCard
          category={calculator.category}
          title={calculator.title}
          description={calculator.description}
          href={calculator.href}
        />
      ))}
    </div>

    <section class="content-section">
      <h2>Why Percentage-Based Budget Rules Matter</h2>

      <p>
        Many financial decisions are evaluated relative to income rather than
        raw dollar amounts alone. A payment that feels manageable at one income
        level may create major stress at another.
      </p>

      <p>
        Percentage-based budgeting helps compare housing, transportation, debt,
        travel, and lifestyle expenses within the broader context of financial
        flexibility, savings potential, and long-term stability.
      </p>

      <p>
        These rules are not perfect. They work best as warning lights. If one
        category takes too much of your income, the rest of the budget has less
        room for emergencies, savings, and normal life.
      </p>
    </section>

    <section class="content-section">
      <h2>Common Budget Rule Pressure Points</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Rent-to-Income Ratio</h3>
          <p>
            Housing becomes riskier as it approaches 40% to 50% of take-home
            income, especially with debt or weak savings.
          </p>
        </div>

        <div class="info-card">
          <h3>Debt-to-Income Pressure</h3>
          <p>
            Debt payments reduce flexibility after rent, car payments, groceries,
            insurance, and utilities are paid.
          </p>
        </div>

        <div class="info-card">
          <h3>Take-Home Pay</h3>
          <p>
            Gross income can make payments look easier than they really are.
            Take-home pay is usually more useful for monthly decisions.
          </p>
        </div>

        <div class="info-card">
          <h3>Emergency Cushion</h3>
          <p>
            A higher spending percentage is safer when emergency savings are
            strong and risky when savings are thin.
          </p>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>Helpful Budget and Housing Guides</h2>

      <div class="link-grid">
        <a class="link-card" href="/how-much-rent-can-i-afford">
          <strong>How Much Rent Can I Afford?</strong>
          <span>
            Learn how take-home income, debt, utilities, and savings affect rent
            affordability.
          </span>
        </a>

        <a class="link-card" href="/what-counts-as-debt">
          <strong>What Counts as Debt?</strong>
          <span>
            See which obligations should be counted when evaluating affordability
            and monthly pressure.
          </span>
        </a>

        <a class="link-card" href="/how-much-emergency-savings-should-i-have">
          <strong>Emergency Savings Guide</strong>
          <span>
            Understand how much cushion to keep before committing to major
            expenses.
          </span>
        </a>
      </div>
    </section>

    <FAQSection title="Budget Rule FAQ" faqs={budgetRuleFaqs} />
  </main>
</Layout>