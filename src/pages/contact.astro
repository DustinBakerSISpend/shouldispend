---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact ShouldISpend"
  description="Contact ShouldISpend with questions, feedback, calculator ideas, or site suggestions."
>
  <main class="contact-page">
    <p class="eyebrow">Contact</p>
    <h1>Contact ShouldISpend</h1>

    <p>
      Have a calculator idea, question, correction, or feedback about ShouldISpend?
      Send a note anytime.
    </p>

    <div class="contact-card">
      <h2>Email</h2>
      <p>
        <a href="mailto:hello@shouldispend.com">hello@shouldispend.com</a>
      </p>
    </div>
  </main>

  <style>
    .contact-page {
      max-width: 760px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: #0f766e;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.8rem;
    }

    h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      line-height: 1;
      margin: 0 0 24px;
      color: #061126;
    }

    p {
      color: #475569;
      line-height: 1.8;
      font-size: 1.05rem;
    }

    .contact-card {
      margin-top: 2rem;
      padding: 1.5rem;
      border-radius: 18px;
      border: 1px solid #d8e0ea;
      background: white;
    }

    .contact-card h2 {
      margin-top: 0;
    }

    a {
      color: #0f766e;
      font-weight: 800;
    }
  </style>
</Layout>