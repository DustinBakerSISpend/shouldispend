---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact ShouldISpend"
  description="Contact ShouldISpend with calculator suggestions, feedback, corrections, partnership inquiries, or general questions."
>
  <main class="contact-page">
    <p class="eyebrow">Contact</p>

    <h1>Contact ShouldISpend</h1>

    <p class="intro">
      Questions, feedback, calculator ideas, or corrections? Reach out anytime.
    </p>

    <p>
      ShouldISpend is an independently operated financial education website
      created and managed by Dustin Baker. The site continues to expand with new
      calculators, guides, and decision-support tools, and user feedback helps
      improve both the calculators and the educational content.
    </p>

    <div class="contact-card">
      <h2>Email</h2>

      <p>
        <a href="mailto:hello@shouldispend.com">
          hello@shouldispend.com
        </a>
      </p>

      <p class="small">
        You can use this email for:
      </p>

      <ul>
        <li>Calculator suggestions</li>
        <li>Bug reports or incorrect calculations</li>
        <li>General feedback</li>
        <li>Partnership or media inquiries</li>
        <li>Content corrections or update requests</li>
      </ul>
    </div>

    <div class="note">
      <p>
        ShouldISpend provides educational information and generalized financial
        decision-support tools. Messages sent through this page do not create a
        financial advisor-client relationship.
      </p>
    </div>
  </main>

  <style>
    .contact-page {
      max-width: 760px;
      margin: 0 auto;
      padding: 80px 24px;
    }

    .eyebrow {
      color: var(--accent);
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.8rem;
      margin-bottom: 14px;
    }

    h1 {
      font-size: clamp(2.7rem, 6vw, 4.5rem);
      line-height: 1;
      margin: 0 0 24px;
      color: var(--navy);
    }

    h2 {
      margin-top: 0;
      color: var(--navy);
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.05rem;
    }

    .intro {
      font-size: 1.18rem;
      color: var(--text);
    }

    .contact-card {
      margin-top: 2.5rem;
      padding: 2rem;
      border-radius: 22px;
      border: 1px solid var(--border);
      background: white;
    }

    .contact-card ul {
      margin-top: 1rem;
      padding-left: 1.25rem;
    }

    .contact-card li {
      margin-bottom: 0.65rem;
    }

    .small {
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
      font-weight: 700;
      color: var(--text);
    }

    .note {
      margin-top: 2rem;
      padding: 1.5rem;
      border-radius: 20px;
      background: #f8fafc;
      border: 1px solid var(--border);
    }

    a {
      color: var(--teal);
      font-weight: 800;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .contact-page {
        padding: 64px 20px;
      }

      .contact-card {
        padding: 1.5rem;
      }
    }
  </style>
</Layout>