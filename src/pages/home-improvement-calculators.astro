---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const homeImprovementCalculators = calculators.filter(
  (calculator) => calculator.category === "Home Improvement"
);

const homeFaqs = [
  {
    question: "How much should I budget for home repairs each year?",
    answer:
      "A realistic annual home repair budget depends on home value, age, climate, condition, roof age, systems risk, emergency savings, and whether repairs are urgent or optional.",
  },
  {
    question: "Should I use emergency savings for home repairs?",
    answer:
      "Emergency savings can make sense for urgent repairs that protect safety, shelter, water, heat, electrical systems, or further damage. It is riskier when the repair is cosmetic or drains the entire cushion.",
  },
  {
    question: "Should I finance a home repair?",
    answer:
      "Financing may be reasonable for urgent repairs when cash is not available, but the monthly payment, interest rate, fees, and existing debt should be tested first.",
  },
  {
    question: "Which home repairs should not wait?",
    answer:
      "Leaks, mold, electrical hazards, roof failure, plumbing problems, foundation issues, heating or cooling failure, safety risks, and water damage usually deserve faster attention than cosmetic upgrades.",
  },
  {
    question: "Is a remodel different from a repair?",
    answer:
      "Yes. Repairs often protect the home from damage or safety issues. Remodels may improve comfort, resale value, or lifestyle, but they usually deserve stricter affordability testing.",
  },
];

const featuredHomeLinks = [
  {
    href: "/home-improvement-annual-cost-calculator",
    title: "Home Improvement Annual Cost Calculator",
    text:
      "Estimate a realistic yearly home repair and improvement budget using home value, home age, condition, climate, systems risk, savings, and renovation goals.",
  },
  {
    href: "/should-i-spend-this-much-on-home-repairs",
    title: "Home Repair Cost Calculator",
    text:
      "Evaluate home repair affordability using emergency savings, urgency, debt pressure, financing risk, and long-term flexibility.",
  },
  {
    href: "/should-i-spend-10000-on-a-roof-replacement",
    title: "$10,000 Roof Replacement Calculator",
    text:
      "Pressure-test a roof replacement against insurance help, savings, urgency, financing, debt, and home protection value.",
  },
  {
    href: "/should-i-spend-8000-on-hvac-replacement",
    title: "$8,000 HVAC Replacement Calculator",
    text:
      "Evaluate HVAC replacement affordability using repair urgency, emergency savings, financing risk, debt pressure, and monthly cash flow.",
  },
];

const homeCostFactors = [
  {
    title: "Urgency and safety",
    text:
      "Water intrusion, electrical hazards, broken heat, plumbing failures, mold, foundation problems, and unsafe structures should be judged differently from cosmetic projects.",
  },
  {
    title: "Home age and condition",
    text:
      "Older homes, deferred maintenance, harsh climates, aging roofs, old systems, and prior quick fixes can increase repair exposure.",
  },
  {
    title: "Emergency savings",
    text:
      "A repair is safer when it protects the home without leaving the household unable to handle the next surprise.",
  },
  {
    title: "Financing cost",
    text:
      "Contractor financing, credit cards, personal loans, HELOCs, and payment plans can make a repair possible but still create long-term pressure.",
  },
  {
    title: "Insurance help",
    text:
      "Insurance may reduce the uncovered cost, but deductibles, claim timing, exclusions, and coverage disputes should be understood before committing.",
  },
  {
    title: "Home value and payoff",
    text:
      "Some projects protect the home, some improve resale value, and some are mostly lifestyle upgrades. The reason matters.",
  },
];

const pressureFactors = [
  {
    title: "Uncovered cost",
    text:
      "The real pressure is the amount the household must cover after insurance, warranties, family help, discounts, and confirmed credits.",
  },
  {
    title: "Repair delay risk",
    text:
      "Waiting can be expensive when the problem may spread, create water damage, worsen safety risk, or damage other systems.",
  },
  {
    title: "Existing debt",
    text:
      "Credit cards, car loans, student loans, medical debt, and other monthly obligations reduce room for home repair payments.",
  },
  {
    title: "Monthly payment",
    text:
      "A financed repair should still leave room for groceries, utilities, rent or mortgage, savings, insurance, and normal bills.",
  },
  {
    title: "Project scope creep",
    text:
      "A simple repair can become a bigger project once walls are opened, materials are upgraded, or related problems are discovered.",
  },
  {
    title: "Essential vs optional",
    text:
      "Necessary repairs deserve more priority than cosmetic upgrades, convenience improvements, or projects driven mainly by comparison.",
  },
];

const reduceCostTips = [
  {
    title: "Get more than one quote",
    text:
      "Multiple estimates can reveal whether the first quote is high, incomplete, or missing a less expensive repair path.",
  },
  {
    title: "Separate repair from upgrade",
    text:
      "Fixing the leak is different from remodeling the whole room. Keep the must-do work visible before adding extras.",
  },
  {
    title: "Ask about phased work",
    text:
      "Some projects can be split into urgent work now and optional improvements later.",
  },
  {
    title: "Check insurance and warranties",
    text:
      "Home insurance, manufacturer warranties, installer warranties, and service contracts may reduce the uncovered cost.",
  },
  {
    title: "Protect the next emergency",
    text:
      "Avoid using every dollar of cash on a project that still leaves the home exposed to future repairs.",
  },
  {
    title: "Watch financing terms",
    text:
      "Low monthly payments can hide high interest, deferred interest, fees, or long repayment timelines.",
  },
];

const redFlags = [
  "The repair would go entirely on a high-interest credit card.",
  "The project is mostly cosmetic but would drain emergency savings.",
  "The contractor quote is not itemized.",
  "The household has not checked insurance, warranties, or second opinions.",
  "The monthly payment would crowd out groceries, utilities, debt payments, or savings.",
  "The project keeps expanding before the urgent problem is solved.",
  "The home has multiple aging systems and no remaining repair cushion.",
  "The decision is being rushed by fear, sales pressure, or comparison.",
];

const assumptions = [
  "Monthly income means take-home pay, not gross income.",
  "Home repair affordability depends on urgency, safety, savings, debt, financing terms, and recovery room.",
  "Necessary repairs are treated differently from cosmetic upgrades.",
  "Insurance, warranties, rebates, and confirmed help should reduce the true uncovered cost.",
  "A repair is less risky when emergency savings remain strong afterward.",
  "These calculators are educational tools and do not replace contractor, legal, insurance, tax, or financial advice.",
];

const relatedGuides = [
  {
    href: "/should-i-spend-2500-on-water-heater-replacement",
    title: "$2,500 Water Heater Replacement Calculator",
    text:
      "Evaluate water heater replacement affordability using age, leak risk, household need, repair history, savings, financing, and cash flow.",
  },
  {
    href: "/should-i-spend-12000-on-new-windows",
    title: "$12,000 New Windows Calculator",
    text:
      "Compare window replacement cost against energy savings, emergency reserves, financing costs, debt pressure, and long-term home value.",
  },
  {
    href: "/should-i-spend-15000-on-foundation-repair",
    title: "$15,000 Foundation Repair Calculator",
    text:
      "Evaluate foundation repair affordability using structural risk, emergency savings, financing pressure, debt load, and home stability.",
  },
  {
    href: "/how-much-emergency-savings-should-i-have",
    title: "Emergency Savings Calculator",
    text:
      "See how much cash cushion to preserve before or after a major home repair.",
  },
  {
    href: "/how-much-debt-is-too-much",
    title: "Debt Pressure Calculator",
    text:
      "Understand whether existing debt leaves enough room for a home repair payment.",
  },
  {
    href: "/calculators",
    title: "All ShouldISpend Calculators",
    text:
      "Browse calculators for home repairs, rent, groceries, cars, medical bills, travel, and more.",
  },
];

const internalLinks = [
  { href: "/home-improvement-annual-cost-calculator", label: "annual home repair budget" },
  { href: "/should-i-spend-this-much-on-home-repairs", label: "home repair cost" },
  { href: "/should-i-spend-10000-on-a-roof-replacement", label: "$10,000 roof" },
  { href: "/should-i-spend-8000-on-hvac-replacement", label: "$8,000 HVAC" },
  { href: "/should-i-spend-2500-on-water-heater-replacement", label: "water heater" },
  { href: "/should-i-spend-15000-on-foundation-repair", label: "foundation repair" },
  { href: "/how-much-emergency-savings-should-i-have", label: "emergency savings" },
  { href: "/calculators", label: "all calculators" },
];
---

<Layout
  title="Home Improvement Calculators | Repair Costs, Savings and Debt"
  description="Use home improvement calculators to evaluate repairs, roof replacement, HVAC, windows, water heaters, foundation work, savings, debt, and financing pressure."
>
  <style>
    .hub-page {
      width: 92%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 72px 0 20px;
    }

    .hero {
      max-width: 940px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      max-width: 980px;
      font-size: clamp(2.75rem, 6.4vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      margin: 0 0 24px;
      color: var(--text);
    }

    h2 {
      font-size: clamp(1.85rem, 3.6vw, 2.65rem);
      line-height: 1.08;
      letter-spacing: -0.035em;
      margin: 0 0 18px;
      color: var(--text);
    }

    h3 {
      color: var(--text);
      font-size: 1.15rem;
      line-height: 1.32;
      margin: 0 0 10px;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.04rem;
    }

    .intro {
      max-width: 880px;
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.85;
      margin: 0 0 18px;
    }

    .section {
      margin-top: 76px;
      max-width: 920px;
    }

    .wide-section {
      margin-top: 76px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-top: 34px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      margin-top: 28px;
    }

    .verdict-bar,
    .callout {
      margin-top: 56px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 32px;
      box-shadow: var(--shadow-soft);
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .info-card,
    .link-card {
      display: block;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 20px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: var(--shadow-soft);
    }

    .info-card p,
    .link-card span {
      display: block;
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .link-card strong {
      display: block;
      color: var(--text);
      line-height: 1.3;
      font-size: 1.08rem;
      margin: 0 0 10px;
    }

    .check-list,
    .red-flag-list {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .check-list li,
    .red-flag-list li {
      margin: 0;
      padding: 15px 16px;
      border-radius: 16px;
      line-height: 1.55;
      font-size: 0.96rem;
    }

    .red-flag-list li {
      border: 1px solid #fecaca;
      background: #fff7f7;
      color: #7f1d1d;
    }

    .check-list li {
      border: 1px solid #cfeee1;
      background: #f1fbf6;
      color: #173404;
    }

    .inline-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .inline-links a {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 800;
      font-size: 0.92rem;
      background: var(--card);
    }

    .inline-links a:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .dark-callout {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
      color: #ffffff;
    }

    .dark-callout h2 {
      color: #ffffff;
    }

    .dark-callout p {
      color: #e7eadf;
    }

    @media (max-width: 720px) {
      .hub-page {
        padding: 56px 0 12px;
      }

      h1 {
        font-size: 2.55rem;
        line-height: 1.03;
      }

      .intro,
      p,
      li {
        font-size: 1rem;
      }

      .grid,
      .info-grid,
      .link-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .section,
      .wide-section {
        margin-top: 58px;
      }

      .verdict-bar,
      .callout {
        padding: 24px;
      }
    }
  </style>

  <main class="hub-page">
    <section class="hero">
      <div class="eyebrow">Home Improvement Calculators</div>

      <h1>Home repairs are not all the same kind of spending.</h1>

      <p class="intro">
        A leaking roof, broken furnace, aging water heater, cracked foundation,
        and cosmetic remodel do not deserve the same financial test.
      </p>

      <p class="intro">
        These calculators help pressure-test repair and improvement decisions
        against urgency, savings, debt, financing, insurance, and the cost of
        waiting.
      </p>

      <div class="inline-links">
        {internalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Start here</div>
      <h2>Common home repair decisions</h2>

      <div class="link-grid">
        {featuredHomeLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    {homeImprovementCalculators.length > 0 && (
      <section class="wide-section">
        <div class="eyebrow">All home improvement calculators</div>
        <h2>Home repair and improvement affordability calculators</h2>

        <p>
          Use these tools to compare repair urgency, savings, debt, financing,
          insurance help, home value, and the pressure a project creates after the
          work is done.
        </p>

        <div class="grid">
          {homeImprovementCalculators.map((calculator) => (
            <CalculatorCard
              category={calculator.category}
              title={calculator.title}
              description={calculator.description}
              href={calculator.href}
            />
          ))}
        </div>
      </section>
    )}

    <div class="verdict-bar">
      <div class="verdict-label">Home repair pressure</div>

      <h2>The cost of waiting can be part of the cost.</h2>

      <p>
        Some home projects are optional. Others protect safety, shelter, water,
        heat, structure, or the value of the home. The safest decision weighs the
        repair cost against the risk of delaying it and the household's ability to
        recover afterward.
      </p>
    </div>

    <section class="section">
      <div class="eyebrow">Decision framework</div>
      <h2>What home repair affordability really means</h2>

      <p>
        Home repair affordability is not just whether the quote can be paid. It is
        whether the repair protects the home without creating a new financial
        emergency.
      </p>

      <p>
        A necessary repair may be worth using savings or financing. A cosmetic
        project should usually face a stricter test, especially when emergency
        savings are thin or debt is already high.
      </p>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Cost categories</div>
      <h2>What can change the real cost of home repairs</h2>

      <div class="info-grid">
        {homeCostFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Pressure factors</div>
      <h2>What makes a home project manageable or risky</h2>

      <p>
        A home improvement calculator should judge the project against urgency,
        uncovered cost, savings, debt, financing, and the risk of doing nothing.
      </p>

      <div class="info-grid">
        {pressureFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Lower the pressure</div>
      <h2>Ways to make a home project safer</h2>

      <div class="info-grid">
        {reduceCostTips.map((tip) => (
          <div class="info-card">
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="eyebrow">Warning signs</div>
      <h2>Home repair red flags</h2>

      <p>
        These signs do not mean the repair should be ignored. They mean the quote,
        timing, financing, or project scope deserves a closer look.
      </p>

      <ul class="red-flag-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="eyebrow">When spending more can make sense</div>
      <h2>A bigger repair can be the safer decision when it prevents bigger damage.</h2>

      <p>
        Spending more can make sense when the project protects the structure,
        avoids water damage, improves safety, restores heat or cooling, prevents
        mold, or fixes a system that keeps failing.
      </p>

      <p>
        It becomes riskier when the project is mostly cosmetic, financed
        aggressively, or expanded before the urgent repair is solved.
      </p>
    </section>

    <section class="section">
      <div class="eyebrow">Assumptions</div>
      <h2>How these calculators think about home repair costs</h2>

      <p>
        These assumptions help keep home improvement results realistic across
        different homes and project types.
      </p>

      <ul class="check-list">
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Related tools</div>
      <h2>Other calculators that connect to home repairs</h2>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>
            <span>{guide.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="callout dark-callout">
      <div class="eyebrow">Use these as pressure tests</div>

      <h2>A home repair should protect the house without wrecking the household.</h2>

      <p>
        ShouldISpend home improvement calculators are educational tools. Use them
        to compare urgency, savings, debt, financing, and repair tradeoffs before
        committing. They do not replace contractor, legal, insurance, tax, or
        financial advice.
      </p>
    </section>

    <FAQSection title="Home Improvement FAQ" faqs={homeFaqs} />
  </main>
</Layout>
