---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const homeImprovementCalculators = calculators.filter(
  (calculator) => calculator.category === "Home Improvement"
);

const homeImprovementFaqs = [
  {
    question: "Should I use emergency savings for home repairs?",
    answer:
      "Emergency savings may be appropriate for urgent repairs that protect safety, housing stability, or prevent more expensive damage. Optional upgrades should usually be planned separately.",
  },
  {
    question: "Are home repairs different from home improvements?",
    answer:
      "Yes. Repairs usually fix a problem, while improvements upgrade the home. Urgent repairs often deserve higher priority than cosmetic projects.",
  },
  {
    question: "Should I finance a home repair?",
    answer:
      "Financing may make sense for urgent repairs, but it can create long-term pressure if the payment strains your monthly budget or adds high-interest debt.",
  },
  {
    question: "How much should I keep saved after a home repair?",
    answer:
      "The safer target depends on income stability, home age, debt, dependents, and monthly expenses. Many homeowners benefit from keeping several months of essential expenses available.",
  },
];

const relatedGuides = [
  {
    title: "Emergency Savings Calculator",
    href: "/how-much-emergency-savings-should-i-have",
    description:
      "Estimate how much emergency savings you may need before and after major home expenses.",
  },
  {
    title: "How Much Debt Is Too Much?",
    href: "/how-much-debt-is-too-much",
    description:
      "Understand how monthly debt pressure affects home repair and renovation decisions.",
  },
  {
    title: "How Much House Can I Afford?",
    href: "/how-much-house-can-i-afford",
    description:
      "Evaluate housing affordability using income, taxes, insurance, maintenance, debt, and savings.",
  },
  {
    title: "Budget Rule Calculators",
    href: "/budget-rule-calculators",
    description:
      "Compare major expenses against income, savings, debt, and monthly financial pressure.",
  },
];
---

<Layout
  title="Home Improvement Calculators | Repairs, Renovations and Savings"
  description="Evaluate home repairs, renovation costs, emergency savings, debt pressure, homeownership costs, and household financial flexibility."
>
  <style>
    .container {
      width: 92%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 72px 0;
    }

    .hero {
      max-width: 880px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(2.8rem, 6vw, 5rem);
      line-height: 1;
      margin-bottom: 24px;
      color: var(--primary);
    }

    .hero p {
      font-size: 1.1rem;
      line-height: 1.85;
      color: var(--muted);
      max-width: 820px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-top: 36px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 28px;
    }

    .section {
      margin-top: 72px;
      max-width: 880px;
    }

    .section h2 {
      font-size: 2rem;
      margin-bottom: 22px;
      line-height: 1.2;
      color: var(--text);
    }

    .section p {
      line-height: 1.9;
      color: var(--muted);
      margin-bottom: 24px;
      font-size: 1.05rem;
    }

    .verdict-bar {
      margin-top: 56px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 32px;
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .verdict-bar h2 {
      margin: 0 0 16px;
      font-size: 2rem;
      color: var(--text);
      line-height: 1.2;
    }

    .verdict-bar p {
      margin: 0;
      line-height: 1.85;
      color: var(--muted);
    }

    .info-card,
    .link-card {
      display: block;
      border: 1px solid var(--border);
      background: white;
      border-radius: 20px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .info-card h3,
    .link-card strong {
      display: block;
      margin-bottom: 10px;
      color: var(--text);
      line-height: 1.3;
    }

    .info-card p,
    .link-card span {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    @media (max-width: 720px) {
      .container {
        padding: 56px 0;
      }

      h1 {
        font-size: 2.9rem;
      }

      .hero p {
        font-size: 1rem;
      }

      .section h2,
      .verdict-bar h2 {
        font-size: 1.7rem;
      }
    }
  </style>

  <main class="container">
    <section class="hero">
      <div class="eyebrow">Home Improvement Calculators</div>

      <h1>Home Improvement Calculators for Repairs and Renovations</h1>

      <p>
        Home repairs and renovation projects can create serious financial
        pressure because they often combine urgency, large costs, savings
        decisions, and debt tradeoffs. These calculators evaluate home expenses
        using emergency savings, repair urgency, income stability, debt pressure,
        and monthly flexibility.
      </p>
    </section>

    <div class="grid">
      {homeImprovementCalculators.map((calculator) => (
        <CalculatorCard
          category={calculator.category}
          title={calculator.title}
          description={calculator.description}
          href={calculator.href}
        />
      ))}
    </div>

    <div class="verdict-bar">
      <div class="verdict-label">Home Repair Pressure</div>

      <h2>
        A home repair becomes financially risky when it protects the house but
        weakens the household afterward.
      </h2>

      <p>
        Necessary repairs can still be the right decision, especially when
        delaying them could create larger damage. The goal is to understand
        whether the expense leaves enough savings, flexibility, and recovery
        room after the work is done.
      </p>
    </div>

    <section class="section">
      <h2>What Home Improvement Affordability Really Means</h2>

      <p>
        Home improvement affordability depends on the difference between urgent
        repairs and optional upgrades. A roof leak, broken furnace, electrical
        issue, plumbing failure, or safety problem should be judged differently
        from a cosmetic remodel.
      </p>

      <p>
        The best financial decision is not always the cheapest option. A repair
        that prevents larger damage may protect long-term stability, while an
        optional upgrade may deserve more caution if it drains savings or adds
        debt pressure.
      </p>

      <p>
        ShouldISpend calculators evaluate home projects by looking at cost,
        urgency, emergency savings, debt load, income stability, and how much
        financial breathing room remains after the project.
      </p>
    </section>

    <section class="section">
      <h2>Financial Pressure Factors in Home Repairs</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Repair Urgency</h3>

          <p>
            Safety issues, water damage, heat, plumbing, and structural problems
            usually carry more urgency than cosmetic upgrades.
          </p>
        </div>

        <div class="info-card">
          <h3>Emergency Savings</h3>

          <p>
            Homeowners often need extra savings because repairs can happen
            suddenly and cost more than expected.
          </p>
        </div>

        <div class="info-card">
          <h3>Debt Pressure</h3>

          <p>
            Financing a repair may solve the immediate problem while adding
            long-term monthly pressure.
          </p>
        </div>

        <div class="info-card">
          <h3>Home Age</h3>

          <p>
            Older homes may require more cash cushion because systems, roofs,
            appliances, and mechanicals can fail closer together.
          </p>
        </div>

        <div class="info-card">
          <h3>Income Stability</h3>

          <p>
            Stable income makes home repair recovery easier than irregular or
            uncertain earnings.
          </p>
        </div>

        <div class="info-card">
          <h3>Recovery Timeline</h3>

          <p>
            A repair is safer when the household has a realistic path to
            rebuilding savings afterward.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Related Financial Pressure Guides</h2>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>

            <span>{guide.description}</span>
          </a>
        ))}
      </div>
    </section>

    <FAQSection title="Home Improvement FAQ" faqs={homeImprovementFaqs} />
  </main>
</Layout>