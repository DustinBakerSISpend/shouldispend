---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const medicalCalculators = calculators.filter(
  (calculator) => calculator.category === "Medical"
);

const medicalFaqs = [
  {
    question: "Should I use emergency savings for medical bills?",
    answer:
      "Emergency savings are often meant for unavoidable expenses like medical costs, especially when delaying treatment creates greater risk. The key question is whether the bill leaves enough cushion afterward.",
  },
  {
    question: "Should I go into debt for medical treatment?",
    answer:
      "Necessary care may still be worth pursuing even if a payment plan or debt is required. The goal is to avoid skipped care while limiting high-interest debt and long-term monthly pressure.",
  },
  {
    question: "Do payment plans make medical bills safer?",
    answer:
      "Payment plans can reduce immediate pressure, but they still affect monthly flexibility, savings growth, and household debt load over time.",
  },
  {
    question: "Should I delay medical care because of cost?",
    answer:
      "That depends on urgency and medical necessity. Some care can safely wait while savings improve, but delaying important treatment may increase both health risk and future financial risk.",
  },
  {
    question: "What matters most when comparing medical costs?",
    answer:
      "The biggest factors are urgency, insurance coverage, out-of-pocket maximums, emergency savings, payment plan terms, existing debt, monthly income, and whether delaying care could make the problem worse.",
  },
];

const featuredMedicalLinks = [
  {
    title: "Should I Spend This Much on Medical Bills?",
    href: "/should-i-spend-this-much-on-medical-bills/",
    text:
      "Pressure-test a medical bill against savings, income, urgency, debt, insurance gaps, and monthly recovery room.",
  },
  {
    title: "Medical Bill Payment Plan Calculator",
    href: "/medical-bill-payment-plan-calculator/",
    text:
      "Estimate whether a monthly medical payment plan fits your budget without crowding out normal bills.",
  },
  {
    title: "Should I Use Emergency Savings for Medical Bills?",
    href: "/should-i-spend-this-much-on-medical-bills/",
    text:
      "Decide whether paying from savings protects your household or leaves too little cushion afterward.",
  },
  {
    title: "Emergency Savings Calculator",
    href: "/how-much-emergency-savings-should-i-have/",
    text:
      "See how much cash cushion may help before and after an unavoidable medical expense.",
  },
];

const medicalCostFactors = [
  {
    title: "Insurance gaps",
    text:
      "Deductibles, coinsurance, copays, out-of-network charges, denied claims, uncovered procedures, and balance bills can make the final cost very different from the first estimate.",
  },
  {
    title: "Urgency of care",
    text:
      "Emergency care, necessary treatment, pain relief, mobility, dental work, therapy, prescriptions, and follow-up care should be judged differently from optional or easily delayed care.",
  },
  {
    title: "Emergency savings",
    text:
      "Savings can make medical care easier to handle, but the remaining cushion matters after the bill is paid.",
  },
  {
    title: "Payment plan terms",
    text:
      "A payment plan can reduce immediate strain, but the monthly payment still competes with rent, groceries, transportation, childcare, and debt payoff.",
  },
  {
    title: "Existing debt",
    text:
      "Credit cards, car loans, student loans, personal loans, and other monthly obligations affect whether a medical bill is manageable.",
  },
  {
    title: "Recovery path",
    text:
      "The safest medical spending decisions leave a realistic path to rebuild savings and keep the household stable after treatment.",
  },
];

const reduceCostTips = [
  {
    title: "Ask for an itemized bill",
    text:
      "Billing errors happen. An itemized bill makes it easier to spot duplicate charges, unclear fees, denied claims, or services that need review.",
  },
  {
    title: "Ask about financial assistance",
    text:
      "Hospitals and providers may offer charity care, hardship discounts, income-based assistance, or lower payment terms.",
  },
  {
    title: "Check network status early",
    text:
      "For non-emergency care, confirm whether the provider, facility, lab, anesthesiologist, and other services are in network.",
  },
  {
    title: "Compare payment options",
    text:
      "A no-interest medical payment plan is usually safer than a high-interest credit card if the monthly payment fits.",
  },
  {
    title: "Protect basic bills",
    text:
      "Medical spending should not accidentally crowd out rent, groceries, transportation, prescriptions, insurance premiums, or childcare.",
  },
  {
    title: "Appeal when something looks wrong",
    text:
      "Insurance appeals, billing reviews, coding questions, and provider assistance can matter before a bill becomes debt.",
  },
];

const redFlags = [
  "The bill would wipe out emergency savings with no realistic plan to rebuild them.",
  "The payment plan would make rent, groceries, transportation, or childcare difficult to cover.",
  "The provider is out of network and the final bill is uncertain.",
  "The plan depends on a high-interest credit card instead of a lower-pressure payment option.",
  "Optional treatment is being financed while essential bills are already strained.",
  "The household has not asked about financial assistance, itemized billing, or insurance appeals.",
  "The medical cost is being delayed even though waiting could make the health problem worse.",
  "A one-time medical bill would create monthly debt pressure for years.",
];

const assumptions = [
  "Monthly income means take-home pay, not gross income.",
  "Medical affordability depends on both the bill amount and the household's ability to recover afterward.",
  "Emergency savings are useful for medical costs, but they should not be drained casually.",
  "No-interest payment plans are generally less risky than high-interest credit card debt.",
  "Necessary medical care may still be worth pursuing even when the financial pressure is real.",
  "Optional, cosmetic, or easily delayed care should be judged differently from urgent or necessary care.",
  "These calculators are educational tools and do not replace medical, insurance, legal, or financial advice.",
];

const relatedGuides = [
  {
    title: "How Much Emergency Savings Should I Have?",
    href: "/how-much-emergency-savings-should-i-have/",
    text:
      "Learn how emergency savings affect medical flexibility, financial pressure, and recovery from unexpected expenses.",
  },
  {
    title: "How Much Debt Is Too Much?",
    href: "/how-much-debt-is-too-much/",
    text:
      "Understand how recurring debt obligations affect monthly breathing room and financial stability.",
  },
  {
    title: "What Counts as Debt?",
    href: "/what-counts-as-debt/",
    text:
      "See which financial obligations should be included when evaluating affordability and monthly pressure.",
  },
  {
    title: "Medical Bill Payment Plan Calculator",
    href: "/medical-bill-payment-plan-calculator/",
    text:
      "Estimate whether a monthly medical payment plan fits your income, savings, debt, and budget flexibility.",
  },
  {
    title: "Should I Spend This Much on Medical Bills?",
    href: "/should-i-spend-this-much-on-medical-bills/",
    text:
      "Pressure-test a medical bill against savings, income, urgency, debt, and monthly recovery power.",
  },
  {
    title: "All Calculators",
    href: "/calculators/",
    text:
      "Browse other ShouldISpend calculators for debt, emergency savings, rent, groceries, baby costs, and major spending decisions.",
  },
];

const internalLinks = [
  { href: "/should-i-spend-this-much-on-medical-bills/", label: "medical bill calculator" },
  { href: "/medical-bill-payment-plan-calculator/", label: "payment plan calculator" },
  { href: "/should-i-spend-this-much-on-medical-bills/", label: "use savings for medical bills" },
  { href: "/how-much-emergency-savings-should-i-have/", label: "emergency savings" },
  { href: "/how-much-debt-is-too-much/", label: "debt pressure" },
  { href: "/calculators/", label: "all calculators" },
];
---

<Layout
  title="Medical Cost Calculators | Medical Bills and Healthcare Affordability"
  description="Evaluate medical bills, payment plans, emergency savings, healthcare affordability, insurance gaps, debt pressure, and monthly financial flexibility."
>
  <style>
    .hub-page {
      width: 92%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 72px 0 20px;
    }

    .hero {
      max-width: 940px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      max-width: 980px;
      font-size: clamp(2.75rem, 6.4vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      margin: 0 0 24px;
      color: var(--text);
    }

    h2 {
      font-size: clamp(1.85rem, 3.6vw, 2.65rem);
      line-height: 1.08;
      letter-spacing: -0.035em;
      margin: 0 0 18px;
      color: var(--text);
    }

    h3 {
      color: var(--text);
      font-size: 1.15rem;
      line-height: 1.32;
      margin: 0 0 10px;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.04rem;
    }

    .intro {
      max-width: 880px;
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.85;
      margin: 0 0 18px;
    }

    .section {
      margin-top: 76px;
      max-width: 920px;
    }

    .wide-section {
      margin-top: 76px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-top: 34px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      margin-top: 28px;
    }

    .verdict-bar,
    .callout,
    .note {
      margin-top: 56px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 32px;
      box-shadow: var(--shadow-soft);
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .info-card,
    .link-card {
      display: block;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 20px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: var(--shadow-soft);
    }

    .info-card p,
    .link-card span {
      display: block;
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .link-card strong {
      display: block;
      color: var(--text);
      line-height: 1.3;
      font-size: 1.08rem;
      margin: 0 0 10px;
    }

    .check-list,
    .red-flag-list {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .check-list li,
    .red-flag-list li {
      margin: 0;
      padding: 15px 16px;
      border-radius: 16px;
      line-height: 1.55;
      font-size: 0.96rem;
    }

    .red-flag-list li {
      border: 1px solid #fecaca;
      background: #fff7f7;
      color: #7f1d1d;
    }

    .check-list li {
      border: 1px solid #cfeee1;
      background: #f1fbf6;
      color: #173404;
    }

    .inline-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .inline-links a {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 800;
      font-size: 0.92rem;
      background: var(--card);
    }

    .inline-links a:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .dark-callout {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
      color: #ffffff;
    }

    .dark-callout h2 {
      color: #ffffff;
    }

    .dark-callout p {
      color: #e7eadf;
    }

    @media (max-width: 720px) {
      .hub-page {
        padding: 56px 0 12px;
      }

      h1 {
        font-size: 2.55rem;
        line-height: 1.03;
      }

      .intro,
      p,
      li {
        font-size: 1rem;
      }

      .grid,
      .info-grid,
      .link-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .section,
      .wide-section {
        margin-top: 58px;
      }

      .verdict-bar,
      .callout,
      .note {
        padding: 24px;
      }
    }
  </style>

  <main class="hub-page">
    <section class="hero">
      <div class="eyebrow">Medical Cost Calculators</div>

      <h1>Medical bills are not ordinary bills.</h1>

      <p class="intro">
        Healthcare costs can create financial pressure even when care is necessary.
        These calculators help compare medical bills, payment plans, emergency savings,
        insurance gaps, debt pressure, and monthly breathing room without treating
        healthcare like a luxury purchase.
      </p>

      <div class="inline-links">
        {internalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </section>

    <OmniStyleReviewBlock
      pageName="the medical calculators hub"
      pageType="calculator hub"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="medical bills, dental costs, payment plans, insurance exposure, deductible, out-of-pocket cost, savings, debt, emergency fund, and healthcare budget pressure"
    />

    <CorePageExamplesBlock
      title="Medical calculator examples"
      intro="Medical-cost calculators should help organize affordability pressure, not replace insurance, billing, medical, or legal advice."
      useCases={[
          "You need a calculator for medical or dental cost pressure.",
          "You want to compare bills, payment plans, savings, debt, and insurance exposure.",
          "You need to understand whether a healthcare cost fits your budget."
        ]}
      notEnough={[
          "You need medical, insurance, legal, billing, or benefits advice.",
          "You need help choosing treatment.",
          "You are handling a medical emergency."
        ]}
      examples={[
          {
            label: "Payment plan decision",
            takeaway: "Monthly terms matter as much as the total bill."
          },
          {
            label: "High deductible exposure",
            takeaway: "Savings should be compared with likely out-of-pocket cost."
          },
          {
            label: "Debt-funded care",
            takeaway: "Pressure is higher when high-interest credit is required."
          }
        ]}
      commonMistake="Treating the bill as final before asking for itemization, insurance review, or payment options."
      nextStep="Use the relevant calculator after confirming the bill or estimated out-of-pocket cost."
    />



    <section id="HubReview" class="callout">
      <div class="eyebrow">Review status</div>
      <h2>Medical calculator hub reviewed for clear assumptions, practical examples, and useful limits.</h2>

      <p>
        <strong>Written and maintained by Dustin Baker.</strong> Last reviewed: July 2026.
        This hub is part of the ShouldISpend calculator library and is reviewed for calculation accuracy, working links, practical examples, and clear limitations.
      </p>

      <p>
        These calculators are educational pressure tests. They help readers compare
        medical bills, dental work, treatment costs, payment plans, insurance gaps, and emergency savings against take-home income, savings, debt, outside help, monthly
        breathing room, and recovery risk. They are not personalized financial, legal,
        tax, medical, insurance, or investment advice.
      </p>

      <p>
        For more context, review the <a href="/methodology/">Methodology</a>,
        <a href="/editorial-policy/">Editorial Policy</a>, and
        <a href="/disclaimer/">Disclaimer</a>.
      </p>
    </section>

    <section id="CrawlableHubExamples" class="wide-section">
      <div class="eyebrow">Worked examples</div>
      <h2>Examples this hub is meant to help pressure-test</h2>

      <p>
        These examples are visible before anyone uses a form. They show how the same
        category can produce very different pressure depending on savings, income,
        debt, outside help, urgency, and whether the decision creates a recurring bill.
      </p>

      <ul class="check-list">
        <li>$8,000 medical bill with no emergency fund and a high-interest payment option.</li>
        <li>$5,000 dental work partly covered by insurance with the uncovered cost paid from savings.</li>
        <li>A medical payment plan that protects cash flow versus a credit card balance with high interest.</li>
        <li>A necessary treatment where the goal is reducing damage, not pretending the expense is optional.</li>
      </ul>
    </section>

    <section id="HubLimits" class="section">
      <div class="eyebrow">When this hub is not enough</div>
      <h2>Use the calculators as a starting point, not the final word.</h2>

      <p>
        A calculator can clarify pressure, but it cannot know every detail of a household.
        Slow down before relying on a result alone when the decision involves legal
        obligations, taxes, medical treatment, insurance disputes, unstable income,
        major debt, family obligations, or a situation where the lowest-cost option
        could create larger harm later.
      </p>
    </section>


    <section class="wide-section">
      <div class="eyebrow">Start here</div>
      <h2>Common medical cost decisions</h2>

      <div class="link-grid">
        {featuredMedicalLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    {medicalCalculators.length > 0 && (
      <section class="wide-section">
        <div class="eyebrow">All medical calculators</div>
        <h2>Medical bill and healthcare affordability calculators</h2>

        <p>
          Use these tools to compare medical bills, insurance gaps, payment plans,
          emergency savings use, debt pressure, and the household budget after care.
        </p>

        <div class="grid">
          {medicalCalculators.map((calculator) => (
            <CalculatorCard
              category={calculator.category}
              title={calculator.title}
              description={calculator.description}
              href={calculator.href}
            />
          ))}
        </div>
      </section>
    )}

    <div class="verdict-bar">
      <div class="verdict-label">Healthcare affordability</div>

      <h2>The goal is to protect both your health and your financial stability.</h2>

      <p>
        Medical spending should be evaluated differently from optional purchases.
        Some care cannot wait. Some bills can be negotiated, appealed, financed,
        or planned around. The safest decision usually balances medical necessity
        with a realistic path back to stability.
      </p>
    </div>

    <section class="section">
      <div class="eyebrow">Decision framework</div>
      <h2>What medical affordability really means</h2>

      <p>
        A medical expense can be technically payable and still create real pressure
        if it drains emergency savings, adds high-interest debt, or leaves too little
        room for rent, groceries, transportation, childcare, insurance premiums, or
        normal monthly expenses.
      </p>

      <p>
        The bill matters, but so does the timing, urgency, insurance coverage, payment
        plan, savings cushion, existing debt, and what happens if care is delayed.
      </p>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Cost factors</div>
      <h2>What can change the real cost of medical care</h2>

      <div class="info-grid">
        {medicalCostFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Lower the pressure</div>
      <h2>Ways to make a medical bill safer</h2>

      <div class="info-grid">
        {reduceCostTips.map((tip) => (
          <div class="info-card">
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="eyebrow">Warning signs</div>
      <h2>Medical bill red flags</h2>

      <p>
        These signs do not mean you should skip care. They mean the payment plan,
        bill, provider, or timing deserves a closer look.
      </p>

      <ul class="red-flag-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="eyebrow">When spending makes sense</div>
      <h2>Necessary care can still be the right decision.</h2>

      <p>
        Medical spending can make sense even when the number feels uncomfortable.
        Treatment, pain reduction, mobility, fertility care, emergency care, dental
        work, therapy, hearing aids, vision procedures, and prescriptions may protect
        quality of life or prevent larger problems later.
      </p>

      <p>
        The strongest medical spending decisions usually have clear medical value,
        a verified bill, a realistic payment plan, and enough remaining cushion to
        keep the household stable after treatment.
      </p>
    </section>

    <section class="section">
      <div class="eyebrow">Assumptions</div>
      <h2>How these calculators think about medical costs</h2>

      <p>
        These assumptions help keep the medical calculator cluster consistent.
      </p>

      <ul class="check-list">
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Related tools</div>
      <h2>Other calculators that connect to medical bills</h2>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>
            <span>{guide.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="callout dark-callout">
      <div class="eyebrow">Use these as pressure tests</div>

      <h2>A medical bill result is not a medical recommendation.</h2>

      <p>
        ShouldISpend medical calculators are educational tools for financial
        decision support. They do not replace a doctor, insurer, hospital billing
        office, financial advisor, attorney, or other qualified professional.
      </p>
    </section>

    <FAQSection title="Medical Cost FAQ" faqs={medicalFaqs} />
  </main>
</Layout>
