---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import MethodologySection from "../components/MethodologySection.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import { calculators } from "../data/calculators.js";

const medicalCalculators = calculators.filter(
  (calculator) => calculator.category === "Medical"
);

const medicalFaqs = [
  {
    question: "Should I use emergency savings for medical bills?",
    answer:
      "Emergency savings are often intended for unavoidable expenses like medical costs, especially when delaying treatment creates greater risk. The key question is whether the bill leaves enough cushion afterward.",
  },
  {
    question: "Should I go into debt for medical treatment?",
    answer:
      "Necessary care may still be worth pursuing even if a payment plan or debt is required. The goal is to avoid skipped care while limiting high-interest debt and long-term monthly pressure.",
  },
  {
    question: "Do payment plans make medical bills safer?",
    answer:
      "Payment plans can reduce immediate pressure, but they still affect monthly flexibility, savings growth, and household debt load over time.",
  },
  {
    question: "Should I delay medical care because of cost?",
    answer:
      "That depends on the urgency and medical necessity. Some care can safely wait while savings improve, but delaying important treatment may increase both health risk and future financial risk.",
  },
  {
    question: "What matters most when comparing medical costs?",
    answer:
      "The biggest factors are urgency, insurance coverage, out-of-pocket maximums, emergency savings, payment plan terms, existing debt, monthly income, and whether delaying care could make the problem worse.",
  },
];

const relatedGuides = [
  {
    title: "How Much Emergency Savings Should I Have?",
    href: "/how-much-emergency-savings-should-i-have",
    description:
      "Learn how emergency savings affect medical flexibility, financial pressure, and recovery from unexpected expenses.",
  },
  {
    title: "How Much Debt Is Too Much?",
    href: "/how-much-debt-is-too-much",
    description:
      "Understand how recurring debt obligations affect monthly breathing room and financial stability.",
  },
  {
    title: "What Counts as Debt?",
    href: "/what-counts-as-debt",
    description:
      "See which financial obligations should be included when evaluating affordability and monthly pressure.",
  },
  {
    title: "Should I Use Emergency Savings for Medical Bills?",
    href: "/should-i-use-emergency-savings-for-medical-bills",
    description:
      "Decide whether using savings for healthcare protects your finances or leaves too little cushion.",
  },
  {
    title: "Medical Bill Payment Plan Calculator",
    href: "/medical-bill-payment-plan-calculator",
    description:
      "Estimate whether a monthly medical payment plan fits your income, savings, debt, and budget flexibility.",
  },
  {
    title: "Should I Spend This Much on Medical Bills?",
    href: "/should-i-spend-this-much-on-medical-bills",
    description:
      "Pressure-test a medical bill against savings, income, urgency, debt, and monthly recovery power.",
  },
];

const relatedMedicalCalculators = medicalCalculators
  .filter((calculator) => calculator.href !== "/medical-calculators")
  .slice(0, 8);
---

<Layout
  title="Medical Cost Calculators | Medical Bills and Healthcare Affordability"
  description="Evaluate medical bills, payment plans, emergency savings, healthcare affordability, insurance gaps, debt pressure, and monthly financial flexibility."
>
  <style>
    .container {
      width: 92%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 72px 0;
    }

    .hero {
      max-width: 900px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(2.8rem, 6vw, 5rem);
      line-height: 1;
      margin: 0 0 24px;
      color: var(--primary);
    }

    .hero p {
      font-size: 1.1rem;
      line-height: 1.85;
      color: var(--muted);
      max-width: 860px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-top: 36px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 28px;
    }

    .section {
      margin-top: 72px;
      max-width: 900px;
    }

    .section.full {
      max-width: none;
    }

    .section-kicker {
      color: var(--primary);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.76rem;
      margin-bottom: 12px;
    }

    .section h2 {
      font-size: 2rem;
      margin-bottom: 22px;
      line-height: 1.2;
      color: var(--text);
    }

    .section p {
      line-height: 1.9;
      color: var(--muted);
      margin-bottom: 24px;
      font-size: 1.05rem;
    }

    .verdict-bar {
      margin-top: 56px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 32px;
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .verdict-bar h2 {
      margin: 0 0 16px;
      font-size: 2rem;
      color: var(--text);
      line-height: 1.2;
    }

    .verdict-bar p {
      margin: 0;
      line-height: 1.85;
      color: var(--muted);
    }

    .info-card,
    .link-card {
      display: block;
      border: 1px solid var(--border);
      background: white;
      border-radius: 20px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .info-card h3,
    .link-card strong {
      display: block;
      margin-bottom: 10px;
      color: var(--text);
      line-height: 1.3;
    }

    .info-card p,
    .link-card span {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    @media (max-width: 720px) {
      .container {
        padding: 56px 0;
      }

      h1 {
        font-size: 2.9rem;
      }

      .hero p {
        font-size: 1rem;
      }

      .section h2,
      .verdict-bar h2 {
        font-size: 1.7rem;
      }

      .grid,
      .info-grid,
      .link-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main class="container">
    <section class="hero">
      <div class="eyebrow">Medical Cost Calculators</div>

      <h1>Medical Cost Calculators and Healthcare Affordability Tools</h1>

      <p>
        Medical costs can create financial pressure even when treatment is
        necessary. These calculators evaluate healthcare spending using income,
        savings, debt pressure, insurance gaps, payment plans, emergency
        reserves, and monthly flexibility instead of looking at the bill alone.
      </p>
    </section>

    <div class="grid">
      {medicalCalculators.map((calculator) => (
        <CalculatorCard
          category={calculator.category}
          title={calculator.title}
          description={calculator.description}
          href={calculator.href}
        />
      ))}
    </div>

    <div class="verdict-bar">
      <div class="verdict-label">Healthcare Affordability</div>

      <h2>
        A medical bill becomes financially dangerous when it weakens long-term
        stability after treatment.
      </h2>

      <p>
        Medical spending should be evaluated differently than luxury purchases
        because healthcare is often unavoidable. The goal is not simply avoiding
        spending. It is protecting both health and long-term financial
        flexibility at the same time.
      </p>
    </div>

    <section class="section">
      <div class="section-kicker">Decision Framework</div>

      <h2>What Medical Affordability Really Means</h2>

      <p>
        A medical expense can be technically affordable and still create major
        financial pressure if it drains emergency savings, increases
        high-interest debt, or leaves little room for rent, groceries,
        transportation, childcare, insurance premiums, or normal monthly
        expenses afterward.
      </p>

      <p>
        Healthcare affordability depends on more than the invoice. Insurance
        coverage, deductibles, out-of-network risk, payment plan terms, income
        stability, existing debt, emergency savings, and the urgency of care all
        matter. A $2,500 bill can be manageable for one household and
        destabilizing for another.
      </p>

      <p>
        Some treatments are unavoidable, which makes medical affordability
        different from travel, weddings, or luxury spending. The safest approach
        is usually the one that balances medical necessity with long-term
        financial survivability.
      </p>
    </section>

    <section class="section full">
      <div class="section-kicker">Pressure Factors</div>

      <h2>Financial Pressure Factors in Medical Spending</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Emergency Savings</h3>
          <p>
            Emergency savings can reduce the need for high-interest borrowing
            after unexpected healthcare costs.
          </p>
        </div>

        <div class="info-card">
          <h3>Insurance Gaps</h3>
          <p>
            Deductibles, out-of-network costs, coinsurance, denied claims, and
            uncovered procedures can dramatically change affordability.
          </p>
        </div>

        <div class="info-card">
          <h3>Payment Plans</h3>
          <p>
            Monthly medical payments still affect long-term flexibility even if
            they reduce short-term pressure.
          </p>
        </div>

        <div class="info-card">
          <h3>Debt Load</h3>
          <p>
            Existing debt obligations can make otherwise manageable healthcare
            costs much harder to absorb.
          </p>
        </div>

        <div class="info-card">
          <h3>Income Stability</h3>
          <p>
            Stable income generally reduces medical financial risk compared with
            irregular or uncertain earnings.
          </p>
        </div>

        <div class="info-card">
          <h3>Recovery Timeline</h3>
          <p>
            The safest financial decisions usually leave a realistic path to
            rebuilding savings afterward.
          </p>
        </div>
      </div>
    </section>

    <KeyCostCategories
      items={[
        {
          title: "Out-of-pocket cost",
          description:
            "The real bill depends on deductibles, coinsurance, copays, out-of-network charges, denied claims, and uncovered services.",
        },
        {
          title: "Emergency savings",
          description:
            "Savings can make medical care easier to handle, but the remaining cushion matters after the bill is paid.",
        },
        {
          title: "Payment plan terms",
          description:
            "A payment plan can reduce immediate pain, but it still competes with rent, groceries, transportation, childcare, and other obligations.",
        },
        {
          title: "Existing debt",
          description:
            "Credit cards, car loans, personal loans, and other monthly payments affect whether a medical bill is manageable.",
        },
        {
          title: "Medical urgency",
          description:
            "Necessary or time-sensitive care should be judged differently from optional, cosmetic, or easily delayed care.",
        },
      ]}
    />

    <ReduceCostTips
      items={[
        "Ask for an itemized bill before paying a large medical charge.",
        "Check whether the provider offers financial assistance, charity care, or income-based discounts.",
        "Confirm whether the provider is in-network before scheduling non-emergency care.",
        "Ask whether a no-interest payment plan is available before using a credit card.",
        "Compare cash-pay prices when insurance does not meaningfully reduce the cost.",
        "Avoid draining emergency savings completely unless the care is urgent and unavoidable.",
      ]}
    />

    <FinancialRedFlags
      items={[
        "The bill would wipe out emergency savings with no realistic plan to rebuild them.",
        "The payment plan would make rent, groceries, transportation, or childcare difficult to cover.",
        "The provider is out of network and the final bill is uncertain.",
        "The plan depends on a high-interest credit card instead of a lower-pressure payment option.",
        "Optional treatment is being financed while other essential bills are already strained.",
        "The household is ignoring insurance appeals, itemized billing errors, or financial assistance options.",
      ]}
    />

    <CalculatorAssumptions
      items={[
        "Monthly income means take-home pay, not gross income.",
        "Medical affordability depends on both the bill amount and the household's ability to recover afterward.",
        "Emergency savings are useful for medical costs, but they should not be drained casually.",
        "No-interest payment plans are generally less risky than high-interest credit card debt.",
        "Necessary medical care may still be worth pursuing even when the financial pressure is real.",
        "These calculators are educational tools and do not replace medical, insurance, legal, or financial advice.",
      ]}
    />

    <section class="section">
      <div class="section-kicker">When Spending Makes Sense</div>

      <h2>When Medical Spending Can Be the Right Decision</h2>

      <p>
        Medical spending can make sense even when the number feels uncomfortable.
        Necessary treatment, pain reduction, mobility, fertility care,
        emergency care, dental work, therapy, hearing aids, and vision
        procedures may protect quality of life or prevent larger problems later.
      </p>

      <p>
        The strongest medical spending decisions usually have clear medical
        value, a verified bill, a realistic payment plan, and enough remaining
        cushion to keep the household stable after treatment.
      </p>
    </section>

    <section class="section">
      <div class="section-kicker">Related Guides</div>

      <h2>Related Medical and Financial Pressure Guides</h2>

      <p>
        Medical bills rarely happen in isolation. These related pages help
        connect healthcare costs with emergency savings, existing debt, payment
        pressure, and monthly financial flexibility.
      </p>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>
            <span>{guide.description}</span>
          </a>
        ))}
      </div>
    </section>

    <FAQSection title="Medical Cost FAQ" faqs={medicalFaqs} />

    <div class="section full">
      <RelatedCalculators calculators={relatedMedicalCalculators} />
    </div>
  </main>

  <MethodologySection category="medical cost affordability" updated="June 2026" />
</Layout>