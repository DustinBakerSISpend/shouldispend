---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const medicalCalculators = calculators.filter(
  (calculator) => calculator.category === "Medical"
);

const medicalFaqs = [
  {
    question: "Should I use emergency savings for medical bills?",
    answer:
      "Emergency savings are often intended for unavoidable expenses like medical costs, especially when delaying treatment creates greater risk. The key question is whether the bill creates long-term financial pressure afterward.",
  },
  {
    question: "Should I go into debt for medical treatment?",
    answer:
      "Necessary medical care may still be worth pursuing even if payment plans or debt are required. The goal is to reduce long-term pressure while avoiding skipped care that could create larger problems later.",
  },
  {
    question: "Do payment plans make medical bills safer?",
    answer:
      "Payment plans can reduce immediate pressure, but they still affect monthly flexibility, savings growth, and debt load over time.",
  },
  {
    question: "Should I delay medical care because of cost?",
    answer:
      "That depends on the urgency and medical necessity. Some care can safely wait while savings improve, but delaying important treatment may increase financial and health risk later.",
  },
];

const relatedGuides = [
  {
    title: "How Much Emergency Savings Should I Have?",
    href: "/how-much-emergency-savings-should-i-have",
    description:
      "Learn how emergency savings affect medical flexibility, financial pressure, and recovery from unexpected expenses.",
  },
  {
    title: "How Much Debt Is Too Much?",
    href: "/how-much-debt-is-too-much",
    description:
      "Understand how recurring debt obligations affect monthly breathing room and financial stability.",
  },
  {
    title: "What Counts as Debt?",
    href: "/what-counts-as-debt",
    description:
      "See which financial obligations should be included when evaluating affordability and monthly pressure.",
  },
  {
    title: "Budget Rule Calculators",
    href: "/budget-rule-calculators",
    description:
      "Compare spending decisions against income, savings, debt, and overall financial flexibility.",
  },
];
---

<Layout
  title="Medical Cost Calculators | Medical Bills and Healthcare Affordability"
  description="Evaluate medical bills, payment plans, healthcare affordability, emergency savings, debt pressure, and monthly financial flexibility."
>
  <style>
    .container {
      width: 92%;
      max-width: 1100px;
      margin: 0 auto;
      padding: 72px 0;
    }

    .hero {
      max-width: 860px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(2.8rem, 6vw, 5rem);
      line-height: 1;
      margin-bottom: 24px;
      color: var(--primary);
    }

    .hero p {
      font-size: 1.1rem;
      line-height: 1.85;
      color: var(--muted);
      max-width: 820px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-top: 36px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 28px;
    }

    .section {
      margin-top: 72px;
      max-width: 860px;
    }

    .section h2 {
      font-size: 2rem;
      margin-bottom: 22px;
      line-height: 1.2;
      color: var(--text);
    }

    .section p {
      line-height: 1.9;
      color: var(--muted);
      margin-bottom: 24px;
      font-size: 1.05rem;
    }

    .verdict-bar {
      margin-top: 56px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 32px;
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .verdict-bar h2 {
      margin: 0 0 16px;
      font-size: 2rem;
      color: var(--text);
      line-height: 1.2;
    }

    .verdict-bar p {
      margin: 0;
      line-height: 1.85;
      color: var(--muted);
    }

    .info-card,
    .link-card {
      display: block;
      border: 1px solid var(--border);
      background: white;
      border-radius: 20px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .info-card h3,
    .link-card strong {
      display: block;
      margin-bottom: 10px;
      color: var(--text);
      line-height: 1.3;
    }

    .info-card p,
    .link-card span {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    @media (max-width: 720px) {
      .container {
        padding: 56px 0;
      }

      h1 {
        font-size: 2.9rem;
      }

      .hero p {
        font-size: 1rem;
      }

      .section h2,
      .verdict-bar h2 {
        font-size: 1.7rem;
      }
    }
  </style>

  <main class="container">
    <section class="hero">
      <div class="eyebrow">Medical Cost Calculators</div>

      <h1>Medical Cost Calculators and Healthcare Affordability Tools</h1>

      <p>
        Medical costs can create financial pressure even when treatment is
        necessary. These calculators evaluate healthcare spending using income,
        savings, debt pressure, insurance gaps, payment plans, and monthly
        flexibility instead of looking at the bill alone.
      </p>
    </section>

    <div class="grid">
      {medicalCalculators.map((calculator) => (
        <CalculatorCard
          category={calculator.category}
          title={calculator.title}
          description={calculator.description}
          href={calculator.href}
        />
      ))}
    </div>

    <div class="verdict-bar">
      <div class="verdict-label">Healthcare Affordability</div>

      <h2>
        A medical bill becomes financially dangerous when it weakens long-term
        stability after treatment.
      </h2>

      <p>
        Medical spending should be evaluated differently than luxury purchases
        because healthcare is often unavoidable. The goal is not simply avoiding
        spending — it is protecting both health and long-term financial
        flexibility at the same time.
      </p>
    </div>

    <section class="section">
      <h2>What Medical Affordability Really Means</h2>

      <p>
        A medical expense can be technically affordable and still create major
        financial pressure if it drains emergency savings, increases high-interest
        debt, or leaves little room for rent, groceries, transportation, or
        normal monthly expenses afterward.
      </p>

      <p>
        Healthcare affordability depends on emergency savings, insurance quality,
        household income, payment plans, debt obligations, and how quickly the
        household can realistically recover financially after the expense.
      </p>

      <p>
        Some treatments are unavoidable, which makes medical affordability
        different from travel, weddings, or luxury spending. The safest approach
        is usually the one that balances medical necessity with long-term
        financial survivability.
      </p>
    </section>

    <section class="section">
      <h2>Financial Pressure Factors in Medical Spending</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>Emergency Savings</h3>

          <p>
            Emergency savings can reduce the need for high-interest borrowing
            after unexpected healthcare costs.
          </p>
        </div>

        <div class="info-card">
          <h3>Insurance Gaps</h3>

          <p>
            Deductibles, out-of-network costs, coinsurance, and uncovered
            procedures can dramatically change affordability.
          </p>
        </div>

        <div class="info-card">
          <h3>Payment Plans</h3>

          <p>
            Monthly medical payments still affect long-term flexibility even if
            they reduce short-term pressure.
          </p>
        </div>

        <div class="info-card">
          <h3>Debt Load</h3>

          <p>
            Existing debt obligations can make otherwise manageable healthcare
            costs much harder to absorb.
          </p>
        </div>

        <div class="info-card">
          <h3>Income Stability</h3>

          <p>
            Stable income generally reduces medical financial risk compared to
            irregular or uncertain earnings.
          </p>
        </div>

        <div class="info-card">
          <h3>Recovery Timeline</h3>

          <p>
            The safest financial decisions usually leave a realistic path to
            rebuilding savings afterward.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>Related Financial Pressure Guides</h2>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>

            <span>{guide.description}</span>
          </a>
        ))}
      </div>
    </section>

    <FAQSection title="Medical Cost FAQ" faqs={medicalFaqs} />
  </main>
</Layout>