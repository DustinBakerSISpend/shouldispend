---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
---

<Layout
  title="Should I Use Emergency Savings for Dental Work?"
  description="Decide whether using emergency savings for dental work is financially safe based on savings left, treatment urgency, income stability, debt pressure, and payment options."
>
  <style>
    .container { max-width: 950px; margin: 0 auto; padding: 60px 20px; }
    .content-section { max-width: 760px; margin: 72px auto 0; }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 28px; padding: 34px; }
    h2 { margin-top: 0; font-size: 2rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 22px; margin-bottom: 28px; }
    label { display: block; margin-bottom: 10px; font-weight: 700; }
    input, select { width: 100%; padding: 18px; border-radius: 14px; border: 1px solid var(--border); font-size: 1.1rem; box-sizing: border-box; background: white; }
    button { background: #0f172a; color: white; border: none; padding: 16px 28px; border-radius: 14px; font-size: 1rem; font-weight: 700; cursor: pointer; margin-top: 10px; width: 100%; display: block; }
    button:hover { opacity: 0.92; }
    .result { margin-top: 40px; border: 1px solid var(--border); border-radius: 24px; padding: 28px; display: none; background: #f8fafc; }
    .score { font-size: 3rem; font-weight: 800; margin-bottom: 16px; }
    .bar { width: 100%; height: 16px; background: #dbe3ee; border-radius: 999px; overflow: hidden; margin-bottom: 24px; }
    .fill { height: 100%; width: 0%; background: #16a34a; border-radius: 999px; transition: width 0.4s ease; }
    .metric { margin-bottom: 14px; font-size: 1.05rem; }
    .guidance { margin-top: 26px; font-size: 1.15rem; line-height: 1.7; }
    .disclaimer { margin-top: 30px; font-size: 0.9rem; color: var(--muted); }
    .content-section p, .content-section li { line-height: 1.8; }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Dental Emergency Savings Calculator"
      title="Should I Use Emergency Savings for Dental Work?"
      description="Estimate whether using emergency savings for dental treatment protects your health and finances or leaves your household exposed afterward."
    >
      <div class="card">
        <h2>Dental Savings Pressure Verdict</h2>

        <div class="grid">
          <div>
            <label for="billAmount">Dental Work Cost</label>
            <input id="billAmount" type="number" placeholder="5000" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="savingsAmount">Current Emergency Savings</label>
            <input id="savingsAmount" type="number" placeholder="15000" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="monthlyIncome">Monthly Take-Home Income</label>
            <input id="monthlyIncome" type="number" placeholder="7000" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="monthlyExpenses">Monthly Essential Expenses</label>
            <input id="monthlyExpenses" type="number" placeholder="4000" min="0" inputmode="decimal" />
          </div>

          <div>
            <label for="debtPressure">Debt Pressure</label>
            <select id="debtPressure">
              <option value="low">Low</option>
              <option value="moderate">Moderate</option>
              <option value="high">High</option>
            </select>
          </div>

          <div>
            <label for="incomeStability">Income Stability</label>
            <select id="incomeStability">
              <option value="stable">Stable</option>
              <option value="average">Average</option>
              <option value="unstable">Unstable</option>
            </select>
          </div>

          <div>
            <label for="paymentPlan">Dental Payment Plan Available?</label>
            <select id="paymentPlan">
              <option value="yes">Yes</option>
              <option value="no">No</option>
            </select>
          </div>

          <div>
            <label for="urgency">Dental Treatment Urgency</label>
            <select id="urgency">
              <option value="necessary">Necessary / Time-Sensitive</option>
              <option value="unclear">Unclear</option>
              <option value="flexible">Can Safely Wait</option>
            </select>
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="dentalSavingsButton" type="button">
          Evaluate Emergency Savings Decision
        </button>

        <div class="result" id="result">
          <div class="score" id="score"></div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="stress"></div>
          <div class="metric" id="remainingSavings"></div>
          <div class="metric" id="monthsRemaining"></div>
          <div class="metric" id="billShare"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not dental, medical, insurance, legal, or financial advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <h2>When Using Emergency Savings for Dental Work Makes Sense</h2>

        <p>
          Emergency savings can be appropriate for dental work when the treatment protects health, prevents worsening pain, or avoids a more expensive problem later. A root canal, implant repair, infection-related care, extraction, crown, or urgent restorative procedure may be exactly the kind of expense an emergency fund exists to handle.
        </p>

        <p>
          The risk is using so much cash that your household becomes exposed afterward. A dental bill can be medically important and still require a careful payment strategy if it drains most of your savings.
        </p>
      </div>

      <WhenSpendingMakesSense
        title="When Using Savings Is Reasonable"
        items={[
          "The dental work is urgent, painful, infection-related, or likely to become more expensive if delayed.",
          "You have a written treatment plan that separates urgent work from optional work.",
          "You still keep a meaningful emergency cushion afterward.",
          "Using savings helps you avoid high-interest dental financing or credit card debt.",
          "Your normal monthly cash flow remains stable after the payment.",
        ]}
      />

      <div class="content-section">
        <h2>When to Slow Down Before Draining Savings</h2>

        <p>
          You may want to slow down if the treatment plan is unclear, the dental office is pushing financing quickly, insurance has not been confirmed, or the work includes cosmetic or optional procedures mixed with urgent care.
        </p>

        <p>
          A safer approach is to confirm the diagnosis, ask what must happen now, compare whether the work can be phased, and decide whether to pay all cash, partial cash, or use a low-cost payment plan.
        </p>
      </div>

      <KeyCostCategories
        items={[
          {
            title: "Remaining emergency cushion",
            description:
              "The biggest factor is how much cash remains after the dental work is paid.",
          },
          {
            title: "Treatment urgency",
            description:
              "Pain, infection, chewing function, broken teeth, and worsening dental problems should be treated differently than cosmetic upgrades.",
          },
          {
            title: "Insurance and annual maximums",
            description:
              "Dental insurance often has caps, waiting periods, exclusions, and partial coverage rules that can affect timing.",
          },
          {
            title: "Payment plan alternatives",
            description:
              "A no-interest dental payment plan may preserve cash, but the monthly payment still needs to fit your budget.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Ask for an itemized dental treatment plan before paying.",
          "Separate urgent dental work from optional or cosmetic treatment.",
          "Confirm dental insurance coverage, annual maximums, and waiting periods.",
          "Ask whether treatment can be phased across months or benefit years.",
          "Compare a second opinion if the work is not urgent.",
          "Use HSA or FSA funds when available.",
          "Avoid deferred-interest financing unless payoff is extremely realistic.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "The dental bill would use nearly all available emergency savings.",
          "The office cannot clearly explain which procedures are urgent.",
          "You are being pushed into same-day financing before reviewing the treatment plan.",
          "You would need credit cards for groceries, rent, utilities, or transportation afterward.",
          "Insurance coverage, crown pricing, follow-up costs, or sedation fees are unclear.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "The calculator evaluates financial pressure, not dental necessity.",
          "Monthly income means take-home pay after taxes and payroll deductions.",
          "Monthly essential expenses include housing, food, utilities, transportation, insurance, childcare, and required bills.",
          "Emergency savings are treated as a household stability buffer, not idle cash.",
          "Very high income or very large savings can produce a true 0/100 pressure score when the dental bill is tiny relative to available resources.",
        ]}
      />

      <FAQSection
        title="Emergency Savings and Dental Work FAQ"
        faqs={[
          {
            question: "Should I use emergency savings for dental work?",
            answer:
              "It can make sense if the dental work is urgent, medically important, or likely to become more expensive if delayed. The key is whether enough emergency savings remains afterward.",
          },
          {
            question: "Is dental work an emergency fund expense?",
            answer:
              "Often, yes. Pain, infection, broken teeth, root canals, extractions, and necessary restorative work can qualify as legitimate emergency fund uses.",
          },
          {
            question: "Should I use savings or finance dental work?",
            answer:
              "Savings may be better than high-interest debt if you still keep a cushion afterward. A low-cost payment plan may be better if paying cash would drain your emergency fund.",
          },
          {
            question: "How much emergency savings should remain after dental work?",
            answer:
              "Many households should try to keep at least one month of essential expenses if possible, with three to six months being stronger. The right cushion depends on income stability, dependents, debt, and housing risk.",
          },
          {
            question: "Should I get a second opinion before using savings for dental work?",
            answer:
              "For expensive non-emergency dental work, yes. A second opinion can help confirm the diagnosis, compare costs, and identify whether the treatment can be phased.",
          },
        ]}
      />

      <MethodologySection category="medical spending" updated="May 2026" />

      <RelatedGuides
        guides={[
          {
            title: "Emergency Savings Calculator",
            href: "/how-much-emergency-savings-should-i-have",
            description:
              "Estimate how much emergency savings may be enough based on expenses, dependents, debt, and income stability.",
          },
          {
            title: "What Counts as Debt?",
            href: "/what-counts-as-debt",
            description:
              "Understand which obligations should be included when estimating household financial pressure.",
          },
        ]}
      />

      <RelatedCalculators
        calculators={[
          {
            category: "Medical",
            title: "Should I Spend $5,000 on Dental Work?",
            href: "/should-i-spend-5000-on-dental-work",
          },
          {
            category: "Medical",
            title: "Should I Spend $10,000 on Dental Work?",
            href: "/should-i-spend-10000-on-dental-work",
          },
          {
            category: "Medical",
            title: "Should I Spend $3,000 on a Root Canal?",
            href: "/should-i-spend-3000-on-a-root-canal",
          },
          {
            category: "Medical",
            title: "Browse Medical Calculators",
            href: "/medical-calculators",
          },
        ]}
      />
    </CalculatorPageShell>
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          color: "#16a34a",
          action:
            "Using savings may be reasonable after confirming the treatment plan, insurance coverage, and final out-of-pocket cost.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          color: "#ca8a04",
          action:
            "Use caution. Ask whether treatment can be phased, compare payment plans, and preserve emergency savings where possible.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        color: "#dc2626",
        action:
          "Avoid draining savings without reviewing the treatment plan, insurance coverage, second-opinion options, and safer payment terms.",
      };
    }

    function calculateDentalSavings() {
      const billAmount = getNumber("billAmount");
      const savingsAmount = getNumber("savingsAmount");
      const monthlyIncome = getNumber("monthlyIncome");
      const monthlyExpenses = getNumber("monthlyExpenses");

      const debtPressure = document.getElementById("debtPressure").value;
      const incomeStability = document.getElementById("incomeStability").value;
      const paymentPlan = document.getElementById("paymentPlan").value;
      const urgency = document.getElementById("urgency").value;

      const result = document.getElementById("result");
      const scoreEl = document.getElementById("score");
      const barFill = document.getElementById("barFill");
      const stressEl = document.getElementById("stress");
      const remainingSavingsEl = document.getElementById("remainingSavings");
      const monthsRemainingEl = document.getElementById("monthsRemaining");
      const billShareEl = document.getElementById("billShare");
      const guidanceEl = document.getElementById("guidance");

      result.style.display = "block";

      if (billAmount <= 0 || savingsAmount <= 0) {
        scoreEl.textContent = "Add your numbers first";
        barFill.style.width = "0%";
        barFill.style.background = "#16a34a";
        stressEl.innerHTML = "";
        remainingSavingsEl.innerHTML = "";
        monthsRemainingEl.innerHTML = "";
        billShareEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter a positive dental work cost and emergency savings balance so the calculator can estimate post-payment pressure.";
        return;
      }

      const remaining = savingsAmount - billAmount;

      const monthsLeft =
        monthlyExpenses > 0
          ? remaining / monthlyExpenses
          : remaining > 0
            ? 999
            : 0;

      const billToSavingsRatio =
        savingsAmount > 0 ? billAmount / savingsAmount : 999;

      const billToIncomeRatio =
        monthlyIncome > 0 ? billAmount / monthlyIncome : billAmount > 0 ? 999 : 0;

      const savingsAfterBillPositive = remaining > 0;

      const monthlySurplus = monthlyIncome - monthlyExpenses;

      const hasHugeSavingsBuffer =
        billAmount <= savingsAmount * 0.01 && savingsAfterBillPositive;

      const hasHugeIncomeBuffer =
        monthlyIncome > 0 &&
        billAmount <= monthlyIncome * 0.02 &&
        monthlySurplus > monthlyIncome * 0.45;

      const hasStrongSavingsBuffer =
        billAmount <= savingsAmount * 0.05 && savingsAfterBillPositive;

      const hasStrongIncomeBuffer =
        monthlyIncome > 0 &&
        billAmount <= monthlyIncome * 0.05 &&
        monthlySurplus > monthlyIncome * 0.3;

      let pressureScore = 0;

      if (hasHugeSavingsBuffer || hasHugeIncomeBuffer) {
        pressureScore = 0;
      } else {
        if (remaining < 0) pressureScore += 45;
        else if (monthsLeft < 1) pressureScore += 36;
        else if (monthsLeft < 3) pressureScore += 24;
        else if (monthsLeft < 6) pressureScore += 12;
        else if (monthsLeft >= 12) pressureScore -= 10;
        else if (monthsLeft >= 6) pressureScore -= 5;

        if (billToSavingsRatio >= 1) pressureScore += 24;
        else if (billToSavingsRatio >= 0.75) pressureScore += 18;
        else if (billToSavingsRatio >= 0.5) pressureScore += 12;
        else if (billToSavingsRatio >= 0.25) pressureScore += 6;

        if (billToIncomeRatio >= 1) pressureScore += 12;
        else if (billToIncomeRatio >= 0.5) pressureScore += 8;
        else if (billToIncomeRatio >= 0.25) pressureScore += 4;

        if (debtPressure === "moderate") pressureScore += 8;
        if (debtPressure === "high") pressureScore += 18;

        if (incomeStability === "average") pressureScore += 8;
        if (incomeStability === "unstable") pressureScore += 18;

        if (paymentPlan === "yes") pressureScore -= 6;
        if (paymentPlan === "no") pressureScore += 4;

        if (urgency === "necessary") pressureScore -= 6;
        if (urgency === "unclear") pressureScore += 5;
        if (urgency === "flexible") pressureScore += 10;

        if (hasStrongSavingsBuffer) pressureScore -= 14;
        if (hasStrongIncomeBuffer) pressureScore -= 10;

        if (
          billToSavingsRatio < 0.05 &&
          monthsLeft >= 12 &&
          debtPressure === "low" &&
          incomeStability === "stable"
        ) {
          pressureScore = Math.min(pressureScore, 10);
        }

        if (
          billToSavingsRatio < 0.01 &&
          monthsLeft >= 12 &&
          (monthlyIncome === 0 || billToIncomeRatio < 0.05)
        ) {
          pressureScore = 0;
        }
      }

      pressureScore = Math.round(clamp(pressureScore, 0, 100));

      const level = getPressureLevel(pressureScore);

      let guidance = "";

      if (pressureScore === 0) {
        guidance =
          `Using emergency savings for this dental work appears to create essentially no financial pressure based on the numbers entered. The dental cost uses only ${(billToSavingsRatio * 100).toFixed(2)}% of current savings, leaving a very large cushion afterward.`;
      } else if (pressureScore <= 30) {
        guidance =
          `Using savings appears manageable. After paying for the dental work, your emergency fund would cover about ${Math.max(monthsLeft, 0).toFixed(1)} months of essential expenses.`;
      } else if (pressureScore <= 60) {
        guidance =
          `Using savings may be workable, but it would noticeably reduce your cushion. Consider whether phasing treatment, using a partial payment plan, or paying only the urgent portion first would preserve more flexibility.`;
      } else {
        guidance =
          `Using savings could leave the household financially exposed. Before draining cash, ask for an itemized treatment plan, insurance confirmation, second-opinion options, and safer payment terms.`;
      }

      scoreEl.textContent = `${level.label}  -  ${pressureScore}/100`;
      scoreEl.style.color = level.color;
      barFill.style.width = `${pressureScore}%`;
      barFill.style.background = level.color;

      stressEl.innerHTML = `<strong>Pressure level:</strong> ${level.stress}`;
      remainingSavingsEl.innerHTML = `<strong>Emergency savings left after dental work:</strong> $${remaining.toLocaleString()}`;
      monthsRemainingEl.innerHTML = `<strong>Months of essential expenses remaining:</strong> ${
        monthsLeft >= 999 ? "Very high" : Math.max(monthsLeft, 0).toFixed(1)
      }`;
      billShareEl.innerHTML = `<strong>Dental cost as share of emergency savings:</strong> ${(billToSavingsRatio * 100).toFixed(2)}%`;
      guidanceEl.textContent = `${guidance} Recommended next step: ${level.action}`;
    }

    document
      .getElementById("dentalSavingsButton")
      .addEventListener("click", calculateDentalSavings);
  </script>
</Layout>
