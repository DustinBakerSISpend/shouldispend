---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
import { calculators } from "../data/calculators.js";

const studentLoanFaqs = [
  {
    question: "Should I take out student loans?",
    answer:
      "Student loans may make sense when the program has a clear career payoff, the loan payment fits future take-home income, and borrowing does not stack on top of already stressful debt.",
  },
  {
    question: "How much student loan debt is too much?",
    answer:
      "Student loan debt becomes riskier when expected payments crowd out rent, groceries, emergency savings, transportation, childcare, medical bills, or other essential costs after graduation.",
  },
  {
    question: "Is it better to use savings or student loans?",
    answer:
      "Using savings can reduce debt, but draining your emergency fund can create risk. A balanced approach may preserve emergency savings while limiting unnecessary borrowing.",
  },
  {
    question: "What if I do not know my future student loan payment?",
    answer:
      "You can estimate it, but do not ignore it. The monthly payment is one of the most important numbers because it determines whether the loan fits your post-school budget.",
  },
  {
    question: "When should I avoid student loans?",
    answer:
      "Avoid or reduce student loans when the program payoff is unclear, the payment would be too large for expected income, you already have heavy debt, or cheaper paths are available.",
  },
];

const keyCostCategories = [
  {
    title: "Tuition and fees",
    body:
      "The loan amount should include tuition, mandatory fees, lab fees, technology fees, program charges, and any costs that must be paid to stay enrolled.",
  },
  {
    title: "Housing and living costs",
    body:
      "Borrowing becomes riskier when loans are used to cover rent, food, transportation, or lifestyle costs that continue after graduation.",
  },
  {
    title: "Books, supplies, and equipment",
    body:
      "Laptops, books, uniforms, tools, testing fees, software, and certification materials can add thousands beyond tuition.",
  },
  {
    title: "Interest and repayment term",
    body:
      "The amount borrowed is not the full cost. Interest, fees, deferment, repayment length, and payment plan choices affect the real burden.",
  },
  {
    title: "Income interruption",
    body:
      "School may reduce work hours. Lost income during enrollment should be considered alongside the loan balance.",
  },
  {
    title: "Program payoff",
    body:
      "Borrowing is safer when the credential leads to a specific job, license, promotion, career switch, or income gain.",
  },
];

const reduceCostTips = [
  "Apply for grants, scholarships, employer tuition help, and state aid before borrowing.",
  "Compare community college, transfer paths, in-state options, online programs, and part-time enrollment.",
  "Borrow only what is needed for the program, not extra lifestyle spending.",
  "Estimate the monthly loan payment before accepting the loan.",
  "Compare the expected payment with realistic take-home income after graduation.",
  "Avoid borrowing heavily for a program with unclear completion or job outcomes.",
  "Use savings carefully, but do not drain the emergency fund just to avoid every dollar of debt.",
  "Consider working part-time, delaying enrollment, or reducing course load if it prevents high-risk borrowing.",
];

const financialRedFlags = [
  "The expected student loan payment would be hard to afford on realistic take-home income.",
  "The program does not have a clear job, promotion, license, or income path.",
  "You are borrowing mainly for living costs without a plan to control expenses.",
  "You already have high monthly debt payments before adding student loans.",
  "The loan depends on an income increase that is hopeful, not realistic.",
  "You have not compared lower-cost schools, transfer credits, grants, or employer help.",
  "The program may take longer than expected, increasing debt and delaying income.",
  "The loan would prevent emergency savings, rent stability, transportation, or childcare after graduation.",
];

const assumptions = [
  "Monthly income means expected take-home pay after school, not gross salary.",
  "Other debt means monthly debt payments expected after school, including car loans, credit cards, medical debt, and personal loans.",
  "Expected income gain means the extra monthly take-home income you reasonably expect because of the program.",
  "If no monthly loan payment is entered, the calculator estimates one as 1.2% of the expected loan balance.",
  "Program confidence is a judgment input based on job path, degree value, completion odds, and income visibility.",
  "The calculator estimates pressure, not whether education is personally meaningful.",
  "A pressure score of 0 is allowed when income, savings, debt, payment, and payoff numbers make the loan essentially harmless.",
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "College" &&
      calculator.href !== "/should-i-take-out-student-loans"
  )
  .slice(0, 4);
---

<Layout
  title="Should I Take Out Student Loans?"
  description="Evaluate whether student loans fit your future income, expected payment, current debt, savings cushion, career payoff, and long-term financial pressure."
>


  <style>
    .container { max-width: 980px; margin: auto; }
    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }
    .calculator h2,
    .content-section h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
      line-height: 1.2;
    }
    .calculator-intro,
    .content-section p,
    .content-section li {
      color: #334155;
      line-height: 1.9;
      font-size: 1.06rem;
    }
    .calculator-intro { margin-bottom: 30px; }
    .grid,
    .info-grid,
    .link-grid,
    .mini-grid {
      display: grid;
      gap: 20px;
    }
    .grid { grid-template-columns: 1fr 1fr; gap: 24px; }
    .info-grid,
    .link-grid,
    .mini-grid {
      grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
      margin-top: 28px;
    }
    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }
    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }
    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }
    .helper-link a,
    .content-link,
    a {
      color: #0f766e;
      font-weight: 800;
      text-decoration: none;
    }
    .helper-link a:hover,
    .content-link:hover,
    a:hover { text-decoration: underline; }
    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }
    button:hover { opacity: 0.92; }
    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }
    .results.visible { display: block; }
    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }
    .bar {
      width: 100%;
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }
    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }
    .fill.safe { background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%); }
    .fill.caution { background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%); }
    .fill.danger { background: linear-gradient(90deg, #dc2626 0%, #f97316 100%); }
    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }
    .result-details p { margin: 0 0 12px; }
    .guidance {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid #dbe4ee;
      font-size: 1.12rem;
      line-height: 1.85;
      color: #1e293b;
    }
    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }
    .content-section { margin-top: 68px; }
    .content-section h3 {
      color: #0f172a;
      line-height: 1.3;
      margin: 0 0 10px;
      font-size: 1.2rem;
    }
    .pillar-card,
    .info-card,
    .link-card,
    .mini-card,
    .callout,
    .table-wrap {
      display: block;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .pillar-card { margin-top: 20px; }
    .pillar-card:hover,
    .link-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
    }
    .pillar-card strong,
    .link-card strong {
      display: block;
      margin-bottom: 10px;
      color: #0f172a;
      font-size: 1.05rem;
    }
    .pillar-card span,
    .link-card span,
    .info-card p,
    .mini-card p {
      color: #334155;
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }
    .numbered-card { position: relative; padding-top: 48px; }
    .numbered-card .number {
      position: absolute;
      top: 20px;
      left: 22px;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      background: #ccfbf1;
      color: #115e59;
      font-weight: 950;
      display: grid;
      place-items: center;
      font-size: 0.86rem;
    }
    .callout { background: #f8fafc; margin-top: 28px; }
    .callout p { margin: 0; color: #0f172a; font-size: 1.08rem; }
    .warning-box { border-left: 5px solid #dc2626; }
    .decision-box { border-left: 5px solid #0f766e; }
    .table-wrap { overflow-x: auto; padding: 0; margin-top: 26px; }
    table { width: 100%; border-collapse: collapse; min-width: 720px; }
    th,
    td {
      text-align: left;
      padding: 16px;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: top;
      color: #334155;
      line-height: 1.55;
    }
    th {
      color: #0f172a;
      background: #f8fafc;
      font-size: 0.92rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    tr:last-child td { border-bottom: none; }
    .check-list,
    .red-list {
      list-style: none;
      padding-left: 0;
      display: grid;
      gap: 10px;
    }
    .check-list li,
    .red-list li {
      position: relative;
      padding-left: 30px;
      margin-bottom: 0;
    }
    .check-list li::before {
      content: "+";
      position: absolute;
      left: 0;
      top: 0;
      color: #0f766e;
      font-weight: 950;
    }
    .red-list li::before {
      content: "!";
      position: absolute;
      left: 0;
      top: 5px;
      width: 18px;
      height: 18px;
      border-radius: 999px;
      display: grid;
      place-items: center;
      background: #fee2e2;
      color: #b91c1c;
      font-weight: 950;
      font-size: 0.8rem;
      line-height: 1;
    }
    @media (max-width: 768px) {
      .calculator { padding: 24px; }
      .grid { grid-template-columns: 1fr; }
      .calculator h2,
      .content-section h2 { font-size: 1.7rem; }
      .results { padding: 24px; }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Student Loan Calculator"
      title="Should I Take Out Student Loans?"
      description="Pressure-test student loan borrowing against future income, monthly payment, existing debt, emergency savings, career payoff, and the risk of starting repayment with too little flexibility."
    >
      <div class="calculator">
        <h2>Student Loan Pressure Verdict</h2>

        <p class="calculator-intro">
          Enter your expected loan amount, monthly take-home income after school,
          savings, current debt payments, and expected income gain. This
          calculator estimates whether student loans look manageable, worth
          caution, or too stressful for your future budget.
        </p>

        <div class="grid">
          <div class="field">
            <label for="futureIncome">Expected Monthly Take-Home Income After School</label>
            <input id="futureIncome" type="number" placeholder="Example: 5200" />
          </div>

          <div class="field">
            <label for="savings">Current Savings</label>
            <input id="savings" type="number" placeholder="Example: 12000" />
          </div>

          <div class="field">
            <label for="loanAmount">Total Student Loans You Expect to Borrow</label>
            <input id="loanAmount" type="number" placeholder="Example: 25000" />
          </div>

          <div class="field">
            <label for="loanPayment">Expected Monthly Student Loan Payment</label>
            <input id="loanPayment" type="number" placeholder="Example: 300" />

            <div class="helper-link">
              Don't know the payment? Leave blank and this calculator will estimate one.
            </div>
          </div>

          <div class="field">
            <label for="currentDebt">Other Monthly Debt Payments After School</label>
            <input id="currentDebt" type="number" placeholder="Example: 600" />

            <div class="helper-link">
              Not sure what counts as debt?
              <a href="/what-counts-as-debt/">Read the debt guide</a>
            </div>
          </div>

          <div class="field">
            <label for="incomeGain">Expected Monthly Income Gain From the Program</label>
            <input id="incomeGain" type="number" placeholder="Example: 900" />
          </div>

          <div class="field">
            <label for="programStrength">Program Confidence</label>
            <select id="programStrength">
              <option value="strong">Strong job or income path</option>
              <option value="medium" selected>Some career upside</option>
              <option value="weak">Unclear payoff</option>
            </select>
          </div>

          <div class="field">
            <label for="years">Years Until Program Is Finished</label>
            <input id="years" type="number" placeholder="Example: 2" />
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="loanButton" type="button">Get Student Loan Verdict</button>

        <div class="results" id="results">
          <div class="score" id="scoreText"></div>

          <div class="bar">
            <div class="fill" id="fillBar"></div>
          </div>

          <div class="result-details" id="resultDetails"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial, legal, tax, or student-aid advice.
          </div>
        </div>
      </div>

<OmniStyleReviewBlock
      pageName="the student loan affordability calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="student loans, tuition, aid, scholarships, grants, expected salary, degree path, monthly payment, interest, savings, family help, and debt pressure after graduation"
    />

    <CorePageExamplesBlock
      title="Student loan examples"
      intro="Student loans can be useful when the degree has a clear payoff, but borrowing should be tested against likely income and total debt."
      useCases={[
          "You are deciding whether to take out student loans.",
          "You need to include aid, scholarships, grants, family help, savings, and expected salary.",
          "You want to understand debt pressure after graduation."
        ]}
      notEnough={[
          "You need legal, tax, student-loan, financial-aid, or repayment-plan advice.",
          "You need exact interest or payment terms from a lender.",
          "You need program-specific job-placement guarantees."
        ]}
      examples={[
          {
            label: "Modest loans, strong degree path",
            takeaway: "Pressure may be manageable if expected income supports repayment."
          },
          {
            label: "Large loans, uncertain salary",
            takeaway: "Pressure rises when borrowing outpaces career payoff."
          },
          {
            label: "Aid reduces need",
            takeaway: "Grants, scholarships, and family help should be counted before loans."
          }
        ]}
      commonMistake="Borrowing the full offered amount without comparing repayment to likely income."
      nextStep="Estimate post-graduation payment and compare it with realistic starting income."
    />



      <section class="content-section">
        <h2>Student loans are not just tuition help. They are a future bill.</h2>

        <p>
          Student loans can be useful when they buy access to a credential with a
          clear payoff. They can also become a long-term drag when the program
          outcome is uncertain, the loan payment is too high, or the borrower
          graduates into a budget that already has rent, groceries,
          transportation, insurance, childcare, medical costs, and other debt.
        </p>

        <p>
          The right question is not only "Can I get approved?" It is "Will the
          payment fit the life I expect to have after school?" A manageable loan
          should support a stronger future, not make every future decision tighter.
        </p>

        <div class="callout decision-box">
          <p>
            Student loan debt is most defensible when the path from borrowing to
            income is clear, specific, and realistic.
          </p>
        </div>
      </section>

      <section class="content-section" id="MethodologySection">
        <h2>How this student loan calculator works</h2>

        <p>
          The calculator estimates a pressure score from 0 to 100. It compares
          the expected loan balance, estimated monthly payment, other debt,
          expected take-home income, current savings, program length, program
          confidence, and expected income gain.
        </p>

        <div class="mini-grid">
          <div class="mini-card numbered-card">
            <div class="number">1</div>
            <h3>Estimate the payment</h3>
            <p>If no payment is entered, the calculator estimates one as 1.2% of the expected loan balance.</p>
          </div>

          <div class="mini-card numbered-card">
            <div class="number">2</div>
            <h3>Compare debt to income</h3>
            <p>The payment is compared with expected monthly take-home income and total monthly debt after school.</p>
          </div>

          <div class="mini-card numbered-card">
            <div class="number">3</div>
            <h3>Check savings cushion</h3>
            <p>Savings matter because repayment is less stressful when you are not starting from zero after graduation.</p>
          </div>

          <div class="mini-card numbered-card">
            <div class="number">4</div>
            <h3>Judge payoff strength</h3>
            <p>The calculator compares the payment with expected income gain and adjusts for program confidence.</p>
          </div>
        </div>

        <p>
          There is no artificial minimum pressure. If future income, savings,
          payment size, total debt, and program payoff make the loan essentially
          harmless, the score can fall to 0.
        </p>
      </section>

      <WhenSpendingMakesSense
        title="When Student Loans Can Make Sense"
        items={[
          "The program has a clear job, license, promotion, or income path.",
          "The expected monthly payment fits your future take-home income.",
          "You have compared grants, scholarships, employer help, and lower-cost schools.",
          "You are not using loans to cover avoidable lifestyle inflation.",
          "The borrowing creates a realistic path to stronger long-term stability.",
          "You understand the repayment timeline before accepting the loan.",
          "The loan does not force you to pause emergency savings for years after graduation.",
        ]}
      />

      <section class="content-section" id="KeyCostCategories">
        <h2>Key costs to include before borrowing</h2>

        <p>
          Student loans should be judged against the full education decision, not
          just the tuition line. The real cost includes what you borrow, what you
          stop earning, and what repayment does to your future budget.
        </p>

        <div class="info-grid">
          {keyCostCategories.map((category) => (
            <div class="info-card">
              <h3>{category.title}</h3>
              <p>{category.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="content-section">
        <h2>Student loan decision table</h2>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Situation</th>
                <th>Borrowing may be reasonable when</th>
                <th>Borrowing becomes risky when</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Career payoff</td>
                <td>The program leads to a specific credential, license, promotion, or job path.</td>
                <td>The payoff is vague, speculative, or mostly based on hope.</td>
              </tr>
              <tr>
                <td>Monthly payment</td>
                <td>The payment is small relative to future take-home income.</td>
                <td>The payment crowds out rent, groceries, transportation, or savings.</td>
              </tr>
              <tr>
                <td>Other debt</td>
                <td>Existing debt is low enough that the student loan does not overload the budget.</td>
                <td>Credit cards, car loans, or other payments are already stressful.</td>
              </tr>
              <tr>
                <td>Savings</td>
                <td>You keep enough cash to handle emergencies during and after school.</td>
                <td>You graduate with debt and no cushion for normal life disruptions.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="content-section" id="ReduceCostTips">
        <h2>Ways to reduce student loan borrowing before you commit</h2>

        <p>
          A lower loan amount can change the entire verdict. Before accepting the
          maximum amount offered, look for ways to reduce the balance and protect
          your future monthly budget.
        </p>

        <ul class="check-list">
          {reduceCostTips.map((tip) => <li>{tip}</li>)}
        </ul>
      </section>

      <section class="content-section" id="FinancialRedFlags">
        <h2>Financial red flags before taking out student loans</h2>

        <p>
          These warning signs do not always mean school is a bad idea. They mean
          the borrowing plan needs more aid, lower costs, clearer payoff, or a
          different timeline.
        </p>

        <ul class="red-list">
          {financialRedFlags.map((flag) => <li>{flag}</li>)}
        </ul>

        <div class="callout warning-box">
          <p>
            Be especially careful when the degree sounds valuable but the income
            path is unclear. Student loans are easiest to justify when the payoff
            is specific, not just hopeful.
          </p>
        </div>
      </section>

      <section class="content-section">
        <h2>When you should wait, borrow less, or choose a cheaper path</h2>

        <p>
          Waiting may be smart if the program payoff is unclear, you already have
          stressful debt, or the future payment would make rent, groceries,
          transportation, medical bills, childcare, or emergency savings hard to
          maintain.
        </p>

        <p>
          That does not mean giving up on school. It may mean applying for more
          aid, choosing a lower-cost school, transferring credits, starting
          part-time, working while enrolled, or building a stronger cash cushion
          before borrowing.
        </p>

        <p>
          If the payment would strain
          <a class="content-link" href="/how-much-rent-can-i-afford/">housing</a>,
          <a class="content-link" href="/should-i-spend-this-much-on-groceries-per-month/">groceries</a>,
          transportation, or existing debt, the loan amount may need to come down
          before enrollment.
        </p>
      </section>

      <section class="content-section">
        <h2>Start with the full college cost picture</h2>

        <p>
          Student loans should be judged against the full education decision.
          Tuition, fees, housing, books, time away from work, repayment timing,
          and income upside all affect whether borrowing is financially durable.
        </p>

        <a class="pillar-card" href="/college-cost-calculator/">
          <strong>College Cost Calculator</strong>
          <span>
            Estimate total education pressure using tuition, fees, housing,
            books, savings, loans, expected payoff, and household flexibility.
          </span>
        </a>

        <a class="pillar-card" href="/college-calculators/">
          <strong>Should I Spend $20,000 on College?</strong>
          <span>
            Pressure-test a smaller college cost against savings, borrowing,
            existing debt, expected income gain, and emergency flexibility.
          </span>
        </a>

        <a class="pillar-card" href="/should-i-use-savings-for-college/">
          <strong>Should I Use Savings for College?</strong>
          <span>
            Compare using cash versus borrowing while protecting emergency
            reserves.
          </span>
        </a>

        <a class="pillar-card" href="/how-much-debt-is-too-much/">
          <strong>Debt Pressure Calculator</strong>
          <span>
            See how existing monthly debt affects your ability to add a student
            loan payment without squeezing the rest of your budget.
          </span>
        </a>
      </section>

      <section class="content-section" id="CalculatorAssumptions">
        <h2>Calculator assumptions</h2>

        <ul>
          {assumptions.map((assumption) => <li>{assumption}</li>)}
        </ul>
      </section>

      <section class="content-section">
        <h2>What your student loan verdict actually means</h2>

        <p>
          A student loan verdict is not a judgment on whether education matters.
          It estimates whether the borrowing plan creates manageable or
          stressful pressure based on future income, debt load, savings, and
          expected career payoff.
        </p>

        <div class="info-grid">
          <div class="info-card">
            <h3>Low pressure</h3>
            <p>The loan looks manageable. Still confirm the program payoff, avoid extra borrowing, and keep emergency savings intact.</p>
          </div>

          <div class="info-card">
            <h3>Moderate pressure</h3>
            <p>The loan may work, but compare cheaper schools, more aid, employer help, part-time options, and smaller loan amounts.</p>
          </div>

          <div class="info-card">
            <h3>High pressure</h3>
            <p>The current borrowing plan could strain your future budget. Reduce the loan, delay enrollment, or choose a clearer payoff path.</p>
          </div>
        </div>
      </section>

      <section class="content-section" id="RelatedCalculators">
        <h2>Related college calculators</h2>
        <RelatedCalculators calculators={relatedCalculators} />
      </section>

      <div class="content-section">
        <FAQSection title="Student Loan FAQ" faqs={studentLoanFaqs} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="student loan affordability" />
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action:
            "Keep the borrowing plan only if the program payoff remains clear and future monthly payments stay manageable.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action:
            "Compare lower-cost schools, grants, employer help, part-time options, and smaller loan amounts before committing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action:
          "Reduce the loan amount, delay enrollment, increase aid, or choose a lower-cost path before borrowing.",
      };
    }

    function calculateStudentLoans() {
      const futureIncome = getNumber("futureIncome");
      const savings = getNumber("savings");
      const loanAmount = getNumber("loanAmount");
      const enteredLoanPayment = getNumber("loanPayment");
      const currentDebt = getNumber("currentDebt");
      const incomeGain = getNumber("incomeGain");
      const years = getNumber("years");
      const programStrength =
        document.getElementById("programStrength")?.value || "medium";

      const results = document.getElementById("results");
      const scoreText = document.getElementById("scoreText");
      const fillBar = document.getElementById("fillBar");
      const resultDetails = document.getElementById("resultDetails");
      const guidance = document.getElementById("guidance");

      results.classList.add("visible");

      if (futureIncome <= 0 || loanAmount <= 0) {
        scoreText.textContent = "Add your numbers first";
        fillBar.style.width = "0%";
        fillBar.className = "fill safe";

        resultDetails.innerHTML =
          "<p>Enter expected monthly take-home income after school, loan amount, savings, other debt payments, and expected income gain so the calculator can estimate student loan pressure.</p>";

        guidance.textContent = "";
        return;
      }

      const estimatedLoanPayment =
        enteredLoanPayment > 0 ? enteredLoanPayment : loanAmount * 0.012;

      const loanToAnnualIncomeRatio =
        (loanAmount / Math.max(futureIncome * 12, 1)) * 100;

      const loanPaymentRatio =
        (estimatedLoanPayment / Math.max(futureIncome, 1)) * 100;

      const totalDebtRatio =
        ((estimatedLoanPayment + currentDebt) / Math.max(futureIncome, 1)) * 100;

      const savingsMonths =
        savings / Math.max(futureIncome * 0.7, 1);

      const payoffRatio =
        estimatedLoanPayment / Math.max(incomeGain, 1);

      const payoffStrength =
        incomeGain >= estimatedLoanPayment * 4
          ? "strong"
          : incomeGain >= estimatedLoanPayment * 2
            ? "moderate"
            : "weak";

      const timeRisk =
        years >= 4 ? 12 : years >= 2 ? 6 : years > 0 ? 2 : 0;

      const incomeRecoveryPower =
        loanAmount / Math.max(futureIncome * 12, 1);

      const savingsPower =
        savings / Math.max(estimatedLoanPayment, 1);

      const absurdIncome =
        futureIncome >= loanAmount * 4 &&
        loanPaymentRatio <= 0.5 &&
        totalDebtRatio <= 5;

      const absurdSavings =
        savings >= loanAmount * 25 &&
        savingsMonths >= 60;

      const ultraSafeIncome =
        incomeRecoveryPower <= 0.03 &&
        loanPaymentRatio <= 1 &&
        totalDebtRatio <= 8;

      const ultraSafeSavings =
        savingsPower >= 120 &&
        savingsMonths >= 24;

      let pressureScore = 0;

      pressureScore += clamp(loanToAnnualIncomeRatio * 0.75, 0, 32);
      pressureScore += clamp(loanPaymentRatio * 3.2, 0, 36);
      pressureScore += clamp(totalDebtRatio * 0.75, 0, 30);
      pressureScore += timeRisk;

      if (savingsMonths < 1) {
        pressureScore += futureIncome >= estimatedLoanPayment * 75 ? 3 : 18;
      } else if (savingsMonths < 3) {
        pressureScore += futureIncome >= estimatedLoanPayment * 50 ? 2 : 10;
      } else if (savingsMonths >= 6) {
        pressureScore -= 8;
      }

      if (estimatedLoanPayment > 0 && incomeGain <= 0) {
        pressureScore += 18;
      } else if (payoffRatio > 0.5) {
        pressureScore += 14;
      } else if (payoffRatio > 0.3) {
        pressureScore += 8;
      } else if (payoffRatio <= 0.15 && incomeGain > 0) {
        pressureScore -= 8;
      }

      if (programStrength === "strong") {
        pressureScore -= 8;
      } else if (programStrength === "weak") {
        pressureScore += 16;
      }

      if (
        loanPaymentRatio < 5 &&
        totalDebtRatio < 18 &&
        savingsMonths >= 6 &&
        payoffStrength !== "weak"
      ) {
        pressureScore = Math.min(pressureScore, 24);
      }

      if (
        loanPaymentRatio < 3 &&
        totalDebtRatio < 10 &&
        savingsMonths >= 12 &&
        payoffStrength === "strong"
      ) {
        pressureScore = Math.min(pressureScore, 10);
      }

      if (ultraSafeIncome && ultraSafeSavings) {
        pressureScore = 0;
      }

      if (absurdIncome || absurdSavings) {
        pressureScore = 0;
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      scoreText.textContent = `${level.label}  -  ${pressureScore}/100`;
      fillBar.style.width = `${pressureScore}%`;
      fillBar.className = `fill ${level.colorClass}`;

      let explanation = "";

      if (pressureScore === 0) {
        explanation =
          "This student loan plan creates virtually no measurable pressure based on the future income, savings, debt, payment, and payoff numbers provided.";
      } else if (pressureScore <= 30) {
        explanation =
          "This student loan plan appears manageable based on the numbers provided. The main priority is confirming the program payoff and avoiding unnecessary extra borrowing.";
      } else if (pressureScore <= 60) {
        explanation =
          "This student loan plan may work, but it deserves caution. The payment, existing debt, timeline, and uncertain income improvement could reduce future flexibility.";
      } else {
        explanation =
          "This student loan plan could create significant financial pressure. A lower-cost school, more aid, smaller loan, part-time option, or clearer payoff would likely create more flexibility.";
      }

      resultDetails.innerHTML = `
        <p><strong>Estimated student loan payment:</strong> About $${estimatedLoanPayment.toFixed(0)} per month.</p>

        <p><strong>Loan balance compared with income:</strong> ${loanToAnnualIncomeRatio.toFixed(1)}% of expected annual take-home income.</p>

        <p><strong>Student loan payment impact:</strong> ${loanPaymentRatio.toFixed(1)}% of expected monthly take-home income.</p>

        <p><strong>Total debt impact:</strong> ${totalDebtRatio.toFixed(1)}% of expected monthly take-home income, including other debt payments.</p>

        <p><strong>Emergency savings cushion:</strong> About ${savingsMonths.toFixed(1)} months of estimated flexibility.</p>

        <p><strong>Expected payoff strength:</strong> ${payoffStrength} based on estimated loan payment versus expected monthly income gain.</p>

        <p><strong>Pressure level:</strong> ${level.stress}.</p>

        <p>${explanation} Recommended next step: ${level.action}</p>
      `;

      guidance.textContent = "";
    }

    document
      .getElementById("loanButton")
      .addEventListener("click", calculateStudentLoans);
  </script>
</Layout>
