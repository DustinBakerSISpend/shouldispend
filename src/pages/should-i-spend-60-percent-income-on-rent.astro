---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";

const pageUrl = "https://shouldispend.com/should-i-spend-60-percent-income-on-rent";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is spending 60% of income on rent too much?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Spending 60% of income on rent is usually high risk because it can leave too little room for savings, debt payments, utilities, groceries, transportation, insurance, and emergencies.",
      },
    },
    {
      "@type": "Question",
      name: "Can 60% rent ever be affordable?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It can be survivable for very high-income renters with large savings, low debt, stable income, and unusually low other expenses, but it is still a high fixed monthly commitment.",
      },
    },
    {
      "@type": "Question",
      name: "What makes 60% rent dangerous?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A 60% rent ratio becomes dangerous when utilities, debt payments, move-in costs, transportation, childcare, medical bills, or weak emergency savings leave almost no monthly flexibility.",
      },
    },
    {
      "@type": "Question",
      name: "Should I sign a lease if rent is 60% of income?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Be cautious. Before signing, check take-home pay, full housing cost, savings after move-in, debt payments, and whether the lease still works during a bad month.",
      },
    },
    {
      "@type": "Question",
      name: "Is 60% rent different for high earners?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. A high earner may still have large dollars left after rent, but the lease should still be tested against savings, debt, job stability, and the full monthly cost.",
      },
    },
  ],
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Should I Spend 60% of My Income on Rent Calculator",
  url: pageUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "All",
  description:
    "A 60% rent calculator that estimates housing pressure using income, take-home pay, rent, utilities, debt, bills, savings, and move-in costs.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://shouldispend.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Rent Calculators",
      item: "https://shouldispend.com/rent-calculators",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Should I Spend 60% of My Income on Rent?",
      item: pageUrl,
    },
  ],
};
---

<Layout
  title="Should I Spend 60% of My Income on Rent? Calculator | ShouldISpend"
  description="Use this 60% rent calculator to decide whether a very high rent ratio creates serious pressure based on income, take-home pay, debt, savings, bills, and utilities."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
      box-sizing: border-box;
    }

    button {
      background: #0f766e;
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
      display: none;
      background: #f8fafc;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
      line-height: 1.05;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }

    .content-section p,
    .content-section li {
      line-height: 1.8;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="60% Rent Rule Calculator"
      title="Should I Spend 60% of My Income on Rent?"
      description="Test whether a 60% rent ratio is survivable or financially dangerous after take-home pay, utilities, debt payments, savings, move-in costs, other bills, and monthly breathing room."
    >
      <div class="card">
        <h2>60% Rent Rule Pressure Verdict</h2>

        <div class="grid">
          <div>
            <label for="grossIncome">Annual Household Income</label>
            <input id="grossIncome" type="number" placeholder="200000" />
          </div>

          <div>
            <label for="takeHomePay">Monthly Take-Home Pay</label>
            <input id="takeHomePay" type="number" placeholder="12000" />
          </div>

          <div>
            <label for="rent">Monthly Rent</label>
            <input id="rent" type="number" placeholder="7200" />
          </div>

          <div>
            <label for="utilities">Utilities, Internet, Parking, Fees</label>
            <input id="utilities" type="number" placeholder="750" />
          </div>

          <div>
            <label for="monthlyDebt">Monthly Debt Payments</label>
            <input id="monthlyDebt" type="number" placeholder="900" />

            <div class="helper-link">
              <a href="/what-counts-as-debt">
                Not sure what counts as debt? Read the debt guide
              </a>
            </div>
          </div>

          <div>
            <label for="otherBills">Other Monthly Bills</label>
            <input id="otherBills" type="number" placeholder="2400" />
          </div>

          <div>
            <label for="savings">Total Emergency Savings</label>
            <input id="savings" type="number" placeholder="75000" />
          </div>

          <div>
            <label for="movingCost">Estimated Move-In Cost</label>
            <input id="movingCost" type="number" placeholder="18000" />
          </div>
        </div>

        <button id="rentButton" type="button">
          Get 60% Rent Verdict
        </button>

        <div class="result" id="result">
          <div class="score" id="score"></div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="housingRatio"></div>
          <div class="metric" id="takeHomeRatio"></div>
          <div class="metric" id="leftoverCash"></div>
          <div class="metric" id="recommendedRent"></div>
          <div class="metric" id="savingsCushion"></div>
          <div class="metric" id="moveInImpact"></div>
          <div class="metric" id="debtPressure"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <h2>Is 60% of Income on Rent Too Much?</h2>

        <p>
          Spending 60% of income on rent is usually a danger zone. At that level,
          the lease can dominate the budget before utilities, debt payments,
          insurance, groceries, transportation, medical costs, savings, and
          emergencies are even counted.
        </p>

        <p>
          Still, the answer is not identical for every renter. A very high-income
          household with large savings, low debt, stable income, and unusually
          low other expenses may survive a 60% rent ratio. A renter with modest
          income or weak savings may feel pressure almost immediately.
        </p>

        <p>
          This calculator treats 60% rent as a serious warning sign, then checks
          whether income, savings, debt, and leftover cash soften or confirm that
          risk.
        </p>
      </div>

      <div class="content-section">
        <h2>Why 60% Rent Is So Risky</h2>

        <p>
          A high fixed rent payment leaves fewer ways to adjust when life gets
          expensive. Groceries can rise, utilities can spike, insurance can
          change, cars can break, medical bills can appear, and income can become
          less stable.
        </p>

        <p>
          When rent already consumes most of the budget, even normal surprises
          can become credit card problems. That is why savings and leftover cash
          matter so much on this page.
        </p>
      </div>

      <WhenSpendingMakesSense
        title="When 60% Rent Might Be Survivable"
        items={[
          "Your income is very high and still leaves meaningful dollars after rent, utilities, debt, and normal bills.",
          "You have a large emergency fund after deposits, movers, furniture, fees, and setup costs.",
          "Debt payments are extremely low and do not compete with rent for cash flow.",
          "The location creates major value, such as replacing a commute, improving safety, supporting work, or solving a short-term housing need.",
          "The lease is temporary, intentional, and does not derail savings, debt payoff, healthcare, childcare, or other core needs.",
        ]}
      />

      <div class="content-section">
        <h2>When 60% Rent Is a Hard Stop</h2>

        <p>
          A 60% rent ratio should be treated as a hard stop if the payment leaves
          little or no monthly cash, drains savings, requires credit cards for
          normal spending, delays urgent debt payoff, or depends on uncertain
          overtime, bonuses, side income, or a future raise.
        </p>

        <p>
          The lease is especially dangerous if move-in costs would wipe out the
          emergency fund. High rent with no cushion can turn one bad month into a
          long recovery.
        </p>
      </div>

      <KeyCostCategories
        items={[
          {
            title: "Full housing cost",
            description:
              "At 60%, every added housing cost matters. Utilities, parking, internet, pet fees, renter’s insurance, storage, trash, and building fees can push the real burden even higher.",
          },
          {
            title: "Leftover cash",
            description:
              "The dollars left after rent, utilities, debt, and bills matter more than the percentage alone, especially for high-income households.",
          },
          {
            title: "Emergency savings",
            description:
              "A large savings cushion can soften risk, while weak savings make a 60% rent ratio fragile almost immediately.",
          },
          {
            title: "Income stability",
            description:
              "A high rent ratio is much more dangerous when commissions, bonuses, overtime, or side income are required to make the lease work.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Search for a cheaper unit before accepting a 60% rent ratio.",
          "Compare rent plus utilities, parking, internet, pet fees, and insurance.",
          "Avoid spending most of your savings on deposits and move-in costs.",
          "Consider a roommate, smaller unit, different neighborhood, or shorter lease.",
          "Test the lease against a bad month before signing.",
          "Lower the rent target if debt payments, childcare, medical bills, or transportation costs are already high.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "Rent and utilities would leave little or no monthly cash after normal bills.",
          "You would need credit cards for groceries, transportation, medical costs, or routine expenses.",
          "Move-in costs would wipe out most of your emergency savings.",
          "The lease depends on overtime, bonuses, side income, or a future raise.",
          "Debt payments already make the monthly budget tight.",
          "The apartment is mainly a lifestyle upgrade rather than a necessary short-term solution.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "The calculator treats 60% rent as a high-risk housing decision that requires extra scrutiny.",
          "Monthly housing cost includes rent plus estimated utilities, internet, parking, renter’s insurance, and other required housing fees.",
          "Take-home pay is used to estimate real monthly breathing room.",
          "Move-in costs are treated as an immediate savings hit because high-rent leases often require large deposits, movers, fees, and setup costs.",
          "The calculator is designed for general education and does not replace personalized financial advice.",
        ]}
      />

      <div class="content-section">
        <h2>How 60% Rent Can Look Different for High Earners</h2>

        <p>
          A 60% rent ratio is almost always aggressive, but high-income households
          may still have meaningful dollars left after rent. That matters. A
          household bringing home $25,000 per month has a different margin than a
          household bringing home $5,000 per month.
        </p>

        <p>
          Even then, the lease should not be judged by income alone. Savings,
          debt, move-in costs, job stability, other bills, and the reason for the
          high rent all matter.
        </p>
      </div>

      <div class="content-section">
        <h2>Emergency Savings Can Decide the Answer</h2>

        <p>
          With 60% rent, savings are not a side detail. They are the buffer that
          keeps a high fixed payment from becoming a crisis after one bad month.
        </p>

        <p>
          A strong cushion can make a temporary, high-rent situation more
          survivable. Weak savings can make the same lease dangerous even before
          the first month is over.
        </p>
      </div>

      <FAQSection
        title="60% Rent Rule FAQ"
        faqs={[
          {
            question: "Is spending 60% of income on rent too much?",
            answer:
              "Usually, yes. Spending 60% of income on rent often leaves too little room for utilities, debt payments, savings, groceries, transportation, insurance, and emergencies.",
          },
          {
            question: "Can 60% rent ever be affordable?",
            answer:
              "It can be survivable for very high-income renters with low debt, large savings, stable income, and low other expenses, but it remains a high fixed monthly commitment.",
          },
          {
            question: "Should I use gross income or take-home pay for 60% rent?",
            answer:
              "Use take-home pay. Gross income can make high rent look easier than it feels because taxes, insurance, payroll deductions, and contributions reduce available cash.",
          },
          {
            question: "Should utilities count with 60% rent?",
            answer:
              "Yes. Utilities, parking, renter’s insurance, internet, pet fees, storage, laundry, and commuting costs should be included because the full housing burden matters.",
          },
          {
            question: "What is the biggest risk of spending 60% on rent?",
            answer:
              "The biggest risk is losing the ability to absorb normal life events. A car repair, medical bill, job disruption, or rent increase can become much harder to handle.",
          },
        ]}
      />

      <MethodologySection category="rent affordability" updated="May 2026" />

      <RelatedGuides
        guides={[
          {
            title: "How Much Rent Can I Afford?",
            href: "/how-much-rent-can-i-afford",
            description:
              "Use the broader rent affordability guide to compare income, take-home pay, debt, utilities, savings, and monthly flexibility.",
          },
          {
            title: "What Counts as Debt?",
            href: "/what-counts-as-debt",
            description:
              "See which monthly obligations should be included when judging housing pressure.",
          },
          {
            title: "How Much Emergency Savings Should I Have?",
            href: "/how-much-emergency-savings-should-i-have",
            description:
              "Estimate how much cushion to keep before signing a high-risk lease.",
          },
        ]}
      />

      <RelatedCalculators
        calculators={[
          {
            category: "Rent",
            title: "Should I Spend 30% of My Income on Rent?",
            href: "/should-i-spend-30-percent-income-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend 40% of My Income on Rent?",
            href: "/should-i-spend-40-percent-income-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend 50% of My Income on Rent?",
            href: "/should-i-spend-50-percent-income-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend $3,000 on Rent?",
            href: "/should-i-spend-3000-on-rent",
          },
          {
            category: "Rent",
            title: "Should I Spend $4,000 on Rent?",
            href: "/should-i-spend-4000-on-rent",
          },
        ]}
      />
    </CalculatorPageShell>
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const formatMoney = (value) => {
      return Math.round(value).toLocaleString("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          color: "#16a34a",
          action:
            "This high rent ratio appears survivable based on the numbers provided, but verify the full cost and reason for the high payment before signing.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          color: "#ca8a04",
          action:
            "This rent ratio may be survivable, but compare lower-cost options and protect savings before committing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        color: "#dc2626",
        action:
          "This rent ratio could create serious strain. Strongly consider lower rent, lower debt, stronger savings, or more income first.",
      };
    }

    function calculateRent() {
      const grossIncome = getNumber("grossIncome");
      const takeHomePay = getNumber("takeHomePay");
      const rent = getNumber("rent");
      const utilities = getNumber("utilities");
      const monthlyDebt = getNumber("monthlyDebt");
      const otherBills = getNumber("otherBills");
      const savings = getNumber("savings");
      const movingCost = getNumber("movingCost");

      const result = document.getElementById("result");
      const scoreEl = document.getElementById("score");
      const barFill = document.getElementById("barFill");
      const housingRatioEl = document.getElementById("housingRatio");
      const takeHomeRatioEl = document.getElementById("takeHomeRatio");
      const leftoverCashEl = document.getElementById("leftoverCash");
      const recommendedRentEl = document.getElementById("recommendedRent");
      const savingsCushionEl = document.getElementById("savingsCushion");
      const moveInImpactEl = document.getElementById("moveInImpact");
      const debtPressureEl = document.getElementById("debtPressure");
      const guidanceEl = document.getElementById("guidance");

      result.style.display = "block";

      if (grossIncome <= 0 || takeHomePay <= 0 || rent <= 0) {
        scoreEl.textContent = "Add your numbers first";
        barFill.style.width = "0%";
        barFill.style.background = "#16a34a";
        housingRatioEl.innerHTML = "";
        takeHomeRatioEl.innerHTML = "";
        leftoverCashEl.innerHTML = "";
        recommendedRentEl.innerHTML = "";
        savingsCushionEl.innerHTML = "";
        moveInImpactEl.innerHTML = "";
        debtPressureEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter positive numbers for annual income, monthly take-home pay, and rent so the calculator can estimate housing pressure.";
        return;
      }

      const monthlyGrossIncome = grossIncome / 12;
      const totalHousingCost = rent + utilities;
      const totalCommittedMonthly = totalHousingCost + monthlyDebt + otherBills;
      const leftoverAfterBills = takeHomePay - totalCommittedMonthly;
      const housingGrossRatio = (totalHousingCost / monthlyGrossIncome) * 100;
      const housingTakeHomeRatio = (totalHousingCost / takeHomePay) * 100;
      const debtTakeHomeRatio = (monthlyDebt / takeHomePay) * 100;
      const leftoverRatio = (leftoverAfterBills / takeHomePay) * 100;
      const postMoveSavings = savings - movingCost;
      const postMoveSavingsMonths =
        totalCommittedMonthly > 0 ? postMoveSavings / totalCommittedMonthly : 0;
      const emergencyMonths =
        totalCommittedMonthly > 0 ? savings / totalCommittedMonthly : 0;
      const moveInSavingsImpact =
        savings > 0 ? (movingCost / savings) * 100 : movingCost > 0 ? 100 : 0;

      const conservativeRent = Math.max(0, Math.min(monthlyGrossIncome * 0.25, takeHomePay * 0.28));
      const balancedRent = Math.max(0, Math.min(monthlyGrossIncome * 0.3, takeHomePay * 0.35));
      const stretchRent = Math.max(0, Math.min(monthlyGrossIncome * 0.4, takeHomePay * 0.45));

      let pressureScore = 0;

      pressureScore += clamp((housingGrossRatio - 20) * 1.05, 0, 28);
      pressureScore += clamp((housingTakeHomeRatio - 25) * 1.15, 0, 34);
      pressureScore += clamp(debtTakeHomeRatio * 0.55, 0, 16);

      if (leftoverAfterBills < 0) {
        pressureScore += 28;
      } else if (leftoverRatio < 8) {
        pressureScore += 20;
      } else if (leftoverRatio < 15) {
        pressureScore += 12;
      } else if (leftoverRatio >= 35) {
        pressureScore -= 8;
      } else if (leftoverRatio >= 25) {
        pressureScore -= 4;
      }

      if (savings <= 0 && movingCost > 0) {
        pressureScore += 18;
      } else if (postMoveSavings < 0) {
        pressureScore += 20;
      } else if (postMoveSavingsMonths < 1 && grossIncome < 120000) {
        pressureScore += 16;
      } else if (postMoveSavingsMonths < 3 && grossIncome < 180000) {
        pressureScore += 10;
      } else if (postMoveSavingsMonths >= 6) {
        pressureScore -= 8;
      }

      if (moveInSavingsImpact >= 75) pressureScore += 12;
      else if (moveInSavingsImpact >= 50) pressureScore += 8;
      else if (moveInSavingsImpact <= 10 && savings > 0) pressureScore -= 3;

      if (housingGrossRatio >= 60) pressureScore += 18;
      else if (housingGrossRatio >= 50) pressureScore += 12;
      else if (housingGrossRatio >= 40) pressureScore += 7;

      if (housingTakeHomeRatio >= 65) pressureScore += 20;
      else if (housingTakeHomeRatio >= 55) pressureScore += 14;
      else if (housingTakeHomeRatio >= 45) pressureScore += 8;

      if (
        housingGrossRatio < 22 &&
        housingTakeHomeRatio < 28 &&
        leftoverRatio >= 30 &&
        emergencyMonths >= 4 &&
        debtTakeHomeRatio < 10
      ) {
        pressureScore -= 12;
      }

      if (
        housingGrossRatio < 12 &&
        housingTakeHomeRatio < 16 &&
        leftoverRatio >= 50 &&
        emergencyMonths >= 8 &&
        debtTakeHomeRatio < 5
      ) {
        pressureScore = Math.min(pressureScore, 10);
      }

      if (
        housingGrossRatio < 6 &&
        housingTakeHomeRatio < 8 &&
        leftoverRatio >= 65 &&
        emergencyMonths >= 12 &&
        debtTakeHomeRatio < 3
      ) {
        pressureScore = 0;
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      let guidance = "";

      if (pressureScore === 0) {
        guidance =
          `This ${formatMoney(rent)} rent payment appears financially tiny relative to the numbers provided, even though the page is about high rent ratios. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, leaving substantial flexibility. The decision is mainly about lease terms, location value, and opportunity cost.`;
      } else if (pressureScore <= 30) {
        guidance =
          `This ${formatMoney(rent)} rent payment appears survivable based on the numbers provided. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, while leaving about ${formatMoney(leftoverAfterBills)} after listed housing, debt, and bill obligations.`;
      } else if (pressureScore <= 60) {
        guidance =
          `This ${formatMoney(rent)} rent payment may be survivable, but it deserves caution. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, so savings, utilities, debt payments, and move-in costs should be checked carefully before signing.`;
      } else {
        guidance =
          `This ${formatMoney(rent)} rent payment could create significant financial pressure. Housing would use about ${housingGrossRatio.toFixed(1)}% of gross income and ${housingTakeHomeRatio.toFixed(1)}% of take-home pay, which may leave too little flexibility after debt, bills, savings needs, and emergencies.`;
      }

      scoreEl.textContent = `${level.label} — ${pressureScore}/100`;
      barFill.style.width = `${pressureScore}%`;
      barFill.style.background = level.color;

      housingRatioEl.innerHTML = `<strong>Housing-to-gross-income ratio:</strong> ${housingGrossRatio.toFixed(1)}%`;
      takeHomeRatioEl.innerHTML = `<strong>Housing-to-take-home-pay ratio:</strong> ${housingTakeHomeRatio.toFixed(1)}%`;
      leftoverCashEl.innerHTML = `<strong>Estimated leftover after listed bills:</strong> ${formatMoney(leftoverAfterBills)}`;
      recommendedRentEl.innerHTML = `<strong>Estimated rent range:</strong> ${formatMoney(conservativeRent)} conservative / ${formatMoney(balancedRent)} balanced / ${formatMoney(stretchRent)} stretch`;
      savingsCushionEl.innerHTML = `<strong>Emergency cushion:</strong> ${emergencyMonths.toFixed(1)} months before move-in / ${postMoveSavingsMonths.toFixed(1)} months after move-in costs`;
      moveInImpactEl.innerHTML = `<strong>Move-in savings impact:</strong> ${moveInSavingsImpact.toFixed(1)}% of savings`;
      debtPressureEl.innerHTML = `<strong>Debt payment pressure:</strong> ${debtTakeHomeRatio.toFixed(1)}% of take-home pay`;
      guidanceEl.textContent = `${guidance} Recommended next step: ${level.action}`;
    }

    document
      .getElementById("rentButton")
      .addEventListener("click", calculateRent);
  </script>
</Layout>