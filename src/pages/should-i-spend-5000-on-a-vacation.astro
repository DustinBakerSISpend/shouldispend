---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
---

<Layout
  title="Should I Spend $5,000 on a Vacation?"
  description="Use this vacation calculator to decide whether a $5,000 trip fits your income, savings, debt, emergency cushion, and travel budget."
>
  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
      box-sizing: border-box;
    }

    button {
      background: #0f766e;
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
      display: none;
      background: #f8fafc;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }

    .content-section p,
    .content-section li {
      line-height: 1.8;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Vacation Spending Calculator"
      title="Should I Spend $5,000 on a Vacation?"
      description="Estimate whether a $5,000 vacation fits your income, savings, debt, emergency cushion, and overall financial flexibility."
    >
      <div class="card">
        <h2>Vacation Affordability Verdict</h2>

        <div class="grid">
          <div>
            <label for="income">Annual Household Income</label>
            <input id="income" type="number" placeholder="150000" />
          </div>

          <div>
            <label for="savings">Total Savings</label>
            <input id="savings" type="number" placeholder="12000" />
          </div>

          <div>
            <label for="vacation">Vacation Cost</label>
            <input id="vacation" type="number" value="5000" />
          </div>

          <div>
            <label for="debt">Total Debt</label>
            <input id="debt" type="number" placeholder="20000" />

            <div class="helper-link">
              <a href="/what-counts-as-debt">
                Not sure what counts as debt? Read the debt guide
              </a>
            </div>
          </div>
        </div>

        <button id="vacationButton" type="button">
          Get Vacation Verdict
        </button>

        <div class="result" id="result">
          <div class="score" id="score"></div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="stress"></div>
          <div class="metric" id="savingsImpact"></div>
          <div class="metric" id="incomeImpact"></div>
          <div class="metric" id="debtRatio"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <h2>What a $5,000 Vacation Really Includes</h2>

        <p>
          A $5,000 vacation often sounds simple, but the real cost is usually
          more than flights and hotels. Transportation, baggage fees, airport
          meals, rideshares, rental cars, excursions, travel insurance, resort
          fees, souvenirs, parking, tips, and unexpected costs can raise the
          total quickly.
        </p>

        <p>
          For some households, $5,000 may cover a comfortable domestic trip,
          road trip, beach rental, national park vacation, or modest
          international getaway. For others, it may only cover airfare and
          lodging, especially for a family or peak-season trip.
        </p>

        <p>
          The safest vacation budget includes the entire trip before booking, not
          just the headline expenses that appear first.
        </p>
      </div>

      <div class="content-section">
        <h2>Domestic vs. International Tradeoffs</h2>

        <p>
          A $5,000 budget can stretch much further when the destination, timing,
          and transportation match the budget. A domestic road trip may leave
          room for better lodging and activities, while an international trip may
          use more of the budget on airfare before the vacation even begins.
        </p>

        <p>
          Neither choice is automatically better. The key question is whether the
          trip still leaves enough room for meals, transportation, experiences,
          emergency costs, and normal life after you return home.
        </p>
      </div>

      <WhenSpendingMakesSense
        title="When a $5,000 Vacation Makes Sense"
        items={[
          "You can pay for the trip without carrying high-interest credit card debt.",
          "Your emergency fund remains intact after booking.",
          "The vacation fits a real need for rest, family time, or a meaningful milestone.",
          "The budget includes transportation, lodging, food, activities, tips, fees, and surprise costs.",
          "The trip will not delay debt payoff, housing stability, or other important goals.",
        ]}
      />

      <div class="content-section">
        <h2>When Waiting Might Be the Better Choice</h2>

        <p>
          Waiting may be smarter if the vacation would wipe out savings, delay
          debt payoff, depend on credit cards, or make monthly bills harder to
          manage after returning home.
        </p>

        <p>
          A cheaper version of the trip may still work. Fewer travel days,
          cheaper flights, off-season travel, lower-cost lodging, or a closer
          destination can reduce financial pressure without giving up the
          vacation entirely.
        </p>
      </div>

      <KeyCostCategories
        items={[
          {
            title: "Transportation",
            description:
              "Airfare, gas, rental cars, rideshares, checked bags, airport parking, and local transit can consume a large share of the budget.",
          },
          {
            title: "Lodging",
            description:
              "Hotels, vacation rentals, resort fees, cleaning fees, taxes, parking, and location premiums should be included before booking.",
          },
          {
            title: "Food and daily spending",
            description:
              "Restaurants, groceries, snacks, coffee, drinks, tips, and convenience purchases can become expensive over several days.",
          },
          {
            title: "Activities and surprise costs",
            description:
              "Tours, tickets, excursions, souvenirs, travel insurance, weather backup plans, and emergency expenses should be part of the estimate.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Travel during shoulder season instead of peak dates.",
          "Choose a closer destination if airfare would eat too much of the budget.",
          "Book lodging with a kitchen or free breakfast to reduce meal costs.",
          "Limit paid activities and mix in free or low-cost experiences.",
          "Set a daily spending limit before the trip starts.",
          "Build a small surprise-cost buffer into the budget.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "The vacation would require credit card debt or a buy-now-pay-later plan.",
          "The trip would leave you without a real emergency cushion.",
          "You have upcoming bills, repairs, medical costs, or family expenses that are not funded yet.",
          "The budget does not include meals, transportation, tips, fees, or a surprise-cost buffer.",
          "The trip would make normal life feel tighter after you return home.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "The calculator assumes the vacation is primarily paid with savings instead of high-interest debt.",
          "The estimate should include transportation, lodging, food, activities, tips, fees, and emergency costs.",
          "The calculator assumes your income and debt obligations are relatively stable.",
          "Trip length, destination, family size, and season can significantly change the real cost.",
          "The calculator assumes you still maintain an emergency cushion after booking the trip.",
        ]}
      />

      <FAQSection
        title="Vacation Spending FAQ"
        faqs={[
          {
            question: "Is a $5,000 vacation too expensive?",
            answer:
              "That depends on your income, savings, debt load, emergency fund, and overall financial flexibility. A $5,000 vacation may feel comfortable for one household and financially stressful for another.",
          },
          {
            question: "How much should I spend on a vacation?",
            answer:
              "Vacation spending should fit comfortably within your broader financial picture without damaging emergency savings, increasing high-interest debt, or delaying major long-term goals.",
          },
          {
            question: "Should I finance a vacation?",
            answer:
              "Financing a vacation with high-interest debt can create long-term financial pressure if the trip cost exceeds what your income and savings can comfortably support.",
          },
          {
            question: "Should I use savings for a vacation?",
            answer:
              "Using savings is usually safer than using high-interest debt, but the vacation should still leave enough emergency cash afterward for normal life expenses and unexpected events.",
          },
          {
            question: "What costs do people forget when budgeting for vacations?",
            answer:
              "Many travelers forget baggage fees, airport transportation, food, tips, resort fees, excursions, souvenirs, travel insurance, parking, and emergency spending.",
          },
        ]}
      />

      <MethodologySection category="vacation spending" updated="May 2026" />

      <RelatedGuides
        guides={[
          {
            title: "How to Avoid Vacation Debt",
            href: "/how-to-avoid-vacation-debt",
            description:
              "Learn how to plan a vacation without relying on credit card debt or draining your emergency fund.",
          },
          {
            title: "Travel Budget Calculators",
            href: "/travel-calculators",
            description:
              "Browse calculators for Disney trips, Europe vacations, cruises, and other major travel decisions.",
          },
        ]}
      />

      <RelatedCalculators
        calculators={[
          {
            category: "Travel",
            title: "Should I Spend $8,000 on a Disney Vacation?",
            href: "/should-i-spend-8000-on-a-disney-vacation",
          },
          {
            category: "Travel",
            title: "Should I Spend $10,000 on a Europe Trip?",
            href: "/should-i-spend-10000-on-a-europe-trip",
          },
          {
            category: "Travel",
            title: "Should I Spend $12,000 on a Cruise?",
            href: "/should-i-spend-12000-on-a-cruise",
          },
          {
            category: "Travel",
            title: "Browse Travel Calculators",
            href: "/travel-calculators",
          },
        ]}
      />
    </CalculatorPageShell>
  </div>

  <script is:inline>
    function calculateVacation() {
      const income = Number(document.getElementById("income").value);
      const savings = Number(document.getElementById("savings").value);
      const vacation = Number(document.getElementById("vacation").value);
      const debt = Number(document.getElementById("debt").value || 0);

      const result = document.getElementById("result");
      const scoreEl = document.getElementById("score");
      const barFill = document.getElementById("barFill");
      const stressEl = document.getElementById("stress");
      const savingsImpactEl = document.getElementById("savingsImpact");
      const incomeImpactEl = document.getElementById("incomeImpact");
      const debtRatioEl = document.getElementById("debtRatio");
      const guidanceEl = document.getElementById("guidance");

      result.style.display = "block";

      if (!income || !savings || !vacation) {
        scoreEl.textContent = "Add your numbers first";
        barFill.style.width = "0%";
        stressEl.innerHTML = "";
        savingsImpactEl.innerHTML = "";
        incomeImpactEl.innerHTML = "";
        debtRatioEl.innerHTML = "";
        guidanceEl.textContent =
          "Enter your income, savings, vacation cost, and debt so the calculator can give a useful verdict.";
        return;
      }

      const savingsImpact = (vacation / savings) * 100;
      const incomeImpact = (vacation / income) * 100;
      const debtRatio = (debt / income) * 100;

      let score = 100;

      score -= savingsImpact * 0.22;
      score -= incomeImpact * 0.9;
      score -= debtRatio * 0.18;

      if (savings < vacation) score -= 12;
      if (debt > income * 0.5) score -= 10;

      score = Math.max(0, Math.min(100, Math.round(score)));

      let verdict = "";
      let stress = "";
      let guidance = "";
      let barColor = "";

      if (score >= 80) {
        verdict = "Comfortable Vacation";
        stress = "Low stress";
        guidance =
          "This vacation appears financially manageable based on your income, savings, debt, and remaining emergency cushion.";
        barColor = "#16a34a";
      } else if (score >= 60) {
        verdict = "Manageable With Caution";
        stress = "Moderate stress";
        guidance =
          "This trip may work, but keep firm limits on transportation, lodging, food, activities, and surprise costs.";
        barColor = "#ca8a04";
      } else if (score >= 40) {
        verdict = "Financial Stretch";
        stress = "High stress";
        guidance =
          "This vacation could create financial pressure. A lower budget, closer destination, or delayed trip may be safer.";
        barColor = "#ea580c";
      } else {
        verdict = "High Financial Risk";
        stress = "Very high stress";
        guidance =
          "This vacation cost appears too aggressive for the current financial picture, especially if the trip would be financed with high-interest debt.";
        barColor = "#b91c1c";
      }

      scoreEl.textContent = `${verdict} - ${score}/100`;
      barFill.style.width = `${score}%`;
      barFill.style.background = barColor;

      stressEl.innerHTML = `<strong>Stress level:</strong> ${stress}`;
      savingsImpactEl.innerHTML = `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;
      incomeImpactEl.innerHTML = `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;
      debtRatioEl.innerHTML = `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;
      guidanceEl.textContent = guidance;
    }

    document
      .getElementById("vacationButton")
      .addEventListener("click", calculateVacation);
  </script>
</Layout>