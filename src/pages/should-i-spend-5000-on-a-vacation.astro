---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
---

<Layout title="Should I Spend $5,000 on a Vacation?">
  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
    }

    button {
      background: var(--button);
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Vacation Spending Calculator"
      title="Should I Spend $5,000 on a Vacation?"
      description="Estimate whether a $5,000 vacation fits your income, savings, debt, emergency cushion, and overall financial flexibility."
    >
      <div class="card">
        <h2>Vacation Affordability Verdict</h2>

        <div class="grid">
          <div>
            <label for="income">Annual Household Income</label>
            <input id="income" type="number" placeholder="150000" />
          </div>

          <div>
            <label for="savings">Total Savings</label>
            <input id="savings" type="number" placeholder="12000" />
          </div>

          <div>
            <label for="vacation">Vacation Cost</label>
            <input id="vacation" type="number" placeholder="5000" />
          </div>

          <div>
            <label for="debt">Total Debt</label>
            <input id="debt" type="number" placeholder="20000" />

            <div class="helper-link">
              <a href="/what-counts-as-debt">
                Not sure what counts as debt? Read the debt guide
              </a>
            </div>
          </div>
        </div>

        <button id="vacationButton">
          Get Vacation Verdict
        </button>

        <div class="result">
          <div class="score" id="score">
            Comfortable Vacation - 82/100
          </div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="stress"></div>
          <div class="metric" id="savingsImpact"></div>
          <div class="metric" id="incomeImpact"></div>
          <div class="metric" id="debtRatio"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <section>
          <h2>What Your Vacation Verdict Actually Means</h2>

          <p>
            A vacation verdict is not just about whether you can technically pay for a trip today.
            It is about whether the vacation still leaves enough room for emergency savings, normal
            bills, debt payments, retirement goals, and financial flexibility after you return home.
          </p>

          <p>
            A stronger verdict means the trip is less likely to create stress later. A weaker verdict
            means the vacation may still be possible, but the timing, payment method, trip length,
            or overall budget may need to change.
          </p>
        </section>

        <section>
          <h2>What a $5,000 Vacation Really Includes</h2>

          <p>
            A $5,000 vacation often includes more than flights and hotels. Transportation, baggage
            fees, airport meals, rideshares, rental cars, excursions, travel insurance, resort fees,
            souvenirs, parking, and unexpected costs can raise the total quickly.
          </p>

          <p>
            For some households, $5,000 may cover a comfortable family trip. For others, it may only
            cover airfare and lodging. The true affordability depends on income, savings, debt,
            emergency reserves, family size, and how the trip will be paid for.
          </p>
        </section>

        <section>
          <h2>When a Vacation Makes Financial Sense</h2>

          <p>
            A vacation usually makes the most financial sense when it is mostly paid from savings,
            does not drain the emergency fund, and does not create high-interest debt afterward.
          </p>

          <p>
            The healthiest vacation budgets account for the full trip cost upfront instead of relying
            on future paychecks or credit card balances after the trip is already over.
          </p>

          <p>
            Vacations can absolutely be worthwhile. Rest, family memories, major milestones, and
            meaningful experiences matter. The key is making sure the trip improves life instead of
            creating financial pressure afterward.
          </p>
        </section>

        <section>
          <h2>When Waiting Might Be the Better Choice</h2>

          <p>
            Waiting may be smarter if the vacation would wipe out savings, delay debt payoff, depend
            on credit cards, or make monthly bills harder to manage after returning home.
          </p>

          <p>
            A cheaper version of the trip may still work. Fewer travel days, cheaper flights,
            off-season travel, lower-cost lodging, or a closer destination can reduce financial
            pressure without giving up the vacation entirely.
          </p>
        </section>

        <FinancialRedFlags
  items={[
    "The vacation would require credit card debt or a buy-now-pay-later plan.",
    "The trip would leave you without a real emergency cushion.",
    "You have upcoming bills, repairs, medical costs, or family expenses that are not funded yet.",
    "The budget does not include meals, transportation, tips, fees, or a surprise-cost buffer.",
    "The trip would make normal life feel tighter after you return home.",
  ]}
/>
        <FAQSection
          title="Vacation Spending FAQ"
          faqs={[
            {
              question: "Is a $5,000 vacation too expensive?",
              answer:
                "That depends on your income, savings, debt load, emergency fund, and overall financial flexibility. A $5,000 vacation may feel comfortable for one household and financially stressful for another.",
            },
            {
              question: "How much should I spend on a vacation?",
              answer:
                "Vacation spending should fit comfortably within your broader financial picture without damaging emergency savings, increasing high-interest debt, or delaying major long-term goals.",
            },
            {
              question: "Should I finance a vacation?",
              answer:
                "Financing a vacation with high-interest debt can create long-term financial pressure if the trip cost exceeds what your income and savings can comfortably support.",
            },
            {
              question: "Should I use savings for a vacation?",
              answer:
                "Using savings is usually safer than using high-interest debt, but the vacation should still leave enough emergency cash afterward for normal life expenses and unexpected events.",
            },
            {
              question: "What costs do people forget when budgeting for vacations?",
              answer:
                "Many travelers forget baggage fees, airport transportation, food, tips, resort fees, excursions, souvenirs, travel insurance, parking, and emergency spending.",
            },
          ]}
        />

        <MethodologySection
          category="vacation spending"
          updated="May 2026"
        />

        <RelatedGuides
  guides={[
    {
      title: "How to Avoid Vacation Debt",
      href: "/how-to-avoid-vacation-debt",
      description:
        "Learn how to plan a vacation without relying on credit card debt or draining your emergency fund.",
    },
    {
      title: "Travel Budget Calculators",
      href: "/travel-calculators",
      description:
        "Browse calculators for Disney trips, Europe vacations, cruises, and other major travel decisions.",
    },
  ]}
/>
        <RelatedCalculators
          calculators={[
            {
              category: "Travel",
              title: "Should I Spend $8,000 on a Disney Vacation?",
              href: "/should-i-spend-8000-on-a-disney-vacation",
            },
            {
              category: "Travel",
              title: "Should I Spend $10,000 on a Europe Trip?",
              href: "/should-i-spend-10000-on-a-europe-trip",
            },
            {
              category: "Travel",
              title: "Should I Spend $12,000 on a Cruise?",
              href: "/should-i-spend-12000-on-a-cruise",
            },
            {
              category: "Travel",
              title: "Browse Travel Calculators",
              href: "/travel-calculators",
            },
          ]}
        />
      </div>
    </CalculatorPageShell>
  </div>

  <script is:inline>
    function calculateVacation() {
      const income = Number(document.getElementById("income").value);
      const savings = Number(document.getElementById("savings").value);
      const vacation = Number(document.getElementById("vacation").value);
      const debt = Number(document.getElementById("debt").value);

      let score = 100;

      const savingsImpact = savings > 0 ? (vacation / savings) * 100 : 100;
      const incomeImpact = income > 0 ? (vacation / income) * 100 : 100;
      const debtRatio = income > 0 ? (debt / income) * 100 : 50;

      score -= savingsImpact * 0.22;
      score -= incomeImpact * 0.9;
      score -= debtRatio * 0.18;

      if (savings < vacation) score -= 12;
      if (income > 0 && debt > income * 0.5) score -= 10;

      score = Math.max(0, Math.min(100, Math.round(score)));

      let verdict = "";
      let stress = "";
      let guidance = "";
      let barColor = "";

      if (score >= 80) {
        verdict = "Comfortable Vacation";
        stress = "Low stress";
        guidance =
          "This vacation appears financially manageable based on your income, savings, debt, and remaining emergency cushion.";
        barColor = "#16a34a";
      } else if (score >= 60) {
        verdict = "Manageable With Caution";
        stress = "Moderate stress";
        guidance =
          "This trip is probably affordable, though it may reduce short-term financial flexibility.";
        barColor = "#ca8a04";
      } else if (score >= 40) {
        verdict = "Financial Stretch";
        stress = "High stress";
        guidance =
          "This vacation could create financial pressure. A lower budget or delayed trip may be safer.";
        barColor = "#ea580c";
      } else {
        verdict = "High Financial Risk";
        stress = "Very high stress";
        guidance =
          "This vacation cost appears too aggressive for the current financial picture.";
        barColor = "#b91c1c";
      }

      document.getElementById("score").textContent =
        `${verdict} - ${score}/100`;

      document.getElementById("barFill").style.width =
        `${score}%`;

      document.getElementById("barFill").style.background =
        barColor;

      document.getElementById("stress").innerHTML =
        `<strong>Stress level:</strong> ${stress}`;

      document.getElementById("savingsImpact").innerHTML =
        `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;

      document.getElementById("incomeImpact").innerHTML =
        `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;

      document.getElementById("debtRatio").innerHTML =
        `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

      document.getElementById("guidance").textContent =
        guidance;
    }

    document.getElementById("vacationButton")
      .addEventListener("click", calculateVacation);
  </script>
</Layout>