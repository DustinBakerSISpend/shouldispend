---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import { calculators } from "../data/calculators.js";

const outOfStateFaqs = [
  {
    question: "Is paying $15,000 more per year for out-of-state tuition worth it?",
    answer:
      "It can be worth it if the school offers a clearly stronger program, better career placement, meaningful scholarships, a faster graduation path, or a specific opportunity the cheaper school cannot provide. It is riskier when the premium mostly buys preference, distance, prestige, or campus feel.",
  },
  {
    question: "Is this calculator for the student or the parent?",
    answer:
      "It is for the person or household helping pay the extra out-of-state tuition premium. That may be the student, a parent, or both. Use the income, savings, debt, and help that will actually support the extra cost.",
  },
  {
    question: "Should I include scholarships or grants?",
    answer:
      "Yes. Include aid, grants, scholarships, tuition discounts, and reliable family help that specifically reduce the extra out-of-state cost.",
  },
  {
    question: "Does this evaluate the full college cost?",
    answer:
      "No. This calculator focuses on the extra annual out-of-state premium. Use the College Cost Calculator for total tuition, housing, fees, books, transportation, and borrowing pressure.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "College" &&
      calculator.href !== "/should-i-spend-15000-on-out-of-state-tuition"
  )
  .slice(0, 6);
---

<Layout
  title="Should I Spend $15,000 More on Out-of-State Tuition?"
  description="Evaluate whether $15,000 more for out-of-state tuition makes sense based on aid, program strength, savings, income, debt, and family help."
>

    <OmniStyleReviewBlock
      pageName="the $15,000 out-of-state tuition calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="$15,000 out-of-state tuition premium, aid, residency, program strength, scholarships, family help, savings, income, debt, expected salary, and whether the added cost improves the degree outcome"
    />

    <CorePageExamplesBlock
      title="$15,000 out-of-state tuition examples"
      intro="Out-of-state tuition is only worth more when the program value, aid package, or career path justifies the added cost."
      useCases={[
          "You are deciding whether to pay $15,000 more for out-of-state tuition.",
          "You need to compare aid, scholarships, residency, program strength, debt, and expected salary.",
          "You want to know whether the added cost improves the education outcome enough."
        ]}
      notEnough={[
          "You need admissions, financial-aid, tax, or student-loan legal advice.",
          "You need exact salary, job-placement, or program ranking predictions.",
          "You are deciding based mainly on campus fit, family, or personal reasons."
        ]}
      examples={[
          {
            label: "Strong program advantage",
            takeaway: "The extra cost may be easier to justify if it clearly improves career outcomes."
          },
          {
            label: "Similar program, higher debt",
            takeaway: "Pressure rises when the out-of-state option adds debt without clear value."
          },
          {
            label: "Residency path possible",
            takeaway: "Waiting or establishing residency can change the affordability picture."
          }
        ]}
      commonMistake="Comparing schools emotionally without calculating the added debt and expected payoff of the out-of-state premium."
      nextStep="Compare net cost and projected borrowing against the specific program advantage."
    />


  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro,
    .annual-note {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .annual-note {
      background: #ecfeff;
      border: 1px solid #99f6e4;
      border-radius: 18px;
      padding: 18px 20px;
      font-weight: 800;
      color: #115e59;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }

    .field-hint {
      display: block;
      margin-top: 8px;
      color: #64748b;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a,
    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .helper-link a:hover,
    .content-link:hover {
      text-decoration: underline;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .guidance {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid #dbe4ee;
      font-size: 1.12rem;
      line-height: 1.85;
      color: #1e293b;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
    }

    .pillar-card {
      display: block;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 24px;
      margin-top: 28px;
      text-decoration: none;
      transition: transform 0.15s ease;
    }

    .pillar-card:hover {
      transform: translateY(-2px);
    }

    .pillar-card strong {
      display: block;
      margin-bottom: 10px;
      color: #0f172a;
      font-size: 1.08rem;
    }

    .pillar-card span {
      color: #334155;
      line-height: 1.7;
      font-size: 0.98rem;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="College Cost Calculator"
      title="Should I Spend $15,000 More on Out-of-State Tuition?"
      description="Pressure-test the extra annual premium for out-of-state tuition against aid, residency, program strength, expected payoff, savings, debt, income, and family help."
    >
      <div class="calculator">
        <h2>$15,000 Out-of-State Tuition Premium Verdict</h2>

        <p class="calculator-intro">
          This calculator focuses on the extra amount you would pay each year
          for an out-of-state school compared with a cheaper in-state or local
          option. Use the income, savings, debt, and help that will actually
          support the extra cost.
        </p>

        <div class="annual-note">
          Important: this evaluates the extra out-of-state tuition premium per
          year, not the full four-year college cost.
        </div>

        <div class="grid">
          <div class="field">
            <label for="premiumCost">Extra Out-of-State Cost per Year</label>
            <input id="premiumCost" type="number" value="15000" placeholder="Example: 15000" />
            <span class="field-hint">Use the annual difference versus the cheaper school.</span>
          </div>

          <div class="field">
            <label for="income">Monthly Take-Home Income Supporting College</label>
            <input id="income" type="number" placeholder="Example: 6500" />
            <span class="field-hint">Use student income, parent income, or both  -  only if it will help pay.</span>
          </div>

          <div class="field">
            <label for="savings">Savings Available for College</label>
            <input id="savings" type="number" placeholder="Example: 25000" />
          </div>

          <div class="field">
            <label for="emergencyFund">Emergency Fund After College Savings</label>
            <input id="emergencyFund" type="number" placeholder="Example: 12000" />
          </div>

          <div class="field">
            <label for="monthlyDebt">Current Monthly Debt Payments</label>
            <input id="monthlyDebt" type="number" placeholder="Example: 500" />

            <div class="helper-link">
              Not sure what counts as debt?
              <a href="/what-counts-as-debt/">Read the debt guide</a>
            </div>
          </div>

          <div class="field">
            <label for="borrowed">Amount Borrowed for This Premium per Year</label>
            <input id="borrowed" type="number" placeholder="Example: 10000" />

            <div class="helper-link">
              Comparing loan risk?
              <a href="/should-i-take-out-student-loans/">Use the student loan calculator</a>
            </div>
          </div>

          <div class="field">
            <label for="aid">Aid / Scholarships Reducing the Premium</label>
            <input id="aid" type="number" placeholder="Example: 5000" />
          </div>

          <div class="field">
            <label for="familyHelp">Reliable Family or Outside Help per Year</label>
            <input id="familyHelp" type="number" placeholder="Example: 3000" />
          </div>

          <div class="field">
            <label for="cashUsed">Savings Used for This Premium per Year</label>
            <input id="cashUsed" type="number" placeholder="Example: 5000" />
          </div>

          <div class="field">
            <label for="expectedSalary">Expected Starting Salary After Graduation</label>
            <input id="expectedSalary" type="number" placeholder="Example: 60000" />
          </div>

          <div class="field">
            <label for="programStrength">Program Strength Compared with Cheaper Option</label>
            <select id="programStrength">
              <option value="strong">Clearly stronger program or career path</option>
              <option value="medium" selected>Some advantage</option>
              <option value="weak">Mostly preference or prestige</option>
            </select>
          </div>

          <div class="field">
            <label for="residencyChance">Chance of Getting In-State Tuition Later</label>
            <select id="residencyChance">
              <option value="likely">Likely or already documented</option>
              <option value="possible" selected>Possible but not guaranteed</option>
              <option value="unlikely">Unlikely or unclear</option>
            </select>
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="tuitionButton" type="button">Get Out-of-State Tuition Verdict</button>

        <div class="results" id="results">
          <div class="score" id="scoreText"></div>

          <div class="bar">
            <div class="fill" id="fillBar"></div>
          </div>

          <div class="result-details" id="resultDetails"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice or a
            financial aid determination.
          </div>
        </div>
      </div>

      <section class="content-section">
        <h2>Start With the Extra Cost, Not the School Name</h2>

        <p>
          Out-of-state tuition can feel like one big college decision, but the
          cleaner question is narrower: what are you paying above the cheaper
          realistic option, and what do you get for that extra money?
        </p>

        <p>
          A $15,000 annual premium may be reasonable if the school provides a
          materially better program, internships, licensing path, job placement,
          scholarship package, or faster route to graduation. It is harder to
          justify when the extra cost mostly buys distance, campus preference,
          football Saturdays, weather, or brand name.
        </p>

        <a class="pillar-card" href="/ideal-tuition-cost-calculator/">
          <strong>Ideal Tuition Cost Calculator</strong>
          <span>
            Find a realistic annual tuition range before comparing expensive
            schools, aid packages, housing plans, and career payoff.
          </span>
        </a>

        <a class="pillar-card" href="/college-cost-calculator/">
          <strong>College Cost Calculator</strong>
          <span>
            Estimate total college affordability using tuition, fees, housing,
            books, loans, savings, aid, expected payoff, and overall pressure.
          </span>
        </a>

        <a class="pillar-card" href="/degree-roi-calculator/">
          <strong>Degree ROI Calculator</strong>
          <span>
            Compare total cost, lost income, expected salary gains, payback
            period, debt pressure, and career upside.
          </span>
        </a>
      </section>

      <section class="content-section">
        <h2>What the Out-of-State Premium Really Buys</h2>

        <p>
          The premium is not just the advertised out-of-state tuition rate. It
          is the difference between the out-of-state school and the cheaper
          school you would realistically attend. That difference may include
          tuition, fees, travel, housing, transportation, and fewer local support
          options.
        </p>

        <p>
          The extra cost is more defensible when it directly improves the
          student's outcome. Examples include a specialized major, required
          clinical placement, stronger recruiting pipeline, direct admission to
          a competitive program, or a school with better completion odds for the
          student's situation.
        </p>
      </section>

      <WhenSpendingMakesSense
        title="When Spending $15,000 More on Out-of-State Tuition Can Make Sense"
        items={[
          "The school has a clearly stronger program than the cheaper option.",
          "Aid, scholarships, tuition discounts, or reliable family help reduce the premium.",
          "The student can graduate on time without adding extra semesters.",
          "Borrowing stays manageable compared with expected starting salary.",
          "The extra cost buys a real career, licensing, internship, or placement advantage.",
          "Emergency savings remain protected after any cash contribution.",
        ]}
      />

      <KeyCostCategories
        items={[
          {
            title: "Annual tuition premium",
            description:
              "This is the extra yearly amount paid for the out-of-state school compared with the cheaper realistic option.",
          },
          {
            title: "Aid and scholarships",
            description:
              "Gift aid can make the out-of-state premium much smaller than the sticker-price difference.",
          },
          {
            title: "Borrowing",
            description:
              "Loans used for the premium should be judged against expected salary, existing debt, and repayment flexibility.",
          },
          {
            title: "Program strength",
            description:
              "The higher cost is easier to justify when the out-of-state program materially improves the outcome.",
          },
          {
            title: "Residency risk",
            description:
              "Some students expect to qualify for in-state tuition later, but that should not be treated as guaranteed unless the rules are clear.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Compare the out-of-state school against the cheapest school you would actually attend.",
          "Ask whether scholarships renew each year or only apply to the first year.",
          "Confirm residency rules in writing before assuming tuition will drop later.",
          "Price travel, housing, parking, insurance, and moving costs separately from tuition.",
          "Appeal the aid package if a similar school offered more money.",
          "Consider starting in-state or at community college, then transferring if the target program still matters.",
        ]}
      />

      <FinancialRedFlags
        items={[
          "The extra $15,000 per year is mostly for preference, distance, prestige, or campus feel.",
          "The plan depends on getting in-state tuition later without clear residency rules.",
          "The student would need loans for the premium without a strong expected salary.",
          "Savings would be drained below a basic emergency cushion.",
          "The aid package is not renewable for every year.",
          "The cheaper option offers a similar degree, similar placement, and lower debt risk.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "Monthly income means take-home pay, not gross income.",
          "This calculator evaluates the extra out-of-state premium per year, not the full college cost.",
          "Aid, scholarships, and family help are treated as annual amounts.",
          "Estimated student loan payment uses a rough monthly payment equal to 1.2% of the borrowed amount.",
          "Reliable income, high savings, low debt, no borrowing, and strong emergency reserves can reduce pressure to 0/100.",
          "Program strength and expected salary can lower pressure only when the financial plan is also manageable.",
        ]}
      />

      <section class="content-section">
        <h2>When You Should Choose the Cheaper School</h2>

        <p>
          The cheaper school deserves serious consideration when it offers a
          similar degree, similar career outcomes, better aid, less debt, and a
          realistic path to graduation. Saving $15,000 per year can preserve
          flexibility for housing, transportation, internships, graduate school,
          emergencies, or starting adult life without heavy repayment pressure.
        </p>

        <p>
          Choosing the cheaper option does not mean settling. It may mean buying
          the same credential with less risk. The more similar the outcomes, the
          harder the out-of-state premium is to justify.
        </p>
      </section>

      <section class="content-section">
        <h2>What Your Out-of-State Tuition Verdict Means</h2>

        <p>
          A low-pressure result means the extra annual premium appears manageable
          based on the income, savings, aid, borrowing, and payoff numbers
          entered. A moderate result means the decision may still work, but
          cheaper options and more aid should be tested first.
        </p>

        <p>
          A high-pressure result does not mean the school is bad. It means the
          current funding plan creates too much strain relative to the likely
          benefit. In that case, the smarter move may be to negotiate aid, reduce
          borrowing, choose the cheaper school, or delay the decision until the
          numbers improve.
        </p>
      </section>

      <div class="content-section">
        <FAQSection title="Out-of-State Tuition FAQ" faqs={outOfStateFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="out-of-state tuition affordability" updated="June 2026" />
  </div>

  <script is:inline>
  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  const getNumber = (id) => {
    const rawValue = document.getElementById(id)?.value;
    const value = Number(rawValue);
    return Number.isFinite(value) && value >= 0 ? value : 0;
  };

  const getValue = (id) => document.getElementById(id)?.value || "";

  function getPressureLevel(score) {
    if (score <= 30) {
      return {
        label: "Low Pressure",
        stress: "Low pressure",
        colorClass: "safe",
        action:
          "Confirm the aid, help, renewal rules, and program fit, but the extra premium appears manageable.",
      };
    }

    if (score <= 60) {
      return {
        label: "Moderate Pressure",
        stress: "Moderate pressure",
        colorClass: "caution",
        action:
          "Appeal aid, compare in-state options, verify residency rules, and reduce the uncovered cost before committing.",
      };
    }

    return {
      label: "High Pressure",
      stress: "High pressure",
      colorClass: "danger",
      action:
        "Choose the cheaper school, reduce borrowing, secure more aid, or delay the decision before taking on this premium.",
    };
  }

  function formatDollars(value) {
    return `$${Math.round(value).toLocaleString()}`;
  }

  function calculateOutOfStatePressure() {
    const premiumCost = getNumber("premiumCost") || 15000;
    const income = getNumber("income");
    const savings = getNumber("savings");
    const emergencyFund = getNumber("emergencyFund");
    const monthlyDebt = getNumber("monthlyDebt");
    const requestedBorrowed = getNumber("borrowed");
    const aid = getNumber("aid");
    const familyHelp = getNumber("familyHelp");
    const requestedCashUsed = getNumber("cashUsed");
    const expectedSalary = getNumber("expectedSalary");
    const programStrength = getValue("programStrength") || "medium";
    const residencyChance = getValue("residencyChance") || "possible";

    const results = document.getElementById("results");
    const scoreText = document.getElementById("scoreText");
    const fillBar = document.getElementById("fillBar");
    const resultDetails = document.getElementById("resultDetails");
    const guidance = document.getElementById("guidance");

    results.classList.add("visible");

    if (premiumCost <= 0) {
      scoreText.textContent = "Add the premium first";
      fillBar.style.width = "0%";
      fillBar.className = "fill safe";
      resultDetails.innerHTML =
        "<p>Enter the extra annual out-of-state tuition premium to calculate pressure.</p>";
      guidance.textContent = "";
      return;
    }

    const annualIncome = income * 12;
    const giftHelp = aid + familyHelp;
    const uncoveredPremium = Math.max(premiumCost - giftHelp, 0);

    const borrowed = Math.min(requestedBorrowed, uncoveredPremium);
    const cashNeededAfterBorrowing = Math.max(uncoveredPremium - borrowed, 0);
    const cashUsed =
      uncoveredPremium <= 0
        ? 0
        : Math.min(
            requestedCashUsed > 0 ? requestedCashUsed : cashNeededAfterBorrowing,
            cashNeededAfterBorrowing
          );

    const remainingSavings = Math.max(savings - cashUsed, 0);
    const estimatedLoanPayment = borrowed > 0 ? borrowed * 0.012 : 0;

    const emergencyMonths = income > 0 ? emergencyFund / income : 0;
    const savingsMonthsAfter = income > 0 ? remainingSavings / income : 0;
    const totalLiquidMonthsAfter =
      income > 0 ? (remainingSavings + emergencyFund) / income : 0;

    const debtRatioAfter =
      income > 0 ? ((monthlyDebt + estimatedLoanPayment) / income) * 100 : 0;

    const uncoveredPremiumRatio =
      income > 0 ? (uncoveredPremium / annualIncome) * 100 : uncoveredPremium > 0 ? 100 : 0;

    const cashUseRatio =
      cashUsed > 0 ? (cashUsed / Math.max(savings, 1)) * 100 : 0;

    const borrowedShare =
      borrowed > 0 && uncoveredPremium > 0
        ? (borrowed / uncoveredPremium) * 100
        : 0;

    const expectedMonthlySalary = expectedSalary > 0 ? expectedSalary / 12 : 0;
    const loanToFutureIncome =
      expectedMonthlySalary > 0
        ? estimatedLoanPayment / expectedMonthlySalary
        : estimatedLoanPayment > 0
          ? 1
          : 0;

    let pressureScore = 0;

    /*
      HARD GATES:
      1. If aid + outside help covers the premium, pressure is 0.
      2. If savings are massive relative to the premium, pressure is 0.
      3. If income is massive and debt is low, pressure is 0.
    */

    if (uncoveredPremium === 0) {
      pressureScore = 0;
    } else if (
      savings >= premiumCost * 20 &&
      remainingSavings >= premiumCost * 15
    ) {
      pressureScore = 0;
    } else if (
      income >= premiumCost * 2 &&
      debtRatioAfter <= 8 &&
      totalLiquidMonthsAfter >= 12
    ) {
      pressureScore = 0;
    } else {
      pressureScore += clamp(uncoveredPremiumRatio * 1.5, 0, 30);
      pressureScore += clamp(cashUseRatio * 0.22, 0, 18);
      pressureScore += clamp(debtRatioAfter * 0.65, 0, 28);

      if (borrowed > 0) {
        pressureScore += clamp(borrowedShare * 0.15, 0, 16);
      }

      if (emergencyMonths < 1) {
        pressureScore += savings >= premiumCost * 5 ? 2 : 18;
      } else if (emergencyMonths < 3) {
        pressureScore += savings >= premiumCost * 5 ? 1 : 8;
      } else if (emergencyMonths >= 6) {
        pressureScore -= 8;
      }

      if (savingsMonthsAfter >= 24) pressureScore -= 18;
      else if (savingsMonthsAfter >= 12) pressureScore -= 12;
      else if (savingsMonthsAfter >= 6) pressureScore -= 6;
      else if (cashUsed > 0 && savingsMonthsAfter < 1) pressureScore += 14;

      if (loanToFutureIncome > 0.12 && savings < premiumCost * 5) {
        pressureScore += 10;
      } else if (loanToFutureIncome > 0.08 && savings < premiumCost * 5) {
        pressureScore += 6;
      } else if (loanToFutureIncome > 0 && loanToFutureIncome <= 0.04) {
        pressureScore -= 5;
      }

      if (programStrength === "strong") pressureScore -= 10;
      else if (programStrength === "weak") pressureScore += 14;

      if (residencyChance === "likely") pressureScore -= 5;
      else if (residencyChance === "unlikely") pressureScore += 6;

      if (giftHelp >= premiumCost * 0.75) pressureScore -= 14;
      else if (giftHelp >= premiumCost * 0.5) pressureScore -= 10;
      else if (giftHelp >= premiumCost * 0.25) pressureScore -= 5;

      if (expectedSalary >= 85000 && programStrength === "strong") {
        pressureScore -= 8;
      }

      if (
        savings >= premiumCost * 12 &&
        remainingSavings >= premiumCost * 10 &&
        debtRatioAfter <= 12
      ) {
        pressureScore = Math.min(pressureScore, 5);
      }

      if (
        savings >= premiumCost * 8 &&
        remainingSavings >= premiumCost * 6 &&
        debtRatioAfter <= 15
      ) {
        pressureScore = Math.min(pressureScore, 10);
      }

      if (
        borrowed === 0 &&
        uncoveredPremium <= income &&
        debtRatioAfter <= 10 &&
        totalLiquidMonthsAfter >= 12
      ) {
        pressureScore = Math.min(pressureScore, 5);
      }
    }

    pressureScore = clamp(Math.round(pressureScore), 0, 100);

    const level = getPressureLevel(pressureScore);

    scoreText.textContent = `${level.label}  -  ${pressureScore}/100`;
    fillBar.style.width = `${pressureScore}%`;
    fillBar.className = `fill ${level.colorClass}`;

    let explanation = "";

    if (pressureScore === 0 && uncoveredPremium === 0) {
      explanation =
        "This out-of-state premium creates no measurable pressure because aid and outside help fully cover the extra annual cost.";
    } else if (pressureScore === 0) {
      explanation =
        "This out-of-state premium creates virtually no measurable pressure based on the income, savings, debt, borrowing, and liquid cushion entered.";
    } else if (pressureScore <= 30) {
      explanation =
        "This out-of-state premium appears manageable. The main job is confirming the school actually improves the academic or career outcome.";
    } else if (pressureScore <= 60) {
      explanation =
        "This out-of-state premium may work, but it deserves caution. Aid, borrowing, residency assumptions, and cheaper alternatives should be tested before committing.";
    } else {
      explanation =
        "This out-of-state premium could create significant financial pressure. The cheaper school, more aid, lower borrowing, or a clearer payoff would likely be safer.";
    }

    resultDetails.innerHTML = `
      <p><strong>Extra annual premium:</strong> ${formatDollars(premiumCost)}.</p>

      <p><strong>Aid and outside help applied:</strong> ${formatDollars(giftHelp)}.</p>

      <p><strong>Uncovered annual premium:</strong> ${formatDollars(uncoveredPremium)}.</p>

      <p><strong>Uncovered premium impact:</strong> ${uncoveredPremiumRatio.toFixed(1)}% of annual take-home income.</p>

      <p><strong>Estimated loan payment:</strong> About ${formatDollars(estimatedLoanPayment)} per month based on uncovered borrowing.</p>

      <p><strong>Debt impact after borrowing:</strong> ${debtRatioAfter.toFixed(1)}% of monthly take-home income, including estimated student loan payment.</p>

      <p><strong>Emergency fund coverage:</strong> ${emergencyMonths.toFixed(1)} months of take-home income.</p>

      <p><strong>Savings after planned cash use:</strong> About ${savingsMonthsAfter.toFixed(1)} months of take-home income.</p>

      <p><strong>Total liquid cushion after premium:</strong> About ${totalLiquidMonthsAfter.toFixed(1)} months of take-home income.</p>

      <p><strong>Pressure level:</strong> ${level.stress}.</p>

      <p>${explanation} Recommended next step: ${level.action}</p>
    `;

    guidance.textContent = "";
  }

  document
    .getElementById("tuitionButton")
    .addEventListener("click", calculateOutOfStatePressure);
</script>
</Layout>
