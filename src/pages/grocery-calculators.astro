---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators";

const groceryCalculators = calculators.filter((calculator) =>
  ["Groceries", "Food"].includes(calculator.category)
);

const groceryFaqs = [
  {
    question: "How much should I spend on groceries each month?",
    answer:
      "A realistic grocery budget depends on household size, take-home income, local food prices, debt, savings, and how much room is left after fixed bills.",
  },
  {
    question: "Is a high grocery bill always bad?",
    answer:
      "No. Groceries are essential, and a higher bill may be reasonable for a larger household, special diet, or expensive area. The concern is whether food costs crowd out savings, bills, or debt payoff.",
  },
  {
    question: "Should dining out count as grocery spending?",
    answer:
      "Usually no. Groceries and dining out are both food costs, but they behave differently in a budget. Dining out is usually more flexible and should be reviewed separately.",
  },
  {
    question: "What makes a grocery budget risky?",
    answer:
      "A grocery budget becomes risky when it leaves little room for rent, utilities, transportation, debt payments, emergency savings, or unexpected expenses.",
  },
];
---

<Layout
  title="Grocery Budget Calculators | Food Spending and Monthly Grocery Costs"
  description="Use grocery budget calculators to evaluate monthly food spending, dining out, household size, income, debt, savings, and financial pressure."
>
  <style>
    .container {
      width: 92%;
      max-width: 1100px;
      margin: 0 auto;
      padding-bottom: 72px;
    }

    .hero {
      padding: 64px 0 34px;
      text-align: center;
    }

    .eyebrow {
      color: var(--primary);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(2.7rem, 6vw, 4.8rem);
      line-height: 1;
      margin: 0 0 24px;
      color: var(--primary);
    }

    .hero p {
      max-width: 840px;
      margin: 0 auto;
      font-size: 1.12rem;
      line-height: 1.85;
      color: var(--muted);
    }

    .section {
      margin-top: 56px;
    }

    .section-title {
      font-size: 2rem;
      color: var(--primary);
      margin-bottom: 18px;
      line-height: 1.2;
    }

    .section-intro {
      max-width: 840px;
      color: var(--muted);
      line-height: 1.8;
      font-size: 1.05rem;
      margin-bottom: 28px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      margin-top: 24px;
    }

    .verdict-bar {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 28px;
      margin-top: 28px;
    }

    .verdict-label {
      color: var(--primary);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .verdict-bar h2 {
      color: var(--primary);
      font-size: 1.65rem;
      line-height: 1.25;
      margin: 0 0 14px;
    }

    .verdict-bar p {
      color: var(--muted);
      line-height: 1.8;
      margin: 0;
    }

    .info-card,
    .link-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
    }

    .link-card {
      display: block;
      color: inherit;
      text-decoration: none;
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .info-card h3,
    .link-card strong {
      display: block;
      color: var(--primary);
      margin: 0 0 12px;
      font-size: 1.18rem;
      line-height: 1.25;
    }

    .info-card p,
    .link-card span {
      color: var(--muted);
      line-height: 1.75;
      margin: 0;
      font-size: 0.97rem;
    }

    @media (max-width: 700px) {
      .hero {
        padding-top: 52px;
      }

      .hero p {
        font-size: 1rem;
      }

      .section-title {
        font-size: 1.65rem;
      }
    }
  </style>

  <div class="container">
    <section class="hero">
      <div class="eyebrow">Grocery Budget Calculators</div>

      <h1>Grocery Budget Calculators for Real Monthly Food Costs</h1>

      <p>
        Grocery spending is one of the easiest monthly expenses to underestimate.
        ShouldISpend helps you evaluate food costs using household size, income,
        debt, emergency savings, dining habits, and the financial pressure
        created by recurring food bills.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">Start with the Grocery and Food Calculators</h2>

      <p class="section-intro">
        These calculators help you decide whether your grocery spending, monthly
        food budget, or dining-out habits are reasonable for your household — or
        whether they may be creating pressure elsewhere in your budget.
      </p>

      <div class="grid">
        {groceryCalculators.map((calculator) => (
          <CalculatorCard {...calculator} />
        ))}
      </div>
    </section>

    <section class="section">
      <div class="verdict-bar">
        <div class="verdict-label">Grocery Spending Verdict</div>

        <h2>
          A grocery budget works only if it leaves room for savings, bills, debt,
          and normal life.
        </h2>

        <p>
          Food is essential, but grocery spending can still become a budget
          problem when it quietly crowds out emergency savings, debt payoff,
          rent, utilities, childcare, transportation, or other monthly needs.
          The best grocery budget is sustainable, realistic, repeatable, and
          flexible enough to survive an expensive month without creating credit
          card pressure.
        </p>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">What Grocery Affordability Depends On</h2>

      <p class="section-intro">
        Grocery affordability depends on more than household size. A monthly
        food budget that feels manageable for one household can create stress
        for another if debt, rent, savings, income, or family needs are different.
      </p>

      <div class="info-grid">
        <div class="info-card">
          <h3>Household Size</h3>
          <p>
            A single adult, couple, family of four, and larger household all
            need different grocery expectations.
          </p>
        </div>

        <div class="info-card">
          <h3>Take-Home Income</h3>
          <p>
            Grocery spending should be judged against the money actually
            available after taxes, benefits, and payroll deductions.
          </p>
        </div>

        <div class="info-card">
          <h3>Debt Pressure</h3>
          <p>
            Credit cards, loans, and other monthly obligations can make an
            otherwise normal grocery bill feel much heavier.
          </p>
        </div>

        <div class="info-card">
          <h3>Emergency Savings</h3>
          <p>
            A household with a thin emergency fund may need a more cautious
            grocery target until savings become more stable.
          </p>
        </div>

        <div class="info-card">
          <h3>Dining Out</h3>
          <p>
            Restaurant spending, delivery, coffee, snacks, and convenience food
            can hide the true size of a household food budget.
          </p>
        </div>

        <div class="info-card">
          <h3>Repeatability</h3>
          <p>
            The best food budget is one you can actually repeat month after
            month without unrealistic restriction or financial drift.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Related Budget and Spending Hubs</h2>

      <p class="section-intro">
        Grocery spending connects closely to rent, debt, emergency savings, and
        general budget rules. Use these hubs to understand the larger financial
        picture around food costs.
      </p>

      <div class="link-grid">
        <a class="link-card" href="/budget-rule-calculators">
          <strong>Budget Rule Calculators</strong>
          <span>
            Compare spending decisions against income, savings, debt, and
            monthly flexibility.
          </span>
        </a>

        <a class="link-card" href="/how-much-debt-is-too-much">
          <strong>How Much Debt Is Too Much?</strong>
          <span>
            Understand when monthly obligations begin to reduce stability and
            flexibility.
          </span>
        </a>

        <a class="link-card" href="/how-much-emergency-savings-should-i-have">
          <strong>Emergency Savings Guide</strong>
          <span>
            See how much cushion you may need before taking on larger spending
            commitments.
          </span>
        </a>

        <a class="link-card" href="/calculators">
          <strong>All ShouldISpend Calculators</strong>
          <span>
            Browse calculators for groceries, rent, cars, travel, weddings,
            debt, and major life expenses.
          </span>
        </a>
      </div>
    </section>

    <FAQSection title="Grocery Budget Calculator FAQ" faqs={groceryFaqs} />
  </div>
</Layout>