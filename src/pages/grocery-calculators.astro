---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const groceryCalculators = calculators.filter(
  (calculator) => calculator.category === "Groceries"
);

const groceryFaqs = [
  {
    question: "How much should I spend on groceries each month?",
    answer:
      "A healthy grocery budget depends on take-home income, household size, food prices in your area, dietary needs, debt, savings, and how often you eat out. The safest budget covers realistic meals without weakening rent, debt payments, emergency savings, or medical needs.",
  },
  {
    question: "Is a high grocery bill always a problem?",
    answer:
      "No. A high grocery bill may be reasonable for a large household, special diets, food allergies, high-protein meals, or a family trying to avoid restaurants. It becomes a problem when it creates debt, drains savings, or leaves no room for other essentials.",
  },
  {
    question: "Should groceries be judged differently from restaurants?",
    answer:
      "Yes. Groceries are usually more essential than restaurants, delivery, and convenience food. A household should usually cut restaurant spending before cutting basic groceries, especially when children, health needs, or dietary restrictions are involved.",
  },
  {
    question: "Why does my grocery budget feel impossible to control?",
    answer:
      "Grocery pressure often comes from a mix of inflation, household size, convenience purchases, food waste, special diets, snacks, drinks, and weak meal planning. The problem is rarely one item. It is usually the pattern across the month.",
  },
  {
    question: "Should I use emergency savings for groceries?",
    answer:
      "Emergency savings can be appropriate if groceries are needed during a short-term income disruption. But if savings are being used for groceries every month, that usually signals a budget, income, debt, or housing-cost problem that needs a bigger fix.",
  },
  {
    question: "What should I cut first if groceries are too expensive?",
    answer:
      "Start with food waste, delivery, convenience meals, premium snacks, drinks, duplicate ingredients, and unplanned trips. Do not start by cutting basic nutrition, children's food, medical diets, or essential household staples.",
  },
];

const featuredGroceryLinks = [
  {
    href: "/ideal-grocery-budget-calculator",
    title: "Ideal Grocery Budget Calculator",
    text:
      "Find a realistic monthly grocery range using income, household size, food needs, savings, debt, and restaurant spending.",
  },
  {
    href: "/should-i-spend-1500-on-groceries-per-month",
    title: "$1,500 Grocery Calculator",
    text:
      "Pressure-test a high monthly grocery bill against household size, income, savings, debt, and eating-out costs.",
  },
  {
    href: "/should-i-spend-this-much-on-groceries-per-month",
    title: "Grocery Spending Calculator",
    text:
      "Evaluate whether your current grocery total is supporting the household or creating monthly pressure.",
  },
  {
    href: "/should-i-meal-prep-or-eat-out",
    title: "Meal Prep vs. Eating Out Calculator",
    text:
      "Compare groceries, meal prep, restaurant spending, convenience costs, time pressure, and realistic follow-through.",
  },
];

const groceryCategories = [
  {
    title: "Core meal staples",
    text:
      "Proteins, grains, produce, dairy alternatives, eggs, beans, pasta, rice, frozen vegetables, and basic meal ingredients usually deserve more protection than snacks or convenience items.",
  },
  {
    title: "Convenience foods",
    text:
      "Pre-cut produce, frozen meals, ready-made dinners, deli meals, and packaged lunches save time but can quietly raise the monthly grocery total.",
  },
  {
    title: "Snacks and drinks",
    text:
      "Chips, bars, soda, energy drinks, coffee drinks, desserts, and specialty beverages often create budget pressure because they are easy to buy repeatedly.",
  },
  {
    title: "Special diet costs",
    text:
      "Gluten-free, dairy-free, high-protein, allergy-safe, medical, or child-specific foods may cost more and should not be judged like optional splurges.",
  },
  {
    title: "Household consumables",
    text:
      "Paper products, cleaning supplies, diapers, wipes, toiletries, pet food, and pharmacy items can inflate a grocery receipt even when food spending is not the main issue.",
  },
  {
    title: "Eating-out replacement",
    text:
      "A higher grocery bill can be financially smart if it replaces restaurants, delivery, drive-thru meals, or convenience spending.",
  },
];

const pressureFactors = [
  {
    title: "Household size",
    text:
      "A grocery bill that looks high for one person may be normal for a family. Adults, children, teenagers, and dietary needs all matter.",
  },
  {
    title: "Take-home income",
    text:
      "Grocery pressure should be compared against take-home pay, not gross salary. The real question is how much money is available after taxes and deductions.",
  },
  {
    title: "Food waste",
    text:
      "Throwing away food is one of the fastest ways to turn a reasonable grocery budget into a stressful one.",
  },
  {
    title: "Restaurant spending",
    text:
      "Groceries and restaurants should be viewed together. A high grocery bill may be fine if restaurant spending is low.",
  },
  {
    title: "Debt and housing costs",
    text:
      "Groceries become harder to manage when rent, mortgage payments, car payments, credit cards, or medical bills already consume too much income.",
  },
  {
    title: "Savings cushion",
    text:
      "A grocery budget is safer when the household can buy food without using credit cards or draining emergency savings.",
  },
];

const redFlags = [
  "You regularly put groceries on a credit card and cannot pay it off.",
  "You use emergency savings for normal grocery trips every month.",
  "Restaurant spending stays high while groceries also keep rising.",
  "You throw away a large amount of food each week.",
  "You make several unplanned grocery trips every week.",
  "Snacks, drinks, and convenience items are crowding out actual meals.",
  "The grocery bill is causing missed debt payments, rent pressure, or overdrafts.",
  "You are cutting nutrition while still spending heavily on delivery or restaurants.",
];

const reduceCostTips = [
  {
    title: "Plan around meals, not ingredients",
    text:
      "A grocery list works better when it starts with actual breakfasts, lunches, dinners, and leftovers instead of random items that may not become meals.",
  },
  {
    title: "Protect cheap repeatable meals",
    text:
      "Every household benefits from a few reliable low-cost meals that people will actually eat. These meals reduce panic trips and delivery spending.",
  },
  {
    title: "Cut waste before cutting nutrition",
    text:
      "Use what is already in the freezer, pantry, and fridge before buying more. Waste reduction is usually safer than cutting fruits, proteins, or necessary dietary foods.",
  },
  {
    title: "Separate food from household goods",
    text:
      "If the receipt includes diapers, pet food, toiletries, paper products, and cleaning supplies, the food budget may not be the real problem.",
  },
  {
    title: "Limit convenience premiums",
    text:
      "Pre-made meals, individually packaged snacks, bottled drinks, and delivery substitutes can be useful, but they should be intentional instead of automatic.",
  },
  {
    title: "Use restaurant savings to fund groceries",
    text:
      "A larger grocery budget may be the right move if it helps the household avoid drive-thru meals, delivery fees, and expensive last-minute food choices.",
  },
];

const assumptions = [
  "Monthly income means take-home pay available to support the household, not gross income.",
  "Groceries are treated as an essential expense, but pressure rises when spending creates debt or weakens other essentials.",
  "Large households, teenagers, dietary restrictions, allergies, and medical food needs can justify higher grocery spending.",
  "Restaurants, delivery, and convenience food should be evaluated alongside groceries because they all serve the same food budget.",
  "A high grocery bill is less concerning when emergency savings, rent, debt, and other essentials remain stable.",
  "The best grocery budget is realistic enough to be followed, not so strict that it causes repeated failure or more restaurant spending.",
];

const relatedGuides = [
  {
    title: "Budget Rule Calculators",
    href: "/budget-rule-calculators",
    text:
      "Compare grocery spending against take-home income, savings, debt, and other household pressure points.",
  },
  {
    title: "Emergency Savings Calculator",
    href: "/how-much-emergency-savings-should-i-have",
    text:
      "See how much cash cushion you may need before grocery costs become a recurring emergency.",
  },
  {
    title: "How Much Debt Is Too Much?",
    href: "/how-much-debt-is-too-much",
    text:
      "Understand whether debt payments are making normal food costs harder to absorb.",
  },
  {
    title: "Rent Calculators",
    href: "/rent-calculators",
    text:
      "Review rent pressure when housing costs leave too little money for groceries and essentials.",
  },
  {
    title: "Medical Cost Calculators",
    href: "/medical-calculators",
    text:
      "Compare grocery pressure with medical costs, prescriptions, and health-related expenses.",
  },
  {
    title: "All Calculators",
    href: "/calculators",
    text:
      "Browse every ShouldISpend calculator for household spending, debt, savings, travel, rent, college, and more.",
  },
];

const internalLinks = [
  { href: "/ideal-grocery-budget-calculator", label: "ideal grocery budget" },
  { href: "/should-i-spend-1500-on-groceries-per-month", label: "$1,500 groceries" },
  { href: "/should-i-spend-this-much-on-groceries-per-month", label: "grocery spending calculator" },
  { href: "/should-i-meal-prep-or-eat-out", label: "meal prep vs eating out" },
  { href: "/how-much-emergency-savings-should-i-have", label: "emergency savings" },
  { href: "/rent-calculators", label: "rent calculators" },
  { href: "/medical-calculators", label: "medical calculators" },
  { href: "/calculators", label: "all calculators" },
];
---

<Layout
  title="Grocery Budget Calculators | Food Costs, Household Pressure and Savings"
  description="Use grocery budget calculators to evaluate food spending, household size, take-home income, restaurant costs, savings pressure, and monthly affordability."
>
  <style>
    .hub-page {
      width: 92%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 72px 0 20px;
    }

    .hero {
      max-width: 940px;
      margin-bottom: 56px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      max-width: 980px;
      font-size: clamp(2.75rem, 6.4vw, 5rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      margin: 0 0 24px;
      color: var(--text);
    }

    h2 {
      font-size: clamp(1.85rem, 3.6vw, 2.65rem);
      line-height: 1.08;
      letter-spacing: -0.035em;
      margin: 0 0 18px;
      color: var(--text);
    }

    h3 {
      color: var(--text);
      font-size: 1.15rem;
      line-height: 1.32;
      margin: 0 0 10px;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.85;
      font-size: 1.04rem;
    }

    .intro {
      max-width: 880px;
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.85;
      margin: 0 0 18px;
    }

    .section {
      margin-top: 76px;
      max-width: 920px;
    }

    .wide-section {
      margin-top: 76px;
    }

    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      margin-top: 34px;
    }

    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      margin-top: 28px;
    }

    .verdict-bar,
    .callout {
      margin-top: 56px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 32px;
      box-shadow: var(--shadow-soft);
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .info-card,
    .link-card {
      display: block;
      border: 1px solid var(--border);
      background: var(--card);
      border-radius: 20px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: var(--shadow-soft);
    }

    .info-card p,
    .link-card span {
      display: block;
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .link-card strong {
      display: block;
      color: var(--text);
      line-height: 1.3;
      font-size: 1.08rem;
      margin: 0 0 10px;
    }

    .check-list,
    .red-flag-list {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .check-list li,
    .red-flag-list li {
      margin: 0;
      padding: 15px 16px;
      border-radius: 16px;
      line-height: 1.55;
      font-size: 0.96rem;
    }

    .red-flag-list li {
      border: 1px solid #fecaca;
      background: #fff7f7;
      color: #7f1d1d;
    }

    .check-list li {
      border: 1px solid #cfeee1;
      background: #f1fbf6;
      color: #173404;
    }

    .inline-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .inline-links a {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 800;
      font-size: 0.92rem;
      background: var(--card);
    }

    .inline-links a:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .dark-callout {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
      color: #ffffff;
    }

    .dark-callout h2 {
      color: #ffffff;
    }

    .dark-callout p {
      color: #e7eadf;
    }

    @media (max-width: 720px) {
      .hub-page {
        padding: 56px 0 12px;
      }

      h1 {
        font-size: 2.55rem;
        line-height: 1.03;
      }

      .intro,
      p,
      li {
        font-size: 1rem;
      }

      .grid,
      .info-grid,
      .link-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .section,
      .wide-section {
        margin-top: 58px;
      }

      .verdict-bar,
      .callout {
        padding: 24px;
      }
    }
  </style>

  <main class="hub-page">
    <section class="hero">
      <div class="eyebrow">Grocery Budget Calculators</div>

      <h1>Groceries are essential, but the grocery bill can still break the budget.</h1>

      <p class="intro">
        Food spending is hard to judge because groceries are both necessary and
        flexible. A household can overspend on waste, snacks, drinks, convenience
        meals, and duplicate trips. It can also spend too little on real food and
        end up relying on restaurants, delivery, or emergency spending later.
      </p>

      <p class="intro">
        These calculators help pressure-test grocery costs against take-home income,
        household size, restaurant spending, debt, savings, and monthly breathing room.
      </p>

      <div class="inline-links">
        {internalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Start here</div>
      <h2>Common grocery budget decisions</h2>

      <div class="link-grid">
        {featuredGroceryLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    {groceryCalculators.length > 0 && (
      <section class="wide-section">
        <div class="eyebrow">All grocery calculators</div>
        <h2>Grocery and food affordability calculators</h2>

        <p>
          Use these tools to compare grocery spending, eating out, meal prep,
          leftovers, household size, income, savings, debt, and the pressure food
          costs create across the rest of the month.
        </p>

        <div class="grid">
          {groceryCalculators.map((calculator) => (
            <CalculatorCard
              category={calculator.category}
              title={calculator.title}
              description={calculator.description}
              href={calculator.href}
            />
          ))}
        </div>
      </section>
    )}

    <div class="verdict-bar">
      <div class="verdict-label">Grocery pressure</div>

      <h2>The warning sign is not the grocery number by itself.</h2>

      <p>
        A grocery bill can be high for good reasons: a larger family, teenagers,
        allergies, medical diets, high-protein meals, or a deliberate choice to cook
        at home instead of eating out. The warning sign is when groceries require
        credit cards, drain emergency savings, crowd out rent, prevent debt payoff,
        or leave no room for the next normal bill.
      </p>
    </div>

    <section class="section">
      <div class="eyebrow">Decision framework</div>
      <h2>What grocery affordability really means</h2>

      <p>
        Grocery affordability is not just about spending less. A budget that looks
        perfect on paper can fail if it does not buy enough food, ignores dietary
        needs, or forces the household into takeout by Wednesday.
      </p>

      <p>
        The better question is whether grocery spending fits inside the household's
        full financial picture. If rent, debt, car payments, medical bills, and
        utilities are already tight, even a normal grocery bill can feel impossible.
        If savings are strong and restaurant spending is low, a larger grocery bill
        may be reasonable.
      </p>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Cost categories</div>
      <h2>What grocery costs can include</h2>

      <div class="info-grid">
        {groceryCategories.map((category) => (
          <div class="info-card">
            <h3>{category.title}</h3>
            <p>{category.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Pressure factors</div>
      <h2>What makes grocery spending manageable or risky</h2>

      <p>
        A grocery calculator should not treat food like a luxury purchase. It should
        look at whether the household can eat normally without creating debt, draining
        savings, or relying on restaurants to fill the gaps.
      </p>

      <div class="info-grid">
        {pressureFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Lower the pressure</div>
      <h2>Ways to make grocery spending safer</h2>

      <div class="info-grid">
        {reduceCostTips.map((tip) => (
          <div class="info-card">
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="eyebrow">Warning signs</div>
      <h2>Grocery budget red flags</h2>

      <p>
        These warning signs suggest grocery spending is becoming part of a larger
        household money problem.
      </p>

      <ul class="red-flag-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="eyebrow">When spending more can make sense</div>
      <h2>A higher grocery bill can be the right move.</h2>

      <p>
        Spending more on groceries can make sense when it reduces restaurant
        spending, supports a medical or allergy need, feeds a larger household, or
        makes home meals realistic.
      </p>

      <p>
        The danger is assuming every grocery purchase is essential just because it
        came from a grocery store. Snacks, drinks, convenience meals, duplicate
        pantry items, and household goods can make a food budget look worse than it
        really is.
      </p>
    </section>

    <section class="section">
      <div class="eyebrow">Assumptions</div>
      <h2>How these calculators think about grocery costs</h2>

      <p>
        These assumptions help keep grocery pressure results realistic across
        different households.
      </p>

      <ul class="check-list">
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="wide-section">
      <div class="eyebrow">Related tools</div>
      <h2>Other calculators that connect to grocery spending</h2>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>
            <span>{guide.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="callout dark-callout">
      <div class="eyebrow">Use these as pressure tests</div>

      <h2>Food is not optional. The goal is to find pressure, not guilt.</h2>

      <p>
        ShouldISpend grocery calculators are educational tools. Use them to identify
        whether the household is spending intentionally, wasting money, replacing
        restaurant costs, or using groceries as one more sign that the total budget
        needs repair.
      </p>
    </section>

    <FAQSection title="Grocery Budget FAQ" faqs={groceryFaqs} />
  </main>
</Layout>
