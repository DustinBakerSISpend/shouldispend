  <script is:inline>
  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  const getNumber = (id) => {
    const rawValue = document.getElementById(id)?.value;
    const value = Number(rawValue);
    return Number.isFinite(value) && value >= 0 ? value : 0;
  };

  const formatMoney = (value) => {
    return Math.round(value).toLocaleString("en-US", {
      style: "currency",
      currency: "USD",
      maximumFractionDigits: 0,
    });
  };

  function getPressureLevel(score) {
    if (score <= 30) {
      return {
        label: "Low Pressure",
        stress: "Low pressure",
        color: "#16a34a",
        action:
          "This ring purchase appears manageable, but keep the full wedding and emergency-savings picture in view.",
      };
    }

    if (score <= 60) {
      return {
        label: "Moderate Pressure",
        stress: "Moderate pressure",
        color: "#ca8a04",
        action:
          "This ring may work, but consider lowering the price, avoiding financing, or rebuilding savings first.",
      };
    }

    return {
      label: "High Pressure",
      stress: "High pressure",
      color: "#dc2626",
      action:
        "This ring could create real strain. Consider a lower-cost ring, delayed upgrade, or more time to save.",
    };
  }

  function calculateRing() {
    const income = getNumber("income");
    const savings = getNumber("savings");
    const ringCost = getNumber("ringCost");
    const debt = getNumber("debt");
    const weddingBudget = getNumber("weddingBudget");
    const monthlyTakeHome = getNumber("monthlyTakeHome");

    const result = document.getElementById("result");
    const scoreEl = document.getElementById("score");
    const barFill = document.getElementById("barFill");
    const stressEl = document.getElementById("stress");
    const savingsImpactEl = document.getElementById("savingsImpact");
    const incomeImpactEl = document.getElementById("incomeImpact");
    const monthlyImpactEl = document.getElementById("monthlyImpact");
    const debtRatioEl = document.getElementById("debtRatio");
    const weddingStackEl = document.getElementById("weddingStack");
    const remainingSavingsEl = document.getElementById("remainingSavings");
    const guidanceEl = document.getElementById("guidance");

    result.style.display = "block";

    if (income <= 0 || savings <= 0 || ringCost <= 0) {
      scoreEl.textContent = "Add your numbers first";
      barFill.style.width = "0%";
      barFill.style.background = "#16a34a";
      stressEl.innerHTML = "";
      savingsImpactEl.innerHTML = "";
      incomeImpactEl.innerHTML = "";
      monthlyImpactEl.innerHTML = "";
      debtRatioEl.innerHTML = "";
      weddingStackEl.innerHTML = "";
      remainingSavingsEl.innerHTML = "";
      guidanceEl.textContent =
        "Enter a positive income, savings amount, ring cost, debt, expected wedding budget, and take-home pay so the calculator can estimate pressure.";
      return;
    }

    const monthlyIncome = monthlyTakeHome > 0 ? monthlyTakeHome : income / 12;
    const savingsImpact = (ringCost / savings) * 100;
    const annualIncomeImpact = (ringCost / income) * 100;
    const monthlyIncomeImpact = (ringCost / monthlyIncome) * 100;
    const debtRatio = (debt / income) * 100;
    const engagementStack = ringCost + weddingBudget;
    const engagementStackIncomeImpact = (engagementStack / income) * 100;
    const engagementStackSavingsImpact = savings > 0 ? (engagementStack / savings) * 100 : 0;
    const remainingSavings = savings - ringCost;
    const remainingSavingsMonths = remainingSavings / monthlyIncome;

    let pressureScore = 0;

    pressureScore += clamp(savingsImpact * 0.38, 0, 36);
    pressureScore += clamp(monthlyIncomeImpact * 0.22, 0, 24);
    pressureScore += clamp(debtRatio * 0.2, 0, 16);

    if (ringCost > savings) pressureScore += 26;

    if (remainingSavingsMonths < 1 && income < 100000) {
      pressureScore += 18;
    } else if (remainingSavingsMonths < 3 && income < 150000) {
      pressureScore += 10;
    } else if (remainingSavingsMonths >= 6) {
      pressureScore -= 8;
    }

    if (debtRatio >= 75) pressureScore += 12;
    else if (debtRatio >= 40) pressureScore += 8;

    if (weddingBudget > 0) {
      if (engagementStackSavingsImpact >= 90) pressureScore += 14;
      else if (engagementStackSavingsImpact >= 60) pressureScore += 9;
      else if (engagementStackSavingsImpact >= 35) pressureScore += 5;

      if (engagementStackIncomeImpact >= 45) pressureScore += 10;
      else if (engagementStackIncomeImpact >= 25) pressureScore += 6;
    }

    if (
      annualIncomeImpact < 2 &&
      savingsImpact < 10 &&
      remainingSavingsMonths >= 6 &&
      debtRatio < 15
    ) {
      pressureScore -= 12;
    }

    if (
      annualIncomeImpact < 0.75 &&
      monthlyIncomeImpact < 8 &&
      debtRatio < 10
    ) {
      pressureScore = Math.min(pressureScore, 18);
    }

    if (
      annualIncomeImpact < 0.25 &&
      monthlyIncomeImpact < 3 &&
      debtRatio < 5
    ) {
      pressureScore = Math.min(pressureScore, 8);
    }

    if (
      annualIncomeImpact < 0.1 &&
      monthlyIncomeImpact < 1.5 &&
      savingsImpact < 1 &&
      debtRatio < 3 &&
      remainingSavingsMonths >= 12
    ) {
      pressureScore = 0;
    }

    pressureScore = clamp(Math.round(pressureScore), 0, 100);

    const level = getPressureLevel(pressureScore);

    let guidance = "";

    if (pressureScore === 0) {
      guidance =
        `This ${formatMoney(ringCost)} engagement ring appears financially tiny relative to the numbers provided. The ring equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, so the decision is mainly about preference, proposal priorities, and opportunity cost.`;
    } else if (pressureScore <= 30) {
      guidance =
        `This ${formatMoney(ringCost)} engagement ring appears manageable based on the numbers provided. The ring equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, so the main priority is avoiding financing and keeping future wedding costs controlled.`;
    } else if (pressureScore <= 60) {
      guidance =
        `This ${formatMoney(ringCost)} engagement ring may work, but it deserves caution. The ring equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, and the larger engagement season may add pressure if wedding costs are already high.`;
    } else {
      guidance =
        `This ${formatMoney(ringCost)} engagement ring could create real financial strain. The ring equals about ${annualIncomeImpact.toFixed(1)}% of annual income and ${savingsImpact.toFixed(1)}% of savings, so a lower-cost ring, delayed upgrade, or longer savings window would likely be safer.`;
    }

    scoreEl.textContent = `${level.label}  -  ${pressureScore}/100`;
    barFill.style.width = `${pressureScore}%`;
    barFill.style.background = level.color;

    stressEl.innerHTML = `<strong>Pressure level:</strong> ${level.stress}`;
    savingsImpactEl.innerHTML = `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;
    incomeImpactEl.innerHTML = `<strong>Annual income impact:</strong> ${annualIncomeImpact.toFixed(1)}% of annual income`;
    monthlyImpactEl.innerHTML = `<strong>Monthly take-home impact:</strong> ${monthlyIncomeImpact.toFixed(1)}% of one month's take-home pay`;
    debtRatioEl.innerHTML = `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;
    weddingStackEl.innerHTML = `<strong>Ring + expected wedding budget:</strong> ${formatMoney(engagementStack)} total / ${engagementStackIncomeImpact.toFixed(1)}% of annual income`;
    remainingSavingsEl.innerHTML = `<strong>Estimated savings after ring:</strong> ${formatMoney(remainingSavings)} / ${remainingSavingsMonths.toFixed(1)} months of take-home pay`;

    guidanceEl.textContent = `${guidance} Recommended next step: ${level.action}`;
  }

  document
    .getElementById("ringButton")
    .addEventListener("click", calculateRing);
</script>
