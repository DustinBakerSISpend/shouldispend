---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";

const pageUrl = "https://shouldispend.com/should-i-spend-5000-on-an-engagement-ring";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is $5,000 too much to spend on an engagement ring?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "$5,000 can be reasonable or risky depending on income, savings, debt, wedding plans, emergency cushion, and whether the ring requires financing.",
      },
    },
    {
      "@type": "Question",
      name: "Should I finance a $5,000 engagement ring?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Financing an engagement ring can add pressure before wedding costs begin. Paying in cash while preserving emergency savings is usually safer.",
      },
    },
    {
      "@type": "Question",
      name: "How much should I spend on an engagement ring?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A safer ring budget is one that fits your income and savings without creating debt, weakening your emergency fund, or crowding out wedding and housing goals.",
      },
    },
    {
      "@type": "Question",
      name: "Is the three-month salary rule still useful?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The three-month salary rule is not a good affordability test. Real affordability depends on cash flow, debt, savings, and shared financial priorities.",
      },
    },
    {
      "@type": "Question",
      name: "Can a cheaper engagement ring still be meaningful?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. A ring's meaning does not depend on maximizing the price. Many couples are happier when the ring fits comfortably within the larger financial plan.",
      },
    },
  ],
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Should I Spend $5,000 on an Engagement Ring Calculator",
  url: pageUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "All",
  description:
    "An engagement ring affordability calculator that estimates pressure from a $5,000 ring using income, savings, debt, wedding plans, and emergency cushion.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://shouldispend.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Wedding Calculators",
      item: "https://shouldispend.com/wedding-calculators",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Should I Spend $5,000 on an Engagement Ring?",
      item: pageUrl,
    },
  ],
};
---

<Layout
  title="Should I Spend $5,000 on an Engagement Ring? Calculator | ShouldISpend"
  description="Use this $5,000 engagement ring calculator to decide whether the ring fits your income, savings, debt, emergency fund, wedding plans, and monthly flexibility."

  noindex={true}>


  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
      box-sizing: border-box;
    }

    button {
      background: #0f766e;
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
      display: none;
      background: #f8fafc;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
      line-height: 1.05;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

