            <input id="monthlyTakeHome" type="number" placeholder="6200" />
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="ringButton" type="button">
          Get Engagement Ring Verdict
        </button>

        <div class="result" id="result">
          <div class="score" id="score"></div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

