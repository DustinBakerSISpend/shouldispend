---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
---

<Layout title="Should I Spend $8,000 on a Disney Vacation?">

  <style>

    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
    }

    button {
      background: var(--button);
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }

  </style>

<div class="container">

<CalculatorPageShell
  eyebrow="Disney Vacation Calculator"
  title="Should I Spend $8,000 on a Disney Vacation?"
  description="Estimate whether an $8,000 Disney vacation fits your income, savings, debt, emergency cushion, family size, and overall financial flexibility."
>

  <div class="card">

    <h2>Disney Vacation Affordability Verdict</h2>

    <div class="grid">

      <div>
        <label>Annual Household Income</label>
        <input id="income" type="number" placeholder="150000" />
      </div>

      <div>
        <label>Total Savings</label>
        <input id="savings" type="number" placeholder="25000" />
      </div>

      <div>
        <label>Disney Vacation Cost</label>
        <input id="vacation" type="number" placeholder="8000" />
      </div>

      <div>
        <label>Total Debt</label>
        <input id="debt" type="number" placeholder="20000" />

        <div class="helper-link">
          <a href="/what-counts-as-debt">
            Not sure what counts as debt? Read the debt guide
          </a>
        </div>
      </div>

    </div>

    <button id="vacationButton" type="button">
      Get Disney Vacation Verdict
    </button>

    <div class="result">

      <div class="score" id="score">
        Comfortable Disney Vacation - 82/100
      </div>

      <div class="bar">
        <div class="fill" id="barFill"></div>
      </div>

      <div class="metric" id="stress"></div>
      <div class="metric" id="savingsImpact"></div>
      <div class="metric" id="incomeImpact"></div>
      <div class="metric" id="debtRatio"></div>

      <div class="guidance" id="guidance"></div>

      <div class="disclaimer">
        This is a general educational estimate, not financial advice.
      </div>

    </div>

  </div>

<div class="content-section">

<section>
  <h2>What an $8,000 Disney Vacation Really Costs</h2>

  <p>
    A Disney vacation budget can rise quickly because the headline price rarely includes
    everything families actually spend. Park tickets, hotel nights, airfare, rental cars,
    airport transfers, food, snacks, souvenirs, Lightning Lane-style upgrades, stroller rentals,
    character meals, and rest-day activities can all push the final cost higher.
  </p>

  <p>
    An $8,000 Disney trip may be reasonable for a family if it includes several park days,
    moderate hotel choices, flights, meals, and a cushion for extras. It becomes more risky
    when the number only covers the basics and leaves souvenirs, transportation, upgraded
    experiences, and emergency costs to be figured out later.
  </p>

  <p>
    Disney is also different from many vacations because the emotional pressure is real.
    Parents often want the trip to feel special, which can make it easy to approve another
    meal, another souvenir, another park upgrade, or another convenience cost in the moment.
  </p>
</section>

<section>
  <h2>When an $8,000 Disney Vacation Makes Sense</h2>

  <p>
    A Disney trip at this price point makes more sense when the vacation is mostly paid from
    savings, the household still has an emergency cushion afterward, and the trip does not
    create high-interest credit card debt.
  </p>

  <p>
    The budget should include the full Disney reality: tickets, lodging, food, transportation,
    parking, airport costs, souvenirs, and paid line-skipping or premium experiences if your
    family expects to use them.
  </p>

  <p>
    The trip can be worth it when the cost fits the family budget and the memories do not come
    with months of stress after returning home.
  </p>
</section>

<section>
  <h2>When You Should Wait</h2>

  <p>
    Waiting may be smarter if the trip would drain savings, depend on credit cards, delay debt
    payoff, or make normal household bills feel tight afterward.
  </p>

  <p>
    You may not need to cancel the idea completely. A shorter trip, fewer park days, off-site
    hotel, cheaper flights, fewer table-service meals, or a stricter souvenir budget can lower
    the total cost without giving up the Disney experience entirely.
  </p>
</section>

<FAQSection
  title="Disney Vacation FAQ"
  faqs={[
    {
      question: "Is $8,000 enough for a Disney vacation?",
      answer:
        "Yes, $8,000 can be enough for many Disney trips, especially for families that plan carefully. The final cost depends on airfare, hotel tier, park days, tickets, meals, souvenirs, and paid upgrades.",
    },
    {
      question: "Is an $8,000 Disney vacation too expensive?",
      answer:
        "It depends on income, savings, debt, and the emergency cushion left after the trip. It becomes too expensive if it creates credit card debt or makes normal bills harder to manage.",
    },
    {
      question: "Should I use savings or finance a Disney vacation?",
      answer:
        "Savings are usually safer than financing. A Disney trip can feel less magical afterward if the cost turns into months of high-interest credit card payments.",
    },
    {
      question: "What should be included in a Disney vacation budget?",
      answer:
        "A Disney budget should include park tickets, hotel, airfare or gas, rental car or transfers, meals, snacks, souvenirs, stroller rentals, parking, Lightning Lane-style costs, and an emergency cushion.",
    },
    {
      question: "How can I make a Disney vacation cheaper?",
      answer:
        "Consider fewer park days, off-site hotels, cheaper travel dates, packed snacks, fewer table-service meals, limited souvenirs, and avoiding premium upgrades that are not essential to the trip.",
    },
  ]}
/>

<RelatedCalculators
  calculators={[
    {
      category: "Travel",
      title: "Should I Spend $5,000 on a Vacation?",
      href: "/should-i-spend-5000-on-a-vacation",
    },
    {
      category: "Travel",
      title: "Should I Spend $10,000 on a Europe Trip?",
      href: "/should-i-spend-10000-on-a-europe-trip",
    },
    {
      category: "Travel",
      title: "Should I Spend $12,000 on a Cruise?",
      href: "/should-i-spend-12000-on-a-cruise",
    },
    {
      category: "Travel",
      title: "Browse Travel Calculators",
      href: "/travel-calculators",
    },
  ]}
/>

</div>
</CalculatorPageShell>
</div>

<script is:inline>

function calculateVacation() {

  const income = Number(document.getElementById("income").value);
  const savings = Number(document.getElementById("savings").value);
  const vacation = Number(document.getElementById("vacation").value);
  const debt = Number(document.getElementById("debt").value);

  let score = 100;

  const savingsImpact = (vacation / savings) * 100;
  const incomeImpact = (vacation / income) * 100;
  const debtRatio = (debt / income) * 100;

  score -= savingsImpact * 0.22;
  score -= incomeImpact * 0.9;
  score -= debtRatio * 0.18;

  if (savings < vacation) score -= 12;
  if (debt > income * 0.5) score -= 10;

  score = Math.max(0, Math.min(100, Math.round(score)));

  let verdict = "";
  let stress = "";
  let guidance = "";
  let barColor = "";

  if (score >= 80) {
    verdict = "Comfortable Disney Vacation";
    stress = "Low stress";
    guidance =
      "This Disney vacation appears financially manageable based on your income, savings, debt, and remaining emergency cushion.";
    barColor = "#16a34a";
  }

  else if (score >= 60) {
    verdict = "Manageable With Guardrails";
    stress = "Moderate stress";
    guidance =
      "This Disney trip may work, but keep firm limits on tickets, hotel costs, food, souvenirs, and paid park upgrades.";
    barColor = "#ca8a04";
  }

  else if (score >= 40) {
    verdict = "Financial Stretch";
    stress = "High stress";
    guidance =
      "This Disney vacation could create financial pressure. Consider fewer park days, a cheaper hotel, or delaying until more cash is saved.";
    barColor = "#ea580c";
  }

  else {
    verdict = "High Financial Risk";
    stress = "Very high stress";
    guidance =
      "This Disney vacation cost appears too aggressive for the current financial picture, especially if any part would be financed with high-interest debt.";
    barColor = "#b91c1c";
  }

  document.getElementById("score").textContent =
    `${verdict} - ${score}/100`;

  document.getElementById("barFill").style.width =
    `${score}%`;

  document.getElementById("barFill").style.background =
    barColor;

  document.getElementById("stress").innerHTML =
    `<strong>Stress level:</strong> ${stress}`;

  document.getElementById("savingsImpact").innerHTML =
    `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;

  document.getElementById("incomeImpact").innerHTML =
    `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;

  document.getElementById("debtRatio").innerHTML =
    `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

  document.getElementById("guidance").textContent =
    guidance;
}

document.getElementById("vacationButton")
  .addEventListener("click", calculateVacation);

</script>

</Layout>