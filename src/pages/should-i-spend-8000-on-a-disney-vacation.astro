---
import MethodologySection from "../components/MethodologySection.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
---

<Layout
  title="Should I Spend $8,000 on a Disney Vacation?"
  description="Use this Disney vacation calculator to decide whether an $8,000 trip fits your income, savings, debt, and family budget."
>
  <style>
    .container {
      max-width: 950px;
      margin: 0 auto;
      padding: 60px 20px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 28px;
      padding: 34px;
    }

    h2 {
      margin-top: 0;
      font-size: 2rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      font-size: 1.1rem;
    }

    button {
      background: var(--button);
      color: white;
      border: none;
      padding: 16px 28px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 10px;
      display: inline-block;
    }

    .result {
      margin-top: 40px;
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
    }

    .score {
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe3ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #16a34a;
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    .metric {
      margin-bottom: 14px;
      font-size: 1.05rem;
    }

    .guidance {
      margin-top: 26px;
      font-size: 1.15rem;
      line-height: 1.7;
    }

    .disclaimer {
      margin-top: 30px;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: var(--primary);
      font-weight: 600;
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Disney Vacation Calculator"
      title="Should I Spend $8,000 on a Disney Vacation?"
      description="Estimate whether an $8,000 Disney vacation fits your income, savings, debt, emergency cushion, family size, and overall financial flexibility."
    >
      <div class="card">
        <h2>Disney Vacation Affordability Verdict</h2>

        <div class="grid">
          <div>
            <label for="income">Annual Household Income</label>
            <input id="income" type="number" placeholder="150000" />
          </div>

          <div>
            <label for="savings">Total Savings</label>
            <input id="savings" type="number" placeholder="25000" />
          </div>

          <div>
            <label for="vacation">Disney Vacation Cost</label>
            <input id="vacation" type="number" placeholder="8000" />
          </div>

          <div>
            <label for="debt">Total Debt</label>
            <input id="debt" type="number" placeholder="20000" />

            <div class="helper-link">
              <a href="/what-counts-as-debt">
                Not sure what counts as debt? Read the debt guide
              </a>
            </div>
          </div>
        </div>

        <button id="vacationButton" type="button">
          Get Disney Vacation Verdict
        </button>

        <div class="result">
          <div class="score" id="score">
            Comfortable Disney Vacation - 82/100
          </div>

          <div class="bar">
            <div class="fill" id="barFill"></div>
          </div>

          <div class="metric" id="stress"></div>
          <div class="metric" id="savingsImpact"></div>
          <div class="metric" id="incomeImpact"></div>
          <div class="metric" id="debtRatio"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <div class="content-section">
        <section>
          <h2>What an $8,000 Disney Vacation Really Costs</h2>

          <p>
            An $8,000 Disney vacation can be realistic, but only if the number includes the full trip.
            Families often budget for hotel and park tickets first, then underestimate airfare, airport
            transfers, meals, snacks, souvenirs, stroller rentals, parking, character meals, rest-day
            activities, and paid line-skipping options.
          </p>

          <p>
            Disney trips also vary heavily by family size. An $8,000 budget for two adults is very different
            from an $8,000 budget for a family of four, five, or six. Park days, hotel tier, travel dates,
            airfare, and whether you stay on property can change the final price quickly.
          </p>

          <p>
            The safest Disney budget includes tickets, lodging, transportation, food, souvenirs, premium
            park upgrades, and a cushion for hot-weather convenience spending. In the parks, small decisions
            can become expensive fast.
          </p>
        </section>

        <section>
          <h2>Why Disney Vacations Become So Expensive</h2>

          <p>
            Disney vacations are expensive because the trip is built from many separate costs. Park tickets,
            park hopper options, hotel nights, flights, transportation, meals, snacks, souvenirs, and premium
            experiences all stack together.
          </p>

          <p>
            Families may also pay for Lightning Lane-style access, special dining, themed merchandise,
            stroller rentals, photo packages, resort parking, or extra convenience when the weather is hot
            and everyone is tired.
          </p>

          <p>
            The emotional pressure is part of the cost. Parents often want the trip to feel memorable, which
            can make it easier to approve another souvenir, another character meal, or another shortcut in
            the moment.
          </p>
        </section>

        <section>
          <h2>Disney Costs People Forget</h2>

          <p>
            Common forgotten costs include airport food, checked bags, rideshares, sunscreen, rain gear,
            refillable bottles, stroller rentals, resort fees, tips, snacks, phone chargers, souvenirs,
            travel insurance, and meals on arrival and departure days.
          </p>

          <p>
            Families should also budget for fatigue. A rest day, a closer hotel, or a paid convenience can
            make the trip smoother, but those choices should be planned before booking instead of added
            under pressure.
          </p>
        </section>

        <section>
          <h2>When an $8,000 Disney Trip Makes Sense</h2>

          <p>
            An $8,000 Disney trip makes sense when it is mostly paid from savings, leaves the emergency fund
            intact, and does not create high-interest credit card debt after returning home.
          </p>

          <p>
            It is easier to justify when the trip is tied to a major family milestone, the kids are at a good
            age for the parks, and the budget already includes tickets, lodging, food, transportation,
            souvenirs, and premium experiences your family expects to use.
          </p>
        </section>

        <section>
          <h2>When You Should Scale Back</h2>

          <p>
            Scaling back may be smarter if the trip would drain savings, depend on credit cards, delay debt
            payoff, or make normal household bills feel tight afterward.
          </p>

          <p>
            A lower-cost Disney plan can still work. Consider fewer park days, a value hotel, off-property
            lodging, cheaper travel dates, packed snacks, limited souvenirs, fewer table-service meals, or
            skipping park hopper tickets.
          </p>
        </section>

        <FAQSection
          title="Disney Vacation FAQ"
          faqs={[
            {
              question: "Is $8,000 enough for a Disney vacation?",
              answer:
                "Yes, $8,000 can be enough for many Disney vacations, especially with careful planning. The final answer depends on airfare, hotel tier, park days, ticket type, meals, souvenirs, family size, and paid upgrades.",
            },
            {
              question: "Is an $8,000 Disney vacation too expensive?",
              answer:
                "An $8,000 Disney vacation is too expensive if it creates credit card debt, drains emergency savings, or makes normal bills harder to manage. It can be reasonable if it is saved for in advance and fits comfortably within the household budget.",
            },
            {
              question: "Should I use savings or finance a Disney vacation?",
              answer:
                "Savings are usually safer than financing. A Disney trip can become much more expensive if the cost turns into months of high-interest credit card payments.",
            },
            {
              question: "What should be included in a Disney vacation budget?",
              answer:
                "A Disney vacation budget should include park tickets, hotel, airfare or gas, airport transfers, rental car or rideshares, meals, snacks, souvenirs, stroller rentals, parking, travel insurance, Lightning Lane-style costs, and emergency money.",
            },
            {
              question: "Are park hopper tickets worth it?",
              answer:
                "Park hopper tickets can be worth it for experienced Disney travelers who know how they want to move between parks. For families trying to control costs, single-park-per-day tickets may be the better financial choice.",
            },
            {
              question: "How can I make a Disney vacation cheaper?",
              answer:
                "Consider fewer park days, value hotels, off-property lodging, cheaper travel dates, packed snacks, fewer table-service meals, limited souvenirs, and avoiding premium upgrades that are not essential to the trip.",
            },
          ]}
        />

        <MethodologySection
          category="Disney vacation spending"
          updated="May 2026"
        />

        <RelatedCalculators
          calculators={[
            {
              category: "Travel",
              title: "Should I Spend $5,000 on a Vacation?",
              href: "/should-i-spend-5000-on-a-vacation",
            },
            {
              category: "Travel",
              title: "Should I Spend $10,000 on a Europe Trip?",
              href: "/should-i-spend-10000-on-a-europe-trip",
            },
            {
              category: "Travel",
              title: "Should I Spend $12,000 on a Cruise?",
              href: "/should-i-spend-12000-on-a-cruise",
            },
            {
              category: "Travel",
              title: "Browse Travel Calculators",
              href: "/travel-calculators",
            },
          ]}
        />

        <section>
          <h2>Disney Vacation Planning Guide</h2>

          <p>
            Want a deeper breakdown of Disney hotel costs, park tickets, Lightning Lane-style upgrades,
            food, souvenirs, and where families overspend?
          </p>

          <p>
            Read the full guide:
            <a href="/how-to-budget-for-a-disney-vacation">
              How to Budget for a Disney Vacation
            </a>
          </p>
        </section>
      </div>
    </CalculatorPageShell>
  </div>

  <script is:inline>
    function calculateVacation() {
      const income = Number(document.getElementById("income").value);
      const savings = Number(document.getElementById("savings").value);
      const vacation = Number(document.getElementById("vacation").value);
      const debt = Number(document.getElementById("debt").value);

      let score = 100;

      const savingsImpact = savings > 0 ? (vacation / savings) * 100 : 100;
      const incomeImpact = income > 0 ? (vacation / income) * 100 : 100;
      const debtRatio = income > 0 ? (debt / income) * 100 : 50;

      score -= savingsImpact * 0.22;
      score -= incomeImpact * 0.9;
      score -= debtRatio * 0.18;

      if (savings < vacation) score -= 12;
      if (income > 0 && debt > income * 0.5) score -= 10;

      score = Math.max(0, Math.min(100, Math.round(score)));

      let verdict = "";
      let stress = "";
      let guidance = "";
      let barColor = "";

      if (score >= 80) {
        verdict = "Comfortable Disney Vacation";
        stress = "Low stress";
        guidance =
          "This Disney vacation appears financially manageable based on your income, savings, debt, and remaining emergency cushion.";
        barColor = "#16a34a";
      } else if (score >= 60) {
        verdict = "Manageable With Guardrails";
        stress = "Moderate stress";
        guidance =
          "This Disney trip may work, but keep firm limits on tickets, hotel costs, food, souvenirs, and paid park upgrades.";
        barColor = "#ca8a04";
      } else if (score >= 40) {
        verdict = "Financial Stretch";
        stress = "High stress";
        guidance =
          "This Disney vacation could create financial pressure. Consider fewer park days, a cheaper hotel, or delaying until more cash is saved.";
        barColor = "#ea580c";
      } else {
        verdict = "High Financial Risk";
        stress = "Very high stress";
        guidance =
          "This Disney vacation cost appears too aggressive for the current financial picture, especially if any part would be financed with high-interest debt.";
        barColor = "#b91c1c";
      }

      document.getElementById("score").textContent = `${verdict} - ${score}/100`;
      document.getElementById("barFill").style.width = `${score}%`;
      document.getElementById("barFill").style.background = barColor;

      document.getElementById("stress").innerHTML =
        `<strong>Stress level:</strong> ${stress}`;

      document.getElementById("savingsImpact").innerHTML =
        `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;

      document.getElementById("incomeImpact").innerHTML =
        `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;

      document.getElementById("debtRatio").innerHTML =
        `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

      document.getElementById("guidance").textContent = guidance;
    }

    document.getElementById("vacationButton").addEventListener("click", calculateVacation);
  </script>
</Layout>