---
import CalculatorCard from "../components/CalculatorCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Should I Spend This Much?">

  <style>

    .container {
      width: 92%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero {
      padding: 80px 0 50px;
      text-align: center;
    }

    .eyebrow {
      color: var(--primary);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    h1 {
      font-size: clamp(2.8rem, 7vw, 5rem);
      line-height: 1;
      margin: 0 0 24px;
      color: var(--primary);
    }

    .hero p {
      max-width: 760px;
      margin: 0 auto;
      font-size: 1.2rem;
      line-height: 1.7;
      color: var(--muted);
    }

    .section {
      margin-top: 70px;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 24px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
    }

    .info-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 28px;
    }

    .info-card h3 {
      margin-top: 0;
      font-size: 1.35rem;
      color: var(--primary);
    }

    .info-card p {
      color: var(--muted);
      line-height: 1.7;
    }

    .popular-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }

    .popular-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 22px;
      transition: 0.2s ease;
    }

    .popular-card:hover {
      transform: translateY(-2px);
    }

    .popular-label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 10px;
    }

    .popular-card h3 {
      margin: 0 0 12px;
      font-size: 1.2rem;
      line-height: 1.3;
    }

    .popular-card p {
      color: var(--muted);
      line-height: 1.6;
      font-size: 0.96rem;
      margin-bottom: 18px;
    }

    .popular-link {
      font-weight: 700;
      color: var(--primary);
      text-decoration: none;
    }

    .popular-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 700px) {

      .hero {
        padding-top: 60px;
      }

      .hero p {
        font-size: 1rem;
      }

      .section-title {
        font-size: 1.7rem;
      }

    }

  </style>

  <div class="container">

    <section class="hero">

      <div class="eyebrow">
        Financial Decision Engine
      </div>

      <h1>
        Should I Spend This Much?
      </h1>

      <p>
        Get a fast, practical verdict on whether a purchase,
        subscription, wedding, trip, lifestyle expense,
        or major payment is financially worth it.
      </p>

    </section>

    <section class="section">

      <h2 class="section-title">
        Most Popular Calculators
      </h2>

      <div class="popular-row">

        <div class="popular-card">

          <div class="popular-label">
            Cars
          </div>

          <h3>
            Should I Spend $700 on a Car Payment?
          </h3>

          <p>
            Evaluate whether your monthly vehicle payment is realistic for your income, debt load, and savings cushion.
          </p>

          <a
            class="popular-link"
            href="/should-i-spend-700-on-a-car-payment"
          >
            Open Calculator →
          </a>

        </div>

        <div class="popular-card">

          <div class="popular-label">
            Weddings
          </div>

          <h3>
            Should I Spend $30,000 on a Wedding?
          </h3>

          <p>
            Analyze wedding affordability based on income, savings, debt, financial stress, and long-term flexibility.
          </p>

          <a
            class="popular-link"
            href="/should-i-spend-30000-on-a-wedding"
          >
            Open Calculator →
          </a>

        </div>

        <div class="popular-card">

          <div class="popular-label">
            Travel
          </div>

          <h3>
            Should I Spend $10,000 on a Europe Trip?
          </h3>

          <p>
            Evaluate whether a large international vacation is financially manageable based on savings, debt, and income.
          </p>

          <a
            class="popular-link"
            href="/should-i-spend-10000-on-a-europe-trip"
          >
            Open Calculator →
          </a>

        </div>

        <div class="popular-card">

          <div class="popular-label">
            Rent
          </div>

          <h3>
            Should I Spend 50% of My Income on Rent?
          </h3>

          <p>
            Understand the financial pressure and flexibility risks tied to aggressive rent spending.
          </p>

          <a
            class="popular-link"
            href="/should-i-spend-50-percent-income-on-rent"
          >
            Open Calculator →
          </a>

        </div>

      </div>

    </section>

    <section class="section" id="calculators">

      <h2 class="section-title">
        Start With a Calculator
      </h2>

      <div class="grid">

        <CalculatorCard
          category="Weddings"
          title="Should I Spend $30,000 on a Wedding?"
          description="Analyze wedding affordability based on income, savings, debt, financial stress, and long-term flexibility."
          href="/should-i-spend-30000-on-a-wedding"
        />

        <CalculatorCard
          category="Cars"
          title="Should I Spend $700 on a Car Payment?"
          description="Evaluate whether your monthly vehicle payment is realistic for your income, debt load, and savings cushion."
          href="/should-i-spend-700-on-a-car-payment"
        />

        <CalculatorCard
          category="Travel"
          title="Should I Spend $5,000 on a Vacation?"
          description="Evaluate whether a large vacation expense fits your income, savings, debt load, and long-term flexibility."
          href="/should-i-spend-5000-on-a-vacation"
        />

        <CalculatorCard
          category="Travel"
          title="Should I Spend $10,000 on a Europe Trip?"
          description="Evaluate whether a large international vacation is financially manageable based on savings, debt, and income."
          href="/should-i-spend-10000-on-a-europe-trip"
        />

        <CalculatorCard
          category="Cars"
          title="Should I Spend $1,000 on a Car Payment?"
          description="Analyze whether a luxury-level vehicle payment creates financial strain or remains manageable."
          href="/should-i-spend-1000-on-a-car-payment"
        />

        <CalculatorCard
          category="Rent"
          title="Should I Spend 50% of My Income on Rent?"
          description="Understand the financial pressure and flexibility risks tied to aggressive rent spending."
          href="/should-i-spend-50-percent-income-on-rent"
        />

      </div>

    </section>

    <section class="section">

      <h2 class="section-title">
        Browse Calculator Categories
      </h2>

      <div class="grid">

        <CategoryCard
          category="Weddings"
          title="Wedding Budget Calculators"
          description="Analyze wedding affordability, venue budgets, guest costs, and long-term financial flexibility."
          href="/wedding-calculators"
        />

        <CategoryCard
          category="Cars"
          title="Car Payment Calculators"
          description="Evaluate vehicle affordability, monthly payment pressure, savings impact, and debt stress."
          href="/car-calculators"
        />

        <CategoryCard
          category="Travel"
          title="Vacation Spending Calculators"
          description="Decide whether major trips, Disney vacations, Europe travel, and luxury getaways fit your finances."
          href="/travel-calculators"
        />

        <CategoryCard
          category="Rent"
          title="Rent Affordability Calculators"
          description="Understand whether your rent fits your income, debt load, and long-term financial goals."
          href="/rent-calculators"
        />

        <CategoryCard
          category="Budget Rules"
          title="Budget Rule Calculators"
          description="Use structured budgeting systems like 50/30/20 to evaluate spending and savings balance."
          href="/budget-rule-calculators"
        />

        <CategoryCard
          category="Debt Guide"
          title="What Counts as Debt?"
          description="Learn which financial obligations should be included when evaluating affordability and financial risk."
          href="/what-counts-as-debt"
        />

      </div>

    </section>
<section class="section">

  <h2 class="section-title">
    Financial Planning Guides
  </h2>

  <div class="popular-row">

    <div class="popular-card">

      <div class="popular-label">
        Savings
      </div>

      <h3>
        How Much Emergency Savings Should I Have?
      </h3>

      <p>
        Learn how much emergency cushion may make large purchases,
        vacations, weddings, and lifestyle spending safer.
      </p>

      <a
        class="popular-link"
        href="/how-much-emergency-savings-should-i-have"
      >
        Read Guide →
      </a>

    </div>

    <div class="popular-card">

      <div class="popular-label">
        Travel
      </div>

      <h3>
        How to Avoid Vacation Debt
      </h3>

      <p>
        Learn how to budget trips realistically and avoid turning
        travel memories into long-term financial stress.
      </p>

      <a
        class="popular-link"
        href="/how-to-avoid-vacation-debt"
      >
        Read Guide →
      </a>

    </div>

    <div class="popular-card">

      <div class="popular-label">
        Disney
      </div>

      <h3>
        How to Budget for a Disney Vacation
      </h3>

      <p>
        Understand Disney ticket costs, hotels, food, upgrades,
        souvenirs, and realistic family travel budgeting.
      </p>

      <a
        class="popular-link"
        href="/how-to-budget-for-a-disney-vacation"
      >
        Read Guide →
      </a>

    </div>
<div class="popular-card">
<div class="popular-card">

  <div class="popular-label">
    Housing
  </div>

  <h3>
    How Much Rent Can I Afford?
  </h3>

  <p>
    Learn how income, debt, utilities, transportation,
    and emergency savings affect safe rent levels.
  </p>

  <a
    class="popular-link"
    href="/how-much-rent-can-i-afford"
  >
    Read Guide →
  </a>

</div>
  <div class="popular-label">
    Weddings
  </div>

  <h3>
    How to Budget for a Wedding Without Going Into Debt
  </h3>

  <p>
    Learn how to build a realistic wedding budget, avoid debt pressure,
    and protect emergency savings after the celebration ends.
  </p>

  <a
    class="popular-link"
    href="/how-to-budget-for-a-wedding-without-going-into-debt"
  >
    Read Guide →
  </a>

</div>
  </div>

</section>
    <section class="section how-it-works">

      <h2 class="section-title">
        How ShouldISpend Works
      </h2>

      <div class="info-grid">

        <div class="info-card">

          <h3>
            1. Enter Your Numbers
          </h3>

          <p>
            Add the basic financial details that matter most:
            income, savings, debt, and the cost of the decision
            you are considering.
          </p>

        </div>

        <div class="info-card">

          <h3>
            2. Get a Practical Verdict
          </h3>

          <p>
            Each calculator turns those numbers into a clear
            spending verdict, score, stress level,
            and plain-English explanation.
          </p>

        </div>

        <div class="info-card">

          <h3>
            3. Understand the Tradeoffs
          </h3>

          <p>
            The goal is not just math. It is helping you see
            whether a purchase fits your real financial life
            after bills, debt, and savings pressure.
          </p>

        </div>

      </div>

    </section>

  </div>

</Layout>