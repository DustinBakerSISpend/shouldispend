---
import CategoryCard from "../components/CategoryCard.astro";
import Layout from "../layouts/Layout.astro";
import HowItWorks from "../components/HowItWorks.astro";
import WhyUseShouldISpend from "../components/WhyUseShouldISpend.astro";
---

<Layout
  title="Should I Spend This Much?"
  description="Financial decision calculators for weddings, rent, cars, vacations, debt, and major life expenses."
>
  <style>
    .container {
      width: 92%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero {
      padding: 68px 0 36px;
      text-align: center;
    }

    .eyebrow {
      color: var(--primary);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5.4rem);
      line-height: 0.95;
      margin: 0 0 26px;
      color: var(--primary);
    }

    .hero p {
      max-width: 820px;
      margin: 0 auto;
      font-size: 1.16rem;
      line-height: 1.9;
      color: var(--muted);
    }

    .trust-strip {
      margin-top: 30px;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--muted);
    }

    .section {
      margin-top: 56px;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 26px;
      color: var(--primary);
    }

    .section-intro {
      max-width: 820px;
      color: var(--muted);
      line-height: 1.8;
      margin-bottom: 28px;
      font-size: 1.05rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
    }

    .info-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 28px;
    }

    .info-card h3 {
      margin-top: 0;
      font-size: 1.35rem;
      color: var(--primary);
    }

    .info-card p {
      color: var(--muted);
      line-height: 1.8;
    }

    .popular-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }

    .popular-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
      transition: 0.2s ease;
    }

    .popular-card:hover {
      transform: translateY(-2px);
    }

    .popular-label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 10px;
    }

    .popular-card h3 {
      margin: 0 0 14px;
      font-size: 1.22rem;
      line-height: 1.35;
      color: var(--primary);
    }

    .popular-card p {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.97rem;
      margin-bottom: 18px;
    }

    .popular-link {
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
    }

    .popular-link:hover {
      text-decoration: underline;
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      margin-top: 26px;
    }

    .trust-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
    }

    .trust-card h3 {
      margin-top: 0;
      margin-bottom: 14px;
      color: var(--primary);
      font-size: 1.18rem;
    }

    .trust-card p {
      color: var(--muted);
      line-height: 1.75;
      margin: 0;
    }

    @media (max-width: 700px) {
      .hero {
        padding-top: 56px;
      }

      .hero p {
        font-size: 1rem;
      }

      .section-title {
        font-size: 1.7rem;
      }
    }
  </style>

  <div class="container">

    <section class="hero">

      <div class="eyebrow">
        Financial Decision Engine
      </div>

      <h1>
        Should I Spend This Much?
      </h1>

      <p>
        Practical financial calculators and decision tools for weddings,
        rent, vacations, cars, debt, and major life expenses.
        Evaluate whether a purchase actually fits your income,
        savings, debt load, emergency cushion, and long-term flexibility.
      </p>

      <div class="trust-strip">
        Rent • Weddings • Travel • Cars • Debt • Budgeting
      </div>

    </section>

    <HowItWorks />

    <WhyUseShouldISpend />

    <section class="section">

      <h2 class="section-title">
        Most Popular Calculators
      </h2>

      <p class="section-intro">
        These are some of the most useful calculators on ShouldISpend.
        Each tool combines affordability math with practical financial context,
        including savings pressure, debt load, lifestyle flexibility,
        and long-term tradeoffs.
      </p>

      <div class="popular-row">

        <div class="popular-card">

          <div class="popular-label">
            Cars
          </div>

          <h3>
            Should I Spend $700 on a Car Payment?
          </h3>

          <p>
            Evaluate whether your monthly vehicle payment is realistic after
            insurance, debt payments, savings goals, and normal monthly bills.
          </p>

          <a
            class="popular-link"
            href="/should-i-spend-700-on-a-car-payment"
          >
            Open Calculator →
          </a>

        </div>

        <div class="popular-card">

          <div class="popular-label">
            Weddings
          </div>

          <h3>
            Should I Spend $30,000 on a Wedding?
          </h3>

          <p>
            Analyze wedding affordability using income, savings,
            debt pressure, emergency cushion, and long-term flexibility.
          </p>

          <a
            class="popular-link"
            href="/should-i-spend-30000-on-a-wedding"
          >
            Open Calculator →
          </a>

        </div>

        <div class="popular-card">

          <div class="popular-label">
            Travel
          </div>

          <h3>
            Should I Spend $10,000 on a Europe Trip?
          </h3>

          <p>
            Evaluate whether a major Europe vacation fits your savings,
            debt load, travel budget, and broader financial goals.
          </p>

          <a
            class="popular-link"
            href="/should-i-spend-10000-on-a-europe-trip"
          >
            Open Calculator →
          </a>

        </div>

        <div class="popular-card">

          <div class="popular-label">
            Rent
          </div>

          <h3>
            Should I Spend 50% of My Income on Rent?
          </h3>

          <p>
            Understand the savings pressure, flexibility risk,
            and long-term tradeoffs tied to aggressive rent spending.
          </p>

          <a
            class="popular-link"
            href="/should-i-spend-50-percent-income-on-rent"
          >
            Open Calculator →
          </a>

        </div>

      </div>

    </section>

    <section class="section">

      <h2 class="section-title">
        Browse Calculator Categories
      </h2>

      <p class="section-intro">
        Explore calculators built around real financial decisions —
        not just formulas. Each category focuses on practical affordability,
        long-term pressure, and real-world tradeoffs.
      </p>

      <div class="grid">

        <CategoryCard
          category="Weddings"
          title="Wedding Budget Calculators"
          description="Analyze wedding affordability, venue budgets, guest costs, and long-term financial flexibility."
          href="/wedding-calculators"
        />

        <CategoryCard
          category="Cars"
          title="Car Payment Calculators"
          description="Evaluate vehicle affordability, monthly payment pressure, insurance impact, savings strain, and debt stress."
          href="/car-calculators"
        />

        <CategoryCard
          category="Travel"
          title="Vacation Spending Calculators"
          description="Decide whether Europe trips, Disney vacations, cruises, honeymoons, and family travel fit your finances."
          href="/travel-calculators"
        />

        <CategoryCard
          category="Rent"
          title="Rent Affordability Calculators"
          description="Understand whether your rent fits your income, debt load, utilities, transportation costs, and savings goals."
          href="/rent-calculators"
        />

        <CategoryCard
          category="Budget Rules"
          title="Budget Rule Calculators"
          description="Use structured budgeting systems like 50/30/20 to evaluate spending balance, savings, and financial flexibility."
          href="/budget-rule-calculators"
        />

        <CategoryCard
          category="Debt Guide"
          title="What Counts as Debt?"
          description="Learn which obligations should be included when evaluating affordability and financial pressure."
          href="/what-counts-as-debt"
        />

      </div>

    </section>

    <section class="section">

  <h2 class="section-title">
    Financial Planning Guides
  </h2>

  <p class="section-intro">
    These guides explain the financial logic behind the calculators,
    including housing affordability, emergency savings,
    transportation costs, vacation budgets, rent pressure,
    debt management, and long-term financial flexibility.
  </p>

  <div class="popular-row">

    <div class="popular-card">

      <div class="popular-label">
        Housing
      </div>

      <h3>
        How Much House Can I Afford?
      </h3>

      <p>
        Learn how income, debt, taxes, insurance,
        maintenance, emergency savings, and monthly flexibility
        affect realistic home affordability.
      </p>

      <a
        class="popular-link"
        href="/how-much-house-can-i-afford"
      >
        Read Guide →
      </a>

    </div>

    <div class="popular-card">

      <div class="popular-label">
        Cars
      </div>

      <h3>
        How Much Car Can I Afford?
      </h3>

      <p>
        Learn how to calculate a realistic vehicle budget using income,
        savings, debt load, insurance costs, loan length,
        depreciation, and total ownership cost.
      </p>

      <a
        class="popular-link"
        href="/how-much-car-can-i-afford"
      >
        Read Guide →
      </a>

    </div>

    <div class="popular-card">

      <div class="popular-label">
        Travel
      </div>

      <h3>
        How Much Vacation Can I Afford?
      </h3>

      <p>
        Learn how to calculate a realistic vacation budget using savings,
        debt load, emergency funds, hidden travel costs,
        and post-trip flexibility.
      </p>

      <a
        class="popular-link"
        href="/how-much-vacation-can-i-afford"
      >
        Read Guide →
      </a>

    </div>

    <div class="popular-card">

      <div class="popular-label">
        Savings
      </div>

      <h3>
        How Much Emergency Savings Should I Have?
      </h3>

      <p>
        Learn how much emergency cushion may make major purchases,
        vacations, weddings, and lifestyle spending safer.
      </p>

      <a
        class="popular-link"
        href="/how-much-emergency-savings-should-i-have"
      >
        Read Guide →
      </a>

    </div>

    <div class="popular-card">

      <div class="popular-label">
        Travel
      </div>

      <h3>
        How to Avoid Vacation Debt
      </h3>

      <p>
        Learn how to budget trips realistically and avoid turning
        travel memories into long-term financial stress.
      </p>

      <a
        class="popular-link"
        href="/how-to-avoid-vacation-debt"
      >
        Read Guide →
      </a>

    </div>

    <div class="popular-card">

      <div class="popular-label">
        Disney
      </div>

      <h3>
        How to Budget for a Disney Vacation
      </h3>

      <p>
        Understand Disney ticket costs, hotels, meals,
        add-ons, souvenirs, and realistic family budgeting.
      </p>

      <a
        class="popular-link"
        href="/how-to-budget-for-a-disney-vacation"
      >
        Read Guide →
      </a>

    </div>

    <div class="popular-card">

      <div class="popular-label">
        Housing
      </div>

      <h3>
        How Much Rent Can I Afford?
      </h3>

      <p>
        Learn how income, debt, utilities, transportation,
        and emergency savings affect safe rent levels.
      </p>

      <a
        class="popular-link"
        href="/how-much-rent-can-i-afford"
      >
        Read Guide →
      </a>

    </div>

    <div class="popular-card">

      <div class="popular-label">
        Weddings
      </div>

      <h3>
        How to Budget for a Wedding Without Going Into Debt
      </h3>

      <p>
        Learn how to build a realistic wedding budget,
        avoid debt pressure, and protect emergency savings.
      </p>

      <a
        class="popular-link"
        href="/how-to-budget-for-a-wedding-without-going-into-debt"
      >
        Read Guide →
      </a>

    </div>

  </div>

</section>

    <section class="section how-it-works">

      <h2 class="section-title">
        How ShouldISpend Works
      </h2>

      <div class="info-grid">

        <div class="info-card">

          <h3>
            1. Enter Your Numbers
          </h3>

          <p>
            Add the financial details that matter most:
            income, savings, debt, and the cost of the decision
            you are considering.
          </p>

        </div>

        <div class="info-card">

          <h3>
            2. Get a Practical Verdict
          </h3>

          <p>
            Each calculator turns those numbers into a clear
            affordability verdict, score, stress level,
            and plain-English explanation.
          </p>

        </div>

        <div class="info-card">

          <h3>
            3. Understand the Tradeoffs
          </h3>

          <p>
            The goal is not just math. It is helping you understand
            how a decision affects savings, flexibility,
            debt pressure, and everyday financial life.
          </p>

        </div>

      </div>

    </section>

    <section class="section">

      <h2 class="section-title">
        Why ShouldISpend Exists
      </h2>

      <div class="trust-grid">

        <div class="trust-card">

          <h3>
            Real-World Financial Context
          </h3>

          <p>
            Most calculators only show formulas. ShouldISpend focuses on
            real affordability, including savings pressure,
            debt obligations, emergency cushions, and flexibility.
          </p>

        </div>

        <div class="trust-card">

          <h3>
            Conservative by Design
          </h3>

          <p>
            The calculators are intentionally cautious.
            The goal is not encouraging spending.
            The goal is helping people avoid unnecessary financial stress.
          </p>

        </div>

        <div class="trust-card">

          <h3>
            Educational, Not Financial Advice
          </h3>

          <p>
            ShouldISpend provides educational estimates and decision support.
            It is designed to help users think through tradeoffs before
            making large financial commitments.
          </p>

        </div>

      </div>

    </section>

  </div>

</Layout>