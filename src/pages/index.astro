---
import CategoryCard from "../components/CategoryCard.astro";
import Layout from "../layouts/Layout.astro";

const homepageFaqs = [
  {
    question: "What is ShouldISpend?",
    answer:
      "ShouldISpend helps you pressure-test big spending decisions against your actual income, savings, debt, and monthly breathing room.",
  },
  {
    question: "Are the calculators financial advice?",
    answer:
      "No. They are educational tools meant to help you think through a decision, not a replacement for a financial advisor.",
  },
  {
    question: "How do the calculators work?",
    answer:
      "Each calculator looks at the cost, your income, savings, debt, and related expenses, then gives a verdict on how much room the decision would leave you.",
  },
  {
    question: "What kinds of spending decisions does ShouldISpend cover?",
    answer:
      "ShouldISpend covers the expenses that actually move the needle: rent, groceries, weddings, funerals, medical bills, college, baby costs, vacations, cars, debt, and emergency savings.",
  },
  {
    question: "Why do some calculators give conservative verdicts?",
    answer:
      "Because a thin cushion matters. If a purchase could leave you exposed after the money is gone, the calculators are designed to say so.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homepageFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="Should I Spend This Much?"
  description="Use ShouldISpend calculators to pressure-test weddings, rent, groceries, baby costs, college, funerals, medical bills, cars, travel, debt, and major spending decisions."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap");

    :global(body) {
      background: #fbf8f3;
    }

    .homepage {
      font-family: "Outfit", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #173404;
    }

    .container {
      width: 92%;
      max-width: 1180px;
      margin: 0 auto;
    }

    .hero {
      padding: 76px 0 34px;
      text-align: center;
    }

    .eyebrow {
      color: #0f6e56;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    h1 {
      max-width: 980px;
      margin: 0 auto 24px;
      color: #173404;
      font-size: clamp(2.7rem, 6.8vw, 5.35rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      font-weight: 700;
    }

    .hero-copy {
      max-width: 800px;
      margin: 0 auto;
      color: #5f5e5a;
      font-size: 1.16rem;
      line-height: 1.85;
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 30px;
    }

    .button,
    .button-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 13px 23px;
      font-weight: 800;
      text-decoration: none;
      transition: 0.2s ease;
    }

    .button {
      background: #0f6e56;
      color: #ffffff;
      border: 1px solid #0f6e56;
    }

    .button-secondary {
      color: #0f6e56;
      background: #ffffff;
      border: 1px solid #e3ded3;
    }

    .button:hover,
    .button-secondary:hover {
      transform: translateY(-2px);
    }

    .tag-row {
      margin-top: 30px;
      color: #6d6a62;
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.8;
    }

    .section {
      margin-top: 58px;
    }

    .section-header {
      max-width: 850px;
      margin-bottom: 26px;
    }

    .section-title {
      margin: 0 0 14px;
      color: #173404;
      font-size: clamp(2rem, 3.5vw, 3rem);
      line-height: 1.05;
      letter-spacing: -0.035em;
    }

    .section-intro {
      max-width: 850px;
      margin: 0 0 28px;
      color: #5f5e5a;
      line-height: 1.8;
      font-size: 1.05rem;
    }

    .example-verdict {
      max-width: 860px;
      margin: 22px auto 0;
      background: #ffffff;
      border: 1px solid #e3ded3;
      border-radius: 24px;
      padding: 28px;
      box-shadow: 0 18px 40px rgba(23, 52, 4, 0.07);
    }

    .example-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 22px;
      align-items: center;
    }

    .example-scenario {
      margin: 0 0 10px;
      color: #173404;
      font-size: 1.25rem;
      line-height: 1.45;
      font-weight: 800;
    }

    .example-line {
      margin: 0;
      color: #5f5e5a;
      line-height: 1.75;
      font-size: 1rem;
    }

    .risk-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 92px;
      border-radius: 999px;
      padding: 8px 16px;
      background: #faeeda;
      color: #412402;
      font-weight: 800;
      border: 1px solid #ecd39e;
    }

    .example-link {
      display: inline-flex;
      margin-top: 18px;
      color: #0f6e56;
      font-weight: 800;
      text-decoration: none;
    }

    .example-link:hover {
      text-decoration: underline;
    }

    .how-grid,
    .popular-row,
    .trust-grid,
    .faq-list {
      display: grid;
      gap: 22px;
    }

    .how-grid,
    .popular-row,
    .trust-grid {
      grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .how-card,
    .popular-card,
    .trust-card,
    .faq-item,
    .spotlight,
    .founder-note {
      background: #ffffff;
      border: 1px solid #e3ded3;
      border-radius: 20px;
      padding: 24px;
    }

    .how-card {
      counter-increment: step-counter;
    }

    .how-card .step-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      margin-bottom: 16px;
      border-radius: 999px;
      background: #e1f5ee;
      color: #0f6e56;
      font-weight: 800;
    }

    .how-card h3,
    .popular-card h3,
    .trust-card h3,
    .faq-item h3 {
      margin: 0 0 12px;
      color: #173404;
      font-size: 1.16rem;
      line-height: 1.35;
    }

    .how-card p,
    .popular-card p,
    .trust-card p,
    .faq-item p {
      margin: 0;
      color: #5f5e5a;
      line-height: 1.75;
      font-size: 0.98rem;
    }

    .popular-card {
      transition: 0.2s ease;
    }

    .popular-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 34px rgba(23, 52, 4, 0.07);
    }

    .popular-label {
      margin-bottom: 10px;
      color: #0f6e56;
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 1.1px;
      font-weight: 800;
    }

    .popular-link {
      display: inline-flex;
      margin-top: 18px;
      color: #0f6e56;
      font-weight: 800;
      text-decoration: none;
    }

    .popular-link:hover {
      text-decoration: underline;
    }

    .spotlight {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      gap: 26px;
      align-items: center;
      background:
        linear-gradient(135deg, rgba(15, 110, 86, 0.08), rgba(255, 255, 255, 0.96)),
        #ffffff;
    }

    .spotlight h2 {
      margin: 0 0 14px;
      color: #173404;
      font-size: clamp(2rem, 3.4vw, 2.9rem);
      line-height: 1.05;
      letter-spacing: -0.035em;
    }

    .spotlight p {
      color: #5f5e5a;
      line-height: 1.8;
      margin: 0 0 18px;
      font-size: 1.03rem;
    }

    .spotlight-links {
      display: grid;
      gap: 12px;
    }

    .spotlight-link {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      color: #0f6e56;
      font-weight: 800;
      text-decoration: none;
      background: #ffffff;
      border: 1px solid #e3ded3;
      border-radius: 16px;
      padding: 14px 16px;
    }

    .spotlight-link:hover {
      text-decoration: underline;
    }

    .founder-note {
      max-width: 900px;
      background: #173404;
      color: #ffffff;
      border-color: #173404;
    }

    .founder-note h2 {
      margin: 0 0 14px;
      color: #ffffff;
      font-size: clamp(2rem, 3.2vw, 2.75rem);
      line-height: 1.08;
      letter-spacing: -0.035em;
    }

    .founder-note p {
      color: #e7eadf;
      line-height: 1.85;
      font-size: 1.05rem;
      margin: 0 0 18px;
    }

    .signature {
      color: #ffffff;
      font-weight: 800;
    }

    .faq-section {
      margin-bottom: 72px;
    }

    .faq-list {
      grid-template-columns: 1fr;
      max-width: 900px;
    }

    @media (max-width: 820px) {
      .example-grid,
      .spotlight {
        grid-template-columns: 1fr;
      }

      .risk-badge {
        justify-self: start;
      }
    }

    @media (max-width: 700px) {
      .hero {
        padding-top: 46px;
        padding-bottom: 22px;
      }

      h1 {
        max-width: 340px;
        font-size: clamp(2.05rem, 10.5vw, 2.95rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
      }

      .hero-copy {
        max-width: 330px;
        font-size: 0.98rem;
        line-height: 1.65;
      }

      .hero-actions {
        margin-top: 24px;
        gap: 10px;
      }

      .button,
      .button-secondary {
        width: 100%;
        max-width: 310px;
        padding: 12px 18px;
      }

      .tag-row {
        max-width: 330px;
        margin-left: auto;
        margin-right: auto;
        font-size: 0.86rem;
        line-height: 1.7;
      }

      .example-verdict,
      .how-card,
      .popular-card,
      .trust-card,
      .faq-item,
      .spotlight,
      .founder-note {
        padding: 20px;
      }
    }
  </style>

  <div class="homepage">
    <div class="container">
      <section class="hero">
        <div class="eyebrow">Straight answers, not a lecture</div>

        <h1>Is $30,000 too much for a wedding? Is your rent eating your paycheck?</h1>

        <p class="hero-copy">
          Tell us your numbers. Get a real verdict - go, wait, or rethink it -
          instead of another generic budgeting rule that ignores your actual life.
        </p>

        <div class="hero-actions">
          <a class="button" href="/calculators">Browse Calculators</a>
          <a class="button-secondary" href="/methodology">See How Verdicts Work</a>
        </div>

        <div class="tag-row">
          Baby Costs &bull; College &bull; Medical Bills &bull; Funerals &bull; Groceries &bull; Rent &bull; Weddings &bull; Debt
        </div>
      </section>

      <section class="example-verdict" aria-labelledby="example-verdict-title">
        <div class="eyebrow" id="example-verdict-title">What a verdict actually looks like</div>

        <div class="example-grid">
          <div>
            <p class="example-scenario">
              $700/month car payment. $65,000 income. $8,000 in savings.
            </p>
            <p class="example-line">
              This payment leaves about 6% monthly flexibility - below the cushion we would want to see before you sign.
            </p>
          </div>

          <div class="risk-badge">Risky</div>
        </div>

        <a class="example-link" href="/should-i-spend-700-on-a-car-payment">
          Try it with your own numbers &rarr;
        </a>
      </section>

      <section class="section" id="how-verdicts-work">
        <div class="section-header">
          <div class="eyebrow">How it works</div>
          <h2 class="section-title">A number alone does not tell you if you can afford something</h2>
          <p class="section-intro">
            $30,000 is fine for one household and reckless for another. The difference is everything around the number:
            what you make, what you owe, what you have saved, and what would still be left after the decision.
          </p>
        </div>

        <div class="how-grid">
          <div class="how-card">
            <div class="step-number">1</div>
            <h3>Tell us where you stand</h3>
            <p>Income, savings, debt, and the cost you are considering.</p>
          </div>

          <div class="how-card">
            <div class="step-number">2</div>
            <h3>Get a real verdict</h3>
            <p>Not just affordable or not - a clear read on how much room you would have left.</p>
          </div>

          <div class="how-card">
            <div class="step-number">3</div>
            <h3>See the tradeoff</h3>
            <p>Every big purchase competes with something else. We show what.</p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <div class="eyebrow">Most popular</div>
          <h2 class="section-title">Start with what people are actually Googling at 1 AM</h2>
        </div>

        <div class="popular-row">
          <div class="popular-card">
            <div class="popular-label">Baby & Parenting</div>
            <h3>Baby Cost Calculator</h3>
            <p>
              Childcare, diapers, formula, medical costs - see what a baby actually adds to your monthly numbers, and what is left after.
            </p>
            <a class="popular-link" href="/baby-cost-calculator">Open Calculator &rarr;</a>
          </div>

          <div class="popular-card">
            <div class="popular-label">College</div>
            <h3>College Cost Calculator</h3>
            <p>
              Tuition and scholarships are the easy part. This weighs loans, family contribution, and future-income reality.
            </p>
            <a class="popular-link" href="/college-cost-calculator">Open Calculator &rarr;</a>
          </div>

          <div class="popular-card">
            <div class="popular-label">Medical</div>
            <h3>Should I Spend This Much on Medical Bills?</h3>
            <p>
              Insurance gap, payment plan, or pay it now - see which option actually protects your savings.
            </p>
            <a class="popular-link" href="/should-i-spend-this-much-on-medical-bills">Open Calculator &rarr;</a>
          </div>

