---
import CategoryCard from "../components/CategoryCard.astro";
import Layout from "../layouts/Layout.astro";
import HowItWorks from "../components/HowItWorks.astro";

const homepageFaqs = [
  {
    question: "What is ShouldISpend?",
    answer:
      "ShouldISpend is a financial decision-support website that helps users evaluate major purchases, recurring bills, lifestyle expenses, debt pressure, savings tradeoffs, and major life costs through calculators and educational guides.",
  },
  {
    question: "Are the calculators financial advice?",
    answer:
      "No. ShouldISpend calculators are educational tools designed to help users think through spending decisions. Results are generalized estimates and should not replace professional financial advice.",
  },
  {
    question: "How do the calculators work?",
    answer:
      "Most calculators evaluate spending pressure using factors like income, debt, emergency savings, recurring bills, savings impact, household size, and financial flexibility after a purchase or payment.",
  },
  {
    question: "What kinds of spending decisions does ShouldISpend cover?",
    answer:
      "ShouldISpend covers groceries, rent, weddings, funerals, medical bills, college costs, baby expenses, vacations, car payments, debt levels, emergency savings, and other major expenses.",
  },
  {
    question: "Why do some calculators give conservative verdicts?",
    answer:
      "ShouldISpend prioritizes financial flexibility and long-term stability. Many calculators flag situations where a purchase may leave little emergency cushion, increase debt pressure, or create ongoing monthly stress.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homepageFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="Should I Spend This Much?"
  description="Use verdict-driven financial calculators to evaluate baby costs, college, funerals, medical bills, groceries, rent, weddings, debt, car payments, vacations, and major spending decisions."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <style>
    .container {
      width: 92%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .hero {
      padding: 68px 0 36px;
      text-align: center;
    }

    .eyebrow {
      color: var(--primary);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5.4rem);
      line-height: 0.95;
      margin: 0 0 26px;
      color: var(--primary);
    }

    .hero p {
      max-width: 850px;
      margin: 0 auto;
      font-size: 1.16rem;
      line-height: 1.9;
      color: var(--muted);
    }

    .hero-subtext {
      max-width: 780px;
      margin: 22px auto 0;
      font-size: 1.02rem;
      line-height: 1.8;
      color: var(--muted);
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 30px;
    }

    .hero-button,
    .hero-button-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 13px 22px;
      font-weight: 800;
      text-decoration: none;
      transition: 0.2s ease;
    }

    .hero-button {
      background: var(--primary);
      color: white;
      border: 1px solid var(--primary);
    }

    .hero-button-secondary {
      color: var(--primary);
      background: white;
      border: 1px solid var(--border);
    }

    .hero-button:hover,
    .hero-button-secondary:hover {
      transform: translateY(-2px);
    }

    .trust-strip {
      margin-top: 30px;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--muted);
    }

    .section {
      margin-top: 58px;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 26px;
      color: var(--primary);
    }

    .section-intro {
      max-width: 850px;
      color: var(--muted);
      line-height: 1.8;
      margin-bottom: 28px;
      font-size: 1.05rem;
    }

    .grid,
    .popular-row,
    .trust-grid,
    .faq-list {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .popular-row,
    .trust-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }

    .popular-card,
    .trust-card,
    .faq-item,
    .spotlight {
      background: white;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
    }

    .spotlight {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 24px;
      align-items: center;
      background:
        linear-gradient(135deg, rgba(19, 132, 150, 0.08), rgba(255, 255, 255, 0.95)),
        white;
    }

    .spotlight h2 {
      color: var(--primary);
      font-size: 2rem;
      margin: 0 0 14px;
    }

    .spotlight p {
      color: var(--muted);
      line-height: 1.8;
      margin: 0 0 18px;
    }

    .spotlight-links {
      display: grid;
      gap: 12px;
    }

    .spotlight-link {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      color: var(--primary);
      font-weight: 800;
      text-decoration: none;
      background: white;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px 16px;
    }

    .spotlight-link:hover {
      text-decoration: underline;
    }

    .popular-card {
      transition: 0.2s ease;
    }

    .popular-card:hover {
      transform: translateY(-2px);
    }

    .popular-label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 10px;
    }

    .popular-card h3,
    .trust-card h3,
    .faq-item h3 {
      margin: 0 0 14px;
      font-size: 1.18rem;
      line-height: 1.35;
      color: var(--primary);
    }

    .popular-card p,
    .trust-card p,
    .faq-item p {
      color: var(--muted);
      line-height: 1.75;
      font-size: 0.97rem;
      margin-bottom: 18px;
    }

    .trust-card p,
    .faq-item p {
      margin-bottom: 0;
    }

    .popular-link {
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
    }

    .popular-link:hover {
      text-decoration: underline;
    }

    .faq-section {
      margin-top: 72px;
      margin-bottom: 72px;
    }

    .faq-list {
      grid-template-columns: 1fr;
      max-width: 900px;
    }

    .faq-item {
      border-radius: 20px;
    }

    @media (max-width: 820px) {
      .spotlight {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .hero {
        padding-top: 56px;
      }

      .hero p {
        font-size: 1rem;
      }

      .section-title,
      .spotlight h2 {
        font-size: 1.7rem;
      }
    }
  </style>

  <div class="container">
    <section class="hero">
      <div class="eyebrow">Financial Decision Engine</div>

      <h1>Should I Spend This Much?</h1>

      <p>
        ShouldISpend helps you evaluate whether major purchases, recurring bills,
        and life-stage expenses actually fit your broader financial picture.
        Compare decisions across groceries, rent, weddings, funerals, medical
        bills, college, baby costs, travel, cars, debt, and emergency savings
        using income, debt, savings, household pressure, and long-term flexibility.
      </p>

      <p class="hero-subtext">
        Instead of generic budgeting formulas, ShouldISpend focuses on financial
        pressure, affordability tradeoffs, savings impact, debt burden, and
        real-world monthly flexibility.
      </p>

      <div class="hero-actions">
        <a class="hero-button" href="/calculators">Browse Calculators</a>
        <a class="hero-button-secondary" href="/methodology">How Verdicts Work</a>
      </div>

      <div class="trust-strip">
        Baby Costs • College • Medical Bills • Funerals • Groceries • Rent • Weddings • Debt
      </div>
    </section>

    <HowItWorks />

    <section class="section">
      <div class="spotlight">
        <div>
