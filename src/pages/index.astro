---
import CalculatorCard from "../components/CalculatorCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import Layout from "../layouts/Layout.astro";
---
<Layout title="Should I Spend This Much?">
    <style>
  
      .container {
        width: 92%;
        max-width: 1200px;
        margin: 0 auto;
      }

      .hero {
        padding: 80px 0 50px;
        text-align: center;
      }

      .eyebrow {
        color: var(--accent);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 12px;
      }

      h1 {
        font-size: clamp(2.8rem, 7vw, 5rem);
        line-height: 1;
        margin: 0 0 24px;
        color: var(--primary);
      }

      .hero p {
        max-width: 760px;
        margin: 0 auto;
        font-size: 1.2rem;
        line-height: 1.7;
        color: var(--muted);
      }

      .section {
        margin-top: 70px;
      }

      .section-title {
        font-size: 2rem;
        margin-bottom: 24px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 28px;
        transition: 0.2s ease;
      }

      .card:hover {
        transform: translateY(-3px);
      }

      .card-category {
        color: var(--accent);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
      }

      .card h3 {
        margin: 0 0 14px;
        font-size: 1.6rem;
        line-height: 1.2;
      }

      .card p {
        color: var(--muted);
        line-height: 1.6;
        margin-bottom: 24px;
      }

      .button {
        display: inline-block;
        background: var(--primary);
        color: white;
        padding: 14px 22px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
      }

      .coming-soon {
        opacity: 0.7;
      }

      footer {
        text-align: center;
        padding: 80px 0 40px;
        color: var(--muted);
        font-size: 0.95rem;
      }
.footer {
  border-top: 1px solid var(--border);
  margin-top: 80px;
  padding: 40px 24px;
  text-align: center;
  color: var(--muted);
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 24px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.footer-links a {
  color: var(--text);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
}

.footer-links a:hover {
  color: var(--accent);
}
      @media (max-width: 700px) {
        .hero {
          padding-top: 60px;
        }

        .hero p {
          font-size: 1rem;
        }

        .card h3 {
          font-size: 1.35rem;
        }
      }
    </style>
  
      <div class="container">
      <section class="hero">
        <div class="eyebrow">Financial Decision Engine</div>

        <h1>Should I Spend This Much?</h1>

        <p>
          Get a fast, practical verdict on whether a purchase, subscription,
          wedding, trip, lifestyle expense, or major payment is financially
          worth it.
        </p>
      </section>

      <section class="section" id="calculators">
        <h2 class="section-title">Start With a Calculator</h2>

        <div class="grid">
          <CalculatorCard
  category="Weddings"
  title="Should I Spend $30,000 on a Wedding?"
  description="Analyze wedding affordability based on income, savings, debt, financial stress, and long-term flexibility."
  href="/should-i-spend-30000-on-a-wedding"
/>

<CalculatorCard
  category="Cars"
  title="Should I Spend $700 on a Car Payment?"
  description="Evaluate whether your monthly vehicle payment is realistic for your income, debt load, and savings cushion."
  href="/should-i-spend-700-on-a-car-payment"
/
/>
<CalculatorCard
  category="Travel"
  title="Should I Spend $5,000 on a Vacation?"
  description="Evaluate whether a large vacation expense fits your income, savings, debt load, and long-term flexibility."
  href="/should-i-spend-5000-on-a-vacation"
/>
        </div>
      </section>

      <section class="section">
        <h2 class="section-title">Upcoming Categories</h2>

        <div class="grid">
<CategoryCard
  category="Housing"
  title="Mortgage & Rent Calculators"
  description="Tools for rent affordability, mortgage sizing, home upgrades, and real estate decisions."
/>

<CategoryCard
  category="Travel"
  title="Vacation & Flight Spending"
  description="Decide whether luxury trips, flights, resorts, and travel upgrades fit your financial picture."
/>

<CategoryCard
  category="Lifestyle"
  title="Subscriptions & Daily Spending"
  description="Analyze recurring costs, gym memberships, streaming services, dining habits, and lifestyle creep."
/>
        </div>
      </section>

</Layout>