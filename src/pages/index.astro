              College Calculators <span>&rarr;</span>
            </a>
            <a class="spotlight-link" href="/medical-calculators">
              Medical Cost Calculators <span>&rarr;</span>
            </a>
            <a class="spotlight-link" href="/should-i-spend-10000-on-a-funeral">
              Funeral Cost Calculator <span>&rarr;</span>
            </a>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <div class="eyebrow">Every category</div>
          <h2 class="section-title">Or jump straight to the decision you are actually facing</h2>
        </div>

        <div class="grid">
          <CategoryCard
            category="Baby & Parenting"
            title="Baby Cost Calculators"
            description="Newborn costs, childcare, diapers, formula, and what parental leave really does to a paycheck."
            href="/baby-parenting-calculators"
          />

          <CategoryCard
            category="College"
            title="College Cost Calculators"
            description="Tuition, scholarships, loans, and whether a school is worth what it costs."
            href="/college-calculators"
          />

          <CategoryCard
            category="Medical"
            title="Medical Cost Calculators"
            description="Bills, payment plans, and insurance gaps, sized against your actual savings."
            href="/medical-calculators"
          />

          <CategoryCard
            category="Funerals"
            title="Funeral Cost Calculators"
            description="Burial costs, insurance, and family contributions, handled with a little more care."
            href="/funeral-calculators"
          />

          <CategoryCard
            category="Groceries"
            title="Grocery Budget Calculators"
            description="Household food spending, sized to your income and family size."
            href="/grocery-calculators"
          />

          <CategoryCard
            category="Rent"
            title="Rent Affordability Calculators"
            description="What your rent is quietly costing you once utilities and commute are in the picture."
            href="/rent-calculators"
          />

          <CategoryCard
            category="Cars"
            title="Car Payment Calculators"
            description="Monthly payment, insurance, and what a loan does to your debt load."
            href="/car-calculators"
          />

          <CategoryCard
            category="Travel"
            title="Vacation Spending Calculators"
            description="Disney, cruises, honeymoons, and family trips after the trip is over, not just before."
            href="/travel-calculators"
          />

          <CategoryCard
            category="Weddings"
            title="Wedding Budget Calculators"
            description="Venue, guest count, and family contributions, weighed against what you would have left."
            href="/wedding-calculators"
          />

          <CategoryCard
            category="Budget Rules"
            title="Budget Rule Calculators"
            description="Structured systems and rules of thumb, tested against your real numbers."
            href="/budget-rule-calculators"
          />

          <CategoryCard
            category="Debt"
            title="Debt Pressure Calculators"
