---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShouldISpend.com</title>

    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f5f7fb;
        color: #111827;
      }

      .page {
        max-width: 980px;
        margin: 0 auto;
        padding: 60px 24px;
      }

      .hero {
        text-align: center;
        margin-bottom: 42px;
      }

      h1 {
        font-size: 56px;
        line-height: 1.05;
        margin-bottom: 18px;
      }

      .hero p {
        font-size: 21px;
        line-height: 1.6;
        color: #4b5563;
        max-width: 720px;
        margin: 0 auto;
      }

      .calculator {
        background: white;
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 16px 40px rgba(0,0,0,0.07);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
      }

      label {
        font-weight: 700;
        display: block;
        margin-bottom: 8px;
      }

      input {
        width: 100%;
        padding: 14px;
        font-size: 18px;
        border: 1px solid #d1d5db;
        border-radius: 12px;
      }

      button {
        margin-top: 24px;
        background: #111827;
        color: white;
        border: 0;
        padding: 16px 26px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 18px;
        cursor: pointer;
      }

      .result {
        margin-top: 28px;
        padding: 24px;
        border-radius: 18px;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
      }

      .verdict {
        font-size: 32px;
        font-weight: 900;
        margin-bottom: 12px;
      }

      .details {
        font-size: 18px;
        line-height: 1.6;
        color: #374151;
      }

      .small {
        margin-top: 18px;
        font-size: 14px;
        color: #6b7280;
      }

      @media (max-width: 700px) {
        h1 {
          font-size: 42px;
        }

        .grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <section class="hero">
        <h1>Should I Spend This Much?</h1>
        <p>
          Get a quick verdict on whether a purchase, trip, wedding,
          subscription, or lifestyle expense is financially worth it.
        </p>
      </section>

      <section class="calculator">
        <h2>Quick Spending Verdict Calculator</h2>

        <div class="grid">
          <div>
            <label for="income">Monthly Take-Home Income</label>
            <input id="income" type="number" placeholder="Example: 6000" />
          </div>

          <div>
            <label for="savings">Current Savings</label>
            <input id="savings" type="number" placeholder="Example: 15000" />
          </div>

          <div>
            <label for="cost">Purchase Cost</label>
            <input id="cost" type="number" placeholder="Example: 2500" />
          </div>

          <div>
            <label for="uses">Expected Uses</label>
            <input id="uses" type="number" placeholder="Example: 20" />
          </div>
        </div>

        <button id="calculateButton">Get My Verdict</button>

        <div id="result" class="result" style="display: none;">
          <div id="verdict" class="verdict"></div>
          <div id="details" class="details"></div>
          <div class="small">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
  function calculateVerdict() {
    const income = Number(document.getElementById("income").value);
    const savings = Number(document.getElementById("savings").value);
    const cost = Number(document.getElementById("cost").value);
    const uses = Number(document.getElementById("uses").value);

    const result = document.getElementById("result");
    const verdictBox = document.getElementById("verdict");
    const detailsBox = document.getElementById("details");

    if (!income || !savings || !cost || !uses) {
      result.style.display = "block";
      verdictBox.textContent = "Add the missing numbers.";
      detailsBox.textContent = "Fill out all four fields to get a useful spending verdict.";
      return;
    }

    const savingsImpact = (cost / savings) * 100;
    const incomeImpact = (cost / income) * 100;
    const costPerUse = cost / uses;

    let score = 100;

    if (savingsImpact > 10) score -= 15;
    if (savingsImpact > 25) score -= 20;
    if (savingsImpact > 50) score -= 25;

    if (incomeImpact > 25) score -= 10;
    if (incomeImpact > 50) score -= 15;
    if (incomeImpact > 100) score -= 25;

    if (costPerUse > 100) score -= 10;
    if (costPerUse > 250) score -= 15;

    score = Math.max(0, Math.min(100, score));

    let verdict = "";
    let guidance = "";
    let stress = "";

    if (score >= 85) {
      verdict = "Smart Purchase";
      stress = "Low stress";
      guidance = "This looks financially comfortable. The purchase does not meaningfully threaten your savings or monthly income.";
    } else if (score >= 70) {
      verdict = "Reasonable Spend";
      stress = "Manageable stress";
      guidance = "This purchase appears reasonable, especially if it brings real value, convenience, memories, or repeated use.";
    } else if (score >= 50) {
      verdict = "Proceed Carefully";
      stress = "Noticeable stress";
      guidance = "This may still be worth it, but it takes enough from your cushion that you should pause before buying.";
    } else if (score >= 30) {
      verdict = "Financial Stretch";
      stress = "High stress";
      guidance = "This purchase could create pressure. Consider reducing the cost, delaying it, or saving more first.";
    } else {
      verdict = "Probably Not Worth It";
      stress = "Very high stress";
      guidance = "This looks too expensive relative to your current income and savings. Waiting is probably the better move.";
    }

    result.style.display = "block";
    verdictBox.textContent = `${verdict} — ${score}/100`;

    detailsBox.innerHTML = `
      <div style="background:#e5e7eb; border-radius:999px; height:14px; overflow:hidden; margin:14px 0 20px;">
        <div style="width:${score}%; background:#111827; height:14px;"></div>
      </div>

      <strong>Comfort score:</strong> ${score}/100<br>
      <strong>Stress level:</strong> ${stress}<br>
      <strong>Cost per use:</strong> $${costPerUse.toFixed(2)}<br>
      <strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of your savings<br>
      <strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of one month’s take-home income<br><br>

      ${guidance}
    `;
  }

  document.getElementById("calculateButton").addEventListener("click", calculateVerdict);
</script>