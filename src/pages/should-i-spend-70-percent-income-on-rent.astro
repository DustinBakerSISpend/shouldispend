---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
---

<Layout
  title="Should I Spend 70% of My Income on Rent?"
  description="Use this rent calculator to evaluate whether spending 70% of your income on rent creates dangerous housing pressure or a rare survivable exception."
>
  <style>
    .container {
      max-width: 920px;
      margin: 0 auto;
      padding: 72px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 18px;
      text-align: center;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.95;
      margin-bottom: 24px;
      text-align: center;
      color: #0f172a;
    }

    .subtitle {
      text-align: center;
      font-size: 1.08rem;
      line-height: 1.8;
      color: #334155;
      max-width: 720px;
      margin: 0 auto 60px auto;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .content-section h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 24px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
      margin-bottom: 24px;
    }

    .calculator {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 36px;
      margin: 56px auto;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    }

    .calculator h2 {
      margin-bottom: 28px;
      font-size: 1.7rem;
      color: #0f172a;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
      color: #0f172a;
      font-size: 0.95rem;
    }

    input {
      width: 100%;
      padding: 16px;
      border-radius: 14px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    button {
      margin-top: 28px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 28px;
      border-radius: 14px;
      font-size: 19px;
      font-weight: 900;
      cursor: pointer;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 28px;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 18px;
      padding: 28px;
      display: none;
    }

    .score {
      font-size: 2.5rem;
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 18px;
    }

    .bar {
      height: 14px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 18px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #0f766e;
      transition: width 0.4s ease;
    }

    .result-details {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 18px;
    }

    .fine-print {
      font-size: 0.9rem;
      color: #64748b;
    }

    @media (max-width: 720px) {
      .container {
        padding: 54px 20px;
      }

      h1 {
        font-size: 2.8rem;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator {
        padding: 24px;
      }

      .score {
        font-size: 2rem;
      }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Rent Affordability Calculator</div>

    <h1>Should I Spend 70% of My Income on Rent?</h1>

    <p class="subtitle">
      Evaluate whether spending 70% of your take-home income on rent creates
      extreme housing pressure, serious monthly strain, or a rare survivable
      exception backed by unusual savings or income.
    </p>

    <section class="content-section">
      <h2>Is 70% of Income on Rent Too Much?</h2>

      <p>
        Spending 70% of take-home income on rent is usually a dangerous housing
        ratio. It leaves very little room for utilities, groceries,
        transportation, insurance, debt payments, savings, medical costs, and
        unexpected expenses.
      </p>

      <p>
        There are rare exceptions for people with unusually high income, very
        large savings, no debt, temporary housing needs, or major location-based
        reasons. But for most households, 70% rent creates a fragile monthly
        budget.
      </p>
    </section>

    <div class="calculator">
      <h2>Rent Pressure Verdict</h2>

      <div class="grid">
        <div>
          <label for="income">Monthly Take-Home Income</label>
          <input id="income" type="number" placeholder="Example: 6000" />
        </div>

        <div>
          <label for="savings">Total Savings</label>
          <input id="savings" type="number" placeholder="Example: 15000" />
        </div>

        <div>
          <label for="rent">Monthly Rent</label>
          <input id="rent" type="number" value="4200" />
        </div>

        <div>
          <label for="debt">Monthly Debt Payments</label>
          <input id="debt" type="number" placeholder="Example: 600" />

          <div class="helper-link">
            Not sure what counts as debt?
            <a href="/what-counts-as-debt">Read the debt guide</a>
          </div>
        </div>
      </div>

      <button id="rentButton" type="button">Get Rent Verdict</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="fill" id="scoreFill"></div>
        </div>

        <div class="result-details" id="resultDetails"></div>

        <div class="fine-print">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>What a 70% Rent Ratio Really Means</h2>

      <p>
        A 70% rent ratio means most of monthly take-home pay is committed before
        the rest of life is paid for. Even if the lease can technically be paid,
        the remaining budget may be too small to absorb normal expenses.
      </p>

      <p>
        This level can turn small surprises into major problems. A car repair,
        medical bill, job disruption, utility spike, or family emergency can
        create immediate pressure when housing already consumes most income.
      </p>
    </section>

    <WhenSpendingMakesSense
      title="When 70% Rent Might Be a Rare Exception"
      items={[
        "The situation is temporary and solves an urgent housing, safety, work, or family need.",
        "You have unusually large savings after deposits and move-in costs.",
        "You have no meaningful debt and very low transportation costs.",
        "The location directly protects income, safety, school access, medical access, or family stability.",
        "You have a clear plan to reduce housing costs or increase income soon.",
      ]}
    />

    <section class="content-section">
      <h2>When 70% Rent Becomes Dangerous</h2>

      <p>
        Spending 70% of income on rent becomes dangerous when it prevents
        savings, forces credit card use, delays debt payoff, or leaves no room
        for emergencies. That is the most common outcome for this rent ratio.
      </p>

      <p>
        It is especially risky if the rent only works because of overtime,
        bonuses, commissions, side income, family help, or assumptions that
        future income will rise soon.
      </p>
    </section>

    <KeyCostCategories
      items={[
        {
          title: "Utilities and recurring fees",
          description:
            "Electric, gas, water, trash, internet, parking, pet fees, laundry, renter’s insurance, and building charges can make the total housing burden even higher.",
        },
        {
          title: "Debt payments",
          description:
            "Credit cards, student loans, car payments, personal loans, and buy-now-pay-later balances make a 70% rent ratio much harder to survive.",
        },
        {
          title: "Emergency savings",
          description:
            "Extreme rent is much riskier when savings cannot cover repairs, medical bills, job loss, moving costs, or other surprises.",
        },
        {
          title: "Income stability",
          description:
            "Spending 70% of income on rent is especially dangerous when income depends on overtime, commissions, seasonal work, contract work, or unstable hours.",
        },
      ]}
    />

    <ReduceCostTips
      items={[
        "Look for a cheaper unit before signing a lease.",
        "Consider a roommate, smaller apartment, different neighborhood, or shorter lease.",
        "Avoid draining savings for deposits, furniture, brokers, or moving costs.",
        "Compare total housing cost, not just the rent payment.",
        "Use 70% rent only as a short-term bridge if there is a clear exit plan.",
        "Set a specific plan to lower rent burden or raise income quickly.",
      ]}
    />

    <FinancialRedFlags
      items={[
        "Rent would leave little or no money for savings each month.",
        "You would need credit cards for groceries, gas, utilities, or normal expenses.",
        "Move-in costs would wipe out most of your emergency fund.",
        "Debt payments already consume a large share of take-home pay.",
        "You are relying on overtime, bonuses, family help, or side income to make rent work.",
        "You have no clear plan for reducing the housing burden.",
      ]}
    />

    <CalculatorAssumptions
      items={[
        "The calculator uses monthly take-home income rather than gross income.",
        "The estimate assumes rent is the base monthly payment and does not include every possible utility or fee.",
        "Debt payments should include recurring monthly obligations such as credit cards, student loans, car payments, and personal loans.",
        "Savings are used as a cushion signal because extreme rent creates very little room for emergencies.",
        "Local housing costs, job stability, family obligations, safety needs, and transportation needs can change the final decision.",
      ]}
    />

    <FAQSection
      title="70% Rent FAQ"
      faqs={[
        {
          question: "Is spending 70% of income on rent bad?",
          answer:
            "For most households, yes. Spending 70% of take-home income on rent usually leaves too little room for savings, utilities, transportation, groceries, debt payments, and emergencies.",
        },
        {
          question: "Can spending 70% of income on rent ever make sense?",
          answer:
            "Only rarely. It may be temporarily survivable with very large savings, no debt, stable income, and a clear reason the location is necessary, but it is usually a high-pressure choice.",
        },
        {
          question: "Should utilities count toward the 70% number?",
          answer:
            "Utilities should be considered separately because they make the true housing burden higher. Rent may already be 70% of income before internet, parking, insurance, pet fees, and energy costs.",
        },
        {
          question: "What should I do if rent is 70% of my income?",
          answer:
            "Build a strict budget, avoid new debt, protect emergency savings, search for cheaper housing, consider a roommate, and create a specific plan to lower rent burden or raise income.",
        },
        {
          question: "What is a safer rent percentage?",
          answer:
            "Many renters aim for 25% to 30% of take-home income. In expensive markets, 35% to 40% may be realistic, but 70% is usually extreme and hard to sustain.",
        },
      ]}
    />

    <MethodologySection category="rent affordability" updated="May 2026" />

    <RelatedGuides
      guides={[
        {
          title: "How Much Rent Can I Afford?",
          href: "/how-much-rent-can-i-afford",
          description:
            "Learn how rent-to-income rules, take-home pay, debt, utilities, and savings affect affordability.",
        },
        {
          title: "What Counts as Debt?",
          href: "/what-counts-as-debt",
          description:
            "See which monthly obligations should be included when evaluating rent affordability.",
        },
      ]}
    />

    <RelatedCalculators
      calculators={[
        {
          category: "Rent",
          title: "Should I Spend 50% of My Income on Rent?",
          href: "/should-i-spend-50-percent-income-on-rent",
        },
        {
          category: "Rent",
          title: "Should I Spend 60% of My Income on Rent?",
          href: "/should-i-spend-60-percent-income-on-rent",
        },
        {
          category: "Rent",
          title: "Should I Spend $4,000 on Rent?",
          href: "/should-i-spend-4000-on-rent",
        },
        {
          category: "Rent",
          title: "Should I Spend $5,000 on Rent?",
          href: "/should-i-spend-5000-on-rent",
        },
      ]}
    />
  </main>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) return { label: "Low Pressure", color: "#16a34a" };
      if (score <= 60) return { label: "Moderate Pressure", color: "#eab308" };
      return { label: "High Pressure", color: "#dc2626" };
    }

    function calculateRent() {
      const income = getNumber("income");
      const savings = getNumber("savings");
      const rent = getNumber("rent");
      const debt = getNumber("debt");

      const result = document.getElementById("result");
      const scoreText = document.getElementById("scoreText");
      const scoreFill = document.getElementById("scoreFill");
      const resultDetails = document.getElementById("resultDetails");

      result.style.display = "block";

      if (income <= 0 || rent <= 0) {
        scoreText.textContent = "Add your numbers first";
        scoreFill.style.width = "0%";
        scoreFill.style.background = "#16a34a";
        resultDetails.innerHTML =
          "<p>Enter your take-home income and monthly rent so the calculator can estimate housing pressure.</p>";
        return;
      }

      const rentRatio = (rent / income) * 100;
      const debtRatio = (debt / income) * 100;
      const savingsMonths = savings / rent;

      let pressureScore = 0;

      pressureScore += clamp(rentRatio * 1.65, 0, 70);
      pressureScore += clamp(debtRatio * 0.6, 0, 26);

      if (rentRatio >= 80) {
        pressureScore += 36;
      } else if (rentRatio >= 70) {
        pressureScore += 30;
      } else if (rentRatio >= 60) {
        pressureScore += 24;
      } else if (rentRatio >= 50) {
        pressureScore += 18;
      } else if (rentRatio >= 40) {
        pressureScore += 10;
      } else if (rentRatio >= 35) {
        pressureScore += 7;
      } else if (rentRatio >= 30) {
        pressureScore += 5;
      }

      if (savingsMonths < 1) {
        pressureScore += 18;
      } else if (savingsMonths < 3) {
        pressureScore += 10;
      } else if (savingsMonths >= 6) {
        pressureScore -= 8;
      }

      if (rentRatio < 25 && debtRatio < 10 && savingsMonths >= 6) {
        pressureScore = Math.min(pressureScore, 18);
      }

      if (rentRatio < 15 && debtRatio < 5 && savingsMonths >= 12) {
        pressureScore = Math.min(pressureScore, 10);
      }

      if (rentRatio < 8 && debtRatio < 3 && savingsMonths >= 24) {
        pressureScore = Math.min(pressureScore, 3);
      }

      if (rentRatio < 5 && debtRatio === 0 && savingsMonths >= 36) {
        pressureScore = 0;
      }

      if (income >= 50000 && rentRatio < 10 && debtRatio < 5) {
        pressureScore = Math.min(pressureScore, 5);
      }

      if (income >= 100000 && rentRatio < 15 && debtRatio < 5 && savingsMonths >= 12) {
        pressureScore = Math.min(pressureScore, 5);
      }

      if (savings >= 1000000 && rentRatio >= 60 && rentRatio < 75) {
        pressureScore = Math.min(pressureScore, 72);
      }

      if (savings >= 1000000 && rentRatio >= 45 && rentRatio < 60) {
        pressureScore = Math.min(pressureScore, 58);
      }

      if (savings >= 1000000 && rentRatio < 50) {
        pressureScore = Math.min(pressureScore, 5);
      }

      if (savings >= 5000000) {
        pressureScore = 0;
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      scoreText.textContent = `${level.label} — ${pressureScore}/100`;
      scoreFill.style.width = `${pressureScore}%`;
      scoreFill.style.background = level.color;

      let guidance = "";

      if (pressureScore === 0) {
        guidance =
          "With this level of income or savings, this rent ratio creates essentially no financial pressure based on the numbers provided.";
      } else if (pressureScore <= 30) {
        guidance =
          "This rent ratio appears manageable based on the numbers provided. The main priority is keeping utilities, transportation, debt payments, and savings inside the broader housing budget.";
      } else if (pressureScore <= 60) {
        guidance =
          "This rent ratio may work temporarily, but it deserves serious caution. Debt payments, utilities, transportation, and low savings can weaken an already tight housing situation.";
      } else {
        guidance =
          "This rent ratio could create severe financial pressure. A cheaper apartment, roommate, lower debt load, stronger savings cushion, or higher income would likely make the housing situation safer.";
      }

      resultDetails.innerHTML = `
        <p><strong>Rent-to-income ratio:</strong> ${rentRatio.toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Debt impact:</strong> ${debtRatio.toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Savings cushion:</strong> ${savingsMonths.toFixed(1)} months of rent covered.</p>
        <p>${guidance}</p>
      `;
    }

    document
      .getElementById("rentButton")
      .addEventListener("click", calculateRent);
  </script>
</Layout>