---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import { calculators } from "../data/calculators.js";

const categories = [
  {
    name: "Groceries",
    title: "Grocery Budget Calculators",
    description:
      "Evaluate monthly grocery spending, household food costs, income pressure, savings cushion, and budget flexibility.",
    hub: "/grocery-calculators",
  },
  {
    name: "Weddings",
    title: "Wedding Budget Calculators",
    description:
      "Analyze wedding affordability, guest costs, savings pressure, debt risk, and long-term financial flexibility.",
    hub: "/wedding-calculators",
  },
  {
    name: "Funeral Costs",
    title: "Funeral Cost Calculators",
    description:
      "Compare funeral costs, burial, cremation, savings use, family help, insurance, and debt risk during difficult decisions.",
    hub: "/funeral-calculators",
  },
  {
    name: "Cars",
    title: "Car Payment Calculators",
    description:
      "Evaluate vehicle affordability, monthly payment pressure, insurance costs, savings strain, and debt stress.",
    hub: "/car-calculators",
  },
  {
    name: "Travel",
    title: "Vacation Spending Calculators",
    description:
      "Review Disney vacations, Europe trips, cruises, honeymoons, and family travel through income, savings, and debt pressure.",
    hub: "/travel-calculators",
  },
  {
    name: "Medical",
    title: "Medical Cost Calculators",
    description:
      "Evaluate healthcare costs, medical bills, payment plans, emergency savings, and financial pressure.",
    hub: "/medical-calculators",
  },
  {
    name: "Rent",
    title: "Rent Affordability Calculators",
    description:
      "Understand whether rent fits your income, utilities, transportation costs, savings goals, and debt load.",
    hub: "/rent-calculators",
  },
  {
    name: "Budget Rules",
    title: "Budget Rule Calculators and Guides",
    description:
      "Use debt, housing, emergency savings, and percentage-based budget rules to evaluate financial pressure.",
    hub: "/budget-rule-calculators",
  },
  {
    name: "Emergency Savings",
    title: "Emergency Savings Calculators",
    description:
      "Evaluate emergency fund targets, savings pressure, post-purchase flexibility, and financial stability.",
    hub: "/how-much-emergency-savings-should-i-have",
  },
  {
    name: "Home Improvement",
    title: "Home Improvement Calculators",
    description:
      "Evaluate home repairs, renovation costs, emergency savings, debt pressure, and household financial flexibility.",
    hub: "/home-improvement-calculators",
  },
];

const featuredHrefs = [
  "/how-much-debt-is-too-much",
  "/should-i-spend-700-on-a-car-payment",
  "/should-i-spend-30000-on-a-wedding",
  "/should-i-spend-1500-on-groceries-per-month",
  "/should-i-spend-this-much-eating-out-per-month",
  "/should-i-spend-10000-on-a-funeral",
  "/how-much-emergency-savings-should-i-have",
  "/should-i-spend-this-much-on-medical-bills",
];

const featuredCalculators = calculators.filter((calculator) =>
  featuredHrefs.includes(calculator.href)
);
---

<Layout
  title="All Calculators | ShouldISpend"
  description="Browse verdict-driven financial calculators for groceries, weddings, funerals, debt, car payments, rent, vacations, emergency savings, medical costs, and major spending decisions."
>
  <style>
    .page-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 68px 24px 86px;
    }

    .hero {
      max-width: 900px;
      margin-bottom: 44px;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 0.78rem;
      color: var(--primary);
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.7rem, 7vw, 5rem);
      line-height: 0.98;
      margin: 0 0 22px;
      color: var(--text);
      letter-spacing: -0.05em;
    }

    .subtitle {
      max-width: 840px;
      font-size: 1.16rem;
      line-height: 1.85;
      color: var(--muted);
      margin: 0;
    }

    .trust-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 34px 0 58px;
    }

    .trust-item {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px 20px;
    }

    .trust-item strong {
      display: block;
      color: var(--text);
      font-size: 0.98rem;
      margin-bottom: 6px;
    }

    .trust-item span {
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .hub-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
      margin-bottom: 70px;
    }

    .hub-card {
      display: block;
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .hub-card:hover {
      transform: translateY(-3px);
      border-color: rgba(15, 118, 110, 0.35);
      box-shadow: 0 16px 35px rgba(15, 23, 42, 0.08);
    }

    .hub-card strong {
      display: block;
      color: var(--text);
      font-size: 1.08rem;
      margin-bottom: 8px;
    }

    .hub-card span {
      display: block;
      color: var(--muted);
      line-height: 1.65;
      font-size: 0.94rem;
    }

    .section {
      margin-top: 72px;
    }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 26px;
    }

    .section-title {
      font-size: clamp(1.75rem, 4vw, 2.25rem);
      line-height: 1.15;
      margin: 0 0 10px;
      color: var(--text);
      letter-spacing: -0.03em;
    }

    .section-description {
      max-width: 780px;
      color: var(--muted);
      line-height: 1.75;
      margin: 0;
      font-size: 1.03rem;
    }

    .hub-link {
      white-space: nowrap;
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
    }

    .hub-link:hover {
      text-decoration: underline;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .note {
      margin-top: 72px;
      padding: 28px;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: #f8fafc;
    }

    .note h2 {
      margin: 0 0 12px;
      color: var(--text);
      font-size: 1.45rem;
    }

    .note p {
      margin: 0;
      color: var(--muted);
      line-height: 1.75;
    }

    @media (max-width: 768px) {
      .page-container {
        padding: 48px 18px 70px;
      }

      h1 {
        font-size: 2.8rem;
      }

      .subtitle {
        font-size: 1.04rem;
      }

      .trust-strip {
        grid-template-columns: 1fr;
        margin-bottom: 48px;
      }

      .section {
        margin-top: 56px;
      }

      .section-header {
        display: block;
      }

      .hub-link {
        display: inline-block;
        margin-top: 16px;
      }

      .grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }
    }
  </style>

  <main class="page-container">
    <section class="hero">
      <div class="eyebrow">Calculator Library</div>

      <h1>Financial Calculators for Real Spending Decisions</h1>

      <p class="subtitle">
        Browse verdict-driven calculators for groceries, weddings, cars, travel,
        rent, medical costs, debt, emergency savings, home repairs, and other
        major expenses. ShouldISpend evaluates more than the sticker price by
        considering income, savings, debt pressure, emergency flexibility,
        recurring bills, and long-term financial tradeoffs.
      </p>
    </section>

    <div class="trust-strip">
      <div class="trust-item">
        <strong>Verdict-driven</strong>
        <span>
          Each tool gives practical guidance instead of stopping at a raw number.
        </span>
      </div>

      <div class="trust-item">
        <strong>Pressure-based</strong>
        <span>
          Calculators look at cash flow, savings cushion, debt load, and recovery time.
        </span>
      </div>

      <div class="trust-item">
        <strong>Educational only</strong>
        <span>
          Results are estimates for decision support, not personalized financial advice.
        </span>
      </div>
    </div>

    <div class="hub-row">
      {categories.map((category) => (
        <a class="hub-card" href={category.hub}>
          <strong>{category.title}</strong>
          <span>{category.description}</span>
        </a>
      ))}
    </div>

    {featuredCalculators.length > 0 && (
      <section class="section">
        <div class="section-header">
          <div>
            <h2 class="section-title">Core Financial Pressure Calculators</h2>

            <p class="section-description">
              Start with these flagship tools if you want to evaluate the biggest
              sources of financial pressure: debt, car payments, weddings,
              groceries, eating out, funerals, medical bills, and emergency savings.
            </p>
          </div>
        </div>

        <div class="grid">
          {featuredCalculators.map((calculator) => (
            <CalculatorCard
              category={calculator.category}
              title={calculator.title}
              description={calculator.description}
              href={calculator.href}
            />
          ))}
        </div>
      </section>
    )}

    {categories.map((category) => {
      const categoryCalculators = calculators.filter(
        (calculator) => calculator.category === category.name
      );

      if (categoryCalculators.length === 0) return null;

      return (
        <section class="section">
          <div class="section-header">
            <div>
              <h2 class="section-title">{category.title}</h2>

              <p class="section-description">{category.description}</p>
            </div>

            <a class="hub-link" href={category.hub}>
              View Category →
            </a>
          </div>

          <div class="grid">
            {categoryCalculators.map((calculator) => (
              <CalculatorCard
                category={calculator.category}
                title={calculator.title}
                description={calculator.description}
                href={calculator.href}
              />
            ))}
          </div>
        </section>
      );
    })}

    <section class="note">
      <h2>How to Use These Calculators</h2>

      <p>
        ShouldISpend calculators are built as educational pressure tests. Use
        them to compare spending decisions, understand tradeoffs, and identify
        financial stress points before committing to a purchase, payment, trip,
        event, or recurring expense. For decisions involving taxes, legal issues,
        investments, loans, insurance, or major life changes, consider speaking
        with a qualified professional.
      </p>
    </section>
  </main>
</Layout>