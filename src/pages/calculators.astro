---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import { calculators } from "../data/calculators.js";

const categories = [
  {
    name: "Groceries",
    title: "Grocery Budget Calculators",
    description:
      "Evaluate monthly grocery spending, household food costs, income pressure, savings cushion, and budget flexibility.",
    hub: "/grocery-calculators",
  },
  {
    name: "Weddings",
    title: "Wedding Budget Calculators",
    description:
      "Analyze wedding affordability, guest costs, savings pressure, debt risk, and long-term financial flexibility.",
    hub: "/wedding-calculators",
  },
  {
    name: "Cars",
    title: "Car Payment Calculators",
    description:
      "Evaluate vehicle affordability, monthly payment pressure, insurance costs, savings strain, and debt stress.",
    hub: "/car-calculators",
  },
  {
    name: "Travel",
    title: "Vacation Spending Calculators",
    description:
      "Review Disney vacations, Europe trips, cruises, honeymoons, and family travel through income, savings, and debt pressure.",
    hub: "/travel-calculators",
  },
  {
    name: "Rent",
    title: "Rent Affordability Calculators",
    description:
      "Understand whether rent fits your income, utilities, transportation costs, savings goals, and debt load.",
    hub: "/rent-calculators",
  },
  {
    name: "Budget Rules",
    title: "Budget Rule Calculators and Guides",
    description:
      "Use debt, housing, emergency savings, and percentage-based budget rules to evaluate financial pressure.",
    hub: "/budget-rule-calculators",
  },
];
---

<Layout
  title="All Calculators | ShouldISpend"
  description="Browse financial decision calculators for groceries, weddings, cars, travel, rent, debt, housing, and major spending choices."
>
  <style>
    .page-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 24px;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 0.8rem;
      color: var(--primary);
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.5rem, 7vw, 4.8rem);
      line-height: 1;
      margin: 0 0 20px;
      color: var(--text);
    }

    .subtitle {
      max-width: 820px;
      font-size: 1.15rem;
      line-height: 1.85;
      color: var(--muted);
      margin-bottom: 56px;
    }

    .hub-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-bottom: 64px;
    }

    .hub-card {
      display: block;
      background: white;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 22px;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }

    .hub-card:hover {
      transform: translateY(-2px);
    }

    .hub-card strong {
      display: block;
      color: var(--text);
      font-size: 1.08rem;
      margin-bottom: 8px;
    }

    .hub-card span {
      display: block;
      color: var(--muted);
      line-height: 1.65;
      font-size: 0.94rem;
    }

    .section {
      margin-top: 64px;
    }

    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 24px;
    }

    .section-title {
      font-size: 2rem;
      margin: 0 0 10px;
      color: var(--text);
    }

    .section-description {
      max-width: 760px;
      color: var(--muted);
      line-height: 1.75;
      margin: 0;
    }

    .hub-link {
      white-space: nowrap;
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
    }

    .hub-link:hover {
      text-decoration: underline;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    @media (max-width: 768px) {
      .page-container {
        padding: 42px 18px;
      }

      h1 {
        font-size: 2.7rem;
      }

      .subtitle {
        font-size: 1.05rem;
        margin-bottom: 42px;
      }

      .section {
        margin-top: 52px;
      }

      .section-header {
        display: block;
      }

      .section-title {
        font-size: 1.65rem;
      }

      .hub-link {
        display: inline-block;
        margin-top: 16px;
      }

      .grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }
    }
  </style>

  <main class="page-container">
    <div class="eyebrow">Calculator Library</div>

    <h1>All Financial Decision Calculators</h1>

    <p class="subtitle">
      Browse verdict-driven calculators and guides for groceries, weddings,
      cars, travel, rent, debt, housing, and major spending decisions. Each tool
      evaluates more than the sticker price by considering income, savings,
      debt, emergency cushion, monthly pressure, and financial flexibility.
    </p>

    <div class="hub-row">
      {categories.map((category) => (
        <a class="hub-card" href={category.hub}>
          <strong>{category.title}</strong>
          <span>{category.description}</span>
        </a>
      ))}
    </div>

    {categories.map((category) => {
      const categoryCalculators = calculators.filter(
        (calculator) => calculator.category === category.name
      );

      if (categoryCalculators.length === 0) return null;

      return (
        <section class="section">
          <div class="section-header">
            <div>
              <h2 class="section-title">{category.title}</h2>

              <p class="section-description">
                {category.description}
              </p>
            </div>

            <a class="hub-link" href={category.hub}>
              View Category →
            </a>
          </div>

          <div class="grid">
            {categoryCalculators.map((calculator) => (
              <CalculatorCard
                category={calculator.category}
                title={calculator.title}
                description={calculator.description}
                href={calculator.href}
              />
            ))}
          </div>
        </section>
      );
    })}
  </main>
</Layout>