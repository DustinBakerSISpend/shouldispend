---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const categories = [
  {
    name: "Baby & Parenting",
    title: "Baby & Parenting Calculators",
    description:
      "Estimate baby costs, childcare pressure, parental leave tradeoffs, first-year expenses, savings use, and major baby gear decisions.",
    hub: "/baby-parenting-calculators",
  },
  {
    name: "College",
    title: "College Cost Calculators",
    description:
      "Evaluate tuition, student loans, savings use, career payoff, going back to school, and overall education affordability.",
    hub: "/college-calculators",
  },
  {
    name: "Medical",
    title: "Medical Cost Calculators",
    description:
      "Evaluate healthcare costs, medical bills, payment plans, emergency savings, and financial pressure.",
    hub: "/medical-calculators",
  },
  {
    name: "Funeral Costs",
    title: "Funeral Cost Calculators",
    description:
      "Compare funeral costs, burial, cremation, savings use, family help, insurance, and debt risk during difficult decisions.",
    hub: "/funeral-calculators",
  },
  {
    name: "Weddings",
    title: "Wedding Budget Calculators",
    description:
      "Analyze wedding affordability, guest costs, savings pressure, debt risk, and long-term financial flexibility.",
    hub: "/wedding-calculators",
  },
  {
    name: "Cars",
    title: "Car Payment Calculators",
    description:
      "Evaluate vehicle affordability, monthly payment pressure, insurance costs, savings strain, and debt stress.",
    hub: "/car-calculators",
  },
  {
    name: "Rent",
    title: "Rent Affordability Calculators",
    description:
      "Understand whether rent fits your income, utilities, transportation costs, savings goals, and debt load.",
    hub: "/rent-calculators",
  },
  {
    name: "Groceries",
    title: "Grocery Budget Calculators",
    description:
      "Evaluate monthly grocery spending, household food costs, income pressure, savings cushion, and budget flexibility.",
    hub: "/grocery-calculators",
  },
  {
    name: "Travel",
    title: "Vacation Spending Calculators",
    description:
      "Review Disney vacations, Europe trips, cruises, honeymoons, and family travel through income, savings, and debt pressure.",
    hub: "/travel-calculators",
  },
  {
    name: "Budget Rules",
    title: "Budget Rule Calculators and Guides",
    description:
      "Use debt, housing, emergency savings, and percentage-based budget rules to evaluate financial pressure.",
    hub: "/budget-rule-calculators",
  },
  {
    name: "Emergency Savings",
    title: "Emergency Savings Calculators",
    description:
      "Evaluate emergency fund targets, savings pressure, post-purchase flexibility, and financial stability.",
    hub: "/how-much-emergency-savings-should-i-have",
  },
  {
    name: "Home Improvement",
    title: "Home Improvement Calculators",
    description:
      "Evaluate home repairs, renovation costs, emergency savings, debt pressure, and household financial flexibility.",
    hub: "/home-improvement-calculators",
  },
];

const featuredHrefs = [
  "/baby-cost-calculator",
  "/can-we-afford-to-have-a-baby",
  "/how-much-debt-is-too-much",
  "/should-i-spend-700-on-a-car-payment",
  "/should-i-spend-30000-on-a-wedding",
  "/should-i-spend-1500-on-groceries-per-month",
  "/should-i-spend-10000-on-a-funeral",
  "/should-i-spend-this-much-on-medical-bills",
];

const featuredCalculators = featuredHrefs
  .map((href) => calculators.find((calculator) => calculator.href === href))
  .filter(Boolean);

const categorySummaries = categories.map((category) => {
  const count = calculators.filter(
    (calculator) => calculator.category === category.name
  ).length;

  return {
    ...category,
    count,
  };
});

const methodologySteps = [
  {
    title: "Start with the real cost",
    text:
      "A spending decision should include the full cost, not just the headline number. Fees, taxes, interest, insurance, supplies, travel, utilities, tips, deductibles, and recurring add-ons can change the pressure.",
  },
  {
    title: "Use take-home income",
    text:
      "ShouldISpend treats monthly income as money actually available to support the household, not gross income before taxes, payroll deductions, insurance, or retirement contributions.",
  },
  {
    title: "Account for outside help",
    text:
      "Confirmed aid, insurance, family help, employer benefits, scholarships, grants, reimbursements, gifts, or other outside support should reduce the true uncovered cost.",
  },
  {
    title: "Measure savings after the decision",
    text:
      "A purchase is safer when emergency savings remain intact afterward. A cost becomes riskier when it leaves no cushion for normal life surprises.",
  },
  {
    title: "Check debt and monthly pressure",
    text:
      "Financing can make a cost possible today while creating pressure later. The calculators consider payments, debt load, and how much room remains after required bills.",
  },
  {
    title: "Look for recovery room",
    text:
      "The best financial decisions leave a path back to stability. A cost should be judged by what happens after the money is spent, not only by whether it can be paid today.",
  },
];

const pressureSignals = [
  {
    title: "Green Pressure",
    text:
      "The cost appears manageable because savings, take-home income, outside help, or low debt leave enough financial breathing room afterward.",
  },
  {
    title: "Moderate Pressure",
    text:
      "The decision may be workable, but it could require tradeoffs, a slower savings rebuild, a tighter monthly budget, or a clearer plan before committing.",
  },
  {
    title: "High Pressure",
    text:
      "The decision may create serious strain because it drains savings, adds difficult debt, crowds out essentials, or leaves little room for emergencies.",
  },
];

const redFlags = [
  "The decision would use nearly all emergency savings.",
  "The cost depends on credit cards or high-interest debt.",
  "Outside help is assumed but not confirmed.",
  "The monthly payment fits only if nothing else goes wrong.",
  "The calculation uses gross income instead of take-home pay.",
  "The decision ignores taxes, fees, insurance, maintenance, supplies, or other add-ons.",
  "A one-time cost creates recurring pressure for months or years.",
  "The purchase delays rent stability, medical care, debt payoff, emergency savings, or other essentials.",
];

const reducePressureTips = [
  {
    title: "Shrink the uncovered cost",
    text:
      "Use confirmed aid, insurance, scholarships, family help, employer benefits, reimbursements, used items, lower-cost options, or phased spending before using savings or debt.",
  },
  {
    title: "Delay optional spending",
    text:
      "If the decision is not urgent, waiting can protect savings, reduce borrowing, and make the final choice less stressful.",
  },
  {
    title: "Separate needs from upgrades",
    text:
      "A necessary repair, medical bill, childcare cost, or tuition decision should be judged differently from a preference-based upgrade.",
  },
  {
    title: "Run more than one calculator",
    text:
      "Large decisions often touch several categories. A wedding may affect travel and debt. A baby may affect groceries and medical costs. A home repair may affect emergency savings.",
  },
  {
    title: "Protect the next month",
    text:
      "The decision should not only work today. It should still leave enough room for rent, food, transportation, insurance, debt payments, and normal bills next month.",
  },
  {
    title: "Create a recovery plan",
    text:
      "If savings must be used, decide how quickly they can be rebuilt and what spending will be paused until the household is stable again.",
  },
];

const assumptions = [
  "ShouldISpend calculators are educational decision-support tools, not personalized financial, tax, legal, medical, insurance, or investment advice.",
  "Monthly income means take-home pay available to support the person or household paying the cost.",
  "Confirmed outside help should reduce the true uncovered cost.",
  "No calculator should create artificial pressure when the true cost is fully covered by outside help, strong savings, or very high available income.",
  "Urgent needs should be treated differently from optional upgrades.",
  "A low-pressure result is not a command to spend, and a high-pressure result is not always a command to avoid the expense.",
];

const relatedGuides = [
  {
    href: "/budget-rule-calculators",
    title: "Budget Rule Calculators",
    text:
      "Use percentage rules as starting points for rent, debt, car payments, and major spending decisions.",
  },
  {
    href: "/how-much-emergency-savings-should-i-have",
    title: "Emergency Savings Calculator",
    text:
      "Estimate how much cash cushion you may need before and after major expenses.",
  },
  {
    href: "/how-much-debt-is-too-much",
    title: "How Much Debt Is Too Much?",
    text:
      "Understand whether monthly debt pressure is limiting flexibility, savings, and stability.",
  },
  {
    href: "/what-counts-as-debt",
    title: "What Counts as Debt?",
    text:
      "See which obligations should be counted when evaluating monthly affordability.",
  },
  {
    href: "/how-much-rent-can-i-afford",
    title: "How Much Rent Can I Afford?",
    text:
      "Compare rent against take-home pay, utilities, debt, transportation, and emergency savings.",
  },
  {
    href: "/how-much-house-can-i-afford",
    title: "How Much House Can I Afford?",
    text:
      "Evaluate home affordability with income, debt, taxes, insurance, maintenance, and savings.",
  },
];

const calculatorFaqs = [
  {
    question: "What is ShouldISpend?",
    answer:
      "ShouldISpend is a library of decision-focused financial calculators. The tools help compare major expenses against take-home income, savings, debt, outside help, and monthly flexibility.",
  },
  {
    question: "Are these calculators financial advice?",
    answer:
      "No. The calculators are educational pressure tests. They can help clarify tradeoffs, but they are not personalized financial, legal, tax, medical, insurance, or investment advice.",
  },
  {
    question: "Why do the calculators focus on pressure instead of only cost?",
    answer:
      "The same cost can be easy for one household and risky for another. Pressure depends on income, savings, debt, urgency, outside help, recurring payments, and what remains after the decision.",
  },
  {
    question: "Should I use gross income or take-home income?",
    answer:
      "Use take-home income. That better reflects the money actually available after taxes, insurance, benefits, payroll deductions, and retirement contributions.",
  },
  {
    question: "What if family help, insurance, or aid covers the cost?",
    answer:
      "Confirmed outside help should reduce the true uncovered cost. If the full cost is covered, the financial pressure should usually be very low or zero.",
  },
  {
    question: "Can a high-pressure result still be the right decision?",
    answer:
      "Yes. Some costs are necessary, such as urgent medical bills, essential repairs, funeral expenses, or childcare. A high-pressure result means the decision needs a plan, not that the need is fake.",
  },
];
---

<Layout
  title="All Financial Calculators | ShouldISpend"
  description="Browse financial calculators for baby costs, college, medical bills, funerals, weddings, cars, rent, groceries, travel, debt, emergency savings, and home repairs."
>
  <style>
    .page-container {
      width: 92%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 72px 0 94px;
    }

    .hero {
      max-width: 960px;
      margin-bottom: 56px;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 0.78rem;
      color: var(--primary);
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.8rem, 7vw, 5rem);
      line-height: 0.98;
      margin: 0 0 24px;
      color: var(--primary);
      letter-spacing: -0.05em;
    }

    .subtitle,
    .section p,
    .wide-section p,
    .verdict-bar p,
    .note p {
      max-width: 880px;
      font-size: 1.06rem;
      line-height: 1.85;
      color: var(--muted);
    }

    .subtitle {
      margin: 0 0 18px;
    }

    .inline-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .inline-links a {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 800;
      font-size: 0.92rem;
      background: white;
    }

    .trust-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 34px 0 64px;
    }

    .trust-item {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px 20px;
    }

    .trust-item strong {
      display: block;
      color: var(--text);
      font-size: 0.98rem;
      margin-bottom: 6px;
    }

    .trust-item span {
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .hub-section,
    .section,
    .wide-section {
      margin-top: 78px;
    }

    .hub-section {
      margin-bottom: 76px;
    }

    .hub-heading,
    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 26px;
    }

    .hub-heading h2,
    .section-title,
    .section h2,
    .wide-section h2,
    .verdict-bar h2,
    .note h2 {
      font-size: clamp(1.75rem, 4vw, 2.25rem);
      line-height: 1.15;
      margin: 0 0 14px;
      color: var(--text);
      letter-spacing: -0.03em;
    }

    .hub-heading p,
    .section-description {
      max-width: 800px;
      color: var(--muted);
      line-height: 1.75;
      margin: 0;
      font-size: 1.03rem;
    }

    .hub-row,
    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .hub-row {
      grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
    }

    .grid,
    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    .hub-card,
    .info-card,
    .link-card {
      display: block;
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
    }

    .hub-card,
    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .hub-card:hover,
    .link-card:hover {
      transform: translateY(-3px);
      border-color: rgba(15, 118, 110, 0.35);
      box-shadow: 0 16px 35px rgba(15, 23, 42, 0.08);
    }

    .hub-card-top {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
      margin-bottom: 8px;
    }

    .hub-card strong,
    .info-card h3,
    .link-card strong {
      display: block;
      color: var(--text);
      font-size: 1.08rem;
      line-height: 1.35;
      margin: 0 0 10px;
    }

    .count-pill {
      flex: 0 0 auto;
      border-radius: 999px;
      background: #ecfdf5;
      color: #0f766e;
      font-size: 0.74rem;
      font-weight: 900;
      padding: 5px 9px;
    }

    .hub-card span,
    .info-card p,
    .link-card span {
      display: block;
      color: var(--muted);
      line-height: 1.65;
      font-size: 0.94rem;
      margin: 0;
    }

    .hub-link {
      white-space: nowrap;
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
    }

    .hub-link:hover {
      text-decoration: underline;
    }

    .verdict-bar,
    .note {
      margin-top: 72px;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: #f8fafc;
      max-width: 980px;
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .ordered-list,
    .check-list,
    .red-flag-list {
      margin: 22px 0 0;
      padding-left: 22px;
      color: var(--muted);
      line-height: 1.8;
      max-width: 900px;
    }

    .ordered-list li,
    .check-list li,
    .red-flag-list li {
      margin-bottom: 12px;
    }

    .red-flag-list li::marker {
      color: #b91c1c;
    }

    @media (max-width: 768px) {
      .page-container {
        padding: 52px 0 76px;
      }

      h1 {
        font-size: 2.75rem;
      }

      .subtitle,
      .section p,
      .wide-section p,
      .verdict-bar p,
      .note p {
        font-size: 1rem;
      }

      .trust-strip {
        grid-template-columns: 1fr;
        margin-bottom: 52px;
      }

      .hub-heading,
      .section-header {
        display: block;
      }

      .hub-link {
        display: inline-block;
        margin-top: 16px;
      }

      .hub-row,
      .grid,
      .info-grid,
      .link-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .hub-section,
      .section,
      .wide-section {
        margin-top: 58px;
      }
    }
  </style>

  <main class="page-container">
    <section class="hero">
      <div class="eyebrow">Calculator Library</div>

      <h1>Financial Calculators for Real Spending Decisions</h1>

      <p class="subtitle">
        Browse decision-focused calculators for baby costs, college, medical
        bills, funerals, weddings, cars, rent, groceries, travel, debt, emergency
        savings, home repairs, and other major financial choices. ShouldISpend
        evaluates more than the sticker price by considering take-home income,
        savings, debt pressure, outside help, emergency flexibility, recurring
        bills, and long-term tradeoffs.
      </p>

      <p class="subtitle">
        The goal is not to give a generic yes or no. The goal is to show whether
        the decision creates low, moderate, or high financial pressure so you can
        adjust the plan before committing.
      </p>

      <div class="inline-links">
        {categories.map((category) => <a href={category.hub}>{category.title}</a>)}
      </div>
    </section>

    <div class="trust-strip">
      <div class="trust-item">
        <strong>Verdict-driven</strong>
        <span>
          Each tool gives practical spending guidance instead of stopping at a raw number.
        </span>
      </div>

      <div class="trust-item">
        <strong>Pressure-based</strong>
        <span>
          Calculators look at cash flow, savings cushion, debt load, outside help, and recovery time.
        </span>
      </div>

      <div class="trust-item">
        <strong>Educational only</strong>
        <span>
          Results are estimates for decision support, not personalized professional advice.
        </span>
      </div>
    </div>

    <section class="hub-section">
      <div class="hub-heading">
        <div>
          <h2>Browse Calculator Categories</h2>

          <p>
            Start with the category closest to your decision. Each cluster is built
            around financial pressure, practical tradeoffs, internal linking, and
            decision context instead of simple one-number answers.
          </p>
        </div>
      </div>

      <div class="hub-row">
        {categorySummaries.map((category) => (
          <a class="hub-card" href={category.hub}>
            <div class="hub-card-top">
              <strong>{category.title}</strong>
              {category.count > 0 && <span class="count-pill">{category.count}</span>}
            </div>

            <span>{category.description}</span>
          </a>
        ))}
      </div>
    </section>

    {featuredCalculators.length > 0 && (
      <section class="section">
        <div class="section-header">
          <div>
            <h2 class="section-title">Core Financial Pressure Calculators</h2>

            <p class="section-description">
              Start with these flagship tools if you want to evaluate major
              sources of financial pressure: baby costs, college, debt, car
              payments, weddings, groceries, funerals, medical bills, and
              emergency savings.
            </p>
          </div>
        </div>

        <div class="grid">
          {featuredCalculators.map((calculator) => (
            <CalculatorCard
              category={calculator.category}
              title={calculator.title}
              description={calculator.description}
              href={calculator.href}
            />
          ))}
        </div>
      </section>
    )}

    <div class="verdict-bar">
      <div class="verdict-label">How ShouldISpend Works</div>

      <h2>
        The calculators are built around pressure, not permission.
      </h2>

      <p>
        A low-pressure result does not mean every purchase is wise. A high-pressure
        result does not mean every expense should be avoided. Some expenses are
        necessary, urgent, or covered by outside help. The result is meant to show
        the tradeoff: what the cost does to cash flow, savings, debt, and recovery
        room.
      </p>
    </div>

    <section class="wide-section">
      <h2>Methodology: What the Calculators Consider</h2>

      <p>
        ShouldISpend calculators use a consistent decision framework across
        different categories. The details change by topic, but the core question is
        the same: after this decision, is the household still financially stable?
      </p>

      <div class="info-grid">
        {methodologySteps.map((step) => (
          <div class="info-card">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <h2>What the Pressure Levels Mean</h2>

      <p>
        Pressure levels are decision signals. They are not moral judgments and they
        are not professional advice.
      </p>

      <div class="info-grid">
        {pressureSignals.map((signal) => (
          <div class="info-card">
            <h3>{signal.title}</h3>
            <p>{signal.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="wide-section">
      <h2>Reduce Financial Pressure Before You Spend</h2>

      <p>
        Many decisions become safer when the uncovered cost is lower, the timing is
        better, or the household has a clearer recovery plan.
      </p>

      <div class="info-grid">
        {reducePressureTips.map((tip) => (
          <div class="info-card">
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>Financial Red Flags</h2>

      <p>
        These signs suggest a calculator result deserves extra caution before you
        commit to the expense.
      </p>

      <ul class="red-flag-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section class="section">
      <h2>Calculator Assumptions</h2>

      <p>
        These assumptions help keep the calculator library consistent across
        categories.
      </p>

      <ul class="check-list">
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="wide-section">
      <h2>Helpful Starting Guides</h2>

      <p>
        These pages support many of the calculators because most major spending
        decisions eventually connect to savings, debt, housing, and monthly
        affordability.
      </p>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>
            <span>{guide.text}</span>
          </a>
        ))}
      </div>
    </section>

    {categories.map((category) => {
      const categoryCalculators = calculators.filter(
        (calculator) => calculator.category === category.name
      );

      if (categoryCalculators.length === 0) return null;

      return (
        <section class="section">
          <div class="section-header">
            <div>
              <h2 class="section-title">{category.title}</h2>

              <p class="section-description">{category.description}</p>
            </div>

            <a class="hub-link" href={category.hub}>
              View Category →
            </a>
          </div>

          <div class="grid">
            {categoryCalculators.map((calculator) => (
              <CalculatorCard
                category={calculator.category}
                title={calculator.title}
                description={calculator.description}
                href={calculator.href}
              />
            ))}
          </div>
        </section>
      );
    })}

    <section class="note">
      <h2>Use These Calculators as Pressure Tests</h2>

      <p>
        ShouldISpend calculators are built as educational decision-support tools.
        Use them to compare spending decisions, understand tradeoffs, and identify
        financial stress points before committing to a purchase, payment, trip,
        event, recurring expense, or major life change. For decisions involving
        taxes, legal issues, investments, loans, insurance, medical care, or major
        household changes, consider speaking with a qualified professional.
      </p>
    </section>

    <FAQSection title="ShouldISpend Calculator FAQ" faqs={calculatorFaqs} />
  </main>
</Layout>