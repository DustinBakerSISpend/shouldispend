---
import Layout from "../layouts/Layout.astro";
import { calculators } from "../data/calculators.js";
---
<Layout title="All Calculators | ShouldISpend">
  <style>
        .header {
      background: white;
      border-bottom: 1px solid var(--border);
      padding: 18px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 2rem;
      font-weight: 800;
      text-decoration: none;
      color: var(--text);
    }

    .nav {
      display: flex;
      gap: 24px;
    }

    .nav a {
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 24px;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 0.8rem;
      color: var(--accent);
      font-weight: 700;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.5rem, 7vw, 4.8rem);
      line-height: 1;
      margin: 0 0 20px;
    }

    .subtitle {
      max-width: 760px;
      font-size: 1.2rem;
      line-height: 1.7;
      color: var(--muted);
      margin-bottom: 60px;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 30px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 28px;
      margin-bottom: 60px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
    }

    .card-category {
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      color: var(--accent);
      font-weight: 700;
      margin-bottom: 14px;
    }

    .card h3 {
      font-size: 2rem;
      margin: 0 0 16px;
    }

    .card p {
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 24px;
    }

    .button {
      display: inline-block;
      background: var(--button);
      color: white;
      text-decoration: none;
      padding: 14px 22px;
      border-radius: 14px;
      font-weight: 700;
    }
.footer {
  border-top: 1px solid var(--border);
  margin-top: 80px;
  padding: 40px 24px;
  text-align: center;
  color: var(--muted);
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 24px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.footer-links a {
  color: var(--text);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
}

.footer-links a:hover {
  color: var(--accent);
}
      .button {
  display: inline-block;
  margin-top: 1rem;
  background: #0b132b;
  color: white;
  padding: 0.75rem 1rem;
  border-radius: 10px;
  text-decoration: none;
  font-weight: 700;
}

.button:hover {
  opacity: 0.92;
}
    @media (max-width: 768px) {
      .header {
        padding: 16px;
      }

      .nav {
        gap: 16px;
      }

      h1 {
        font-size: 3rem;
      }

      .card h3 {
        font-size: 1.6rem;
      }

      </style>

<div class="container">

  <div class="eyebrow">Calculator Library</div>

  <h1>All Financial Decision Calculators</h1>

  <p class="subtitle">
    Explore calculators for weddings, cars, travel, subscriptions,
    lifestyle spending, rent, debt, entertainment, and major purchases.
  </p>

  <h2 class="section-title">Featured Calculators</h2>

  <div class="grid">
{calculators.map((calculator) => (
  <div class="card">
    <div class="card-category">
      {calculator.category}
    </div>

    <h3>{calculator.title}</h3>

    <p>{calculator.description}</p>

    <a class="button" href={calculator.href}>
      Open Calculator
    </a>
  </div>
))}
    </div>


</div>
</Layout>