<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>All Calculators | ShouldISpend</title>

  <style>
    :root {
      --bg: #f4f7fb;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #475569;
      --border: #dbe3ee;
      --accent: #0f766e;
      --button: #0b132b;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    .header {
      background: white;
      border-bottom: 1px solid var(--border);
      padding: 18px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 2rem;
      font-weight: 800;
      text-decoration: none;
      color: var(--text);
    }

    .nav {
      display: flex;
      gap: 24px;
    }

    .nav a {
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 60px 24px;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 0.8rem;
      color: var(--accent);
      font-weight: 700;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.5rem, 7vw, 4.8rem);
      line-height: 1;
      margin: 0 0 20px;
    }

    .subtitle {
      max-width: 760px;
      font-size: 1.2rem;
      line-height: 1.7;
      color: var(--muted);
      margin-bottom: 60px;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 30px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 28px;
      margin-bottom: 60px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 28px;
    }

    .card-category {
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      color: var(--accent);
      font-weight: 700;
      margin-bottom: 14px;
    }

    .card h3 {
      font-size: 2rem;
      margin: 0 0 16px;
    }

    .card p {
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 24px;
    }

    .button {
      display: inline-block;
      background: var(--button);
      color: white;
      text-decoration: none;
      padding: 14px 22px;
      border-radius: 14px;
      font-weight: 700;
    }
.footer {
  border-top: 1px solid var(--border);
  margin-top: 80px;
  padding: 40px 24px;
  text-align: center;
  color: var(--muted);
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 24px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}

.footer-links a {
  color: var(--text);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
}

.footer-links a:hover {
  color: var(--accent);
}
    @media (max-width: 768px) {
      .header {
        padding: 16px;
      }

      .nav {
        gap: 16px;
      }

      h1 {
        font-size: 3rem;
      }

      .card h3 {
        font-size: 1.6rem;
      }
    }
  </style>
</head>

<body>

<header class="header">
