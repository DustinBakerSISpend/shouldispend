---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const categories = [
  {
    name: "Baby & Parenting",
    title: "Baby & Parenting Calculators",
    description:
      "Newborn costs, childcare, diapers, formula, leave, and the monthly reality of adding a baby.",
    hub: "/baby-parenting-calculators/",
  },
  {
    name: "College",
    title: "College Cost Calculators",
    description:
      "Tuition, scholarships, loans, family help, school choice, and whether the degree math still works.",
    hub: "/college-calculators/",
  },
  {
    name: "Medical",
    title: "Medical Cost Calculators",
    description:
      "Medical bills, payment plans, insurance gaps, emergency savings, and the cost of waiting.",
    hub: "/medical-calculators/",
  },
  {
    name: "Funeral Costs",
    title: "Funeral Cost Calculators",
    description:
      "Burial, cremation, insurance, family help, payment plans, and hard decisions in a hard week.",
    hub: "/funeral-calculators/",
  },
  {
    name: "Weddings",
    title: "Wedding Budget Calculators",
    description:
      "Guest count, venue cost, family contributions, debt risk, and what is left after the day is over.",
    hub: "/wedding-calculators/",
  },
  {
    name: "Cars",
    title: "Car Payment Calculators",
    description:
      "Monthly payments, insurance, loan length, existing debt, and the real cost of driving away.",
    hub: "/car-calculators/",
  },
  {
    name: "Rent",
    title: "Rent Affordability Calculators",
    description:
      "Rent, utilities, transportation, debt payments, savings goals, and whether the month still works.",
    hub: "/rent-calculators/",
  },
  {
    name: "Moving",
    title: "Moving and First Apartment Calculators",
    description:
      "Deposits, furniture, utilities, moving costs, first-apartment pressure, and the cash needed to land safely.",
    hub: "/moving-calculators/",
  },
  {
    name: "Groceries",
    title: "Grocery Budget Calculators",
    description:
      "Food spending by household size, income, habits, meal planning, and why the budget feels tight.",
    hub: "/grocery-calculators/",
  },
  {
    name: "Travel",
    title: "Vacation Spending Calculators",
    description:
      "Disney, Europe, cruises, honeymoons, road trips, family travel, and the bill after the trip.",
    hub: "/travel-calculators/",
  },
  {
    name: "Budget Rules",
    title: "Budget Rule Calculators and Guides",
    description:
      "Rent rules, debt rules, emergency savings, car limits, and percentage-based checks against real numbers.",
    hub: "/budget-rule-calculators/",
  },
  {
    name: "Emergency Savings",
    title: "Emergency Savings Calculators",
    count: 7,
    description:
      "How much cash cushion you need before, during, and after a major spending decision.",
    hub: "/emergency-savings-calculators/",
  },
  {
    name: "Home Improvement",
    title: "Home Improvement Calculators",
    description:
      "Repairs, renovations, emergency fixes, annual maintenance, savings use, and debt pressure.",
    hub: "/home-improvement-calculators/",
  },
];

const featuredHrefs = [
  "/baby-cost-calculator/",
  "/can-we-afford-to-have-a-baby/",
  "/how-much-debt-is-too-much/",
  "/wedding-calculators/",
  "/grocery-calculators/",
  "/should-i-spend-10000-on-a-funeral/",
  "/should-i-spend-this-much-on-medical-bills/",
];

const featuredCalculators = featuredHrefs
  .map((href) => calculators.find((calculator) => calculator.href === href))
  .filter(Boolean);

const categorySummaries = categories.map((category) => {
  const calculatedCount = calculators.filter(
    (calculator) => calculator.category === category.name
  ).length;

  const count =
    typeof category.count === "number" ? category.count : calculatedCount;

  return {
    ...category,
    count,
  };
});

const methodologySteps = [
  {
    title: "Start with the real cost",
    text:
      "The headline price is rarely the whole decision. Taxes, fees, insurance, supplies, tips, interest, travel, repairs, and recurring add-ons can change the pressure.",
  },
  {
    title: "Use take-home income",
    text:
      "These calculators work best with the money actually available after taxes, insurance, benefits, payroll deductions, and retirement contributions.",
  },
  {
    title: "Subtract confirmed help",
    text:
      "Insurance, scholarships, grants, employer benefits, family help, reimbursements, and other confirmed support should reduce the true uncovered cost.",
  },
  {
    title: "Look at savings after",
    text:
      "A decision is safer when emergency savings survive it. It becomes riskier when the cost leaves no room for normal life surprises.",
  },
  {
    title: "Check monthly pressure",
    text:
      "Financing can make something possible today while creating stress later. The calculators look at payments, debt, and the room left after required bills.",
  },
  {
    title: "Find the recovery path",
    text:
      "The best decisions leave a way back to stability. The question is not only whether you can pay. It is what happens next.",
  },
];

const pressureSignals = [
  {
    title: "Green Pressure",
    text:
      "The cost looks manageable because income, savings, outside help, or low debt leave enough breathing room afterward.",
  },
  {
    title: "Moderate Pressure",
    text:
      "The decision may work, but it likely needs tradeoffs, a slower savings rebuild, a tighter month, or a clearer plan.",
  },
  {
    title: "High Pressure",
    text:
      "The decision may create serious strain by draining savings, adding hard debt, crowding out essentials, or leaving little emergency room.",
  },
];

const redFlags = [
  "The decision would use nearly all emergency savings.",
  "The cost depends on credit cards or high-interest debt.",
  "Outside help is assumed but not confirmed.",
  "The monthly payment works only if nothing else goes wrong.",
  "The calculation uses gross income instead of take-home pay.",
  "The decision ignores taxes, fees, insurance, maintenance, supplies, or add-ons.",
  "A one-time cost creates recurring pressure for months or years.",
  "The purchase delays rent stability, medical care, debt payoff, emergency savings, or other essentials.",
];

const reducePressureTips = [
  {
    title: "Shrink the uncovered cost",
    text:
      "Use confirmed aid, insurance, scholarships, family help, employer benefits, reimbursements, used items, lower-cost choices, or phased spending before debt.",
  },
  {
    title: "Delay optional spending",
    text:
      "When the decision is not urgent, waiting can protect savings, reduce borrowing, and make the final choice calmer.",
  },
  {
    title: "Separate needs from upgrades",
    text:
      "A necessary repair, medical bill, childcare cost, or tuition decision is different from a preference-based upgrade.",
  },
  {
    title: "Run more than one calculator",
    text:
      "Big decisions often spill into other categories. A baby affects groceries and medical costs. A wedding can affect travel and debt.",
  },
  {
    title: "Protect the next month",
    text:
      "The decision should still leave enough room for rent, food, transportation, insurance, debt payments, and normal bills.",
  },
  {
    title: "Create a recovery plan",
    text:
      "If savings must be used, decide how fast they can be rebuilt and what spending will pause until the household stabilizes.",
  },
];

const assumptions = [
  "ShouldISpend calculators are educational decision-support tools, not personalized financial, tax, legal, medical, insurance, or investment advice.",
  "Monthly income means take-home pay available to support the person or household paying the cost.",
  "Confirmed outside help should reduce the true uncovered cost.",
  "No calculator should create artificial pressure when the true cost is fully covered by outside help, strong savings, or very high available income.",
  "Urgent needs should be treated differently from optional upgrades.",
  "A low-pressure result is not a command to spend, and a high-pressure result is not always a command to avoid the expense.",
];

const relatedGuides = [
  {
    href: "/budget-rule-calculators/",
    title: "Budget Rule Calculators",
    text:
      "Use percentage rules as starting points for rent, debt, car payments, and major spending decisions.",
  },
  {
    href: "/emergency-savings-calculators/",
    title: "Emergency Savings Calculator",
    text:
      "Estimate how much cash cushion you may need before and after major expenses.",
  },
  {
    href: "/how-much-debt-is-too-much/",
    title: "How Much Debt Is Too Much?",
    text:
      "See whether monthly debt pressure is limiting flexibility, savings, and stability.",
  },
  {
    href: "/what-counts-as-debt/",
    title: "What Counts as Debt?",
    text:
      "Know which obligations should count when evaluating monthly affordability.",
  },
  {
    href: "/how-much-rent-can-i-afford/",
    title: "How Much Rent Can I Afford?",
    text:
      "Compare rent against take-home pay, utilities, debt, transportation, and emergency savings.",
  },
  {
    href: "/how-much-house-can-i-afford/",
    title: "How Much House Can I Afford?",
    text:
      "Evaluate home affordability with income, debt, taxes, insurance, maintenance, and savings.",
  },
];


const chooserCards = [
  {
    title: "Use a hub when you are still comparing options",
    text:
      "Category hubs are best when you know the general problem, such as rent, car costs, groceries, weddings, baby costs, medical bills, travel, or emergency savings, but not the exact calculator yet.",
  },
  {
    title: "Use a dollar-specific page when the price is fixed",
    text:
      "If the quote, bill, payment, or budget is already known, a dollar-specific calculator can pressure-test that exact amount against income, savings, debt, and outside help.",
  },
  {
    title: "Use an affordability calculator when the budget is unknown",
    text:
      "If you are asking how much car, rent, vacation, college, or house you can afford, start with the broader affordability calculators before choosing a specific spending target.",
  },
  {
    title: "Use debt and savings calculators when the decision affects stability",
    text:
      "If the purchase touches credit cards, emergency savings, loan payments, or monthly breathing room, run a savings or debt calculator alongside the spending calculator.",
  },
];

const workedExamples = [
  {
    title: "$700 car payment on $4,000 take-home income",
    text:
      "A $700 payment can create high monthly pressure if take-home income is $4,000, emergency savings are thin, insurance is expensive, and other debt already exists. The payment may technically fit but still crowd out repairs, rent, groceries, and savings.",
  },
  {
    title: "$700 car payment with very strong savings",
    text:
      "The same $700 payment can be low-pressure or even zero-pressure when income is high, emergency savings are very large compared with the vehicle cost, there is no risky debt, and the payment does not threaten monthly essentials.",
  },
  {
    title: "$30,000 wedding with $20,000 confirmed family help",
    text:
      "A large wedding budget can become much safer when outside help is confirmed, the uncovered cost is small, no credit-card debt is needed, and the couple still has emergency savings after deposits and final vendor payments.",
  },
  {
    title: "$10,000 funeral with insurance and shared family support",
    text:
      "Funeral costs are different from optional spending. The calculator should look at urgency, insurance proceeds, family contributions, payment-plan risk, and whether the remaining cost would drain savings or create high-interest debt.",
  },
  {
    title: "$1,500 groceries for a large household",
    text:
      "A grocery bill that looks high in isolation may be reasonable for a larger household, special diet, high local prices, or reduced restaurant spending. The pressure depends on take-home income, debt, savings, and what the food budget replaces.",
  },
  {
    title: "$8,000 medical bill with no emergency fund",
    text:
      "A necessary medical bill may still be high-pressure if there is no cash cushion. In that case, the result should push toward payment-plan comparison, financial assistance, insurance review, and avoiding high-interest debt where possible.",
  },
];

const hubReviewNotes = [
  {
    title: "Written and maintained by Dustin Baker",
    text:
      "ShouldISpend is built around practical consumer decision-making: what a cost does to income, savings, debt, and monthly room after the decision is made.",
  },
  {
    title: "Last reviewed: July 2026",
    text:
      "The calculator library is reviewed for calculation accuracy, clear assumptions, practical examples, and scenarios where income, savings, debt, or outside help materially change the result.",
  },
  {
    title: "Educational planning, not personal advice",
    text:
      "The calculators are pressure tests for planning. They do not replace a qualified financial, tax, legal, medical, insurance, or investment professional.",
  },
];
const calculatorFaqs = [
  {
    question: "What is ShouldISpend?",
    answer:
      "ShouldISpend is a library of calculators that pressure-test major expenses against take-home income, savings, debt, outside help, and monthly breathing room.",
  },
  {
    question: "Are these calculators financial advice?",
    answer:
      "No. The calculators are educational pressure tests. They can help clarify tradeoffs, but they are not personalized financial, legal, tax, medical, insurance, or investment advice.",
  },
  {
    question: "Why do the calculators focus on pressure instead of only cost?",
    answer:
      "The same cost can be easy for one household and risky for another. Pressure depends on income, savings, debt, urgency, outside help, recurring payments, and what remains after the decision.",
  },
  {
    question: "Should I use gross income or take-home income?",
    answer:
      "Use take-home income. That better reflects the money actually available after taxes, insurance, benefits, payroll deductions, and retirement contributions.",
  },
  {
    question: "What if family help, insurance, or aid covers the cost?",
    answer:
      "Confirmed outside help should reduce the true uncovered cost. If the full cost is covered, the financial pressure should usually be very low or zero.",
  },
  {
    question: "Can a high-pressure result still be the right decision?",
    answer:
      "Yes. Some costs are necessary, such as urgent medical bills, essential repairs, funeral expenses, or childcare. A high-pressure result means the decision needs a plan, not that the need is fake.",
  },
];
---

<Layout
  title="All Financial Calculators | ShouldISpend"
  description="Browse ShouldISpend calculators for baby costs, college, funerals, weddings, cars, rent, groceries, travel, debt, savings, and more."
>
  <style>
    .page-container {
      width: 92%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 72px 0 94px;
    }

    .hero {
      max-width: 980px;
      margin-bottom: 54px;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-size: 0.78rem;
      color: var(--primary);
      font-weight: 800;
      margin-bottom: 18px;
    }

    h1 {
      max-width: 980px;
      font-size: clamp(2.75rem, 6.7vw, 5rem);
      line-height: 0.98;
      margin: 0 0 24px;
      color: var(--text);
      letter-spacing: -0.055em;
    }

    .subtitle,
    .section p,
    .wide-section p,
    .verdict-bar p,
    .note p {
      max-width: 880px;
      font-size: 1.06rem;
      line-height: 1.85;
      color: var(--muted);
    }

    .subtitle {
      margin: 0 0 18px;
    }

    .inline-links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .inline-links a {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 10px 14px;
      color: var(--primary);
      text-decoration: none;
      font-weight: 800;
      font-size: 0.92rem;
      background: var(--card);
    }

    .inline-links a:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .trust-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 34px 0 64px;
    }

    .trust-item {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 20px;
      box-shadow: var(--shadow-soft);
    }

    .trust-item strong {
      display: block;
      color: var(--text);
      font-size: 1rem;
      margin-bottom: 6px;
    }

    .trust-item span {
      color: var(--muted);
      font-size: 0.94rem;
      line-height: 1.6;
    }

    .hub-section,
    .section,
    .wide-section {
      margin-top: 78px;
    }

    .hub-section {
      margin-bottom: 76px;
    }

    .hub-heading,
    .section-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 26px;
    }

    .hub-heading h2,
    .section-title,
    .section h2,
    .wide-section h2,
    .verdict-bar h2,
    .note h2 {
      font-size: clamp(1.9rem, 4vw, 2.7rem);
      line-height: 1.08;
      margin: 0 0 14px;
      color: var(--text);
      letter-spacing: -0.035em;
    }

    .hub-heading p,
    .section-description {
      max-width: 800px;
      color: var(--muted);
      line-height: 1.75;
      margin: 0;
      font-size: 1.03rem;
    }

    .hub-row,
    .grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 24px;
    }

    .hub-row {
      grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
    }

    .grid,
    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    .hub-card,
    .info-card,
    .link-card {
      display: block;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
    }

    .hub-card,
    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .hub-card:hover,
    .link-card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: var(--shadow-soft);
    }

    .hub-card-top {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
      margin-bottom: 8px;
    }

    .hub-card strong,
    .info-card h3,
    .link-card strong {
      display: block;
      color: var(--text);
      font-size: 1.08rem;
      line-height: 1.35;
      margin: 0 0 10px;
    }

    .count-pill {
      flex: 0 0 auto;
      border-radius: 999px;
      background: #e1f5ee;
      color: var(--primary);
      font-size: 0.74rem;
      font-weight: 900;
      padding: 5px 9px;
    }

    .hub-card span,
    .info-card p,
    .link-card span {
      display: block;
      color: var(--muted);
      line-height: 1.65;
      font-size: 0.94rem;
      margin: 0;
    }

    .hub-link {
      white-space: nowrap;
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
    }

    .hub-link:hover {
      text-decoration: underline;
    }

    .verdict-bar,
    .note {
      margin-top: 72px;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: var(--card);
      max-width: 980px;
      box-shadow: var(--shadow-soft);
    }

    .verdict-label {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.8rem;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .red-flag-list,
    .check-list {
      margin: 22px 0 0;
      padding-left: 22px;
      color: var(--muted);
      line-height: 1.8;
      max-width: 900px;
    }

    .red-flag-list li,
    .check-list li {
      margin-bottom: 12px;
    }

    .red-flag-list li::marker {
      color: #b91c1c;
    }

    @media (max-width: 768px) {
      .page-container {
        padding: 52px 0 76px;
      }

      h1 {
        font-size: 2.55rem;
        line-height: 1.03;
      }

      .subtitle,
      .section p,
      .wide-section p,
      .verdict-bar p,
      .note p {
        font-size: 1rem;
      }

      .inline-links {
        gap: 10px;
      }

      .inline-links a {
        font-size: 0.86rem;
        padding: 9px 12px;
      }

      .trust-strip {
        grid-template-columns: 1fr;
        margin-bottom: 52px;
      }

      .hub-heading,
      .section-header {
        display: block;
      }

      .hub-link {
        display: inline-block;
        margin-top: 16px;
      }

      .hub-row,
      .grid,
      .info-grid,
      .link-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .hub-section,
      .section,
      .wide-section {
        margin-top: 58px;
      }

      .verdict-bar,
      .note {
        padding: 24px;
      }
    }
  </style>

  <main class="page-container">
    <section class="hero">
      <div class="eyebrow">Calculator Library</div>

      <h1>Find the calculator for the money decision in front of you.</h1>

      <p class="subtitle">
        Browse calculators for baby costs, college, medical bills, funerals,
        weddings, cars, rent, groceries, travel, moving, debt, emergency savings,
        home repairs, and other decisions that can reshape a month or a year.
      </p>

      <p class="subtitle">
        Each tool looks past the sticker price and asks the practical question:
        what happens to your income, savings, debt, and breathing room after the
        money is gone?
      </p>

      <div class="inline-links">
        {categories.map((category) => <a href={category.hub}>{category.title}</a>)}
      </div>
    </section>



    <div class="trust-strip">
      <div class="trust-item">
        <strong>Verdict-driven</strong>
        <span>Each tool gives a practical read instead of stopping at a raw number.</span>
      </div>

      <div class="trust-item">
        <strong>Pressure-based</strong>
        <span>Results account for savings, debt, outside help, monthly bills, and recovery room.</span>
      </div>

      <div class="trust-item">
        <strong>Educational only</strong>
        <span>Use the calculators as a second opinion, not personalized professional advice.</span>
      </div>    </div>

    <section id="HubReviewNotes" class="section">
      <div class="eyebrow">Review status</div>
      <h2>Built to make spending pressure visible before the decision is made.</h2>

      <p>
        ShouldISpend is not trying to tell every household what to do. The goal is
        to make the financial pressure easier to see before a bill, payment, trip,
        event, repair, or recurring cost becomes harder to reverse.
      </p>

      <div class="info-grid">
        {hubReviewNotes.map((note) => (
          <div class="info-card">
            <h3>{note.title}</h3>
            <p>{note.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="ChooseCalculator" class="wide-section">
      <div class="eyebrow">Choose the right tool</div>
      <h2>How to pick the calculator that matches your decision</h2>

      <p>
        A spending decision can be broad, specific, urgent, optional, one-time,
        recurring, fully covered, or debt-funded. Start with the tool that matches
        the part of the decision you actually control.
      </p>

      <div class="info-grid">
        {chooserCards.map((card) => (
          <div class="info-card">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        ))}
      </div>
    </section>

<OmniStyleReviewBlock
      pageName="the calculators index"
      pageType="calculator hub"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="major spending decisions, calculator selection, affordability pressure, income, savings, debt, emergency fund, cash flow, and choosing the right financial decision tool"
    />

    <CorePageExamplesBlock
      title="ShouldISpend calculator examples"
      intro="The calculators index is meant to help users choose the right pressure test before making a major spending decision."
      useCases={[
          "You need to find the right ShouldISpend calculator.",
          "You are comparing several spending decisions at once.",
          "You want to pressure-test a purchase against income, savings, debt, and cash flow."
        ]}
      notEnough={[
          "You need personalized financial, tax, investment, legal, or medical advice.",
          "You need a live quote or product recommendation.",
          "You are dealing with an urgent financial crisis."
        ]}
      examples={[
          {
            label: "Major purchase",
            takeaway: "Start with the category calculator closest to the decision."
          },
          {
            label: "Debt or savings concern",
            takeaway: "Use debt and emergency calculators before optional purchases."
          },
          {
            label: "Life event cost",
            takeaway: "Wedding, baby, college, moving, and funeral decisions need full-budget context."
          }
        ]}
      commonMistake="Using a calculator as permission instead of a pressure test."
      nextStep="Choose the closest category, then run the most specific calculator available."
    />



    <section id="WorkedExamples" class="wide-section">
      <div class="eyebrow">Worked examples</div>
      <h2>Examples of how the same price can create different pressure</h2>

      <p>
        These examples are visible without using a form so readers and search engines
        can understand the logic behind the calculator library. The same dollar amount
        can be safe, risky, or urgent depending on savings, income, debt, outside help,
        and whether the expense is optional.
      </p>

      <div class="info-grid">
        {workedExamples.map((example) => (
          <div class="info-card">
            <h3>{example.title}</h3>
            <p>{example.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="WhenCalculatorIsNotEnough" class="section">
      <div class="eyebrow">Limits</div>
      <h2>When a calculator is not enough</h2>

      <p>
        A calculator can show pressure, but it cannot know every personal risk.
        Slow down before relying on a calculator alone when the decision involves
        legal obligations, tax consequences, medical treatment, insurance disputes,
        bankruptcy risk, major loans, unstable income, custody or family obligations,
        or a situation where the cheapest option could create harm later.
      </p>
    </section>

    <section class="hub-section">
      <div class="hub-heading">
        <div>
          <div class="eyebrow">Every category</div>
          <h2>Start with the expense that is actually causing the stress.</h2>

          <p>
            Some decisions are monthly. Some happen once and still echo for years.
            Pick the category closest to what you are weighing right now.
          </p>
        </div>
      </div>

      <div class="hub-row">
        {categorySummaries.map((category) => (
          <a class="hub-card" href={category.hub}>
            <div class="hub-card-top">
              <strong>{category.title}</strong>
              {category.count > 0 && <span class="count-pill">{category.count}</span>}
            </div>

            <span>{category.description}</span>
          </a>
        ))}
      </div>
    </section>

    {featuredCalculators.length > 0 && (
      <section class="section">
        <div class="section-header">
          <div>
            <div class="eyebrow">Good starting points</div>
            <h2 class="section-title">Core calculators people reach for first</h2>

            <p class="section-description">
              Start here for the decisions that most often create real pressure:
              baby costs, debt, car payments, weddings, groceries, funerals,
              medical bills, college, and emergency savings.
            </p>
          </div>
        </div>

        <div class="grid">
          {featuredCalculators.map((calculator) => (
            <CalculatorCard
              category={calculator.category}
              title={calculator.title}
              description={calculator.description}
              href={calculator.href}
            />
          ))}
        </div>
      </section>
    )}

    <div class="verdict-bar">
      <div class="verdict-label">How ShouldISpend works</div>

      <h2>The calculators are built around pressure, not permission.</h2>

      <p>
        A low-pressure result does not mean every purchase is wise. A high-pressure
        result does not mean every expense should be avoided. Some costs are
        necessary, urgent, or fully covered by outside help. The point is to show
        the tradeoff before you commit.
      </p>
    </div>

    <section id="MethodologySection" class="wide-section">
      <div class="eyebrow">Methodology</div>
      <h2>What the calculators consider</h2>

      <p>
        The details change by topic, but the core question stays the same:
        after this decision, does the household still have enough room to stay stable?
      </p>

      <div class="info-grid">
        {methodologySteps.map((step) => (
          <div class="info-card">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="KeyCostCategories" class="wide-section">
      <div class="eyebrow">Verdicts</div>
      <h2>What the pressure levels mean</h2>

      <p>
        Pressure levels are decision signals. They are not moral judgments and
        they are not professional advice.
      </p>

      <div class="info-grid">
        {pressureSignals.map((signal) => (
          <div class="info-card">
            <h3>{signal.title}</h3>
            <p>{signal.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="ReduceCostTips" class="wide-section">
      <div class="eyebrow">Before you spend</div>
      <h2>Ways to reduce financial pressure</h2>

      <p>
        Many decisions become safer when the uncovered cost is lower, the timing
        is better, or the household has a clearer recovery plan.
      </p>

      <div class="info-grid">
        {reducePressureTips.map((tip) => (
          <div class="info-card">
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section id="FinancialRedFlags" class="section">
      <div class="eyebrow">Warning signs</div>
      <h2>Financial red flags</h2>

      <p>
        These signs do not always mean no. They do mean the decision deserves a
        second look before you commit.
      </p>

      <ul class="red-flag-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section id="CalculatorAssumptions" class="section">
      <div class="eyebrow">Assumptions</div>
      <h2>How the library stays consistent</h2>

      <p>
        These assumptions keep the calculators pointed in the same direction
        across very different categories.
      </p>

      <ul class="check-list">
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section id="RelatedCalculators" class="wide-section">
      <div class="eyebrow">Helpful guides</div>
      <h2>Start here when the decision connects to savings, debt, or housing</h2>

      <p>
        Most major spending decisions eventually connect to emergency savings,
        debt, rent, housing, or monthly affordability. These guides support the
        math behind many calculators.
      </p>

      <div class="link-grid">
        {relatedGuides.map((guide) => (
          <a class="link-card" href={guide.href}>
            <strong>{guide.title}</strong>
            <span>{guide.text}</span>
          </a>
        ))}
      </div>
    </section>

    {categories.map((category) => {
      const categoryCalculators = calculators.filter(
        (calculator) => calculator.category === category.name
      );

      if (categoryCalculators.length === 0) return null;

      return (
        <section class="section">
          <div class="section-header">
            <div>
              <h2 class="section-title">{category.title}</h2>

              <p class="section-description">{category.description}</p>
            </div>

            <a class="hub-link" href={category.hub}>
              View Category &rarr;
            </a>
          </div>

          <div class="grid">
            {categoryCalculators.map((calculator) => (
              <CalculatorCard
                category={calculator.category}
                title={calculator.title}
                description={calculator.description}
                href={calculator.href}
              />
            ))}
          </div>
        </section>
      );
    })}

    <section class="note">
      <div class="eyebrow">Use them as pressure tests</div>
      <h2>A calculator result is a starting point, not the final word.</h2>

      <p>
        Use ShouldISpend calculators to compare spending decisions, understand
        tradeoffs, and identify stress points before committing to a purchase,
        payment, trip, event, recurring expense, or major life change. For decisions
        involving taxes, legal issues, investments, loans, insurance, medical care,
        or major household changes, consider speaking with a qualified professional.
      </p>
    </section>

    <section id="CalculatorHubPolicyLinks" class="note">
      <div class="eyebrow">Trust and policies</div>
      <h2>How to review the calculator library</h2>

      <p>
        ShouldISpend calculators are written and maintained by Dustin Baker and are
        reviewed for calculation accuracy, clear explanations, and uncommon financial scenarios. For
        more context, read the <a href="/methodology/">Methodology</a>,
        <a href="/editorial-policy/">Editorial Policy</a>, <a href="/disclaimer/">Disclaimer</a>,
        <a href="/terms/">Terms</a>, and <a href="/privacy/">Privacy Policy</a>.
      </p>
    </section>
    <FAQSection title="ShouldISpend Calculator FAQ" faqs={calculatorFaqs} />
  </main>
</Layout>

