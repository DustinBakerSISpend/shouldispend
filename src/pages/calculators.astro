---
import Layout from "../layouts/Layout.astro";
import { calculators } from "../data/calculators.js";
---

<Layout title="All Calculators | ShouldISpend">
	<style>
		.page-container {
			max-width: 1200px;
			margin: 0 auto;
			padding: 60px 24px;
		}

		.eyebrow {
			text-transform: uppercase;
			letter-spacing: 3px;
			font-size: 0.8rem;
			color: var(--primary);
			font-weight: 700;
			margin-bottom: 18px;
		}

		h1 {
			font-size: clamp(2.5rem, 7vw, 4.8rem);
			line-height: 1;
			margin: 0 0 20px;
		}

		.subtitle {
			max-width: 760px;
			font-size: 1.2rem;
			line-height: 1.7;
			color: var(--muted);
			margin-bottom: 60px;
		}

		.section-title {
			font-size: 2rem;
			margin-bottom: 30px;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 28px;
			margin-bottom: 60px;
		}

		.card {
			background: var(--card);
			border: 1px solid var(--border);
			border-radius: 24px;
			padding: 28px;
		}

		.card-category {
			text-transform: uppercase;
			letter-spacing: 2px;
			font-size: 0.75rem;
			color: var(--primary);
			font-weight: 700;
			margin-bottom: 14px;
		}

		.card h3 {
			font-size: 1.8rem;
			line-height: 1.1;
			margin: 0 0 16px;
		}

		.card p {
			color: var(--muted);
			line-height: 1.7;
			margin-bottom: 24px;
		}

		.button {
			display: inline-block;
			background: #0b132b;
			color: white;
			padding: 0.75rem 1rem;
			border-radius: 10px;
			text-decoration: none;
			font-weight: 700;
		}

		.button:hover {
			opacity: 0.92;
		}

		@media (max-width: 768px) {
			.page-container {
				padding: 42px 18px;
			}

			h1 {
				font-size: 2.7rem;
			}

			.subtitle {
				font-size: 1.05rem;
				margin-bottom: 42px;
			}

			.section-title {
				font-size: 1.65rem;
			}

			.grid {
				grid-template-columns: 1fr;
				gap: 18px;
			}

			.card {
				padding: 24px;
				border-radius: 20px;
			}

			.card h3 {
				font-size: 1.55rem;
			}
		}
	</style>

	<div class="page-container">
		<div class="eyebrow">Calculator Library</div>

		<h1>All Financial Decision Calculators</h1>

		<p class="subtitle">
			Explore verdict-driven calculators for weddings, cars, travel, subscriptions,
			lifestyle spending, rent, debt, entertainment, and major purchases.
		</p>

		<h2 class="section-title">Featured Calculators</h2>

		<div class="grid">
			{calculators.map((calculator) => (
				<div class="card">
					<div class="card-category">{calculator.category}</div>

					<h3>{calculator.title}</h3>

					<p>{calculator.description}</p>

					<a class="button" href={calculator.href}>Open Calculator</a>
				</div>
			))}
		</div>
	</div>
</Layout>