---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
import { calculators } from "../data/calculators.js";

const collegeFaqs = [
  {
    question: "Is $20,000 too much to spend on college?",
    answer:
      "$20,000 can be manageable when the program has a clear payoff, borrowing is limited, emergency savings remain intact, and monthly obligations stay flexible. It becomes riskier when the cost depends on debt, drains savings, or does not improve earning power.",
  },
  {
    question: "Should I borrow $20,000 for college?",
    answer:
      "Borrowing $20,000 may make sense if the degree or credential has strong income potential and the future payment fits your expected budget. It deserves caution if you already have debt, uncertain job prospects, or no clear repayment plan.",
  },
  {
    question: "Should I use savings to pay for college?",
    answer:
      "Using savings can reduce loan pressure, but it should not wipe out your emergency fund or leave you unable to handle rent, repairs, medical bills, childcare, or job disruption.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "College" &&
      calculator.href !== "/should-i-spend-20000-on-college"
  )
  .slice(0, 4);
---

<Layout
  title="Should I Spend $20,000 on College?"
  description="Evaluate whether spending $20,000 on college fits your savings, student loan risk, income, career payoff, debt pressure, and financial flexibility."
>
  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a,
    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .helper-link a:hover,
    .content-link:hover {
      text-decoration: underline;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .guidance {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid #dbe4ee;
      font-size: 1.12rem;
      line-height: 1.85;
      color: #1e293b;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
    }

    .pillar-card {
      display: block;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 24px;
      margin-top: 28px;
      text-decoration: none;
      transition: transform 0.15s ease;
    }

    .pillar-card:hover {
      transform: translateY(-2px);
    }

    .pillar-card strong {
      display: block;
      margin-bottom: 10px;
      color: #0f172a;
      font-size: 1.08rem;
    }

    .pillar-card span {
      color: #334155;
      line-height: 1.7;
      font-size: 0.98rem;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="College Cost Calculator"
      title="Should I Spend $20,000 on College?"
      description="Pressure-test a $20,000 college expense against savings, student loan risk, income, career payoff, and monthly financial flexibility."
    >
      <div class="calculator">
        <h2>$20,000 College Pressure Verdict</h2>

        <p class="calculator-intro">
          Enter your income, savings, expected borrowing, existing monthly debt,
          and expected income gain. This calculator estimates whether spending
          $20,000 on college looks manageable, worth caution, or financially
          stressful.
        </p>

        <div class="grid">
          <div class="field">
            <label for="income">Monthly Take-Home Income</label>
            <input id="income" type="number" placeholder="Example: 5500" />
          </div>

          <div class="field">
            <label for="savings">Current Savings</label>
            <input id="savings" type="number" placeholder="Example: 18000" />
          </div>

          <div class="field">
            <label for="collegeCost">Total College Cost</label>
            <input id="collegeCost" type="number" placeholder="Example: 20000" />
          </div>

          <div class="field">
            <label for="borrowed">Amount You Expect to Borrow</label>
            <input id="borrowed" type="number" placeholder="Example: 12000" />

            <div class="helper-link">
              Comparing loan pressure?
              <a href="/should-i-take-out-student-loans">Use the student loan calculator</a>
            </div>
          </div>

          <div class="field">
            <label for="debt">Current Monthly Debt Payments</label>
            <input id="debt" type="number" placeholder="Example: 650" />

            <div class="helper-link">
              Not sure what counts as debt?
              <a href="/what-counts-as-debt">Read the debt guide</a>
            </div>
          </div>

          <div class="field">
            <label for="incomeGain">Expected Monthly Income Gain After School</label>
            <input id="incomeGain" type="number" placeholder="Example: 900" />
          </div>

          <div class="field">
            <label for="programStrength">Program Confidence</label>
            <select id="programStrength">
              <option value="strong">Strong job or income path</option>
              <option value="medium" selected>Some career upside</option>
              <option value="weak">Unclear payoff</option>
            </select>
          </div>

          <div class="field">
            <label for="cashUsed">Savings You Plan to Use</label>
            <input id="cashUsed" type="number" placeholder="Example: 8000" />
          </div>
        </div>

        <button id="collegeButton" type="button">Get College Verdict</button>

        <div class="results" id="results">
          <div class="score" id="scoreText"></div>

          <div class="bar">
            <div class="fill" id="fillBar"></div>
          </div>

          <div class="result-details" id="resultDetails"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <section class="content-section">
        <h2>Start With the Full College Cost Calculator</h2>

        <p>
          A $20,000 college decision may involve tuition, fees, books, housing,
          transportation, reduced work hours, student loans, and savings tradeoffs.
          The cost should be judged against the full financial picture, not only
          the sticker price.
        </p>

        <a class="pillar-card" href="/college-cost-calculator">
          <strong>College Cost Calculator</strong>
          <span>
            Estimate total education pressure using tuition, fees, housing,
            books, loans, savings, expected payoff, and household flexibility.
          </span>
        </a>

        <a class="pillar-card" href="/should-i-use-savings-for-college">
          <strong>Should I Use Savings for College?</strong>
          <span>
            Decide whether paying cash for school reduces risk or leaves too
            little emergency cushion after tuition and fees.
          </span>
        </a>

        <a class="pillar-card" href="/how-much-emergency-savings-should-i-have">
          <strong>Emergency Savings Guide</strong>
          <span>
            See how much savings cushion to preserve before committing cash to
            tuition, books, housing, or school-related costs.
          </span>
        </a>
      </section>

      <section class="content-section">
        <h2>What a $20,000 College Decision Really Includes</h2>

        <p>
          A $20,000 college cost might represent a year of school, a certificate
          program, a community college path, a private-school gap, or part of a
          degree. The number matters, but the funding method matters just as much.
        </p>

        <p>
          Paying $20,000 from savings is different from borrowing $20,000.
          Borrowing is different from combining scholarships, cash, work income,
          and a smaller loan. The healthiest plan usually limits high-pressure
          borrowing while preserving enough cash for normal life.
        </p>
      </section>

      <WhenSpendingMakesSense
        title="When Spending $20,000 on College Can Make Sense"
        items={[
          "The program has a clear job, income, certification, or promotion path.",
          "You can pay some or all of the cost without draining emergency savings.",
          "Any student loan payment would fit your expected post-school income.",
          "You have compared cheaper schools, credits, grants, and employer help.",
          "The decision improves long-term stability instead of only delaying pressure.",
        ]}
      />

      <section class="content-section">
        <h2>When You Should Wait</h2>

        <p>
          A $20,000 college expense may be too aggressive if the program payoff
          is unclear, the cost requires risky borrowing, or the decision leaves
          you without enough savings for rent, food, transportation, medical
          costs, childcare, or job disruption.
        </p>

        <p>
          Waiting does not always mean abandoning school. It may mean applying
          for grants, starting at a lower-cost institution, transferring credits,
          asking about employer reimbursement, or building a stronger cash cushion
          first.
        </p>

        <p>
          If the decision would strain
          <a class="content-link" href="/how-much-rent-can-i-afford">
            housing
          </a>,
          <a class="content-link" href="/should-i-spend-this-much-on-groceries-per-month">
            groceries
          </a>,
          medical bills, transportation, or existing debt, the education plan
          should be redesigned before you commit.
        </p>
      </section>

      <section class="content-section">
        <h2>Key Costs to Consider</h2>

        <p>
          Tuition is only one part of college affordability. Fees, books,
          software, lab supplies, technology, transportation, housing, parking,
          childcare, and lost work hours can change the true cost.
        </p>

        <p>
          A $20,000 program with a clear payoff and limited borrowing may be
          safer than a cheaper program that does not move your career forward.
          The goal is not simply to spend less. The goal is to avoid financial
          pressure that outweighs the benefit.
        </p>

        <p>
          You can also compare this decision with the broader
          <a class="content-link" href="/college-calculators">
            college calculator hub
          </a>
          before choosing a school, loan amount, or payment plan.
        </p>
      </section>

      <section class="content-section">
        <h2>Signs the College Cost Is Creating Financial Pressure</h2>

        <p>
          Be careful if the expense wipes out your emergency fund, requires
          credit cards, adds student loans without a clear income path, or forces
          you to pause essential bills and debt payments.
        </p>

        <p>
          A weaker verdict does not mean college is a bad idea. It means this
          version of the plan may need more aid, lower costs, stronger savings,
          or a clearer payoff before it becomes financially durable.
        </p>
      </section>
      <section class="content-section" id="FinancialRedFlags">
        <h2>Financial Red Flags Before Spending $20,000 on College</h2>
        <ul>
          <li>You would need to borrow most of the $20,000 without a realistic repayment plan.</li>
          <li>Using savings would leave little or nothing for emergencies.</li>
          <li>The program has an uncertain graduation rate or weak employment outcomes.</li>
          <li>New student loan payments would compete with housing, groceries, transportation, or existing debt.</li>
          <li>You have not fully explored grants, scholarships, employer tuition assistance, or lower-cost alternatives.</li>
        </ul>
      </section>

      <section class="content-section" id="ReduceCostTips">
        <h2>Ways to Reduce the Cost of a $20,000 College Decision</h2>
        <ul>
          <li>Appeal your financial aid package before accepting the first offer.</li>
          <li>Complete general education courses at a lower-cost institution if credits transfer.</li>
          <li>Search for employer tuition reimbursement and local scholarship opportunities.</li>
          <li>Reduce housing, meal plan, transportation, and textbook expenses.</li>
          <li>Pay cash where practical and borrow only after all other funding sources have been exhausted.</li>
        </ul>
      </section>

      <section class="content-section" id="KeyCostCategories">
        <h2>Key Cost Categories</h2>
        <p>
          Tuition is only one piece of the decision. Housing, books, technology,
          transportation, fees, parking, supplies, childcare, and lost work
          income often determine whether a $20,000 education plan is actually
          affordable.
        </p>

        <p>
          Looking at the full cost�not just tuition�helps avoid borrowing more
          than expected and produces a more realistic affordability picture.
        </p>
      </section>

      <section class="content-section" id="CalculatorAssumptions">
        <h2>Calculator Assumptions</h2>
        <ul>
          <li>Monthly income means take-home pay after taxes and deductions.</li>
          <li>Student loan payments are estimated using a simplified repayment model.</li>
          <li>Any scholarships, grants, employer assistance, or family contributions should already be reflected in the numbers you enter.</li>
          <li>Expected income gains are estimates rather than guarantees.</li>
          <li>The score measures financial pressure, not educational quality.</li>
        </ul>
      </section>


      <section class="content-section">
        <h2>What Your College Verdict Actually Means</h2>

        <p>
          A college verdict is not a judgment on whether education matters. It
          estimates whether the current cost, savings drawdown, borrowing plan,
          and expected payoff create manageable or stressful financial pressure.
        </p>

        <p>
          A stronger verdict means the $20,000 decision is less likely to damage
          monthly flexibility. A weaker verdict means the education goal may
          still be worthwhile, but the funding plan deserves more caution.
        </p>
      </section>

      <div class="content-section">
        <FAQSection faqs={collegeFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="college affordability" />
  </div>

  <script is:inline>
    const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    function getPressureLevel(score) {
      if (score <= 30) {
        return {
          label: "Low Pressure",
          stress: "Low pressure",
          colorClass: "safe",
          action:
            "Keep the plan only if the program payoff remains clear and emergency savings stay protected.",
        };
      }

      if (score <= 60) {
        return {
          label: "Moderate Pressure",
          stress: "Moderate pressure",
          colorClass: "caution",
          action:
            "Compare grants, lower-cost schools, employer help, and smaller loan options before committing.",
        };
      }

      return {
        label: "High Pressure",
        stress: "High pressure",
        colorClass: "danger",
        action:
          "Reduce the cost, delay enrollment, increase aid, or strengthen savings before taking on this expense.",
      };
    }

    function calculateCollegePressure() {
      const income = getNumber("income");
      const savings = getNumber("savings");
      const collegeCost = getNumber("collegeCost") || 20000;
      const borrowed = getNumber("borrowed");
      const debt = getNumber("debt");
      const incomeGain = getNumber("incomeGain");
      const cashUsed = getNumber("cashUsed");
      const programStrength =
        document.getElementById("programStrength")?.value || "medium";

      const results = document.getElementById("results");
      const scoreText = document.getElementById("scoreText");
      const fillBar = document.getElementById("fillBar");
      const resultDetails = document.getElementById("resultDetails");
      const guidance = document.getElementById("guidance");

      results.classList.add("visible");

      if (income <= 0 || collegeCost <= 0) {
        scoreText.textContent = "Add your numbers first";
        fillBar.style.width = "0%";
        fillBar.className = "fill safe";

        resultDetails.innerHTML =
          "<p>Enter monthly take-home income, savings, college cost, expected borrowing, current debt payments, and expected income gain so the calculator can estimate financial pressure.</p>";

        guidance.textContent = "";
        return;
      }

      const estimatedLoanPayment = borrowed > 0 ? borrowed * 0.012 : 0;
      const costToIncomeRatio = (collegeCost / Math.max(income * 12, 1)) * 100;
      const cashUseRatio = (cashUsed / Math.max(savings, 1)) * 100;
      const remainingSavings = Math.max(savings - cashUsed, 0);
      const savingsMonthsAfter = remainingSavings / Math.max(income * 0.7, 1);
      const debtRatioBefore = (debt / income) * 100;
      const debtRatioAfter = ((debt + estimatedLoanPayment) / income) * 100;
      const loanToIncomeGainRatio =
        estimatedLoanPayment / Math.max(incomeGain, 1);
      const payoffStrength =
        incomeGain >= estimatedLoanPayment * 4
          ? "strong"
          : incomeGain >= estimatedLoanPayment * 2
            ? "moderate"
            : "weak";

      const incomeRecoveryPower = collegeCost / Math.max(income * 12, 1);
      const savingsPower = savings / Math.max(collegeCost, 1);

      const absurdIncome =
        income >= collegeCost * 4 &&
        costToIncomeRatio <= 2 &&
        debtRatioAfter <= 5;

      const absurdSavings =
        savings >= collegeCost * 25 &&
        cashUseRatio <= 5 &&
        savingsMonthsAfter >= 60;

      const ultraSafeIncome =
        incomeRecoveryPower <= 0.03 &&
        debtRatioAfter <= 8 &&
        estimatedLoanPayment <= income * 0.01;

      const ultraSafeSavings =
        savingsPower >= 10 &&
        savingsMonthsAfter >= 24 &&
        cashUseRatio <= 10;

      let pressureScore = 0;

      pressureScore += clamp(costToIncomeRatio * 0.9, 0, 34);
      pressureScore += clamp(cashUseRatio * 0.35, 0, 26);
      pressureScore += clamp(debtRatioAfter * 0.75, 0, 28);

      if (borrowed > 0) {
        pressureScore += clamp((borrowed / Math.max(collegeCost, 1)) * 18, 0, 18);
      }

      if (savingsMonthsAfter < 1) {
        pressureScore += 20;
      } else if (savingsMonthsAfter < 3) {
        pressureScore += 12;
      } else if (savingsMonthsAfter >= 6) {
        pressureScore -= 8;
      }

      if (estimatedLoanPayment > 0 && incomeGain <= 0) {
        pressureScore += 16;
      } else if (loanToIncomeGainRatio > 0.5) {
        pressureScore += 14;
      } else if (loanToIncomeGainRatio > 0.3) {
        pressureScore += 8;
      } else if (loanToIncomeGainRatio <= 0.15 && incomeGain > 0) {
        pressureScore -= 8;
      }

      if (programStrength === "strong") {
        pressureScore -= 8;
      } else if (programStrength === "weak") {
        pressureScore += 14;
      }

      if (
        costToIncomeRatio < 8 &&
        debtRatioAfter < 15 &&
        savingsMonthsAfter >= 6 &&
        payoffStrength !== "weak"
      ) {
        pressureScore = Math.min(pressureScore, 22);
      }

      if (
        costToIncomeRatio < 4 &&
        debtRatioAfter < 10 &&
        savingsMonthsAfter >= 12 &&
        payoffStrength === "strong"
      ) {
        pressureScore = Math.min(pressureScore, 10);
      }

      if (ultraSafeIncome && ultraSafeSavings) {
        pressureScore = 0;
      }

      if (absurdIncome || absurdSavings) {
        pressureScore = 0;
      }

      pressureScore = clamp(Math.round(pressureScore), 0, 100);

      const level = getPressureLevel(pressureScore);

      scoreText.textContent = `${level.label} — ${pressureScore}/100`;
      fillBar.style.width = `${pressureScore}%`;
      fillBar.className = `fill ${level.colorClass}`;

      let explanation = "";

      if (pressureScore === 0) {
        explanation =
          "This college cost creates virtually no measurable pressure based on the income, savings, borrowing, debt, and payoff numbers provided.";
      } else if (pressureScore <= 30) {
        explanation =
          "This college decision appears manageable based on the numbers provided. The main priority is preserving savings and confirming that the program has a practical payoff.";
      } else if (pressureScore <= 60) {
        explanation =
          "This college decision may work, but it deserves caution. Borrowing, savings drawdown, and uncertain income improvement could reduce flexibility faster than expected.";
      } else {
        explanation =
          "This college decision could create significant financial pressure. A lower-cost program, more aid, delayed enrollment, smaller loan, or stronger savings cushion would likely create more flexibility.";
      }

      resultDetails.innerHTML = `
        <p><strong>College cost impact:</strong> ${costToIncomeRatio.toFixed(1)}% of annual take-home income.</p>

        <p><strong>Estimated loan payment:</strong> About $${estimatedLoanPayment.toFixed(0)} per month based on the borrowing amount entered.</p>

        <p><strong>Debt impact after school borrowing:</strong> ${debtRatioAfter.toFixed(1)}% of monthly take-home income, including estimated student loan payment.</p>

        <p><strong>Savings after planned cash use:</strong> About ${savingsMonthsAfter.toFixed(1)} months of estimated flexibility.</p>

        <p><strong>Expected payoff strength:</strong> ${payoffStrength} based on estimated loan payment versus expected monthly income gain.</p>

        <p><strong>Pressure level:</strong> ${level.stress}.</p>

        <p>${explanation} Recommended next step: ${level.action}</p>
      `;

      guidance.textContent = "";
    }

    document
      .getElementById("collegeButton")
      .addEventListener("click", calculateCollegePressure);
  </script>
</Layout>