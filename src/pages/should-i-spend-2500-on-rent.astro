---
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
---

<Layout
  title="Should I Spend $2,500 on Rent?"
  description="Use this rent calculator to decide whether a $2,500 monthly rent payment fits your income, savings, debt, utilities, and monthly flexibility."
>
  <style>
    .container {
      max-width: 920px;
      margin: 0 auto;
      padding: 72px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 18px;
      text-align: center;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.95;
      margin-bottom: 24px;
      text-align: center;
      color: #0f172a;
    }

    .subtitle {
      text-align: center;
      font-size: 1.08rem;
      line-height: 1.8;
      color: #334155;
      max-width: 720px;
      margin: 0 auto 60px auto;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .content-section h2 {
      font-size: 2rem;
      line-height: 1.2;
      margin-bottom: 24px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
      margin-bottom: 24px;
    }

    .calculator {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 24px;
      padding: 36px;
      margin: 56px auto;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
    }

    .calculator h2 {
      margin-bottom: 28px;
      font-size: 1.7rem;
      color: #0f172a;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }

    label {
      display: block;
      margin-bottom: 10px;
      font-weight: 700;
      color: #0f172a;
      font-size: 0.95rem;
    }

    input {
      width: 100%;
      padding: 16px;
      border-radius: 14px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    button {
      margin-top: 28px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 28px;
      border-radius: 14px;
      font-size: 19px;
      font-weight: 900;
      cursor: pointer;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 28px;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 18px;
      padding: 28px;
      display: none;
    }

    .score {
      font-size: 2.5rem;
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 18px;
    }

    .bar {
      height: 14px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 18px;
    }

    .fill {
      height: 100%;
      width: 0%;
      background: #0f766e;
      transition: width 0.4s ease;
    }

    .result-details {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 18px;
    }

    .fine-print {
      font-size: 0.9rem;
      color: #64748b;
    }

    @media (max-width: 720px) {
      .container {
        padding: 54px 20px;
      }

      h1 {
        font-size: 2.8rem;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator {
        padding: 24px;
      }

      .score {
        font-size: 2rem;
      }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Rent Affordability Calculator</div>

    <h1>Should I Spend $2,500 on Rent?</h1>

    <p class="subtitle">
      Evaluate whether a $2,500 monthly rent payment fits comfortably within
      your take-home income, debt load, savings, utilities, and overall
      financial flexibility.
    </p>

    <section class="content-section">
      <h2>Is $2,500 Rent Affordable?</h2>

      <p>
        A $2,500 monthly rent payment can be workable for higher-income
        households, but it can also create serious pressure if it combines with
        car payments, credit card balances, student loans, childcare, or limited
        savings.
      </p>

      <p>
        The important question is not only whether you can pay $2,500 this month.
        It is whether the rent still leaves enough room for savings, debt payoff,
        utilities, transportation, groceries, and unexpected expenses throughout
        the lease.
      </p>
    </section>

    <div class="calculator">
      <h2>Rent Affordability Verdict</h2>

      <div class="grid">
        <div>
          <label for="income">Monthly Take-Home Income</label>
          <input id="income" type="number" placeholder="Example: 8500" />
        </div>

        <div>
          <label for="savings">Total Savings</label>
          <input id="savings" type="number" placeholder="Example: 30000" />
        </div>

        <div>
          <label for="rent">Monthly Rent</label>
          <input id="rent" type="number" value="2500" />
        </div>

        <div>
          <label for="debt">Monthly Debt Payments</label>
          <input id="debt" type="number" placeholder="Example: 900" />

          <div class="helper-link">
            Not sure what counts as debt?
            <a href="/what-counts-as-debt">Read the debt guide</a>
          </div>
        </div>
      </div>

      <button id="rentButton" type="button">Get Rent Verdict</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="fill" id="scoreFill"></div>
        </div>

        <div class="result-details" id="resultDetails"></div>

        <div class="fine-print">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>What a $2,500 Rent Payment Means</h2>

      <p>
        A $2,500 rent payment should be judged against your full financial
        picture, not just your ability to make the payment this month. The
        stronger your savings cushion and the lower your debt load, the easier
        this rent level becomes to absorb.
      </p>

      <p>
        If the payment pushes rent near or above 40% of take-home income, the
        decision may require stricter guardrails: fewer discretionary expenses,
        a larger emergency fund, or a shorter lease commitment.
      </p>
    </section>

    <WhenSpendingMakesSense
      title="When $2,500 Rent Can Make Sense"
      items={[
        "The payment leaves room for monthly savings after bills.",
        "Your emergency fund remains intact after deposits and move-in costs.",
        "Debt payments are low enough that rent does not crowd out other obligations.",
        "The location improves safety, commute, work stability, or family logistics.",
        "Utilities, parking, pet fees, renter’s insurance, and transportation have been included.",
      ]}
    />

    <section class="content-section">
      <h2>When You Should Look for Cheaper Rent</h2>

      <p>
        Cheaper rent may be smarter if $2,500 would leave little room for
        savings, increase credit card reliance, delay debt payoff, or make
        monthly bills feel tight.
      </p>

      <p>
        Rent is one of the hardest expenses to adjust quickly. A stretched rent
        decision can create pressure every month until the lease ends.
      </p>
    </section>

    <KeyCostCategories
      items={[
        {
          title: "Utilities and recurring fees",
          description:
            "Electric, gas, water, trash, internet, parking, pet rent, laundry, and renter’s insurance can make the true housing cost higher than $2,500.",
        },
        {
          title: "Debt payments",
          description:
            "Credit cards, student loans, car payments, and personal loans reduce how much room is left after rent.",
        },
        {
          title: "Move-in costs",
          description:
            "Security deposits, first month’s rent, application fees, movers, furniture, and utility setup can create a large upfront cash need.",
        },
        {
          title: "Transportation tradeoffs",
          description:
            "A $2,500 apartment may be easier to justify if it lowers commuting costs, parking costs, or the need for another vehicle.",
        },
      ]}
    />

    <ReduceCostTips
      items={[
        "Compare total housing cost, not just advertised rent.",
        "Ask about average utilities, parking, and recurring building fees.",
        "Avoid draining emergency savings on deposits and furniture.",
        "Look for included utilities, free parking, or lower commute costs.",
        "Consider a slightly cheaper unit if it protects monthly savings.",
      ]}
    />

    <FinancialRedFlags
      items={[
        "Rent would leave little or no room for monthly savings.",
        "You would need credit cards for normal expenses after rent.",
        "Move-in costs would wipe out most of your emergency fund.",
        "Debt payments already make your monthly budget tight.",
        "You are ignoring utilities, parking, insurance, pet fees, or commuting costs.",
      ]}
    />

    <CalculatorAssumptions
      items={[
        "The calculator uses monthly take-home income rather than gross income.",
        "The estimate assumes rent is the base monthly payment and does not include every utility or fee.",
        "Debt payments should include recurring monthly obligations such as credit cards, student loans, car payments, and personal loans.",
        "Savings are used as a cushion signal, especially when move-in costs or high rent reduce flexibility.",
        "Local housing costs, job stability, family obligations, and transportation needs can change the final decision.",
      ]}
    />

    <FAQSection
      title="$2,500 Rent FAQ"
      faqs={[
        {
          question: "Is $2,500 a month too much for rent?",
          answer:
            "$2,500 rent may be comfortable or risky depending on take-home income, savings, debt payments, utilities, transportation costs, and local cost of living.",
        },
        {
          question: "What income do I need for $2,500 rent?",
          answer:
            "Many renters would want enough take-home income that $2,500 rent still leaves room for bills, savings, debt payments, utilities, and emergencies. The safer range depends on your full budget, not income alone.",
        },
        {
          question: "Should utilities count when judging $2,500 rent?",
          answer:
            "Yes. Utilities, internet, parking, renter’s insurance, pet fees, and transportation costs all affect whether the apartment is truly affordable.",
        },
        {
          question: "Is $2,500 rent worth it for a better location?",
          answer:
            "Sometimes. Higher rent can make sense if it meaningfully reduces commute costs, improves safety, or supports work stability without damaging savings.",
        },
        {
          question: "What if $2,500 rent leaves no room for savings?",
          answer:
            "That is a warning sign. Rent that prevents saving money can make emergencies harder to absorb and may create financial stress throughout the lease.",
        },
      ]}
    />

    <MethodologySection category="rent affordability" updated="May 2026" />

    <RelatedGuides
      guides={[
        {
          title: "How Much Rent Can I Afford?",
          href: "/how-much-rent-can-i-afford",
          description:
            "Learn how rent-to-income rules, take-home pay, debt, utilities, and savings affect affordability.",
        },
        {
          title: "What Counts as Debt?",
          href: "/what-counts-as-debt",
          description:
            "See which monthly obligations should be included when evaluating rent affordability.",
        },
      ]}
    />

    <RelatedCalculators
      calculators={[
        {
          category: "Rent",
          title: "Should I Spend $2,000 on Rent?",
          href: "/should-i-spend-2000-on-rent",
        },
        {
          category: "Rent",
          title: "Should I Spend $3,000 on Rent?",
          href: "/should-i-spend-3000-on-rent",
        },
        {
          category: "Rent",
          title: "Should I Spend 40% of My Income on Rent?",
          href: "/should-i-spend-40-percent-income-on-rent",
        },
        {
          category: "Rent",
          title: "Should I Spend 50% of My Income on Rent?",
          href: "/should-i-spend-50-percent-income-on-rent",
        },
      ]}
    />
  </main>

  <script is:inline>
    function calculateRent() {
      const income = Number(document.getElementById("income").value);
      const savings = Number(document.getElementById("savings").value || 0);
      const rent = Number(document.getElementById("rent").value);
      const debt = Number(document.getElementById("debt").value || 0);

      const result = document.getElementById("result");
      const scoreText = document.getElementById("scoreText");
      const scoreFill = document.getElementById("scoreFill");
      const resultDetails = document.getElementById("resultDetails");

      result.style.display = "block";

      if (!income || !rent) {
        scoreText.textContent = "Add your numbers first";
        scoreFill.style.width = "0%";
        resultDetails.innerHTML =
          "<p>Enter your take-home income and monthly rent so the calculator can give a useful verdict.</p>";
        return;
      }

      let score = 100;

      const rentRatio = rent / income;
      const debtRatio = debt / income;
      const savingsMonths = savings > 0 ? savings / rent : 0;

      score -= rentRatio * 120;
      score -= debtRatio * 45;

      if (rentRatio > 0.35 && savings < rent * 3) {
        score -= 18;
      } else if (rentRatio > 0.25 && savings < rent * 6) {
        score -= 10;
      }

      score = Math.max(5, Math.min(100, Math.round(score)));

      let verdict = "";
      let color = "";

      if (score >= 80) {
        verdict = "Comfortable Rent";
        color = "#16a34a";
      } else if (score >= 60) {
        verdict = "Manageable With Guardrails";
        color = "#eab308";
      } else if (score >= 40) {
        verdict = "Financial Stretch";
        color = "#f97316";
      } else {
        verdict = "High Risk Housing Cost";
        color = "#dc2626";
      }

      const rentPercent = rentRatio * 100;
      const debtPercent = debtRatio * 100;

      scoreText.textContent = `${verdict} - ${score}/100`;
      scoreFill.style.width = `${score}%`;
      scoreFill.style.background = color;

      resultDetails.innerHTML = `
        <p><strong>Rent impact:</strong> ${rentPercent.toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Debt impact:</strong> ${debtPercent.toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Savings cushion:</strong> ${savingsMonths.toFixed(1)} months of rent covered.</p>
      `;
    }

    document
      .getElementById("rentButton")
      .addEventListener("click", calculateRent);
  </script>
</Layout>