---
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
import { calculators } from "../data/calculators.js";

const carFaqs = [
  {
    question: "Is a $700 car payment too much?",
    answer:
      "A $700 car payment can be manageable for some households, but it becomes risky when it crowds out emergency savings, retirement contributions, insurance, fuel, repairs, or other debt payments.",
  },
  {
    question: "How much of my income should go toward a car payment?",
    answer:
      "A common guideline is to keep the car payment comfortably below 10% to 15% of monthly take-home pay, especially when insurance, gas, maintenance, and registration are added on top.",
  },
  {
    question: "What should I consider besides the monthly payment?",
    answer:
      "The payment is only one part of the decision. You should also consider loan length, interest rate, down payment, insurance cost, maintenance, depreciation, and whether the payment still leaves room for savings.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "Cars" &&
      calculator.href !== "/should-i-spend-700-on-a-car-payment"
  )
  .slice(0, 4);
---

<Layout
  title="Should I Spend $700 on a Car Payment?"
  description="Evaluate whether a $700 car payment fits your income, savings, debt load, total vehicle costs, and financial flexibility."
>
  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: #475569;
    }

    .helper-link a,
    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .helper-link a:hover,
    .content-link:hover {
      text-decoration: underline;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .score {
      font-size: clamp(2rem, 4vw, 2.7rem);
      font-weight: 900;
      color: #0f172a;
      margin-bottom: 22px;
      line-height: 1.15;
    }

    .bar {
      width: 100%;
      height: 16px;
      background: #dbe4ee;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .fill {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      transition: width 0.45s ease;
    }

    .fill.safe {
      background: linear-gradient(90deg, #0f766e 0%, #14b8a6 100%);
    }

    .fill.caution {
      background: linear-gradient(90deg, #ca8a04 0%, #facc15 100%);
    }

    .fill.danger {
      background: linear-gradient(90deg, #dc2626 0%, #f97316 100%);
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .guidance {
      margin-top: 22px;
      padding-top: 20px;
      border-top: 1px solid #dbe4ee;
      font-size: 1.12rem;
      line-height: 1.85;
      color: #1e293b;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section p {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
    }

    .pillar-card {
      display: block;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 24px;
      margin-top: 28px;
      text-decoration: none;
      transition: transform 0.15s ease;
    }

    .pillar-card:hover {
      transform: translateY(-2px);
    }

    .pillar-card strong {
      display: block;
      margin-bottom: 10px;
      color: #0f172a;
      font-size: 1.08rem;
    }

    .pillar-card span {
      color: #334155;
      line-height: 1.7;
      font-size: 0.98rem;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Car Payment Calculator"
      title="Should I Spend $700 on a Car Payment?"
      description="Evaluate whether your monthly car payment is financially manageable based on income, savings, debt load, and overall comfort level."
    >
      <div class="calculator">
        <h2>Car Payment Affordability Verdict</h2>

        <p class="calculator-intro">
          Enter your income, savings, car payment, and current debt payments.
          This calculator estimates whether the payment looks comfortable,
          heavy, or financially risky.
        </p>

        <div class="grid">
          <div class="field">
            <label for="income">Monthly Take-Home Income</label>
            <input id="income" type="number" placeholder="Example: 6000" />
          </div>

          <div class="field">
            <label for="savings">Current Savings</label>
            <input id="savings" type="number" placeholder="Example: 15000" />
          </div>

          <div class="field">
            <label for="payment">Monthly Car Payment</label>
            <input id="payment" type="number" placeholder="Example: 700" />
          </div>

          <div class="field">
            <label for="debt">Current Monthly Debt Payments</label>
            <input id="debt" type="number" placeholder="Example: 900" />

            <div class="helper-link">
              Not sure what counts as debt?
              <a href="/what-counts-as-debt">Read the debt guide</a>
            </div>
          </div>
        </div>

        <button id="carButton" type="button">Get Car Payment Verdict</button>

        <div class="results" id="results">
          <div class="score" id="scoreText"></div>

          <div class="bar">
            <div class="fill" id="fillBar"></div>
          </div>

          <div class="result-details" id="resultDetails"></div>

          <div class="guidance" id="guidance"></div>

          <div class="disclaimer">
            This is a general educational estimate, not financial advice.
          </div>
        </div>
      </div>

      <section class="content-section">
        <h2>Start With the Full Car Affordability Guide</h2>

        <p>
          A $700 monthly payment only tells part of the story. Insurance, fuel,
          maintenance, loan structure, depreciation, and existing debt all
          affect whether the vehicle actually fits your financial life.
        </p>

        <a class="pillar-card" href="/how-much-car-can-i-afford">
          <strong>How Much Car Can I Afford?</strong>
          <span>
            Learn how to calculate a realistic vehicle budget using take-home
            income, savings, insurance costs, debt pressure, loan length, and
            total ownership cost.
          </span>
        </a>
      </section>

      <section class="content-section">
        <h2>What a $700 Car Payment Really Costs</h2>

        <p>
          A $700 car payment is rarely just $700. Once insurance, fuel,
          maintenance, registration, tires, repairs, and possible parking costs
          are included, the true monthly ownership cost can be much higher.
        </p>

        <p>
          For many households, a $700 payment can turn into a total vehicle cost
          closer to $950–$1,300 per month. That is why this calculator looks at
          income, savings, existing debt, and budget flexibility instead of only
          asking whether the payment technically fits.
        </p>
      </section>

      <WhenSpendingMakesSense
        title="When a $700 Car Payment Can Make Sense"
        items={[
          "You have strong emergency savings after the purchase.",
          "Your retirement contributions remain on track.",
          "Your total monthly debt load stays manageable.",
          "You have stable income and reliable cash flow.",
          "The vehicle supports a real lifestyle or work need.",
        ]}
      />

      <section class="content-section">
        <h2>When You Should Wait</h2>

        <p>
          A $700 car payment may be too aggressive if you are carrying
          high-interest debt, rebuilding savings, relying on overtime income, or
          stretching your monthly budget to make the deal work.
        </p>

        <p>
          Financing pressure often becomes more noticeable several months after
          the excitement of the purchase fades — especially once insurance
          renewals, repairs, and unexpected expenses appear.
        </p>

        <p>
          If the payment would leave little flexibility after housing, groceries,
          utilities, and debt obligations, a less expensive vehicle may create
          significantly less long-term financial stress.
        </p>
      </section>

      <section class="content-section">
        <h2>Key Costs to Consider</h2>

        <p>
          Before taking on a $700 car payment, estimate the full cost of owning
          the vehicle. Insurance, fuel, maintenance, registration, interest, and
          depreciation can change the real affordability picture quickly.
        </p>

        <p>
          A payment that looks manageable by itself may become uncomfortable
          once the total cost of transportation is measured against your monthly
          take-home income.
        </p>

        <p>
          You can also review the broader
          <a class="content-link" href="/how-much-car-can-i-afford">
            car affordability guide
          </a>
          for deeper budgeting guidance before committing to a vehicle purchase.
        </p>
      </section>

      <section class="content-section">
        <h2>Financial Red Flags</h2>

        <p>
          Be careful if the payment would slow your emergency savings, increase
          credit card reliance, delay debt payoff, or leave you with little room
          for normal surprise expenses.
        </p>

        <p>
          A weaker verdict does not always mean you cannot buy the car. It means
          the payment may create pressure that reduces your flexibility in other
          parts of your financial life.
        </p>
      </section>

      <section class="content-section">
        <h2>What Your Car Payment Verdict Actually Means</h2>

        <p>
          A car payment verdict is not just about whether the monthly bill
          technically fits. It is about whether the payment leaves enough room
          for insurance, repairs, savings, emergencies, and normal life.
        </p>

        <p>
          A stronger verdict means the payment is less likely to create ongoing
          financial pressure. A weaker verdict means the car may still be
          possible, but the tradeoff could reduce flexibility in other areas of
          your budget.
        </p>
      </section>

      <div class="content-section">
        <FAQSection faqs={carFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <MethodologySection category="car payment budgeting" />
  </div>

  <script is:inline>
    function calculateCarPayment() {
      const income = Number(document.getElementById("income").value);
      const savings = Number(document.getElementById("savings").value);
      const payment = Number(document.getElementById("payment").value);
      const debt = Number(document.getElementById("debt").value);

      const results = document.getElementById("results");
      const scoreText = document.getElementById("scoreText");
      const fillBar = document.getElementById("fillBar");
      const resultDetails = document.getElementById("resultDetails");
      const guidance = document.getElementById("guidance");

      results.classList.add("visible");

      if (!income || !savings || !payment) {
        scoreText.textContent = "Add the Core Numbers First";
        fillBar.style.width = "0%";
        fillBar.className = "fill";
        resultDetails.innerHTML =
          "<p>Enter monthly take-home income, current savings, and monthly car payment to review affordability.</p>";
        guidance.textContent = "";
        return;
      }

      const paymentImpact = payment / income;
      const debtRatio = (payment + debt) / income;
      const savingsMonths = savings / Math.max(income * 0.7, 1);
      const sixMonthPaymentImpact = (payment * 6) / savings;

      let score = 100;

      if (paymentImpact > 0.18) score -= 35;
      else if (paymentImpact > 0.15) score -= 25;
      else if (paymentImpact > 0.12) score -= 15;
      else if (paymentImpact > 0.1) score -= 8;

      if (debtRatio > 0.45) score -= 30;
      else if (debtRatio > 0.35) score -= 22;
      else if (debtRatio > 0.25) score -= 14;
      else if (debtRatio > 0.18) score -= 7;

      if (savingsMonths < 1) score -= 20;
      else if (savingsMonths < 3) score -= 12;
      else if (savingsMonths < 6) score -= 5;

      if (sixMonthPaymentImpact > 0.75) score -= 18;
      else if (sixMonthPaymentImpact > 0.5) score -= 10;
      else if (sixMonthPaymentImpact > 0.3) score -= 5;

      score = Math.max(0, Math.min(100, Math.round(score)));

      let verdict = "Comfortable Payment";
      let stress = "Low pressure";
      let explanation =
        "This payment appears manageable relative to your income, savings, and current debt load.";

      if (score < 50) {
        verdict = "High Car Payment Pressure";
        stress = "High pressure";
        explanation =
          "This car payment looks aggressive relative to your income, savings, and debt load. A lower payment could preserve more monthly flexibility.";
      } else if (score < 75) {
        verdict = "Manageable With Guardrails";
        stress = "Moderate pressure";
        explanation =
          "This payment may be workable, but it deserves caution. Review insurance, fuel, repairs, savings goals, and other monthly obligations before committing.";
      }

      scoreText.textContent = `${verdict} - ${score}/100`;

      fillBar.style.width = `${Math.max(score, 6)}%`;
      fillBar.className = "fill";

      if (score >= 75) {
        fillBar.classList.add("safe");
      } else if (score >= 50) {
        fillBar.classList.add("caution");
      } else {
        fillBar.classList.add("danger");
      }

      resultDetails.innerHTML = `
        <p><strong>Payment impact:</strong> ${(paymentImpact * 100).toFixed(1)}% of monthly take-home income.</p>
        <p><strong>Total debt impact:</strong> ${(debtRatio * 100).toFixed(1)}% of monthly take-home income, including this car payment.</p>
        <p><strong>Emergency savings cushion:</strong> About ${savingsMonths.toFixed(1)} months of estimated core expenses.</p>
        <p><strong>Six-month payment impact:</strong> ${(sixMonthPaymentImpact * 100).toFixed(1)}% of current savings.</p>
        <p><strong>Stress level:</strong> ${stress}.</p>
      `;

      guidance.textContent = explanation;
    }

    document
      .getElementById("carButton")
      .addEventListener("click", calculateCarPayment);
  </script>
</Layout>