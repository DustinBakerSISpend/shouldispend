---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";

const liveFuneralCalculators = [
  {
    category: "Funeral Costs",
    title: "Funeral Price Calculator",
    description:
      "Estimate a realistic funeral cost range based on burial, cremation, viewing, casket, cemetery, reception, flowers, obituary, transportation, and memorial choices.",
    href: "/funeral-price-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Cremation Cost Calculator",
    description:
      "Estimate direct cremation, memorial service, urn, keepsake, obituary, travel, and reception costs.",
    href: "/cremation-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Burial Cost Calculator",
    description:
      "Estimate burial costs including casket, plot, vault, headstone, opening and closing fees, transportation, and service costs.",
    href: "/burial-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Cemetery Plot and Headstone Cost Calculator",
    description:
      "Estimate cemetery-only costs including the plot, grave opening and closing, vault, headstone, engraving, installation, care fees, admin fees, and confirmed credits.",
    href: "/cemetery-plot-and-headstone-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Casket Cost Calculator",
    description:
      "Estimate casket, rental casket, cremation container, delivery, sales tax, handling, upgrades, third-party savings, and out-of-pocket casket cost.",
    href: "/casket-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Funeral Reception Cost Calculator",
    description:
      "Estimate funeral reception costs including guests, food, venue, drinks, service fees, tips, rentals, decor, cleanup, transportation, and per-guest cost.",
    href: "/funeral-reception-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Obituary Cost Calculator",
    description:
      "Estimate obituary costs using newspaper base fees, word count, line count, photo fees, number of papers, print days, online memorials, programs, and confirmed credits.",
    href: "/obituary-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Funeral Travel Cost Calculator",
    description:
      "Estimate funeral travel costs including flights, mileage, hotels, meals, rental cars, parking, childcare, pet care, missed work, and last-minute fare pressure.",
    href: "/funeral-travel-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Funeral Cost Split Calculator",
    description:
      "Estimate per-person funeral shares, confirmed contributions, promised help, unpaid gaps, single-payer exposure, estate reimbursement, family caps, and credits.",
    href: "/funeral-cost-split-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Funeral vs. Cremation Cost Calculator",
    description:
      "Compare burial, cremation, direct cremation, memorial services, cemetery costs, family preferences, and total funeral spending pressure.",
    href: "/funeral-vs-cremation-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "$5,000 Funeral Calculator",
    description:
      "Evaluate whether a $5,000 funeral or memorial fits savings, insurance help, family contributions, debt risk, and emergency cushion.",
    href: "/should-i-spend-5000-on-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "$10,000 Funeral Calculator",
    description:
      "Pressure-test a $10,000 funeral against savings, insurance help, family contributions, debt risk, and emergency reserves.",
    href: "/should-i-spend-10000-on-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "$15,000 Funeral Calculator",
    description:
      "Evaluate whether a $15,000 funeral creates manageable family support or risky pressure from savings loss, debt, insurance gaps, and burial costs.",
    href: "/should-i-spend-15000-on-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "$20,000 Funeral Calculator",
    description:
      "Analyze whether a $20,000 funeral is financially safe based on insurance proceeds, family help, burial costs, savings, debt, and long-term pressure.",
    href: "/should-i-spend-20000-on-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "Can I Afford a Funeral?",
    description:
      "Compare funeral quotes against savings, insurance proceeds, family help, debt, income, and household obligations before committing.",
    href: "/can-i-afford-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "Funeral Payment Plan Calculator",
    description:
      "Estimate monthly payments, interest, payoff timeline, and financing pressure before putting funeral costs on a payment plan.",
    href: "/funeral-payment-plan-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Funeral Insurance Calculator",
    description:
      "Compare premiums, expected benefits, age, health, savings alternatives, and whether funeral insurance is better than saving directly.",
    href: "/funeral-insurance-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Should I Use Savings for Funeral Costs?",
    description:
      "Decide whether using savings protects the family or creates risk by draining emergency reserves, rent money, or monthly flexibility.",
    href: "/should-i-use-savings-for-funeral-costs/",
  },
];

const funeralCostFactors = [
  {
    title: "Funeral home services",
    text:
      "Planning, coordination, permits, paperwork, staff time, facility use, transportation coordination, and overhead can create a large fixed base before ceremony choices are added.",
  },
  {
    title: "Viewing or memorial",
    text:
      "Facility use, staff, visitation, livestreaming, clergy, musicians, programs, flowers, photos, and memorial setup can make two similar funerals cost very different amounts.",
  },
  {
    title: "Burial costs",
    text:
      "Burial may include a casket, cemetery plot, grave opening and closing, vault, marker, headstone, transportation, and cemetery administration fees.",
  },
  {
    title: "Cremation costs",
    text:
      "Direct cremation may be lower-cost, but cremation with a formal service, upgraded urn, keepsakes, obituary, and reception can still become expensive.",
  },
  {
    title: "Family logistics",
    text:
      "Travel, lodging, meals, missed work, childcare, reception costs, and gathering expenses can add pressure outside the funeral home invoice.",
  },
  {
    title: "Financing and timing",
    text:
      "A funeral paid from insurance proceeds is different from one paid by credit card while waiting for reimbursement. Timing can create pressure even when money is expected later.",
  },
];

const reduceCostTips = [
  {
    title: "Ask for itemized pricing",
    text:
      "Get the actual line items before choosing a package. A clear quote makes it easier to separate required costs from optional upgrades.",
  },
  {
    title: "Compare service types",
    text:
      "Burial, cremation, direct cremation, and memorial-only plans can create very different costs while still giving family a meaningful way to gather.",
  },
  {
    title: "Keep products simple",
    text:
      "A simpler casket, urn, container, or printed program can lower the bill without changing the love behind the service.",
  },
  {
    title: "Use family help clearly",
    text:
      "Specific contributions are safer than vague promises. Let family members cover defined costs directly when possible.",
  },
  {
    title: "Delay optional memorial items",
    text:
      "Headstone upgrades, larger receptions, keepsakes, and bigger gatherings can often wait until cash is available.",
  },
  {
    title: "Avoid high-interest debt",
    text:
      "Credit cards and expensive loans can turn one hard week into months or years of pressure for the person who signed the contract.",
  },
];

const redFlags = [
  "The full funeral cost would go on a high-interest credit card.",
  "One person is expected to pay while others pressure them emotionally.",
  "The plan would drain emergency savings below a safe level.",
  "The funeral home quote is not itemized or feels unclear.",
  "The family is choosing upgrades mainly out of guilt.",
  "The monthly payment plan would crowd out rent, food, medical bills, or debt payoff.",
  "No one has compared burial, cremation, direct cremation, or memorial-only options.",
  "The cost depends on money that has not arrived yet, such as delayed insurance proceeds.",
  "The person signing the contract is assuming other people will reimburse them later.",
  "The funeral budget ignores travel, reception, obituary, cemetery, or family logistics costs.",
];

const assumptions = [
  "Funeral affordability depends on the household or person actually paying the bill, not the deceased person's income.",
  "Monthly income means take-home pay available to the payer, not gross income.",
  "Insurance help means realistic money expected for this funeral, not vague hope that the estate will eventually reimburse someone.",
  "Savings should mean liquid cash that can be used without missing essential bills or selling long-term assets.",
  "Debt pressure includes credit cards, loans, car payments, student loans, medical payment plans, and other required monthly debt obligations.",
  "Lower-cost funeral options can still be meaningful when they reflect the person's wishes and protect surviving family members.",
  "The calculators are educational pressure tests, not legal, estate, tax, insurance, or funeral-director advice.",
];

const paymentOptions = [
  {
    title: "Life insurance",
    text:
      "Insurance proceeds can make a funeral easier to manage, but timing matters. Confirm beneficiary access, payout timing, and whether money is available before payment is due.",
  },
  {
    title: "Available savings",
    text:
      "Savings can be appropriate when the funeral does not wipe out rent money, grocery money, medical reserves, transportation funds, or the household emergency cushion.",
  },
  {
    title: "Family contributions",
    text:
      "Shared costs can reduce pressure on one person, but contributions should be specific, realistic, and preferably paid directly toward an invoice or defined expense.",
  },
  {
    title: "Prepaid arrangements",
    text:
      "Prepaid plans may reduce uncertainty, but families should review what is covered, what is excluded, whether prices are guaranteed, and whether the provider is reputable.",
  },
  {
    title: "Payment plans",
    text:
      "Payment plans should be reviewed like debt: monthly payment, interest rate, fees, term length, late-payment consequences, and whether the payment fits the household budget.",
  },
  {
    title: "Credit cards or loans",
    text:
      "High-interest borrowing is one of the biggest warning signs, especially when simpler services, direct contributions, or delayed optional memorial items are available.",
  },
];

const planningLinks = [
  {
    href: "/how-to-pay-for-funeral-expenses-without-debt/",
    title: "How to Pay for Funeral Expenses Without Debt",
    text:
      "Review practical ways to lower costs, divide expenses, use insurance, avoid high-interest borrowing, and still plan a respectful service.",
  },
  {
    href: "/should-i-spend-10000-on-a-funeral/",
    title: "$10,000 Funeral Calculator",
    text:
      "Pressure-test one of the most common funeral budget questions against savings, insurance, income, family help, and debt.",
  },
  {
    href: "/should-i-use-savings-for-funeral-costs/",
    title: "Should I Use Savings for Funeral Costs?",
    text:
      "Decide whether using savings is safer than borrowing, financing, or waiting for reimbursement.",
  },
  {
    href: "/funeral-vs-cremation-cost-calculator/",
    title: "Funeral vs. Cremation Cost Calculator",
    text:
      "Compare burial, cremation, direct cremation, and memorial options before choosing a plan.",
  },
  {
    href: "/how-much-emergency-savings-should-i-have/",
    title: "Emergency Savings Guide",
    text:
      "See how much cash cushion to preserve before using savings for a funeral, burial, cremation, or memorial.",
  },
  {
    href: "/how-much-debt-is-too-much/",
    title: "Debt Pressure Calculator",
    text:
      "Measure whether funeral borrowing would create too much monthly pressure or push the household into risky territory.",
  },
];

const funeralFaqs = [
  {
    question: "How much should you spend on a funeral?",
    answer:
      "The right funeral budget depends on available savings, insurance proceeds, family contributions, burial or cremation preferences, emergency reserves, and whether the cost creates debt. A respectful service should not require long-term financial damage.",
  },
  {
    question: "Is $10,000 too much for a funeral?",
    answer:
      "A $10,000 funeral may be manageable if insurance, savings, or family support cover most of the cost. It becomes risky when the bill requires high-interest debt, drains emergency savings, or leaves one household carrying the burden alone.",
  },
  {
    question: "Is cremation cheaper than burial?",
    answer:
      "Direct cremation is often cheaper than burial, but cremation with a formal service, reception, obituary, flowers, urn, and other memorial expenses can still become costly. The real comparison depends on the full plan, not just the disposition method.",
  },
  {
    question: "Should I use savings to pay for a funeral?",
    answer:
      "Using savings may be reasonable if it does not endanger rent, groceries, transportation, medical costs, debt payments, or emergency reserves. It is riskier when funeral spending leaves the household financially exposed afterward.",
  },
  {
    question: "Should I borrow money for funeral expenses?",
    answer:
      "Borrowing should be a last resort, especially through credit cards or high-interest loans. Before taking on debt, compare lower-cost funeral options, family contributions, insurance timing, itemized pricing, and direct cremation or memorial alternatives.",
  },
  {
    question: "Which funeral calculator should I use first?",
    answer:
      "Start with the funeral price calculator if you do not know the total cost yet. Use the funeral vs. cremation calculator if you are choosing between service types. Use the $5,000, $10,000, $15,000, or $20,000 funeral calculators if you already have a target budget.",
  },
];
---

<Layout
  title="Funeral Cost Calculators | ShouldISpend"
  description="Browse funeral cost calculators for burial, cremation, funeral affordability, savings, insurance, debt risk, payment plans, and lower-cost memorial decisions."
>
  <style>
    .hub-page {
      width: 92%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 72px 0 20px;
    }

    .hero {
      max-width: 960px;
      margin-bottom: 52px;
    }

    .eyebrow {
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1.8px;
      font-size: 0.78rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    h1 {
      max-width: 980px;
      font-size: clamp(2.75rem, 6.5vw, 5rem);
      line-height: 0.98;
      margin: 0 0 24px;
      color: var(--text);
      letter-spacing: -0.055em;
    }

    h2 {
      font-size: clamp(1.85rem, 3.8vw, 2.7rem);
      margin: 0 0 18px;
      line-height: 1.08;
      color: var(--text);
      letter-spacing: -0.035em;
    }

    h3 {
      color: var(--text);
      line-height: 1.28;
      margin: 0 0 10px;
      font-size: 1.15rem;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.82;
      font-size: 1.04rem;
    }

    .intro {
      max-width: 900px;
      color: var(--muted);
      font-size: 1.12rem;
      line-height: 1.85;
      margin: 0 0 18px;
    }

    .trust-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 34px 0 64px;
    }

    .trust-item,
    .link-card,
    .info-card,
    .panel,
    .soft-box,
    .callout {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
    }

    .trust-item {
      box-shadow: var(--shadow-soft);
    }

    .trust-item strong,
    .link-card strong,
    .info-card h3,
    .panel h3 {
      display: block;
      color: var(--text);
      margin-bottom: 10px;
      font-size: 1.05rem;
    }

    .trust-item span,
    .link-card span,
    .info-card p,
    .panel p {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .grid,
    .link-grid,
    .info-grid,
    .two-col-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      margin-top: 28px;
    }

    .link-grid,
    .info-grid {
      grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
      margin-top: 28px;
    }

    .two-col-grid {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: start;
      margin-top: 28px;
    }

    .content-section {
      margin-top: 76px;
    }

    .content-section.narrow {
      max-width: 900px;
    }

    .content-section p {
      margin-bottom: 18px;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: var(--shadow-soft);
    }

    .soft-box,
    .callout {
      border-radius: 24px;
      padding: 30px;
      box-shadow: var(--shadow-soft);
    }

    .dark-callout {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
      color: #ffffff;
    }

    .dark-callout h2 {
      color: #ffffff;
    }

    .dark-callout p {
      color: #e7eadf;
    }

    .red-flag-list,
    .check-list {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .red-flag-list li,
    .check-list li {
      margin: 0;
      padding: 15px 16px;
      border-radius: 16px;
      line-height: 1.55;
      font-size: 0.96rem;
    }

    .red-flag-list li {
      border: 1px solid #fecaca;
      background: #fff7f7;
      color: #7f1d1d;
    }

    .check-list li {
      border: 1px solid #cfeee1;
      background: #f1fbf6;
      color: #173404;
    }

    @media (max-width: 768px) {
      .hub-page {
        padding: 54px 0 12px;
      }

      h1 {
        font-size: 2.55rem;
        line-height: 1.03;
      }

      .intro {
        font-size: 1.04rem;
      }

      .trust-strip,
      .two-col-grid {
        grid-template-columns: 1fr;
        margin-bottom: 50px;
      }

      .grid,
      .link-grid,
      .info-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .content-section {
        margin-top: 58px;
      }

      .soft-box,
      .callout {
        padding: 24px;
      }
    }
  </style>

  <main class="hub-page">
    <section class="hero">
      <div class="eyebrow">Funeral Cost Calculators</div>

      <h1>Funeral costs are urgent, emotional, and easy to overspend on.</h1>

      <p class="intro">
        Funeral spending often happens fast, under grief, family pressure, and unclear
        pricing. These calculators help compare funeral costs, cremation options,
        burial expenses, insurance help, savings use, debt risk, payment plans, and
        lower-cost memorial choices without treating the decision like an ordinary purchase.
      </p>
    </section>

    <div class="trust-strip">
      <div class="trust-item">
        <strong>Respectful, not salesy</strong>
        <span>The goal is to honor someone without letting guilt turn into long-term financial harm.</span>
      </div>

      <div class="trust-item">
        <strong>Debt-aware decisions</strong>
        <span>Tools flag credit card risk, payment-plan pressure, and emergency savings damage.</span>
      </div>

      <div class="trust-item">
        <strong>Burial and cremation context</strong>
        <span>Compare the full cost picture instead of focusing only on the funeral home quote.</span>
      </div>
    </div>

    <section class="content-section">
      <div class="eyebrow">Start here</div>

      <h2>Funeral, cremation, burial, insurance, and payment calculators</h2>

      <p>
        Start with a funeral price estimate, then compare cremation, burial,
        insurance, savings, payment plans, and specific funeral budgets. These
        tools help families pressure-test the full cost before committing under
        grief, urgency, or family pressure.
      </p>

      <div class="grid">
        {liveFuneralCalculators.map((calculator) => (
          <CalculatorCard
            category={calculator.category}
            title={calculator.title}
            description={calculator.description}
            href={calculator.href}
          />
        ))}
      </div>
    </section>

    <section class="content-section narrow">
      <div class="eyebrow">Budget philosophy</div>

      <h2>How much should you spend on a funeral?</h2>

      <p>
        There is no single correct funeral budget. A reasonable amount depends on
        the person's wishes, available insurance, family contributions, savings,
        local prices, burial or cremation preferences, and whether the plan creates
        debt for the people left behind.
      </p>

      <p>
        A funeral that is manageable for one household may be damaging for another.
        The safest funeral budget usually avoids high-interest debt, preserves an
        emergency cushion, uses itemized pricing, and gives family members a clear
        way to share costs when appropriate.
      </p>

      <p>
        The healthiest question is not what is the most we can do. It is what honors
        the person while protecting the people who still have to pay rent, buy food,
        handle medical bills, and keep going after the service ends.
      </p>
    </section>

    <section class="content-section">
      <div class="eyebrow">Cost factors</div>

      <h2>What funeral costs can include</h2>

      <div class="info-grid">
        {funeralCostFactors.map((factor) => (
          <div class="info-card">
            <h3>{factor.title}</h3>
            <p>{factor.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="eyebrow">Payment options</div>

      <h2>Ways families usually pay for funeral costs</h2>

      <p>
        The source of the money matters. A funeral covered by insurance creates a
        different kind of pressure than one paid with a credit card while relatives
        promise to reimburse later.
      </p>

      <div class="info-grid">
        {paymentOptions.map((option) => (
          <div class="info-card">
            <h3>{option.title}</h3>
            <p>{option.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="eyebrow">Lower the pressure</div>

      <h2>Ways to reduce funeral cost without making it feel careless</h2>

      <div class="info-grid">
        {reduceCostTips.map((tip) => (
          <div class="info-card">
            <h3>{tip.title}</h3>
            <p>{tip.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="eyebrow">Warning signs</div>

      <h2>Funeral spending red flags</h2>

      <p>
        These signs do not mean a family is doing anything wrong. They do mean the
        person paying should slow down, ask for clearer numbers, and protect the
        household from long-term damage.
      </p>

      <ul class="red-flag-list">
        {redFlags.map((flag) => <li>{flag}</li>)}
      </ul>
    </section>

    <section class="content-section">
      <div class="eyebrow">Related guides</div>

      <h2>Helpful funeral planning and money pages</h2>

      <div class="link-grid">
        {planningLinks.map((link) => (
          <a class="link-card" href={link.href}>
            <strong>{link.title}</strong>
            <span>{link.text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="eyebrow">Assumptions</div>

      <h2>How these calculators think about funeral costs</h2>

      <p>
        These assumptions help keep the funeral calculator cluster consistent.
      </p>

      <ul class="check-list">
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </section>

    <section class="callout dark-callout">
      <div class="eyebrow">Use these as pressure tests</div>

      <h2>A respectful funeral should not wreck the person left paying for it.</h2>

      <p>
        ShouldISpend funeral calculators are educational tools. Use them to compare
        options, understand tradeoffs, and spot debt pressure before signing a
        funeral contract. For legal, estate, insurance, tax, or funeral-director
        questions, talk with a qualified professional.
      </p>
    </section>

    <FAQSection title="Funeral Cost Calculator FAQ" faqs={funeralFaqs} />
  </main>
</Layout>
