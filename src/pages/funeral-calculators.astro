---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";

const liveFuneralCalculators = [
  {
    category: "Funeral Costs",
    title: "Funeral Price Calculator",
    description:
      "Estimate a realistic funeral cost range based on burial, cremation, viewing, casket, cemetery, reception, flowers, obituary, transportation, and memorial choices.",
    href: "/funeral-price-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Cremation Cost Calculator",
    description:
      "Estimate direct cremation, memorial service, urn, keepsake, obituary, travel, and reception costs.",
    href: "/cremation-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Burial Cost Calculator",
    description:
      "Estimate burial costs including casket, plot, vault, headstone, opening and closing fees, transportation, and service costs.",
    href: "/burial-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Funeral vs. Cremation Cost Calculator",
    description:
      "Compare burial, cremation, direct cremation, memorial services, cemetery costs, family preferences, and total funeral spending pressure.",
    href: "/funeral-vs-cremation-cost-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "$5,000 Funeral Calculator",
    description:
      "Evaluate whether a $5,000 funeral or memorial fits savings, insurance help, family contributions, debt risk, and emergency cushion.",
    href: "/should-i-spend-5000-on-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "$10,000 Funeral Calculator",
    description:
      "Pressure-test a $10,000 funeral against savings, insurance help, family contributions, debt risk, and emergency reserves.",
    href: "/should-i-spend-10000-on-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "$15,000 Funeral Calculator",
    description:
      "Evaluate whether a $15,000 funeral creates manageable family support or risky pressure from savings loss, debt, insurance gaps, and burial costs.",
    href: "/should-i-spend-15000-on-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "$20,000 Funeral Calculator",
    description:
      "Analyze whether a $20,000 funeral is financially safe based on insurance proceeds, family help, burial costs, savings, debt, and long-term pressure.",
    href: "/should-i-spend-20000-on-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "Can I Afford a Funeral?",
    description:
      "Compare funeral quotes against savings, insurance proceeds, family help, debt, income, and household obligations before committing.",
    href: "/can-i-afford-a-funeral/",
  },
  {
    category: "Funeral Costs",
    title: "Funeral Payment Plan Calculator",
    description:
      "Estimate monthly payments, interest, payoff timeline, and financing pressure before putting funeral costs on a payment plan.",
    href: "/funeral-payment-plan-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Funeral Insurance Calculator",
    description:
      "Compare premiums, expected benefits, age, health, savings alternatives, and whether funeral insurance is better than saving directly.",
    href: "/funeral-insurance-calculator/",
  },
  {
    category: "Funeral Costs",
    title: "Should I Use Savings for Funeral Costs?",
    description:
      "Decide whether using savings protects the family or creates risk by draining emergency reserves, rent money, or monthly flexibility.",
    href: "/should-i-use-savings-for-funeral-costs/",
  },
];

const funeralCostFactors = [
  {
    title: "Funeral home basic services",
    text:
      "Planning, coordination, permits, paperwork, staff time, facility use, transportation coordination, and overhead can create a large fixed base before any ceremony choices are added.",
  },
  {
    title: "Viewing, ceremony, or memorial",
    text:
      "Facility use, staff, visitation, livestreaming, clergy, musicians, programs, flowers, photos, and memorial setup can make two similar funerals cost very different amounts.",
  },
  {
    title: "Burial costs",
    text:
      "Burial may include a casket, cemetery plot, grave opening and closing, vault, marker, headstone, transportation, and cemetery administration fees.",
  },
  {
    title: "Cremation costs",
    text:
      "Direct cremation may be lower-cost, but cremation with a formal service, upgraded urn, keepsakes, obituary, and reception can still become expensive.",
  },
  {
    title: "Family logistics",
    text:
      "Travel, lodging, meals, missed work, childcare, reception costs, and gathering expenses can add pressure outside the funeral home invoice.",
  },
  {
    title: "Financing and timing",
    text:
      "A funeral paid from insurance proceeds is different from one paid by credit card while waiting for reimbursement. Timing can create pressure even when money is expected later.",
  },
];

const reduceCostTips = [
  "Ask for itemized pricing before choosing a package.",
  "Separate required costs from optional upgrades.",
  "Compare burial, cremation, direct cremation, and memorial-only options.",
  "Use a simpler casket, urn, or container if the upgrade does not matter to the family.",
  "Hold a reception at home, a church, a community room, or a relative’s house.",
  "Let family members pay specific costs directly instead of making vague promises.",
  "Delay optional memorial items, headstone upgrades, or larger gatherings until cash is available.",
  "Avoid high-interest credit cards unless repayment is already realistic.",
  "Use photos, music, stories, food, and people to create meaning instead of relying on expensive products.",
];

const redFlags = [
  "The full funeral cost would go on a high-interest credit card.",
  "One person is expected to pay while others pressure them emotionally.",
  "The plan would drain emergency savings below a safe level.",
  "The funeral home quote is not itemized or feels unclear.",
  "The family is choosing upgrades mainly out of guilt.",
  "The monthly payment plan would crowd out rent, food, medical bills, or debt payoff.",
  "No one has compared burial, cremation, direct cremation, or memorial-only options.",
  "The cost depends on money that has not arrived yet, such as delayed insurance proceeds.",
  "The person signing the contract is assuming other people will reimburse them later.",
  "The funeral budget ignores travel, reception, obituary, cemetery, or family logistics costs.",
];

const assumptions = [
  "Funeral affordability depends on the household or person actually paying the bill, not the deceased person’s income.",
  "Monthly income means take-home pay available to the payer, not gross income.",
  "Insurance help means realistic money expected for this funeral, not vague hope that the estate will eventually reimburse someone.",
  "Savings should mean liquid cash that can be used without missing essential bills or selling long-term assets.",
  "Debt pressure includes credit cards, loans, car payments, student loans, medical payment plans, and other required monthly debt obligations.",
  "Lower-cost funeral options can still be meaningful when they reflect the person’s wishes and protect surviving family members.",
  "The calculators are educational pressure tests, not legal, estate, tax, insurance, or funeral-director advice.",
];

const paymentOptions = [
  {
    title: "Life insurance",
    text:
      "Insurance proceeds can make a funeral easier to manage, but timing matters. Families should confirm beneficiary access, expected payout timing, and whether money is available before payment is due.",
  },
  {
    title: "Available savings",
    text:
      "Savings can be appropriate when the funeral does not wipe out rent money, grocery money, medical reserves, transportation funds, or the household emergency cushion.",
  },
  {
    title: "Family contributions",
    text:
      "Shared costs can reduce pressure on one person, but contributions should be specific, realistic, and preferably paid directly toward the invoice or a defined expense.",
  },
  {
    title: "Prepaid arrangements",
    text:
      "Prepaid plans may reduce uncertainty, but families should review what is covered, what is excluded, whether prices are guaranteed, and whether the provider is reputable.",
  },
  {
    title: "Payment plans",
    text:
      "Payment plans should be reviewed like debt: monthly payment, interest rate, fees, term length, late-payment consequences, and whether the payment fits the household budget.",
  },
  {
    title: "Credit cards or loans",
    text:
      "High-interest borrowing is one of the biggest warning signs, especially when simpler services, cremation, direct contributions, or delayed optional memorial items are available.",
  },
];

const planningLinks = [
  {
    href: "/how-to-pay-for-funeral-expenses-without-debt/",
    title: "How to Pay for Funeral Expenses Without Debt",
    text:
      "Review practical ways to lower costs, divide expenses, use insurance, avoid high-interest borrowing, and still plan a respectful service.",
  },
  {
    href: "/should-i-spend-10000-on-a-funeral/",
    title: "$10,000 Funeral Calculator",
    text:
      "Pressure-test one of the most common funeral budget questions against savings, insurance, income, family help, and debt.",
  },
  {
    href: "/should-i-use-savings-for-funeral-costs/",
    title: "Should I Use Savings for Funeral Costs?",
    text:
      "Decide whether using savings is safer than borrowing, financing, or waiting for reimbursement.",
  },
  {
    href: "/funeral-vs-cremation-cost-calculator/",
    title: "Funeral vs. Cremation Cost Calculator",
    text:
      "Compare burial, cremation, direct cremation, and memorial options before choosing a plan.",
  },
  {
    href: "/how-much-emergency-savings-should-i-have/",
    title: "Emergency Savings Guide",
    text:
      "See how much cash cushion to preserve before using savings for a funeral, burial, cremation, or memorial.",
  },
  {
    href: "/how-much-debt-is-too-much/",
    title: "Debt Pressure Calculator",
    text:
      "Measure whether funeral borrowing would create too much monthly pressure or push the household into risky territory.",
  },
];

const funeralFaqs = [
  {
    question: "How much should you spend on a funeral?",
    answer:
      "The right funeral budget depends on available savings, insurance proceeds, family contributions, burial or cremation preferences, emergency reserves, and whether the cost creates debt. A respectful service should not require long-term financial damage.",
  },
  {
    question: "Is $10,000 too much for a funeral?",
    answer:
      "A $10,000 funeral may be manageable if insurance, savings, or family support cover most of the cost. It becomes risky when the bill requires high-interest debt, drains emergency savings, or leaves one household carrying the burden alone.",
  },
  {
    question: "Is cremation cheaper than burial?",
    answer:
      "Direct cremation is often cheaper than burial, but cremation with a formal service, reception, obituary, flowers, urn, and other memorial expenses can still become costly. The real comparison depends on the full plan, not just the disposition method.",
  },
  {
    question: "Should I use savings to pay for a funeral?",
    answer:
      "Using savings may be reasonable if it does not endanger rent, groceries, transportation, medical costs, debt payments, or emergency reserves. It is riskier when funeral spending leaves the household financially exposed afterward.",
  },
  {
    question: "Should I borrow money for funeral expenses?",
    answer:
      "Borrowing should be a last resort, especially through credit cards or high-interest loans. Before taking on debt, compare lower-cost funeral options, family contributions, insurance timing, itemized pricing, and direct cremation or memorial alternatives.",
  },
  {
    question: "Which funeral calculator should I use first?",
    answer:
      "Start with the funeral price calculator if you do not know the total cost yet. Use the funeral vs. cremation calculator if you are choosing between service types. Use the $5,000, $10,000, $15,000, or $20,000 funeral calculators if you already have a target budget.",
  },
];
---

<Layout
  title="Funeral Cost Calculators | ShouldISpend"
  description="Browse funeral cost calculators for burial, cremation, funeral affordability, savings, insurance, debt risk, payment plans, and lower-cost memorial decisions."
>
  <style>
    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 76px 24px 90px;
    }

    .hero {
      max-width: 960px;
      margin-bottom: 42px;
    }

    .eyebrow,
    .section-kicker {
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.78rem;
      font-weight: 900;
      margin-bottom: 16px;
    }

    .section-kicker {
      letter-spacing: 0.12em;
      font-size: 0.76rem;
      margin-bottom: 12px;
    }

    h1 {
      font-size: clamp(2.8rem, 7vw, 5rem);
      line-height: 0.98;
      margin: 0 0 24px;
      color: var(--text);
      letter-spacing: -0.05em;
      max-width: 980px;
    }

    h2 {
      font-size: clamp(1.85rem, 4vw, 2.45rem);
      margin: 0 0 18px;
      line-height: 1.15;
      color: var(--text);
      letter-spacing: -0.035em;
    }

    h3 {
      color: var(--text);
      line-height: 1.25;
      margin: 0 0 10px;
    }

    p,
    li {
      color: var(--muted);
      line-height: 1.82;
      font-size: 1.04rem;
    }

    .intro {
      max-width: 890px;
      color: var(--muted);
      font-size: 1.13rem;
      line-height: 1.85;
      margin: 0;
    }

    .trust-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 36px 0 64px;
    }

    .trust-item,
    .link-card,
    .info-card,
    .panel,
    .soft-box,
    .decision-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      text-decoration: none;
      color: inherit;
    }

    .trust-item {
      background: #f8fafc;
      padding: 18px 20px;
    }

    .trust-item strong,
    .link-card strong,
    .info-card h3,
    .panel h3,
    .decision-card strong {
      display: block;
      color: var(--text);
      margin-bottom: 10px;
      font-size: 1.05rem;
    }

    .trust-item span,
    .link-card span,
    .info-card p,
    .panel p,
    .decision-card span {
      color: var(--muted);
      line-height: 1.7;
      font-size: 0.96rem;
      margin: 0;
    }

    .trust-item span {
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .grid,
    .link-grid,
    .info-grid,
    .two-col-grid,
    .decision-grid {
      display: grid;
      gap: 24px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      margin-top: 28px;
    }

    .link-grid,
    .info-grid,
    .decision-grid {
      grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
      margin-top: 28px;
    }

    .two-col-grid {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: start;
      margin-top: 28px;
    }

    .content-section {
      margin-top: 76px;
    }

    .content-section.narrow {
      max-width: 900px;
    }

    .content-section p {
      margin-bottom: 18px;
    }

    .link-card {
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-3px);
      border-color: rgba(15, 118, 110, 0.35);
      box-shadow: 0 16px 35px rgba(15, 23, 42, 0.08);
    }

    .soft-box {
      background: #f8fafc;
      border-radius: 24px;
      padding: 28px;
    }

    .soft-box h3 {
      margin: 0 0 12px;
      color: var(--text);
      font-size: 1.25rem;
      letter-spacing: -0.02em;
    }

    .soft-box p {
      margin-bottom: 0;
    }

    .callout {
      margin-top: 72px;
      padding: 30px;
      border-radius: 24px;
      border: 1px solid rgba(15, 118, 110, 0.22);
      background: #f0fdfa;
      max-width: 940px;
    }

    .callout h2 {
      margin: 0 0 14px;
      color: var(--text);
      font-size: 1.55rem;
      letter-spacing: -0.02em;
    }

    .callout p {
      color: var(--muted);
      line-height: 1.78;
      margin: 0;
    }

    .red-flag-list,
    .check-list {
      margin: 22px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .red-flag-list li,
    .check-list li {
      margin: 0;
      padding: 15px 16px;
      border-radius: 16px;
      line-height: 1.55;
      font-size: 0.96rem;
    }

    .red-flag-list li {
      border: 1px solid #fecaca;
      background: #fff7f7;
      color: #7f1d1d;
    }

    .check-list li {
      border: 1px solid #ccfbf1;
      background: #f0fdfa;
      color: #134e4a;
    }

    .table-wrap {
      overflow-x: auto;
      margin-top: 26px;
      border: 1px solid var(--border);
      border-radius: 22px;
      background: #fff;
    }

    table {
      width: 100%;
      min-width: 760px;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 16px;
      border-bottom: 1px solid #e2e8f0;
      vertical-align: top;
      color: var(--muted);
      line-height: 1.55;
    }

    th {
      color: var(--text);
      background: #f8fafc;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    tr:last-child td {
      border-bottom: none;
    }

    @media (max-width: 768px) {
      .container {
        padding: 54px 18px 76px;
      }

      h1 {
        font-size: 2.75rem;
      }

      .intro {
        font-size: 1.04rem;
      }

      .trust-strip,
      .two-col-grid {
        grid-template-columns: 1fr;
        margin-bottom: 50px;
      }

      .grid,
      .link-grid,
      .info-grid,
      .decision-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .content-section {
        margin-top: 58px;
      }
    }
  </style>

  <main class="container">
    <section class="hero">
      <div class="eyebrow">Funeral Cost Calculators</div>

      <h1>Funeral Cost Calculators for Difficult Money Decisions</h1>

      <p class="intro">
        Funeral spending often happens fast, under grief, family pressure, and
        unclear pricing. These calculators help compare funeral costs, cremation
        options, burial expenses, insurance help, savings use, debt risk,
        payment plans, and lower-cost memorial choices without treating the
        decision like an ordinary purchase.
      </p>
    </section>

    <div class="trust-strip">
      <div class="trust-item">
        <strong>Respectful, not salesy</strong>
        <span>
          The goal is to honor someone without letting guilt turn into long-term financial harm.
        </span>
      </div>

      <div class="trust-item">
        <strong>Debt-aware decisions</strong>
        <span>
          Tools flag credit card risk, payment-plan pressure, and emergency savings damage.
        </span>
      </div>

      <div class="trust-item">
        <strong>Burial and cremation context</strong>
        <span>
          Compare the full cost picture instead of focusing only on the funeral home quote.
        </span>
      </div>
    </div>

    <section class="content-section">
      <div class="section-kicker">Start Here</div>

      <h2>Funeral Cost, Cremation, Burial, Insurance, and Payment Calculators</h2>

      <p>
        Start with a funeral price estimate, then compare cremation, burial,
        insurance, savings, payment plans, and specific funeral budgets. These
        tools help families pressure-test the full cost before committing under
        grief, urgency, or family pressure.
      </p>

      <div class="grid">
        {liveFuneralCalculators.map((calculator) => (
          <CalculatorCard
            category={calculator.category}
            title={calculator.title}
            description={calculator.description}
            href={calculator.href}
          />
        ))}
      </div>
    </section>

    <section class="content-section narrow">
      <div class="section-kicker">Budget Philosophy</div>

      <h2>How much should you spend on a funeral?</h2>

      <p>
        There is no single correct funeral budget. A reasonable amount depends
        on the person’s wishes, available insurance, family contributions,
        savings, local prices, burial or cremation preferences, and whether the
        plan creates debt for the people left behind.
      </p>

      <p>
        A funeral that is financially manageable for one household may be
        damaging for another. The safest funeral budget usually avoids
        high-interest debt, preserves an emergency cushion, uses itemized
        pricing, and gives family members a clear way to share costs when
        appropriate.
      </p>

      <p>
        The healthiest question is not “What is the most we can do?” It is “How
        can we honor this person without creating a second crisis for the
        family?”
      </p>
    </section>

    <section class="content-section" id="MethodologySection">
      <div class="section-kicker">Methodology</div>

      <h2>How ShouldISpend evaluates funeral affordability</h2>

      <p>
        SIS funeral calculators focus on financial pressure rather than judging
        the emotional value of a service. The framework looks at the total
        funeral cost, out-of-pocket cost after help, available savings,
        insurance or prepaid funds, family contributions, emergency reserves,
        monthly take-home income, existing debt payments, financing risk, and
        whether lower-cost options could still meet the family’s needs.
      </p>

      <div class="decision-grid">
        <div class="decision-card">
          <strong>Out-of-pocket cost</strong>
          <span>
            The key number is what the family must actually pay after insurance,
            prepaid arrangements, estate cash, and confirmed contributions.
          </span>
        </div>

        <div class="decision-card">
          <strong>Emergency savings impact</strong>
          <span>
            A funeral is riskier when it drains the cash needed for housing,
            groceries, utilities, transportation, medical needs, or a surviving household.
          </span>
        </div>

        <div class="decision-card">
          <strong>Debt and payment pressure</strong>
          <span>
            Payment plans, credit cards, and personal loans are weighed against
            take-home income and existing debt obligations.
          </span>
        </div>

        <div class="decision-card">
          <strong>Lower-cost alternatives</strong>
          <span>
            The framework considers whether direct cremation, a smaller memorial,
            simpler products, or delayed optional expenses could reduce pressure.
          </span>
        </div>
      </div>

      <p>
        A lower-pressure funeral plan usually has clear pricing, realistic
        funding, limited borrowing, preserved emergency savings, and shared
        family expectations. A higher-pressure plan often depends on
        high-interest debt, unclear quotes, rushed upgrades, or one household
        absorbing a cost it cannot carry.
      </p>
    </section>

    <section class="content-section" id="KeyCostCategories">
      <div class="section-kicker">Cost Breakdown</div>

      <h2>Funeral expenses that can change the final bill</h2>

      <p>
        Funeral quotes can be difficult to compare because some costs are
        required, some are optional, and some appear later in the process.
        Families should ask for itemized pricing before committing to a plan.
      </p>

      <div class="info-grid">
        {funeralCostFactors.map((item) => (
          <div class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-kicker">Comparison</div>

      <h2>Burial, cremation, and memorial choices create different pressure</h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Choice</th>
              <th>Why families choose it</th>
              <th>Common pressure point</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Traditional burial</td>
              <td>Formal service, cemetery burial, familiar family or religious structure.</td>
              <td>Casket, cemetery plot, vault, opening and closing, marker, and facility fees can stack quickly.</td>
            </tr>
            <tr>
              <td>Cremation with memorial</td>
              <td>Lower-cost disposition with a flexible gathering, service, or celebration later.</td>
              <td>Costs can rise when the family adds a formal service, reception, urn upgrades, flowers, travel, and keepsakes.</td>
            </tr>
            <tr>
              <td>Direct cremation</td>
              <td>Simple, lower-cost option that lets the family plan a separate goodbye.</td>
              <td>Some families later add memorial costs, travel, food, or keepsakes that should still be budgeted.</td>
            </tr>
            <tr>
              <td>Memorial-only gathering</td>
              <td>Personal event at home, church, park, community room, or restaurant.</td>
              <td>Usually flexible, but food, venue, travel, and printed materials can still add up.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <div class="section-kicker">Payment Options</div>

      <h2>How families commonly pay for funeral expenses</h2>

      <p>
        The same funeral price can produce a different verdict depending on who
        is paying, when money is available, and whether the plan creates debt.
        A $10,000 funeral covered by insurance is very different from a $10,000
        funeral placed on one person’s credit card.
      </p>

      <div class="info-grid">
        {paymentOptions.map((item) => (
          <div class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="content-section" id="ReduceCostTips">
      <div class="section-kicker">Reduce Cost Tips</div>

      <h2>Ways to lower funeral costs without making the goodbye feel cheap</h2>

      <p>
