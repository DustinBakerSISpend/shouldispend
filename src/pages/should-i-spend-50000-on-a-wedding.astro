---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import MethodologySection from "../components/MethodologySection.astro";
import FinancialRedFlags from "../components/FinancialRedFlags.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import WhenSpendingMakesSense from "../components/WhenSpendingMakesSense.astro";
---

<Layout
  title="Should I Spend $50,000 on a Wedding?"
  description="Use this wedding calculator to decide whether a $50,000 wedding fits your income, savings, debt, emergency cushion, and long-term goals."
>
  <style>
    .container {
      max-width: 920px;
      margin: 0 auto;
      padding: 72px 24px;
    }

    .eyebrow {
      text-align: center;
      color: var(--teal);
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      text-align: center;
      margin: 0 0 16px;
      color: var(--navy);
      line-height: 1.05;
    }

    .subtitle {
      text-align: center;
      font-size: 22px;
      color: var(--muted);
      margin: 0 auto 56px;
      line-height: 1.5;
      max-width: 760px;
    }

    .content-section {
      max-width: 760px;
      margin: 72px auto 0;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 24px;
      line-height: 1.2;
    }

    .content-section p,
    .content-section li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
      margin-bottom: 24px;
    }

    .calculator {
      background: var(--card);
      border-radius: 24px;
      padding: 38px;
      box-shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
      border: 1px solid rgba(15, 23, 42, 0.05);
      margin-top: 56px;
    }

    .calculator h2 {
      margin-top: 0;
      color: var(--navy);
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    label {
      display: block;
      font-weight: 800;
      margin-bottom: 9px;
      color: var(--navy);
    }

    input {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid var(--border);
      font-size: 18px;
      box-sizing: border-box;
    }

    input:focus {
      outline: 3px solid rgba(15, 118, 110, 0.18);
      border-color: var(--teal);
    }

    button {
      margin-top: 28px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 28px;
      border-radius: 14px;
      font-size: 19px;
      font-weight: 900;
      cursor: pointer;
      display: inline-block;
    }

    button:hover {
      opacity: 0.92;
    }

    .result {
      margin-top: 34px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 30px;
      display: none;
    }

    .score {
      font-size: 36px;
      font-weight: 900;
      margin-bottom: 18px;
      color: var(--navy);
    }

    .bar {
      height: 16px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 24px;
    }

    .bar-fill {
      height: 100%;
      background: var(--teal);
      width: 0%;
      transition: width 0.4s ease;
    }

    .line {
      margin-bottom: 12px;
      font-size: 18px;
      color: var(--text);
    }

    .guidance {
      margin-top: 26px;
      font-size: 20px;
      line-height: 1.6;
      color: var(--navy);
    }

    .verdict-breakdown {
      margin-top: 18px;
      padding: 18px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 14px;
      font-size: 0.98rem;
      line-height: 1.65;
      color: var(--muted);
      display: none;
    }

    .verdict-breakdown strong {
      color: var(--text);
    }

    .disclaimer {
      margin-top: 22px;
      font-size: 13px;
      color: #64748b;
    }

    .helper-link {
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .helper-link a {
      color: #0f766e;
      font-weight: 700;
    }

    @media (max-width: 700px) {
      .container {
        padding: 54px 20px;
      }

      h1 {
        font-size: 38px;
      }

      .subtitle {
        font-size: 18px;
      }

      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Wedding Spending Calculator</div>

    <h1>Should I Spend $50,000 on a Wedding?</h1>

    <p class="subtitle">
      Get a practical verdict based on income, savings, debt, stress level, and
      how much of your financial cushion the wedding would consume.
    </p>

    <div class="calculator">
      <h2>Wedding Affordability Verdict</h2>

      <div class="grid">
        <div>
          <label for="income">Combined Annual Income</label>
          <input id="income" type="number" placeholder="Example: 220000" />
        </div>

        <div>
          <label for="savings">Total Savings</label>
          <input id="savings" type="number" placeholder="Example: 120000" />
        </div>

        <div>
          <label for="cost">Wedding Cost</label>
          <input id="cost" type="number" value="50000" />
        </div>

        <div>
          <label for="debt">Current Debt</label>
          <input id="debt" type="number" placeholder="Example: 25000" />

          <div class="helper-link">
            <a href="/what-counts-as-debt/">
              Not sure what counts as debt? Read the debt guide
            </a>
          </div>
        </div>
      </div>

      <button class="sis-action-button sis-calculate-button" id="weddingButton" type="button">Get Wedding Verdict</button>

      <div class="result" id="result">
        <div class="score" id="scoreText"></div>

        <div class="bar">
          <div class="bar-fill" id="barFill"></div>
        </div>

        <div class="line" id="stress"></div>
        <div class="line" id="savingsImpact"></div>
        <div class="line" id="incomeImpact"></div>
        <div class="line" id="debtRatio"></div>

        <div class="guidance" id="guidance"></div>

        <div class="verdict-breakdown" id="verdictBreakdown"></div>

        <div class="disclaimer">
          This is a general educational estimate, not financial advice.
        </div>
      </div>
    </div>

    <section class="content-section">
      <h2>What a $50,000 Wedding Really Costs</h2>

      <p>
        A $50,000 wedding is a major financial event. It may include a premium
        venue, larger guest list, full-service catering, photography, video,
        entertainment, floral design, transportation, attire, rentals, and a
        more complex event timeline.
      </p>

      <p>
        At this level, the risk is not just the headline number. The risk is
        what the wedding does to emergency savings, debt payoff, housing plans,
        retirement contributions, and the couple's financial flexibility after
        the celebration.
      </p>

      <p>
        A high-end wedding can be reasonable for a household with strong income,
        substantial savings, low debt, and a clear cash plan. It becomes much
        riskier when the budget depends on credit cards, personal loans, or
        depleted savings.
      </p>
    </section>

    <OmniStyleReviewBlock
      pageName="the $50,000 wedding calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: July 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="a $50,000 wedding budget, savings, family help, guest count, monthly income, debt, emergency cushion, and whether the wedding creates avoidable financial pressure"
    />

    <CorePageExamplesBlock
      title="$50,000 wedding examples"
      intro="A $50,000 wedding can be manageable or stressful depending on how much is saved, how much help is reliable, and whether the remaining cost creates debt or drains emergency savings."
      useCases={[
          "You are planning around a $50,000 wedding budget.",
          "You want to compare savings, family help, guest count, and debt risk.",
          "You need to decide whether to keep the budget, scale down, delay, or change priorities."
        ]}
      notEnough={[
          "You need contract, venue, tax, legal, or family mediation advice.",
          "The wedding budget is still incomplete or major vendors are unknown.",
          "Someone is promising help that is not reliable or confirmed."
        ]}
      examples={[
          {
            label: "Most of the wedding is already saved",
            takeaway: "Pressure is lower when the wedding is paid from existing savings and the emergency fund remains intact."
          },
          {
            label: "Family help covers a large share",
            takeaway: "Reliable help can reduce pressure, but only if it is clear, confirmed, and does not create repayment stress."
          },
          {
            label: "The budget requires credit cards",
            takeaway: "Pressure rises quickly when the wedding depends on high-interest debt or leaves no emergency cushion afterward."
          }
        ]}
      commonMistake="Treating the headline wedding budget as affordable without checking savings left after deposits and final payments."
      nextStep="Separate confirmed help, current savings, and any amount that would become debt."
    />



    <WhenSpendingMakesSense
      title="When a $50,000 Wedding Can Make Sense"
      items={[
        "The wedding can be paid mostly or entirely in cash.",
        "Emergency savings remain strong after the celebration.",
        "The couple has low debt relative to income.",
        "Housing, retirement, and family goals remain on track.",
        "Both partners agree the experience is worth the tradeoff.",
      ]}
    />

    <section class="content-section">
      <h2>When You Should Scale Back</h2>

      <p>
        Scaling back may be smarter if the wedding would require high-interest
        debt, drain most savings, delay a home purchase, slow debt payoff, or
        create financial tension before the marriage begins.
      </p>

      <p>
        A lower-cost wedding can still feel beautiful and meaningful. Trimming
        guest count, venue complexity, bar package, floral design, rentals, or
        premium vendor upgrades can protect the core experience while reducing
        long-term pressure.
      </p>
    </section>

    <KeyCostCategories
      items={[
        {
          title: "Venue, catering, and bar",
          description:
            "A larger guest list, premium venue, full dinner service, open bar, staffing, taxes, and gratuities can dominate the budget.",
        },
        {
          title: "Photo, video, and entertainment",
          description:
            "Photography, videography, live music, DJ services, ceremony audio, and reception production can add major cost.",
        },
        {
          title: "Design, florals, and rentals",
          description:
            "Flowers, lighting, furniture, linens, signage, decor, tents, and upgraded rentals can turn a wedding into a much larger event.",
        },
        {
          title: "Travel, lodging, and weekend events",
          description:
            "Welcome parties, rehearsal dinners, hotel blocks, transportation, brunches, and guest logistics can expand the full wedding weekend cost.",
        },
      ]}
    />

    <ReduceCostTips
      items={[
        "Reduce guest count before cutting the most meaningful parts of the day.",
        "Choose one premium category instead of upgrading every vendor.",
        "Limit wedding-weekend events if they are pushing the budget higher.",
        "Set a firm cap for flowers, rentals, signage, and decor.",
        "Keep a separate buffer for taxes, tips, overtime, and final invoices.",
      ]}
    />

    <FinancialRedFlags
      items={[
        "The wedding requires credit cards, personal loans, or borrowed money.",
        "The budget would consume most emergency savings.",
        "The cost would delay housing, debt payoff, or retirement goals.",
        "The final plan depends on uncertain gifts or family contributions.",
        "The couple feels pressured to spend more than they actually want.",
      ]}
    />

    <CalculatorAssumptions
      items={[
        "The calculator assumes the wedding cost includes the major event expenses, not only the venue deposit.",
        "The estimate uses annual household income, total savings, current debt, and the planned wedding budget.",
        "The calculator treats high savings impact and high debt pressure as larger risk factors.",
        "The tool is educational and does not replace personalized financial advice.",
        "Actual wedding affordability can change based on local prices, family contributions, timing, and payment method.",
      ]}
    />

    <section class="content-section">
      <h2>What Your Wedding Verdict Actually Means</h2>

      <p>
        A wedding affordability score is not a judgment about whether the
        celebration is emotionally meaningful. The verdict estimates how much
        financial pressure the expense may create relative to your current
        income, savings cushion, and debt load.
      </p>

      <p>
        A strong score means the wedding appears easier to absorb. A weaker
        score means the budget may still be possible, but the tradeoffs deserve
        serious caution.
      </p>
    </section>

    <FAQSection
      title="$50,000 Wedding FAQ"
      faqs={[
        {
          question: "Is $50,000 too much to spend on a wedding?",
          answer:
            "It depends on income, savings, debt, and whether the wedding creates financial stress afterward. A $50,000 wedding may be manageable for some households and risky for others.",
        },
        {
          question: "Should you finance a $50,000 wedding?",
          answer:
            "Financing a $50,000 wedding can create long-term pressure after the celebration is over. If the cost requires high-interest debt or depleted emergency savings, the budget may be too aggressive.",
        },
        {
          question: "What should be included in a $50,000 wedding budget?",
          answer:
            "Include venue, catering, bar, photography, video, music, flowers, rentals, decor, attire, transportation, hotel or weekend events, taxes, tips, and a final buffer.",
        },
        {
          question: "Can a $50,000 wedding be financially responsible?",
          answer:
            "Yes, if it is planned in advance, paid mostly in cash, and does not damage emergency savings, debt payoff, housing plans, or long-term goals.",
        },
        {
          question: "How can I reduce a $50,000 wedding budget?",
          answer:
            "Start with guest count, venue, catering, bar, florals, rentals, and extra wedding-weekend events. Those categories usually create the biggest savings opportunities.",
        },
      ]}
    />

    <MethodologySection category="wedding spending" updated="July 2026" />

    <RelatedGuides
      guides={[
        {
          title: "How to Budget for a Wedding Without Going Into Debt",
          href: "/how-to-budget-for-a-wedding-without-going-into-debt",
          description:
            "Plan wedding spending without letting the celebration create long-term financial pressure.",
        },
        {
          title: "What Counts as Debt?",
          href: "/what-counts-as-debt",
          description:
            "See which debt obligations matter when evaluating a major wedding budget.",
        },
      ]}
    />

    <RelatedCalculators
      calculators={[
        {
          category: "Weddings",
          title: "Should I Spend $15,000 on a Wedding?",
          href: "/should-i-spend-15000-on-a-wedding",
        },
        {
          category: "Weddings",
          title: "Should I Spend $30,000 on a Wedding?",
          href: "/should-i-spend-30000-on-a-wedding",
        },
        {
          category: "Travel",
          title: "Should I Spend $15,000 on a Honeymoon?",
          href: "/should-i-spend-15000-on-a-honeymoon",
        },
        {
          category: "Cars",
          title: "Should I Spend $1,000 on a Car Payment?",
          href: "/should-i-spend-1000-on-a-car-payment",
        },
      ]}
    />
  </main>

  <script is:inline>
    function calculateWedding() {
      const income = Number(document.getElementById("income").value);
      const savings = Number(document.getElementById("savings").value);
      const cost = Number(document.getElementById("cost").value);
      const debt = Number(document.getElementById("debt").value || 0);

      if (!income || !savings || !cost) {
        alert("Please enter income, savings, and wedding cost.");
        return;
      }

      const savingsImpact = (cost / savings) * 100;
      const incomeImpact = (cost / income) * 100;
      const debtRatio = (debt / income) * 100;
      const breakdown = document.getElementById("verdictBreakdown");

      let score = 100;

      if (savingsImpact > 10) score -= 12;
      if (savingsImpact > 25) score -= 18;
      if (savingsImpact > 50) score -= 25;
      if (incomeImpact > 15) score -= 10;
      if (incomeImpact > 25) score -= 15;
      if (debtRatio > 10) score -= 8;
      if (debtRatio > 25) score -= 12;

      score = Math.max(0, Math.min(100, score));

      let verdict = "";
      let guidance = "";
      let stress = "";
      let barColor = "";

      if (score >= 85) {
        verdict = "Smart Wedding Budget";
        stress = "Low stress";
        barColor = "#0f766e";
        guidance =
          "This wedding appears financially manageable. It still deserves a budget, but the cost does not seriously threaten your cushion.";
      } else if (score >= 70) {
        verdict = "Manageable with Guardrails";
        stress = "Manageable stress";
        barColor = "#d97706";
        guidance =
          "This can work if you avoid financing it, keep extra costs under control, and preserve enough savings after the wedding.";
      } else if (score >= 50) {
        verdict = "Proceed Carefully";
        stress = "Noticeable stress";
        barColor = "#dc2626";
        guidance =
          "This wedding would take a meaningful bite out of your financial cushion. Consider trimming the guest list, venue cost, or extras.";
      } else {
        verdict = "High Financial Risk";
        stress = "High stress";
        barColor = "#dc2626";
        guidance =
          "This wedding cost looks too aggressive for the current financial picture. A smaller budget would likely protect your future flexibility.";
      }

      document.getElementById("result").style.display = "block";
      document.getElementById("scoreText").textContent =
        `${verdict} - ${score}/100`;

      document.getElementById("barFill").style.width = `${score}%`;
      document.getElementById("barFill").style.background = barColor;

      document.getElementById("stress").innerHTML =
        `<strong>Stress level:</strong> ${stress}`;

      document.getElementById("savingsImpact").innerHTML =
        `<strong>Savings impact:</strong> ${savingsImpact.toFixed(1)}% of savings`;

      document.getElementById("incomeImpact").innerHTML =
        `<strong>Income impact:</strong> ${incomeImpact.toFixed(1)}% of annual income`;

      document.getElementById("debtRatio").innerHTML =
        `<strong>Debt ratio:</strong> ${debtRatio.toFixed(1)}% of annual income`;

      document.getElementById("guidance").textContent = guidance;

      breakdown.style.display = "block";

      breakdown.innerHTML = `
        <strong>Financial Breakdown:</strong><br><br>
        - Wedding cost equals <strong>${incomeImpact.toFixed(1)}%</strong> of annual household income.<br>
        - Wedding cost consumes <strong>${savingsImpact.toFixed(1)}%</strong> of total savings.<br>
        - Existing debt load equals <strong>${debtRatio.toFixed(1)}%</strong> of annual income.<br><br>
        Higher savings impact and debt pressure usually increase long-term financial stress after large purchases.
      `;
    }

    document
      .getElementById("weddingButton")
      .addEventListener("click", calculateWedding);
  </script>
</Layout>
