---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import FAQSection from "../components/FAQSection.astro";
import { calculators } from "../data/calculators.js";

const rentCalculators = calculators.filter(
  (calculator) => calculator.category === "Rent"
);

const rentFaqs = [
  {
    question: "Is rent based on gross income or take-home income?",
    answer:
      "Take-home income usually gives a clearer picture because it reflects the money actually available after taxes, benefits, and payroll deductions.",
  },
  {
    question: "Is 40% of income on rent too much?",
    answer:
      "It can be aggressive. A 40% rent ratio is easier to handle with low debt, strong savings, stable income, and lower transportation costs.",
  },
  {
    question: "Is 50% of income on rent too much?",
    answer:
      "Spending half of take-home income on rent is usually risky because it leaves less room for savings, debt payoff, emergencies, utilities, groceries, and normal life.",
  },
  {
    question: "Should debt payments affect rent decisions?",
    answer:
      "Yes. Debt payments reduce the money left after rent, which can make an affordable-looking rent payment feel much tighter.",
  },
  {
    question: "Should utilities count when judging rent affordability?",
    answer:
      "Yes. Utilities, internet, parking, renter’s insurance, pet fees, and transportation costs all affect the real monthly housing burden.",
  },
];
---

<Layout
  title="Rent Affordability Calculators | Housing Budget and Rent Rules"
  description="Browse rent affordability calculators for $2,000 rent, $2,500 rent, $3,000 rent, 40% rent, 50% rent, and housing budget decisions."
>
  <style>
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 72px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.95;
      margin-bottom: 28px;
      max-width: 860px;
      color: #0f172a;
    }

    .intro {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
      max-width: 800px;
      margin-bottom: 56px;
    }

    .section {
      margin-top: 70px;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 20px;
      line-height: 1.2;
      color: #0f172a;
    }

    .section-description {
      max-width: 800px;
      color: #334155;
      line-height: 1.8;
      margin-bottom: 28px;
    }

    .grid,
    .popular-grid,
    .info-grid,
    .link-grid {
      display: grid;
      gap: 22px;
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .popular-grid,
    .info-grid,
    .link-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }

    .popular-card,
    .info-card,
    .link-card {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 26px;
    }

    .popular-label {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .popular-card h2,
    .info-card h3,
    .link-card strong {
      color: #0f172a;
      line-height: 1.2;
      margin-top: 0;
    }

    .popular-card h2 {
      font-size: 1.35rem;
      margin-bottom: 14px;
    }

    .popular-card p,
    .info-card p,
    .link-card span {
      color: #334155;
      line-height: 1.75;
    }

    .link-card {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease;
    }

    .link-card:hover {
      transform: translateY(-2px);
    }

    .link-card strong {
      display: block;
      margin-bottom: 10px;
    }

    .link-card span {
      display: block;
      font-size: 0.95rem;
    }

    .popular-link,
    .text-link {
      color: #0f766e;
      font-weight: 800;
      text-decoration: none;
    }

    .popular-link:hover,
    .text-link:hover {
      text-decoration: underline;
    }

    .content-section {
      max-width: 800px;
      margin-top: 70px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 24px;
      line-height: 1.2;
      color: #0f172a;
    }

    .content-section p {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
      margin-bottom: 24px;
    }

    .button {
      display: inline-block;
      background: #0f766e;
      color: white;
      text-decoration: none;
      padding: 14px 18px;
      border-radius: 12px;
      font-weight: 800;
      margin-top: 8px;
    }

    .button:hover {
      opacity: 0.92;
    }

    @media (max-width: 720px) {
      .container {
        padding: 54px 20px;
      }

      h1 {
        font-size: 2.8rem;
      }

      .intro {
        font-size: 1.02rem;
      }

      .section-title,
      .content-section h2 {
        font-size: 1.7rem;
      }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Rent Calculators</div>

    <h1>Rent Affordability Calculators and Housing Budget Tools</h1>

    <p class="intro">
      Use these rent affordability calculators to evaluate whether your housing
      costs fit your take-home income, debt load, savings cushion, utilities,
      transportation costs, and long-term financial flexibility.
    </p>

    <p class="intro">
  These tools are designed to account for rent pressure, debt obligations,
  emergency savings, utilities, transportation, and overall monthly flexibility
  instead of relying only on outdated percentage rules.
</p>

    <section>
      <h2 class="section-title">Most Popular Rent Calculators</h2>

      <p class="section-description">
        Start with a monthly rent amount, then compare it against rent-to-income
        pressure. These tools help show whether the lease leaves enough room for
        normal bills, savings, emergencies, and debt payments.
      </p>

      <div class="popular-grid">
        <div class="popular-card">
          <div class="popular-label">Rent</div>

          <h2>Should I Spend $3,000 on Rent?</h2>

          <p>
            Evaluate whether a high monthly rent payment fits your income, debt
            load, savings, utilities, and flexibility.
          </p>

          <a class="popular-link" href="/should-i-spend-3000-on-rent">
            Open Calculator →
          </a>
        </div>

        <div class="popular-card">
          <div class="popular-label">Rent</div>

          <h2>Should I Spend $2,500 on Rent?</h2>

          <p>
            Test whether a $2,500 rent payment creates breathing room or puts
            pressure on your monthly budget.
          </p>

          <a class="popular-link" href="/should-i-spend-2500-on-rent">
            Open Calculator →
          </a>
        </div>

        <div class="popular-card">
          <div class="popular-label">Rent Ratio</div>

          <h2>Should I Spend 40% of My Income on Rent?</h2>

          <p>
            See whether a 40% rent ratio leaves enough room for savings, debt
            payments, utilities, and normal expenses.
          </p>

          <a class="popular-link" href="/should-i-spend-40-percent-income-on-rent">
            Open Calculator →
          </a>
        </div>

        <div class="popular-card">
          <div class="popular-label">Rent Ratio</div>

          <h2>Should I Spend 50% of My Income on Rent?</h2>

          <p>
            Estimate the risk of spending half your income on housing before
            committing to a high-pressure lease.
          </p>

          <a class="popular-link" href="/should-i-spend-50-percent-income-on-rent">
            Open Calculator →
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">All Rent Calculators</h2>

      <div class="grid">
        {rentCalculators.map((calculator) => (
          <CalculatorCard
            category={calculator.category}
            title={calculator.title}
            description={calculator.description}
            href={calculator.href}
          />
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>How Much Should You Spend on Rent?</h2>

      <p>
        Rent should support your lifestyle without overwhelming the rest of your
        financial picture. Housing costs affect savings rates, emergency funds,
        retirement contributions, debt payoff speed, and everyday stress.
      </p>

      <p>
        A rent payment that technically fits your income can still create
        pressure if it leaves little room for flexibility, transportation,
        groceries, insurance, repairs, utilities, or unexpected expenses.
      </p>

      <p>
        The healthiest housing budgets usually leave enough breathing room for
        both current stability and future goals. When rent rises above 35% to
        40% of take-home income, debt payments and emergency savings become even
        more important.
      </p>

      <p>
        For these calculators, debt usually means recurring obligations that
        reduce flexibility, such as credit card payments, student loans, car
        loans, personal loans, and minimum monthly balances. You can also review
        the <a class="text-link" href="/what-counts-as-debt">debt guide</a>
        before entering your numbers.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">Rent Budget Rules to Know</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>The 30% Rule</h3>

          <p>
            Many renters use 30% of income as a starting point, but the rule is
            only useful when debt, savings, utilities, and local housing costs
            are considered.
          </p>
        </div>

        <div class="info-card">
          <h3>The 40% Warning Zone</h3>

          <p>
            Spending around 40% of take-home income on rent can work in some
            cases, but it often requires low debt, strong savings, or tighter
            discretionary spending.
          </p>
        </div>

        <div class="info-card">
          <h3>The 50% Risk Zone</h3>

          <p>
            Spending half of take-home income on rent usually leaves very little
            room for emergencies, debt payoff, transportation, savings, or
            normal budget surprises.
          </p>
        </div>

        <div class="info-card">
          <h3>Emergency Cushion</h3>

          <p>
            A larger rent payment usually requires a stronger emergency fund
            because replacing income or absorbing surprise expenses becomes
            harder with a high fixed monthly cost.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
  <h2 class="section-title">Rent and Housing Guides</h2>

  <div class="link-grid">

    <a class="link-card" href="/should-i-spend-40-percent-income-on-rent">
  <strong>40% Rent Calculator</strong>

  <span>
    Estimate whether spending 40% of take-home income on rent
    creates manageable pressure or ongoing financial strain.
  </span>
</a>

    <a class="link-card" href="/how-much-rent-can-i-afford">
      <strong>How Much Rent Can I Afford?</strong>

      <span>
        Learn how rent-to-income rules, take-home pay, debt,
        utilities, and savings affect safe housing costs.
      </span>
    </a>

    <a class="link-card" href="/budget-rule-calculators">
  <strong>Budget Rule Calculators</strong>

  <span>
    Compare rent, debt, transportation, groceries, and major expenses
    against income and monthly financial pressure.
  </span>
</a>

    <a class="link-card" href="/what-counts-as-debt">
      <strong>What Counts as Debt?</strong>

      <span>
        See which recurring obligations should be included
        when evaluating rent affordability.
      </span>
    </a>

    <a class="link-card" href="/how-much-debt-is-too-much">
  <strong>How Much Debt Is Too Much?</strong>
  <span>
    Learn how debt ratios, monthly obligations, and financial flexibility
    affect major spending decisions.
  </span>
</a>

    <a class="link-card" href="/how-much-emergency-savings-should-i-have">
      <strong>Emergency Savings Guide</strong>

      <span>
        Learn how much cushion to keep before committing
        to large monthly housing costs.
      </span>
    </a>

    <a class="link-card" href="/calculators">
  <strong>All ShouldISpend Calculators</strong>

  <span>
    Browse calculators for rent, groceries, debt, weddings,
    transportation, travel, and major life expenses.
  </span>
</a>

  </div>
</section>

    <FAQSection title="Rent Affordability FAQ" faqs={rentFaqs} />
  </main>
</Layout>