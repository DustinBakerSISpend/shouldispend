---
import Layout from "../layouts/Layout.astro";
import CalculatorCard from "../components/CalculatorCard.astro";
import { calculators } from "../data/calculators";

const rentCalculators = calculators.filter(
  (calculator) => calculator.category === "Rent"
);
---

<Layout title="Rent Affordability Calculators | ShouldISpend">
  <style>
    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 72px 24px;
    }

    .eyebrow {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.95;
      margin-bottom: 28px;
      max-width: 820px;
      color: #0f172a;
    }

    .intro {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
      max-width: 780px;
      margin-bottom: 56px;
    }

    .section {
      margin-top: 70px;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 24px;
      line-height: 1.2;
      color: #0f172a;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .popular-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 18px;
      margin-bottom: 64px;
    }

    .popular-card,
    .info-card,
    .faq-card {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 26px;
    }

    .popular-label {
      color: #0f766e;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .popular-card h2,
    .info-card h3,
    .faq-card h3 {
      color: #0f172a;
      line-height: 1.2;
      margin-top: 0;
    }

    .popular-card h2 {
      font-size: 1.35rem;
      margin-bottom: 14px;
    }

    .popular-card p,
    .info-card p,
    .faq-card p {
      color: #334155;
      line-height: 1.75;
    }

    .popular-link,
    .text-link {
      color: #0f766e;
      font-weight: 800;
      text-decoration: none;
    }

    .popular-link:hover,
    .text-link:hover {
      text-decoration: underline;
    }

    .content-section {
      max-width: 780px;
      margin-top: 70px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 24px;
      line-height: 1.2;
      color: #0f172a;
    }

    .content-section p {
      font-size: 1.08rem;
      line-height: 1.9;
      color: #334155;
      margin-bottom: 24px;
    }

    .info-grid,
    .faq-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
    }

    .guide-card {
      background: white;
      border: 1px solid #dbe4ee;
      border-radius: 20px;
      padding: 28px;
      max-width: 460px;
    }

    .guide-card h3 {
      margin-top: 0;
      color: #0f172a;
      font-size: 1.45rem;
    }

    .guide-card p {
      color: #334155;
      line-height: 1.75;
    }

    .button {
      display: inline-block;
      background: #020617;
      color: white;
      text-decoration: none;
      padding: 14px 18px;
      border-radius: 12px;
      font-weight: 800;
      margin-top: 8px;
    }

    .button:hover {
      opacity: 0.92;
    }

    @media (max-width: 720px) {
      .container {
        padding: 54px 20px;
      }

      h1 {
        font-size: 2.8rem;
      }

      .intro {
        font-size: 1.02rem;
      }

      .section-title,
      .content-section h2 {
        font-size: 1.7rem;
      }
    }
  </style>

  <main class="container">
    <div class="eyebrow">Rent Calculators</div>

    <h1>Rent Affordability Calculators and Housing Budget Tools</h1>

    <p class="intro">
      Use these rent affordability calculators to evaluate whether your housing
      costs fit your income, debt load, savings cushion, and long-term financial
      flexibility. Start with a specific rent amount, test a rent-to-income ratio,
      or compare your housing cost against the rest of your budget.
    </p>

    <section>
      <h2 class="section-title">Most Popular Rent Calculators</h2>

      <div class="popular-grid">
        <div class="popular-card">
          <div class="popular-label">Rent</div>

          <h2>Should I Spend $3,000 on Rent?</h2>

          <p>
            Evaluate whether a high monthly rent payment fits your income, debt
            load, savings, and flexibility.
          </p>

          <a class="popular-link" href="/should-i-spend-3000-on-rent">
            Open Calculator →
          </a>
        </div>

        <div class="popular-card">
          <div class="popular-label">Rent</div>

          <h2>Should I Spend $2,500 on Rent?</h2>

          <p>
            Test whether a $2,500 rent payment creates healthy breathing room or
            puts pressure on your budget.
          </p>

          <a class="popular-link" href="/should-i-spend-2500-on-rent">
            Open Calculator →
          </a>
        </div>

        <div class="popular-card">
          <div class="popular-label">Rent Ratio</div>

          <h2>Should I Spend 40% of My Income on Rent?</h2>

          <p>
            See whether a 40% rent ratio leaves enough room for savings, debt
            payments, and normal expenses.
          </p>

          <a class="popular-link" href="/should-i-spend-40-percent-income-on-rent">
            Open Calculator →
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">All Rent Calculators</h2>

      <div class="grid">
        {rentCalculators.map((calculator) => (
          <CalculatorCard
            category={calculator.category}
            title={calculator.title}
            description={calculator.description}
            href={calculator.href}
          />
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>How Much Should You Spend on Rent?</h2>

      <p>
        Rent should support your lifestyle without overwhelming the rest of your
        financial picture. Housing costs affect savings rates, emergency funds,
        retirement contributions, debt payoff speed, and everyday stress.
      </p>

      <p>
        A rent payment that technically fits your income can still create
        pressure if it leaves little room for flexibility, transportation,
        groceries, insurance, travel, repairs, or unexpected expenses.
      </p>

      <p>
        The healthiest housing budgets usually leave enough breathing room for
        both current stability and future goals. When rent rises above 35% to
        40% of take-home income, debt payments and emergency savings become even
        more important.
      </p>

      <p>
        For these calculators, debt usually means recurring obligations that
        reduce flexibility, such as credit card payments, student loans, car
        loans, personal loans, and minimum monthly balances. You can also review
        the <a class="text-link" href="/what-counts-as-debt">debt guide</a>
        before entering your numbers.
      </p>
    </section>

    <section class="section">
      <h2 class="section-title">Rent Budget Rules to Know</h2>

      <div class="info-grid">
        <div class="info-card">
          <h3>The 30% Rule</h3>
          <p>
            Many renters use 30% of income as a starting point, but the rule is
            only useful when debt, savings, and local housing costs are considered.
          </p>
        </div>

        <div class="info-card">
          <h3>The 40% Warning Zone</h3>
          <p>
            Spending around 40% of take-home income on rent can work in some
            cases, but it often requires lower debt, stronger savings, or tighter
            discretionary spending.
          </p>
        </div>

        <div class="info-card">
          <h3>Emergency Cushion</h3>
          <p>
            A larger rent payment usually requires a stronger emergency fund
            because replacing income or absorbing surprise expenses becomes
            harder with a high fixed monthly cost.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Rent and Housing Guides</h2>

      <div class="guide-card">
        <h3>How Much Rent Can I Afford?</h3>

        <p>
          Learn how budgeting rules, debt, savings, and income affect safe
          housing costs.
        </p>

        <a class="button" href="/how-much-rent-can-i-afford">
          Read Guide
        </a>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Rent Affordability FAQ</h2>

      <div class="faq-grid">
        <div class="faq-card">
          <h3>Is rent based on gross income or take-home income?</h3>
          <p>
            Take-home income usually gives a clearer picture because it reflects
            the money actually available after taxes and payroll deductions.
          </p>
        </div>

        <div class="faq-card">
          <h3>Is 40% of income on rent too much?</h3>
          <p>
            It can be aggressive. A 40% rent ratio is easier to handle with low
            debt, strong savings, and stable income.
          </p>
        </div>

        <div class="faq-card">
          <h3>Should debt payments affect rent decisions?</h3>
          <p>
            Yes. Debt payments reduce the money left after rent, which can make
            an affordable-looking rent payment feel much tighter.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>