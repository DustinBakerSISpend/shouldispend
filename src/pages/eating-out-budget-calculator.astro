---
import CorePageExamplesBlock from "../components/CorePageExamplesBlock.astro";
import OmniStyleReviewBlock from "../components/OmniStyleReviewBlock.astro";
import Layout from "../layouts/Layout.astro";
import CalculatorPageShell from "../components/CalculatorPageShell.astro";
import FAQSection from "../components/FAQSection.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import MethodologySection from "../components/MethodologySection.astro";
import CalculatorAssumptions from "../components/CalculatorAssumptions.astro";
import KeyCostCategories from "../components/KeyCostCategories.astro";
import ReduceCostTips from "../components/ReduceCostTips.astro";
import { calculators } from "../data/calculators.js";

const eatingOutFaqs = [
  {
    question: "How much should I spend eating out per month?",
    answer:
      "A reasonable eating-out budget depends on take-home income, household size, grocery spending, debt, savings, and lifestyle. This calculator gives a monthly dollar range instead of one fixed number.",
  },
  {
    question: "Should eating out be based on income?",
    answer:
      "Yes. A $300 eating-out budget feels very different on $2,000 per month than it does on $20,000 per month. This calculator adjusts the recommended amount based on monthly take-home income.",
  },
  {
    question: "Does this include coffee and delivery?",
    answer:
      "Yes. Restaurants, takeout, delivery apps, coffee shops, work lunches, convenience meals, tips, and fees should generally be counted in an eating-out budget.",
  },
  {
    question: "Should I cut eating out to zero?",
    answer:
      "Not always. The goal is a repeatable number that fits your budget. Cutting eating out to zero can backfire if it creates burnout or leads to unplanned spending later.",
  },
];

const relatedCalculators = calculators
  .filter(
    (calculator) =>
      calculator.category === "Groceries" &&
      calculator.href !== "/eating-out-budget-calculator"
  )
  .slice(0, 4);
---

<Layout
  title="Eating Out Budget Calculator | How Much Should You Spend?"
  description="Estimate how much to spend eating out each month and week based on take-home income, groceries, household size, debt, savings, and lifestyle."
>


  <style>
    .container {
      max-width: 900px;
      margin: auto;
    }

    .calculator {
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.06);
    }

    .calculator h2 {
      margin-top: 0;
      font-size: 2rem;
      margin-bottom: 18px;
      color: #0f172a;
    }

    .calculator-intro {
      color: #334155;
      line-height: 1.8;
      margin-bottom: 30px;
      font-size: 1.05rem;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .field label {
      display: block;
      font-weight: 800;
      margin-bottom: 10px;
      color: #0f172a;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 16px;
      border-radius: 12px;
      border: 1px solid #cbd5e1;
      font-size: 1rem;
      box-sizing: border-box;
      background: white;
    }

    button {
      margin-top: 30px;
      background: #0f766e;
      color: white;
      border: none;
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 1.05rem;
      font-weight: 800;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:hover {
      opacity: 0.92;
    }

    .results {
      margin-top: 36px;
      background: #f8fafc;
      padding: 32px;
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
      display: none;
    }

    .results.visible {
      display: block;
    }

    .total-price {
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 900;
      color: #0f172a;
      line-height: 1.05;
      margin-bottom: 12px;
    }

    .result-label {
      font-size: 1.15rem;
      font-weight: 800;
      color: #0f766e;
      margin-bottom: 24px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .result-details {
      color: #334155;
      line-height: 1.9;
      font-size: 1.02rem;
    }

    .result-details p {
      margin: 0 0 12px;
    }

    .mini-summary {
      margin-top: 24px;
      padding: 20px;
      border-radius: 18px;
      background: white;
      border: 1px solid #dbe4ee;
      color: #334155;
      line-height: 1.8;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.9rem;
      color: #64748b;
    }

    .content-section {
      margin-top: 60px;
    }

    .content-section h2 {
      font-size: 2rem;
      margin-bottom: 20px;
      color: #0f172a;
    }

    .content-section p,
    .content-section li {
      font-size: 1.1rem;
      line-height: 1.9;
      color: #334155;
    }

    .content-link {
      color: #0f766e;
      font-weight: 700;
      text-decoration: none;
    }

    .content-link:hover {
      text-decoration: underline;
    }

    .budget-link-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-top: 24px;
    }

    .budget-link-card {
      display: block;
      border: 1px solid #dbe4ee;
      border-radius: 18px;
      padding: 20px;
      background: #f8fafc;
      color: inherit;
      text-decoration: none;
    }

    .budget-link-card strong {
      display: block;
      color: #0f172a;
      margin-bottom: 8px;
      font-size: 1.05rem;
    }

    .budget-link-card span {
      color: #475569;
      line-height: 1.65;
      font-size: 0.95rem;
    }

    @media (max-width: 768px) {
      .calculator {
        padding: 24px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .calculator h2,
      .content-section h2 {
        font-size: 1.7rem;
      }

      .results {
        padding: 24px;
      }
    }
  </style>

  <div class="container">
    <CalculatorPageShell
      eyebrow="Eating Out Budget Calculator"
      title="Eating Out Budget Calculator"
      description="Estimate a practical monthly and weekly eating-out budget based on take-home income, groceries, household size, debt, savings, housing, and lifestyle."
    >
      <div class="calculator">
        <h2>How Much Should You Spend Eating Out?</h2>

        <p class="calculator-intro">
          Enter your monthly take-home income, grocery spending, household size,
          debt, savings, and eating-out style. This calculator gives you a
          practical monthly dollar range for restaurants, takeout, delivery,
          coffee, and work lunches.
        </p>

        <div class="grid">
          <div class="field">
            <label for="income">Monthly Take-Home Income</label>
            <input id="income" type="number" min="0" placeholder="Example: 6500" />
          </div>

          <div class="field">
            <label for="household">Household Size</label>
            <input id="household" type="number" min="1" step="1" placeholder="Example: 2" />
          </div>

          <div class="field">
            <label for="groceries">Monthly Grocery Spending</label>
            <input id="groceries" type="number" min="0" placeholder="Example: 700" />
          </div>

          <div class="field">
            <label for="debt">Monthly Debt Payments</label>
            <input id="debt" type="number" min="0" placeholder="Example: 600" />
          </div>

          <div class="field">
            <label for="savings">Emergency Savings</label>
            <input id="savings" type="number" min="0" placeholder="Example: 10000" />
          </div>

          <div class="field">
            <label for="housing">Monthly Rent or Mortgage</label>
            <input id="housing" type="number" min="0" placeholder="Example: 1800" />
          </div>

          <div class="field">
            <label for="lifestyle">Eating-Out Style</label>
            <select id="lifestyle">
              <option value="low">Occasional / budget-conscious</option>
              <option value="medium" selected>Balanced</option>
              <option value="high">Social, busy, or convenience-heavy</option>
            </select>
          </div>

          <div class="field">
            <label for="goal">Main Goal</label>
            <select id="goal">
              <option value="save">Save money aggressively</option>
              <option value="balanced" selected>Balanced budget</option>
              <option value="flexible">More lifestyle flexibility</option>
            </select>
          </div>
        </div>

        <button class="sis-action-button sis-calculate-button" id="eatingOutBudgetButton" type="button">
          Calculate Eating Out Budget
        </button>

        <div class="results" id="results">
          <div class="result-label">Recommended Monthly Eating-Out Budget</div>

          <div class="total-price" id="budgetRange"></div>

          <div class="result-details" id="resultDetails"></div>

          <div class="mini-summary" id="summary"></div>

          <div class="disclaimer">
            This estimate is for restaurants, takeout, delivery, coffee, work
            lunches, tips, and fees. It does not include groceries.
          </div>
        </div>
      </div>

<OmniStyleReviewBlock
      pageName="the eating-out budget calculator"
      pageType="calculator"
      reviewLabel="Last reviewed: September 2026"
      methodologyHref="/methodology/"
      editorialHref="/editorial-policy/"
      disclaimerHref="/disclaimer/"
      decisionFocus="restaurant, takeout, delivery, coffee, convenience-food spending, grocery spending, take-home income, savings, debt, and monthly breathing room"
    />

    <CorePageExamplesBlock
      title="Eating-out budget examples"
      intro="An eating-out budget works best when it fits around groceries, savings, debt, and normal bills. The goal is not zero restaurants; the goal is a number that does not crowd out more important needs."
      useCases={[
          "You want a realistic restaurant and takeout budget.",
          "You are trying to reduce delivery or convenience-food spending.",
          "You need a food budget that still leaves room for savings and debt payoff."
        ]}
      notEnough={[
          "You are facing food insecurity or need local assistance.",
          "Food decisions are tied to medical or nutritional needs.",
          "You need a meal plan or nutrition advice."
        ]}
      examples={[
          {
            label: "Weekly takeout limit",
            takeaway: "A planned weekly limit can preserve flexibility while preventing restaurant spending from spreading across the whole month."
          },
          {
            label: "Delivery fees and tips",
            takeaway: "The real budget should include fees, tips, drinks, coffee, and snacks, not just entree prices."
          },
          {
            label: "Debt payoff month",
            takeaway: "A temporary lower eating-out budget can free cash for credit-card payoff without changing fixed bills."
          }
        ]}
      commonMistake="Setting a restaurant budget without checking grocery spending and total food spending first."
      nextStep="Choose a monthly restaurant number after groceries, debt, savings, and essential bills are covered."
    />



      <section class="content-section">
        <h2>How This Eating Out Budget Calculator Works</h2>

        <p>
          The calculator combines income and flexible cash flow with household size,
          grocery spending, debt, housing, savings, and your selected lifestyle goal.
          It returns a monthly range, a weekly range, and the estimated share of
          take-home income used for eating out.
        </p>

        <p>
          The result is intentionally a range rather than a universal spending rule.
          The same restaurant budget can create very different pressure depending on
          the rest of the household budget.
        </p>

        <p>
          For related food decisions, compare this result with the
          <a class="content-link" href="/should-i-meal-prep-or-eat-out/">
            meal prep vs eating out calculator
          </a>,
          the
          <a class="content-link" href="/ideal-grocery-budget-calculator/">
            ideal grocery budget calculator
          </a>,
          or the
          <a class="content-link" href="/cost-per-meal-calculator/">
            cost per meal calculator
          </a>.
        </p>
      </section>

      <KeyCostCategories
        items={[
          {
            title: "Take-home income",
            description:
              "The recommended eating-out budget rises when monthly income gives you more flexible spending room.",
          },
          {
            title: "Grocery spending",
            description:
              "Restaurants are easier to afford when groceries are controlled and food at home is not being wasted.",
          },
          {
            title: "Debt payments",
            description:
              "Debt lowers the recommended restaurant budget because less income is flexible.",
          },
          {
            title: "Emergency savings",
            description:
              "Weak savings make the estimate more conservative. Strong savings allow more lifestyle flexibility.",
          },
          {
            title: "Lifestyle goal",
            description:
              "A savings-focused household gets a tighter range. A flexibility-focused household gets more room.",
          },
        ]}
      />

      <ReduceCostTips
        items={[
          "Separate restaurants, delivery, coffee, snacks, and groceries into different categories.",
          "Set a weekly eating-out cap instead of trying to manage one monthly number.",
          "Keep the restaurant meals you actually value and cut forgettable convenience spending.",
          "Use pickup instead of delivery when fees and tips are inflating the total.",
          "Keep easy backup meals at home to prevent emergency takeout.",
        ]}
      />

      <CalculatorAssumptions
        items={[
          "Monthly income means take-home pay after taxes and payroll deductions.",
          "Eating out includes restaurants, fast food, takeout, delivery, coffee shops, work lunches, tips, and fees.",
          "Groceries are excluded from the final eating-out budget but included when estimating total food flexibility.",
          "Debt payments and weak emergency savings reduce the recommended range.",
          "Very high income can produce a much higher recommended dollar amount while still being financially safe.",
          "The estimate is educational guidance, not personal financial advice.",
        ]}
      />

      <section class="content-section">
        <h2>What Counts as Eating Out?</h2>

        <p>
          Eating out is more than sit-down restaurants. It usually includes
          fast food, takeout, delivery apps, coffee shops, work lunches, snacks
          bought away from home, tips, and delivery fees.
        </p>

        <p>
          The number can grow quickly because the purchases feel small. A few
          coffees, two lunches, one delivery order, and a weekend meal can become
          a meaningful monthly expense without ever feeling like a big purchase.
        </p>
      </section>

      <section class="content-section">
        <h2>Why the Right Eating-Out Budget Changes by Income</h2>

        <p>
          The right restaurant budget is not the same for every household. A
          $150 monthly eating-out budget may be generous on a tight income, while
          a $1,000 budget may be reasonable for a high-income household with low
          debt and strong savings.
        </p>

        <p>
          The goal is to find a number that protects essential bills, keeps
          groceries under control, supports savings, and still leaves room for
          meals or convenience you genuinely value.
        </p>
      </section>

      <section class="content-section">
        <h2>How to Use Your Monthly Number</h2>

        <p>
          The calculator already converts the monthly range into a weekly target.
          Use the weekly number as a pacing tool rather than treating the full
          monthly amount as available on day one. That makes it easier to decide
          whether a delivery order, coffee run, work lunch, or dinner out fits
          before the month gets away from you.
        </p>

        <p>
          If one week runs high, adjust the next week instead of abandoning the
          budget. The goal is repeatable spending over the month, not hitting the
          exact same restaurant total every seven days.
        </p>
      </section>


      <section class="content-section">
        <h2>Eating Out Budget vs. Total Food Budget</h2>

        <p>
          Restaurant spending and grocery spending should be evaluated together.
          A household that spends more on takeout because it buys fewer groceries
          has a different food budget from a household that spends heavily in both
          categories and throws food away at home.
        </p>

        <p>
          Use the calculator's total-food-share result to check the combined picture.
          If eating out rises without groceries falling, the issue may be total food
          spending rather than restaurants alone. The
          <a class="content-link" href="/ideal-grocery-budget-calculator/">
            grocery budget calculator
          </a>
          can help pressure-test the other side of the food budget.
        </p>
      </section>

      <section class="content-section">
        <h2>Compare Common Monthly Eating-Out Budgets</h2>

        <p>
          The calculator gives a personalized range. If you are deciding whether a
          specific monthly amount fits, these amount-based pages let you pressure-test
          the same question at common spending levels.
        </p>

        <div class="budget-link-grid">
          <a class="budget-link-card" href="/should-i-spend-300-eating-out-per-month/">
            <strong>$300 per month eating out</strong>
            <span>Check whether a $300 restaurant, takeout, coffee, and delivery budget fits.</span>
          </a>

          <a class="budget-link-card" href="/should-i-spend-500-eating-out-per-month/">
            <strong>$500 per month eating out</strong>
            <span>Pressure-test a larger monthly restaurant and convenience-food budget.</span>
          </a>

          <a class="budget-link-card" href="/should-i-spend-1000-eating-out-per-month/">
            <strong>$1,000 per month eating out</strong>
            <span>See when a four-figure monthly eating-out budget becomes financially heavy.</span>
          </a>
        </div>
      </section>

      <div class="content-section">
        <FAQSection title="Eating Out Budget Calculator FAQ" faqs={eatingOutFaqs} />
      </div>

      <div class="content-section">
        <RelatedCalculators calculators={relatedCalculators} />
      </div>
    </CalculatorPageShell>

    <section id="FinancialRedFlags">
      <h2>Eating Out Budget Red Flags</h2>

      <p>
        Eating out becomes financially risky when it quietly crowds out
        savings, groceries, debt payoff, or basic monthly obligations. The
        danger is not one meal. The danger is a pattern that feels small
        each time but creates steady pressure across the month.
      </p>

      <ul>
        <li>Restaurant spending is growing while savings are flat or shrinking.</li>
        <li>Meals are being financed with credit cards that are not paid off monthly.</li>
        <li>Eating out is causing grocery waste instead of replacing grocery costs.</li>
        <li>The habit makes it harder to cover rent, debt payments, or emergency savings.</li>
      </ul>
    </section>

    <!-- Journey Wave 3A eating-out traffic expansion -->
    <!-- Calculator integrity hardening: extreme-input guardrails -->
    <MethodologySection category="eating out budget estimates" updated="September 2026" />
  </div>

  <script is:inline>
    const getNumber = (id) => {
      const rawValue = document.getElementById(id)?.value;
      const value = Number(rawValue);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const getValue = (id) => document.getElementById(id)?.value || "";

    function formatMoney(value) {
      return value.toLocaleString(undefined, {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      });
    }

    function clamp(value, min, max) {
      return Math.min(Math.max(value, min), max);
    }

    function calculateEatingOutRecommendation({
      income,
      household,
      groceries,
      debt,
      savings,
      housing,
      lifestyle,
      goal,
    }) {
      const safeIncome = Number.isFinite(income) && income > 0 ? income : 0;
      const safeHousehold =
        Number.isFinite(household) && household > 0
          ? Math.max(Math.round(household), 1)
          : 1;
      const safeGroceries =
        Number.isFinite(groceries) && groceries > 0 ? groceries : 0;
      const safeDebtInput =
        Number.isFinite(debt) && debt > 0 ? debt : 0;
      const safeSavings =
        Number.isFinite(savings) && savings > 0 ? savings : 0;
      const safeHousing =
        Number.isFinite(housing) && housing > 0 ? housing : 0;

      if (safeIncome <= 0) {
        return {
          recommendedMidpoint: 0,
          lowRange: 0,
          highRange: 0,
          weeklyLow: 0,
          weeklyHigh: 0,
          finalShare: 0,
          totalFoodShare: 0,
          savingsMonths: 0,
          flexibleCash: 0,
          guidance: "no discretionary room",
          household: safeHousehold,
        };
      }

      const safeDebt = Math.min(safeDebtInput, safeIncome);
      const requiredOutflow = safeHousing + safeDebt + safeGroceries;
      const flexibleCash = Math.max(safeIncome - requiredOutflow, 0);

      let incomePercent = 0.045;

      if (safeIncome >= 4000) {
        incomePercent = 0.055;
      }

      if (safeIncome >= 8000) {
        incomePercent = 0.07;
      }

      if (safeIncome >= 15000) {
        incomePercent = 0.085;
      }

      if (safeIncome >= 30000) {
        incomePercent = 0.1;
      }

      const lifestyleMultiplier =
        lifestyle === "low" ? 0.72 : lifestyle === "high" ? 1.22 : 1;

      const goalMultiplier =
        goal === "save" ? 0.7 : goal === "flexible" ? 1.2 : 1;

      const householdFloor = safeHousehold * 45;
      const incomeBasedBudget = safeIncome * incomePercent;
      const flexibleCashBudget = flexibleCash * 0.18;

      let recommendedMidpoint =
        incomeBasedBudget * 0.65 + flexibleCashBudget * 0.35;

      recommendedMidpoint *= lifestyleMultiplier * goalMultiplier;

      const savingsNeed = Math.max(
        safeIncome * 0.65,
        requiredOutflow + safeHousehold * 300
      );
      const savingsMonths = savingsNeed > 0 ? safeSavings / savingsNeed : 0;

      if (savingsMonths < 1) {
        recommendedMidpoint *= 0.78;
      } else if (savingsMonths < 3) {
        recommendedMidpoint *= 0.9;
      } else if (savingsMonths >= 6) {
        recommendedMidpoint *= 1.08;
      }

      const debtShare = safeDebt / safeIncome;
      const housingShare = safeHousing / safeIncome;
      const groceryShare = safeGroceries / safeIncome;

      if (debtShare > 0.35) {
        recommendedMidpoint *= 0.65;
      } else if (debtShare > 0.25) {
        recommendedMidpoint *= 0.78;
      } else if (debtShare > 0.18) {
        recommendedMidpoint *= 0.88;
      }

      if (housingShare > 0.45) {
        recommendedMidpoint *= 0.72;
      } else if (housingShare > 0.35) {
        recommendedMidpoint *= 0.85;
      }

      if (groceryShare > 0.18) {
        recommendedMidpoint *= 0.82;
      } else if (groceryShare > 0.14) {
        recommendedMidpoint *= 0.9;
      }

      const practicalMinimum =
        safeIncome < 2500 ? 40 : safeIncome < 4500 ? 75 : householdFloor;

      // Integrity guardrails:
      // 1) Never recommend discretionary restaurant spending when entered
      //    housing + debt + groceries already consume all take-home income.
      // 2) Never let a household-size floor overpower actual cash flow.
      // 3) Cap the midpoint at 10% of take-home income and 40% of remaining
      //    flexible cash so extreme income/household inputs stay bounded.
      const discretionaryCap = Math.max(
        Math.min(safeIncome * 0.1, flexibleCash * 0.4),
        0
      );

      if (discretionaryCap <= 0) {
        recommendedMidpoint = 0;
      } else {
        const affordableFloor = Math.min(practicalMinimum, discretionaryCap);
        recommendedMidpoint = Math.max(recommendedMidpoint, affordableFloor);
        recommendedMidpoint = Math.min(recommendedMidpoint, discretionaryCap);
      }

      const lowRange = recommendedMidpoint * 0.82;
      const highRange = recommendedMidpoint * 1.18;
      const weeklyLow = lowRange / 4.33;
      const weeklyHigh = highRange / 4.33;
      const finalShare = recommendedMidpoint / safeIncome;
      const totalFoodShare =
        (safeGroceries + recommendedMidpoint) / safeIncome;

      let guidance = "balanced";

      if (recommendedMidpoint <= 0) {
        guidance = "no discretionary room";
      } else if (finalShare <= 0.035) {
        guidance = "conservative";
      } else if (finalShare >= 0.09) {
        guidance = "flexible";
      }

      return {
        recommendedMidpoint,
        lowRange,
        highRange,
        weeklyLow,
        weeklyHigh,
        finalShare,
        totalFoodShare,
        savingsMonths,
        flexibleCash,
        guidance,
        household: safeHousehold,
      };
    }

    function calculateEatingOutBudget() {
      const income = getNumber("income");
      const household = getNumber("household");
      const groceries = getNumber("groceries");
      const debt = getNumber("debt");
      const savings = getNumber("savings");
      const housing = getNumber("housing");
      const lifestyle = getValue("lifestyle");
      const goal = getValue("goal");

      const results = document.getElementById("results");
      const budgetRange = document.getElementById("budgetRange");
      const resultDetails = document.getElementById("resultDetails");
      const summary = document.getElementById("summary");

      results.classList.add("visible");

      const recommendation = calculateEatingOutRecommendation({
        income,
        household,
        groceries,
        debt,
        savings,
        housing,
        lifestyle,
        goal,
      });

      if (income <= 0) {
        budgetRange.textContent = "$0";
        resultDetails.innerHTML =
          "<p>Enter monthly take-home income to estimate a monthly eating-out budget.</p>";
        summary.textContent = "";
        return;
      }

      const {
        recommendedMidpoint,
        lowRange,
        highRange,
        weeklyLow,
        weeklyHigh,
        finalShare,
        totalFoodShare,
        savingsMonths,
        guidance,
      } = recommendation;

      budgetRange.textContent =
        recommendedMidpoint > 0
          ? `${formatMoney(lowRange)} - ${formatMoney(highRange)}`
          : "$0";

      resultDetails.innerHTML = `
        <p><strong>Estimated midpoint:</strong> ${formatMoney(recommendedMidpoint)} per month.</p>

        <p><strong>Weekly target:</strong> about ${formatMoney(weeklyLow)} to ${formatMoney(weeklyHigh)} per week.</p>

        <p><strong>Eating-out share of take-home income:</strong> about ${(finalShare * 100).toFixed(1)}% at the midpoint.</p>

        <p><strong>Total food share with groceries:</strong> about ${(totalFoodShare * 100).toFixed(1)}% of take-home income.</p>

        <p><strong>Emergency savings estimate:</strong> about ${savingsMonths.toFixed(1)} months of baseline expenses.</p>
      `;

      if (recommendedMidpoint <= 0) {
        summary.innerHTML = `
          Based on the income, housing, debt, and grocery costs entered, there is
          <strong>no current discretionary room</strong> for a separate eating-out
          budget. Reduce another entered cost or increase available income before
          assigning restaurant spending.
        `;
      } else {
        summary.innerHTML = `
          Based on <strong>${formatMoney(income)}</strong> in monthly take-home income,
          <strong>${formatMoney(groceries)}</strong> in groceries, household size,
          debt, housing, savings, and lifestyle, a practical eating-out budget is about
          <strong>${formatMoney(lowRange)} to ${formatMoney(highRange)}</strong> per month.
          This is a <strong>${guidance}</strong> restaurant budget, not a hard limit.
        `;
      }
    }

    document
      .getElementById("eatingOutBudgetButton")
      .addEventListener("click", calculateEatingOutBudget);
  </script>
</Layout>
